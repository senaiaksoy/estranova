# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# LLM API Keys
# Do not commit real secrets. Copy this file to `.env` and fill with your own keys locally.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
# RAG (Chroma): dahili kaynak aramasi embedding icin de OPENAI_API_KEY kullanilir (yerel model yok).
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"
GOOGLE_API_KEY="YOUR_GOOGLE_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Site launch: set to `production` when the public site goes live (search indexing + robots Allow).
# Until then omit or use `development` — pages use noindex and /robots.txt disallows crawlers.
# PUBLIC_LAUNCH_MODE=production

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Required for GA4 to load in production. Set in Cloudflare Pages → Settings → Environment variables (Production).
# Loads only after user accepts analytics cookies via the consent banner.
# Privacy: code sends anonymize_ip + disables Google Signals + disables ad personalization at runtime.
# PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Search Console HTML meta verification code.
# Example: if Search Console gives
# <meta name="google-site-verification" content="abc123" />
# set only the content value below.
# PUBLIC_GOOGLE_SITE_VERIFICATION=abc123
