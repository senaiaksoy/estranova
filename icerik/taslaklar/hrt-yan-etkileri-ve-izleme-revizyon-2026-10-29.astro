---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { resolveSiteUrl } from '../../../utils/seo';

const route = '/hormonal-gecis/menopoz/hrt-yan-etkileri-ve-izleme/';
const hero = submenuHeroByRoute[route]!;

const tocEntries = [
  { id: 'acilis', label: 'İzlem Defteriyle Başlamak' },
  { id: 'ilk-haftalar', label: 'İlk Haftalarda Neler Değişebilir?' },
  { id: 'yumusak-yan-etkiler', label: 'Hafif Yan Etkilerle Baş Etmek' },
  { id: 'kanama-duzeni', label: 'Kanama Düzenindeki Değişimler' },
  { id: 'ruh-hali-uyku', label: 'Ruh Hali, Baş Ağrısı ve Uyku' },
  { id: 'izleme-takvimi', label: 'İzleme Takvimi ve Kontrole Hazırlık' },
  { id: 'ne-zaman-hekime', label: 'Planlı Kontrolü Beklememeniz Gereken Belirtiler' },
  { id: 'kaynaklar', label: 'Kaynaklar' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'HRT Yan Etkileri ve İzleme — İlk Aylarda Neyi Bekleyelim, Neyi Soralım?';
const seoTitle = 'HRT Yan Etkileri ve İzleme';
const articleDescription =
  'HRT\'nin ilk aylarında yan etkiler, kanama ve kontrol takvimi: hangi belirtileri not etmeli, ne zaman hekime danışmalı, hangi durumda acil yardım almalısınız?';
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'alper-mumcu',
  articleType: 'clinical-guide',
  publishedDate: '27 Nisan 2026',
  modifiedDate: '29 Ekim 2026',
  pathname: route,
  articleSection: 'Hormonal Geçiş',
  sectionPath: '/hormonal-gecis/',
  keywords: [
    'HRT',
    'hormon tedavisi yan etkileri',
    'meme hassasiyeti',
    'baş ağrısı',
    'kanama düzensizliği',
    'menopoz',
    'izleme takvimi',
    '3 aylık kontrol',
    'alarm belirtileri',
  ],
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/hormonal-gecis/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Hormonal Geçiş · Menopoz · HRT"
      title={articleTitle}
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="alper-mumcu"
        articleType="clinical-guide"
        publishedDate="27 Nisan 2026"
        lastUpdated="29 Ekim 2026"
        readingMinutes={7}
        imageSrc="/images/library/editorial/introspective-clasped-hands.webp"
        imageAlt="Pencere yanında elini omzuna koymuş, koyu saçlı bir kadının portresi"
      />

      <ArticleSummary title="Kısa Klinik Yanıt">
        <p>
          Sistemik menopozal hormon tedavisinin (HRT) ilk haftalarında hafif meme hassasiyeti, bulantı ve baş ağrısı görülebilir; bunlar zamanla
          azalabilir. Kanamanın değerlendirilmesi tedavi düzenine, başlangıç veya değişiklik tarihine ve
          kişisel risklere bağlıdır; yoğun ya da uzun süren kanamada kontrolü beklemeyin. İlk kontrol üçüncü
          ayda, sonrasında en az yılda bir yapılır. Ani nefes darlığı veya göğüs ağrısı, ani konuşma bozukluğu,
          tek taraflı güçsüzlük veya ani görme kaybında 112'yi arayın. Rahatsız edici yan etkileri hekiminize
          bildirin; dozu veya ilaç türünü kendi başınıza değiştirmeyin.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="acilis">İzlem Defteriyle Başlamak</h2>
        <p>
          Sabah ilacınızı aldınız, öğleden sonra memenizde bir hassasiyet fark ettiniz. Aklınıza gelen ilk
          soru belli: “Bu normal mi?”
        </p>
        <p>
          HRT'ye yeni başlamış biri için çok doğal bir soru bu. Yanıtlarken üç şeye bakarım: Belirti ne zaman
          başladı, ne kadar şiddetli ve zamanla nasıl değişiyor?
        </p>
        <p>
          Bu rehber, menopozal hormon tedavisinin (HRT) tablet, bant, jel veya sprey gibi tüm vücudu etkileyen
          sistemik biçimlerinin izlemine odaklanır. Yalnızca vajinaya uygulanan düşük doz östrojenin emilimi
          ve risk profili farklıdır; burada anlatılan riskler ona aynen genellenmez <Evidence level={4} /> <a href="#kaynak-1">[1]</a>.
        </p>
        <p>
          Bunun için karmaşık bir sistem gerekmez. Telefonunuza düşeceğiniz kısa bir not yeter:
          “İki gündür meme hassasiyeti var”, “Bu hafta iki kez lekelenme oldu” veya “Gece terlemesi azaldı.”
          Kanama günlerini ayrıca işaretleyin. İlaca başladığınız ve dozun değiştiği tarihi de yazın.
        </p>
        <p>
          Bu notları kontrol görüşmesine getirin. Hekiminiz belirtilerin tedaviyle ilişkisini ve doz ya da
          uygulama yolunda değişiklik gerekip gerekmediğini bu notlarla daha kolay değerlendirir. Kayıt tutmak
          tanı koymaz; konuşmayı somutlaştırır. Aşağıdaki güvenlik belirtilerinden biri ortaya çıkarsa not
          almakla yetinmeyin, uygun tıbbi yardıma başvurun.
        </p>

        <h2 id="ilk-haftalar">İlk Haftalarda Neler Değişebilir?</h2>
        <p>
          Önce şunu söyleyeyim: İlk günlerde belirgin bir değişiklik hissetmemeniz, tedavinin etkisiz kaldığını
          göstermez.
        </p>
        <p>
          Belirtilerdeki düzelme de yan etkilerin seyri de kişiden kişiye değişir. Bazı kadınlar hiçbir yan
          etki yaşamaz. Bazılarında meme hassasiyeti, bulantı, baş ağrısı veya ruh hali değişiklikleri görülür.
          Bu belirtiler östrojene veya birlikte kullanılan progesteron/progestojen grubundaki hormona
          bağlı olabilir <a href="#kaynak-2">[2]</a>. Hafif belirtiler birkaç hafta içinde azalabilir.
          Rahatsız edici olanları ya da üç aydan uzun sürenleri hekiminizle konuşun. Şiddetli bir belirti
          için üç ay beklenmez <Evidence level={4} /> <a href="#kaynak-2">[2]</a>.
        </p>
        <p>
          Menopoz belirtileriyle ilaç yan etkileri birbirine benzeyebilir. Bu yüzden yeni bir şikâyeti hemen
          “hormonlara alışıyorum” diye açıklamayın. Ne zaman başladığını ve gününüzü nasıl etkilediğini
          hekiminize anlatın. Üçüncü ay kontrolü tam da bunun için planlanır: tedavinin yararını ve nasıl
          tolere edildiğini birlikte değerlendirmek <a href="#kaynak-1">[1]</a>.
        </p>

        <h2 id="yumusak-yan-etkiler">Hafif Yan Etkilerle Baş Etmek</h2>
        <p>
          Hafif bir yan etki de gününüzü bozabilir. Bulantıyla güne başlamak ya da giysinin bile rahatsız
          ettiği bir meme hassasiyeti küçük bir dert sayılmaz.
        </p>
        <p>Bunu hekiminize söylemek için şiddetlenmesini beklemeyin.</p>
        <p>
          <strong>Meme hassasiyeti</strong> birkaç hafta içinde hafifleyebilir. Sizi rahatsız ediyorsa veya
          geçmiyorsa hekiminizle konuşun. Memede yeni kitle, meme başında akıntı ya da değişiklik veya ciltte
          çekinti fark etmek, genel hassasiyetten ayrı değerlendirilir <Evidence level={4} /> <a href="#kaynak-3">[3]</a>.
        </p>
        <p>
          <strong>Bulantı</strong> için ağızdan alınan östrojen tabletini yemekle almak yardımcı olabilir;
          kendi ilacınızın kullanım talimatını esas alın. Bir haftadan uzun sürerse veya belirginse
          hekiminize bildirin. Gerekirse doz, ilaç türü veya uygulama yolu yeniden değerlendirilir
          <a href="#kaynak-3">[3]</a>. Hedef, belirtileriniz için en düşük etkili dozu bulmaktır
          <a href="#kaynak-1">[1]</a>. Jel ya da bant herkes için otomatik olarak daha uygun değildir.
        </p>
        <p>
          <strong>Şişkinlik veya hafif şişme</strong> fark ederseniz, ne zaman başladığını ve gün içinde
          nasıl değiştiğini kaydedin. Bir bacakta ağrı, kızarıklık ve şişlik varsa bunu sıradan sıvı
          tutulması saymayın; aynı gün tıbbi değerlendirme gerekir <a href="#kaynak-3">[3]</a>.
        </p>

        <h2 id="kanama-duzeni">Kanama Düzenindeki Değişimler</h2>
        <p>
          Kanama görmek insanı haklı olarak tedirgin eder. Miktarı ve süresi kadar, kullandığınız tedavi
          düzeni ve kanamanın ne zaman başladığı da değerlendirmeyi değiştirir.
        </p>
        <p>
          Hekiminize başlangıç tarihini, kanama günlerini ve kullandığınız tedavi düzenini birlikte anlatın.
          Rahmi olan kadınlarda sistemik HRT'nin ilk altı ayında veya doz ya da ilaç değişikliğini izleyen
          üç ayda lekelenme görülebilir. Döngüsel kombine tedavide progesteron veya benzer etkili bir
          progestojen ayın belirli günlerinde kullanılır; bu dönemin sonunda beklenen çekilme kanaması
          olabilir. Sürekli kombine tedavide ise iki hormon her gün kullanılır ve ilk aylardaki lekelenme
          farklı değerlendirilir
          <Evidence level={4} /> <a href="#kaynak-1">[1]</a> <a href="#kaynak-2">[2]</a>.
        </p>
        <p>
          <strong>Yoğun veya uzun süren kanamayı, tedaviye ne zaman başlamış olursanız olun, planlı kontrolü
          beklemeden bildirin.</strong> HRT'ye başladıktan altı aydan veya doz/ilaç değişikliğinden üç
          aydan sonra devam eden ya da yeni başlayan beklenmedik kanama için de gecikmeden hekime başvurun.
          İlk aylardaki hafif lekelenmeyi üçüncü ay kontrolünde belirtin. Bu süreler, yoğun kanamayı veya
          kişisel riskleri olan birindeki kanamayı incelemeden bekletme önerisi değildir. Hekim kanama
          öyküsü ve kişisel risklere göre muayene, ultrason ve gerektiğinde ek inceleme planlar
          <a href="#kaynak-4">[4]</a>.
        </p>
        <p>
          Rahminiz ameliyatla alınmışsa vajinal kanamayı HRT'ye alışma belirtisi saymayın; hekiminize
          bildirin <a href="#kaynak-3">[3]</a>. HRT kullanmıyorsanız, son adetinizden en az bir yıl sonra
          ortaya çıkan kanama da bir kez olmuş veya az miktarda olsa bile değerlendirilmelidir
          <a href="#kaynak-7">[7]</a>.
        </p>

        <h2 id="ruh-hali-uyku">Ruh Hali, Baş Ağrısı ve Uyku</h2>
        <p>
          Sıcak basmalarınız azaldı ama gece yine uyanıyorsunuz. Bu çelişki insanın kafasını karıştırır.
        </p>
        <p>
          Uykunuz ve ruh haliniz, sıcak basmalarla aynı hızda düzelmeyebilir. Bu değişimleri ayrı ayrı
          kaydetmeniz, kontrolde neyin sürdüğünü anlatmanızı kolaylaştırır.
        </p>
        <p>
          Ruh hali değişiklikleri hem menopoz döneminde hem de HRT kullanırken görülebilir. Keyifsizlik
          veya duygusal dalgalanma günlük yaşamınızı zorlaştırıyorsa hekiminize anlatın. “Abartıyor muyum?”
          diye düşünüp susmayın. Bunları yalnızca “uyum dönemi” diyerek geçiştirmek de doğru olmaz
          <a href="#kaynak-2">[2]</a> <a href="#kaynak-3">[3]</a>.
        </p>
        <p>
          Hafif baş ağrısı başlangıçta görülebilir. Bir haftadan uzun sürüyorsa veya şiddetliyse hekimle
          görüşün <a href="#kaynak-3">[3]</a>. Migreniniz varsa ağrının alışılmış biçiminden farklı olup
          olmadığını ve görme değişikliği eşlik edip etmediğini de belirtin. Ani, çok şiddetli ağrı veya
          nörolojik belirtiler aşağıdaki acil değerlendirme sınırına girer.
        </p>
        <p>
          Uykuyu değerlendirirken gece terlemesiyle uyanmayı, uykuya dalma güçlüğünü ve ertesi günkü
          yorgunluğu ayırarak not edin. Her belirti için “ikinci ayda düzelir” gibi sabit bir
          süre vermem; bu dürüst bir söz olmaz. Kontrolde, tedavinin hedeflediği yakınmalarda ne kadar
          değişiklik olduğunu konuşun <a href="#kaynak-1">[1]</a>.
        </p>

        <h2 id="izleme-takvimi">İzleme Takvimi ve Kontrole Hazırlık</h2>
        <p>
          Takvim aslında basit. İlk kontrol yaklaşık üçüncü ayda, sonrasında en az yılda bir yapılır; yan
          etkiler veya yeterince düzelmeyen belirtiler varsa görüşme öne alınır.
        </p>
        <p>
          Üçüncü ayda sıcak basmaları, gece terlemeleri, kanama ve yan etkiler birlikte gözden geçirilir.
          İlacı nasıl kullandığınız da konuşulur. Doz veya uygulama yolunda değişiklik gerekip gerekmediği
          bu bilgilerle değerlendirilir. Altıncı ay kontrolü herkes için zorunlu bir basamak değildir;
          ihtiyaç varsa eklenir <Evidence level={4} /> <a href="#kaynak-1">[1]</a>.
        </p>
        <p>
          Yıllık görüşmede yeni sağlık sorunları, tedavinin yararı, olası riskler ve tansiyon gibi temel
          sağlık kontrolleri ele alınır. Menopozun olağan yaş aralığında hormon düzeyleri, HRT dozunu
          ayarlamak için rutin olarak ölçülmez; ihtiyaç belirtileriniz ve sağlık öykünüzle değerlendirilir
          <a href="#kaynak-10">[10]</a>. Ulusal tarama programları sürdürülür. HRT kullanmak tek başına
          herkese aynı kan testi, ultrason veya kemik yoğunluğu ölçümü listesini gerektirmez; gerekli
          incelemeler kişisel bulgular ve risklerle belirlenir <a href="#kaynak-1">[1]</a>.
        </p>
        <p>
          Türkiye'deki ulusal meme kanseri tarama programında, belirtisi olmayan 40–69 yaş arası kadınlar
          için iki yılda bir mamografi önerilir <a href="#kaynak-5">[5]</a>. Kişisel riskleriniz veya
          yeni bir meme bulgusu varsa hekiminiz farklı bir değerlendirme planlayabilir. Tarama takvimi,
          yeni bir kitleyi bildirmek için bekleme süresi değildir.
        </p>
        <p>
          Kontrole giderken kısa notlarınızı ve kullandığınız ilaçların listesini yanınıza alın. Benim ilk
          sorum genellikle şudur: “Sizi en çok ne rahatsız ediyor?” O belirtiyi ilk sırada söyleyin.
        </p>
        <p id="sik-sorulanlar">
          Hekiminize şu üç soruyu da sorabilirsiniz: “Tedaviden beklediğimiz yararı görüyor muyum?”, “Bu
          belirti için doz veya uygulama yolunu gözden geçirelim mi?” ve “Bir sonraki kontrolü beklemeden
          hangi durumda size ulaşmalıyım?”
        </p>

        <h2 id="ne-zaman-hekime">Planlı Kontrolü Beklememeniz Gereken Belirtiler</h2>
        <p>
          Bu listeyi korkmanız için değil, gerektiğinde tereddüt etmemeniz için yazıyorum. Bazı belirtiler
          aynı gün değerlendirme, bazıları acil yardım gerektirir.
        </p>
        <ul>
          <li><strong>112'yi arayın:</strong> Aniden başlayan nefes darlığı veya göğüs ağrısı varsa; ikisinin
            birlikte olmasını beklemeyin <a href="#kaynak-8">[8]</a>. Ani konuşma
            bozukluğu, yüzde kayma veya kol/bacakta tek taraflı güçsüzlük gelişirse de yardım çağırın. Acile kendiniz araç
            kullanarak gitmeyin <a href="#kaynak-3">[3]</a>.</li>
          <li><strong>112'yi arayın:</strong> Ani görme kaybı veya aniden başlayan, alışılmışın dışında çok
            şiddetli baş ağrısı varsa. İnme düşündüren belirtiler kısa sürede geçse bile yardım çağırın;
            bunları sıradan migren veya ilaç yan etkisi saymayın <a href="#kaynak-6">[6]</a>.</li>
          <li><strong>112'yi arayın:</strong> Dudak, dil veya boğazda ani şişme ile nefes alma ya da yutma
            güçlüğü gelişirse. Bunlar ciddi alerjik reaksiyon belirtisi olabilir <a href="#kaynak-3">[3]</a>.</li>
          <li><strong>Aynı gün değerlendirme alın:</strong> Bir bacakta şişlik, kızarıklık veya baldır ağrısı
            varsa. Bunlar damar içinde pıhtı belirtisi olabilir <a href="#kaynak-3">[3]</a>.</li>
          <li><strong>Kontrol tarihini beklemeden bildirin:</strong> Yoğun veya uzun süren kanama,
            tedavinin başlangıcından altı ay veya doz/ilaç değişikliğinden üç ay sonra devam eden ya da
            yeni başlayan beklenmedik kanama varsa <a href="#kaynak-4">[4]</a>.</li>
          <li><strong>Tarama tarihini beklemeden bildirin:</strong> Memede yeni kitle, meme başında
            değişiklik veya ciltte çekinti varsa <a href="#kaynak-3">[3]</a>.</li>
        </ul>
        <p>
          Şiddetli karın ağrısı, göz aklarında ya da ciltte sararma veya koyu idrarı gecikmeden
          değerlendirtin <a href="#kaynak-9">[9]</a>. Yeni başlayan çarpıntıyı da hekiminize bildirin;
          göğüs ağrısı, belirgin nefes darlığı veya bayılma eşlik ediyorsa 112'yi arayın
          <a href="#kaynak-11">[11]</a>. Bu liste bütün olası yan etkileri içermez;
          kendi ilacınızın kullanma talimatındaki uyarıları da izleyin.
        </p>
        <p>
          İlk aylarda kaygı duymanız çok anlaşılır. Her ayrıntıyı kendi başınıza çözmeniz gerekmez.
          Rahatsızlığınızı açıkça anlatın, güvenlik belirtilerinde beklemeyin. Gerisini hekiminizle
          birlikte konuşursunuz.
        </p>

        <h2 id="kaynaklar">Kaynaklar</h2>
        <p>Yan etkiler, kanama değerlendirmesi ve takip planı için kullanılan seçilmiş kaynaklar:</p>
        <ol>
          <li id="kaynak-1"><a href="https://www.nice.org.uk/guidance/ng23/chapter/Recommendations" target="_blank" rel="noopener noreferrer">NICE NG23 — Menopoz: tanı ve yönetim; 1.5.6, 1.8.4–1.8.5 ve 1.9, 2026 güncellemesi</a>. Sistemik ve lokal tedavi ayrımı, ilk kontrol, yıllık izlem ve kanama değerlendirme süreleri.</li>
          <li id="kaynak-2"><a href="https://www.nhs.uk/medicines/hormone-replacement-therapy-hrt/side-effects-of-hormone-replacement-therapy-hrt/" target="_blank" rel="noopener noreferrer">NHS — Hormon tedavisinin yan etkileri</a>. Genel yan etkiler ve tedavi düzenine göre kanama.</li>
          <li id="kaynak-3"><a href="https://www.nhs.uk/medicines/hormone-replacement-therapy-hrt/oestrogen-tablets-patches-gel-and-spray/side-effects-of-oestrogen-tablets-patches-gel-and-spray/" target="_blank" rel="noopener noreferrer">NHS — Östrojen tabletleri, bantları, jel ve spreylerin yan etkileri</a>. Belirtiye göre yardım arama sınırları.</li>
          <li id="kaynak-4"><a href="https://thebms.org.uk/publications/bms-guidelines/management-of-unscheduled-bleeding-on-hormone-replacement-therapy-hrt/" target="_blank" rel="noopener noreferrer">British Menopause Society — HRT sırasında beklenmedik kanamanın yönetimi; Mayıs 2026'da gözden geçirilen ortak kılavuz</a>. Kanama süresi, miktarı ve kişisel risklere göre inceleme.</li>
          <li id="kaynak-5"><a href="https://www.saglik.gov.tr/TR-100021/ekim-ayi-tum-dunyada-meme-kanseri-farkindalik-ayidir.html" target="_blank" rel="noopener noreferrer">T.C. Sağlık Bakanlığı — Meme kanseri farkındalığı ve ulusal tarama aralığı</a>. 40–69 yaşta iki yılda bir mamografi.</li>
          <li id="kaynak-6"><a href="https://www.nhs.uk/conditions/stroke/symptoms/" target="_blank" rel="noopener noreferrer">NHS — İnme belirtileri</a>. Ani görme kaybı, şiddetli baş ağrısı ve belirtiler geçse bile acil yardım gerektiren durumlar.</li>
          <li id="kaynak-7"><a href="https://www.nhs.uk/symptoms/post-menopausal-bleeding/" target="_blank" rel="noopener noreferrer">NHS — Menopoz sonrası kanama</a>. HRT dışındaki menopoz sonrası kanamada değerlendirme; 24 Eylül 2026'da gözden geçirilmiş.</li>
          <li id="kaynak-8"><a href="https://www.nhs.uk/conditions/pulmonary-embolism/" target="_blank" rel="noopener noreferrer">NHS — Akciğer damarında pıhtı</a>. Ani nefes darlığı veya göğüs ağrısında acil yardım; 15 Ekim 2026'da gözden geçirilmiş.</li>
          <li id="kaynak-9"><a href="https://medlineplus.gov/druginfo/meds/a601041.html" target="_blank" rel="noopener noreferrer">MedlinePlus — Östrojen ve progestin hormon tedavisi</a>. Sarılık, koyu idrar ve karın ağrısı gibi ciddi yan etki uyarıları.</li>
          <li id="kaynak-10"><a href="https://thebms.org.uk/2026/06/new-whc-fact-sheet-hormone-blood-tests-in-the-menopause-transition/" target="_blank" rel="noopener noreferrer">British Menopause Society — Menopoz geçişinde hormon kan testleri; 22 Haziran 2026</a>. Menopozun olağan yaş aralığında HRT izleminde rutin hormon testi gerekmemesi.</li>
          <li id="kaynak-11"><a href="https://www.uhsussex.nhs.uk/resources/palpitations-emergency-department-leaflet/" target="_blank" rel="noopener noreferrer">University Hospitals Sussex NHS — Çarpıntıda değerlendirme ve acil yardım belirtileri</a>. Göğüs ağrısı, şiddetli nefes darlığı veya bayılmayla birlikte çarpıntı.</li>
        </ol>
