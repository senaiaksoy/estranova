---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuHero from '../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../components/site/ArticleAuthorBlock.astro';
import SaveForLaterButton from '../../components/site/SaveForLaterButton.astro';
import ReadingControls from '../../components/site/ReadingControls.astro';
import RedFlagBox from '../../components/site/RedFlagBox.astro';
import ArticleTOC from '../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../components/site/ArticleSummary.astro';
import RelatedReadings from '../../components/site/RelatedReadings.astro';
import Evidence from '../../components/site/Evidence.astro';
import { submenuHeroByRoute } from '../../data/submenu-heroes';
import { articleFaqs } from '../../data/article-faqs';
import { buildArticleSchemas } from '../../utils/article-schema';
import { resolveSiteUrl } from '../../utils/seo';

// ADAY SÜRÜM (onay-bekleyen) — canlı rota src/pages/zamansiz-yasam/ altındaki dosyadır.
// Bu dosya yazar onayı ve kontrol formu gelmeden canlıya alınmaz.

const pathname = '/zamansiz-yasam/40-sonrasi-diz-agrisi-izlem-mudahale/';
const hero =
  submenuHeroByRoute[pathname] ??
  submenuHeroByRoute['/zamansiz-yasam/40-sonrasi-kas-iskelet-agrilari/'] ??
  submenuHeroByRoute['/zamansiz-yasam/']!;

const articleTitle = '40 Sonrası Diz Ağrısı: Ne Zaman İzlem, Ne Zaman Müdahale?';
const seoTitle = '40 Sonrası Diz Ağrısı: İzlem mi Müdahale mi?';
const articleDescription =
  '40 sonrası diz ağrısında MR raporuna sıkışmadan; şiddet, süre, işlev kaybı ve müdahale eşikleri üzerinden karar vermeyi anlatan ortopedik takip rehberi.';

const tocEntries = [
  { id: 'tek-cumle', label: 'Tek Cümleye Sıkıştırmamak' },
  { id: 'mekanizmalar', label: 'Mekanizmalar' },
  { id: 'izlem', label: 'İzlem Dönemi' },
  { id: 'mudahale', label: 'Müdahale Eşikleri' },
  { id: 'kirmizi-bayraklar', label: 'Kırmızı Bayraklar' },
  { id: 'karar-zinciri', label: 'Karar Zinciri' },
  { id: 'sss', label: 'Sık Sorulanlar' },
  { id: 'sonuc', label: 'Sonuç' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const faqItems = articleFaqs[pathname] ?? [];
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'bulent-aksoy',
  articleType: 'clinical-guide',
  publishedDate: '8 Mayıs 2026',
  modifiedDate: '14 Ekim 2026',
  pathname: pathname,
  articleSection: 'Zamansız Yaşam',
  sectionPath: '/zamansiz-yasam/',
  keywords: [
    '40 sonrası diz ağrısı',
    'diz ağrısı izlem',
    'diz ağrısı müdahale',
    'diz osteoartriti',
    'menisküs yırtığı',
    'konservatif tedavi',
    'ortopedik takip',
    'diz ağrısı kırmızı bayrak',
  ],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/zamansiz-yasam/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Ortopedik Takip"
      title={articleTitle}
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="bulent-aksoy"
        articleType="clinical-guide"
        publishedDate="8 Mayıs 2026"
        lastUpdated="14 Ekim 2026"
        readingMinutes={8}
        imageSrc="/images/library/editorial/zy-diz-agrisi-ortopedik-takip.png"
        imageAlt="Boğaz manzaralı sakin bir iç mekanda, diz sağlığı ve ortopedik takip temasını taşıyan olgun kadın portresi"
      />

      <div class="flex flex-wrap items-center justify-end gap-3">
        <ReadingControls />
        <SaveForLaterButton slug={pathname} title={articleTitle} />
      </div>

      <ArticleSummary title="Kısa Özet">
        <p>
          Birçok kadın 40 sonrası diz ağrısını bir sabah aniden başlamış gibi yaşar. Oysa tablo genellikle daha uzun bir
          sürecin sonucudur: azalan kas gücü, değişen hareket alışkanlıkları, kilo dağılımındaki farklılaşma, uykusuzluk
          ve zaman zaman eski küçük travmaların birikimi. Bu yüzden ilk soru "hemen müdahale gerekir mi?" olmamalı.
          "Bu ağrının hangi kısmı izlemle düzelebilir?" sorusu daha doğru bir başlangıçtır. Cerrahi seçenek doğru hasta
          için değerlidir, ama pek çok kişide ilk güçlü adım, iyi planlanmış konservatif yaklaşımdır.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="tek-cumle">Diz Ağrısını Tek Cümleye Sıkıştırmamak Neden Önemli?</h2>
        <p class="italic">
          MR raporu dizin yapısını anlatır. Merdiven çıkıp çıkamadığınızı ya da yürürken nerede durmak zorunda kaldığınızı
          anlatmaz.
        </p>
        <p>
          Muayene odasında en sık duyduğumuz cümle şu: "MR'da kireçlenme var." Bu bilgi önemlidir, ama tek başına tedavi
          kararı vermez. Aynı raporu taşıyan iki kişinin günlük hayatı çok farklı olabilir. Biri merdiven çıkabiliyor,
          diğeri 15 dakikalık bir yürüyüşte durmak zorunda kalıyor. Görüntü tek başına yetmez.
        </p>
        <p>
          Ağrı uzadıkça insanın kaygılanması çok anlaşılır bir tepkidir. Değerlendirmede dört soruya birlikte bakarız: ağrı ne
          kadar şiddetli, ne kadar süredir var, gün içinde nasıl davranıyor ve hareketinizi nasıl etkiliyor? Sabah kısa süren
          tutuklukla başlayıp gün içinde açılan bir diz ile gece sizi uyandıran, dinlenirken bile süren bir ağrı aynı tablo
          değildir. İki durumu ayırmak, gereksiz panik kadar gereksiz beklemeyi de önler.
        </p>

        <h2 id="mekanizmalar">40 Sonrası Dizde Öne Çıkan Mekanizmalar</h2>
        <p class="italic">
          Eklem yüzeyi yalnız başına tabloyu açıklamaz; kas, tendon ve yüklenme ritmi de payını alır.
        </p>
        <p>
          Hormonal geçişle birlikte kas kütlesinde azalma görülebilir; kas gücü düştüğünde diz eklemi günlük hayatta daha
          yüksek mekanik yük hisseder. Özellikle kuadriseps ve kalça çevresi kasların zayıflığı, merdiven inişinde ve uzun
          yürüyüşlerde dizin daha hızlı yorulmasına yol açabilir <Evidence from={4} to={5} />.
        </p>
        <p>
          Sık yapılan bir hata, yükün tamamını "kıkırdak aşınması"na yüklemektir; oysa diz kendi başına çalışmaz. Kalça kontrolü,
          ayak bileği hareketliliği, gövde dengesi ve yürüme paterni bir zincir gibi birbirine bağlıdır. Zincirin bir halkası
          zayıfladığında ağrı dizde görünür hale gelir. Dizinizdeki ağrının nedeni, zincirin başka bir halkasında da olabilir.
          Bu yüzden değerlendirmeyi yalnızca dize bakarak değil, tüm alt ekstremiteyi bir bütün olarak okuyarak yaparız.
        </p>

        <h2 id="izlem">İzlem Dönemi: Uygun Olduğu Durumlar ve Planın Yapısı</h2>
        <p class="italic">
          Bu dönemde hedefler somut ve ölçülebilir olur; plan aktif bir tedavi süreci olarak yürür.
        </p>
        <p>
          Şiddeti hafif ya da orta düzeyde olan, travma öyküsü, belirgin instabilite, kilitlenme veya nörovasküler uyarı
          bulgusu bulunmayan diz ağrılarında ilk yaklaşım çoğu zaman konservatif izlem olmalıdır. Bu dönemin amacı ağrıyı
          tamamen sıfırlamak değil, işlevinizi geri kazanmaktır. Ağrı tam geçmeden de günlük hayatınıza güvenle
          dönebilirsiniz.
        </p>
        <p>
          İyi bir izlem planı genellikle 8-12 haftalık bir çerçevede kurulur. Yaşınız, bulgularınız ve işlev kaybınız dikkate
          alınarak kişiselleştirilir. Çoğu zaman şu bileşenler yer alır:
        </p>
        <ul>
          <li><strong>Aktivite doz ayarı:</strong> Tam istirahat yerine yüklenmeyi düzenlemek.</li>
          <li><strong>Hedefli egzersiz:</strong> Diz çevresi kas güçlendirme, kalça stabilitesi, hareket açıklığı çalışmaları.</li>
          <li><strong>Günlük yaşam düzeni:</strong> Merdiven, uzun süre ayakta kalma ve çömelme gibi yükü artıran hareketleri geçici olarak ayarlamak.</li>
          <li><strong>Kilo ve uyku desteği:</strong> Eklem yükünü azaltan ve toparlanmayı kolaylaştıran temel başlıklar.</li>
          <li><strong>Ağrı günlüğü:</strong> Hangi etkinlikten sonra ne kadar ağrı hissettiğinizi ve ertesi gün işlevinizin nasıl değiştiğini not etmek.</li>
        </ul>
        <p>
          Bu yaklaşımın özü, sizi ameliyat masasından önce hayata yönlendirmektir. Konservatif plan iyi yürüdüğünde birçok
          hastada hem ağrı hem hareket kısıtlılığı belirgin biçimde azalır.
        </p>

        <h2 id="mudahale">Müdahale Eşikleri: Kararın Dayandığı Bulgular</h2>
        <p class="italic">
          Karar, ağrının varlığına bakılarak verilmez; tedaviye yanıt vermeyen işlev kaybı belirleyicidir.
        </p>
        <p>
          Plan doğru uygulanmasına rağmen yaşam kaliteniz belirgin biçimde düşmeye devam ediyorsa bir üst basamağa geçmek
          gerekir. Bunun için tek bir ölçüt yoktur, ama birkaç klinik eşik yol gösterir.
        </p>
        <p>
          8-12 haftalık düzenli izlem sonrasında aşağıdaki bulgular devam ediyorsa müdahale gündeme alınır:
        </p>
        <ul>
          <li>Gece ağrısının sürmesi veya artması</li>
          <li>Yürüme mesafesinde belirgin kısalma</li>
          <li>Merdiven inip çıkmada giderek artan zorlanma</li>
          <li>Dizde kilitlenme, takılma veya boşalma hissinin sıklaşması</li>
          <li>Günlük işlevlerde belirgin bağımlılık ve yaşam kalitesinde düşüş</li>
        </ul>
        <p>
          "Müdahale" her zaman ameliyat demek değildir; uygun durumda, hekiminizin kararıyla hedefli enjeksiyon seçenekleri,
          rehabilitasyon protokolünün yeniden düzenlenmesi, biyomekanik desteklerin değerlendirilmesi veya ileri ortopedik
          inceleme ara basamak olarak kullanılabilir. Cerrahi, bu zincirin sonunda doğru endikasyonla değerlendirildiğinde
          anlam kazanır.
        </p>

        <h2 id="kirmizi-bayraklar">Kırmızı Bayraklar: Hızlı Değerlendirme Gerektiren Belirtiler</h2>
        <p class="italic">
          Bazı belirtilerde beklemek yerine doğrudan ortopedik değerlendirme gerekir.
        </p>
        <p>
          Her diz ağrısı acil değildir, ama aşağıdaki bulgulardan biri sizde varsa gecikmeden değerlendirme alınmalıdır:
        </p>
        <RedFlagBox
          markers={[
            'Travma sonrası üzerine basamama',
            'Dizde kısa sürede artan şişlik ve belirgin ısı artışı',
            'Ateşle birlikte diz ağrısı',
            'İstirahatte de süren ve şiddeti artan ağrı',
            'Bacakta güç kaybı, belirgin dengesizlik veya ani fonksiyon kaybı',
            'Baldırda tek taraflı şişlik, kızarıklık, belirgin hassasiyet veya nefes darlığının eşlik etmesi',
          ]}
          footnote="Bu belirtiler tanıyı tek başına koydurmaz; enfeksiyon, ciddi bağ-yumuşak doku hasarı, kırık veya damar kaynaklı acil durumların hızlı dışlanmasını gerektirebilir."
        />

        <h2 id="karar-zinciri">Hasta-Hekim Görüşmesinde Karar Zinciri</h2>
        <p class="italic">
          Doğru karar, ortak hedef konuşulduğunda oluşur; tek bir cümlelik reçete bunun yerini tutmaz.
        </p>
        <p>İyi bir muayenede şu soruları sormanız süreci netleştirir:</p>
        <ol>
          <li>Bu ağrının ana mekanizması sizce mekanik yüklenme mi, inflamasyon mu, ikisinin karışımı mı?</li>
          <li>İlk 2-3 ay için gerçekçi hedefimiz nedir: ağrı azalması mı, yürüme mesafesi mi, merdiven kapasitesi mi?</li>
          <li>Hangi bulgu ortaya çıkarsa izlemden daha ileri müdahaleye geçmeyi konuşacağız?</li>
          <li>Benim yaşam düzenime uygun egzersiz ve takip planı nasıl olmalı?</li>
          <li>Cerrahi dışı seçeneklerin beklenen kazanımı ve sınırı nedir?</li>
        </ol>
        <p>
          Bu sorular belirsizliğinizi azaltır ve karar sürecini ölçülebilir hâle getirir. Tedavinin başarısı çoğu zaman doğru
          ilacı seçmek kadar iyi iletişim kurmaya da bağlıdır.
        </p>

        <h2 id="sss">Sık Sorulan Kısa Sorular</h2>
        <p class="italic">
          Aşağıda, sık aklınıza takılan dört sorunun kısa yanıtları var.
        </p>

        <h3>Dizimde ağrı varken yürüyüş yapabilir miyim?</h3>
        <p>
          Çoğu durumda evet. Süre ve tempo kişiye göre ayarlanmalıdır; ağrıyı artıran uzun yürüyüşler yerine kısa ve düzenli
          yürüyüşler tercih edilir.
        </p>

        <h3>MR'da menisküs yırtığı yazıyorsa ameliyat şart mı?</h3>
        <p>
          Hayır. Menisküs bulgusu klinik muayene ve işlev kaybıyla birlikte yorumlanır. Her menisküs bulgusu ameliyat
          gerektirmez.
        </p>

        <h3>Kilo vermek gerçekten diz ağrısını azaltır mı?</h3>
        <p>
          Fazla kilosu olan kişilerde genellikle evet. Vücut ağırlığındaki azalma, diz eklemine binen yükü azaltır ve hareket
          toleransını artırır.
        </p>

        <h3>Ne kadar süre konservatif plan denenmeli?</h3>
        <p>
          Genellikle 8-12 hafta. Bu sürede ölçülebilir iyileşme yoksa müdahale basamakları yeniden değerlendirilir.
        </p>

        <h2 id="sonuc">Sonuç: Doğru Sıra Kurulduğunda Karar Netleşir</h2>
        <p class="italic">
          İzlem ile müdahale aynı yolun iki basamağıdır.
        </p>
        <p>
          40 sonrası diz ağrısında en güvenli yaklaşım; konservatif planla başlamak, yanıtı düzenli izlemek ve gerektiğinde
          müdahaleyi gecikmeden devreye almaktır. Cerrahi için ne "hemen" ne de "asla" denebilir. Doğru hasta, doğru zaman ve
          doğru endikasyonla anlam kazanır.
        </p>
        <p>
          Ağrı puanının düşmesi önemlidir, ama asıl hedef yürüyebilmek, merdiven çıkabilmek, geceleri rahat uyuyabilmek ve
          günlük hayatı daha az kaygıyla sürdürebilmektir. Ortopedi hekiminizle birlikte kuracağınız açık bir karar zinciri,
          tedavinin en güçlü başlangıç noktasıdır.
        </p>
      </ArticleProsePanel>

      <RelatedReadings
        class="mt-14"
        paths={[
          '/zamansiz-yasam/40-sonrasi-kas-iskelet-agrilari/',
          '/zamansiz-yasam/kemik-gucu-kirigi-beklemeden-sorulacak-sorular/',
          '/zamansiz-yasam/kilo-artisi-menopoz/',
          '/hormonal-gecis/40-sonrasi/tarama-testleri/',
        ]}
      />

      <ArticleEditorNote>
        <p class="mb-4 text-lg font-semibold text-ink">Kanıt Düzeyi: <Evidence from={4} to={5} /></p>
        <div class="space-y-3 leading-relaxed text-ink/80">
          <p class="italic">
            Bu yazı genel bilgilendirme amaçlıdır; bireysel tanı ve tedavi önerisi yerine geçmez.
          </p>
          <p>
            <strong class="text-primary">Klinik not:</strong> 40 sonrası diz ağrısında ilk basamak yaklaşımın konservatif plan
            olması, güncel ortopedi ve rehabilitasyon kılavuzlarıyla uyumludur. Ağrı şiddeti kadar işlev kaybının,
            yürüme kapasitesinin ve günlük yaşam etkisinin birlikte değerlendirilmesi klinik karar kalitesini artırır.
          </p>
          <p>
            Cerrahi kararında temel belirleyici, görüntüleme sonucu tek başına değil; iyi uygulanmış izlem dönemine rağmen
            devam eden işlev kaybıdır. Bu nedenle hasta-hekim görüşmesinde hedeflerin netleştirilmesi, takip süresinin baştan
            konuşulması ve kırmızı bayrak bulgularının açıkça tanımlanması önemlidir.
          </p>
          <p>
            Özellikle travma sonrası üzerine basamama, gece artan istirahat ağrısı, hızlı gelişen şişlik, ateş eşlik eden
            eklem yakınması, belirgin güç kaybı veya baldırda tek taraflı şişlik-kızarıklık gibi bulgularda gecikmeden
            değerlendirme gerekir.
          </p>
        </div>
      </ArticleEditorNote>

      <ArticleDisclaimer>
        <p>
          Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavinin yerini almaz. Kendi
          durumunuza uygun izlem ve müdahale planını ortopedi hekiminizle bireysel olarak belirleyiniz.
        </p>
      </ArticleDisclaimer>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
