---
interface Props {
  href: string;
  label: string;
  icon: 'flame' | 'moon' | 'heart' | 'scale' | 'bone' | 'brain' | 'sparkles' | 'leaf';
}

const { href, label, icon } = Astro.props;
---

<a
  href={href}
  class="group flex items-center gap-3 rounded-2xl border border-primary/18 bg-white px-4 py-3.5 text-left text-sm font-medium text-ink shadow-sm transition hover:-translate-y-0.5 hover:border-primary/35 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-primary/30 md:text-[0.9375rem]"
>
  <span
    class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-cream-soft text-primary ring-1 ring-primary/10 transition group-hover:bg-primary/8"
    aria-hidden="true"
  >
    {
      icon === 'flame' && (
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-2.5-1.2-4.8-2.5-6.5-1.3 1.7-2.5 4-2.5 6.5a2.5 2.5 0 0 0 5 0Z" />
          <path d="M12 3c1.2 2.2 3 5.2 3 8a3 3 0 1 1-6 0c0-2.8 1.8-5.8 3-8Z" />
        </svg>
      )
    }
    {
      icon === 'moon' && (
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 14.5A8.5 8.5 0 0 1 9.5 3 8.5 8.5 0 1 0 21 14.5Z" />
        </svg>
      )
    }
    {
      icon === 'heart' && (
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 14c0 3-7 7-7 7s-7-4-7-7a4.5 4.5 0 0 1 8-2.7A4.5 4.5 0 0 1 19 14Z" />
        </svg>
      )
    }
    {
      icon === 'scale' && (
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3 3 9v1a9 9 0 0 0 18 0V9Z" />
          <path d="M7 14h10" />
          <path d="M12 14v7" />
        </svg>
      )
    }
    {
      icon === 'bone' && (
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 3a2 2 0 0 1 2 2v1h2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-2v1a2 2 0 1 1-4 0v-1H9v1a2 2 0 1 1-4 0v-1H3a2 2 0 0 1-2-2v-2a2 2 0 0 1 2-2h2V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v1h2V5a2 2 0 0 1 2-2Z" />
        </svg>
      )
    }
    {
      icon === 'brain' && (
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5a3 3 0 0 0-3 3v1H7a2 2 0 0 0-2 2v2c0 1.1.9 2 2 2h2v1a3 3 0 0 0 6 0v-1h2a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2h-2V8a3 3 0 0 0-3-3Z" />
          <path d="M8 15h8" />
        </svg>
      )
    }
    {
      icon === 'sparkles' && (
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9.5 2 11 7l5 1.5L11 10l-1.5 5L8 10 3 8.5 8 7z" />
          <path d="M19 14l1 2 2 1-2 1-1 2-1-2-2-1 2-1z" />
        </svg>
      )
    }
    {
      icon === 'leaf' && (
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M11 20C6.5 16.5 4 12 4 8a6 6 0 0 1 11-3c3.5 0 6 2.5 6 6 0 4.5-3.5 9-10 9Z" />
          <path d="M12 20V10" />
        </svg>
      )
    }
  </span>
  <span class="min-w-0 leading-snug">{label}</span>
</a>
