---
import ArticleMetaSigil from './ArticleMetaSigil.astro';

interface Props {
  href: string;
  title: string;
  excerpt: string;
  imageSrc: string;
  imageAlt: string;
  /** Büyük numara (ör. 01); yoksa gösterilmez */
  step?: string;
  cta?: string;
  /** Okuma süresi (dk) — verildiğinde alt meta sigili gösterilir */
  readingMinutes?: number;
  /** Kanıt düzeyi (Sınırlı | Orta | Güçlü) */
  evidence?: 'Sınırlı' | 'Orta' | 'Güçlü';
  /** Son güncelleme tarihi (ör. "Şub 2026") */
  updated?: string;
}

const {
  href,
  title,
  excerpt,
  imageSrc,
  imageAlt,
  step,
  cta = 'Yazıyı aç',
  readingMinutes,
  evidence,
  updated,
} = Astro.props;
---

<a
  href={href}
    class="group relative flex h-full flex-col overflow-hidden rounded-[36px] border border-primary/12 bg-white shadow-[0_26px_82px_-58px_rgba(44,22,28,0.30)] ring-1 ring-black/[0.04] transition duration-300 hover:-translate-y-1 hover:border-gold/45 hover:bg-cream-soft/20 hover:shadow-[0_36px_106px_-62px_rgba(44,22,28,0.40)] focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/35 focus-visible:ring-offset-2"
>
  <div class="pointer-events-none absolute inset-x-7 top-0 z-10 h-px bg-gradient-to-r from-transparent via-gold/70 to-transparent"></div>
  <div class="pointer-events-none absolute right-6 top-6 z-20 hidden text-[10px] font-bold uppercase tracking-[0.28em] text-white/72 md:block">
    Estranova
  </div>
  <div class="relative aspect-[4/3] overflow-hidden rounded-b-[32px]">
    <img
      src={imageSrc}
      alt={imageAlt}
      width="600"
      height="225"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]"
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1c1412]/58 via-[#1c1412]/18 to-transparent" />
    <div class="pointer-events-none absolute inset-x-5 bottom-5 h-px bg-gradient-to-r from-cream-warm/85 via-white/55 to-transparent"></div>
    {
      step && (
        <span class="absolute bottom-7 left-5 font-serif text-5xl font-medium italic tabular-nums text-white/95 drop-shadow-[0_10px_28px_rgba(0,0,0,0.28)] md:text-7xl">
          {step}
        </span>
      )
    }
  </div>
  <div class="relative flex flex-1 flex-col p-6 md:p-7">
    <p class="mb-4 flex items-center gap-3 text-[10px] font-bold uppercase tracking-[0.24em] text-gold-bronze">
      <span class="h-px w-8 bg-gold/70"></span>
      <span>Bölüm Dosyası</span>
    </p>
    <h2 class="mb-3 font-serif text-3xl leading-[0.98] tracking-[-0.025em] text-ink transition group-hover:text-primary md:text-4xl">{title}</h2>
    <p class="mb-6 flex-1 leading-relaxed text-ink/72">{excerpt}</p>
    {readingMinutes && (
      <div class="mb-3">
        <ArticleMetaSigil readingMinutes={readingMinutes} evidence={evidence} updated={updated} />
      </div>
    )}
    <span class="inline-flex items-center gap-2 border-t border-primary/10 pt-4 text-sm font-semibold text-primary group-hover:underline">
      {cta}
      <span class="text-gold transition group-hover:translate-x-1" aria-hidden="true">→</span>
    </span>
  </div>
</a>
