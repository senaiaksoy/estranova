---
interface Props {
  class?: string;
  variant?: 'article' | 'footer';
}

const { class: className, variant = 'article' } = Astro.props;
const preferredSourceUrl = 'https://google.com/preferences/source?q=estranova.com';
---

{
  variant === 'footer' ? (
    <a
      href={preferredSourceUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-preferred-source-link
      data-preferred-source-surface="footer"
      class:list={[
        'rounded px-2 py-1 transition-colors hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50',
        className,
      ]}
      title="Estranova'yı Google kaynak tercihlerine ekle"
    >
      GOOGLE KAYNAK TERCİHİ
    </a>
  ) : (
    <section
      aria-labelledby="preferred-source-title"
      class:list={[
        'relative overflow-hidden rounded-[30px] border border-primary/14 bg-cream-warm/55 p-6 shadow-[0_22px_60px_-46px_rgba(44,22,28,0.28)] ring-1 ring-black/[0.03] md:p-7',
        className,
      ]}
    >
      <div class="pointer-events-none absolute right-0 top-0 h-24 w-24 rounded-bl-full bg-primary/[0.045]"></div>
      <p class="relative mb-3 flex items-center gap-3 text-[10px] font-bold uppercase tracking-[0.24em] text-primary">
        <span class="h-px w-8 bg-gold/70"></span>
        <span>Google kaynak tercihi</span>
      </p>
      <div class="relative grid gap-5 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <h2 id="preferred-source-title" class="font-serif text-2xl leading-tight text-ink md:text-3xl">
            Estranova'yı Google'da kaynak olarak ekleyin
          </h2>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink/72 md:text-base">
            Estranova okuma akışınızda görünür kalsın isterseniz, Google kaynak tercihlerinizde siteyi işaretleyebilirsiniz.
          </p>
        </div>
        <a
          href={preferredSourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-preferred-source-link
          data-preferred-source-surface="article"
          class="inline-flex items-center justify-center rounded-full border border-primary/24 bg-white px-5 py-3 text-xs font-bold uppercase tracking-[0.18em] text-primary shadow-[0_14px_36px_-28px_rgba(44,22,28,0.4)] transition hover:border-primary/45 hover:bg-primary hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/45"
        >
          Kaynak tercihine ekle
        </a>
      </div>
    </section>
  )
}
