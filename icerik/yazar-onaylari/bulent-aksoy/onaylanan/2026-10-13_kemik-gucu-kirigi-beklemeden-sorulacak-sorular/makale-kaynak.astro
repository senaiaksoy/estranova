---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuHero from '../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../components/site/ArticleAuthorBlock.astro';
import SaveForLaterButton from '../../components/site/SaveForLaterButton.astro';
import ReadingControls from '../../components/site/ReadingControls.astro';
import RedFlagBox from '../../components/site/RedFlagBox.astro';
import ArticleTOC from '../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../components/site/ArticleSummary.astro';
import Evidence from '../../components/site/Evidence.astro';
import RelatedReadings from '../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../components/site/ArticleFAQ.astro';
import { submenuHeroByRoute } from '../../data/submenu-heroes';
import { articleFaqs } from '../../data/article-faqs';
import { buildArticleSchemas } from '../../utils/article-schema';
import { resolveSiteUrl } from '../../utils/seo';

const pathname = '/zamansiz-yasam/kemik-gucu-kirigi-beklemeden-sorulacak-sorular/';
const hero = submenuHeroByRoute['/zamansiz-yasam/']!;
const faqItems = articleFaqs[pathname] ?? [];

const tocEntries = [
  { id: 'sessiz-baslar', label: 'Sessiz Başlar' },
  { id: 'osteopeni-osteoporoz', label: 'Rapor ve Osteopeni' },
  { id: 'risk-faktorleri', label: 'Risk Etkenleri' },
  { id: 'kemik-taramasi', label: 'DXA Taraması' },
  { id: 'kas-denge', label: 'Kas ve Denge' },
  { id: 'beslenme', label: 'Beslenme ve D Vitamini' },
  { id: 'turkiye-baglami', label: 'Türkiye Bağlamı' },
  { id: 'tibbi-secenekler', label: 'Tıbbi Seçenekler' },
  { id: 'kirmizi-bayraklar', label: 'Kırmızı Bayraklar' },
  { id: 'karar-zinciri', label: 'Karar Zinciri' },
  { id: 'sik-sorulanlar', label: 'Sıkça Sorulanlar' },
  { id: 'kaynaklar', label: 'Kaynaklar' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Kemik Gücü: Kırığı Beklemeden Sorulacak Sorular';
const articleDescription =
  '40 sonrası kemik gücünü kırık yaşanmadan önce konuşmak için tarama, düşme riski, kas gücü ve beslenme başlıklarını bir araya getiriyoruz.';
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'bulent-aksoy',
  articleType: 'clinical-guide',
  publishedDate: '1 Haziran 2026',
  modifiedDate: '13 Ekim 2026',
  pathname,
  articleSection: 'Zamansız Yaşam',
  sectionPath: '/zamansiz-yasam/',
  keywords: [
    'kemik gücü',
    '40 sonrası kemik sağlığı',
    'osteoporoz',
    'kırık riski',
    'düşme riski',
    'direnç egzersizi',
    'D vitamini',
    'ortopedik takip',
  ],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${articleTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/zamansiz-yasam/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Kemik Sağlığı"
      title={articleTitle}
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="bulent-aksoy"
        articleType="clinical-guide"
        publishedDate="1 Haziran 2026"
        lastUpdated="13 Ekim 2026"
        readingMinutes={12}
        imageSrc="/images/library/editorial/bulent-kemik-gucu-kirik-beklemeden-byline.webp"
        imageAlt="Aydınlık bir evde pencere yanında oturan 50+ kadın; kemik gücü, kırık riski ve koruyucu ortopedik takip temasını taşıyan sakin editoryal görsel"
        imagePosition="50% center"
      />

      <div class="flex flex-wrap items-center justify-end gap-3">
        <ReadingControls />
        <SaveForLaterButton slug={pathname} title={articleTitle} />
      </div>

      <ArticleSummary title="Kısa Özet">
        <p>
          Kemik kaybı çoğu zaman sessiz ilerler; ilk işaret bazen yıllar sonra gelen bir kırıktır. Kemik ölçümü tek
          başına karar vermez: yaş, kırık öyküsü, kullanılan ilaçlar, düşme riski ve diğer risk etkenleriyle birlikte
          okunur. Korunmak için kalsiyum tek başına yetmez; kas gücü, denge, beslenme ve doğru zamanda tarama birlikte
          planlanır.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="sessiz-baslar">Kemik Kaybı Çoğu Zaman Sessiz Başlar</h2>
        <p>
          Kemik sağlığının zor tarafı, günlük hayatta kendini gürültülü biçimde belli etmemesidir. Bir eklem ağrır, kas
          tutulur, bel uyarır; kemik ise uzun süre sessiz kalabilir. Sessizlik çoğu zaman güvence sayılır; oysa bir şey
          hissetmemek kemiğin iyi olduğunu kanıtlamaz. Bunu sizi suçlamak için söylemiyorum.
        </p>
        <p>
          Kemik canlı bir dokudur; yapım ve yıkım dengesi içinde sürekli yenilenir. Menopoz geçişiyle östrojen
          düzeyindeki azalma, bazı kadınlarda kemik yıkımını hızlandırabilir <Evidence level={5} />. Menopozdan sonraki
          ilk 5–10 yılda kemik mineral yoğunluğundaki düşüş hızlanabilir <sup><a href="#ref-1">[1]</a></sup>. Bu yüzden
          hedef yalnızca rapordaki rakam olmamalı; duruşunuzu, dengenizi ve ileride kendi başınıza hareket edebilmenizi
          korumak da bu işin parçasıdır.
        </p>
        <p>
          Ortopedide benim önemsediğim çizgi, hastayı ameliyat masasından önce hayata yönlendirebilmektir. Kemik
          sağlığında bunun karşılığı, kırık olduktan sonra telaşla konuşmaya başlamak yerine riskleri kırık gelmeden
          görünür kılmaktır. Koruyucu akıl çoğu zaman dramatik bir müdahale anında devreye girmez. Günlük hayatın küçük
          kararlarında sessizce çalışmaya başlar.
        </p>
        <p>
          Asansör çalışmadığında iki kat çıkmak, mutfakta üst rafa uzanmak ya da kaldırım kenarında bir an duraksamak,
          kemiğin yanında onu taşıyan bütün sistemin nasıl çalıştığını hatırlatır. Bu yalnızca bir gündelik benzetme;
          sizin risk tablonuz ölçüm, öykü ve kişisel koşullarla anlaşılır.
        </p>

        <h2 id="osteopeni-osteoporoz">Rapor Ne Söyler: Osteopeni ve Osteoporoz</h2>
        <p>
          Raporda "osteoporoz" kelimesini görmek insanı korkutabilir; bu kaygı çok doğal. Yine de bu kelime size bir
          hüküm vermez, izlemin nereden başlayacağını gösterir.
        </p>
        <p>
          En sık yanlış anlaşılan nokta, raporda osteopeni yazmasının mutlaka ciddi bir kemik hastalığı anlamına geldiğinin
          düşünülmesidir. Örneğin bir kadın T-skorunun −1,8 çıktığını gördüğünde kemiklerinin artık kolayca kırılacağını
          düşünebiliyor. Oysa osteopeni, kemik yoğunluğunun normalden düşük olduğunu gösterir; osteoporozla aynı şey
          değildir.
        </p>
        <p>
          DXA raporunda iki ayrı skor yer alabilir. Hangisine bakılacağı yaşınıza ve menopoz durumunuza bağlıdır <sup><a href="#ref-2">[2]</a></sup>.
        </p>
        <table>
          <thead>
            <tr>
              <th scope="col">Skor</th>
              <th scope="col">Kimde esas alınır?</th>
              <th scope="col">Nasıl okunur?</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="whitespace-nowrap">T-skoru</td>
              <td>Menopoz sonrası kadınlar; 50 yaş ve üzeri erkekler</td>
              <td>−1,0 ile −2,5 arası osteopeni; −2,5 ve altı osteoporoz</td>
            </tr>
            <tr>
              <td class="whitespace-nowrap">Z-skoru</td>
              <td>Menopoz öncesi kadınlar (özellikle 50 yaş altı ve erken menopoz yoksa)</td>
              <td>−2,0 ve altı "yaşa göre beklenenin altında"; ikincil (sekonder) nedenler araştırılır</td>
            </tr>
          </tbody>
        </table>
        <p>
          Ben kemik yoğunluğu sonucunu hiçbir zaman tek başına değerlendirmem. Yaşa, menopoz süresine, daha önce kırık
          geçirip geçirmediğine, kullandığı ilaçlara ve diğer risk etkenlerine de bakarım. Gerektiğinde FRAX ile
          önümüzdeki 10 yıllık kırık riskini hesaplarım.
        </p>
        <p>
          Bunun tersi de mümkündür. Ölçümü çok kötü görünmeyen bir kadında, özellikle daha önce düşük travmalı bir kırık
          varsa, önemli bir kırık riski bulunabilir. Küçük bir düşmede kalça ya da omurga kırığı geçirmişseniz osteoporoz
          tanısı T-skorundan bağımsız olarak konabilir <sup><a href="#ref-1">[1]</a></sup>.
        </p>
        <p>
          <strong>Kemik yoğunluğu ölçümündeki tek bir rakam, kemiklerimizin ne kadar sağlam olduğunu veya gelecekte kırık
          yaşayıp yaşamayacağımızı tek başına söylemez.</strong>
        </p>

        <h2 id="risk-faktorleri">Riskinizi Belirleyen Etkenler</h2>
        <p>
          Aynı yaştaki iki kadının kemik riski birbirinden çok farklı olabilir. Risk listesine bakmanın amacı, kime ne
          zaman daha yakından bakılacağını seçmektir.
        </p>
        <p>
          Öne çıkan etkenlerden biri, daha önce küçük bir düşmede kırık geçirmiş olmaktır <Evidence from={4} to={5} />
          <sup><a href="#ref-3">[3]</a></sup><sup><a href="#ref-14">[14]</a></sup>. Erken menopoz (45 yaş öncesi), düşük
          vücut kitle indeksi (BMI 19 kg/m²'nin altı), ailede kalça kırığı öyküsü ve sigara da bu listededir. Yüksek alkol
          tüketimi ve hareketsiz yaşam riski artırır. Yetersiz protein ve kalsiyum alımı, belirgin D vitamini eksikliği ve
          üç aydan uzun süren kortikosteroid kullanımı da bu listede yer alır <sup><a href="#ref-3">[3]</a></sup>.
        </p>
        <p>
          Sigara ve alkolü her görüşmede sorarım. Bunu hastaya suçluluk hissettirmek için değil, değiştirebileceğimiz risk
          etkenlerini belirlemek için yaparım. Sigara kullanımı kemik kaybı ve kırık riskinin artmasıyla ilişkilidir;
          aşırı alkol tüketimi ise hem kemik sağlığını olumsuz etkileyebilir hem de düşme riskini artırabilir.
        </p>
        <p>
          Hipertiroidi başta olmak üzere tiroid bozuklukları, romatoid artrit, emilim sorunları ve kronik böbrek hastalığı
          da kemik metabolizmasını etkileyebilir <sup><a href="#ref-3">[3]</a></sup>. Birkaç küçük risk, yıllar içinde
          sessizce üst üste biner; belirleyici olan çoğu zaman tek bir büyük neden olmaz.
        </p>

        <h2 id="kemik-taramasi">DXA Taraması: Ne Zaman, Hangi Sıklıkta</h2>
        <p>
          Herkese uyan tek bir yaş yok. Tarama zamanını sizin risk tablonuz belirler.
        </p>
        <p>
          USPSTF'nin 2025 önerisi, 65 yaş ve üzeri kadınlarda osteoporoz taramasını önerir <sup><a href="#ref-4">[4]</a></sup>.
          Aynı öneri, 65 yaş altındaki menopoz sonrası kadınlardan klinik risk değerlendirmesiyle artmış kırık riski
          taşıyanlar için de taramayı önerir. Erken menopoz, küçük bir düşmede kırık, uzun süreli steroid kullanımı veya
          belirgin zayıflık varsa tarama daha erken gündeme gelebilir.
        </p>
        <p>
          İlk DXA ölçümü kişisel başlangıç çizginizi gösterir. Sonraki ölçümün zamanı bu sonuca ve izlem planına göre
          belirlenir; her yıl otomatik olarak tekrarlamak gerekmez. Ölçüm sonuçlarının yorumunda ISCD'nin 2023 resmî
          pozisyonlarını <sup><a href="#ref-2">[2]</a></sup>, kırık riski değerlendirmesinde ve tedavi kararlarında ise
          NOGG'nin 2024 güncellemesini <sup><a href="#ref-15">[15]</a></sup> temel alırım.
        </p>

        <h2 id="kas-denge">Kemik Gücü, Kas ve Dengeyle Birlikte Konuşulur</h2>
        <p>
          Kemik tek başına korunmaz; onu taşıyan kas, yöneten denge ve günlük hareket alışkanlığıyla birlikte korunur.
          Kemik yüke yanıt verir. Merdiveni seçtiğiniz, pazar filesini kendiniz taşıdığınız her gün kemiğinize küçük bir
          iş vermiş olursunuz.
        </p>
        <p>
          Tempolu yürüyüş ve merdiven çıkma gibi ağırlık taşıyan hareketler ile ağırlık ya da direnç bandıyla kademeli
          yapılan direnç çalışmaları kemik yapım hücrelerini uyarabilir ve yoğunluğun korunmasına katkı sağlayabilir
          <Evidence level={4} /> <sup><a href="#ref-8">[8]</a></sup>.
        </p>
        <p>
          "Direnç egzersizi" herkes için aynı programı anlatmaz. Diz, kalça, bel, omuz ve denge geçmişi göz önünde
          bulundurularak güvenli bir başlangıç gerekir. Direnç çalışmaları kas gücüne ve dengeye de katkı sağlayabilir;
          bu da düşme riskini azaltmaya yardımcı olabilir.
        </p>
        <p>
          Kas gücü sessizce azalabilir. Azaldığında düşme riski artabilir; düşme riski arttığında kırık ihtimali büyür.
          Bu zincirin olumlu tarafı, bazı halkaları günlük hayat içinde güçlendirmenin mümkün olmasıdır. Merdiven güveni,
          otur-kalk kuvveti, kalça çevresi kasları, ayak bileği kontrolü ve ev içi aydınlatma bu denklemin parçasıdır.
        </p>
        <p>
          Sigaradan uzak durmak, alkolü sınırlamak ve uzun oturma sürelerini bölmek de bu planın parçasıdır. En sık yapılan
          hata, birkaç hafta çok yoğun çalışıp sonra tamamen bırakmaktır. Kemik sabırlıdır; yıllarca sürdürebileceğiniz,
          haftaya yayılan bir düzen ona iyi gelir.
        </p>

        <h2 id="beslenme">Beslenme ve D Vitamininde Ölçülü Yaklaşım</h2>
        <p>
          Kemik sağlığı konuşulurken konu hızla takviyelere kayabilir. Oysa iyi başlangıç, eksik olanı ayırmak ve temel
          beslenme zemininin yerinde olup olmadığını görmektir.
        </p>
        <p>
          Beslenme referans değerlerine göre kadınlarda kalsiyum ihtiyacı yaşla artar: <strong>19–50 yaş arasında günde
          1000 mg</strong>, <strong>51 yaş ve üzerinde günde 1200 mg</strong> <sup><a href="#ref-5">[5]</a></sup>. Bu miktarı
          mümkün olduğunca besinlerden almak tercih edilir. Yoğurt, ayran, kefir, peynir, susam ve tahin, badem ve koyu
          yeşil yapraklı sebzeler sofranızda bu işi görür.
        </p>
        <p>
          Protein de bu tablonun parçasıdır. Menopoz sonrası kas ve kemik sağlığı için uzman uzlaşısı, günde vücut
          ağırlığının kilogramı başına <strong>1,0–1,2 g protein</strong> öneriyor <sup><a href="#ref-7">[7]</a></sup>. 70
          kilo bir kadın için bu, günde yaklaşık 70–84 gram demek.
        </p>
        <p>
          D vitamini kemik metabolizmasında önemli bir rol oynar. Yine de güncel kılavuz, belirgin bir gerekçe yoksa
          sağlıklı yetişkinlerde rutin 25(OH)D kan testini önermiyor <sup><a href="#ref-6">[6]</a></sup>. Takviyenin gerekip
          gerekmediği güneşlenme, kişisel riskler ve beslenme alışkanlıklarıyla birlikte değerlendirilir. Rastgele ve üst
          üste takviye eklemek iyi bir kestirme yol değildir.
        </p>

        <h2 id="turkiye-baglami">Türkiye'de Kemik Sağlığı Nasıl Görünüyor</h2>
        <p>
          Kılavuzların çoğu başka ülkelerde yazılıyor. Kendi ülkemizin verisine de bakmakta fayda var.
        </p>
        <p>
          Türkiye'de 2009'da yapılan bir kalça kırığı çalışması, 50 yaş ve üzerindeki kadınların üçte birinde (%33,3)
          kalça bölgesinde osteoporoz buldu. Aynı çalışmaya göre 50 yaşındaki bir kadının yaşamı boyunca kalça kırığı
          geçirme olasılığı %14,6 olarak hesaplandı <sup><a href="#ref-10">[10]</a></sup>. O tarihte Türkiye, kalça kırığı
          oranı düşük Avrupa ülkeleri arasındaydı; ama oran 1988–89'a göre belirgin biçimde artmıştı. Veriler eski olduğu
          için bugünkü tabloyu birebir yansıtmayabilir. Bu rakamlar sizi korkutmak için burada değil; ölçümün ve erken
          konuşmanın neden değerli olduğunu göstermek için.
        </p>
        <p>
          Kırık riskini hesaplayan FRAX aracının Türkiye'ye özgü bir modeli var. Ulusal uzlaşı raporu da DXA erişimini ve
          FRAX kullanımını ülkemizin güçlü yanları arasında sayıyor <sup><a href="#ref-11">[11]</a></sup>. Ölçmek mümkün.
          Asıl eksik, sonrası: aynı rapor, kırık geçirdikten sonra ilaç tedavisi almayan hastaların oranını %75–90,
          osteoporoz tanı oranını yaklaşık %25 olarak tahmin ediyor <sup><a href="#ref-11">[11]</a></sup>. Sonucunuzu
          aldığınızda "şimdi ne yapacağız?" diye sormanız bu yüzden önemli.
        </p>
        <p>
          D vitamini düşüklüğü Türkiye'de sık bildiriliyor. Beş büyük ilde 44.592 kadının sonuçlarına bakan bir çalışmada
          (2011–2017) D vitamini eksikliği (20 ng/mL altı) Diyarbakır'da %78,7, İstanbul'da %50,5 bulundu <sup><a href="#ref-12">[12]</a></sup>.
          Düzce'de 85.892 yetişkinle yapılan başka bir çalışmada eksiklik kadınlarda %68,6'ydı; düzeyler yazın en yüksek,
          kışın en düşüktü <sup><a href="#ref-13">[13]</a></sup>. İki çalışma da hastaneye başvurup D vitamini baktıran
          kişilere dayanıyor; bu yüzden tüm toplumu temsil etmiyor. Rakamların ortak mesajı basit: kırık ortaya çıkmadan
          riski konuşmak mümkün.
        </p>
        <p>
          Bu veriler kılavuzun söylediğini değiştirmiyor: belirgin bir gerekçe yoksa rutin D vitamini testi önerilmiyor
          <sup><a href="#ref-6">[6]</a></sup>. Yine de düşük düzeyin sık görüldüğü bir ülkede yaşıyorsanız, özellikle kış
          aylarında güneşlenme ve beslenme alışkanlıklarınızı hekiminizle konuşmanız yerinde olur. Test ve takviye kararı
          kişisel riskinize göre verilir.
        </p>

        <h2 id="tibbi-secenekler">Tıbbi Seçenekler ve Sınırlar</h2>
        <p>
          Ölçümünüz belirgin düşükse ya da daha önce kırık geçirdiyseniz, yaşam tarzı adımlarının yanına ilaç seçenekleri
          de eklenebilir. Ölçümdeki sayı tek başına ilaç kararı vermez; daha önce küçük bir düşmede kırık geçirmiş olmak
          kararı en çok değiştiren bulgudur.
        </p>
        <p>
          Menopozal hormon tedavisi (HRT/MHT), uygun kadınlarda osteoporozun önlenmesine katkı sağlayabilir <Evidence level={5} />
          <sup><a href="#ref-9">[9]</a></sup>. Ateş basması gibi vazomotor belirtiler ya da erken menopoz varsa bu seçenek
          ayrıca konuşulur. Karar, yaşınız ve menopozdan bu yana geçen süreyle birlikte verilir; genellikle ilk 10 yıl veya
          60 yaş altı dönem dikkate alınır. Pıhtı (venöz tromboembolizm, VTE) ve meme kanseri gibi kontrendikasyonlar da
          ayrıca değerlendirilir.
        </p>
        <p>
          Diğer seçenekler arasında kemik yıkımını azaltan ilaçlar (bifosfonatlar ve denosumab) ile SERM grubundan
          raloksifen bulunur. Çok yüksek riskli seçilmiş durumlarda kemik yapımını artıran (anabolik) tedaviler de gündeme
          gelir <sup><a href="#ref-1">[1]</a></sup>. Bifosfonat öncesinde böbrek fonksiyonları (eGFR) ve ağız-diş sağlığı
          değerlendirilir.
        </p>
        <p>
          Denosumab kullanılıyorsa bırakma kararı da planlanır. İlaç plansız kesildiğinde kemik kaybı hızla geri dönebilir
          ve omurga kırığı riski artabilir; bu nedenle genellikle başka bir ilaçla geçiş yapılır <sup><a href="#ref-1">[1]</a></sup>.
          Bütün bu seçeneklerde asıl hedef kırık riskini azaltmaktır. Hangisinin size uygun olduğuna hekiminizle birlikte
          karar verilir.
        </p>

        <h2 id="kirmizi-bayraklar">Beklemeden Değerlendirilmesi Gereken Durumlar</h2>
        <p>
          Kemik sağlığı genellikle uzun vadeli bir izlemdir. Yine de bazı belirtilerde beklemek doğru olmaz. Özellikle
          düşme sonrası tabloyu küçümsememek gerekir.
        </p>

        <RedFlagBox
          title="Kemik ve kırık riski açısından geciktirilmemesi gereken işaretler"
          intro="Aşağıdaki durumlar kişisel izlem planından önce daha hızlı ortopedik veya tıbbi değerlendirme gerektirebilir."
          markers={[
            'Düşme sonrası kalça, kasık, bel veya el bileğinde şiddetli ağrı ve üzerine basamama',
            'Yeni gelişen belirgin sırt ağrısı, boy kısalması hissi veya omurgada çökme şüphesi',
            'Ateş, belirgin şişlik, kızarıklık veya eklemde hızlı artan hareket kısıtlılığı',
            'Uyuşma, güç kaybı, idrar-dışkı kontrolünde yeni sorun veya giderek artan gece ağrısı',
          ]}
          footnote="Bu liste tanı koymaz; daha hızlı değerlendirme gerektirebilecek işaretleri görünür kılar."
        />

        <h2 id="karar-zinciri">Sakin Bir Karar Zinciri Kurmak</h2>
        <p>
          Kemik gücü için iyi karar, tek bir cümleyle verilmez. Ölçüm, risk, hareket, beslenme, düşme olasılığı ve tıbbi
          seçenekler birlikte tartıldığında tablo netleşir.
        </p>
        <p>
          İlk adım kişisel riskin adını koymaktır. İkinci adım, düzeltilebilir alanları ayırmaktır: D vitamini eksikliği,
          yetersiz protein, hareketsizlik, ev içi düşme riski, kas güçsüzlüğü, görme sorunu veya uygun olmayan ilaç
          kullanımı gibi. Üçüncü adım ise izlem ve gerekiyorsa tedavi kararını kişisel tabloya göre planlamaktır.
        </p>
        <p>
          Bir sonraki kontrolünüzde şu üç soruyla başlayabilirsiniz: "Kırık riskim ortalamanın üstünde mi?", "DXA için
          doğru zamanda mıyım?" ve "Yaşam tarzı adımları bana yeter mi, yoksa tıbbi seçenekleri de konuşmalı mıyız?" İçiniz
          rahat olsun: bu soruları sormak için bir şikâyetinizin olması gerekmez.
        </p>
        <p>
          Cerrahi seçenekler ortopedide doğru zamanlandığında değer kazanır; fakat kemik sağlığında temel hedef, mümkün
          olduğunca kırığı ve düşmeyi önlemektir. Sakin bir ortopedik karar bazen en büyük etkisini ameliyattan çok önce
          gösterir. Bu yazının ana cümlesi bu yüzden basit: kemiği konuşmak için kemiğin kırılmasını beklemek gerekmez.
        </p>

