---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../../components/site/ArticleSummary.astro';
import RelatedReadings from '../../../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../../../components/site/ArticleFAQ.astro';
import Evidence from '../../../../components/site/Evidence.astro';
import { submenuHeroByRoute } from '../../../../data/submenu-heroes';
import { buildArticleSchemas } from '../../../../utils/article-schema';
import { resolveSiteUrl } from '../../../../utils/seo';

const pathname =
  '/hormonal-gecis/40-sonrasi/menopozdan-sonra-kalp-sagligina-neden-daha-dikkatli-bakiyorum';
const hero = submenuHeroByRoute['/hormonal-gecis/40-sonrasi']!;

const articleTitle = 'Menopozdan sonra kalp sağlığına neden daha dikkatli bakıyorum';
const articleDescription =
  'Menopozla birlikte kalp damar riski nasıl değişir, hangi belirtiler ciddiye alınmalıdır ve hormon tedavisi bu tabloda nasıl değerlendirilir? Dr. Alp Aslan Eryılmaz sakin ve önleyici bir yaklaşımla anlatıyor.';

const tocEntries = [
  { id: 'neden-yeniden-degerlendiriyorum', label: 'Kalp sağlığını neden yeniden değerlendiriyorum' },
  { id: 'risk-degisimleri', label: 'Bu dönemde en sık dikkat ettiğim risk değişimleri' },
  { id: 'hangi-sinyaller', label: 'Hangi sinyalleri ciddiye alırım' },
  { id: 'hrt-kalp-etkisi', label: 'Hormon tedavisinin kalp üzerindeki etkisi' },
  { id: 'hangi-testler', label: 'Hangi testleri anlamlı buluyorum' },
  { id: 'duzenli-izlem', label: 'Tedaviden önce düzenli izlem' },
  { id: 'doktor-gorusmesi', label: 'Doktor görüşmesine giderken' },
  { id: 'sik-sorulanlar', label: 'Sık Sorulan Sorular' },
];

const faqItems = [
  {
    question: 'Hormon tedavisi kalbi korumak için başlanır mı?',
    answer:
      'Ben bunu tek başına kalbi korumak amacıyla başlanan bir tedavi gibi görmüyorum. Karar çoğu zaman menopoz belirtileri, yaşam kalitesi, kemik sağlığı ve kişisel risk profiliniz birlikte değerlendirilerek verilir. Kalp damar tarafı bu kararın önemli bir parçasıdır, ama tek başına bütün resmi oluşturmaz.',
  },
  {
    question: 'HRT herkes için aynı kardiyovasküler riski mi taşır?',
    answer:
      'Hayır. Yaş, menopozun üzerinden geçen süre, sigara öyküsü, tansiyon, migren, pıhtılaşma eğilimi ve mevcut damar hastalığı gibi başlıklar tabloyu değiştirir. Bu yüzden en doğru yaklaşım genelleme yapmak değil, kişisel risk zemininizi ayrı ayrı konuşmaktır.',
  },
  {
    question: 'Menopoz dönemindeki çarpıntı her zaman kalp hastalığı anlamına mı gelir?',
    answer:
      'Hayır. Çarpıntı bazen hormonal değişim, uyku bozulması, stres, kafein ya da ritim değişiklikleriyle ilişkili olabilir. Yine de yeni başlayan, sıklaşan ya da nefes darlığı, göğüste baskı, baygınlık hissi gibi başka belirtilerle birlikte görülen çarpıntıların değerlendirilmesi gerekir.',
  },
  {
    question: 'Kalp sağlığı için ilk adım olarak neyi daha önemli buluyorum?',
    answer:
      'Ben ilk adım olarak düzenli izlemeyi önemsiyorum. Tansiyon takibi, lipid profili, hareket düzeyi, uyku, sigara kullanımı ve aile öyküsü birlikte düşünülmeden sağlıklı bir risk değerlendirmesi yapmak zor olur. Büyük bir belirti beklemeden bu başlıklara bakmaya başladığınızda, çoğu zaman daha sakin ve daha net bir yol açılmış olur.',
  },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'alp-aslan-eryilmaz',
  publishedDate: '11 Mayıs 2026',
  pathname,
  articleSection: 'Hormonal Geçiş',
  sectionPath: '/hormonal-gecis',
  keywords: [
    'menopoz',
    'kalp sağlığı',
    'menopoz sonrası kalp riski',
    'HRT',
    'hormon tedavisi',
    'tansiyon',
    'kolesterol',
    'çarpıntı',
  ],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${articleTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/hormonal-gecis" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Hormonal Geçiş · 40 Sonrası"
      title={articleTitle}
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />

      <ArticleAuthorBlock
        authorSlug="alp-aslan-eryilmaz"
        publishedDate="11 Mayıs 2026"
        readingMinutes={9}
        imageSrc="/images/library/editorial/alp-aslan-eryilmaz-menopoz-kalp-byline.png"
        imageAlt="Krem trençkot ve bordo fular detayıyla apartman girişinde kısa bir duraklama anında görülen orta yaşlı kadın; menopoz sonrası kalp sağlığı yazısı için sakin editoryal byline görseli"
        imagePosition="center"
      />

      <ArticleSummary title="Kısa Özet">
        <p>
          Menopozla birlikte kalp damar sistemi çoğu zaman sessiz ama önemli bir değişim sürecine girer. Dr. Alp Aslan Eryılmaz bu yazıda, kalp sağlığına yalnızca belirti olduğunda değil, risk haritası değişmeye başladığında da daha dikkatli bakmak gerektiğini anlatıyor. Yazı; kolesterol, tansiyon, çarpıntı, eforla gelen yakınmalar, anlamlı testler ve hormon tedavisinin kalp tarafındaki yerini korku üretmeden ele alıyor.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="neden-yeniden-degerlendiriyorum">Kalp sağlığını neden menopozdan sonra yeniden değerlendiriyorum</h2>
        <p>
          Menopozdan sonra değişen şey yalnızca adet düzeni olmuyor; kalp damar sistemi de daha dikkatli okunması gereken bir döneme giriyor.
        </p>
        <p>
          Ben bu dönemi, "Bir şey olursa zaten belirti verir" diye okunacak bir eşik olarak görmüyorum. Sizin de fark etmiş olabileceğiniz gibi, enerji, uyku, kilo dağılımı, tansiyon eğilimi ve efor kapasitesi zaman içinde daha farklı bir dengeye geçebiliyor. Bu değişimlerin her biri tek başına dramatik görünmeyebilir; ama birlikte düşünüldüklerinde kardiyovasküler risk haritasını yeniden çizer.
        </p>
        <p>
          Özellikle hormonal koruyuculuğun azalmasıyla birlikte kolesterol dengesi, damar esnekliği ve tansiyon seyri yeniden önem kazanabiliyor <Evidence level={4} />. Bu, her kadının aynı hızda ya da aynı ölçüde risk taşıdığı anlamına gelmiyor. Ama menopozdan sonra kalp sağlığını gençlik yıllarındaki varsayımlarla okumaya devam etmek de çoğu zaman doğru olmuyor.
        </p>
        <p>
          Benim bu dönemde önemsediğim şey korku değil, erken fark etme kültürü. Önleyici yaklaşımın gücü tam da burada: tablo büyümeden önce riskin yönünü gösterebilmek.
        </p>

        <h2 id="risk-degisimleri">Bu dönemde en sık dikkat ettiğim risk değişimleri neler</h2>
        <p>
          Menopoz sonrasında risk tek bir başlıkta toplanmaz; küçük değişimler çoğu zaman aynı dönemde üst üste binerek anlam kazanır.
        </p>
        <p>
          Bu yıllarda en sık dikkat ettiğim başlıklar LDL kolesterolde artış, tansiyon değerlerinde yukarı yönlü kayma, bel çevresinde genişleme, hareketin azalması, uyku bozulması ve kan şekeri dengesindeki değişimler oluyor. Sizin için bunlardan biri daha önde olabilir, başka biri daha geri planda kalabilir; önemli olan bunların birlikte nasıl bir tablo oluşturduğunu görebilmektir.
        </p>
        <p>
          Burada sık karşılaştığım düşünce şu oluyor: "Kendimi çok kötü hissetmiyorum, o halde ciddi bir şey yoktur." Oysa kalp damar riski çoğu zaman gürültülü başlamaz. Birçok kadın için tablo, büyük bir belirtiyle değil, ölçümlerdeki küçük ama anlamlı kaymalarla görünür hale gelir.
        </p>
        <p>
          Ben bu nedenle yalnızca yakınmaları değil, ölçülebilen değişimleri de önemsiyorum. Rutin takip dediğim şey tam olarak budur: riskin büyümesini beklemek yerine yönünü erkenden görmek.
        </p>

        <h2 id="hangi-sinyaller">Her belirti kalp sorunu değildir, ama bazı sinyalleri ciddiye alırım</h2>
        <p>
          Menopoz döneminde görülen her yakınma kalpten kaynaklanmaz; yine de bazı işaretler daha dikkatli değerlendirilmelidir.
        </p>
        <p>
          Özellikle yeni başlayan, tekrarlayan ve alışılmış halinizden farklı olan belirtiler üzerinde daha dikkatli dururum. Eforla gelen nefes darlığı, göğüste baskı hissi, yeni başlayan çabuk yorulma, çene ya da sırt hattına yayılan rahatsızlık ve açıklanamayan halsizlik bu başlıkların içinde yer alır.
        </p>
        <p>
          Kadınlarda kalp kaynaklı yakınmalar her zaman klasik görünmeyebilir <Evidence level={4} />. Bu nedenle yalnızca "şiddetli göğüs ağrısı var mı" sorusuna bakmak yeterli olmaz. Bazen belirti çok çarpıcı değildir; ama yeni, tekrarlayan ve açıklaması güçtür.
        </p>
        <p>
          Sizin için önemli olan, bedeninizin yeni bir gidiş kurup kurmadığını fark etmektir. Ben bu yüzden her şeyi hormona bağlamayı da, her şeyi kalbe yormayı da doğru bulmam. İyi değerlendirme çoğu zaman bu iki uç arasında kurulur.
        </p>

        <h2 id="hrt-kalp-etkisi">Hormon tedavisinin kalp üzerindeki etkisini nasıl değerlendiriyorum</h2>
        <p>
          Hormon tedavisi bu dönemin en çok konuşulan başlıklarından biri; ama kalp sağlığı açısından tek cümlelik yargılarla ele alınmamalıdır.
        </p>
        <p>
          Çünkü yaş, menopozdan ne kadar zaman geçtiği, damar riski, tansiyon profili, sigara öyküsü, migren varlığı ve pıhtılaşma eğilimi gibi başlıklar değerlendirmeyi doğrudan değiştirir. Aynı tedavi seçeneği iki farklı kadında aynı kardiyovasküler anlamı taşımayabilir.
        </p>
        <p>
          Ben hormon tedavisini yalnızca kalp hastalığını ya da başka kronik sorunları önlemek için başlanan bir seçenek gibi görmüyorum. Bu karar çoğu zaman sıcak basması, uyku bölünmesi, yaşam kalitesindeki düşüş ve bazı kadınlarda kemik sağlığı gibi daha geniş bir değerlendirmeyle verilir. Kalp damar tarafı bu kararın önemli bir parçasıdır, ama tek başına belirleyici değildir.
        </p>
        <p>
          Bazı kadınlarda, özellikle menopozun daha erken döneminde ve toplam damar riski düşükse, fayda-risk dengesi daha uygun görünebilir <Evidence from={3} to={4} />. Buna karşılık menopozun üzerinden uzun zaman geçmişse ya da kişide damar hastalığı, inme, pıhtılaşma öyküsü veya belirgin kardiyovasküler risk varsa değerlendirme değişir.
        </p>
        <p>
          Bir başka önemli nokta da şu: her hormon tedavisi seçeneği aynı risk profiline sahip değildir. Kullanım şekli, eşlik eden sağlık başlıkları ve sizin genel risk zemininiz birlikte düşünülmelidir. Bu nedenle "HRT herkes için iyidir" ya da "HRT herkeste zararlıdır" gibi kesin cümleler bana doğru gelmiyor. Daha doğru soru şudur: "Benim risk haritam içinde bunun yeri var mı?"
        </p>

        <h2 id="hangi-testler">Hangi testleri hangi durumda anlamlı buluyorum</h2>
        <p>
          Kalp değerlendirmesi tek bir testten ibaret değildir; doğru test ancak doğru koşullar içinde anlam kazanır.
        </p>
        <p>
          Yaş, aile öyküsü, kolesterol profili, tansiyon seyri, sigara kullanıp kullanmadığınız, kan şekeri dengeniz ve yaşadığınız belirtilerin niteliği birlikte düşünülmeden sağlıklı bir yol haritası çizmek kolay olmaz. Bu nedenle değerlendirmeye çoğu zaman temel risk resmiyle başlamak gerekir.
        </p>
        <p>
          Bazı kadınlar için düzenli tansiyon ölçümü, lipid profili, kan şekeri değerlendirmesi ve temel kardiyolojik muayene iyi bir başlangıç olabilir. Bazıları için elektrokardiyografi, ritim izlemi, ekokardiyografi ya da daha ileri risk değerlendirmeleri anlam kazanabilir. Ben burada asıl değerin çok sayıda test yapmakta değil, doğru kişide doğru testi istemekte olduğunu düşünüyorum.
        </p>
        <p>
          Değerlendirme sürecine "Bana hangi test yapılacak?" sorusuyla değil, "Benim risk profilim ne söylüyor?" sorusuyla girdiğinizde daha doğru bir zemine geçmiş olursunuz. Önleyici yaklaşımın özü de budur.
        </p>

        <h2 id="duzenli-izlem">Günlük hayatta ilk baktığım şey tedavi değil, düzenli izlem olur</h2>
        <p>
          Kalp sağlığını koruma konuşulunca hızlı çözümler öne çıkabilir; ben ise önce düzenli izlem disiplinine bakıyorum.
        </p>
        <p>
          Çünkü günlük ritim, uyku kalitesi, hareket düzeyi, sigara kullanımı, kilo çevresindeki değişim ve evde tansiyon ölçüm alışkanlığı çoğu zaman riskin yönünü erken haber verir. Büyük belirtiyi beklemeden küçük sinyalleri fark etmek, çoğu zaman daha sakin ve daha güvenli bir yoldur.
        </p>
        <p>
          Burada amaç kusursuz bir yaşam planı kurmak değildir. Ben daha çok sürdürülebilir alışkanlıkların peşinden gitmeyi önemsiyorum. Kısa süreli ve iddialı programlardan çok, devam eden küçük düzenlerin uzun vadede daha güvenilir etkisi olduğunu düşünüyorum.
        </p>
        <p>
          Birçok kadın bu dönemde bedeninin eskisi kadar kolay okunmadığını hissediyor. Bu çok anlaşılır bir duygu. Ama bu belirsizlik içinde bile, düzenli izlem çoğu zaman en sağlam başlangıç noktasıdır.
        </p>

        <h2 id="doktor-gorusmesi">Doktor görüşmesine giderken hangi soruların hazır olmasını önemserim</h2>
        <p>
          Menopoz sonrasında kalp sağlığını değerlendirmek isteyen biri için en değerli adımlardan biri, görüşmeye doğru sorularla gitmektir.
        </p>
        <p>
          Kişinin kendi risk profilini anlamadan rahatlaması zor olur. Aklınızdaki dağınık endişeleri daha net bir konuşmaya çevirebilmeniz için, sorularınızı önceden toparlamanızı önemli buluyorum.
        </p>
        <p>
          Şu sorular iyi bir başlangıç sağlayabilir: "Benim kalp damar riskimde bu dönemde belirgin bir değişim olmuş olabilir mi?", "Hangi ölçümleri düzenli izlemem gerekir?", "Benim için şu anda anlamlı bir test var mı?", "Yaşadığım yakınmalar menopozla mı, kalple mi daha çok ilişkili görünüyor?", "Hormon tedavisi düşünülüyorsa bunun kardiyovasküler açıdan benim için özel bir riski var mı?"
        </p>
        <p>
          Bazen doğru tanıya giden yol, doğru soruyu sormakla başlar. Belirsizliği tamamen ortadan kaldırmak her zaman mümkün değildir; ama onu daha yönetilebilir hale getirmek çoğu zaman mümkündür.
        </p>
      </ArticleProsePanel>

      <ArticleFAQ
        id="sik-sorulanlar"
        items={faqItems}
        class="mt-10"
        title="Sık Sorulan Sorular"
      />

      <RelatedReadings
        class="mt-10"
        paths={[
          '/hormonal-gecis/menopoz/hormon-tedavisi-karar-rehberi',
          '/hormonal-gecis/menopoz/menopozda-hekim-hasta-iliskisi',
          '/bilimsel-pencere/yeni-arastirmalar/menopozda-hrt-avantajlari',
        ]}
      />

      <ArticleEditorNote class="mt-10">
        <p>
          <em>Menopoz sonrasında kalp damar riskini değerlendirirken tek bir belirtiye ya da tek bir teste odaklanmak yeterli değildir.</em>
        </p>
        <p>
          Menopoz sonrasında kardiyovasküler riskin yeniden değerlendirilmesi önemlidir; ancak bu değerlendirme tek bir belirtiye ya da tek bir teste indirgenemez. Yaş, aile öyküsü, lipid profili, tansiyon seyri, diyabet eğilimi, sigara kullanımı ve eforla gelen yakınmalar birlikte okunmalıdır.
        </p>
        <p>
          Hormon tedavisi açısından en kritik ayrım şudur: bu tedavi yalnızca kalp hastalığını ya da başka kronik hastalıkları önlemek amacıyla başlanmaz. Uygun adaylarda fayda anlamlı olabilir; ancak damar hastalığı, pıhtılaşma öyküsü, inme riski veya geç başlangıç gibi başlıklar dengeyi değiştirir.
        </p>
        <p>
          Yeni başlayan efor dispnesi, göğüste baskı, açıklanamayan çabuk yorulma, senkop, belirgin çarpıntı ve bacakta tek taraflı şişlik gibi işaretler ertelenmemelidir. Burada paylaşılan yaklaşım genel popülasyon içindir; sizin tablonuzdaki eşlik eden hastalıklar, kullandığınız ilaçlar ve kişisel risk faktörleri kararı değiştirir.
        </p>
      </ArticleEditorNote>

      <ArticleDisclaimer class="mt-10" />
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
