---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuHero from '../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../components/site/ArticleAuthorBlock.astro';
import SaveForLaterButton from '../../components/site/SaveForLaterButton.astro';
import ReadingControls from '../../components/site/ReadingControls.astro';
import RedFlagBox from '../../components/site/RedFlagBox.astro';
import ArticleTOC from '../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../components/site/ArticleSummary.astro';
import Evidence from '../../components/site/Evidence.astro';
import RelatedReadings from '../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../components/site/ArticleFAQ.astro';
import { submenuHeroByRoute } from '../../data/submenu-heroes';
import { buildArticleSchemas } from '../../utils/article-schema';

import { resolveSiteUrl } from '../../utils/seo';

const tocEntries = [
  { id: 'isim-koymak', label: 'Ağrıya İsim Koymak' },
  { id: 'yasla-degisen', label: 'Yaşla Değişen Sistem' },
  { id: 'bel-diz-kalca', label: 'Bel, Diz ve Kalça' },
  { id: 'hareket-haritasi', label: 'Hareket Haritası' },
  { id: 'denge-guven', label: 'Denge ve Güven' },
  { id: 'ne-zaman-destek', label: 'Ne Zaman Destek?' },
  { id: 'kapanis', label: 'Bir Sonraki Görüşmeye Hazırlık' },
  { id: 'kaynaklar', label: 'Kaynaklar' },
  { id: 'sik-sorulanlar', label: 'Sıkça Sorulan Sorular' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = '40 Sonrası Diz, Kalça ve Bel Ağrısı — Bedeni Dinleyerek Hareket Etmek';
const seoTitle = '40 Sonrası Diz, Kalça ve Bel Ağrısı';
const articleDescription =
  '40 sonrası diz, kalça ve bel ağrısını tek bir egzersize indirgemeden; kas gücü, eklem yükü, denge ve fizyoterapi desteği üzerinden anlatan sade rehber.';
const articlePath = '/zamansiz-yasam/40-sonrasi-kas-iskelet-agrilari/';
const hero = submenuHeroByRoute[articlePath] ?? submenuHeroByRoute['/zamansiz-yasam/']!;
const faqItems = [
  { question: '40 yaş sonrası diz, kalça ve bel ağrısı kaçınılmaz mı?', answer: 'Yaşla birlikte kas gücü ve hareket alışkanlıkları değişebilir; ağrı yine de değerlendirilmesi gereken bir yakınmadır. Günlük yaşamı kısıtlayan veya tekrarlayan ağrıyı yaşınıza bağlayıp geçmeyin. Muayene, olası nedenleri ve uygun desteği ayırmaya yardımcı olur.' },
  { question: 'Ağrım varken tamamen dinlenmeli miyim?', answer: 'Travma veya acil belirti varsa önce tıbbi değerlendirme gerekir. Bunlar dışlandığında bel ağrısı ve eklem kireçlenmesinde, kapasitenize göre ayarlanmış hareket genellikle bakımın parçasıdır. Egzersiz sırasında belirgin kötüleşme ya da yeni güç kaybı olursa hareketi sürdürmeye zorlamayın.' },
  { question: 'Yürüyüş kas güçlendirme çalışmasının yerini tutar mı?', answer: 'Yürüyüş genel dayanıklılık için bir başlangıç olabilir. Yetişkinler için fiziksel aktivite önerileri, aerobik hareketin yanında kas güçlendirmeyi de kapsar. Mevcut ağrı veya denge sorunu varsa hangi çalışmanın uygun olduğu ayrıca değerlendirilir.' },
  { question: 'MR raporunda fıtık veya kireçlenme yazması ağrıyı açıklar mı?', answer: 'Rapordaki bulgu, şikâyetiniz ve muayeneyle birlikte yorumlanır. Bel ağrısında görüntüleme rutin olarak istenmez; uzman değerlendirmesinde sonucu bakım planını değiştirecekse düşünülür. Yeni idrar-dışkı kontrol sorunu veya kasık çevresinde his kaybı varsa acil servise başvurun. Bacakta ilerleyen güç kaybında beklemeden tıbbi değerlendirme gerekir.' },
  { question: 'Fizyoterapi için üç ay beklemem gerekir mi?', answer: 'Hayır. Üç ay, kronik bel ağrısını tanımlarken kullanılan süredir; yardım istemek için bekleme süresi değildir. Ağrı yürüyüşünüzü, uykunuzu veya işinizi kısıtlıyorsa daha erken değerlendirme alabilirsiniz.' },
];
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'ersin-sarac',
  articleType: 'editorial-guide',
  publishedDate: '4 Mayıs 2026',
  modifiedDate: '14 Ekim 2026',
  image: '/images/library/editorial/introspective-khaki-wrap.webp',
  pathname: articlePath,
  articleSection: 'Zamansız Yaşam',
  sectionPath: '/zamansiz-yasam/',
  keywords: ['40 sonrası hareket', 'bel ağrısı', 'diz ağrısı', 'kalça ağrısı', 'kas-iskelet sağlığı', 'fizyoterapi', 'denge egzersizi'],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  image="/images/library/editorial/introspective-khaki-wrap.webp"
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/zamansiz-yasam/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Hareket"
      title={articleTitle}
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      {/* medicalReviewer="Yok": inceleme bekleniyor. Gerçek inceleyici adı ve tarihi, inceleme tamamlanınca yazılır. */}
      <ArticleAuthorBlock
        authorSlug="ersin-sarac"
        articleType="editorial-guide"
        medicalReviewer="Yok"
        publishedDate="4 Mayıs 2026"
        readingMinutes={7}
        lastUpdated="14 Ekim 2026"
        imageSrc="/images/library/editorial/kas-iskelet-yuruyus-byline.webp"
        imageAlt="Sabah ağaçlı bir İstanbul parkında yürüyen, krem eşarplı, boyalı saçlı orta yaşlı bir kadının temsili portresi"
      />

      <p class="mt-4 text-sm text-ink/75"><strong>Tıbbi inceleme:</strong> Bu revizyon için bekleniyor.</p>

      <div class="flex flex-wrap items-center justify-end gap-3">
        <ReadingControls />
        <SaveForLaterButton slug={articlePath} title={articleTitle} />
      </div>

      <ArticleSummary title="Kısa Özet">
        <p>Muayene, 40 sonrasında diz, kalça veya bel ağrısının olası nedenlerini ayırt etmeye yardımcı olur. Günlük yaşamı kısıtlayan
          ağrıyı yalnızca yaşa ya da menopoza bağlamayın. Ciddi nedenler dışlandığında, kapasitenize göre
          ayarlanan hareket bel ağrısı ve eklem kireçlenmesinde bakımın parçası olabilir. Yeni idrar-dışkı
          kontrol sorunu veya kasık çevresinde his kaybı varsa acil değerlendirme gerekir.</p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="isim-koymak">Ağrıya İsim Koymak: Tek Bir Nokta Değil, Bir Harita</h2>
        <p>Sandalyeden kalkarken diziniz sızlıyor, yürüyüşte kalçanız rahatsız oluyor ya da gün sonunda
          beliniz tutuluyor olabilir. Nerede ağrıdığı kadar, ne zaman başladığı ve neleri zorlaştırdığı da önemlidir.</p>
        <p>İlk adım, ağrıya bir egzersiz seçmekten önce tabloyu tanımaktır. Bel ağrısı, eklem kireçlenmesi
          ve bir yaralanma aynı yaklaşımı gerektirmez. Öykü ve muayene bu ayrımı kurar; günlük hareket,
          uyku ve ağrıyla ilgili endişeler de değerlendirmeye katılır <Evidence level={3} /> <sup>[1, 2]</sup>.</p>
        <p>Bedeni dinleyerek ilerlemek, hangi hareketten sonra ne olduğunu fark etmekle başlar.
          Yürüdüğünüz süreyi, merdivende zorlanıp zorlanmadığınızı ve ağrının dinlenmeyle değişimini not
          edebilirsiniz. Bu gözlemler, görüşmede ağrıyı yalnızca bir puanla anlatmaktan daha somut bir çerçeve sunar.</p>

        <h2 id="yasla-degisen">40 Sonrasında Kas, Eklem ve Denge Neden Değişir?</h2>
        <p>40 yaş, hareket sisteminde bir anda her şeyin değiştiği bir sınır değildir.
          Yaş alma, hareket alışkanlıkları ve menopoz geçişi farklı katkılar yapabilir.</p>
        <p>Menopoz geçişini izleyen bir çalışmada yağ kütlesinde artış ve yağsız kütlede azalma gözlenmiştir
          <Evidence level={2} /> <sup>[3]</sup>. Yağsız kütle yalnızca kası kapsamaz; bu bulgu bir kişinin diz
          ya da bel ağrısının nedenini göstermez. Yeni başlayan ağrının ayrıca değerlendirilmesi gerekir.</p>
        <p>Dengeyi görme, iç kulak, ayaklardan gelen duyular ve kasların birlikte çalışması sağlar.
          Yetişkinler için genel fiziksel aktivite önerileri aerobik hareketin yanında kas güçlendirmeyi de
          içerir. Bu güçlü önerinin dayandığı kanıt orta kesinliktedir <Evidence level={3} /> <sup>[4]</sup>.
          Genel sağlık önerisi, ağrılı bir eklem için kişisel
          egzersiz programı yerine geçmez.</p>

        <h2 id="bel-diz-kalca">Bel, Diz ve Kalça Ağrısını Ayırmak Neden Önemli?</h2>
        <p>Hareketin yararı ve güvenli sınırları, ağrının nedenine göre değişir.
          Bel ağrısı için söylenen her cümleyi diz veya kalça ağrısına taşımamak gerekir.</p>
        <p>Ciddi bir hastalığa bağlı olmayan kronik primer bel ağrısında yapılandırılmış egzersiz,
          bakımın bir parçası olarak sunulabilir. Bu öneri koşulludur ve kanıt kesinliği düşüktür
          <Evidence level={2} /> <sup>[1]</sup>. Egzersizin yararı herkeste aynı değildir; eğitim ve kişinin
          günlük işlevini dikkate alan bir plan içinde ele alınır.</p>
        <p>Diz ve kalça osteoartritinde, yani eklem kireçlenmesinde, kişiye uyarlanmış egzersiz ve
          bilgilendirme temel yaklaşımlardandır <Evidence level={4} /> <sup>[5]</sup>. Kilo yönetimi ise
          fazla kilosu veya obezitesi olan kişiler için gündeme gelir; ağrısı olan herkese kilo verme
          hedefi konmaz. Başlangıçta bir miktar rahatsızlık görülebilir, ancak yeni şişlik veya belirgin
          işlev kaybı olduğunda plan yeniden değerlendirilir.</p>
        <p>Bel ağrısında MR veya röntgen rutin bir ilk adım değildir. Uzman değerlendirmesinde,
          görüntüleme sonucu bakım planını değiştirecekse düşünülebilir <Evidence level={4} /> <sup>[2]</sup>.
          Raporda yazan bulgu, şikâyetiniz ve muayeneyle birlikte yorumlanır.</p>

        <h2 id="hareket-haritasi">Güvenli Hareket Haritası: Ağrıyı Susturmak Değil, Yanıtı Okumak</h2>
        <p>Ciddi nedenler dışlandıktan sonra hareketin miktarı ve biçimi, kapasitenize göre ayarlanır.
          Başlangıç noktası, günlük yaşamda yapabildiklerinizdir.</p>
        <p>Ağrının şiddeti kadar karakteri, hareketle nasıl değiştiği ve ne kadar sürdüğü de önemlidir.
          Bir hareketi değerlendirirken sırasında ne hissettiğinizi, sonrasında ne kadar sürede yatıştığını
          ve ertesi gün yürüyüşünüzü ya da işinizi nasıl etkilediğini izleyebilirsiniz.</p>
        <p>Hafif, hareketle artmayan ve dinlenmeyle geçen bir ağrıda egzersizi tamamen bırakmak yerine
          tempoyu, süreyi veya yükü azaltmak düşünülebilir. Ağrı giderek artıyor, hareketi kısıtlıyor
          veya ertesi gün de belirgin sürüyorsa bunu sıradan bir egzersiz ağrısı sayıp zorlamamak gerekir.</p>
        <p>Eklemde şişlik veya kızarıklık, gece ağrısı, uyuşma ya da güç kaybı hekim değerlendirmesi
          gerektirir. Ani ve şiddetli ağrıda beklemeden tıbbi değerlendirme alın. Acil belirtiler için
          aşağıdaki kutuya bakın. Amaç, ağrıya rağmen zorlanmak yerine güvenli hareket sınırını bulmaktır
          <sup>[6, 7]</sup>.</p>
        <p>Yürüyüş, güçlendirme ve eklem hareket açıklığı çalışmaları farklı ihtiyaçlara karşılık gelir.
          Genel hareket önerileri ile ağrıya yönelik egzersiz planı birlikte düşünülebilir
          <Evidence level={3} /> <sup>[2, 4, 5]</sup>. Fizyoterapistinizle hangi günlük işi daha rahat yapmak
          istediğinizi konuşun: evden durağa yürümek, merdiven inmek veya sandalyeden kalkmak gibi.</p>
        <p>Küçük adımların gücü, sürdürebildiğiniz bir başlangıç yapabilmenizde yatar.
          Her gün aynı yükü artırmak yerine, değişimi ağrı ve işlevinizle birlikte izleyebilirsiniz.</p>

        <h2 id="denge-guven">Denge, Düşme Korkusu ve Günlük Yaşam</h2>
        <p>Dengeyle ilgili bir güçlük, yalnızca ağrılı bölgeye bakılarak anlaşılmayabilir.
          Sandalyeden kalkma ve merdiven inme gibi günlük işler değerlendirmeye somut bir yön verir.</p>
        <p>Düşmeyi önlemek için denge ve kuvvet içeren çok bileşenli aktivite önerileri özellikle
          65 yaş ve üzerindeki yetişkinlere yöneliktir. Bu güçlü öneri orta kesinlikte kanıta dayanır
          <Evidence level={3} /> <sup>[4]</sup>. 40 yaş üstündeki her kadının düşme riski aynı değildir;
          risk, kişisel denge ve işlev değerlendirmesiyle ele alınır.</p>
        <p>Yakın zamanda düşmüşseniz, yürürken güvensizlik hissediyorsanız veya bir yere tutunma
          ihtiyacınız artmışsa bunu görüşmede belirtin. Güç, denge ve günlük çevreniz birlikte ele
          alınabilir. Dengeyi sınamak için kendinizi düşme tehlikesine sokmanız gerekmez.</p>

        <h2 id="ne-zaman-destek">Ne Zaman Fizyoterapi veya Hekim Desteği Gerekir?</h2>
        <p>Ağrı yürüyüşünüzü, uykunuzu veya işinizi kısıtlıyorsa değerlendirme için üç ay beklemeyin.
          Bazı yeni belirtiler ise doğrudan acil değerlendirme gerektirir.</p>
        <p>Üç ay, kronik bel ağrısını tanımlarken kullanılan süredir; yardım isteme eşiği değildir
          <sup>[1]</sup>. Giderek artan, tekrar eden veya günlük yaşamı daraltan ağrıda hekim ya da
          fizyoterapi değerlendirmesi daha erken yapılabilir <Evidence level={4} /> <sup>[6, 7]</sup>.
          Ağrıya travma eşlik ediyorsa ya da aşağıdaki belirtilerden biri varsa önce tıbbi değerlendirme alın.</p>
        <p><strong>Bel ağrısıyla birlikte yeni idrar yapamama, idrar-dışkı kontrolünde kayıp, kasık veya
          makat çevresinde his kaybı ya da iki bacakta yeni güçsüzlük varsa acil servise başvurun.</strong>
          Bu belirtilerde rutin fizyoterapi görüşmesini beklemeyin <sup>[6]</sup>.</p>
        <RedFlagBox
          markers={[
            'Düşme, çarpma veya burkulma sonrası üzerine basamama ya da belirgin şekil bozukluğu: acil değerlendirme',
            'Yeni başlayan veya ilerleyen bacak güç kaybı, uyuşma ya da ayak bileğini kaldıramama: gecikmeden tıbbi değerlendirme',
            'İdrar yapamama, idrar-dışkı kontrolünde yeni kayıp veya kasık-makat çevresinde his kaybı: acil değerlendirme',
            'Sıcak ve şiş eklem, özellikle ateş ya da genel durum bozukluğuyla birlikte: aynı gün tıbbi değerlendirme',
            'Ağrıyla birlikte açıklanamayan kilo kaybı, ateş, gece terlemesi veya kanser öyküsü: gecikmeden hekim değerlendirmesi',
            'Gece uykudan uyandıran, pozisyonla rahatlamayan ve giderek artan ağrı: hekim değerlendirmesi',
          ]}
          footnote="Bu bulgular tanı koymaz. Acil olarak belirtilen durumlarda acil servise başvurun; diğerlerinde değerlendirme zamanını sağlık profesyoneliyle netleştirin. Kaynaklar: [6, 7]."
        />

        <h2 id="kapanis">Bir Sonraki Görüşmeye Hazırlık</h2>
        <p>Görüşmeye ağrının yerini, başlangıcını ve zorlaştırdığı günlük işleri not ederek gidebilirsiniz.
          Anlatmak istediğiniz bir hedef seçin: daha uzun yürümek veya merdiveni daha rahat inmek gibi.</p>
        <p>Fizyoterapistinize şu soruyu yöneltebilirsiniz: “Hangi değişiklikte hareketi azaltmalıyım,
          hangi belirtide hekim değerlendirmesi almalıyım?” Böylece bedeni dinleyerek ilerlemek,
          belirsiz bir öneriden günlük yaşamda kullanabileceğiniz bir plana dönüşür.</p>

        <h2 id="kaynaklar">Kaynaklar ve İleri Okuma</h2>
        <p>Numaralı atıflar, genel hareket önerilerini ağrıya özgü kılavuzlardan ayırır.
          Kaynakların kapsadığı yaş grubu ve hastalık, metindeki sınırlarla birlikte okunmalıdır.</p>
        <ol>
          <li>WHO, 2023. Kronik primer bel ağrısında cerrahi dışı bakım; egzersiz için koşullu öneri ve düşük kanıt kesinliği. <a href="https://www.ncbi.nlm.nih.gov/books/NBK599210/table/fm-ch2.tab1/" target="_blank" rel="noopener noreferrer">Öneri tablosu</a>.</li>
          <li>NICE NG59, 2016; güncelleme 2020. Bel ağrısı ve siyatikte değerlendirme, egzersiz ve görüntüleme. <a href="https://www.nice.org.uk/guidance/ng59/chapter/recommendations" target="_blank" rel="noopener noreferrer">Kılavuz önerileri</a>.</li>
          <li>Greendale ve ark., 2019. Menopoz geçişinde vücut kompozisyonunu izleyen gözlemsel çalışma. <a href="https://doi.org/10.1172/jci.insight.124865" target="_blank" rel="noopener noreferrer">Çalışmanın tam metni</a>.</li>
          <li>WHO, 2020. Fiziksel aktivite ve hareketsiz davranış kılavuzu; yetişkinler ve 65 yaş üzeri için ayrı öneriler. <a href="https://www.ncbi.nlm.nih.gov/books/NBK566046/" target="_blank" rel="noopener noreferrer">Yaş gruplarına göre öneriler</a>.</li>
          <li>NICE NG226, 2022. Osteoartritte kişiye uyarlanmış egzersiz, eğitim ve uygun kişilerde kilo yönetimi. <a href="https://www.nice.org.uk/guidance/ng226/chapter/recommendations" target="_blank" rel="noopener noreferrer">Osteoartrit önerileri</a>.</li>
          <li>NHS. Bel ağrısında değerlendirme ve acil belirtiler. <a href="https://www.nhs.uk/conditions/back-pain/" target="_blank" rel="noopener noreferrer">Bel ağrısı güvenlik bilgisi</a>.</li>
          <li>NHS. Eklem ağrısında değerlendirme, travma ve sıcak-şiş eklem uyarıları. <a href="https://www.nhs.uk/symptoms/joint-pain/" target="_blank" rel="noopener noreferrer">Eklem ağrısı güvenlik bilgisi</a>.</li>
        </ol>
      </ArticleProsePanel>

      <ArticleFAQ id="sik-sorulanlar" items={faqItems} title="Sıkça Sorulan Sorular" intro="Hareket, görüntüleme ve değerlendirme zamanına ilişkin kısa yanıtlar." class="mt-10" />

      <RelatedReadings
        class="mt-14"
        paths={[
          '/zamansiz-yasam/kemik-gucu-kirigi-beklemeden-sorulacak-sorular/',
          '/zamansiz-yasam/kilo-artisi-menopoz/',
          '/beden-yakinlik/pelvik-taban/menopozda-idrar-kacirma-pelvik-taban/',
          '/hormonal-gecis/40-sonrasi/tarama-testleri/',
          '/zamansiz-yasam/d-vitamini-rehberi/',
        ]}
      />

      <ArticleEditorNote title="Bilimsel Editör Notu — inceleme taslağı">
        <p><strong>Bu revizyonun tıbbi incelemesi bekleniyor.</strong> Aşağıdaki metin bilimsel editörün
          onayına sunulacak taslaktır; onaylanmış bir hekim görüşü olarak sunulmaz.</p>
        <p>Egzersizle ilgili kanıtı tek düzeyde toplamak yanıltıcıdır. Kronik primer bel ağrısında
          yapılandırılmış egzersiz için öneri koşullu, kanıt kesinliği düşüktür. Diz ve kalça
          osteoartritinde kişiye uyarlanmış egzersiz ve bilgilendirme temel bakımın parçasıdır.
          Denge ve kuvvetle düşmeyi önleme önerilerinin yaş kapsamı özellikle 65 yaş üzeridir.</p>
        <p>Fizyoterapi hareket ve işlev değerlendirmesine katkı sağlar. Travma, sıcak ve şiş eklem,
          ilerleyen güç kaybı ya da yeni idrar-dışkı kontrol sorunu olduğunda tıbbi değerlendirme
          önceliklidir. İlgili kaynaklar: [1, 4, 5, 6, 7].</p>
      </ArticleEditorNote>

       <ArticleDisclaimer>
<p>
          Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme yerine geçmez. Tanı, tedavi ve egzersiz planı için sağlık profesyoneline başvurunuz.
