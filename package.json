{
  "name": "estranova",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 3000 --host 0.0.0.0",
    "start": "astro dev --port 3000 --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "tsc --noEmit",
    "compliance": "node scripts/compliance-check.mjs",
    "preview:local": "set ASTRO_TELEMETRY_DISABLED=1&&astro preview --host 0.0.0.0 --port 4321",
    "dev:local": "set ASTRO_TELEMETRY_DISABLED=1&&astro dev --port 3000 --host 0.0.0.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "astro": "^6.1.5",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
