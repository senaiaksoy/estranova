---
import type { Article } from '../data/articles';

type Accent = 'primary' | 'secondary' | 'charcoal';
type Variant = 'default' | 'featured';

interface Props {
  article: Article;
  href?: string;
  variant?: Variant;
  accent?: Accent;
}

const {
  article,
  href = `/article/${article.slug}`,
  variant = 'default',
  accent = 'primary',
} = Astro.props as Props;

const categoryLabelMap: Record<string, string> = {
  perimenopoz: 'Perimenopoz',
  menopoz: 'Menopoz',
  'kadin-sagligi': '40+ Saglik',
  'kalp-sagligi': 'Kalp Sagligi',
  bilgi: 'Bilgi',
};

const categoryLabel = categoryLabelMap[article.category] ?? article.category.replace(/-/g, ' ');
const accentClass = accent === 'secondary' ? 'bg-secondary' : accent === 'charcoal' ? 'bg-charcoal' : 'bg-primary';
---

{
  variant === 'featured' ? (
    <article class="rounded-[34px] overflow-hidden border border-primary/10 bg-white">
      <div class:list={['h-3', accentClass]}></div>
      <div class="p-8 md:p-10">
        <p class="text-[11px] uppercase tracking-[0.24em] text-secondary font-bold mb-4">{categoryLabel}</p>
        <h3 class="text-3xl font-serif leading-tight mb-4">{article.title}</h3>
        <p class="text-charcoal/65 leading-relaxed mb-6">{article.excerpt}</p>
        <a href={href} class="inline-flex text-sm font-semibold text-primary border-b border-primary/30 pb-1 hover:border-primary">
          Yaziyi inceleyin
        </a>
      </div>
    </article>
  ) : (
    <article class="rounded-[30px] border border-primary/10 bg-white p-7 editorial-shadow">
      <div class="flex items-center justify-between gap-4 mb-4">
        <p class="text-[11px] uppercase tracking-[0.24em] text-secondary font-bold">{categoryLabel}</p>
        <p class="text-[11px] uppercase tracking-[0.24em] text-charcoal/40 font-bold">{article.readTime}</p>
      </div>

      <h3 class="text-2xl md:text-3xl font-serif mb-4 leading-tight">{article.title}</h3>
      <p class="text-charcoal/65 leading-relaxed mb-6">{article.excerpt}</p>

      <div class="flex items-center justify-between gap-4">
        <p class="text-[11px] uppercase tracking-[0.22em] text-charcoal/40 font-bold">{article.author}</p>
        <a href={href} class="inline-flex text-sm font-semibold text-primary border-b border-primary/30 pb-1 hover:border-primary">
          Yaziyi inceleyin
        </a>
      </div>
    </article>
  )
}
