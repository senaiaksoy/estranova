---
interface Props {
  title: string;
  description: string;
  image: string;
  category: string;
  readTime: string;
  href: string;
}

const { title, description, image, category, readTime, href } = Astro.props;
---

<a href={href} class="group cursor-pointer block">
  <div class="aspect-[16/9] rounded-[40px] overflow-hidden mb-8 shadow-xl">
    <img 
      src={image} 
      alt={title} 
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
      referrerpolicy="no-referrer"
    />
  </div>
  <div class="flex items-center gap-4 mb-4">
    <span class="text-[10px] font-bold tracking-widest text-secondary uppercase">{category}</span>
    <span class="text-[10px] font-bold text-charcoal/30 uppercase tracking-widest">{readTime} OKUMA</span>
  </div>
  <h3 class="text-3xl font-serif mb-4 group-hover:text-primary transition-colors">
    {title}
  </h3>
  <p class="text-charcoal/60 leading-relaxed line-clamp-2">
    {description}
  </p>
</a>
