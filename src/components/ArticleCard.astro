---
import type { Article } from '../data/articles';

interface Props extends Article {
  compact?: boolean;
}

const { title, excerpt, content, author, reviewer, date, category, readTime, href, tags, compact, featured } = Astro.props as Props;
---

<a href={href} class="group cursor-pointer block">
  <div class={`relative overflow-hidden rounded-[40px] mb-6 ${compact ? 'aspect-video' : 'aspect-[16/9]'}`}>
    <img
      src={`https://images.unsplash.com/photo-${Math.random() > 0.5 ? '1541895635-2f7a111039d5' : '1536244074244-28fdd00c6f57'}?w=800&auto=format&fit=crop&q=60`}
      alt={title}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
    />
    ${featured ? `<div class="absolute top-4 left-4 bg-secondary text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-[0.22em]">Öne Çıkan</div>` : ''}
  </div>

  <div class="flex items-center gap-3 mb-3">
    <span class="text-[10px] font-bold tracking-[0.22em] text-secondary uppercase">${category.replace(/-/g, ' ')}</span>
    <span class="text-[10px] font-bold text-charcoal/30 uppercase tracking-[0.22em]">${readTime}</span>
  </div>

  <h3 class="text-2xl md:text-3xl font-serif mb-3 group-hover:text-primary transition-colors leading-tight">
    ${title}
  </h3>

  <p class="text-charcoal/70 leading-relaxed line-clamp-2 ${compact ? 'text-sm' : 'text-base'}">
    ${excerpt}
  </p>

  <footer class="mt-4 flex flex-wrap items-center gap-2 text-[10px] font-medium uppercase tracking-widest text-charcoal/40">
    <span class="flex items-center gap-1">
      <span class="w-1 h-1 rounded-full bg-charcoal/30"></span>
      ${author}
    </span>
    <span class="flex items-center gap-1">
      <span class="w-1 h-1 rounded-full bg-charcoal/30"></span>
      ${date}
    </span>
    ${tags ? `<span class="flex items-center gap-1">
      <span class="w-1 h-1 rounded-full bg-charcoal/30"></span>
      ${tags.slice(0, 2).join(' • ')}
    </span>` : ''}
  </footer>
</a>
