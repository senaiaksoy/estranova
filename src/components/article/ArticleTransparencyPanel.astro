---
type Variant = 'meta' | 'disclaimer' | 'full';

interface Props {
  variant?: Variant;
  author?: string;
  reviewer?: string;
  reviewerTitle?: string;
  reviewDate?: string;
  lastModified?: string;
  disclaimerVersion?: string;
  disclaimerText?: string;
}

const {
  variant = 'full',
  author = '',
  reviewer = '',
  reviewerTitle = '',
  reviewDate = '',
  lastModified = '',
  disclaimerVersion = '',
  disclaimerText = 'Bu içerik tıbbi tanı ve tedavi yerine geçmez, mutlaka hekiminize danışınız.',
} = Astro.props as Props;

const showMeta = variant === 'meta' || variant === 'full';
const showDisclaimer = variant === 'disclaimer' || variant === 'full';
---

{showMeta && (
  <section class="grid grid-cols-1 md:grid-cols-4 gap-4">
    <div class="rounded-2xl border border-primary/10 bg-white p-5">
      <p class="text-[11px] font-bold tracking-[0.22em] uppercase text-charcoal/40 mb-2">Yazar</p>
      <p class="font-semibold text-charcoal">{author}</p>
    </div>
    <div class="rounded-2xl border border-primary/10 bg-white p-5">
      <p class="text-[11px] font-bold tracking-[0.22em] uppercase text-charcoal/40 mb-2">Tıbbi İnceleme</p>
      <p class="font-semibold text-charcoal">{reviewer}</p>
      {reviewerTitle && <p class="text-xs text-charcoal/55 mt-1">{reviewerTitle}</p>}
    </div>
    <div class="rounded-2xl border border-primary/10 bg-white p-5">
      <p class="text-[11px] font-bold tracking-[0.22em] uppercase text-charcoal/40 mb-2">İnceleme Tarihi</p>
      <p class="font-semibold text-charcoal">{reviewDate}</p>
    </div>
    <div class="rounded-2xl border border-primary/10 bg-white p-5">
      <p class="text-[11px] font-bold tracking-[0.22em] uppercase text-charcoal/40 mb-2">Son Güncelleme</p>
      <p class="font-semibold text-charcoal">{lastModified}</p>
    </div>
  </section>
)}

{showDisclaimer && (
  <section class="mt-12 rounded-[28px] border-l-4 border-secondary bg-surface-container p-8">
    <p class="text-[11px] uppercase tracking-[0.22em] text-secondary font-bold mb-3">Tıbbi Sorumluluk Reddi</p>
    <p class="text-charcoal/75 leading-relaxed">
      {disclaimerText}
    </p>
    {disclaimerVersion && <p class="text-xs text-charcoal/55 mt-4">Metin sürümü: {disclaimerVersion}</p>}
  </section>
)}
