---
import { featuredArticles, publishedArticles } from '../../data/articles';

const featuredArticle = featuredArticles[0] ?? publishedArticles[0];
const featuredHref = featuredArticle ? `/article/${featuredArticle.slug}` : '/library';
---

<section class="py-24 bg-primary text-white px-6 overflow-hidden relative">
  <div class="absolute top-0 right-0 w-1/2 h-full opacity-10 pointer-events-none">
    <svg viewBox="0 0 400 400" class="w-full h-full">
      <path d="M0,200 Q100,100 200,200 T400,200" fill="none" stroke="white" stroke-width="1" />
      <path d="M0,220 Q100,120 200,220 T400,220" fill="none" stroke="white" stroke-width="1" />
      <path d="M0,240 Q100,140 200,240 T400,240" fill="none" stroke="white" stroke-width="1" />
    </svg>
  </div>

  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
    <div class="relative z-10">
      <p class="text-secondary font-bold tracking-[0.3em] uppercase mb-6">Öne Çıkan İçerik</p>
      <h2 class="text-4xl md:text-6xl font-serif leading-tight mb-8">
        {featuredArticle?.title ?? 'Önerilen okuma'}
      </h2>
      <p class="text-white/70 text-lg mb-10 leading-relaxed">
        {featuredArticle?.excerpt ?? 'Kütüphane içeriklerinden öne çıkan bir yazıyı okuyun.'}
      </p>
      <a
        href={featuredHref}
        class="bg-white text-primary px-8 py-4 rounded-full font-bold text-lg hover:bg-surface transition-all inline-flex items-center gap-2"
      >
        Yazıyı Oku <span>-></span>
      </a>
    </div>
    <div class="relative">
      <div class="aspect-video rounded-3xl overflow-hidden shadow-2xl rotate-3">
        <img
          src="https://images.unsplash.com/photo-1559757175-5700dde675bc?auto=format&fit=crop&q=80&w=1000"
          alt="Beyin sağlığı araştırması"
          class="w-full h-full object-cover"
          referrerpolicy="no-referrer"
        />
      </div>
      <div class="absolute -bottom-6 -left-6 bg-secondary p-8 rounded-2xl shadow-xl -rotate-3">
        <p class="text-sm font-bold tracking-widest uppercase mb-2">Okuma Süresi</p>
        <p class="text-3xl font-serif">{featuredArticle?.readTime ?? '5 dk'}</p>
      </div>
    </div>
  </div>
</section>
