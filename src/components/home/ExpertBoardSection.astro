---
import { homepageGovernance, medicalBoardMembers } from '../../data/home';

const getInitials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? '')
    .join('');
---

<section class="py-24 bg-surface-container px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16" data-reveal="up">
      <h2 class="text-4xl md:text-5xl font-serif mb-6">Yonetim ve Editoryal Yapi</h2>
      <p class="text-charcoal/60 max-w-3xl mx-auto">
        Estranova; site yonetimi, tibbi yazi denetimi, yazar ekibi ve tibbi kurul rollerini acik sekilde ayiran
        seffaf bir editoryal model ile yayin yapar.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-14" data-reveal-stagger>
      {homepageGovernance.map((item) => (
        <article class="bg-card border border-primary/10 rounded-3xl p-6 shadow-sm card-hover" data-reveal="scale-up">
          <h3 class="text-lg font-serif mb-3 text-primary">{item.title}</h3>
          <ul class="space-y-1 mb-3">
            {item.people.map((person) => (
              <li class="text-charcoal font-semibold">{person}</li>
            ))}
          </ul>
          <p class="text-sm text-charcoal/65 leading-relaxed">{item.note}</p>
        </article>
      ))}
    </div>

    <div class="bg-card border border-primary/10 rounded-3xl p-8 md:p-10" data-reveal="up">
      <h3 class="text-2xl font-serif mb-3">Tibbi Kurul</h3>
      <p class="text-charcoal/60 mb-8">
        Tibbi kurul biyografileri tupbebek.com Yayin Kurulu sayfasindaki bilgiler temel alinarak ozetlenmistir.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-reveal-stagger>
        {medicalBoardMembers.map((member) => (
          <article class="rounded-2xl border border-primary/10 p-6 bg-surface/50 card-hover" data-reveal="up">
            <div class="flex items-start gap-4 mb-4">
              <div class="w-12 h-12 rounded-full bg-primary/10 text-primary font-bold flex items-center justify-center shrink-0">
                {getInitials(member.name)}
              </div>
              <div>
                <h4 class="text-lg font-serif leading-tight">{member.name}</h4>
                <p class="text-sm text-secondary font-semibold mt-1">{member.specialty}</p>
              </div>
            </div>
            <p class="text-sm text-charcoal/70 leading-relaxed">{member.bio}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
