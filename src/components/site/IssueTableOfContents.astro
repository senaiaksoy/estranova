---
/**
 * Sayı sayfasının üstünde "Bu Sayıda İçindekiler" bileşeni.
 *
 * Lapham's Quarterly + Atlantic TocFeaturedSection mantığı: kapağın
 * hemen ardından, editör mektubundan ÖNCE okurun "bu sayıda neler
 * var?" sorusunu yanıtlayan kompakt liste. Tek bakışta sayının tüm
 * yapısı: Editör Mektubu + Kapak Dosyası + sabit köşe yer-tutucuları.
 *
 * Sabit köşeler (Yaşıt Köşesi / Okur Sayfası / Arka Sayfa) Faz 2'de
 * doldurulacak — şu an "Yakında" etiketi taşıyor; mimari Lapham's
 * "Voices in Time / Conversations / Miscellany" izinde.
 */

import type { Issue } from '../../data/issues';
import { resolveCoverDossier, formatIssuePad, resolveIssueSections } from '../../data/issues';
import { writers } from '../../data/writers';

interface Props {
  issue: Issue;
}

const { issue } = Astro.props;
const coverDossier = resolveCoverDossier(issue);
const issuePad = formatIssuePad(issue.number);

// Editör mektubu görünür ad — Senai Aksoy için "Doç. Dr." ön ek
const editorWriter = writers.find((w) => w.slug === issue.editorLetter.writerSlug);
const editorDisplayName =
  editorWriter?.slug === 'senai-aksoy'
    ? 'Doç. Dr. Senai Aksoy'
    : editorWriter?.displayName ?? 'Estranova';

// Sabit köşe slotları yalnızca yayınlandığında TOC'a girer.
// Planlı yer-tutucuları gizli tutmak ilk sayının 3 yazılı ritmini korur.
const sectionSlots = resolveIssueSections(issue).filter((slot) => slot.status === 'published');
---

<section class="border-t border-burgundy/10 bg-cream-soft px-6 py-12 md:py-16">
  <div class="mx-auto max-w-4xl">
    <header class="mb-8">
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
        Bu Sayıda
      </p>
      <h2 class="font-serif text-3xl leading-tight text-ink md:text-4xl">
        Sayı {issuePad} içindekiler
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-ink/65">
        Editör mektubu ve kapak dosyasındaki yazılar.
      </p>
    </header>

    <ul class="border-t border-burgundy/15">
      <li class="border-b border-burgundy/15 py-5">
        <a href="#bilimsel-editor-mektubu" class="group flex items-baseline gap-5">
          <span class="shrink-0 font-serif text-lg tabular-nums text-gold">—</span>
          <div class="min-w-0 flex-1">
            <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-burgundy/75">
              Bilimsel Editör Mektubu
            </p>
            <p class="mt-1 font-serif text-lg leading-snug text-ink group-hover:underline group-hover:decoration-burgundy/35 md:text-xl">
              {editorDisplayName}'in açılışı
            </p>
          </div>
          <span class="shrink-0 text-xs uppercase tracking-[0.18em] text-ink/55">
            ~3 dk
          </span>
        </a>
      </li>

      {coverDossier && coverDossier.articles.map((article, idx) => {
        const writer = writers.find((w) => w.slug === article.writerSlug);
        const writerName = writer?.displayName ?? 'Estranova';
        const isPlanned = article.status === 'planned';
        const Tag = !isPlanned && article.href ? 'a' : 'div';
        const tagProps = !isPlanned && article.href ? { href: article.href } : {};
        return (
          <li class="border-b border-burgundy/15 py-5">
            <Tag
              {...tagProps}
              class:list={[
                'group flex items-baseline gap-5',
                !isPlanned && article.href
                  ? 'cursor-pointer'
                  : 'opacity-80',
              ]}
            >
              <span class="shrink-0 font-serif text-lg tabular-nums text-gold">
                {String(idx + 1).padStart(2, '0')}
              </span>
              <div class="min-w-0 flex-1">
                <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-burgundy/75">
                  Kapak Dosyası · Yazan {writerName}
                </p>
                <p
                  class:list={[
                    'mt-1 font-serif text-lg leading-snug text-ink md:text-xl',
                    !isPlanned && article.href && 'group-hover:underline group-hover:decoration-burgundy/35',
                  ]}
                >
                  {article.title}
                </p>
              </div>
              <span class="shrink-0 text-xs uppercase tracking-[0.18em] text-ink/55">
                {isPlanned ? 'Yakında' : `~${article.readingMinutes ?? 7} dk`}
              </span>
            </Tag>
          </li>
        );
      })}

      {sectionSlots.map((slot) => {
        const isPublished = slot.status === 'published';
        const slotWriter = slot.writerSlug
          ? writers.find((w) => w.slug === slot.writerSlug)
          : undefined;
        const slotWriterName = slotWriter?.displayName ?? '';
        const Tag = isPublished && slot.href ? 'a' : 'div';
        const tagProps = isPublished && slot.href ? { href: slot.href } : {};
        return (
          <li class:list={['border-b border-burgundy/15 py-5', !isPublished && 'opacity-55']}>
            <Tag
              {...tagProps}
              class:list={[
                'group flex items-baseline gap-5',
                isPublished && slot.href ? 'cursor-pointer' : '',
              ]}
            >
              <span
                class:list={[
                  'shrink-0 font-serif text-lg tabular-nums',
                  isPublished ? 'text-gold' : 'text-gold/70',
                ]}
              >
                ·
              </span>
              <div class="min-w-0 flex-1">
                <p
                  class:list={[
                    'text-[10px] font-semibold uppercase tracking-[0.22em]',
                    isPublished ? 'text-burgundy/75' : 'text-burgundy/55',
                  ]}
                >
                  {slot.label}{isPublished && slotWriterName ? ` · Yazan ${slotWriterName}` : ''}
                </p>
                <p
                  class:list={[
                    'mt-1 font-serif text-lg leading-snug md:text-xl',
                    isPublished ? 'text-ink' : 'text-ink/55',
                    isPublished && slot.href && 'group-hover:underline group-hover:decoration-burgundy/35',
                  ]}
                >
                  {isPublished && slot.title ? slot.title : slot.description}
                </p>
              </div>
              <span
                class:list={[
                  'shrink-0 text-[10px] uppercase tracking-[0.2em]',
                  isPublished ? 'text-ink/55' : 'text-ink/45',
                ]}
              >
                {isPublished ? `~${slot.readingMinutes ?? 5} dk` : 'Yakında'}
              </span>
            </Tag>
          </li>
        );
      })}
    </ul>
  </div>
</section>
