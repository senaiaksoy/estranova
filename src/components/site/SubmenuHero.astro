---
/**
 * Alt menü / kategori sayfaları için tam genişlik hero görseli + başlık.
 */
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  imageSrc: string;
  imageAlt: string;
  /** Makale sayfalarında daha alçak şerit */
  compact?: boolean;
}

const { eyebrow, title, lede, imageSrc, imageAlt, compact = false } = Astro.props;
---

<section
  class:list={[
    'relative isolate w-full overflow-hidden bg-burgundy-deep',
    compact ? 'min-h-[min(56vh,560px)]' : 'min-h-[min(46vh,520px)] md:min-h-[min(90vh,1100px)]',
  ]}
  aria-labelledby="submenu-hero-title"
>
  <img
    src={imageSrc}
    alt={imageAlt}
    width="1800"
    height="1000"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    class:list={[
      'absolute inset-0 h-full w-full scale-[1.02] object-cover object-top',
      compact ? 'opacity-90' : '',
    ]}
  />
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1c1412]/78 via-[#1c1412]/30 to-[#1c1412]/5"></div>
  <div class="pointer-events-none absolute inset-y-0 left-0 hidden w-1/3 bg-gradient-to-r from-[#1c1412]/72 to-transparent md:block"></div>
  <div class="pointer-events-none absolute inset-x-6 bottom-6 top-24 hidden border border-cream-warm/18 md:block"></div>
  <div class="pointer-events-none absolute right-[8%] top-24 h-36 w-36 rounded-full bg-gold/16 blur-3xl"></div>
  <div
    class:list={[
      'relative z-10 mx-auto flex max-w-6xl flex-col justify-end px-6 pb-12 md:pb-16',
      compact ? 'min-h-[min(56vh,560px)] pt-36 md:pt-40' : 'min-h-[min(46vh,520px)] pt-28 md:pb-16 md:pt-36',
    ]}
  >
    <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.32em] text-cream-warm/90">
      <span class="h-px w-12 bg-gold/80"></span>
      <span>{eyebrow}</span>
    </p>
    <h1 id="submenu-hero-title" class="mt-5 max-w-5xl text-balance font-serif text-[clamp(3.35rem,7.8vw,8rem)] leading-[0.86] tracking-[-0.065em] text-white drop-shadow-[0_18px_42px_rgba(0,0,0,0.28)]">
      {title}
    </h1>
    {
      lede && (
        <p class="mt-7 max-w-2xl border-l border-gold/65 pl-5 text-base leading-relaxed text-white/88 md:text-xl">{lede}</p>
      )
    }
  </div>
</section>
