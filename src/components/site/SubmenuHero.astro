---
/**
 * Alt menü / kategori sayfaları için tam genişlik hero görseli + başlık.
 */
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  imageSrc: string;
  imageAlt: string;
  /** Makale sayfalarında daha alçak şerit */
  compact?: boolean;
}

const { eyebrow, title, lede, imageSrc, imageAlt, compact = false } = Astro.props;
---

<section
  class:list={[
    'relative isolate w-full overflow-hidden bg-burgundy-deep',
    compact ? 'min-h-[min(56vh,560px)]' : 'min-h-[min(46vh,520px)] md:min-h-[min(90vh,1100px)]',
  ]}
  aria-labelledby="submenu-hero-title"
>
  <img
    src={imageSrc}
    alt={imageAlt}
    width="1800"
    height="1000"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    class:list={[
      'absolute inset-0 h-full w-full scale-[1.02] object-cover object-top',
      compact ? 'opacity-90' : '',
    ]}
  />
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1c1412]/82 via-[#1c1412]/34 to-[#1c1412]/6"></div>
  <div class="pointer-events-none absolute inset-y-0 left-0 hidden w-[42%] bg-gradient-to-r from-[#1c1412]/76 via-[#1c1412]/34 to-transparent md:block"></div>
  <div class="pointer-events-none absolute inset-x-6 bottom-6 top-24 hidden border border-cream-warm/18 md:block"></div>
  <div class="pointer-events-none absolute inset-x-10 top-28 hidden h-px bg-gradient-to-r from-transparent via-gold/55 to-transparent md:block"></div>
  <div class="pointer-events-none absolute right-[8%] top-24 h-36 w-36 rounded-full bg-gold/18 blur-3xl"></div>
  <div class="pointer-events-none absolute bottom-8 right-[8%] hidden font-serif text-[11rem] italic leading-none text-white/[0.045] md:block" aria-hidden="true">
    E
  </div>
  <div
    class:list={[
      'relative z-10 mx-auto flex max-w-6xl flex-col justify-end px-6 pb-12 md:pb-16',
      compact ? 'min-h-[min(56vh,560px)] pt-36 md:pt-40' : 'min-h-[min(46vh,520px)] pt-28 md:pb-16 md:pt-36',
    ]}
  >
    <div class="mb-7 flex flex-wrap items-center gap-x-4 gap-y-2 text-[10px] font-bold uppercase tracking-[0.26em] text-cream-warm/82 md:text-xs">
      <span class="rounded-full border border-cream-warm/24 bg-white/[0.06] px-4 py-2 backdrop-blur-sm">{eyebrow}</span>
      <span class="hidden h-px w-12 bg-gold/70 sm:block"></span>
      <span class="font-serif font-normal italic tracking-[0.12em] text-gold">Estranova Dosya</span>
    </div>
    <p class="sr-only">{eyebrow}</p>
    <h1 id="submenu-hero-title" class="max-w-5xl text-balance font-serif text-[clamp(3.45rem,8vw,8.4rem)] leading-[0.84] tracking-[-0.07em] text-white drop-shadow-[0_18px_42px_rgba(0,0,0,0.28)]">
      {title}
    </h1>
    {
      lede && (
        <p class="mt-8 max-w-2xl border-l border-gold/70 pl-5 font-serif text-lg italic leading-relaxed text-white/90 md:text-2xl">{lede}</p>
      )
    }
  </div>
</section>
