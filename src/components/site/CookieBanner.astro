---
/**
 * CookieBanner — merkez modal, çerez onay paneli.
 *
 * `featureFlags.cookieBannerEnabled = true` olduğunda
 * `SiteLayout.astro` tarafından render edilir. İlk ziyarette seçim
 * yapılana kadar merkezde modal olarak görünür; karar verildiyse görünmez.
 * Footer'daki [data-cookie-trigger="open"] linki paneli yeniden açar.
 *
 * Kategoriler:
 *   • Zorunlu — her zaman açık (localStorage tercih saklama)
 *   • Analitik — kabulde GA4 granted, redde GA4 Consent Mode denied
 *     (PUBLIC_GA4_MEASUREMENT_ID gerekli)
 *
 * Mantık: src/scripts/cookie-consent.ts
 * Durum: src/utils/consent.ts
 */

const TITLE_ID = 'estranova-cookie-banner-title';
const DESC_ID = 'estranova-cookie-banner-desc';
---

<aside
  id="estranova-cookie-banner"
  role="dialog"
  aria-modal="true"
  aria-labelledby={TITLE_ID}
  aria-describedby={DESC_ID}
  aria-hidden="true"
  data-state="closed"
  data-view="collapsed"
  class="pointer-events-none fixed inset-0 z-50 flex items-center justify-center bg-ink/45 px-4 py-6 opacity-0 backdrop-blur-sm transition-opacity duration-300 ease-out motion-reduce:transition-none data-[state=open]:pointer-events-auto data-[state=open]:opacity-100 sm:px-6"
>
  <div class="w-full max-w-3xl">
    <div class="relative max-h-[calc(100vh-3rem)] overflow-y-auto rounded-[28px] border border-primary/12 bg-white p-5 shadow-[0_32px_96px_-36px_rgba(44,22,28,0.42)] ring-1 ring-black/[0.04] sm:p-7">
      <div data-section="collapsed">
        <p class="mb-2 flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.22em] text-gold">
          <svg class="h-2.5 w-2.5 shrink-0" viewBox="0 0 200 200" aria-hidden="true">
            <polygon
              fill="#000000"
              points="100,10 111.31,88.69 190,100 111.31,111.31 100,190 88.69,111.31 10,100 88.69,88.69"
            ></polygon>
          </svg>
          <span>ÇEREZ TERCİHİNİZ</span>
        </p>
        <h2
          id={TITLE_ID}
          class="mb-3 font-serif text-xl italic leading-tight text-secondary sm:text-2xl"
        >
          Sayfa kullanımını ölçmemize izin verir misiniz?
        </h2>
        <p
          id={DESC_ID}
          class="mb-5 max-w-[58ch] text-sm leading-relaxed text-ink/75 sm:text-[15px]"
        >
          Estranova; sayfa kullanımını anonim olarak anlamak için Google Analytics 4 kullanır.
          Kabul ederseniz analitik çerezleri açılır. Reddederseniz site aynı şekilde çalışır;
          yalnızca çerezsiz, temel ziyaret ölçümü yapılır.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <button
            type="button"
            data-action="accept-all"
            class="inline-flex min-h-[44px] flex-1 items-center justify-center rounded-xl border border-primary/40 bg-secondary px-5 text-sm font-semibold text-white transition hover:bg-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
          >
            Tümünü kabul et
          </button>
          <button
            type="button"
            data-action="reject-all"
            class="inline-flex min-h-[44px] flex-1 items-center justify-center rounded-xl border border-primary/40 bg-white px-5 text-sm font-semibold text-secondary transition hover:bg-primary/5 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
          >
            Reddet
          </button>
          <button
            type="button"
            data-action="open-preferences"
            class="inline-flex min-h-[44px] items-center justify-center gap-1 rounded-xl px-3 text-sm font-medium text-secondary underline decoration-gold-bronze/30 underline-offset-4 transition hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 sm:flex-shrink-0"
          >
            Tercihler →
          </button>
        </div>
        <p class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 border-t border-gold/30 pt-4 text-[10px] font-bold uppercase tracking-[0.2em] text-gold-bronze/85">
          <a
            href="/cerez-politikasi/"
            class="underline decoration-gold-bronze/30 underline-offset-2 transition hover:text-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/35"
          >
            Çerez politikası
          </a>
          <span class="text-gold">·</span>
          <a
            href="/kvkk/"
            class="underline decoration-gold-bronze/30 underline-offset-2 transition hover:text-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/35"
          >
            KVKK
          </a>
        </p>
      </div>

      <div data-section="expanded" hidden>
        <h2 class="mb-1 font-serif text-xl italic leading-tight text-secondary sm:text-2xl">
          Çerez tercihleri
        </h2>
        <p class="mb-5 text-[10px] font-bold uppercase tracking-[0.2em] text-gold-bronze/85">
          Kategorileri ayrı ayrı seçebilirsiniz
        </p>

        <div class="space-y-4">
          <div class="rounded-2xl border border-gold/30 bg-cream/50 p-4">
            <div class="flex items-start gap-3">
              <input
                type="checkbox"
                id="consent-essential"
                checked
                disabled
                aria-describedby="consent-essential-desc"
                class="mt-1 h-4 w-4 shrink-0 rounded border-primary/30 text-secondary accent-secondary focus:ring-primary/40 disabled:opacity-70"
              />
              <div class="flex-1">
                <label for="consent-essential" class="block text-sm font-semibold text-secondary">
                  Zorunlu
                  <span class="ml-1 text-[10px] uppercase tracking-[0.2em] text-gold-bronze/85">· Her zaman açık</span>
                </label>
                <p id="consent-essential-desc" class="mt-1 text-xs leading-relaxed text-ink/70 sm:text-sm">
                  Yazı boyutu, kayıtlı makaleler gibi tarayıcı tercihleriniz için
                  yalnızca tarayıcınızda kalan teknik depolama. Sunucuya gönderilmez.
                </p>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-primary/12 bg-white p-4">
            <div class="flex items-start gap-3">
              <input
                type="checkbox"
                id="consent-analytics"
                data-toggle="analytics"
                aria-describedby="consent-analytics-desc"
                class="mt-1 h-4 w-4 shrink-0 rounded border-primary/40 accent-secondary focus:ring-primary/40"
              />
              <div class="flex-1">
                <label for="consent-analytics" class="block text-sm font-semibold text-secondary">
                  Analitik
                  <span class="ml-1 text-[10px] uppercase tracking-[0.2em] text-gold-bronze/85">· Google Analytics 4</span>
                </label>
                <p id="consent-analytics-desc" class="mt-1 text-xs leading-relaxed text-ink/70 sm:text-sm">
                  Hangi içeriklerin okunduğunu anonim olarak ölçer. Kabul ederseniz analitik
                  çerezleri açılır; reddederseniz yalnızca çerezsiz temel ölçüm pingi gönderilir.
                  IP kısaltılır, pazarlama özellikleri kapalıdır.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <button
            type="button"
            data-action="save-preferences"
            class="inline-flex min-h-[44px] flex-1 items-center justify-center rounded-xl bg-secondary px-5 text-sm font-semibold text-white transition hover:bg-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
          >
            Tercihlerimi kaydet
          </button>
          <button
            type="button"
            data-action="reject-all"
            class="inline-flex min-h-[44px] items-center justify-center rounded-xl border border-primary/40 bg-white px-5 text-sm font-semibold text-secondary transition hover:bg-primary/5 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
          >
            Tümünü reddet
          </button>
        </div>
      </div>
    </div>
  </div>
</aside>

<script>
  import '../../scripts/cookie-consent';
</script>
