---
/**
 * "Hekiminize danışmanın anlamlı olduğu durumlar" — makale içi
 * mikro-format, gold-bronze çerçeveli kutu.
 *
 * Versalie ve Gennev'in eksik bıraktığı, Estranova'nın tıbbi güven
 * mimarisini somutlaştıran bir bileşen: makaleyi okuyan kişiye
 * "ne durumlarda hekim değerlendirmesi anlamlı olur" sorusunun
 * sade, panik dilinden uzak yanıtı.
 *
 * CLAUDE.md HARD CONSTRAINT §4 uyumu:
 * — Tedavi/teşhis önermez (yalnızca semptom-dikkat eşleşmesi).
 * — "Hemen / acil / kesin" panik dili YASAK; "anlamlı olabilir",
 *   "değerlendirilmesinde fayda var" yumuşatma kullanılır.
 * — Reklam/yönlendirme yok; sade bilgilendirme.
 *
 * Kullanım:
 *   <RedFlagBox
 *     markers={[
 *       'Beklenmedik / yoğun adet kanaması',
 *       'Göğüs ağrısı + nefes darlığı eşlik ediyorsa',
 *       'Ani kilo kaybı veya iştahsızlık',
 *     ]}
 *   />
 */

interface Props {
  /** Üst başlık — varsayılan: "Hekiminize danışmanın anlamlı olduğu durumlar" */
  title?: string;
  /** Tek cümlelik açıklama — varsayılan: bilgilendirme amaçlı not */
  intro?: string;
  /** Belirti maddeleri (3-7 öneri) */
  markers: string[];
  /** Alt satır — opsiyonel, "şunu hatırla" türü ek not */
  footnote?: string;
}

const {
  title = 'Hekiminize danışmanın anlamlı olduğu durumlar',
  intro = 'Aşağıdaki belirtiler tek başına bir tanı anlamına gelmez; ama hekim değerlendirmesinde fayda görebileceğin durumlardır.',
  markers,
  footnote,
} = Astro.props;
---

<aside
  class="my-10 rounded-[24px] border border-gold/40 bg-gradient-to-br from-cream-warm/60 to-cream-soft/40 p-7 shadow-[0_16px_44px_-28px_rgba(201,169,110,0.45)] md:my-12 md:p-8"
  role="complementary"
  aria-labelledby="red-flag-title"
>
  <div class="flex items-start gap-4">
    <span
      class="mt-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-gold/55 bg-white text-gold"
      aria-hidden="true"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
        <path
          d="M9 2.25v1.5M9 14.25v1.5M2.25 9h1.5M14.25 9h1.5M4.22 4.22l1.06 1.06M12.72 12.72l1.06 1.06M4.22 13.78l1.06-1.06M12.72 5.28l1.06-1.06"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
        <circle cx="9" cy="9" r="2.5" stroke="currentColor" stroke-width="1.6" />
      </svg>
    </span>
    <div class="min-w-0 flex-1">
      <p class="mb-2 text-[10px] font-bold uppercase tracking-[0.24em] text-gold">
        Dikkat çekmek istediğimiz
      </p>
      <h3 id="red-flag-title" class="mb-3 font-serif text-xl leading-snug text-burgundy md:text-2xl">
        {title}
      </h3>
      <p class="mb-5 text-sm leading-relaxed text-ink/80 md:text-base">{intro}</p>

      <ul class="space-y-2.5">
        {markers.map((marker) => (
          <li class="flex items-start gap-3 text-sm leading-relaxed text-ink/85 md:text-base">
            <span
              class="mt-2 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-gold"
              aria-hidden="true"
            ></span>
            <span>{marker}</span>
          </li>
        ))}
      </ul>

      {footnote && (
        <p class="mt-5 border-t border-gold/30 pt-4 font-serif text-sm italic leading-relaxed text-ink/65">
          {footnote}
        </p>
      )}
    </div>
  </div>
</aside>
