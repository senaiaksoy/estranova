---
/**
 * Bölümler arası tam genişlik editöryel epigraf.
 * Italic Newsreader; iki ince gold hairline arasında, krem ya da bordo zeminde.
 * Sayfanın duygusal merkezi — sayfa başına tek bir tane kullan.
 */
interface Props {
  quote: string;
  attribution?: string;
  variant?: 'cream' | 'bordo';
}

const { quote, attribution, variant = 'cream' } = Astro.props;
---

<aside
  class:list={[
    'relative w-full px-6 py-16 md:py-24',
    variant === 'bordo'
      ? 'bg-gradient-to-br from-[#4f171c] to-[#2a0c0f] text-[#fcf9f4]'
      : 'bg-[#FDF8F0] text-[#4f171c]',
  ]}
  aria-label="Editöryel epigraf"
>
  <div class="absolute top-0 left-1/2 h-px w-[min(82%,52rem)] -translate-x-1/2 bg-[#C9A96E]/45"></div>
  <div class="absolute bottom-0 left-1/2 h-px w-[min(82%,52rem)] -translate-x-1/2 bg-[#C9A96E]/45"></div>
  <blockquote class="mx-auto max-w-3xl text-center">
    <p class="font-serif text-2xl italic leading-snug md:text-3xl lg:text-[2.4rem] lg:leading-[1.2]">
      &ldquo;{quote}&rdquo;
    </p>
    {attribution && (
      <cite class="mt-7 block text-[10px] font-bold uppercase tracking-[0.32em] not-italic opacity-65 md:text-xs">
        — {attribution}
      </cite>
    )}
  </blockquote>
</aside>
