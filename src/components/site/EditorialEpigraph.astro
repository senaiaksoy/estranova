---
/**
 * Bölümler arası tam genişlik editöryel epigraf.
 * Italic editorial emphasis; iki ince gold hairline arasında, krem ya da bordo zeminde.
 * Sayfanın duygusal merkezi — sayfa başına tek bir tane kullan.
 */
interface Props {
  quote: string;
  attribution?: string;
  variant?: 'cream' | 'bordo';
}

const { quote, attribution, variant = 'cream' } = Astro.props;
---

<aside
  class:list={[
    'relative w-full px-6 py-16 md:py-24',
    variant === 'bordo'
      ? 'bg-gradient-to-br from-secondary to-[#2a0c0f] text-surface'
      : 'bg-cream-soft text-secondary',
  ]}
  aria-label="Editöryel epigraf"
>
  <div class="absolute top-0 left-1/2 h-px w-[min(82%,52rem)] -translate-x-1/2 bg-gold/45"></div>
  <div class="absolute bottom-0 left-1/2 h-px w-[min(82%,52rem)] -translate-x-1/2 bg-gold/45"></div>
  <blockquote class="mx-auto max-w-3xl text-center">
    <p class="font-sans text-2xl italic leading-snug tracking-[0.004em] md:text-3xl lg:text-[2.25rem] lg:leading-[1.28]">
      &ldquo;{quote}&rdquo;
    </p>
    {attribution && (
      <cite class="mt-7 block text-[10px] font-bold uppercase tracking-[0.32em] not-italic opacity-65 md:text-xs">
        — {attribution}
      </cite>
    )}
  </blockquote>
</aside>
