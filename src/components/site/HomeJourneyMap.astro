---
import { submenuHeroByRoute } from '../../data/submenu-heroes';
import type { HomeJourneyItem } from '../../data/home-journey-path';

interface Props {
  sectionNumber?: string;
  sectionLabel: string;
  title: string;
  lede: string;
  items: HomeJourneyItem[];
}

const {
  sectionNumber = '01',
  sectionLabel,
  title,
  lede,
  items,
} = Astro.props;

const hasItems = items.length > 0;
const featured = hasItems ? items.find((item) => item.featured) ?? items[0] : undefined;
const secondaryItems = featured ? items.filter((item) => item.href !== featured.href) : [];
const featuredImage =
  featured ? submenuHeroByRoute[featured.imageKey] ?? submenuHeroByRoute['/hormonal-gecis'] : undefined;
---

{hasItems && featured && featuredImage && (
<section class="relative isolate overflow-hidden border-t border-burgundy/10 bg-[linear-gradient(180deg,rgba(248,244,238,0.92)_0%,rgba(255,255,255,1)_42%,rgba(250,247,242,0.82)_100%)] px-6 py-16 md:py-24">
  <div class="pointer-events-none absolute inset-x-6 top-0 h-px bg-gradient-to-r from-transparent via-gold/65 to-transparent"></div>
  <div class="pointer-events-none absolute -left-16 top-14 h-56 w-56 rounded-full bg-gold/12 blur-3xl"></div>
  <div class="pointer-events-none absolute right-0 top-10 hidden font-serif text-[10rem] italic leading-none tracking-[-0.08em] text-burgundy/[0.035] xl:block">
    rota
  </div>

  <div class="mx-auto max-w-6xl">
    <header class="mb-12 grid gap-8 md:grid-cols-[0.78fr_1.22fr] md:items-end">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
          <span class="font-serif font-normal tabular-nums text-gold">{sectionNumber}</span>
          <span class="mx-2 text-gold">—</span>
          {sectionLabel}
        </p>
      </div>
      <div>
        <h2 class="mb-4 max-w-3xl font-serif text-4xl leading-[0.98] tracking-[-0.04em] text-ink md:text-6xl">
          {title}
        </h2>
        <p class="max-w-2xl border-l border-gold/55 pl-5 font-serif text-xl italic leading-relaxed text-burgundy/82">
          {lede}
        </p>
      </div>
    </header>

    <div class="grid gap-7 lg:grid-cols-[1.08fr_0.92fr] lg:items-stretch">
      <a
        href={featured.href}
        class="group relative overflow-hidden rounded-[38px] border border-burgundy/14 bg-[#22181b] shadow-[0_40px_120px_-72px_rgba(44,22,28,0.58)] ring-1 ring-white/70 transition duration-300 hover:-translate-y-1 hover:border-gold/45 focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
        aria-label={`${featured.title} içeriğini incele`}
      >
        <div class="absolute inset-0">
          <img
            src={featuredImage.src}
            alt={featuredImage.alt}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.035]"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#1d1416]/90 via-[#1d1416]/44 to-transparent"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-[#1d1416]/38 via-transparent to-transparent"></div>
        </div>
        <div class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-gold/80 to-transparent"></div>

        <div class="relative flex min-h-[540px] flex-col justify-end p-8 md:p-10">
          <div class="mb-8 flex flex-wrap items-center gap-3 text-[10px] font-semibold uppercase tracking-[0.24em]">
            <span class="rounded-full border border-white/24 bg-white/10 px-4 py-2 text-white/88 backdrop-blur-md">
              {featured.step}
            </span>
            <span class="rounded-full bg-gold/90 px-3 py-1.5 text-[#3a1216]">
              {featured.eyebrow}
            </span>
          </div>
          <p class="mb-3 text-[10px] font-semibold uppercase tracking-[0.28em] text-gold/92">
            Öne çıkan rota
          </p>
          <h3 class="mb-5 max-w-[10ch] font-serif text-5xl leading-[0.92] tracking-[-0.05em] text-white md:text-7xl">
            {featured.title}
          </h3>
          <p class="max-w-xl border-l border-gold/70 pl-5 font-serif text-xl italic leading-relaxed text-white/84">
            {featured.excerpt}
          </p>
          <div class="mt-8 flex items-center justify-between border-t border-white/16 pt-5 text-white/78">
            <span class="text-xs font-bold uppercase tracking-[0.18em]">{featured.ctaLabel}</span>
            <span class="font-serif text-3xl text-gold transition group-hover:translate-x-1" aria-hidden="true">→</span>
          </div>
        </div>
      </a>

      <div class="overflow-hidden rounded-[34px] border border-burgundy/12 bg-white shadow-[0_28px_90px_-66px_rgba(44,22,28,0.3)] ring-1 ring-black/[0.04]">
        <div class="border-b border-burgundy/10 px-6 py-4">
          <p class="text-[10px] font-bold uppercase tracking-[0.24em] text-burgundy/72">Diğer geçiş rotaları</p>
        </div>
        {secondaryItems.slice(0, 3).map((item) => (
          <a
            href={item.href}
            class="group grid gap-4 border-t border-burgundy/10 px-5 py-5 transition hover:bg-cream-soft/35 first:border-t-0 md:grid-cols-[88px_1fr_auto] md:items-center md:gap-6 md:px-6"
            aria-label={`${item.title} içeriğini incele`}
          >
            <div class="flex items-center gap-3 md:block">
              <span class="block font-serif text-5xl italic leading-none tabular-nums text-gold md:text-6xl">
                {item.step}
              </span>
              <span class="mt-2 block text-[10px] font-semibold uppercase tracking-[0.22em] text-burgundy/62">
                {item.eyebrow}
              </span>
            </div>

            <div>
              <h3 class="mb-2 font-serif text-2xl leading-tight tracking-[-0.025em] text-ink transition group-hover:text-burgundy md:text-[2rem]">
                {item.title}
              </h3>
              <p class="max-w-2xl text-sm leading-relaxed text-ink/70 md:text-[0.98rem]">
                {item.excerpt}
              </p>
            </div>

            <div class="flex items-center justify-between gap-5 border-t border-burgundy/10 pt-3 text-xs font-bold uppercase tracking-[0.17em] text-burgundy/75 md:border-t-0 md:pt-0">
              <span>{item.ctaLabel}</span>
              <span class="font-serif text-2xl text-gold transition group-hover:translate-x-1" aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
)}
