---
import { EVIDENCE_LABELS as LABELS, type EvidenceLevel } from '../../utils/evidence';
export type { EvidenceLevel };

interface Props {
  level?: EvidenceLevel;
  from?: EvidenceLevel;
  to?: EvidenceLevel;
}

const { level, from, to } = Astro.props;

const isRange = from !== undefined && to !== undefined;
const displayLabel = isRange ? `${LABELS[from!]}–${LABELS[to!]} kanıt` : `${LABELS[level!]} kanıt`;
const tooltip = isRange
  ? `Kanıt düzeyi: ${LABELS[from!]}–${LABELS[to!]} (${from}–${to}/5)`
  : `Kanıt düzeyi: ${LABELS[level!]} (${level}/5)`;
const displayLevel = isRange ? to! : level!;
---

<span class="evidence" data-level={displayLevel} title={tooltip} aria-label={tooltip}>(<span class="evidence-label">{displayLabel}</span>)</span>
