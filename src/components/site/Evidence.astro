---
export type EvidenceLevel = 1 | 2 | 3 | 4 | 5;

interface Props {
  level?: EvidenceLevel;
  from?: EvidenceLevel;
  to?: EvidenceLevel;
}

const { level, from, to } = Astro.props;

const LABELS: Record<EvidenceLevel, string> = {
  5: 'güçlü',
  4: 'iyi',
  3: 'orta',
  2: 'sınırlı',
  1: 'zayıf',
};

const isRange = from !== undefined && to !== undefined;
const displayLabel = isRange ? `${LABELS[from!]}–${LABELS[to!]} kanıt` : `${LABELS[level!]} kanıt`;
const tooltip = isRange
  ? `Kanıt düzeyi: ${LABELS[from!]}–${LABELS[to!]} (${from}–${to}/5)`
  : `Kanıt düzeyi: ${LABELS[level!]} (${level}/5)`;
const displayLevel = isRange ? to! : level!;
---

<span class="evidence" data-level={displayLevel} title={tooltip} aria-label={tooltip}>
  (<span class="evidence-label">{displayLabel}</span>)
</span>
