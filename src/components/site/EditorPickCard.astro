---
import { writers } from '../../data/writers';

interface Props {
  href: string;
  title: string;
  lede: string;
  writerSlug: string;
  readingMinutes: number;
  imageSrc: string;
  imageAlt: string;
  /** Eyebrow label — sub-hub'a göre varyant. Default: "Sayının Açılışı" */
  eyebrow?: string;
  /** CTA metni — default: "Okumaya başla" */
  cta?: string;
}

const {
  href,
  title,
  lede,
  writerSlug,
  readingMinutes,
  imageSrc,
  imageAlt,
  eyebrow = 'Sayının Açılışı',
  cta = 'Okumaya başla',
} = Astro.props;

const writer = writers.find((w) => w.slug === writerSlug);
---

<a
  href={href}
  class="group block overflow-hidden rounded-[32px] border border-[#6B2D3E]/15 bg-white shadow-[0_24px_60px_-32px_rgba(44,24,28,0.18)] ring-1 ring-black/[0.04] transition hover:border-[#6B2D3E]/30 hover:shadow-[0_28px_72px_-30px_rgba(44,24,28,0.24)]"
>
  <div class="grid grid-cols-1 lg:grid-cols-[1.05fr_1fr]">
    <div class="relative aspect-[4/3] overflow-hidden lg:aspect-auto lg:min-h-[420px]">
      <img
        src={imageSrc}
        alt={imageAlt}
        class="h-full w-full object-cover object-center transition duration-700 group-hover:scale-[1.02]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="flex flex-col justify-between gap-8 p-8 md:p-10 lg:p-12">
      <div>
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.22em] text-[#C9A96E]">{eyebrow}</p>
        <h3 class="mb-5 font-serif text-2xl leading-tight text-[#2D2D2D] group-hover:text-[#6B2D3E] md:text-3xl">
          {title}
        </h3>
        <p class="font-serif text-lg italic leading-relaxed text-[#6B2D3E]/85 md:text-xl">
          "{lede}"
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-[#6B2D3E]/12 pt-6 text-sm text-[#2D2D2D]/70">
        {
          writer && (
            <>
              <span class="font-semibold text-[#2D2D2D]">{writer.displayName}</span>
              <span class="text-[#C9A96E]">·</span>
              <span>{writer.role.split('/')[0].trim()}</span>
              <span class="text-[#C9A96E]">·</span>
            </>
          )
        }
        <span>{readingMinutes} dk okuma</span>
        <span class="ml-auto inline-flex items-center gap-2 font-semibold text-[#6B2D3E] group-hover:underline">
          {cta}
          <span aria-hidden="true">→</span>
        </span>
      </div>
    </div>
  </div>
</a>
