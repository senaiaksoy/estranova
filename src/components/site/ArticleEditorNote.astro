---
/**
 * Makale sonu bilimsel editör notu.
 * Klinik güven katmanını promosyon diline düşmeden premium bir kutuya taşır.
 */
interface Props {
  title?: string;
  class?: string;
}

const { title = 'Bilimsel Editör Notu', class: className } = Astro.props;
---

<section
  class:list={[
    'relative overflow-hidden rounded-[38px] border border-burgundy/14 bg-gradient-to-br from-cream-warm via-cream-soft to-white p-7 shadow-[0_30px_82px_-44px_rgba(44,22,28,0.34)] ring-1 ring-white/75 md:p-9',
    className,
  ]}
>
  <div class="pointer-events-none absolute left-0 top-0 h-full w-1.5 bg-gradient-to-b from-gold via-burgundy/45 to-transparent"></div>
  <div class="pointer-events-none absolute right-0 top-0 h-32 w-32 rounded-bl-full bg-burgundy/8"></div>
  <div class="pointer-events-none absolute right-9 top-8 font-serif text-7xl leading-none text-burgundy/[0.07]" aria-hidden="true">not</div>
  <p class="relative mb-3 flex items-center gap-3 text-[10px] font-bold uppercase tracking-[0.26em] text-burgundy">
    <span class="h-px w-10 bg-gold/80"></span>
    <span>{title}</span>
  </p>
  <div class="relative max-w-3xl space-y-3 border-t border-gold/25 pt-5 leading-relaxed text-ink/80 [&_strong]:font-semibold [&_strong]:text-burgundy">
    <slot />
  </div>
</section>
