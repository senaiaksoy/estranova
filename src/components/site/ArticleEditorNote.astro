---
/**
 * Makale sonu bilimsel editör notu.
 * Klinik güven katmanını promosyon diline düşmeden premium bir kutuya taşır.
 */
interface Props {
  title?: string;
  class?: string;
}

const { title = 'Bilimsel Editör Notu', class: className } = Astro.props;
---

<section
  class:list={[
    'relative overflow-hidden rounded-[34px] border border-burgundy/14 bg-gradient-to-br from-cream-warm via-cream-soft to-white p-7 shadow-[0_26px_72px_-42px_rgba(44,22,28,0.3)] ring-1 ring-white/75 md:p-8',
    className,
  ]}
>
  <div class="pointer-events-none absolute left-0 top-0 h-full w-1.5 bg-gradient-to-b from-gold via-burgundy/45 to-transparent"></div>
  <div class="pointer-events-none absolute right-0 top-0 h-28 w-28 rounded-bl-full bg-burgundy/8"></div>
  <p class="relative mb-3 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.22em] text-burgundy">
    <span class="h-px w-10 bg-gold/80"></span>
    <span>{title}</span>
  </p>
  <div class="relative space-y-3 leading-relaxed text-ink/80 [&_strong]:font-semibold [&_strong]:text-burgundy">
    <slot />
  </div>
</section>
