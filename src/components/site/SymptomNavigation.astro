---
/**
 * SymptomNavigation — anasayfa "Belirti Bazlı Navigasyon" bölümü.
 *
 * Editöryel belirti atlası: öne çıkan bir kapak kartı,
 * ikincil atlas kartı ve kısa okuma rotaları.
 *
 * Veri kaynağı: src/data/symptoms.ts (anasayfa bento ve /symptoms
 * rehber sayfası için tek kaynak).
 *
 * Fotoğraflar: public/images/symptoms/*.webp
 */

import { symptoms } from '../../data/symptoms';

interface Props {
  sectionNumber?: string;
}

const { sectionNumber = '05' } = Astro.props;
const featured = symptoms.filter((s) => s.featured);
const rest = symptoms.filter((s) => !s.featured);
const primary = featured[0];
const secondary = featured[1];
---

<section class="relative isolate overflow-hidden border-t border-burgundy/10 bg-white px-6 py-16 md:py-24">
  <div class="pointer-events-none absolute -left-24 top-20 h-72 w-72 rounded-full bg-gold/12 blur-3xl"></div>
  <div class="pointer-events-none absolute right-0 top-12 hidden font-serif text-[12rem] italic leading-none tracking-[-0.08em] text-burgundy/[0.045] lg:block">
    atlas
  </div>

  <div class="mx-auto max-w-6xl">
    <header class="mb-12 grid gap-8 md:grid-cols-[0.82fr_1.18fr] md:items-end">
      <div>
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
          <span class="font-serif font-normal tabular-nums text-gold">{sectionNumber}</span>
          <span class="mx-2 text-gold">—</span>
          Belirti Atlası
        </p>
        <a
          href="/symptoms"
          class="inline-flex items-center gap-2 rounded-full border border-burgundy/14 bg-white/70 px-5 py-2.5 text-xs font-bold uppercase tracking-[0.18em] text-burgundy shadow-sm transition hover:border-gold/35 hover:bg-white focus:outline-none focus:ring-2 focus:ring-burgundy/30"
        >
          <span>Belirti rehberini aç</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <div>
        <h2 class="mb-5 max-w-3xl font-serif text-4xl leading-[0.98] tracking-[-0.035em] text-ink md:text-6xl">
          Bedenin nereden ses veriyor?
        </h2>
        <p class="max-w-2xl border-l border-gold/55 pl-5 font-serif text-xl italic leading-relaxed text-burgundy/82">
          Bir belirtiden başlamak bazen en dürüst başlangıçtır. Burada amaç hızlı cevap vermek değil; bedenin işaretini sakin bir okuma rotasına çevirmek.
        </p>
      </div>
    </header>

    <div class="grid gap-7 lg:grid-cols-[1.08fr_0.92fr] lg:items-stretch">
      {
        primary && (
          <a
            href={primary.href}
            class="group relative min-h-[520px] overflow-hidden rounded-[42px] border border-burgundy/14 bg-ink shadow-[0_42px_130px_-68px_rgba(44,24,28,0.62)] ring-1 ring-white/75 transition duration-300 hover:-translate-y-1 hover:border-gold/45 focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
            aria-label={`${primary.title} rehberini oku`}
          >
            <img
              src={primary.image}
              alt={primary.alt}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#1c1412]/82 via-[#1c1412]/30 to-transparent"></div>
            <div class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-gold/80 to-transparent"></div>
            <div class="relative flex h-full min-h-[520px] flex-col justify-end p-7 md:p-10">
              <div class="mb-7 flex flex-wrap items-center gap-3">
                <span class="rounded-full border border-white/35 bg-white/16 px-4 py-2 text-[0.62rem] font-bold uppercase tracking-[0.24em] text-white backdrop-blur-md">
                  Ana işaret
                </span>
                <span class="rounded-full bg-gold/95 px-3 py-1.5 text-[0.62rem] font-bold uppercase tracking-[0.18em] text-[#3a1216]">
                  {primary.evidence}
                </span>
              </div>
              <h3 class="mb-5 max-w-[9ch] font-serif text-5xl leading-[0.9] tracking-[-0.05em] text-white md:text-7xl">
                {primary.title}
              </h3>
              <p class="max-w-xl border-l border-gold/70 pl-5 font-serif text-xl italic leading-relaxed text-white/86">
                {primary.caption}
              </p>
              <div class="mt-8 flex items-center justify-between border-t border-white/18 pt-5 text-white/76">
                <span class="text-xs font-bold uppercase tracking-[0.18em]">
                  <span>Rehberi oku</span>
                </span>
                <span class="font-serif text-3xl text-gold transition group-hover:translate-x-1" aria-hidden="true">→</span>
              </div>
            </div>
          </a>
        )
      }

      <div class="grid gap-5">
        {
          secondary && (
            <a
              href={secondary.href}
              class="group relative overflow-hidden rounded-[34px] border border-burgundy/14 bg-gradient-to-br from-white via-[#fffaf2] to-cream-warm/60 shadow-[0_30px_96px_-60px_rgba(44,22,28,0.44)] ring-1 ring-white/80 transition duration-300 hover:-translate-y-0.5 hover:border-gold/40 focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
              aria-label={`${secondary.title} rehberini oku`}
            >
              <div class="grid gap-0 md:grid-cols-[0.9fr_1.1fr] lg:grid-cols-1 xl:grid-cols-[0.85fr_1.15fr]">
                <div class="relative min-h-56 overflow-hidden">
                  <img
                    src={secondary.image}
                    alt={secondary.alt}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.035]"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#1c1412]/42 via-transparent to-transparent"></div>
                </div>
                <div class="relative p-7">
                  <span class="mb-5 inline-flex rounded-full bg-gold/90 px-3 py-1.5 text-[0.6rem] font-bold uppercase tracking-[0.18em] text-[#3a1216]">
                    {secondary.evidence}
                  </span>
                  <h3 class="mb-3 max-w-[10ch] font-serif text-4xl leading-[0.96] tracking-[-0.035em] text-ink transition group-hover:text-burgundy">
                    {secondary.title}
                  </h3>
                  <p class="font-serif text-lg italic leading-relaxed text-burgundy/78">
                    {secondary.caption}
                  </p>
                  <div class="mt-6 flex items-center justify-between border-t border-burgundy/12 pt-4 text-xs font-bold uppercase tracking-[0.18em] text-burgundy/75">
                    <span>Rehberi oku</span>
                    <span class="font-serif text-2xl text-gold transition group-hover:translate-x-1" aria-hidden="true">→</span>
                  </div>
                </div>
              </div>
            </a>
          )
        }

        <div class="overflow-hidden rounded-[34px] border border-burgundy/12 bg-white/75 shadow-[0_24px_80px_-58px_rgba(44,22,28,0.34)] ring-1 ring-white/80">
          {rest.map((s, index) => (
            <a
              href={s.href}
              class="group grid gap-4 border-t border-burgundy/10 px-5 py-5 transition hover:bg-cream-soft/70 first:border-t-0 md:grid-cols-[72px_1fr_auto] md:items-center md:px-6"
              aria-label={`${s.title} okuma rotasını aç`}
            >
              <div class="relative h-20 overflow-hidden rounded-[20px]">
                <img
                  src={s.image}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.05]"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#1c1412]/26 via-transparent to-transparent"></div>
              </div>
              <div>
                <p class="mb-1 text-[0.62rem] font-bold uppercase tracking-[0.2em] text-gold-bronze">
                  {String(index + 3).padStart(2, '0')} · {s.category} · {s.evidence}
                </p>
                <h3 class="mb-1 font-serif text-2xl leading-tight tracking-[-0.02em] text-ink transition group-hover:text-burgundy">
                  {s.title}
                </h3>
                <p class="max-w-2xl text-sm leading-relaxed text-ink/70">{s.desc}</p>
              </div>
              <div class="flex items-center justify-between gap-5 border-t border-burgundy/10 pt-3 text-xs font-bold uppercase tracking-[0.17em] text-burgundy/72 md:border-t-0 md:pt-0">
                <span>Okuma rotası</span>
                <span class="font-serif text-2xl text-gold transition group-hover:translate-x-1" aria-hidden="true">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
