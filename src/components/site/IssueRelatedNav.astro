---
/**
 * Sayı detay sayfasının altında "Önceki Sayı / Sonraki Sayı" navigasyonu.
 *
 * Paris Review ve Cabinet Magazine'in sayılar arası gezinme deseni:
 * okuyucu sayıyı tamamladığında sıradaki sayıya doğal geçiş yapar,
 * dergi okurluğu sürekliliği kurar.
 *
 * İlk veya son sayıda eksik tarafı "ilk sayı / yakında" yumuşak metniyle
 * göstererek kırılganlığı sessizleştirir.
 */

import type { Issue } from '../../data/issues';
import { releasedIssues as issues, formatIssuePad } from '../../data/issues';
import { magazineConfig } from '../../data/magazine-config';

interface Props {
  currentIssue: Issue;
}

const { currentIssue } = Astro.props;

// Numerik sayılar (Sayı 0 = arşiv hariç), küçükten büyüğe sıralı
const numberedIssues = issues
  .filter((i) => i.number > 0)
  .sort((a, b) => a.number - b.number);

const currentIndex = numberedIssues.findIndex((i) => i.number === currentIssue.number);
const prevIssue =
  currentIndex > 0 ? numberedIssues[currentIndex - 1] : undefined;
const nextIssue =
  currentIndex >= 0 && currentIndex < numberedIssues.length - 1
    ? numberedIssues[currentIndex + 1]
    : undefined;
---

<section class="border-t border-burgundy/10 bg-white px-6 py-12 md:py-16">
  <div class="mx-auto max-w-5xl">
    <p class="mb-6 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
      Sayılar arası
    </p>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6">
      {prevIssue ? (
        <a
          href={`/sayi/${prevIssue.slug}/`}
          class="group flex flex-col rounded-[24px] border border-burgundy/12 bg-white p-6 shadow-[0_18px_56px_-44px_rgba(44,22,28,0.24)] ring-1 ring-black/[0.04] transition hover:-translate-y-0.5 hover:border-gold/35 hover:bg-cream-soft/18 hover:shadow-[0_24px_70px_-48px_rgba(44,22,28,0.30)] focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2 md:p-7"
        >
          <p class="mb-2 text-[10px] font-semibold uppercase tracking-[0.22em] text-burgundy/75">
            ← Önceki sayı
          </p>
          <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-gold">
            {magazineConfig.name} · Sayı {formatIssuePad(prevIssue.number)} · {prevIssue.monthYear}
          </p>
          <h3 class="mt-2 font-serif text-2xl leading-snug text-ink group-hover:underline group-hover:decoration-burgundy/35 md:text-[28px]">
            {prevIssue.theme}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-ink/65">{prevIssue.lede}</p>
        </a>
      ) : (
        <div class="flex flex-col rounded-[24px] border border-dashed border-burgundy/20 bg-white p-6 opacity-70 ring-1 ring-black/[0.03] md:p-7">
          <p class="mb-2 text-[10px] font-semibold uppercase tracking-[0.22em] text-burgundy/55">
            ← Önceki sayı
          </p>
          <p class="font-serif text-lg italic leading-snug text-ink/55 md:text-xl">
            Bu, {magazineConfig.name} dergisinin ilk sayısı.
          </p>
          <p class="mt-3 text-sm leading-relaxed text-ink/55">
        Geçmiş yazılara <a href="/library/" class="font-semibold text-burgundy underline decoration-burgundy/40 underline-offset-4 hover:decoration-burgundy">kütüphaneden</a> ulaşabilirsiniz.
          </p>
        </div>
      )}

      {nextIssue ? (
        <a
          href={`/sayi/${nextIssue.slug}/`}
          class="group flex flex-col rounded-[24px] border border-burgundy/12 bg-white p-6 shadow-[0_18px_56px_-44px_rgba(44,22,28,0.24)] ring-1 ring-black/[0.04] transition hover:-translate-y-0.5 hover:border-gold/35 hover:bg-cream-soft/18 hover:shadow-[0_24px_70px_-48px_rgba(44,22,28,0.30)] focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2 md:p-7 md:items-end md:text-right"
        >
          <p class="mb-2 text-[10px] font-semibold uppercase tracking-[0.22em] text-burgundy/75">
            Sonraki sayı →
          </p>
          <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-gold">
            {magazineConfig.name} · Sayı {formatIssuePad(nextIssue.number)} · {nextIssue.monthYear}
          </p>
          <h3 class="mt-2 font-serif text-2xl leading-snug text-ink group-hover:underline group-hover:decoration-burgundy/35 md:text-[28px]">
            {nextIssue.theme}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-ink/65">{nextIssue.lede}</p>
        </a>
      ) : (
        <div class="flex flex-col rounded-[24px] border border-dashed border-burgundy/20 bg-white p-6 opacity-70 ring-1 ring-black/[0.03] md:p-7 md:items-end md:text-right">
          <p class="mb-2 text-[10px] font-semibold uppercase tracking-[0.22em] text-burgundy/55">
            Sonraki sayı →
          </p>
          <p class="font-serif text-lg italic leading-snug text-ink/55 md:text-xl">
            Önümüzdeki sayı yakında.
          </p>
          <p class="mt-3 text-sm leading-relaxed text-ink/55">
            Yeni sayı yayına girdiğinde Estranova Mektubu üzerinden haber veriyoruz.
          </p>
        </div>
      )}
    </div>
  </div>
</section>
