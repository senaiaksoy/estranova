---
import type { SubmenuHeroImage } from '../../data/submenu-heroes';

interface Props {
  hero: SubmenuHeroImage;
}

const { hero } = Astro.props;
---

<section class="relative isolate min-h-[min(64vh,720px)] w-full overflow-hidden md:min-h-[min(92vh,1100px)]" aria-labelledby="home-hero-title">
  <img
    src={hero.src}
    alt={hero.alt}
    width="1800"
    height="1000"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover object-[72%_8%]"
  />
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-[#170f0f]/78 via-[#170f0f]/34 to-transparent"></div>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#170f0f]/62 via-transparent to-transparent"></div>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-36 bg-gradient-to-b from-[#170f0f]/42 to-transparent"></div>
  <div class="pointer-events-none absolute inset-x-6 top-28 z-10 hidden h-px bg-cream-soft/28 md:block"></div>
  <div class="pointer-events-none absolute bottom-8 right-6 z-10 hidden font-serif text-[11rem] leading-none tracking-[-0.08em] text-cream-soft/10 lg:block">
    E
  </div>

  <div
    class="relative z-10 mx-auto grid min-h-[min(64vh,720px)] max-w-6xl grid-cols-1 content-end gap-10 px-6 pb-12 pt-28 md:min-h-[min(92vh,1100px)] md:content-center md:pb-16 md:pt-32 lg:pb-20"
  >
    <div class="max-w-[46rem]">
      <div class="mb-5 flex max-w-xl items-center gap-4">
        <span class="h-px flex-1 bg-cream-warm/55"></span>
        <p class="text-xs font-bold uppercase tracking-[0.32em] text-cream-warm/90">Estranova · 40+ Kadın Sağlığı</p>
      </div>
      <h1 id="home-hero-title" class="mt-4 max-w-[11ch] font-serif text-[clamp(3.1rem,8vw,7.8rem)] leading-[1.02] tracking-[-0.025em] text-white">
        Hormonal geçişi sakin bir dergi gibi okumak
      </h1>
      <p class="mt-6 max-w-2xl border-l border-cream-warm/60 pl-5 font-serif text-xl italic leading-relaxed text-white/88 md:text-2xl">
        Estranova, perimenopozdan menopoz sonrasına uzanan 40+ kadın sağlığını panik diliyle değil, editoryal dikkat ve tıbbi gözden geçirme katmanıyla okur.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="/library"
          class="inline-flex items-center rounded-full bg-cream-soft px-7 py-3.5 text-sm font-semibold text-burgundy-deep shadow-md shadow-burgundy-deep/20 transition hover:bg-white focus:outline-none focus:ring-2 focus:ring-cream-warm/50"
        >
          Kütüphaneyi aç
        </a>
        <a
          href="/symptoms"
          class="inline-flex items-center rounded-full border border-white/45 bg-white/10 px-7 py-3.5 text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white/18 focus:outline-none focus:ring-2 focus:ring-white/35"
        >
          Belirtilere göre bak
        </a>
      </div>

      <aside class="mt-10 max-w-3xl border-y border-cream-soft/24 py-5 text-cream-soft/88" aria-label="Kapak başlıkları">
        <p class="mb-4 text-[10px] font-bold uppercase tracking-[0.32em] text-cream-warm">Kapakta</p>
        <nav class="grid gap-4 md:grid-cols-3">
          <a href="/hormonal-gecis/perimenopoz/perimenopoz-ilk-isaretler" class="group block">
            <span class="mb-2 block font-serif text-xl leading-tight group-hover:underline group-hover:decoration-cream-warm/70 md:text-2xl">Perimenopoz nerede başlar?</span>
            <span class="mb-1 block text-[10px] font-bold uppercase tracking-[0.22em] text-cream-warm/85">Berna Aksoy</span>
            <span class="block text-sm leading-relaxed text-cream-soft/68">İlk işaretleri telaşa çevirmeden okumak.</span>
          </a>
          <a href="/zihin-denge/uyku-dinlenme/aksam-hareketi-uyku-melatonin" class="group block border-t border-cream-soft/18 pt-4 md:border-l md:border-t-0 md:pl-5 md:pt-0">
            <span class="mb-2 block font-serif text-xl leading-tight group-hover:underline group-hover:decoration-cream-warm/70 md:text-2xl">Uyku, gece ve denge</span>
            <span class="mb-1 block text-[10px] font-bold uppercase tracking-[0.22em] text-cream-warm/85">Alara Baykent</span>
            <span class="block text-sm leading-relaxed text-cream-soft/68">Bu ayın dosyasında sakin bir gece okuması.</span>
          </a>
          <a href="/zamansiz-yasam/kemik-sagligi-40-sonrasi" class="group block border-t border-cream-soft/18 pt-4 md:border-l md:border-t-0 md:pl-5 md:pt-0">
            <span class="mb-2 block font-serif text-xl leading-tight group-hover:underline group-hover:decoration-cream-warm/70 md:text-2xl">40 sonrası kemik sağlığı</span>
            <span class="mb-1 block text-[10px] font-bold uppercase tracking-[0.22em] text-cream-warm/85">Doç. Dr. Senai Aksoy</span>
            <span class="block text-sm leading-relaxed text-cream-soft/68">Güç, hareket ve koruyucu takip.</span>
          </a>
        </nav>
      </aside>
    </div>
  </div>
</section>
