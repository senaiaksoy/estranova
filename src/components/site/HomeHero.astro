---
import type { SubmenuHeroImage } from '../../data/submenu-heroes';

interface Props {
  hero: SubmenuHeroImage;
}

const { hero } = Astro.props;
---

<section
  class="relative isolate w-full overflow-hidden bg-[#FDF8F0]"
  aria-labelledby="home-hero-title"
>
  <div class="flex min-h-[75vh] flex-col lg:flex-row lg:items-stretch">
    <div
      class="flex w-full flex-shrink-0 flex-col justify-center self-center px-6 py-12 sm:px-8 lg:w-[58.333333%] lg:max-w-none lg:flex-[0_0_58.333333%] lg:items-start lg:py-16 lg:pl-10 lg:pr-10 xl:pl-16 xl:pr-14"
    >
      <div class="mb-8 flex max-w-3xl items-center gap-4">
        <span class="h-px w-10 shrink-0 bg-[#C9A96E]" aria-hidden="true"></span>
        <p class="text-xs font-bold uppercase tracking-[0.3em] text-[#2D2D2D]">
          ESTRANOVA · SAYI 04 · NİSAN 2026
        </p>
      </div>

      <h1
        id="home-hero-title"
        class="max-w-[22ch] font-serif text-4xl font-normal leading-[0.95] text-[#2D2D2D] md:text-6xl md:leading-[0.95] lg:text-7xl"
      >
        Hormonal geçiş üzerine sakin bir rehber.
      </h1>

      <p
        class="mt-6 max-w-xl font-serif text-lg italic leading-snug text-[#2D2D2D]/75 md:text-xl"
      >
        Perimenopozdan 40 sonrasına, merakla okunan bir yayın.
      </p>
    </div>

    <div
      class="relative aspect-[4/5] w-full min-h-0 min-w-0 flex-1 lg:aspect-auto lg:min-h-[75vh]"
    >
      <img
        src={hero.src}
        alt={hero.alt}
        width="1440"
        height="1800"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover object-center"
      />
    </div>
  </div>

  <div class="flex flex-col items-center justify-center gap-4 px-6 pb-10 pt-4 lg:pb-12">
    <span class="h-px w-10 bg-[#C9A96E]" aria-hidden="true"></span>
    <p class="text-[10px] font-bold uppercase tracking-[0.28em] text-[#2D2D2D]/55">
      AŞAĞI KAYDIR <span class="inline-block translate-y-px text-[#C9A96E]" aria-hidden="true">↓</span>
    </p>
  </div>
</section>
