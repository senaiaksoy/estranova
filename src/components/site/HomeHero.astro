---
import type { SubmenuHeroImage } from '../../data/submenu-heroes';

interface Props {
  hero: SubmenuHeroImage;
}

const { hero } = Astro.props;
---

<section class="relative isolate min-h-[min(64vh,720px)] w-full overflow-hidden md:min-h-[min(92vh,1100px)]" aria-labelledby="home-hero-title">
  <img
    src={hero.src}
    alt={hero.alt}
    width="1800"
    height="1000"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover object-[center_30%]"
  />
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-[#170f0f]/78 via-[#170f0f]/34 to-transparent"></div>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#170f0f]/62 via-transparent to-transparent"></div>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-36 bg-gradient-to-b from-[#170f0f]/42 to-transparent"></div>

  <div
    class="relative z-10 mx-auto grid min-h-[min(64vh,720px)] max-w-6xl grid-cols-1 content-end gap-10 px-6 pb-12 pt-28 md:min-h-[min(92vh,1100px)] md:content-center md:pb-16 md:pt-32 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-end lg:pb-20"
  >
    <div class="max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-[0.32em] text-cream-warm/90">Estranova · 40+ Kadın Sağlığı</p>
      <h1 id="home-hero-title" class="mt-4 font-serif text-[clamp(3.1rem,8vw,7.8rem)] leading-[0.88] tracking-[-0.055em] text-white">
        Hormonal geçişi sakin bir dergi gibi okumak
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/88 md:text-xl">
        Estranova, perimenopozdan menopoz sonrasına uzanan 40+ kadın sağlığını panik diliyle değil, editoryal dikkat ve tıbbi gözden geçirme katmanıyla okur.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="/library"
          class="inline-flex items-center rounded-full bg-cream-soft px-7 py-3.5 text-sm font-semibold text-burgundy-deep shadow-md shadow-burgundy-deep/20 transition hover:bg-white focus:outline-none focus:ring-2 focus:ring-gold/50"
        >
          Kütüphaneyi aç
        </a>
        <a
          href="/symptoms"
          class="inline-flex items-center rounded-full border border-white/45 bg-white/10 px-7 py-3.5 text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white/18 focus:outline-none focus:ring-2 focus:ring-white/35"
        >
          Belirtilere göre bak
        </a>
      </div>
    </div>

    <aside class="hidden border-l border-cream-soft/30 pl-6 text-cream-soft/92 lg:block" aria-label="Kapak başlıkları">
      <p class="mb-5 text-[10px] font-bold uppercase tracking-[0.32em] text-gold">Kapakta</p>
      <nav class="space-y-5">
        <a href="/hormonal-gecis/perimenopoz" class="group block">
          <span class="block font-serif text-2xl leading-tight group-hover:underline group-hover:decoration-gold/70">Perimenopoz nerede başlar?</span>
          <span class="mt-1 block text-sm leading-relaxed text-cream-soft/68">İlk işaretleri telaşa çevirmeden okumak.</span>
        </a>
        <a href="/zihin-denge/uyku-dinlenme" class="group block border-t border-cream-soft/22 pt-5">
          <span class="block font-serif text-2xl leading-tight group-hover:underline group-hover:decoration-gold/70">Uyku, gece ve denge</span>
          <span class="mt-1 block text-sm leading-relaxed text-cream-soft/68">Bu ayın dosyasında sakin bir gece okuması.</span>
        </a>
        <a href="/zamansiz-yasam/kemik-sagligi-40-sonrasi" class="group block border-t border-cream-soft/22 pt-5">
          <span class="block font-serif text-2xl leading-tight group-hover:underline group-hover:decoration-gold/70">40 sonrası kemik sağlığı</span>
          <span class="mt-1 block text-sm leading-relaxed text-cream-soft/68">Güç, hareket ve koruyucu takip.</span>
        </a>
      </nav>
    </aside>
  </div>
</section>
