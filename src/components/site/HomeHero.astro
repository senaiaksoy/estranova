---
import type { SubmenuHeroImage } from '../../data/submenu-heroes';

interface Props {
  hero: SubmenuHeroImage;
}

const { hero } = Astro.props;
---

<section class="relative isolate min-h-[min(56vh,640px)] md:min-h-[min(90vh,1100px)] w-full overflow-hidden" aria-labelledby="home-hero-title">
  <img
    src={hero.src}
    alt={hero.alt}
    width="1800"
    height="1000"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover object-[center_30%]"
  />
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-[#1c1412]/60 via-[#1c1412]/22 to-transparent"></div>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1c1412]/45 via-transparent to-transparent"></div>

  <div
    class="relative z-10 mx-auto flex min-h-[min(56vh,640px)] md:min-h-[min(90vh,1100px)] max-w-6xl flex-col justify-end px-6 pb-12 pt-28 md:justify-center md:pb-16 md:pt-32 lg:pb-20"
  >
    <div class="max-w-2xl">
      <p class="text-xs font-bold uppercase tracking-[0.26em] text-cream-warm/90">Estranova</p>
      <h1 id="home-hero-title" class="mt-3 font-serif text-4xl leading-[1.08] text-white md:text-6xl lg:text-[3.45rem]">
        Hormonal geçişini sakin bir dergi gibi okumak
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-white/88 md:text-xl">
        Estranova, 40+ kadın sağlığını editöryal bir çerçevede okur. Burada paniğin değil, sahici bilginin yanına
        oturursun — bir kadın yaşıtın elinden, bilimsel editörün gözünden geçen yazılarla.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="/library"
          class="inline-flex items-center rounded-xl bg-burgundy-deep px-7 py-3.5 text-sm font-semibold text-cream-soft shadow-md shadow-burgundy-deep/20 transition hover:bg-burgundy focus:outline-none focus:ring-2 focus:ring-gold/50"
        >
          Kütüphaneyi aç
        </a>
        <a
          href="/symptoms"
          class="inline-flex items-center rounded-xl border border-white/45 bg-white/10 px-7 py-3.5 text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white/18 focus:outline-none focus:ring-2 focus:ring-white/35"
        >
          Belirtilere göre bak
        </a>
      </div>
    </div>
  </div>
</section>
