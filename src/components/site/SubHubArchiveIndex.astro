---
import { writers } from '../../data/writers';

interface Item {
  href: string;
  title: string;
  excerpt: string;
  writerSlug: string;
  readingMinutes: number;
  publishedDate?: string;
  keywords?: string[];
}

interface Props {
  items: Item[];
  startAt?: number;
  initialVisible?: number;
}

const { items, startAt = 1, initialVisible = 8 } = Astro.props;

const visibleItems = items.slice(0, initialVisible);
const olderItems = items.slice(initialVisible);
const getWriter = (slug: string) => writers.find((writer) => writer.slug === slug);
---

<div class="border-y border-burgundy/14">
  <ol class="divide-y divide-burgundy/12">
    {
      visibleItems.map((item, index) => {
        const writer = getWriter(item.writerSlug);
        const number = String(startAt + index).padStart(2, '0');

        return (
          <li>
            <a
              href={item.href}
              class="group grid gap-4 py-5 transition hover:bg-white/58 focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2 md:grid-cols-[4.5rem_1fr_auto] md:items-start md:px-5 md:py-6"
            >
              <span class="font-serif text-2xl italic leading-none text-gold md:text-3xl">{number}</span>
              <div class="min-w-0">
                <h3 class="font-serif text-2xl leading-tight text-ink transition group-hover:text-burgundy md:text-[2rem]">
                  {item.title}
                </h3>
                <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink/68 md:text-[0.95rem]">
                  {item.excerpt}
                </p>
                <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-ink/48">
                  {writer && <span class="text-burgundy">{writer.displayName}</span>}
                  {item.publishedDate && <span>{item.publishedDate}</span>}
                  <span>{item.readingMinutes} dk okuma</span>
                </div>
              </div>
              <span class="text-xl text-gold transition group-hover:translate-x-1 md:justify-self-end" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>

  {
    olderItems.length > 0 && (
      <details class="group border-t border-burgundy/14 bg-white/42">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-5 px-5 py-5 text-sm font-bold uppercase tracking-[0.16em] text-burgundy transition hover:bg-white/70 [&::-webkit-details-marker]:hidden">
          <span>Daha eski okumaları göster ({olderItems.length})</span>
          <span class="font-serif text-2xl leading-none text-gold transition group-open:rotate-45" aria-hidden="true">
            +
          </span>
        </summary>
        <ol class="divide-y divide-burgundy/10 border-t border-burgundy/10">
          {
            olderItems.map((item, index) => {
              const writer = getWriter(item.writerSlug);
              const number = String(startAt + initialVisible + index).padStart(2, '0');

              return (
                <li>
                  <a
                    href={item.href}
                    class="group/older grid gap-4 px-5 py-5 transition hover:bg-cream-soft/35 focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2 md:grid-cols-[4.5rem_1fr_auto] md:items-start"
                  >
                    <span class="font-serif text-2xl italic leading-none text-gold/80">{number}</span>
                    <div class="min-w-0">
                      <h3 class="font-serif text-xl leading-tight text-ink transition group-hover/older:text-burgundy md:text-2xl">
                        {item.title}
                      </h3>
                      <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-ink/48">
                        {writer && <span class="text-burgundy">{writer.displayName}</span>}
                        {item.publishedDate && <span>{item.publishedDate}</span>}
                        <span>{item.readingMinutes} dk okuma</span>
                      </div>
                    </div>
                    <span class="text-xl text-gold transition group-hover/older:translate-x-1 md:justify-self-end" aria-hidden="true">
                      →
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ol>
      </details>
    )
  }
</div>
