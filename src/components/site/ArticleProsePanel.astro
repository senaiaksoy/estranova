---
/**
 * Makale ana metni: kart içinde tipografi (prose).
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section
  class:list={[
    'rounded-[32px] border border-[#6B2D3E]/10 bg-white p-8 shadow-[0_22px_55px_-32px_rgba(44,22,28,0.2)] ring-1 ring-black/[0.06] md:p-10 lg:p-12',
    className,
  ]}
>
  <div
    class="prose prose-lg max-w-none prose-headings:font-serif prose-headings:text-[#2D2D2D] prose-p:text-[#2D2D2D]/80 prose-li:text-[#2D2D2D]/80 prose-a:text-[#6B2D3E] prose-a:no-underline hover:prose-a:underline"
  >
    <slot />
  </div>
</section>
