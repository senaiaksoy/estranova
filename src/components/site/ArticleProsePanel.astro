---
/**
 * Makale ana metni: kart içinde tipografi (prose).
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section
  class:list={[
    'rounded-[32px] border border-[#6B2D3E]/10 bg-white p-8 shadow-[0_22px_55px_-32px_rgba(44,22,28,0.2)] ring-1 ring-black/[0.06] md:p-10 lg:p-12',
    className,
  ]}
>
  <div class="prose prose-lg prose-estranova max-w-none">
    <slot />
  </div>
</section>
