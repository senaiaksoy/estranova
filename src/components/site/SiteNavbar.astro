---
import { mainNav, isNavActive } from '../../data/navigation';
import SearchOverlay from './SearchOverlay.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const linkBase =
  'text-sm font-medium transition-colors px-2 py-1 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:border-2 focus-visible:border-primary';

const mobileLinkBase =
  'text-base font-serif py-2.5 px-4 rounded-lg text-left w-full focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:border-2 focus-visible:border-primary';
---

<nav
  aria-label="Ana navigasyon menüsü"
  role="navigation"
  class="fixed top-0 left-0 right-0 z-50 bg-surface/90 backdrop-blur-md border-b border-primary/10 px-6 py-3 focus-within:ring-2 focus-within:ring-primary/20"
>
  <div class="max-w-6xl mx-auto flex items-center justify-between">
    <a
      href="/"
      class="text-2xl font-serif font-bold tracking-tight text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 rounded px-2 py-1"
      aria-label="ESTRANOVA Ana Sayfası"
    >
      <span>ESTRANOVA</span>
      <span class="text-[10px] font-sans font-medium tracking-[0.2em] text-secondary mt-1 block"
        >EDİTORYAL SAĞLIK PLATFORMU</span
      >
    </a>

    <nav aria-label="Ana menü" class="hidden md:flex items-center gap-1 lg:gap-2">
      {
        mainNav.map((item) => {
          const active = isNavActive(currentPath, item);
          const activeClass = active ? 'text-primary font-semibold' : 'text-charcoal/60 hover:text-primary';

          if (!item.children) {
            return (
              <a
                href={item.href}
                class:list={[linkBase, activeClass]}
                aria-current={active ? 'page' : undefined}
                title={item.label}
              >
                {item.name}
              </a>
            );
          }

          return (
            <div class="group relative">
              <span class="flex items-center gap-0.5">
                <a
                  href={item.href}
                  class:list={[linkBase, activeClass]}
                  aria-current={active ? 'page' : undefined}
                  title={item.label}
                >
                  {item.name}
                </a>
                <span
                  class:list={[
                    'pointer-events-none inline-flex h-7 w-4 shrink-0 items-center justify-center text-charcoal/45 group-hover:text-primary',
                    active ? 'text-primary' : '',
                  ]}
                  aria-hidden="true"
                >
                  <svg width="10" height="12" viewBox="0 0 10 12" fill="none" aria-hidden="true">
                    <path d="M1 4l4 4 4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                  </svg>
                </span>
              </span>
              <div
                class="invisible absolute left-0 top-full z-[60] min-w-[13.5rem] pt-2 opacity-0 transition duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
                role="group"
                aria-label={`${item.name} alt menü`}
              >
                <div class="rounded-xl border border-primary/15 bg-surface py-2 shadow-lg">
                  {
                    item.children.map((child) => {
                      const subActive =
                        currentPath === child.href || currentPath.startsWith(`${child.href}/`);
                      return (
                        <a
                          href={child.href}
                          class:list={[
                            'block px-4 py-2.5 text-sm transition-colors',
                            subActive
                              ? 'bg-primary/8 font-semibold text-primary'
                              : 'text-charcoal/85 hover:bg-primary/5 hover:text-primary',
                          ]}
                          aria-current={subActive ? 'page' : undefined}
                        >
                          {child.name}
                        </a>
                      );
                    })
                  }
                </div>
              </div>
            </div>
          );
        })
      }

      <!-- Desktop search trigger (nav'ın sağ ucu) -->
      <button
        type="button"
        data-search-trigger
        class="ml-3 hidden items-center gap-2 rounded-xl border border-primary/12 px-3 py-1.5 text-xs font-medium text-charcoal/55 transition-colors hover:border-primary/30 hover:text-primary md:flex"
        aria-label="Sitede ara (Ctrl+K)"
      >
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <span>Ara</span>
        <kbd class="rounded border border-charcoal/12 px-1.5 py-0.5 text-[9px] font-bold tracking-wider text-charcoal/30">⌘K</kbd>
      </button>
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <!-- Mobile search trigger -->
      <button
        type="button"
        data-search-trigger
        class="flex h-10 w-10 items-center justify-center rounded-full border border-primary/15 text-primary/65 transition-colors hover:border-primary/35 hover:text-primary"
        aria-label="Sitede ara"
      >
        <svg viewBox="0 0 24 24" class="h-4.5 w-4.5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
      </button>

      <button
        type="button"
        class="text-primary p-2 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:border-2 focus-visible:border-primary"
        aria-label="Menüyü aç/kapat"
        aria-controls="mobile-menu"
        aria-expanded="false"
        onclick="mobileMenu.toggle(this)"
      >
        <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>

    <div
      id="mobile-menu"
      class="absolute top-full left-0 right-0 hidden max-h-[min(80vh,560px)] overflow-y-auto bg-surface border-y border-primary/10 shadow-xl p-3 md:hidden flex-col gap-2"
      role="menu"
      aria-hidden="true"
    >
      {
        mainNav.map((item) => {
          const active = isNavActive(currentPath, item);

          if (!item.children) {
            return (
              <a
                href={item.href}
                class:list={[
                  mobileLinkBase,
                  active ? 'bg-primary/10 text-primary font-semibold' : 'text-charcoal hover:bg-primary/5',
                ]}
                role="menuitem"
                aria-current={active ? 'page' : undefined}
              >
                {item.name}
              </a>
            );
          }

          return (
            <details class="rounded-xl border border-primary/10 overflow-hidden" open={active}>
              <summary
                class="cursor-pointer list-none px-4 py-3 font-serif font-medium text-charcoal bg-primary/5 hover:bg-primary/10 [&::-webkit-details-marker]:hidden flex items-center justify-between"
              >
                <span>{item.name}</span>
                <span class="text-charcoal/40 text-xs" aria-hidden="true">
                  ▼
                </span>
              </summary>
              <div class="flex flex-col border-t border-primary/10 bg-surface py-1" role="group">
                <a
                  href={item.href}
                  class:list={[
                    'text-sm py-2.5 px-4 border-b border-primary/5',
                    currentPath === item.href
                      ? 'font-semibold text-primary bg-primary/5'
                      : 'text-charcoal/90 hover:bg-primary/5',
                  ]}
                  role="menuitem"
                >
                  Tümü — {item.name}
                </a>
                {
                  item.children.map((child) => {
                    const subActive =
                      currentPath === child.href || currentPath.startsWith(`${child.href}/`);
                    return (
                      <a
                        href={child.href}
                        class:list={[
                          'text-sm py-2.5 px-4 pl-6',
                          subActive
                            ? 'font-semibold text-primary bg-primary/5'
                            : 'text-charcoal/85 hover:bg-primary/5',
                        ]}
                        role="menuitem"
                        aria-current={subActive ? 'page' : undefined}
                      >
                        {child.name}
                      </a>
                    );
                  })
                }
              </div>
            </details>
          );
        })
      }
    </div>
  </div>
</nav>

<SearchOverlay />
