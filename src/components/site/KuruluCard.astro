---
/**
 * KuruluCard — Yayın Kurulu sayfasındaki tüm kişi kartları için ortak şablon.
 */

interface Props {
  name: string;
  role: string;
  bio: string;
  portrait?: string;
  tags?: string[];
  anchor?: string;
  /** Opsiyonel — yazar profil sayfası linki, örn. `/yazarlar/berna-aksoy/` */
  profileHref?: string;
}

const { name, role, bio, portrait, tags, anchor, profileHref } = Astro.props;
---

<article
  id={anchor}
  class="group relative flex flex-col overflow-hidden rounded-[30px] border border-primary/12 bg-white p-5 shadow-[0_20px_64px_-52px_rgba(44,22,28,0.30)] ring-1 ring-black/[0.04] transition duration-300 hover:-translate-y-0.5 hover:border-gold/35 hover:bg-cream-soft/20 hover:shadow-[0_28px_82px_-58px_rgba(44,22,28,0.38)]"
>
  <div class="pointer-events-none absolute inset-x-6 top-0 h-px bg-gradient-to-r from-transparent via-gold/60 to-transparent"></div>
  <div class="pointer-events-none absolute -right-8 top-5 h-24 w-24 rounded-full bg-gold/10 blur-2xl"></div>

  {portrait && (
    <img
      src={portrait}
      alt={name}
      class="relative mb-5 h-28 w-28 rounded-[24px] border border-primary/15 object-cover shadow-[0_18px_44px_-30px_rgba(44,22,28,0.42)] ring-2 ring-gold/25"
      loading="lazy"
      width="112"
      height="112"
    />
  )}

  {anchor ? (
    <a
      href={`/yayin-kurulu/#${anchor}`}
      class="relative block focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/35 focus-visible:ring-offset-2"
    >
      <h3 class="mb-2 font-serif text-2xl leading-tight text-ink transition group-hover:underline group-hover:decoration-gold/60 group-hover:underline-offset-4">
        {name}
      </h3>
    </a>
  ) : (
    <h3 class="relative mb-2 font-serif text-2xl leading-tight text-ink">{name}</h3>
  )}

  <p class="relative mb-3 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-primary">
    <span class="h-px w-7 bg-gold/75"></span>
    <span>{role}</span>
  </p>

  <p class="relative mb-4 text-sm leading-relaxed text-ink/70">{bio}</p>

  {tags && tags.length > 0 && (
    <ul class="relative flex flex-wrap gap-2" aria-label="Uzmanlık alanları">
      {tags.map((tag) => (
        <li>
          <span class="inline-block rounded-full border border-primary/15 bg-cream-soft/25 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-primary/85 ring-1 ring-black/[0.03]">
            {tag}
          </span>
        </li>
      ))}
    </ul>
  )}

  <slot />

  {profileHref && (
    <a
      href={profileHref}
      class="relative mt-5 inline-flex items-center gap-1.5 text-xs font-semibold text-primary underline decoration-primary/40 underline-offset-4 transition hover:decoration-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/35 focus-visible:ring-offset-2"
    >
      Yazarın sayfasına git
      <span class="text-gold transition group-hover:translate-x-1" aria-hidden="true">→</span>
    </a>
  )}
</article>
