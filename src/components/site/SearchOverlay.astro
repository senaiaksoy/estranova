---
import { searchIndex } from '../../data/search-index';
---

<!-- Search Overlay -->
<div id="search-overlay" class="fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true" aria-label="Site icinde ara">
  <!-- Backdrop -->
  <div id="search-backdrop" class="absolute inset-0 bg-charcoal/40 backdrop-blur-sm"></div>

  <!-- Search Panel -->
  <div class="absolute inset-0 flex items-start justify-center px-4 pt-[12vh] pointer-events-none">
    <div id="search-panel" class="w-full max-w-2xl bg-card rounded-[28px] editorial-shadow overflow-hidden flex flex-col max-h-[70vh] pointer-events-auto">

      <!-- Search Input -->
      <div class="flex items-center gap-3 px-7 py-5 border-b border-primary/10">
        <svg viewBox="0 0 24 24" class="w-5 h-5 text-primary/50 shrink-0" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          id="search-input"
          type="text"
          placeholder="Sayfa, semptom veya konu ara..."
          autocomplete="off"
          class="flex-1 text-lg bg-transparent outline-none text-charcoal placeholder:text-charcoal/30 font-sans"
        />
        <kbd class="hidden md:flex items-center gap-1 text-[11px] font-bold text-charcoal/25 tracking-wider uppercase border border-charcoal/10 rounded-lg px-2 py-1">
          ESC
        </kbd>
      </div>

      <!-- Results -->
      <div id="search-results" class="overflow-y-auto overscroll-contain px-3 py-3">
        <!-- Default: grouped by category -->
        <div id="search-default" class="space-y-4"></div>
        <!-- Active search results -->
        <div id="search-filtered" class="hidden space-y-1"></div>
        <!-- No results -->
        <div id="search-empty" class="hidden py-12 text-center">
          <p class="text-charcoal/40 text-sm">Sonuc bulunamadi</p>
        </div>
      </div>

      <!-- Footer -->
      <div class="flex items-center justify-between px-7 py-3 border-t border-primary/5 bg-surface-container/50">
        <div class="flex items-center gap-4 text-[11px] text-charcoal/30 font-medium">
          <span class="flex items-center gap-1">
            <kbd class="inline-flex items-center justify-center w-5 h-5 rounded border border-charcoal/10 text-[10px]">&uarr;</kbd>
            <kbd class="inline-flex items-center justify-center w-5 h-5 rounded border border-charcoal/10 text-[10px]">&darr;</kbd>
            gezin
          </span>
          <span class="flex items-center gap-1">
            <kbd class="inline-flex items-center justify-center w-5 h-5 rounded border border-charcoal/10 text-[10px]">&crarr;</kbd>
            ac
          </span>
        </div>
        <p class="text-[11px] text-charcoal/25 font-medium">Estranova</p>
      </div>
    </div>
  </div>
</div>

<!-- Inject search data & behavior -->
<script define:vars={{ items: searchIndex }}>
  const searchOverlay = document.getElementById('search-overlay');
  const searchBackdrop = document.getElementById('search-backdrop');
  const searchInput = document.getElementById('search-input');
  const searchDefault = document.getElementById('search-default');
  const searchFiltered = document.getElementById('search-filtered');
  const searchEmpty = document.getElementById('search-empty');

  let activeIndex = -1;
  let visibleItems = [];

  // --- Category config ---
  const categoryMeta = {
    'Sayfa':     { color: 'bg-primary/10 text-primary' },
    'Kategori':  { color: 'bg-secondary/10 text-secondary' },
    'Semptom':   { color: 'bg-primary/8 text-primary-container' },
    'Makale':    { color: 'bg-charcoal/5 text-charcoal/70' },
    'Sayı':      { color: 'bg-secondary/15 text-secondary' },
    'Yazar':     { color: 'bg-primary/12 text-primary' },
  };

  // --- Render helpers ---
  function createResultItem(item, idx) {
    const a = document.createElement('a');
    a.href = item.href;
    a.dataset.idx = idx;
    a.className = 'search-result-item flex items-start gap-4 px-4 py-3 rounded-2xl cursor-pointer transition-colors hover:bg-surface-container';
    a.innerHTML = `
      <div class="flex-1 min-w-0">
        <p class="text-sm font-semibold text-charcoal truncate">${item.title}</p>
        <p class="text-xs text-charcoal/50 mt-0.5 line-clamp-1">${item.description}</p>
      </div>
      <span class="shrink-0 mt-0.5 px-2 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase ${categoryMeta[item.category]?.color || 'bg-charcoal/5 text-charcoal/50'}">${item.category}</span>
    `;
    return a;
  }

  function renderDefault() {
    searchDefault.innerHTML = '';
    const groups = {};
    items.forEach(item => {
      if (!groups[item.category]) groups[item.category] = [];
      groups[item.category].push(item);
    });

    let globalIdx = 0;
    for (const [cat, catItems] of Object.entries(groups)) {
      const section = document.createElement('div');
      section.innerHTML = `<p class="px-4 pb-1 text-[11px] font-bold tracking-[0.22em] uppercase text-charcoal/30">${cat}</p>`;
      const list = document.createElement('div');
      list.className = 'space-y-0.5';
      catItems.forEach(item => {
        list.appendChild(createResultItem(item, globalIdx));
        globalIdx++;
      });
      section.appendChild(list);
      searchDefault.appendChild(section);
    }
    visibleItems = items.map((item, i) => ({ ...item, _idx: i }));
  }

  function renderFiltered(query) {
    const q = normalize(query);
    const matched = items.filter(item =>
      normalize(item.title).includes(q) ||
      normalize(item.description).includes(q) ||
      normalize(item.category).includes(q)
    );

    searchFiltered.innerHTML = '';
    if (matched.length === 0) {
      searchDefault.classList.add('hidden');
      searchFiltered.classList.add('hidden');
      searchEmpty.classList.remove('hidden');
      visibleItems = [];
      return;
    }

    searchEmpty.classList.add('hidden');
    searchDefault.classList.add('hidden');
    searchFiltered.classList.remove('hidden');

    matched.forEach((item, idx) => {
      searchFiltered.appendChild(createResultItem(item, idx));
    });
    visibleItems = matched;
  }

  function normalize(str) {
    return str
      .toLowerCase()
      .replace(/ı/g, 'i')
      .replace(/ö/g, 'o')
      .replace(/ü/g, 'u')
      .replace(/ş/g, 's')
      .replace(/ç/g, 'c')
      .replace(/ğ/g, 'g')
      .replace(/İ/g, 'i')
      .replace(/Ö/g, 'o')
      .replace(/Ü/g, 'u')
      .replace(/Ş/g, 's')
      .replace(/Ç/g, 'c')
      .replace(/Ğ/g, 'g');
  }

  function setActive(idx) {
    const allItems = document.querySelectorAll('.search-result-item');
    allItems.forEach(el => el.classList.remove('bg-surface-container'));
    activeIndex = idx;
    if (idx >= 0 && idx < allItems.length) {
      allItems[idx].classList.add('bg-surface-container');
      allItems[idx].scrollIntoView({ block: 'nearest' });
    }
  }

  // --- Open / Close ---
  function openSearch() {
    searchOverlay.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    searchInput.value = '';
    activeIndex = -1;
    searchDefault.classList.remove('hidden');
    searchFiltered.classList.add('hidden');
    searchEmpty.classList.add('hidden');
    renderDefault();
    requestAnimationFrame(() => searchInput.focus());
  }

  function closeSearch() {
    searchOverlay.classList.add('hidden');
    document.body.style.overflow = '';
    searchInput.value = '';
  }

  // --- Events ---
  // Global keyboard shortcut: Ctrl+K or /
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
    if (e.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement?.tagName)) {
      e.preventDefault();
      openSearch();
    }
  });

  // Navbar trigger
  document.querySelectorAll('[data-search-trigger]').forEach(el => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      openSearch();
    });
  });

  // Close on backdrop click
  searchBackdrop.addEventListener('click', closeSearch);

  // Close on Escape
  searchOverlay.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      e.preventDefault();
      closeSearch();
    }
  });

  // Input handling
  searchInput.addEventListener('input', (e) => {
    const q = e.target.value.trim();
    activeIndex = -1;
    if (!q) {
      searchDefault.classList.remove('hidden');
      searchFiltered.classList.add('hidden');
      searchEmpty.classList.add('hidden');
      renderDefault();
    } else {
      renderFiltered(q);
    }
  });

  // Keyboard navigation
  searchInput.addEventListener('keydown', (e) => {
    const allItems = document.querySelectorAll('.search-result-item');
    const count = allItems.length;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(activeIndex < count - 1 ? activeIndex + 1 : 0);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(activeIndex > 0 ? activeIndex - 1 : count - 1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (activeIndex >= 0 && allItems[activeIndex]) {
        window.location.href = allItems[activeIndex].getAttribute('href');
      }
    }
  });
</script>
