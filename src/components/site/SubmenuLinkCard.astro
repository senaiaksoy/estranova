---
import ArticleMetaSigil from './ArticleMetaSigil.astro';

interface Props {
  href: string;
  title: string;
  excerpt: string;
  imageSrc: string;
  imageAlt: string;
  /** Büyük numara (ör. 01); yoksa gösterilmez */
  step?: string;
  cta?: string;
  /** Okuma süresi (dk) — verildiğinde alt meta sigili gösterilir */
  readingMinutes?: number;
  /** Kanıt düzeyi (Sınırlı | Orta | Güçlü) */
  evidence?: 'Sınırlı' | 'Orta' | 'Güçlü';
  /** Son güncelleme tarihi (ör. "Şub 2026") */
  updated?: string;
}

const {
  href,
  title,
  excerpt,
  imageSrc,
  imageAlt,
  step,
  cta = 'Yazıyı aç',
  readingMinutes,
  evidence,
  updated,
} = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col overflow-hidden rounded-[28px] border border-burgundy/12 bg-white shadow-sm transition hover:shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
>
  <div class="relative h-36 overflow-hidden">
    <img
      src={imageSrc}
      alt={imageAlt}
      width="600"
      height="225"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]"
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1c1412]/65 via-[#1c1412]/15 to-transparent" />
    {
      step && (
        <span class="absolute bottom-3 left-4 font-serif text-3xl font-medium tabular-nums text-white/95 md:text-4xl">
          {step}
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col border-t border-burgundy/10 p-7 md:p-8">
    <h2 class="mb-3 font-serif text-2xl md:text-3xl">{title}</h2>
    <p class="mb-5 flex-1 leading-relaxed text-ink/75">{excerpt}</p>
    {readingMinutes && (
      <div class="mb-3">
        <ArticleMetaSigil readingMinutes={readingMinutes} evidence={evidence} updated={updated} />
      </div>
    )}
    <span class="font-semibold text-burgundy group-hover:underline">{cta}</span>
  </div>
</a>
