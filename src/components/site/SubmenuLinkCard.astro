---
import ArticleMetaSigil from './ArticleMetaSigil.astro';

interface Props {
  href: string;
  title: string;
  excerpt: string;
  imageSrc: string;
  imageAlt: string;
  /** Büyük numara (ör. 01); yoksa gösterilmez */
  step?: string;
  cta?: string;
  /** Okuma süresi (dk) — verildiğinde alt meta sigili gösterilir */
  readingMinutes?: number;
  /** Kanıt düzeyi (Sınırlı | Orta | Güçlü) */
  evidence?: 'Sınırlı' | 'Orta' | 'Güçlü';
  /** Son güncelleme tarihi (ör. "Şub 2026") */
  updated?: string;
}

const {
  href,
  title,
  excerpt,
  imageSrc,
  imageAlt,
  step,
  cta = 'Yazıyı aç',
  readingMinutes,
  evidence,
  updated,
} = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col overflow-hidden border-y border-burgundy/14 bg-white/55 transition hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
>
  <div class="relative aspect-[4/3] overflow-hidden">
    <img
      src={imageSrc}
      alt={imageAlt}
      width="600"
      height="225"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.035]"
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1c1412]/34 via-transparent to-transparent" />
    {
      step && (
        <span class="absolute bottom-4 left-5 font-serif text-5xl font-medium tabular-nums text-white/95 md:text-6xl">
          {step}
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col border-t border-burgundy/12 p-6 md:p-7">
    <h2 class="mb-3 font-serif text-3xl leading-tight tracking-[-0.015em] md:text-4xl">{title}</h2>
    <p class="mb-6 flex-1 leading-relaxed text-ink/72">{excerpt}</p>
    {readingMinutes && (
      <div class="mb-3">
        <ArticleMetaSigil readingMinutes={readingMinutes} evidence={evidence} updated={updated} />
      </div>
    )}
    <span class="inline-flex items-center gap-2 text-sm font-semibold text-burgundy group-hover:underline">
      {cta}
      <span class="text-gold transition group-hover:translate-x-1" aria-hidden="true">→</span>
    </span>
  </div>
</a>
