---
interface Props {
  href?: string;
  tag: string;
  title: string;
  body: string;
  /** Örn. kanıt satırı düz metin; `footer` slotu verilmişse kullanılmaz */
  footer?: string;
  highlight?: boolean;
}

const { href, tag, title, body, footer, highlight = false } = Astro.props;
const hasFooterSlot = Astro.slots.has('footer');

const shellClass = [
  'flex h-full flex-col border-y p-7 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2',
  highlight
    ? 'border-burgundy/35 bg-[#fffaf0] ring-1 ring-burgundy/15'
    : 'border-burgundy/12 bg-cream-soft hover:bg-white',
];
---

{
  href ? (
    <a href={href} class:list={['group block h-full', shellClass]}>
      {highlight && <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-burgundy">Öne çıkan</p>}
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-burgundy">{tag}</p>
      <h3 class="mb-3 font-serif text-3xl leading-tight tracking-[-0.015em] group-hover:underline group-hover:decoration-gold/70">{title}</h3>
      <p class="mb-4 flex-1 leading-relaxed text-ink/75">{body}</p>
      {hasFooterSlot ? (
        <div class="text-sm font-medium text-ink/80">
          <slot name="footer" />
        </div>
      ) : (
        footer && <p class="text-sm font-medium text-ink/80">{footer}</p>
      )}
    </a>
  ) : (
    <article class:list={shellClass}>
      {highlight && <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-burgundy">Öne çıkan</p>}
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-burgundy">{tag}</p>
      <h3 class="mb-3 font-serif text-3xl leading-tight tracking-[-0.015em]">{title}</h3>
      <p class="mb-4 flex-1 leading-relaxed text-ink/75">{body}</p>
      {hasFooterSlot ? (
        <div class="text-sm font-medium text-ink/80">
          <slot name="footer" />
        </div>
      ) : (
        footer && <p class="text-sm font-medium text-ink/80">{footer}</p>
      )}
    </article>
  )
}
