---
import { writers } from '../../data/writers';

interface Props {
  authorSlug: string; // 'berna-aksoy' | 'alara-baykent' | ...
  publishedDate: string; // ör. "14 Nisan 2026"
  lastUpdated?: string; // opsiyonel; yoksa gösterilmez
  readingMinutes: number; // ör. 7
}

const {
  authorSlug,
  publishedDate,
  lastUpdated,
  readingMinutes,
} = Astro.props;

const writer = writers.find((w) => w.slug === authorSlug);
if (!writer) {
  throw new Error(`ArticleAuthorBlock: writer slug "${authorSlug}" not found in writers.ts`);
}

const initials = writer.displayName
  .split(/\s+/)
  .filter((part) => part.length > 0)
  .map((n) => n[0])
  .join('');
---

<section
  class="rounded-[28px] border border-burgundy/15 bg-white p-7 shadow-[0_16px_44px_-24px_rgba(44,24,28,0.14)] ring-1 ring-black/[0.04] md:p-8"
>
  <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
    {
      writer.portrait ? (
        <img
          src={writer.portrait}
          alt={`${writer.displayName} portresi`}
          width="192"
          height="192"
          loading="lazy"
          decoding="async"
          class="h-20 w-20 shrink-0 rounded-full object-cover ring-2 ring-burgundy/15"
        />
      ) : (
        <div
          class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-cream-warm font-serif text-2xl text-burgundy ring-2 ring-burgundy/15"
          aria-hidden="true"
        >
          {initials}
        </div>
      )
    }
    <div class="min-w-0 flex-1">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-burgundy">Yazar</p>
      <p class="mt-1 font-serif text-xl text-ink">{writer.displayName}</p>
      <p class="text-sm text-ink/70">{writer.role.split('/')[0].trim()}</p>

      <p class="mt-3 text-xs uppercase tracking-[0.18em] text-ink/55">
        <span>Tıbben gözden geçirilmiş editöryal içerik</span>
      </p>
      <p class="mt-1 text-xs text-ink/55">
        Yayın: {publishedDate}
        {
          lastUpdated && (
            <>
              <span class="mx-1.5 text-gold">·</span>
              <span>Güncelleme: {lastUpdated}</span>
            </>
          )
        }
        <span class="mx-1.5 text-gold">·</span>
        <span>{readingMinutes} dk okuma</span>
      </p>
    </div>
  </div>
</section>
