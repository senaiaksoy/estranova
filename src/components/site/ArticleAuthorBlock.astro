---
import { writers } from '../../data/writers';
import { getSubmenuHeroImage } from '../../data/submenu-heroes';

interface Props {
  authorSlug: string;
  publishedDate: string;
  lastUpdated?: string;
  readingMinutes: number;
  medicalReviewer?: string;
  imageSrc?: string;
  imageAlt?: string;
  imagePosition?: string;
  eyebrow?: string;
}

const {
  authorSlug,
  publishedDate,
  lastUpdated,
  readingMinutes,
  medicalReviewer = 'Doç. Dr. Senai Aksoy',
  imageSrc,
  imageAlt,
  imagePosition = 'center',
  eyebrow = 'Makale bilgisi',
} = Astro.props;

const writer = writers.find((w) => w.slug === authorSlug);
if (!writer) {
  throw new Error(`ArticleAuthorBlock: writer slug "${authorSlug}" not found in writers.ts`);
}

const routeHero = getSubmenuHeroImage(Astro.url.pathname);
const bylineLabel = writer.isInstitutionalByline ? 'Hazırlayan' : 'Yazan';
const coverSrc = imageSrc ?? routeHero?.src;
const coverAlt =
  imageAlt ??
  routeHero?.alt ??
  'Estranova makale konusu için editoryal kapak görseli';
const authorProfileHref = writer.isInstitutionalByline ? '/editoryal-politika' : `/yazarlar/${writer.slug}`;
const authorProfileLabel = writer.isInstitutionalByline ? 'Yayın ilkeleri' : 'Yazar profili';
---

<section class="relative overflow-hidden rounded-[34px] border border-black/10 bg-white shadow-[0_34px_120px_-76px_rgba(44,24,28,0.42)] ring-1 ring-black/[0.035]">
  <div class="grid items-stretch gap-0 lg:grid-cols-[minmax(18rem,0.86fr)_minmax(0,1.14fr)]">
    <div class="relative aspect-[4/5] min-h-[24rem] overflow-hidden bg-cream-warm lg:aspect-auto lg:min-h-full lg:h-full">
      {
        coverSrc ? (
          <img
            src={coverSrc}
            alt={coverAlt}
            width="900"
            height="1120"
            loading="lazy"
            decoding="async"
            style={`object-position: ${imagePosition};`}
            class="absolute inset-0 h-full w-full object-cover object-center"
          />
        ) : (
          <div class="absolute inset-0 flex items-center justify-center bg-[radial-gradient(circle_at_30%_20%,rgba(201,169,110,0.28),transparent_32%),linear-gradient(135deg,#f7efe5,#ffffff_48%,#efe1d4)] px-8 text-center">
            <p class="font-serif text-4xl italic leading-tight text-burgundy/70">Estranova dosya</p>
          </div>
        )
      }
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1b1413]/42 via-transparent to-transparent"></div>
      <div class="absolute bottom-5 left-5 rounded-full border border-white/25 bg-white/12 px-4 py-2 text-[10px] font-bold uppercase tracking-[0.24em] text-white backdrop-blur-md">
        Dosya görseli
      </div>
    </div>

    <div class="relative flex min-h-[24rem] flex-col justify-center px-7 py-10 text-center md:px-12 lg:px-16">
      <div class="pointer-events-none absolute inset-y-8 left-0 hidden w-px bg-gradient-to-b from-transparent via-gold/65 to-transparent lg:block"></div>
      <div class="pointer-events-none absolute right-8 top-8 font-serif text-7xl italic leading-none text-burgundy/[0.035]" aria-hidden="true">
        E
      </div>

      <p class="text-[11px] font-bold uppercase tracking-[0.28em] text-burgundy/72">{eyebrow}</p>
      <div class="mx-auto mt-5 h-px w-12 bg-gold/80"></div>

      <div class="mx-auto mt-7 max-w-xl">
        <p class="text-[11px] font-black uppercase tracking-[0.18em] text-ink">
          {bylineLabel} : <span class="font-black">{writer.displayName}</span>
        </p>
        <p class="mt-2 text-[11px] font-black uppercase tracking-[0.16em] text-ink">
          Bilimsel inceleme : <span class="font-black">{medicalReviewer}</span>
        </p>
        <p class="mt-5 font-serif text-sm tracking-[0.22em] text-ink/62">{publishedDate}</p>
        <div class="mx-auto mt-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-[11px] uppercase tracking-[0.18em] text-ink/52">
          <span>{readingMinutes} dakikalık okuma</span>
          {
            lastUpdated && (
              <>
                <span class="text-gold">·</span>
                <span>Son güncelleme: {lastUpdated}</span>
              </>
            )
          }
        </div>
      </div>

      <div class="mx-auto mt-8 max-w-lg border-t border-gold/35 pt-5">
        <p class="text-sm leading-relaxed text-ink/68">{writer.role.split('/')[0].trim()}</p>
        <div class="mt-5 flex flex-wrap items-center justify-center gap-3 text-[10px] font-bold uppercase tracking-[0.2em]">
          <a
            href={authorProfileHref}
            class="rounded-full border border-burgundy/15 px-4 py-2 text-burgundy transition hover:border-burgundy/35 hover:bg-burgundy hover:text-white"
          >
            {authorProfileLabel}
          </a>
          <a
            href="/tibbi-sorumluluk"
            class="rounded-full border border-gold/35 px-4 py-2 text-ink/58 transition hover:border-gold hover:bg-gold/10 hover:text-ink"
          >
            Tıbbi not
          </a>
        </div>
      </div>

      {
        writer.isInstitutionalByline && (
          <div class="mx-auto mt-7 max-w-xl rounded-[22px] border border-burgundy/12 bg-cream-warm/45 px-5 py-4 text-left">
            <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-burgundy">Editoryal not</p>
            <p class="mt-2 text-sm leading-relaxed text-ink/72">
              Bu içerik Estranova editörleri tarafından hazırlanmış kurumsal editoryal içeriktir ve yayın öncesinde
              <span class="font-semibold text-ink"> {medicalReviewer}</span> tarafından bilimsel uygunluk, terminoloji
              ve kanıt dengesi açısından gözden geçirilir.
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>
