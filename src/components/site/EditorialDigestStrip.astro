<!-- Inline aylık editoryal özet — form action backend ile bağlanacak -->
<section
  class="border-t border-[#6B2D3E]/10 bg-[#FDF8F0] px-6 py-12 md:py-14"
  aria-labelledby="editorial-digest-heading"
>
  <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-3">
      <img
        src="/images/newsletter/newsletter-ritual.webp"
        alt="Açık bir kitap, keten kumaş ve bir fincan: sakin bir sabah ritüeli"
        width="1200"
        height="1200"
        loading="lazy"
        decoding="async"
        class="aspect-square w-full max-w-[280px] rounded-2xl object-cover ring-1 ring-[#6B2D3E]/10 lg:max-w-none"
      />
    </div>

    <div class="lg:col-span-5">
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">
        <span class="font-serif font-normal tabular-nums text-[#C9A96E]">06</span>
        <span class="mx-2 text-[#C9A96E]">—</span>
        EDİTÖRYAL ÖZET
      </p>
      <h2 id="editorial-digest-heading" class="mb-4 font-serif text-3xl leading-tight text-[#2D2D2D]">
        Aylık bir sakin seçki
      </h2>
      <p class="text-base leading-relaxed text-[#2D2D2D]/75">
        Her ay okuduğumuz ve hazırladığımız içeriklerden bir araya getirdiğimiz kısa bir seçki. Satış yok, promosyon
        yok. İstediğin an ayrılırsın.
      </p>
    </div>

    <div class="lg:col-span-4">
      <!-- TODO: form action — backend hazır olduğunda endpoint ile değiştir -->
      <form
        method="post"
        action="#"
        class="flex flex-col gap-3"
        aria-describedby="editorial-digest-kvkk"
        name="editorial-digest"
      >
        <div class="flex flex-col gap-3 sm:flex-row sm:items-stretch">
          <label for="editorial-digest-email" class="sr-only">E-posta</label>
          <input
            id="editorial-digest-email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            required
            placeholder="E-posta"
            class="min-h-[48px] w-full min-w-0 flex-1 rounded-xl border border-[#6B2D3E]/20 bg-white px-4 text-sm text-[#2D2D2D] shadow-sm outline-none transition placeholder:text-[#2D2D2D]/40 focus:border-[#6B2D3E]/40 focus:ring-2 focus:ring-[#6B2D3E]/20"
          />
          <button
            type="submit"
            class="inline-flex min-h-[48px] shrink-0 items-center justify-center rounded-xl bg-[#6B2D3E] px-6 text-sm font-semibold text-white shadow-sm transition hover:opacity-95 focus:outline-none focus:ring-2 focus:ring-[#6B2D3E]/35 sm:px-7"
          >
            Özeti al
          </button>
        </div>
        <p id="editorial-digest-kvkk" class="text-[11px] leading-snug text-[#2D2D2D]/55">
          <a
            href="/kvkk"
            class="underline decoration-[#2D2D2D]/25 underline-offset-2 transition hover:text-[#2D2D2D]/80 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#6B2D3E]/35 focus-visible:ring-offset-2"
          >
            Bilgilerin nasıl işlenir?
          </a>
        </p>
      </form>
    </div>
  </div>
</section>
