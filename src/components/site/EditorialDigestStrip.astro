---
interface Props {
  sectionNumber?: string;
}

const { sectionNumber = '08' } = Astro.props;
---

<!-- Inline aylık editoryal özet — form action backend ile bağlanacak -->
<section
  class="relative isolate overflow-hidden border-t border-burgundy/10 bg-cream-soft px-6 py-16 md:py-20"
  aria-labelledby="editorial-digest-heading"
>
  <div class="pointer-events-none absolute -right-24 top-8 h-72 w-72 rounded-full bg-gold/12 blur-3xl"></div>
  <div class="mx-auto grid max-w-6xl grid-cols-1 items-stretch gap-8 rounded-[38px] border border-burgundy/14 bg-white/55 p-5 shadow-2xl shadow-burgundy/8 ring-1 ring-white/70 lg:grid-cols-12 lg:gap-10 lg:p-8">
    <div class="lg:col-span-4">
      <div class="relative overflow-hidden rounded-[32px]">
        <img
          src="/images/newsletter/newsletter-ritual.webp"
          alt="Açık bir kitap, keten kumaş ve bir fincan: sakin bir sabah ritüeli"
          width="1200"
          height="1200"
          loading="lazy"
          decoding="async"
          class="aspect-[4/5] w-full object-cover ring-1 ring-burgundy/10"
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1c1412]/22 via-transparent to-transparent"></div>
        <span class="pointer-events-none absolute left-5 top-5 rounded-full border border-cream-soft/35 bg-white/12 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.24em] text-cream-soft backdrop-blur-sm">
          Aylık
        </span>
      </div>
    </div>

    <div class="flex flex-col justify-center lg:col-span-4">
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
        <span class="font-serif font-normal tabular-nums text-gold">{sectionNumber}</span>
        <span class="mx-2 text-gold">—</span>
        EDİTÖRYAL ÖZET
      </p>
      <h2 id="editorial-digest-heading" class="mb-4 font-serif text-4xl leading-[0.98] tracking-[-0.03em] text-ink md:text-6xl">
        Aylık bir sakin seçki
      </h2>
      <p class="text-lg leading-relaxed text-ink/75">
        Her ay okuduğumuz ve hazırladığımız içeriklerden bir araya getirdiğimiz kısa bir seçki. Satış yok, promosyon
        yok. İstediğiniz an ayrılırsınız.
      </p>
    </div>

    <div class="flex flex-col justify-center lg:col-span-4">
      <!-- Faz 2 öncesi: localStorage bekleme listesi; backend'e geçince
           newsletter-signup.ts script'i endpoint çağrısına bağlanır. -->
      <form
        method="post"
        action="#"
        class="flex flex-col gap-3 rounded-[28px] border border-burgundy/12 bg-cream-soft/70 p-4"
        aria-describedby="editorial-digest-kvkk"
        name="editorial-digest"
        data-newsletter-form="monthly"
      >
        <div class="flex flex-col gap-3 sm:flex-row sm:items-stretch">
          <label for="editorial-digest-email" class="sr-only">E-posta</label>
          <input
            id="editorial-digest-email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            required
            placeholder="E-posta"
            class="min-h-[52px] w-full min-w-0 flex-1 rounded-full border border-burgundy/20 bg-white px-5 text-sm text-ink shadow-sm outline-none transition placeholder:text-ink/40 focus:border-burgundy/40 focus:ring-2 focus:ring-burgundy/20"
          />
          <button
            type="submit"
            class="inline-flex min-h-[52px] shrink-0 items-center justify-center rounded-full bg-burgundy px-7 text-sm font-semibold text-white shadow-lg shadow-burgundy/18 transition hover:opacity-95 focus:outline-none focus:ring-2 focus:ring-burgundy/35 sm:px-8"
          >
            Özeti al
          </button>
        </div>
        <p id="editorial-digest-kvkk" class="text-[11px] leading-snug text-ink/55">
          <a
            href="/kvkk"
            class="underline decoration-ink/25 underline-offset-2 transition hover:text-ink/80 focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
          >
            Bilgilerin nasıl işlenir?
          </a>
        </p>
      </form>

      <div
        data-newsletter-success
        hidden
        role="status"
        aria-live="polite"
        class="rounded-xl border border-burgundy/20 bg-white px-5 py-4 text-sm leading-relaxed text-ink/80"
      >
        <p class="mb-1 font-serif text-base italic text-burgundy">Liste hazır.</p>
        <p>
          Aylık seçki yola çıkmaya hazırlanırken adresini sakin bir şekilde
          kaydettik. İlk özet hazır olduğunda gelen kutunuza düşecek; istediğiniz
          an ayrılabilirsiniz.
        </p>
      </div>
    </div>
  </div>
</section>
