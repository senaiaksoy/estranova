---
/**
 * Makale sonu tıbbi sorumluluk notu.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section
  class:list={[
    'relative overflow-hidden rounded-[30px] border border-dashed border-burgundy/22 bg-white/88 p-6 shadow-[0_18px_52px_-38px_rgba(44,22,28,0.24)] ring-1 ring-white/80 md:p-7',
    className,
  ]}
>
  <div class="pointer-events-none absolute right-5 top-5 h-12 w-12 rounded-full bg-gold/12 blur-xl"></div>
  <p class="relative mb-2 flex items-center gap-3 text-[10px] font-bold uppercase tracking-[0.26em] text-burgundy">
    <span class="h-px w-8 bg-gold/70"></span>
    <span>Tıbbi Not</span>
  </p>
  <div class="relative max-w-3xl text-sm leading-relaxed text-ink/74">
    <slot />
  </div>
</section>
