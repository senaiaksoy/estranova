---
import { featureFlags } from '../../utils/feature-flags';
import PreferredSourceCTA from './PreferredSourceCTA.astro';

const showCookieTrigger = featureFlags.cookieBannerEnabled;
---

<footer
  aria-label="Alt bilgi"
  role="contentinfo"
  class="relative isolate overflow-hidden bg-secondary px-6 pb-10 pt-20 text-cream-soft focus-within:ring-2 focus-within:ring-white/20"
>
  <div class="pointer-events-none absolute -left-24 top-20 h-80 w-80 rounded-full bg-cream-warm/10 blur-3xl"></div>
  <div class="pointer-events-none absolute right-0 top-10 hidden font-serif text-[11rem] italic leading-none tracking-[-0.08em] text-white/[0.035] lg:block">
    son sayfa
  </div>

  <div class="mx-auto mb-12 grid max-w-6xl gap-8 border-y border-cream-soft/12 py-12 lg:grid-cols-[1.2fr_1.8fr] lg:items-start">
    <div class="rounded-[34px] border border-white/12 bg-white/[0.045] p-6 ring-1 ring-white/10 backdrop-blur-sm md:p-8">
      <a
        href="/"
        class="mb-6 inline-block rounded px-2 py-1 text-left text-5xl font-serif font-bold leading-[0.85] tracking-[-0.06em] text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50 md:text-6xl"
        aria-label="ESTRANOVA Ana Sayfası"
        title="ESTRANOVA - Ana Sayfaya Dön"
      >
        <span>ESTRANOVA</span>
        <span class="mt-3 block text-[10px] font-sans font-semibold tracking-[0.28em] text-cream-warm">EDİTORYAL SAĞLIK PLATFORMU</span>
      </a>
      <p class="max-w-sm text-base leading-relaxed text-cream-soft/64">
        Perimenopoz, menopoz ve 40+ sağlık başlıklarında kanıta dayalı editoryal içerik platformu.
      </p>
      <div class="mt-8 border-l border-gold/55 pl-5">
        <p class="font-serif text-2xl italic leading-snug text-cream-soft/86">
          Panik değil; sakin okuma, iyi soru ve tıbbi gözden geçirme.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-cream-soft/58">
          Estranova bir randevu veya tedavi yönlendirme alanı değildir; kamuya açık bir editoryal bilgi zemini olarak kurgulanır.
        </p>
      </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-3">
      <div class="rounded-[28px] border border-white/10 bg-white/[0.035] p-5">
        <h4 class="mb-5 font-serif text-xl text-white">İçerik</h4>
        <nav aria-label="İçerik bağlantıları">
          <ul class="space-y-3 text-sm text-cream-soft/60">
            <li><a href="/hormonal-gecis/" class="rounded px-2 py-1 transition-colors hover:text-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary/50" title="Hormonal geçiş rehberi">Hormonal Geçiş</a></li>
            <li><a href="/zamansiz-yasam/" class="rounded px-2 py-1 transition-colors hover:text-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary/50" title="Zamansız yaşam içerikleri">Zamansız Yaşam</a></li>
            <li><a href="/beden-yakinlik/" class="rounded px-2 py-1 transition-colors hover:text-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary/50" title="Beden ve yakınlık">Beden & Yakınlık</a></li>
            <li><a href="/zihin-denge/" class="rounded px-2 py-1 transition-colors hover:text-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary/50" title="Zihin ve denge">Zihin & Denge</a></li>
            <li><a href="/bilimsel-pencere/" class="rounded px-2 py-1 transition-colors hover:text-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary/50" title="Bilimsel pencere">Bilimsel Pencere</a></li>
          </ul>
        </nav>
      </div>

      <div class="rounded-[28px] border border-white/10 bg-white/[0.035] p-5">
        <h4 class="mb-5 font-serif text-xl text-white">Hakkımızda</h4>
        <nav aria-label="Platform bilgileri">
          <ul class="space-y-3 text-sm text-cream-soft/60">
            <li><a href="/manifesto/" class="rounded px-2 py-1 transition-colors hover:text-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary/50" title="Estranova Manifestosu — bu masada neden varız">Manifesto</a></li>
            <li><a href="/hakkimizda/" class="rounded px-2 py-1 transition-colors hover:text-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary/50" title="Platform hakkında">Platform Hakkında</a></li>
            <li><a href="/editoryal-politika/" class="rounded px-2 py-1 transition-colors hover:text-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary/50" title="Editoryal politika">Editoryal Politika</a></li>
            <li><a href="/editoryal-ilkeler/" class="rounded px-2 py-1 transition-colors hover:text-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary/50" title="Estranova Editöryal İlkelerimiz — yayın felsefesi, üretim süreci ve yapay zekâ kullanım sınırları">Editöryal İlkelerimiz</a></li>
            <li><a href="/yayin-kurulu/" class="rounded px-2 py-1 transition-colors hover:text-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary/50" title="Künye — Editöryal ekip ve danışmanlar">Künye</a></li>
            <li><a href="/iletisim/" class="rounded px-2 py-1 transition-colors hover:text-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary/50" title="İletişim ve bilgi sayfası">İletişim</a></li>
          </ul>
        </nav>
      </div>

      <div class="rounded-[28px] border border-white/10 bg-white/[0.035] p-5">
        <h4 class="mb-5 font-serif text-xl text-white">Yasal</h4>
        <nav aria-label="Yasal bilgiler">
          <ul class="space-y-3 text-sm text-cream-soft/60">
            <li><a href="/tibbi-sorumluluk/" class="rounded px-2 py-1 transition-colors hover:text-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary/50" title="Tıbbi sorumluluk reddi">Tıbbi Sorumluluk Reddi</a></li>
            <li><a href="/gizlilik/" class="rounded px-2 py-1 transition-colors hover:text-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary/50" title="Gizlilik — sade özet ve yönlendirme">Gizlilik</a></li>
            <li><a href="/kvkk/" class="rounded px-2 py-1 transition-colors hover:text-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary/50" title="KVKK Aydınlatma Metni — kişisel verilerin işlenmesi">KVKK Aydınlatma Metni</a></li>
            <li><a href="/cerez-politikasi/" class="rounded px-2 py-1 transition-colors hover:text-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary/50" title="Çerez politikası">Çerez Politikası</a></li>
            <li><a href="/kullanim-kosullari/" class="rounded px-2 py-1 transition-colors hover:text-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary/50" title="Kullanım koşulları">Kullanım Koşulları</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </div>

  <div
    class="mx-auto mb-10 grid max-w-6xl gap-5 rounded-[30px] border border-cream-soft/12 bg-cream-soft/5 p-6 focus-within:ring-2 focus-within:ring-white/20 md:grid-cols-[1fr_auto] md:items-center md:p-7"
    role="region"
    aria-label="Platform yönetimi"
    tabindex="0"
  >
    <p class="text-xs leading-relaxed tracking-[0.08em] text-cream-soft/70">
      Site Yöneticisi: <span class="font-semibold text-white">Berna Aksoy</span> &middot;
      Bilimsel Editör / Editoryal Danışman Hekim: <span class="font-semibold text-white">Doç. Dr. Senai Aksoy</span>
    </p>
    <a
      href="/editoryal-politika/"
      class="inline-flex text-xs font-semibold uppercase tracking-[0.18em] text-cream-warm underline decoration-cream-warm/40 underline-offset-4 transition hover:text-white hover:decoration-white focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50"
    >
      Editoryal politikayı oku
    </a>
  </div>

  <div
    class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 border-t border-cream-soft/10 pt-8 text-[10px] font-medium uppercase tracking-widest text-cream-soft/40 md:flex-row"
    aria-label="Site telif hakkı"
  >
    <p>&copy; 2026 ESTRANOVA. TÜM HAKLARI SAKLIDIR.</p>
    <nav aria-label="Alt bilgi navigasyonu">
      <div class="flex gap-8 flex-wrap justify-center">
        <a href="/tibbi-sorumluluk/" class="hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50 rounded px-2 py-1" title="Tıbbi sorumluluk reddi">TIBBİ SORUMLULUK REDDİ</a>
        <a href="/editoryal-politika/" class="hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50 rounded px-2 py-1" title="Editoryal politika">EDİTORYAL POLİTİKA</a>
        <a href="/gizlilik/" class="hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50 rounded px-2 py-1" title="Gizlilik">GİZLİLİK</a>
        <a href="/kvkk/" class="hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50 rounded px-2 py-1" title="KVKK Aydınlatma Metni">KVKK AYDINLATMA METNİ</a>
        <a href="/cerez-politikasi/" class="hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50 rounded px-2 py-1" title="Çerez politikası">ÇEREZ POLİTİKASI</a>
        {showCookieTrigger && (
          <button
            type="button"
            data-cookie-trigger="open"
            class="hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50 rounded px-2 py-1 underline decoration-cream-soft/30 underline-offset-4"
            title="Çerez tercihlerini değiştir"
          >
            ÇEREZ TERCİHLERİ
          </button>
        )}
        <a href="/kullanim-kosullari/" class="hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50 rounded px-2 py-1" title="Kullanım koşulları">KULLANIM KOŞULLARI</a>
        <a href="/yayin-kurulu/" class="hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50 rounded px-2 py-1" title="Künye">KÜNYE</a>
        <a href="/iletisim/" class="hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50 rounded px-2 py-1" title="İletişim">İLETİŞİM</a>
        <PreferredSourceCTA variant="footer" />
      </div>
    </nav>
  </div>
</footer>

