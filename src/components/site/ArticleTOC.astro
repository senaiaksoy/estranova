---
/**
 * Makale içi sticky TOC (içindekiler) — Aeon ve Atlantic uzun-form
 * okuma deneyiminin Estranova uyarlaması.
 *
 * Üç katmanlı:
 * 1. Scroll progress — sayfa yüzdesi gold ince çubuk olarak.
 * 2. Sticky liste — SubmenuArticleBody içinde `<aside class="sticky">`
 *    wrapping ile zaten sticky.
 * 3. Active section highlight — IntersectionObserver ile makale H2'leri
 *    izlenir, viewport ortasındaki bölümün link'i burgundy ve kalın
 *    olarak işaretlenir.
 *
 * Client-side davranış: src/scripts/article-toc.ts (SiteLayout'ta
 * tüm sayfalarda yüklü; data-toc varsa devreye girer).
 */

export interface TOCEntry {
  id: string;
  label: string;
}

interface Props {
  entries: TOCEntry[];
}

const { entries } = Astro.props;
---

<nav
  data-toc
  aria-label="İçindekiler"
  class="rounded-[30px] border border-burgundy/12 bg-white p-5 font-sans shadow-[0_20px_58px_-42px_rgba(44,22,28,0.28)] ring-1 ring-black/[0.04]"
>
  <div class="pointer-events-none mb-5 h-px w-full bg-gradient-to-r from-transparent via-gold/65 to-transparent"></div>
  <div
    data-toc-progress
    aria-hidden="true"
    class="mb-5 h-0.5 w-full overflow-hidden rounded-full bg-burgundy/10"
  >
    <div
      data-toc-progress-bar
      class="h-full w-0 bg-gold transition-[width] duration-150 ease-out"
    ></div>
  </div>

  <p class="mb-1 flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.24em] text-burgundy">
    <span class="font-serif text-base font-normal italic text-gold">folio</span>
    Makale Haritası
  </p>
  <p class="mb-5 border-b border-gold/25 pb-4 font-serif text-lg italic leading-tight text-ink/80">Bölüm bölüm oku</p>

  <ol class="space-y-3.5 text-sm leading-snug">
    {
      entries.map((entry, i) => (
        <li>
          <a
            href={`#${entry.id}`}
            data-toc-link={entry.id}
            class="group grid grid-cols-[2rem_1fr] gap-2 rounded-2xl border border-transparent px-2 py-1.5 text-ink/70 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2 hover:bg-cream-soft/35 hover:text-burgundy data-[active=true]:border-gold/30 data-[active=true]:bg-cream-soft/45 data-[active=true]:font-semibold data-[active=true]:text-burgundy"
          >
            <span class="font-serif tabular-nums text-gold transition group-data-[active=true]:text-burgundy">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="group-hover:underline group-hover:decoration-burgundy/40 group-hover:underline-offset-2 group-data-[active=true]:underline group-data-[active=true]:decoration-burgundy/60 group-data-[active=true]:underline-offset-4">
              {entry.label}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>
