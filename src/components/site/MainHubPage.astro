---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from './SiteNavbar.astro';
import SiteFooter from './SiteFooter.astro';
import SubmenuHero from './SubmenuHero.astro';
import SubmenuSection from './SubmenuSection.astro';
import ChapterMasthead from './ChapterMasthead.astro';
import EditorialEpigraph from './EditorialEpigraph.astro';
import MarginaliaRail from './MarginaliaRail.astro';
import MarginaliaItem from './MarginaliaItem.astro';
import ChapterCompass from './ChapterCompass.astro';
import SubHubLatestStrip from './SubHubLatestStrip.astro';
import SubHubArchiveIndex from './SubHubArchiveIndex.astro';
import type { MainHubConfig } from '../../data/main-hubs';
import { submenuHeroByRoute, articleCardImageByRoute } from '../../data/submenu-heroes';
import { publishedStaticArticles as staticArticles } from '../../data/static-articles';
import { chapterMap } from '../../data/chapter-map';
import { subHubEpigraphs } from '../../data/sub-hub-epigraphs';
import { toISODate } from '../../utils/article-schema';

interface Props {
  config: MainHubConfig;
}

const { config } = Astro.props;
const hero = submenuHeroByRoute[config.path]!;
const epigraph = subHubEpigraphs[config.path];

const readingMinutesByPath: Record<string, number> = {
  '/bilimsel-pencere/yeni-arastirmalar/menopoz-hrt-meme-kanseri-riski/': 10,
  '/bilimsel-pencere/yeni-arastirmalar/glp1-analoglari-menopozal-kilo/': 11,
  '/zamansiz-yasam/deneysel/coenzyme-q10-takviyesi/': 9,
  '/beden-yakinlik/cinsel-saglik/libido-degisimi-menopoz/': 9,
  '/zamansiz-yasam/40-sonrasi-diz-agrisi-izlem-mudahale/': 8,
  '/zamansiz-yasam/durus-bozuldugunda-degil-beden-sessizce-sikistiginda/': 8,
  '/zamansiz-yasam/yapay-zeka-hekim-cihaz-dengesi/': 8,
  '/zamansiz-yasam/40-sonrasi-kas-iskelet-agrilari/': 8,
};

const newestFirst = (a: (typeof staticArticles)[number], b: (typeof staticArticles)[number]) =>
  toISODate(b.publishedDate).localeCompare(toISODate(a.publishedDate));

const articles = staticArticles.filter((article) => article.sectionPath === config.path).sort(newestFirst);
const latestArticle = articles[0];
const archiveArticles = articles.slice(1);

const toHubArticle = (article: (typeof staticArticles)[number]) => {
  const image = articleCardImageByRoute[article.path] ?? submenuHeroByRoute[article.path] ?? hero;

  return {
    href: article.path,
    title: article.title,
    excerpt: article.description,
    writerSlug: article.writerSlug,
    readingMinutes: readingMinutesByPath[article.path] ?? 9,
    publishedDate: article.publishedDate,
    keywords: article.keywords,
    image,
  };
};

const latest = latestArticle ? toHubArticle(latestArticle) : undefined;
const archiveItems = archiveArticles.map(toHubArticle);
const chapters = Object.values(chapterMap).filter((entry) => entry.href.startsWith(`${config.path}/`));
const next = chapters[0];

// Bölümdeki yazıların keyword'leri sıklığa göre toplanır; sağ kolondaki
// "Konular" chip listesi okuyucunun kategoriyi tarama hızını artırır.
const keywordFrequency = new Map<string, number>();
for (const article of articles) {
  for (const kw of article.keywords) {
    keywordFrequency.set(kw, (keywordFrequency.get(kw) ?? 0) + 1);
  }
}
const topKeywords = Array.from(keywordFrequency.entries())
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'tr'))
  .slice(0, 6)
  .map(([kw]) => kw);
---

<SiteLayout title={config.siteTitle} description={config.description}>
  <SiteNavbar currentPath={config.path} />

  <main id="main-content" class="text-ink">
    <ChapterMasthead variant="section" chapter={config.heroTitle} />

    <SubmenuHero
      eyebrow={config.heroEyebrow}
      title={config.heroTitle}
      lede={config.heroLede}
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />

    <section class="border-b border-primary/10 bg-[#fffaf0] px-6 py-14 md:py-16">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-12 lg:grid-cols-12 lg:items-start lg:gap-14">
          <div class="lg:col-span-8">
            <p class="editorial-dropcap text-lg leading-relaxed text-ink/85 md:text-xl">
              {config.description}
            </p>
          </div>

          <div class="lg:col-span-4 lg:pt-1">
            <MarginaliaRail>
              <MarginaliaItem
                label="Bu bölüm"
                value={`${articles.length} yazı · ${chapters.length} alt başlık${latestArticle ? ` · En yeni: ${latestArticle.publishedDate}` : ''}`}
              />
              {topKeywords.length > 0 && (
                <MarginaliaItem label="Konular">
                  <ul class="mt-2 flex flex-wrap gap-1.5">
                    {topKeywords.map((kw) => (
                      <li>
                        <span class="inline-flex items-center rounded-full border border-primary/15 bg-cream-soft/40 px-2.5 py-1 text-[11px] uppercase tracking-[0.16em] text-ink/72">
                          {kw}
                        </span>
                      </li>
                    ))}
                  </ul>
                </MarginaliaItem>
              )}
              <MarginaliaItem
                label="Tıbbi inceleme"
                value="Her yazı bilimsel editör Doç. Dr. Senai Aksoy gözden geçirmesinden geçer; iddialar kanıt seviyesiyle birlikte yayınlanır."
              />
            </MarginaliaRail>
          </div>
        </div>
      </div>
    </section>

    {epigraph && <EditorialEpigraph quote={epigraph} />}

    {
      latest && (
        <SubmenuSection variant="white" borderedTop={true} class="!py-10 md:!py-12">
          <header class="mb-5 grid gap-4 lg:grid-cols-[0.42fr_1.58fr] lg:items-end">
            <p class="text-xs font-bold uppercase tracking-[0.24em] text-primary">Son yazı</p>
            <div>
              <h2 class="font-serif text-3xl leading-tight text-ink md:text-4xl">Bu dosyadan yeni okuma</h2>
              <p class="mt-3 max-w-3xl text-sm leading-relaxed text-ink/68 md:text-base">
                En yeni yazı yalnızca ritmi belirler; sayfanın ana ağırlığı taranabilir arşivde kalır.
              </p>
            </div>
          </header>

          <SubHubLatestStrip
            href={latest.href}
            title={latest.title}
            excerpt={latest.excerpt}
            writerSlug={latest.writerSlug}
            readingMinutes={latest.readingMinutes}
            publishedDate={latest.publishedDate}
            imageSrc={latest.image.src}
            imageAlt={latest.image.alt}
          />
        </SubmenuSection>
      )
    }

    {
      archiveItems.length > 0 && (
        <SubmenuSection variant="cream" borderedTop={true} class="!py-12 md:!py-14">
          <header class="mb-5">
            <h2 class="text-xs font-bold uppercase tracking-[0.24em] text-primary">Aynı dosyada</h2>
          </header>

          <SubHubArchiveIndex items={archiveItems} startAt={2} initialVisible={8} />
        </SubmenuSection>
      )
    }

    {
      chapters.length > 0 && (
        <SubmenuSection variant="white" borderedTop={archiveItems.length === 0}>
          <header class="mb-10 grid gap-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-end">
            <p class="text-xs font-bold uppercase tracking-[0.24em] text-primary">Alt başlıklar</p>
            <h2 class="font-serif text-4xl leading-tight text-ink md:text-5xl">Bu kategorideki yollar</h2>
          </header>
          <div class="divide-y divide-primary/14 border-y border-primary/14 bg-white">
            {chapters.map((chapter, index) => (
              <a
                href={chapter.href}
                class="group grid gap-5 bg-white py-7 transition hover:bg-white md:grid-cols-[88px_1fr_auto] md:items-center md:py-8"
              >
                <span class="font-serif text-3xl italic text-gold">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="mb-2 font-serif text-3xl leading-tight text-ink group-hover:text-primary">
                    {chapter.chapter}
                  </h3>
                  <p class="max-w-2xl text-sm leading-relaxed text-ink/72">
                    {chapter.parent} içinde bir okuma rotası.
                  </p>
                </div>
                <span class="text-2xl text-gold transition group-hover:translate-x-1" aria-hidden="true">
                  →
                </span>
              </a>
            ))}
          </div>
        </SubmenuSection>
      )
    }

    <ChapterCompass nextHref={next?.href} nextNumber={next?.number} nextChapter={next?.chapter} nextParent={next?.parent} />
  </main>

  <SiteFooter />
</SiteLayout>
