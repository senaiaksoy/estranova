---
/**
 * Hub sayfasında "Bu konuda nereden başlamalıyım?" 3-adımlı giriş
 * rehberi.
 *
 * Versalie'nin "Getting Started" 3-adımlı sequence'ı — Estranova
 * için altın editöryal mimari öğesi: hub'a yeni gelen okurun "okuma
 * yolu"nu görsel olarak çizer. Pillar grid'i (alt-hub'lar) ile
 * çakışmaz; pillar'lar yapısal dağılım, bu rehber okur yolu önerisi.
 *
 * Pilot: hormonal-gecis hub'ı (Faz 1.8). Diğer 4 hub Faz 1.9'a
 * bırakıldı; bileşen 5 hub için hazır.
 */

interface PathStep {
  /** Sıra numarası (görsel — "01"/"02"/"03") */
  step: string;
  /** Adımın editöryal etiketi (örn. "Genel çerçeve", "Sık karşılaşılan", "Karar") */
  label: string;
  /** Önerilen makale başlığı */
  title: string;
  /** Tek cümlelik özet — neden bu adım */
  excerpt: string;
  /** Makale URL'i */
  href: string;
  /** Tahmini okuma süresi (dakika) */
  readingMinutes?: number;
}

interface Props {
  /** Bant açılış başlığı — "Hormonal geçişe yeni misiniz?" */
  kicker?: string;
  /** Ana başlık */
  title: string;
  /** 1-2 cümle açıklama */
  intro: string;
  /** 3-4 adımlı yol */
  steps: PathStep[];
}

const {
  kicker = 'Önerilen okuma yolu',
  title,
  intro,
  steps,
} = Astro.props;
---

<section class="relative overflow-hidden border-t border-burgundy/10 bg-gradient-to-b from-[#fffaf0] to-cream-soft px-6 py-16 md:py-20">
  <div class="pointer-events-none absolute -left-12 top-16 h-44 w-44 rounded-full bg-burgundy/6 blur-3xl"></div>
  <div class="pointer-events-none absolute right-8 top-10 hidden font-serif text-[8rem] italic leading-none text-burgundy/[0.035] md:block" aria-hidden="true">
    rota
  </div>
  <div class="mx-auto max-w-6xl">
    <header class="mb-12 grid gap-8 md:grid-cols-[0.72fr_1.28fr] md:items-end">
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
        {kicker}
      </p>
      <div>
        <h2 class="mb-4 font-serif text-4xl leading-[0.98] tracking-[-0.03em] text-ink md:text-6xl">
          {title}
        </h2>
        <p class="max-w-2xl text-base leading-relaxed text-ink/75 md:text-lg">{intro}</p>
      </div>
    </header>

    <ol class="overflow-hidden rounded-[38px] border border-burgundy/12 bg-white/68 shadow-[0_28px_90px_-60px_rgba(44,22,28,0.34)] ring-1 ring-white/75">
      {steps.map((step) => (
        <li class="border-t border-burgundy/12 first:border-t-0">
          <a
            href={step.href}
            class="group grid gap-4 px-5 py-7 transition hover:bg-cream-soft/72 focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2 md:grid-cols-[90px_180px_1fr_auto] md:items-center md:gap-7 md:px-7"
          >
            <span class="font-serif text-5xl italic leading-none tabular-nums text-gold md:text-6xl">
              {step.step}
            </span>
            <span class="flex items-center gap-3 text-[10px] font-semibold uppercase tracking-[0.22em] text-burgundy/75">
              <span class="h-px w-7 bg-gold/70"></span>
              <span>{step.label}</span>
            </span>
            <span>
              <span class="block font-serif text-2xl leading-tight text-ink group-hover:underline group-hover:decoration-gold/70 md:text-3xl">
                {step.title}
              </span>
              <span class="mt-2 block text-sm leading-relaxed text-ink/70 md:text-base">{step.excerpt}</span>
            </span>
            <span class="flex items-center justify-between gap-4 text-[11px] uppercase tracking-[0.18em] text-ink/55 md:flex-col md:items-end">
              {step.readingMinutes && (
                <span class="tabular-nums">~{step.readingMinutes} dk</span>
              )}
              <span class="font-serif text-2xl text-gold transition group-hover:translate-x-1" aria-hidden="true">
                →
              </span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>
