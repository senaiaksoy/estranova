---
import { writers } from '../../data/writers';

interface Props {
  href: string;
  title: string;
  excerpt: string;
  writerSlug: string;
  readingMinutes: number;
  publishedDate?: string;
  imageSrc?: string;
  imageAlt?: string;
  eyebrow?: string;
  cta?: string;
}

const {
  href,
  title,
  excerpt,
  writerSlug,
  readingMinutes,
  publishedDate,
  imageSrc,
  imageAlt = '',
  eyebrow = 'Son yazı',
  cta = 'Yazıyı oku',
} = Astro.props;

const writer = writers.find((w) => w.slug === writerSlug);
---

<a
  href={href}
  class="group grid gap-4 border-y border-primary/14 bg-white py-4 transition hover:bg-cream-soft/24 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/35 focus-visible:ring-offset-2 md:grid-cols-[8rem_1fr_auto] md:items-center md:px-5 lg:grid-cols-[9.25rem_1fr_auto]"
>
  <div class="relative aspect-[4/3] overflow-hidden rounded-2xl bg-cream-warm md:aspect-[5/4]">
    {
      imageSrc ? (
        <img src={imageSrc} alt={imageAlt} loading="lazy" decoding="async" class="h-full w-full object-cover object-top transition duration-700 group-hover:scale-[1.035]" />
      ) : (
        <div class="h-full w-full bg-[linear-gradient(135deg,#f7efe5,#ffffff_48%,#efe1d4)]"></div>
      )
    }
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1c1412]/34 via-transparent to-transparent"></div>
  </div>

  <div class="min-w-0">
    <p class="mb-3 flex items-center gap-3 text-[0.68rem] font-bold uppercase tracking-[0.22em] text-gold-bronze">
      <span class="h-px w-8 bg-gold/75"></span>
      <span>{eyebrow}</span>
    </p>
      <h3 class="max-w-4xl font-serif text-xl leading-tight text-ink transition group-hover:text-primary md:text-2xl lg:text-3xl">
        {title}
      </h3>
      <p class="mt-2 max-h-11 max-w-3xl overflow-hidden text-sm leading-relaxed text-ink/70">
        {excerpt}
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.68rem] uppercase tracking-[0.14em] text-ink/55">
      {writer && <span class="font-semibold text-primary">{writer.displayName}</span>}
      {publishedDate && <span>{publishedDate}</span>}
      <span>{readingMinutes} dk okuma</span>
    </div>
  </div>

  <span class="inline-flex w-max items-center gap-2 rounded-full border border-primary/10 bg-white px-4 py-2 text-sm font-semibold text-primary shadow-sm transition group-hover:border-gold/35 group-hover:bg-cream-soft/35 md:justify-self-end">
    {cta}
    <span aria-hidden="true">→</span>
  </span>
</a>
