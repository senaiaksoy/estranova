---
/**
 * Üst-bant: hero'nun üstünde küçük bir editöryel banner.
 * "BÖLÜM 03 · BEDEN & YAKINLIK / CİLT & GÖRÜNÜM" — Manrope small-caps + gold hairlines.
 *
 * variant='chapter'  → numaralı alt-hub'lar (default)
 * variant='section'  → ana hub girişleri (numara yok, "Dosya" prefix)
 */
interface Props {
  number?: string;
  parent?: string;
  chapter: string;
  variant?: 'chapter' | 'section';
}

const { number, parent, chapter, variant = 'chapter' } = Astro.props;

const prefix = variant === 'chapter' && number ? `Bölüm ${number}` : 'Dosya';
const showParent = variant === 'chapter' && parent;
---

<aside class="relative w-full overflow-hidden bg-white px-6 pt-10 pb-3" aria-label="Bölüm başlığı">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold/45 to-transparent"></div>
  <div class="pointer-events-none absolute -right-8 top-2 h-20 w-20 rounded-full bg-gold/12 blur-2xl"></div>
  <div class="mx-auto flex max-w-6xl items-center gap-4">
    <span class="h-px flex-1 bg-gradient-to-r from-transparent via-gold/45 to-gold/20"></span>
    <p class="whitespace-nowrap rounded-full border border-primary/10 bg-white px-4 py-2 text-center font-sans text-[10px] font-bold uppercase tracking-[0.32em] text-gold-bronze shadow-[0_16px_42px_-36px_rgba(44,22,28,0.24)] ring-1 ring-black/[0.04] md:text-xs">
      <span>{prefix}</span>
      <span class="mx-2 text-gold">·</span>
      {showParent && (
        <>
          <span>{parent}</span>
          <span class="mx-2 text-gold">/</span>
        </>
      )}
      <span class="text-secondary">{chapter}</span>
    </p>
    <span class="h-px flex-1 bg-gradient-to-l from-transparent via-gold/45 to-gold/20"></span>
  </div>
</aside>
