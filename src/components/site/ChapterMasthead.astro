---
/**
 * Üst-bant: hero'nun üstünde küçük bir editöryel banner.
 * "BÖLÜM 03 · BEDEN & YAKINLIK / CİLT & GÖRÜNÜM" — Manrope small-caps + gold hairlines.
 *
 * variant='chapter'  → numaralı alt-hub'lar (default)
 * variant='section'  → ana hub girişleri (numara yok, "Dosya" prefix)
 */
interface Props {
  number?: string;
  parent?: string;
  chapter: string;
  variant?: 'chapter' | 'section';
}

const { number, parent, chapter, variant = 'chapter' } = Astro.props;

const prefix = variant === 'chapter' && number ? `Bölüm ${number}` : 'Dosya';
const showParent = variant === 'chapter' && parent;
---

<aside class="relative w-full bg-[#FDF8F0] px-6 pt-10 pb-3" aria-label="Bölüm başlığı">
  <div class="mx-auto flex max-w-6xl items-center gap-4">
    <span class="h-px flex-1 bg-[#C9A96E]/35"></span>
    <p class="whitespace-nowrap text-center font-sans text-[10px] font-bold uppercase tracking-[0.32em] text-[#775a19] md:text-xs">
      <span>{prefix}</span>
      <span class="mx-2 text-[#C9A96E]">·</span>
      {showParent && (
        <>
          <span>{parent}</span>
          <span class="mx-2 text-[#C9A96E]">/</span>
        </>
      )}
      <span class="text-[#4f171c]">{chapter}</span>
    </p>
    <span class="h-px flex-1 bg-[#C9A96E]/35"></span>
  </div>
</aside>
