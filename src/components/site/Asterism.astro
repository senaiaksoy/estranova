---
/**
 * Bölüm içi geçişlerde "* * *" ayraç.
 * Üç bordo asterisk, italic Manrope; sayfa içi yumuşak ritim ayracı.
 */
interface Props {
  spacing?: 'compact' | 'normal' | 'wide';
}

const { spacing = 'normal' } = Astro.props;

const verticalPad = {
  compact: 'my-8',
  normal: 'my-12 md:my-16',
  wide: 'my-16 md:my-24',
}[spacing];
---

<div
  class:list={['flex items-center justify-center gap-5', verticalPad]}
  aria-hidden="true"
>
  <span class="select-none font-serif text-2xl italic text-secondary/55">∗</span>
  <span class="select-none font-serif text-2xl italic text-secondary/55">∗</span>
  <span class="select-none font-serif text-2xl italic text-secondary/55">∗</span>
</div>
