---
/**
 * /yazarlar/[slug] sayfasında yazar profili + dergi arşivi.
 *
 * Yazarın detaylı bio'sunu (publicBio, signaturePhrase, focusAreas)
 * ve dergi sayılarındaki imzasını gösterir. Faz 1'de yazara özel
 * makale arşivi yalnızca monthly-dossier verisinden çekilir; site
 * genelindeki tüm makalelerin tersine indeksi ileride eklenir.
 */

import type { Writer } from '../../data/writers';
import { dossiers } from '../../data/monthly-dossier';
import { writers } from '../../data/writers';
import {
  issues,
  formatIssuePad,
  resolveCoverDossier,
  resolveIssueSections,
} from '../../data/issues';
import { magazineConfig } from '../../data/magazine-config';

interface Props {
  writer: Writer;
}

const { writer } = Astro.props;

// Bu yazarın imzasını taşıyan dossier yazıları
const writerArticles = dossiers
  .flatMap((d) =>
    d.articles
      .filter((a) => a.writerSlug === writer.slug && a.status === 'published')
      .map((a) => ({
        ...a,
        dossierTitle: d.title,
        dossierSlug: d.slug,
        monthYear: d.monthYear,
      })),
  )
  .sort((a, b) => b.dossierSlug.localeCompare(a.dossierSlug));

// Bu yazarın küratörlük yaptığı dosyalar
const curatedDossiers = dossiers.filter((d) => d.curatorSlug === writer.slug);

// Bu yazarın yer aldığı sayılar — kapak dosyası küratörlüğü, kapak
// dosyasında yazarlık, editör mektubu, sabit köşe (section) yazarlığı
const issuesWithWriter = issues
  .filter((issue) => issue.number > 0)
  .map((issue) => {
    const roles: string[] = [];
    if (issue.editorLetter.writerSlug === writer.slug) {
      roles.push('Bilimsel editör mektubu');
    }
    const coverDossier = resolveCoverDossier(issue);
    if (coverDossier) {
      if (coverDossier.curatorSlug === writer.slug) {
        roles.push('Kapak dosyası küratörü');
      }
      const dossierWriterCount = coverDossier.articles.filter(
        (a) => a.writerSlug === writer.slug && a.status === 'published',
      ).length;
      if (dossierWriterCount > 0) {
        roles.push(
          dossierWriterCount === 1
            ? 'Kapak dosyasında bir yazı'
            : `Kapak dosyasında ${dossierWriterCount} yazı`,
        );
      }
    }
    const sections = resolveIssueSections(issue);
    sections
      .filter((s) => s.status === 'published' && s.writerSlug === writer.slug)
      .forEach((s) => roles.push(s.label));
    return { issue, roles };
  })
  .filter((entry) => entry.roles.length > 0)
  .sort((a, b) => b.issue.number - a.issue.number);

// Bilimsel editör (Doç. Dr. Senai Aksoy) için akademik ön ekli görünüm
const displayWithTitle =
  writer.slug === 'senai-aksoy' ? 'Doç. Dr. Senai Aksoy' : writer.displayName;
---

<section class="relative overflow-hidden border-t border-burgundy/10 bg-white px-6 py-14 md:py-20">
  <div class="pointer-events-none absolute -left-16 top-16 h-48 w-48 rounded-full bg-burgundy/7 blur-3xl"></div>
  <div class="pointer-events-none absolute bottom-6 right-[8%] hidden font-serif text-[9rem] italic leading-none text-burgundy/[0.035] md:block" aria-hidden="true">
    imza
  </div>
  <div class="relative mx-auto max-w-5xl">
    <nav aria-label="Sayfa konumu" class="mb-6 text-xs uppercase tracking-[0.22em] text-ink/55">
      <a href="/" class="text-ink/65 hover:text-burgundy">Anasayfa</a>
      <span class="mx-2 text-gold">·</span>
      <a href="/yayin-kurulu" class="text-ink/65 hover:text-burgundy">Yayın Kurulu</a>
      <span class="mx-2 text-gold">·</span>
      <span class="text-burgundy">{writer.displayName}</span>
    </nav>

    <div class="overflow-hidden rounded-[42px] border border-burgundy/12 bg-white p-7 shadow-[0_34px_100px_-70px_rgba(44,22,28,0.34)] ring-1 ring-black/[0.04] md:p-9">
    <div class="flex flex-col items-start gap-8 md:flex-row md:gap-12">
      {writer.portrait ? (
        <img
          src={writer.portrait}
          alt={`${writer.displayName} portresi`}
          width="240"
          height="240"
          loading="eager"
          decoding="async"
          class="h-40 w-40 rounded-[34px] object-cover shadow-[0_22px_62px_-38px_rgba(44,22,28,0.46)] ring-2 ring-gold/30 md:h-48 md:w-48"
        />
      ) : (
        <div class="flex h-40 w-40 items-center justify-center rounded-[34px] bg-cream-soft/20 font-serif text-5xl text-burgundy shadow-[0_22px_62px_-42px_rgba(44,22,28,0.38)] ring-2 ring-gold/30 md:h-48 md:w-48">
          {writer.displayName
            .split(/\s+/)
            .filter((part) => part.length > 0)
            .map((n) => n[0])
            .join('')}
        </div>
      )}
      <div class="min-w-0 flex-1">
        <p class="mb-4 flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.28em] text-burgundy">
          <span class="h-px w-9 bg-gold/75"></span>
          <span>{writer.role}</span>
        </p>
        <h1 class="mb-4 font-serif text-5xl leading-[0.95] tracking-[-0.04em] text-burgundy md:text-7xl">
          {displayWithTitle}
        </h1>
        <p class="mb-5 max-w-2xl border-l-2 border-gold/60 pl-5 font-serif text-xl italic leading-relaxed text-ink/70 md:text-2xl">
          {writer.signaturePhrase}
        </p>
        <p class="text-base leading-relaxed text-ink/80 md:text-lg">{writer.publicBio}</p>
      </div>
    </div>
    </div>

    {writer.focusAreas && writer.focusAreas.length > 0 && (
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-burgundy/75">
          İmza alanları
        </p>
        {writer.focusAreas.map((area) => (
          <span class="rounded-full border border-burgundy/15 bg-white px-3 py-1 text-xs uppercase tracking-[0.18em] text-ink/70">
            {area}
          </span>
        ))}
      </div>
    )}
  </div>
</section>

{issuesWithWriter.length > 0 && (
  <section class="border-t border-burgundy/10 bg-white px-6 py-12 md:py-16">
    <div class="mx-auto max-w-5xl">
      <header class="mb-10 max-w-2xl">
        <p class="mb-2 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
          {magazineConfig.name} Sayılarında
        </p>
        <h2 class="font-serif text-3xl leading-tight text-ink md:text-4xl">
          {issuesWithWriter.length === 1
            ? 'Bir sayıda yer aldı'
            : `${issuesWithWriter.length} sayıda yer aldı`}
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-ink/65">
          Yazarın küratörlük, kapak dosyası ve sabit köşe imzasıyla göründüğü {magazineConfig.name.toLowerCase()} sayıları.
        </p>
      </header>

      <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
        {issuesWithWriter.map(({ issue, roles }) => {
          const issuePad = formatIssuePad(issue.number);
          return (
            <li>
              <a
                href={`/sayi/${issue.slug}`}
                class="group flex h-full flex-col overflow-hidden rounded-[32px] border border-burgundy/12 bg-white shadow-[0_22px_72px_-58px_rgba(44,22,28,0.30)] ring-1 ring-black/[0.04] transition hover:-translate-y-0.5 hover:border-gold/35 hover:bg-cream-soft/16 hover:shadow-[0_30px_90px_-62px_rgba(44,22,28,0.38)] focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
              >
                <div class="relative aspect-[3/4] w-full overflow-hidden">
                  <img
                    src={issue.coverImage.src}
                    alt={issue.coverImage.alt}
                    width="450"
                    height="600"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover object-center transition duration-700 group-hover:scale-[1.04]"
                  />
                  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1c1412]/55 via-[#1c1412]/15 to-transparent"></div>
                  <div class="absolute bottom-4 left-4 right-4 text-cream-soft">
                    <p class="text-[9px] font-semibold uppercase tracking-[0.32em] text-gold/95">
                      {magazineConfig.subtitle}
                    </p>
                    <p class="mt-1 font-serif text-3xl leading-none">{magazineConfig.name}</p>
                    <p class="mt-2 text-[9px] font-semibold uppercase tracking-[0.22em] text-cream-soft/85">
                      Sayı {issuePad} · {issue.monthYear}
                    </p>
                  </div>
                </div>
                <div class="relative flex flex-1 flex-col p-5">
                  <div class="pointer-events-none absolute inset-x-5 top-0 h-px bg-gradient-to-r from-transparent via-gold/50 to-transparent"></div>
                  <p class="mb-2 text-[10px] font-semibold uppercase tracking-[0.22em] text-gold">
                    {issue.theme}
                  </p>
                  <ul class="flex flex-wrap gap-1.5">
                    {roles.map((role) => (
                      <li>
                        <span class="inline-flex items-center rounded-full border border-burgundy/15 bg-white px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-[0.16em] text-burgundy/80">
                          {role}
                        </span>
                      </li>
                    ))}
                  </ul>
                  <span class="mt-4 text-xs font-semibold text-burgundy underline decoration-burgundy/40 underline-offset-4 transition group-hover:decoration-burgundy">
                    Sayıyı aç →
                  </span>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}

{curatedDossiers.length > 0 && (
  <section class="border-t border-burgundy/10 bg-white px-6 py-12 md:py-16">
    <div class="mx-auto max-w-4xl">
      <header class="mb-8">
        <p class="mb-2 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
          Küratörlüğünü Üstlendiği Dosyalar
        </p>
        <h2 class="font-serif text-3xl leading-tight text-ink md:text-4xl">
          {curatedDossiers.length === 1 ? 'Bir kapak dosyası' : `${curatedDossiers.length} kapak dosyası`}
        </h2>
      </header>
      <ul class="space-y-4">
        {curatedDossiers.map((d) => (
          <li>
            <a
              href={`/dosya/${d.slug}`}
              class="group flex items-start gap-5 rounded-[30px] border border-burgundy/12 bg-white p-6 shadow-[0_20px_64px_-54px_rgba(44,22,28,0.28)] ring-1 ring-black/[0.04] transition hover:-translate-y-0.5 hover:border-gold/35 hover:bg-cream-soft/16 hover:shadow-[0_28px_82px_-60px_rgba(44,22,28,0.34)] focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
            >
              <div class="min-w-0 flex-1">
                <p class="mb-2 text-[10px] font-semibold uppercase tracking-[0.24em] text-gold">
                  {d.kicker}
                </p>
                <h3 class="mb-2 font-serif text-2xl leading-snug text-ink group-hover:underline group-hover:decoration-burgundy/35">
                  {d.title}
                </h3>
                <p class="text-sm leading-relaxed text-ink/70">{d.lede}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

{writerArticles.length > 0 && (
  <section class="border-t border-burgundy/10 bg-white px-6 py-12 md:py-16">
    <div class="mx-auto max-w-4xl">
      <header class="mb-8">
        <p class="mb-2 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
          Eşik Sayılarındaki Yazıları
        </p>
        <h2 class="font-serif text-3xl leading-tight text-ink md:text-4xl">
          {writer.displayName}'ın imzalı yazıları
        </h2>
      </header>
      <ol class="space-y-5">
        {writerArticles.map((a, idx) => (
          <li>
            <a
              href={a.href}
              class="group flex items-start gap-5 rounded-[30px] border border-burgundy/12 bg-white p-6 shadow-[0_20px_64px_-54px_rgba(44,22,28,0.28)] ring-1 ring-black/[0.04] transition hover:-translate-y-0.5 hover:border-gold/35 hover:bg-cream-soft/16 hover:shadow-[0_28px_82px_-60px_rgba(44,22,28,0.34)] focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
            >
              <span class="shrink-0 font-serif text-3xl italic tabular-nums text-gold md:text-4xl">
                {String(idx + 1).padStart(2, '0')}
              </span>
              <div class="min-w-0 flex-1">
                <p class="mb-2 text-[10px] font-semibold uppercase tracking-[0.22em] text-burgundy/75">
                  {a.monthYear} · {a.dossierTitle}
                </p>
                <h3 class="mb-2 font-serif text-xl leading-snug text-ink group-hover:underline group-hover:decoration-burgundy/35 md:text-2xl">
                  {a.title}
                </h3>
                <p class="text-sm leading-relaxed text-ink/70">{a.excerpt}</p>
                {a.readingMinutes && (
                  <p class="mt-2 text-[11px] uppercase tracking-[0.2em] text-ink/55">
                    ~{a.readingMinutes} dakika
                  </p>
                )}
              </div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

{writerArticles.length === 0 && curatedDossiers.length === 0 && (
  <section class="border-t border-burgundy/10 bg-white px-6 py-12">
    <div class="mx-auto max-w-3xl text-center">
      <p class="font-serif text-lg italic leading-relaxed text-ink/70">
        {writer.displayName}, Eşik dergisinin önümüzdeki sayılarında okurla buluşuyor.
      </p>
      <a
        href="/library"
        class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-burgundy underline decoration-burgundy/40 underline-offset-4 transition hover:decoration-burgundy"
      >
        Kütüphanede tüm yazıları gör
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
)}
