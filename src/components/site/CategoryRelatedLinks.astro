---
/**
 * CategoryRelatedLinks — hub sayfalarının sonunda diğer 4 ana kategoriye
 * geçiş kartları. Mevcut kategori `exclude` ile hariç tutulur.
 *
 * 5 hub için tutarlı CTA. Hormonal Geçiş'in eski custom "İlgili Kategoriler"
 * bölümünün yerine bu component kullanılır.
 */

interface Category {
  name: string;
  href: string;
  description: string;
}

interface Props {
  /** Mevcut kategori path'i — listeden hariç tutulur. Örn. '/hormonal-gecis' */
  exclude: string;
  class?: string;
}

const { exclude, class: className } = Astro.props;

const allCategories: Category[] = [
  {
    name: 'Hormonal Geçiş',
    href: '/hormonal-gecis',
    description: 'Perimenopozdan menopoza geçiş sürecinin haritası.',
  },
  {
    name: 'Zamansız Yaşam',
    href: '/zamansiz-yasam',
    description: 'Vitaminler, deneysel ve ameliyatsız yaklaşımlar.',
  },
  {
    name: 'Beden & Yakınlık',
    href: '/beden-yakinlik',
    description: 'Bedensel değişimler, cinsel sağlık ve yakınlık.',
  },
  {
    name: 'Zihin & Denge',
    href: '/zihin-denge',
    description: 'Uyku, ruh hali, hafıza ve stres yönetimi.',
  },
  {
    name: 'Bilimsel Pencere',
    href: '/bilimsel-pencere',
    description: 'Uzman görüşleri ve araştırma özetleri.',
  },
];

const categories = allCategories.filter((c) => c.href !== exclude);
---

<aside
  class:list={[
    'rounded-[32px] border border-burgundy/12 bg-white p-8 shadow-sm ring-1 ring-black/5 md:p-10',
    className,
  ]}
  aria-labelledby="category-related-heading"
>
  <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
    İlgili Kategoriler
  </p>
  <h2
    id="category-related-heading"
    class="mb-6 font-serif text-3xl italic leading-tight text-burgundy-deep md:text-4xl"
  >
    Bilgi yollarına devam et
  </h2>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {categories.map((c) => (
      <a
        href={c.href}
        class="group flex flex-col rounded-2xl border border-burgundy/15 bg-cream-soft p-5 transition hover:border-burgundy/35 hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
      >
        <span class="mb-2 font-serif text-lg italic leading-tight text-burgundy-deep group-hover:underline group-hover:decoration-gold group-hover:underline-offset-4">
          {c.name}
        </span>
        <span class="text-xs leading-relaxed text-ink/75">
          {c.description}
        </span>
        <span
          class="mt-3 text-gold transition group-hover:translate-x-1"
          aria-hidden="true"
        >→</span>
      </a>
    ))}
  </div>
</aside>
