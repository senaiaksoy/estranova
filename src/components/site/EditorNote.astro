---
/**
 * Hassas konu makalelerinde (cinsel sağlık, idrar kaçırma, libido vs.)
 * yazı başında gösterilen küçük editör notu rozeti. "Doç. Dr. Senai Aksoy" geçici
 * yazar personası kullanıldığında devreye giriyor.
 *
 * Kullanım örneği:
 *   <EditorNote initials="S.A." />
 *   <EditorNote text="Bu yazıyı yazmak için kimse gönüllü olmadı..." initials="S.A." />
 */

interface Props {
  /** Rozet metni; varsayılanı esprili kurucusu notu */
  text?: string;
  /** İmza inisyalleri (sağ alt) */
  initials?: string;
}

const {
  text = 'Bu yazıyı yazmak için kimse gönüllü olmadı, ben yazdım.',
  initials = 'S.A.',
} = Astro.props;
---

<aside
  class="my-8 rounded-[20px] border border-gold/30 border-l-[4px] border-l-gold bg-white p-5 shadow-[0_18px_54px_-44px_rgba(44,22,28,0.22)] ring-1 ring-black/[0.04] md:p-6"
  aria-label="Editör notu"
>
  <p class="mb-1 text-xs font-bold uppercase tracking-[0.22em] text-primary">Editör notu</p>
  <p class="text-sm leading-relaxed text-ink/82 md:text-base">
    <em class="font-serif italic">{text}</em>
    <span class="ml-1 whitespace-nowrap text-gold-bronze">— {initials}</span>
  </p>
</aside>
