---
/**
 * Anasayfa "Bu Ayın Sayısı" hero kartı.
 *
 * Eşik dergisinin mevcut sayısını premium dergi-kapağı düzeninde
 * tanıtır: kapak görseli + sayı no + tarih + tema + lede + kapağa
 * bağlanan CTA. MonthlyDossierSection'ın ÜSTÜNE yerleşir; aralarındaki
 * fark "üst-kavram (sayı)" vs "alt-detay (kapak dosyası)" şeklinde.
 *
 * Faz 1: yalnızca görsel/sunum. Tüm CTA'lar nötr ("sayıyı oku" /
 * "yayını izle"); abonelik/paywall dili YASAK (bkz. CLAUDE.md §4 +
 * docs/paywall-policy.md).
 */

import type { Issue } from '../../data/issues';
import { resolveCoverDossier, getIssueReadingMinutes, formatIssuePad } from '../../data/issues';
import { magazineConfig } from '../../data/magazine-config';

interface Props {
  issue: Issue;
  /** Anasayfa numaralanmasında kullanılır (örn. "03") */
  sectionNumber?: string;
}

const { issue, sectionNumber = '03' } = Astro.props;

const coverDossier = resolveCoverDossier(issue);
const readingMinutes = getIssueReadingMinutes(issue);
const articleCount = coverDossier?.articles.length ?? 0;
const issueHref = `/sayi/${issue.slug}`;
const issuePad = formatIssuePad(issue.number);
---

<section class="relative isolate overflow-hidden border-t border-burgundy/10 bg-gradient-to-b from-[#fffaf0] via-cream-soft to-cream-warm px-6 py-16 md:py-24">
  <div class="pointer-events-none absolute -left-20 top-20 h-72 w-72 rounded-full bg-gold/12 blur-3xl"></div>
  <div class="pointer-events-none absolute right-0 top-1/3 hidden font-serif text-[12rem] leading-none tracking-[-0.08em] text-burgundy/5 lg:block">
    {issuePad}
  </div>
  <div class="mx-auto max-w-6xl">
    <header class="mb-12 grid gap-8 md:grid-cols-[0.72fr_1.28fr] md:items-end">
      <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
        <span class="font-serif font-normal tabular-nums text-gold">{sectionNumber}</span>
        <span class="mx-2 text-gold">—</span>
        Bu Ayın Sayısı
      </p>
      <div>
        <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.28em] text-gold">
          {magazineConfig.name} · Sayı {issuePad} · {issue.monthYear}
        </p>
        <h2 class="mb-4 font-serif text-5xl leading-[0.92] tracking-[-0.045em] text-burgundy md:text-7xl lg:text-8xl">
          {issue.theme}
        </h2>
        <p class="max-w-2xl text-lg leading-relaxed text-ink/75">{issue.lede}</p>
      </div>
    </header>

    <a
      href={issueHref}
      class="group relative grid overflow-hidden rounded-[38px] border border-burgundy/14 bg-white/76 shadow-2xl shadow-burgundy/10 ring-1 ring-white/70 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2 md:grid-cols-[0.48fr_0.52fr] md:items-stretch"
    >
      <span class="pointer-events-none absolute inset-x-8 top-0 z-10 h-px bg-gold/55"></span>
      <div class="relative aspect-[4/5] w-full shrink-0 overflow-hidden md:aspect-auto">
        <img
          src={issue.coverImage.src}
          alt={issue.coverImage.alt}
          width="800"
          height="1000"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover object-center transition duration-500 group-hover:scale-[1.03]"
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1c1412]/35 via-[#1c1412]/5 to-transparent"></div>
        {/* Kapak yazısı: dergi adı + sayı no */}
        <div class="absolute bottom-6 left-6 right-6 text-cream-soft">
          <p class="text-[10px] font-semibold uppercase tracking-[0.32em] text-gold/95">
            {magazineConfig.subtitle}
          </p>
          <p class="mt-1 font-serif text-5xl leading-none md:text-6xl lg:text-7xl">
            {magazineConfig.name}
          </p>
          <p class="mt-3 text-xs font-semibold uppercase tracking-[0.22em] text-cream-soft/85">
            Sayı {issuePad} · {issue.monthYear}
          </p>
        </div>
      </div>

      <div class="relative flex min-w-0 flex-1 flex-col justify-between border-t border-burgundy/12 p-8 md:border-l md:border-t-0 md:p-12 lg:p-14">
        <span class="pointer-events-none absolute right-8 top-8 font-serif text-6xl italic leading-none text-gold/12 md:text-8xl">
          {issuePad}
        </span>
        <div>
          <p class="mb-4 text-[10px] font-semibold uppercase tracking-[0.28em] text-gold">
            Bu sayıda
          </p>
          <h3 class="mb-5 font-serif text-4xl leading-[1.02] tracking-[-0.025em] text-ink md:text-5xl">
            {issue.coverHeadline}
          </h3>
          <p class="mb-8 font-serif text-xl italic leading-relaxed text-ink/70 md:text-2xl">
            {coverDossier?.lede ?? issue.lede}
          </p>
          {articleCount > 0 && (
            <p class="text-xs uppercase tracking-[0.2em] text-ink/55">
              <span>{articleCount} yazı</span>
              {readingMinutes > 0 && (
                <>
                  <span class="mx-2 text-gold">·</span>
                  <span>~{readingMinutes} dk okuma</span>
                </>
              )}
            </p>
          )}
        </div>
        <div class="mt-8">
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-burgundy underline decoration-burgundy/40 underline-offset-4 transition group-hover:decoration-burgundy">
            Sayıyı oku
            <span aria-hidden="true">→</span>
          </span>
        </div>
      </div>
    </a>

    <div class="mt-6 flex justify-end">
      <a
        href="/sayi"
        class="text-sm font-semibold text-burgundy underline decoration-burgundy/40 underline-offset-4 transition hover:decoration-burgundy focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
      >
        Tüm sayılar →
      </a>
    </div>
  </div>
</section>
