---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuHero from '../../components/site/SubmenuHero.astro';
import SubmenuLinkCard from '../../components/site/SubmenuLinkCard.astro';
import SubmenuSection from '../../components/site/SubmenuSection.astro';
import SubmenuSpotlightCard from '../../components/site/SubmenuSpotlightCard.astro';
import CategoryRelatedLinks from '../../components/site/CategoryRelatedLinks.astro';
import Evidence from '../../components/site/Evidence.astro';
import ChapterMasthead from '../../components/site/ChapterMasthead.astro';
import EditorialEpigraph from '../../components/site/EditorialEpigraph.astro';
import ChapterCompass from '../../components/site/ChapterCompass.astro';
import { submenuHeroByRoute } from '../../data/submenu-heroes';
import { subHubEpigraphs } from '../../data/sub-hub-epigraphs';

const hero = submenuHeroByRoute['/beden-yakinlik']!;
const __hubPath = '/beden-yakinlik';
const epigraph = subHubEpigraphs[__hubPath];

const pillars = [
  {
    step: '01',
    title: 'Cilt & Görünüm',
    excerpt: 'Kollajen, nem ve cilt bariyerindeki hormonal değişimler; günlük bakım ve klinik destekler için sade bir okuma çerçevesi.',
    href: '/beden-yakinlik/cilt-gorunum',
    image: submenuHeroByRoute['/beden-yakinlik/cilt-gorunum']!,
  },
  {
    step: '02',
    title: 'Cinsel Sağlık',
    excerpt: 'Vajinal kuruluk, cinsellikte ağrı ve libido değişimleri — en az konuşulan ama en sık yaşanan başlıklara mahremiyetinizi yargılamayan bir yaklaşım.',
    href: '/beden-yakinlik/cinsel-saglik',
    image: submenuHeroByRoute['/beden-yakinlik/cinsel-saglik']!,
  },
  {
    step: '03',
    title: 'Pelvik Taban',
    excerpt: 'İdrar kontrolü, duruş ve pelvik kasların menopozdaki değişimi; egzersiz ve davranışsal stratejiler için pratik rehberler.',
    href: '/beden-yakinlik/pelvik-taban',
    image: submenuHeroByRoute['/beden-yakinlik/pelvik-taban']!,
  },
];
---

<SiteLayout
  title="Beden & Yakınlık - Estranova"
  description="Menopoz döneminde bedeniniz, cinsel sağlığınız ve cinsel yaşamniz hakkında bilimsel bilgi ve rehberlik."
>
  <SiteNavbar currentPath="/beden-yakinlik" />

  <ChapterMasthead variant="section" chapter="Beden & Yakınlık" />

  <main id="main-content" class="text-[#2D2D2D]">
    <SubmenuHero
      eyebrow="Kategori"
      title="Beden & Yakınlık"
      lede="Menopoz döneminde bedeniniz, cinsel sağlığınız ve cinsel yaşamniz hakkında bilimsel bilgi ve rehberlik. Bu bölüm, değişen beden deneyimini yargılamadan ele alır."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />
    <SubmenuSection variant="cream" borderedTop={true}>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
        {
          pillars.map((p) => (
            <SubmenuLinkCard
              href={p.href}
              title={p.title}
              excerpt={p.excerpt}
              imageSrc={p.image.src}
              imageAlt={p.image.alt}
              step={p.step}
            />
          ))
        }
      </div>
    </SubmenuSection>

    {epigraph && <EditorialEpigraph quote={epigraph} />}

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">Öne Çıkanlar</p>
        <h2 class="mb-4 font-serif text-4xl leading-tight md:text-5xl">Öne Çıkan İçerikler</h2>
        <p class="text-lg leading-relaxed text-[#2D2D2D]/75">
          Beden ve yakınlık temalarını zarif ve bilimsel bir dille ele alan örnek içerikler.
        </p>
      </header>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <SubmenuSpotlightCard
          tag="Cinsel Sağlık"
          title="Menopozda Cinsellikte Ağrı"
          body="Cinsel ilişki sırasında konforu etkileyen değişimleri ve destekleyici yaklaşımları ele alan rehber."
          href="/beden-yakinlik/cinsel-saglik/cinsellikte-agri-menopoz"
        >
          <span slot="footer">Kanıt Düzeyi: <Evidence level={4} /></span>
        </SubmenuSpotlightCard>
        <SubmenuSpotlightCard
          highlight={true}
          tag="Pelvik Taban"
          title="İdrar Kontrolü ve Pelvik Taban"
          body="Pelvik taban kaslarını destekleyen pratikler ve kontinans değişimlerine kanıt-temelli yaklaşım."
          href="/beden-yakinlik/pelvik-taban/menopozda-idrar-kacirma-pelvik-taban"
        >
          <span slot="footer">Kanıt Düzeyi: <Evidence level={4} /></span>
        </SubmenuSpotlightCard>
        <SubmenuSpotlightCard
          tag="Cilt"
          title="Menopozda Cilt Değişimleri"
          body="Kollajen kaybı, kuruluk ve elastikiyet değişimlerini bilimsel çerçevede ele alan başlangıç rehberi."
          href="/beden-yakinlik/cilt-gorunum/menopozda-cilt-degisimleri"
        >
          <span slot="footer">Kanıt Düzeyi: <Evidence level={4} /></span>
        </SubmenuSpotlightCard>
      </div>
    </SubmenuSection>

    <SubmenuSection variant="sand" borderedTop={true}>
      <CategoryRelatedLinks exclude="/beden-yakinlik" />
    </SubmenuSection>

    <ChapterCompass nextHref="/beden-yakinlik/cilt-gorunum" nextNumber="01" nextChapter="Cilt & Görünüm" nextParent="Beden & Yakınlık" />
  </main>

  <SiteFooter />
</SiteLayout>
