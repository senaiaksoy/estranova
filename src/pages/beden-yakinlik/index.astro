---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuHero from '../../components/site/SubmenuHero.astro';
import SubmenuLinkCard from '../../components/site/SubmenuLinkCard.astro';
import SubmenuSection from '../../components/site/SubmenuSection.astro';
import SubmenuSpotlightCard from '../../components/site/SubmenuSpotlightCard.astro';
import { submenuHeroByRoute } from '../../data/submenu-heroes';

const hero = submenuHeroByRoute['/beden-yakinlik']!;
const img = {
  yakin: submenuHeroByRoute['/beden-yakinlik/yakinlik-agrisi-menopoz']!,
  vajinal: submenuHeroByRoute['/beden-yakinlik/vajinal-saglik-menopoz']!,
  cilt: submenuHeroByRoute['/beden-yakinlik/menopozda-cilt-degisimleri']!,
};

const pillars = [
  {
    step: '01',
    title: 'Menopoz ve Cinsel Sağlık',
    excerpt: 'Yakınlık deneyimindeki değişimleri bilimsel çerçevede anlamaya yardımcı içerikler.',
    href: '/beden-yakinlik/yakinlik-agrisi-menopoz',
    image: img.yakin,
  },
  {
    step: '02',
    title: 'Vajinal Sağlık ve Değişimler',
    excerpt: 'Kuruluk, konfor ve doku değişimlerini sade bir dille açıklayan rehberler.',
    href: '/beden-yakinlik/vajinal-saglik-menopoz',
    image: img.vajinal,
  },
  {
    step: '03',
    title: 'Libido ve Hormonlar',
    excerpt: 'İstek düzeyini etkileyen hormonal, psikolojik ve yaşam tarzı etmenlerine bütüncül bakış.',
    href: '/beden-yakinlik/vajinal-saglik-menopoz',
    image: img.vajinal,
  },
  {
    step: '04',
    title: 'İlişki Dinamikleri ve İletişim',
    excerpt: 'Eşler arası iletişim, karşılıklı anlayış ve güvenli ifade yolları üzerine içerikler.',
    href: '/beden-yakinlik/yakinlik-agrisi-menopoz',
    image: hero,
  },
  {
    step: '05',
    title: 'Beden Algısı ve Özgüven',
    excerpt: 'Bedensel değişimlere uyum, öz-şefkat ve güven duygusunu güçlendiren yaklaşımlar.',
    href: '/beden-yakinlik/menopozda-cilt-degisimleri',
    image: img.cilt,
  },
];
---

<SiteLayout
  title="Beden & Yakınlık - Estranova"
  description="Menopoz döneminde bedeniniz, cinsel sağlığınız ve yakınlık ilişkileriniz hakkında bilimsel bilgi ve rehberlik."
>
  <SiteNavbar currentPath="/beden-yakinlik" />

  <main id="main-content" class="text-[#2D2D2D]">
    <SubmenuHero
      eyebrow="Kategori"
      title="Beden & Yakınlık"
      lede="Menopoz döneminde bedeniniz, cinsel sağlığınız ve yakınlık ilişkileriniz hakkında bilimsel bilgi ve rehberlik. Bu bölüm, değişen beden deneyimini yargılamadan ele alır."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />
    <SubmenuSection variant="cream" borderedTop={true}>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
        {
          pillars.map((p) => (
            <SubmenuLinkCard
              href={p.href}
              title={p.title}
              excerpt={p.excerpt}
              imageSrc={p.image.src}
              imageAlt={p.image.alt}
              step={p.step}
            />
          ))
        }
      </div>
    </SubmenuSection>

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">Öne Çıkanlar</p>
        <h2 class="mb-4 font-serif text-4xl leading-tight md:text-5xl">Öne Çıkan İçerikler</h2>
        <p class="text-lg leading-relaxed text-[#2D2D2D]/75">
          Beden ve yakınlık temalarını zarif ve bilimsel bir dille ele alan örnek içerikler.
        </p>
      </header>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <SubmenuSpotlightCard
          tag="Cinsel Sağlık"
          title="Menopoz Döneminde Konforu Desteklemek"
          body="Yakınlık sırasında konforu etkileyen değişimleri anlamaya yönelik temel bir rehber."
          href="/beden-yakinlik/yakinlik-agrisi-menopoz"
        />
        <SubmenuSpotlightCard
          highlight={true}
          tag="İlişki"
          title="İletişimde Güvenli Alan Kurmak"
          body="Duyguları açıkça ifade etmeyi ve karşılıklı anlayışı güçlendirmeyi amaçlayan yaklaşım notları."
          href="/beden-yakinlik/yakinlik-agrisi-menopoz"
        />
        <SubmenuSpotlightCard
          tag="Beden Algısı"
          title="Özgüven ve Bedensel Uyum"
          body="Beden algısındaki değişimleri yargılamadan ele alan, destekleyici bir başlangıç içeriği."
          href="/beden-yakinlik/menopozda-cilt-degisimleri"
        />
      </div>
    </SubmenuSection>
  </main>

  <SiteFooter />
</SiteLayout>
