---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuHero from '../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../components/site/SubmenuArticleBody.astro';
import ArticleTOC from '../../components/site/ArticleTOC.astro';
import ArticleAuthorBlock from '../../components/site/ArticleAuthorBlock.astro';
import ArticleProsePanel from '../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../components/site/ArticleSummary.astro';
import RelatedReadings from '../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../components/site/ArticleFAQ.astro';
import Evidence from '../../components/site/Evidence.astro';
import { submenuHeroByRoute } from '../../data/submenu-heroes';
import { buildArticleSchemas } from '../../utils/article-schema';
import { articleFaqs } from '../../data/article-faqs';
import { resolveSiteUrl } from '../../utils/seo';

const pathname = '/beden-yakinlik/menopoz-sonrasi-genital-estetik/';
// Makale üst hero görseli parent hub'dan gelir; özel makale görseli verilirse yalnızca
// ArticleAuthorBlock ve articleCardImageByRoute yüzeylerine ayrıca bağlanır.
const hero = submenuHeroByRoute['/beden-yakinlik/']!;
const articleTitle = 'Menopoz Sonrası Genital Estetik: Her Değişim Ameliyat Gerektirir mi?';
const seoTitle = 'Menopoz Sonrası Genital Estetik';
const articleDescription =
  'Op. Dr. Çağrı Sade, menopoz sonrası genital bölge değişimlerini görünüm kaygısına sıkıştırmadan; konfor ve cerrahi dışı seçenekleri sakin anlatıyor.';
const publishedDate = '29 Haziran 2026';
const readingMinutes = 7;
const articleImage = '/images/library/editorial/cagri-sade-menopoz-sonrasi-genital-estetik.webp';
const bylineImage = '/images/library/editorial/cagri-sade-menopoz-sonrasi-genital-estetik-byline.webp';

const tocEntries = [
  { id: 'degisim-cerrahi-degil', label: 'Her Değişim Cerrahi Değil' },
  { id: 'genital-bolge', label: 'Genital Bölge Nasıl Etkilenir?' },
  { id: 'labioplasti', label: 'Labioplasti Ne Zaman Konuşulur?' },
  { id: 'hacim-kaybi', label: 'Hacim Kaybı Ayrı Bir Başlık' },
  { id: 'cerrahi-disinda', label: 'Cerrahi Dışı Seçenekler' },
  { id: 'karar', label: 'Karar İçin Sorulacak Sorular' },
  { id: 'sonuc', label: 'Sonuç Olarak' },
  { id: 'kaynaklar', label: 'Kaynaklar' },
  { id: 'sss', label: 'Sık Sorulanlar' },
];

const faqItems = articleFaqs[pathname] ?? [];
const siteUrl = resolveSiteUrl(Astro.site);
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'cagri-sade',
  articleType: 'clinical-guide',
  publishedDate,
  modifiedDate: '14 Ekim 2026',
  pathname,
  articleSection: 'Beden & Yakınlık',
  sectionPath: '/beden-yakinlik/',
  image: articleImage,
  keywords: [
    'menopoz sonrası genital estetik',
    'labioplasti',
    'genital bölge değişimleri',
    'menopozda mahrem bölge',
    'genital konfor',
    'labium minus',
    'labium majus',
    'cerrahi karar süreci',
    '40 sonrası beden farkındalığı',
  ],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  image={articleImage}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/beden-yakinlik/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Beden & Yakınlık · Mahrem Konfor"
      title={articleTitle}
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="cagri-sade"
        articleType="clinical-guide"
        publishedDate={publishedDate}
        lastUpdated="14 Ekim 2026"
        readingMinutes={readingMinutes}
        imageSrc={bylineImage}
        imageAlt="Gün ışığı alan odada ayna ve keten perdeler yanında duran, elini karnına koymuş kadın"
        imagePosition="center top"
      />

      <ArticleSummary title="Kısa Klinik Yanıt">
        <p>
          Menopoz sonrası genital bölgede doku incelmesi, hassasiyet veya hacim kaybı görülebilir.
          Görünüm değişikliği tek başına ameliyat gerektirmez. Kuruluk, yanma ve ilişki sırasında ağrı varsa
          önce neden araştırılır; nemlendiriciler, kayganlaştırıcılar ve uygun kişide lokal hormonal tedaviler
          değerlendirilebilir <Evidence level={4} /><sup><a href="#kaynak-1" aria-label="Kaynak 1">[1]</a></sup>.
          Labioplasti ve yağ aktarımı farklı amaçları olan cerrahi işlemlerdir; olası yararları kadar riskleri
          ve kanıt sınırları da konuşulmalıdır. Yeni yara, kitle, geçmeyen kaşıntı veya menopoz sonrası kanama
          ise estetik bir karar beklerken ertelenmemesi gereken değerlendirme nedenleridir.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="degisim-cerrahi-degil">Mahrem Bölgedeki Her Değişim Ameliyat Anlamına Gelmez</h2>
        <p>
          Menopoz denildiğinde çoğu kadının aklına sıcak basması, uykusuzluk veya cilt değişimleri gelir.
          Oysa hormonlardaki değişim, bedenin en az konuşulan bölgelerinde de zamanla hissedilebilir.
        </p>
        <p>
          İç çamaşırının sürtmesi, bisiklette rahatsızlık veya ilişki sırasında ağrı, görünüm kaygısından
          farklı sorular doğurur. Sizin için değişen şeyin ne olduğunu anlatmak, görüşmenin başlangıcı olabilir.
        </p>
        <p>
          Bu konuyu açarken çekinmeniz anlaşılır. Sorunuzu anlatmak için utanmanız veya önce bir işlem
          adı öğrenmeniz gerekmiyor.
        </p>
        <p>
          Böyle anlarda benim için en doğru tempo, konuyu hemen bir işlem adına bağlamamaktır.
          <em>“Ne zamandır fark ediyorsunuz, hangi hareketlerde rahatsız ediyor?”</em> Bu sorular,
          görünüm isteğiyle fiziksel yakınmayı ayırmaya yardımcı olur.
        </p>

        <h2 id="genital-bolge">Menopoz Genital Bölgeyi Nasıl Etkileyebilir?</h2>
        <p>
          Östrojen azalması vajina ve dış genital bölgeyi, yani vulvayı etkileyebilir.
          Siz bu değişimi kuruluk veya dokunmaya hassasiyet olarak fark edebilirsiniz.
        </p>
        <p>
          Doku incelmesi ve elastikiyet azalması, bazı kadınlarda sürtünme ve ilişki sırasında rahatsızlığa
          eşlik eder <Evidence level={4} /><sup><a href="#kaynak-1" aria-label="Kaynak 1">[1]</a></sup>.
          Vulvanın şekli, büyüklüğü ve rengi kişiden kişiye değişir. Küçük dudakların büyük dudakların
          dışına uzanması da tek başına bir bozukluk sayılmaz<sup><a href="#kaynak-2" aria-label="Kaynak 2">[2]</a></sup>.
        </p>
        <p>
          Yeni yara, kitle, geçmeyen kaşıntı veya belirgin yeni cilt değişikliği varsa hekim değerlendirmesi
          alın. Bunların farklı nedenleri olabilir; yalnızca menopozla açıklanmamalıdır<sup><a href="#kaynak-4" aria-label="Kaynak 4">[4]</a></sup>.
          Menopozdan sonra kanama, az miktarda veya tek seferlik olsa bile araştırılmalıdır<sup><a href="#kaynak-5" aria-label="Kaynak 5">[5]</a></sup>.
        </p>
        <h2 id="labioplasti">Labioplasti Ne Zaman Gündeme Gelebilir?</h2>
        <p>
          Labioplasti küçük dudakların (labia minora) boyutunu veya şeklini değiştiren bir ameliyattır.
          Sizin için değerlendirilirken, hangi yakınmayı hedeflediği açık olmalıdır.
        </p>
        <p>
          Spor veya kıyafet sırasında çekilme ve sürtünme gibi fiziksel yakınmalar değerlendirmeye alınabilir.
          Muayenede bu yakınmanın anatomiden mi, cilt hastalığı veya başka bir nedenden mi kaynaklandığı araştırılır.
          Beklenen yarar, yakınmanın nedeni ve işlemin riskleriyle birlikte değerlendirilir<sup><a href="#kaynak-2" aria-label="Kaynak 2">[2]</a></sup>.
        </p>
        <p>
          Cerrahi işlem kesi ve iyileşme süreci içerir. Ağrı, kanama, enfeksiyon, iz, dokuların birbirine
          yapışması, his değişikliği, ilişki sırasında ağrı ve yeniden ameliyat gereksinimi gibi riskler
          konuşulmalıdır<sup><a href="#kaynak-2" aria-label="Kaynak 2">[2]</a></sup>.
        </p>
        <p>
          Kozmetik genital cerrahinin yarar ve güvenliğini değerlendiren yüksek kaliteli veriler sınırlıdır
          <Evidence level={2} /><sup><a href="#kaynak-2" aria-label="Kaynak 2">[2]</a></sup>.
          <em>“Bu işlem benim hangi yakınmamı gidermeyi amaçlıyor?”</em> Yanıtı, olası yararlarla riskleri
          birlikte tartışabilmeniz için yeterince somut olmalıdır.
        </p>

        <h2 id="hacim-kaybi">Bazen Sorun Sarkmadan Çok Hacim Kaybıdır</h2>
        <p>
          Menopoz sonrası dönemde bazı kadınlarda büyük dudaklarda (labia majora) hacim kaybı fark edilebilir. Bölge
          daha içe çekilmiş, daha az dolgun veya kişinin alışık olduğu görünümden farklı hale gelebilir.
        </p>
        <p>
          Bu başlık labioplastiden ayrıdır. Küçük dudakların boyutunu değiştirmek ile büyük dudaklara hacim
          kazandırmak farklı işlemlerdir. Görünüm farkının sizi rahatsız edip etmediği ve eşlik eden fiziksel
          yakınma bulunup bulunmadığı ayrıca değerlendirilir.
        </p>
        <p>
          Kişinin kendi yağ dokusunun alınarak büyük dudaklara aktarılması, hacim kazandırmayı amaçlayan
          cerrahi bir girişimdir. Cerrahi dışı bakım seçeneği olarak düşünülmemelidir. Aktarılan yağın bir kısmı
          zamanla azalabilir; sonuç ve iyileşme kişiden kişiye değişir.
        </p>
        <p>
          Bu alandaki çalışmalar az sayıda ve çoğunlukla gözlemseldir. Özellikle menopoz sonrası kadınlara
          özgü uzun dönem yarar ve güvenlik verileri sınırlıdır <Evidence level={2} /><sup><a href="#kaynak-3" aria-label="Kaynak 3">[3]</a></sup>.
        </p>

        <h2 id="cerrahi-disinda">Cerrahi Her Zaman İlk Seçenek Değildir</h2>
        <p>
          Kuruluk, yanma veya ilişki sırasında ağrı yaşıyorsanız ilk adım jinekolojik değerlendirmedir.
          Tedavi, yakınmanın nedenine göre seçilir.
        </p>
        <p>
          Menopoza bağlı doku değişimlerinin yanında enfeksiyon, cilt hastalığı veya pelvik taban kaslarındaki
          gerginlik de araştırılabilir. Nemlendiriciler, ilişki sırasında kayganlaştırıcılar ve uygun kişide
          düşük doz lokal vajinal östrojen gibi hormonal seçenekler değerlendirilir. Bu seçeneklerin her
          belirtiye etkisi ve kanıt gücü aynı değildir <Evidence from={3} to={4} /><sup><a href="#kaynak-1" aria-label="Kaynak 1">[1]</a></sup>.
        </p>
        <p>
          Enerji bazlı uygulamalar, yani lazer ve radyofrekans, deneysel seçeneklerdir.
          Mevcut kanıt, menopoza bağlı genital yakınmalar için kullanımlarını desteklemiyor;
          bu, kesin etkisiz oldukları anlamına gelmez <Evidence from={1} to={2} />. Araştırma dışında deneysel
          kabul edilirler. Önerildiklerinde belirsizlik, olası zararlar ve alternatifler hakkında bilgi isteyin<sup><a href="#kaynak-1" aria-label="Kaynak 1">[1]</a></sup>.
        </p>

        <h2 id="karar">Karar İçin Sorulacak Sorular</h2>
        <p>
          Görüşmeye, günlük hayatınızda sizi zorlayan şeyi anlatarak başlayabilirsiniz.
          Kıyafet sürtünmesiyle ilişki sırasında ağrı farklı değerlendirmeler gerektirebilir.
        </p>
        <p>
          Genel sağlık durumu, diyabet, dolaşım sorunları, sigara kullanımı, ilaçlar, yara iyileşmesi,
          enfeksiyon eğilimi ve cinsel ağrı öyküsü değerlendirmede önem taşır. Menopoz durumu, bu kişisel
          etkenlerin yerini tutmaz.
        </p>
        <p>
          Görüşmeye hazırlık için uzun bir listeye gerek yok. Şu sorular çoğu zaman konuşmayı doğru yere taşır:
        </p>
        <ul>
          <li>Rahatsızlık yalnızca görüntüyle mi ilgili, yoksa fiziksel konforu da etkiliyor mu?</li>
          <li>Sürtünme, ağrı, tahriş veya oturma-spor sırasında belirgin yakınma var mı?</li>
          <li>Kuruluk, yanma veya ilişki sırasında ağrı gibi jinekolojik değerlendirme isteyen belirtiler eşlik ediyor mu?</li>
          <li>Bu karar kendi beden konforumdan mı geliyor, yoksa dışarıdan gelen yorumlardan mı?</li>
          <li>Cerrahi dışı seçenekler gerçekten değerlendirilmiş mi?</li>
          <li>Önerilen işlemin olası yararları, riskleri ve iyileşme süreci neler?</li>
        </ul>
        <p>
          Bu soruların yanıtları, sizin beklentinizle işlemin sağlayabileceği değişimin uyuşup uyuşmadığını
          görmenize yardımcı olur. Görünümünüz hakkındaki dış yorumlar bir tıbbi gereklilik oluşturmaz.
        </p>

        <h2 id="sonuc">Sonuç Olarak</h2>
        <p>
          Mahrem bölgenizde fark ettiğiniz değişimi anlatabilirsiniz.
          Utanmanız veya hemen bir işlem kararı vermeniz gerekmiyor.
        </p>
        <p>
          Bir sonraki adım, değişimin ne zaman başladığını ve hayatınızı nasıl etkilediğini anlatmaktır.
          Böylece görüşme, sizin asıl sorunuza odaklanabilir. Yeni yara veya kanama gibi belirtiler varsa
          değerlendirmeyi ertelemeyin.
        </p>
        <h2 id="kaynaklar">Kaynaklar ve İleri Okuma</h2>
        <p>Metindeki numaralar, ilgili bilginin dayandığı kılavuz ve araştırmalara yönlendirir.</p>
        <ol>
          <li id="kaynak-1">AUA/SUFU/AUGS. Menopozun genitoüriner sendromu kılavuzu, 2025. Tedavi seçenekleri ve enerji bazlı uygulamalar.
            <a href="https://www.auanet.org/documents/Guidelines/PDF/2025%20Guidelines/GSM%20Unabridged%202025.pdf" target="_blank" rel="noopener noreferrer">Kılavuzun tam metni</a>.</li>
          <li id="kaynak-2">ACOG. Elektif kadın genital kozmetik cerrahisi, Komite Görüşü 795. Obstet Gynecol. 2020. Anatomik çeşitlilik, klinik endikasyonlar, kanıt sınırları ve cerrahi riskleri.
            <a href="https://pubmed.ncbi.nlm.nih.gov/31856125/" target="_blank" rel="noopener noreferrer">PMID: 31856125</a>.
            <a href="https://www.acog.org/womens-health/faqs/vaginal-rejuvenation-labiaplasty-and-other-female-genital-cosmetic-surgery" target="_blank" rel="noopener noreferrer">Hasta bilgilendirme sayfası</a>.</li>
          <li id="kaynak-3">Jabbour S ve ark. Büyük dudaklara hacim kazandırılması: sistematik derleme. Aesthet Surg J. 2017;37(10):1157–1164. Az sayıda, çoğunlukla gözlemsel çalışma; menopoz sonrası kadınlara özgü güçlü sonuç kanıtı sağlamaz.
            <a href="https://pubmed.ncbi.nlm.nih.gov/28449124/" target="_blank" rel="noopener noreferrer">PMID: 28449124</a>.</li>
          <li id="kaynak-4">NHS. Vulva kanserinde değerlendirme gerektiren belirtiler. 2025. Bu belirtiler farklı nedenlerle de görülebilir.
            <a href="https://www.nhs.uk/conditions/vulval-cancer/symptoms/" target="_blank" rel="noopener noreferrer">Belirti bilgisi</a>.</li>
          <li id="kaynak-5">NHS. Menopoz sonrası kanama. 2026 güncellemesi.
            <a href="https://www.nhs.uk/symptoms/post-menopausal-bleeding/" target="_blank" rel="noopener noreferrer">Kanama değerlendirmesi</a>.</li>
        </ol>
      </ArticleProsePanel>

      <ArticleFAQ
        id="sss"
        class="mt-10"
        items={faqItems}
        title="Bu Yazıdan Sonra Akla Gelen Sorular"
        intro="Görünüm değişikliği, fiziksel yakınma ve işlem seçenekleri hakkında kısa yanıtlar. Ayrıntılar ve kaynaklar ilgili bölümlerde yer alıyor."
      />

      <RelatedReadings
        class="mt-10"
        paths={[
          '/beden-yakinlik/cinsel-saglik/mahrem-bolge-degisimleri-menopoz/',
          '/beden-yakinlik/cinsel-saglik/cinsellikte-agri-menopoz/',
          '/beden-yakinlik/meme-kucultme-menopoz-sonrasi-beden-konforu/',
        ]}
      />

      <ArticleEditorNote class="mt-10" reviewerForWriter="cagri-sade">
        <p>
          Menopoz sonrası genital bölge değişimleri; vulvovajinal doku sağlığı, cilt-elastikiyet değişimi,
          irritasyon, cinsel ağrı, pelvik taban ve kişisel anatomi başlıklarıyla birlikte okunmalıdır.
          Cerrahi seçenekler yalnızca görünüm kaygısı üzerinden değil; fiziksel rahatsızlık, sağlık zemini,
          beklenti yönetimi ve cerrahi dışı seçeneklerin yeri görüldükten sonra konuşulmalıdır.
        </p>
        <p>
          Bu yazı işlem önerisi, sonuç vaadi veya yönlendirici tedavi metni değildir. Amaç; okurun mahrem
          bölge değişimlerini utanmadan, ama aceleci karar diline de kapılmadan değerlendirmesine yardımcı olmaktır.
        </p>
      </ArticleEditorNote>

      <ArticleDisclaimer class="mt-10">
        <p>Bu içerik genel bilgilendirme içindir; bireysel tıbbi değerlendirme, tanı veya tedavinin yerini almaz.
          Yakınmalarınızın nedeni ve size uygun seçenekler, tıbbi öykünüz ve muayene bulgularınızla birlikte değerlendirilir.</p>
      </ArticleDisclaimer>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
