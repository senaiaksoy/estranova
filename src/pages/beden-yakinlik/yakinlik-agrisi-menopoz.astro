---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuHero from '../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../components/site/ArticleAuthorBlock.astro';
import ArticleProsePanel from '../../components/site/ArticleProsePanel.astro';
import { submenuHeroByRoute } from '../../data/submenu-heroes';

const hero = submenuHeroByRoute['/beden-yakinlik/yakinlik-agrisi-menopoz']!;
---

<SiteLayout
  title="Yakınlık Sırasında Ağrı — Menopozda Dispareuniya Rehberi — Estranova"
  description="Menopozda yakınlık sırasında ağrı veya rahatsızlığın nedenleri ve tedavi seçenekleri hakkında kapsamlı rehberlik."
>
  <SiteNavbar currentPath="/beden-yakinlik" />

  <main id="main-content" class="text-[#2D2D2D]">
    <SubmenuHero
      eyebrow="Beden & Yakınlık · Yakınlık sağlığı"
      title="Yakınlık Sırasında Ağrı — Menopozda Dispareuniya Rehberi"
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <SubmenuArticleBody>
        <ArticleAuthorBlock authorSlug="berna-aksoy" publishedDate="14 Nisan 2026" readingMinutes={7} />

        <section class="rounded-[28px] border border-[#C9A96E]/35 bg-gradient-to-br from-white to-[#FDF8F0]/90 p-7 shadow-sm ring-1 ring-[#C9A96E]/22 md:p-8">
          <h2 class="mb-4 font-serif text-3xl">Kısa Özet</h2>
          <p class="leading-relaxed text-[#2D2D2D]/80">
            Menopozda yakınlık sırasında ağrı veya rahatsızlık yaygındır ve çoğunlukla tedavi edilebilir. Vajinal kuruluk, doku esnekliğinde kayıp ve psikolojik faktörler birleşir. Bilgilendirme ve tedavi seçenekleri yakınlık deneyimini yeniden mümkün kılar.
          </p>
        </section>

        <ArticleProsePanel>
          <h2>Dispareuniya Tanımı ve Yaygınlığı</h2>
          <p>
            Dispareuniya, yakınlık sırasında hissedilen ağrı veya rahatsızlıktır; çok yaygındır [●●●●●].
            Postmenopoz kadınlarının 20-40%'ı bu sorunu yaşar [●●●●●]. Ağrı yüzeysel (giriş bölgesinde) veya derininde (iç bölgede) oluşabilir [●●●●●].
            Fiziksel ağrının ötesinde psikolojik etkiler vardır: kaygı ("ağrı olacağından endişe"), depresyon, ilişkilerde çatışma ve kendine güven kaybı [●●●●○].
          </p>
          <p>
            Ancak bu tamamen normal değildir ve tedavi edilebilir. Konuşmasının tabu olması, birçok kadının yalnız hissetmesine neden olmuştur.
            Aslında bu, menopozun yaygın ve yönetilebilir bir yönüdür.
          </p>

          <h2>Fizyolojik Nedenler</h2>
          <p>
            Birincil neden, östrojen azalmasına bağlı vajinal kuruluktur [●●●●●].
            Menopozda östrojen düşüşü, vajinal dokunun incelmesine, elastikiyet kaybına ve kolajen üretiminin azalmasına yol açar.
            Bu duruma "vulvovajinal atrofi" denir. Yağlayıcı üretimi azalır; doğal nem yoktur.
          </p>
          <p>
            Doku elastisitesi kaybı esnekliği sınırlandırır ve travma riskini artırır [●●●●●].
            Ayrıca, pH değişimi (daha alkalin) [●●●●●] doğal mikrobiyota dengesini etkiler ve enfeksiyonlara yatkınlık artırabilir.
            Endometriosis, rahim fibroidleri, yumurtalık kistleri gibi tıbbi durumlar ağrıyı çoğaltabilir [●●●●●].
            Enfeksiyonlar (mantar enfeksiyonları, UTI) veya pelvik tutukluluk ek risk faktörleridir.
          </p>

          <h2>Psikolojik Faktörler</h2>
          <p>
            Beden imajında değişiklik ve özgüven azalması menopozda yaygındır [●●●●○].
            Yakınlık sırasında kaygı ve performans baskısı ağrıyı artırabilir [●●●●●].
            Partnerle iletişim sorunları veya ilişki dinamikleri stresi ışığlandırabilir [●●●●○].
            Geçmiş travma, cinsel istismar veya olumsuz yakınlık deneyimleri menopozda belirtileri ışığlandırabilir [●●●●○].
            Stres ve yaşamsal yük vücut gerginliğini artırır, kas spazması tetikler ve ağrı döngüsünü derinleştirir [●●●●●].
          </p>

          <h2>Non-Medikal Tedavi Seçenekleri</h2>
          <p>
            Diyalog ve eğitim ilk adımdır [●●●●●]. Partnerle açık konuşma, sorunun fiziksel olduğunu açıklama ve
            performans baskısının yoğunluğunu azaltma önemlidir. Belirsizlik ve utanç, durumu daha da zorlaştırır.
          </p>
          <p>
            Su bazlı veya silikon bazlı yağlayıcılar faydalıdır [●●●●●]. Yakınlık öncesi veya düzenli kullanım (haftada 2-3 kez) doku nemini destekler.
            Nemlendirici krem (örneğin hyaluronik asit) uzun vadeli iyileşmeyi destekler [●●●●●].
          </p>
          <p>
            Düzenli yakınlık, kan akışını artırır ve doku iyileşmesini destekler [●●●●●].
            Foreplay ve zaman ödün vermek (acele etmemek) doğal yağlayıcı üretimini teşvik eder [●●●●●].
            Mindful yaklaşım, beden farkındalığı ve rahatsızlığın normalleştirilmesi de önemlidir [●●●●○].
            İlişkide iletişimi iyileştirmek, stres azaltmak ve alternatif yakınlık biçimlerini keşfetmek daha fazla esneklik sağlar.
          </p>

          <h2>Tıbbi Tedavi Seçenekleri</h2>
          <p>
            Lokal (yerel) hormon tedavisi çoğunlukla etkilidir [●●●●●].
            Vajinal estradiol (tablet, halka, krem) doğrudan bölgeye uygulanır ve sistemi minimal şekilde etkiler.
            Lokal DHEA (prasterone) umut verici bir alternatiftir [●●●●●].
          </p>
          <p>
            Sistemik HRT (ağız veya yama yoluyla) genel tedavi amaçlı alınırsa, yan fayda olarak vajinal belirtileri de iyileştirebilir [●●●●●];
            ancak lokal tedavi genellikle daha etkilidir.
          </p>
          <p>
            Non-hormon lokal tedaviler (hyaluronik asit, gliserin) vardır [●●●●○].
            Ospemifene (oral SERM) vajinal belirtiler için FDA onaylı bir ilaçtır [●●●●○].
            Seçim, kişinin tıbbi geçmişi, tercihleri ve risk faktörlerine göre yapılmalıdır.
          </p>

          <h2>Partner Katılımı</h2>
          <p>
            Partner eğitimi menopozun etkileri, yakınlık fizyolojisi ve değişen ihtiyaçlar açısından önemlidir [●●●●●].
            Tedavi planına katılma (örneğin, yağlayıcı kullanmanın doğal ve normal olduğunu anlamak) uyumu artırır [●●●●●].
            Alternatif yakınlık formlarını (çok penetratif olmayan yakınlık biçimleri) keşfetmek alanı genişletir [●●●●●].
            Duygusal destek, sabır ve anlaşma, iyileşmenin temelini oluşturur [●●●●●].
          </p>

          <h2>Seks Terapist veya Jinekoloji Danışması</h2>
          <p>
            Fiziksel tedaviler başlatıldıktan sonra belirtiler devam ederse seks terapist danışması yardımcı olabilir [●●●●●].
            Jinekoloji konusunda uzmanlaşmış hekim, tıbbi seçenekleri değerlendirmek için gereklidir [●●●●●].
            Psikolojik boyutu ele alan bir terapist (psikolog, danışman) veya seks terapist, ilişki ve beden imajı üzerinde çalışmaya yardımcı olur.
          </p>

          <h2>Uzun Vadeli Perspektif</h2>
          <p>
            Bu ağrı, normal bir sağlık durumu değildir; tedavi edilebilir bir sorun olarak ele alınmalıdır [●●●●●].
            Yakınlık, yaşlılıkta da desteklenerek kalitatif ve doyurucu kalabilir [●●●●●].
            Yaşlılıkta sağlıklı yakınlık, kardiyovasküler sağlık, hormonal denge ve ruh halini destekler.
          </p>

          <h2>Başlamak İçin İlk Adımlar</h2>
          <p>
            Bu hafta, jinekoloğu ile randevu alın veya birinci basamak hekiminizle görüşün.
            Belirtilerinizi açıkça anlatın (utanç duymadan). Basit fiziksel muayene yapılabilir.
          </p>
          <p>
            Aynı zamanda su bazlı bir yağlayıcı satın alın ve yakınlık öncesi kullanımı başlayın.
            Partnerinizle duygu ve ihtiyaçlarınız hakkında açık konuşun. Birlikte çözüm bulmak, soruyu hafifletir.
            Tıbbi destek ve iletişim birlikte, yakınlık deneyimini yeniden güvenli ve doyurucu kılabilir.
          </p>
        </ArticleProsePanel>

        <section class="mt-14 rounded-[28px] border border-[#6B2D3E]/12 bg-[#FDF8F0] p-7 shadow-sm ring-1 ring-[#6B2D3E]/10 md:p-8">
          <h2 class="mb-5 font-serif text-3xl">İlgili İçerikler</h2>
          <ul class="space-y-3">
            <li><a href="/beden-yakinlik/vajinal-saglik-menopoz" class="font-semibold text-[#6B2D3E] hover:underline">Beden & Yakınlık / Vajinal Sağlık ve Menopoz</a></li>
            <li><a href="/zihin-denge/stres-yonetimi-menopoz" class="font-semibold text-[#6B2D3E] hover:underline">Zihin & Denge / Stres Yönetimi</a></li>
            <li><a href="/zihin-denge/ruh-hali-degisimleri-menopoz" class="font-semibold text-[#6B2D3E] hover:underline">Zihin & Denge / Ruh Hali Değişimleri</a></li>
            <li><a href="/hormonal-gecis/menopoz/menopoz-nedir" class="font-semibold text-[#6B2D3E] hover:underline">Hormonal Geçiş / Menopoz Nedir?</a></li>
            <li><a href="/beden-yakinlik/menopozda-cilt-degisimleri" class="font-semibold text-[#6B2D3E] hover:underline">Beden & Yakınlık / Cilt Değişimleri</a></li>
          </ul>
        </section>

        <section class="mt-14 rounded-[28px] border border-[#6B2D3E]/15 border-l-[6px] border-l-[#C9A96E] bg-gradient-to-r from-[#F5EDE0] to-[#FDF8F0] p-7 shadow-sm ring-1 ring-[#6B2D3E]/10 md:p-8">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.22em] text-[#6B2D3E]">Bilimsel Editör Notu · Doç. Dr. Senai Aksoy</p>
          <p class="mb-4 text-lg font-semibold text-[#2D2D2D]">Kanıt Düzeyi: A — Güçlü Kanıt ●●●●●</p>
          <p class="leading-relaxed text-[#2D2D2D]/80">
            Dispareuniya menopozun tabu konularından biridir ancak yaygındır ve tedavi edilebilir. Açık iletişim, basit müdahaleler ve gerekirse tıbbi tedavi, kadınların yakınlık deneyimini yeniden mümkün kılar. Bu makale, konuşmasını ve çözüm aranmasını normalleştirmeyi amaçlar.
          </p>
        </section>

        <section class="mt-10 rounded-[24px] border border-dashed border-[#6B2D3E]/25 bg-white/95 p-6 ring-1 ring-[#6B2D3E]/10">
          <p class="text-sm leading-relaxed text-[#2D2D2D]/75">
            Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavinin yerini almaz. Sağlık kararlarınız için
            kendi hekiminizle birlikte değerlendirme yapınız.
          </p>
        </section>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
