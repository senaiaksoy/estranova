---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { resolveSiteUrl } from '../../../utils/seo';

const hero = submenuHeroByRoute['/beden-yakinlik/cilt-gorunum/menopozda-cilt-degisimleri']!;

const tocEntries = [
  { id: 'ostrojen-etki', label: 'Östrojenin Etkisi' },
  { id: 'yaygin-degisimler', label: 'Yaygın Değişimler' },
  { id: 'vulvovajinal', label: 'Vulvovajinal Doku' },
  { id: 'topikal-yaklasimlar', label: 'Topikal Bakım' },
  { id: 'oral-destekler', label: 'Oral Destekler' },
  { id: 'yasam-aliskanliklari', label: 'Yaşam Alışkanlıkları' },
  { id: 'profesyonel-destek', label: 'Profesyonel Destek' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Menopozda Cilt Değişimleri — Anlamak ve Bakım Rehberi';
const articleDescription = 'Menopoz döneminde ciltte görülen değişimleri, kanıt düzeyleriyle bakım seçeneklerini ve günlük destek adımlarını açıklayan rehber.';
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'duygu-karaosmanoglu',
  publishedDate: '27 Mart 2026',
  pathname: '/beden-yakinlik/cilt-gorunum/menopozda-cilt-degisimleri',
  articleSection: 'Beden & Yakınlık',
  sectionPath: '/beden-yakinlik',
  keywords: ['menopoz', 'cilt', 'kolajen', 'östrojen', 'yaşlanma', 'topikal'],
  siteUrl,
});
---

<SiteLayout
  title={`${articleTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/beden-yakinlik" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Beden & Yakınlık · Cilt sağlığı"
      title="Menopozda Cilt Değişimleri — Anlamak ve Bakım Yapmanın Rehberi"
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <SubmenuArticleBody>
        <ArticleTOC slot="toc" entries={tocEntries} />
        <ArticleAuthorBlock authorSlug="duygu-karaosmanoglu" publishedDate="27 Mart 2026" readingMinutes={3} />

        <section class="rounded-[28px] border border-gold/35 bg-gradient-to-br from-white to-cream-soft/90 p-7 shadow-sm ring-1 ring-gold/22 md:p-8">
          <h2 class="mb-4 font-serif text-3xl">Kısa Özet</h2>
          <p class="leading-relaxed text-ink/80">
            Östrojen azalması cilt mimarisini değiştirir; kolajen ve elastin üretimi zamanla düşebilir. Cilt daha kuru,
            daha hassas ve daha ince görünebilir. Uygun bakım, beslenme ve yaşam alışkanlıkları ile bu değişimleri daha dengeli yönetmek mümkündür.
          </p>
        </section>

        <ArticleProsePanel>
          <h2 id="ostrojen-etki">Östrojen Cilt Yapısına Nasıl Etki Eder?</h2>
          <p>
            Aynaya baktığında cildinin bir anda daha kuru ya da hassas göründüğünü fark etmek şaşırtıcı olabilir; östrojen cildin nem dengesi, kolajen üretimi ve bariyer bütünlüğü üzerinde etkili bir hormondur <Evidence level={5} />.
            Menopoz döneminde östrojen düzeyleri düştükçe cildin su tutma kapasitesi azalabilir ve toparlanma süresi uzayabilir.
          </p>
          <p>
            Bu değişim yalnızca yüz cildi ile sınırlı değildir. Vücudun farklı bölgelerinde kuruluk, hassasiyet artışı ve elastikiyet kaybı
            görülebilir. Ciltte gözlenen değişimleri kişisel başarısızlık gibi değil, hormon geçişinin doğal bir parçası olarak görmek önemlidir.
          </p>

          <h2 id="yaygin-degisimler">Yaygın Cilt Değişimleri Nelerdir?</h2>
          <p>
            Bu değişimleri fark etmek kişisel bakımda başarısız olduğun anlamına gelmez; menopoz döneminde sık görülen başlıca değişimler kuruluk, ince çizgilerde artış, elastikiyet kaybı, ton farklılıkları ve dönemsel
            hassasiyet olarak özetlenebilir. Kuruluk ve ince çizgiler için kanıt seviyesi güçlüdür <Evidence level={5} />.
          </p>
          <p>
            Bazı kişilerde cilt daha reaktif hale gelir. Daha önce sorun yaratmayan ürünler bu dönemde tahriş oluşturabilir.
            Bu nedenle bakım planında ürün çeşitliliğini artırmak yerine, sade ama düzenli bir rutin kurmak çoğu zaman daha iyi sonuç verir.
          </p>

          <h2 id="vulvovajinal">Vulvovajinal Doku Değişimleri</h2>
          <p>
            Cilt değişiminden söz ederken mahrem dokuları da dışarıda bırakmamak gerekir; menopozla birlikte vajinal ve vulvar dokuda incelme, kuruluk ve hassasiyet gelişebilir <Evidence level={5} />. Bu durum günlük konforu,
            cinsel yaşam deneyimini ve bazen idrar yolu şikayetlerini etkileyebilir.
          </p>
          <p>
            Bu belirtiler yaygındır ve utanılacak bir durum değildir. Uygun nemlendirici ürünler, lokal tedavi seçenekleri ve hekim değerlendirmesi
            ile yönetilebilir. Kalıcı rahatsızlık durumunda geç kalmadan destek almak yaşam kalitesini belirgin biçimde artırır.
          </p>

          <h2 id="topikal-yaklasimlar">Yüz Cildi İçin Topikal Yaklaşımlar</h2>
          <p>
            Bakım rutini kalabalık olmak zorunda değildir; nemlendiriciler (hyaluronik asit, gliserin, seramid içeren formüller) bariyer desteğinde temel rol oynar <Evidence level={5} />.
            Retinoid içeren ürünler kolajen dönüşümüne katkı sağlayabilir <Evidence level={5} />, ancak düşük dozla başlayıp yavaş ilerlemek gerekir.
          </p>
          <p>
            C vitamini gibi antioksidanlar cilt tonunu destekleyebilir <Evidence level={4} />. Güneş koruması ise bu dönemde vazgeçilmezdir <Evidence level={5} />.
            SPF 30 ve üzeri ürünlerin düzenli kullanımı, pigment değişimleri ve erken foto-yaşlanma riskini azaltmada en etkili adımlardan biridir.
          </p>

          <h2 id="oral-destekler">Oral Destekler ve Takviyeler</h2>
          <p>
            Takviyeler cilt konusunda çok sık karşımıza çıkar; kolajen hidrolizatı, hyaluronik asit, omega-3 ve bazı antioksidan takviyeler cilt kalitesi için sık konuşulan seçeneklerdir.
            Bu başlıkların kanıt düzeyi genellikle orta veya gelişen kanıt aralığındadır <Evidence from={3} to={4} />.
          </p>
          <p>
            Takviyeler tek başına güçlü bir bakım planı oluşturmaz. Beslenme düzeni, uyku, stres düzeyi ve güneş koruması ile birlikte değerlendirilmelidir.
            Takviye seçimi yapılacaksa doz, içerik ve ilaç etkileşimleri açısından sağlık profesyoneli görüşü almak en güvenli yaklaşımdır.
          </p>

          <h2 id="yasam-aliskanliklari">Yaşam Alışkanlıkları: Sessiz ama Güçlü Etki</h2>
          <p>
            Cilt çoğu zaman içerideki ritmi de gösterir; düzenli uyku, yeterli su tüketimi, protein ve sağlıklı yağdan dengeli beslenme cilt yenilenmesine katkı sağlayabilir <Evidence level={4} />.
            Stres düzeyinin yüksek kalması ise kortizol yoluyla ciltte hassasiyet ve iyileşme gecikmesiyle ilişkili olabilir <Evidence level={4} />.
          </p>
          <p>
            Sigara bırakma ve alkolü sınırlama cilt sağlığı için doğrudan olumlu katkı sağlar <Evidence level={5} />. Günlük 20-30 dakikalık yürüyüş gibi
            sürdürülebilir hareket planı da dolaşımı destekleyerek cilt kalitesine dolaylı katkı sunar.
          </p>

          <h2 id="profesyonel-destek">Ne Zaman Profesyonel Destek Almalısınız?</h2>
          <p>
            Bazen iyi bir rutin yetmez ve bu da senin hatan değildir; ciltte kalıcı tahriş, ani pigment değişimi, geçmeyen kuruluk veya cinsel ilişki sırasında belirgin rahatsızlık varsa dermatolog ve/veya jinekolog
            değerlendirmesi gerekir. Özellikle günlük yaşamı etkileyen şikayetlerde gecikmeden destek almak önemlidir.
          </p>
          <p>
            Menopoz döneminde cilt bakımı tek bir ürüne bağlı değildir; kişiye özgü, düzenli ve gerçekçi bir planla ilerlemek çoğu zaman daha dengeli sonuç verir.
            Buradaki temel hedef kusursuz görünüm değil, konfor ve sağlıklı cilt bariyeridir.
          </p>
        </ArticleProsePanel>

        <RelatedReadings
          class="mt-14"
          paths={[
            '/beden-yakinlik/cinsel-saglik',
            '/zamansiz-yasam/beslenme-yaslanma',
            '/zihin-denge/duygusal-denge/stres-yonetimi-menopoz',
            '/bilimsel-pencere/arastirma',
            '/hormonal-gecis/menopoz/menopoz-nedir',
          ]}
        />

        <section class="mt-14 rounded-[28px] border border-burgundy/15 border-l-[6px] border-l-gold bg-gradient-to-r from-cream-warm to-cream-soft p-7 shadow-sm ring-1 ring-burgundy/10 md:p-8">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.22em] text-burgundy">Bilimsel Editör Notu</p>
          <p class="leading-relaxed text-ink/80">
            Cilt değişimleri menopozun görünür ve günlük yaşamı etkileyen yönlerinden biridir. Bu değişimleri anlamak ve kişiye uygun bakım planı
            oluşturmak konforu artırır. Birçok müdahale kişiden kişiye farklı sonuç verir; düzenli takip ve sabırlı yaklaşım önemlidir.
          </p>
        </section>

        <section class="mt-10 rounded-[24px] border border-dashed border-burgundy/25 bg-white/95 p-6 ring-1 ring-burgundy/10">
          <p class="text-sm leading-relaxed text-ink/75">
            Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme yerine geçmez. Tanı ve tedavi kararları için sağlık profesyoneline başvurunuz.
          </p>
        </section>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
