---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import Evidence from '../../../components/site/Evidence.astro';
import RedFlagBox from '../../../components/site/RedFlagBox.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../../components/site/ArticleFAQ.astro';
import { articleCardImageByRoute, submenuHeroByRoute } from '../../../data/submenu-heroes';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { articleFaqs } from '../../../data/article-faqs';
import { resolveSiteUrl } from '../../../utils/seo';

const pathname = '/beden-yakinlik/cilt-gorunum/menopozda-cilt-degisimleri/';
const hero = submenuHeroByRoute[pathname] ?? submenuHeroByRoute['/beden-yakinlik/cilt-gorunum/']!;
const articleImage = articleCardImageByRoute[pathname]?.src ?? hero.src;
const articleTitle = 'Menopozda Cilt Değişimleri: Cildi Trendlerle Değil Biyolojisiyle Okumak';
const seoTitle = 'Menopozda Cilt Değişimleri';
const articleDescription =
  'Prof. Dr. Gonca Gökdemir, menopozda ciltte kuruluk, hassasiyet, leke eğilimi ve kolajen değişimini hormon, UV ve bariyer biyolojisi üzerinden anlatıyor.';
const publishedDate = '18 Mayıs 2026';
const modifiedDate = '14 Ekim 2026';
const readingMinutes = 9;

const tocEntries = [
  { id: 'cildi-nasil-okurum', label: 'Cildi nasıl okurum?' },
  { id: 'ostrojen-bariyer', label: 'Östrojen, bariyer ve nem' },
  { id: 'kolajen-elastikiyet', label: 'Kolajen ve elastikiyet' },
  { id: 'leke-melanin', label: 'Leke, melanin ve güneş geçmişi' },
  { id: 'bakim-ritmi', label: 'Bakım ritmini sadeleştirmek' },
  { id: 'aktif-madde', label: 'Aktif maddeleri nasıl düşünmeli?' },
  { id: 'degerlendirme', label: 'Ne zaman değerlendirme gerekir?' },
  { id: 'sik-sorulanlar', label: 'Sıkça Sorulanlar' },
  { id: 'kaynaklar', label: 'Kaynaklar' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const faqItems = articleFaqs[pathname] ?? [];
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'gonca-gokdemir',
  articleType: 'clinical-guide',
  publishedDate,
  modifiedDate,
  pathname,
  articleSection: 'Beden & Yakınlık',
  sectionPath: '/beden-yakinlik/',
  image: new URL(articleImage, siteUrl).href,
  keywords: [
    'menopoz',
    'cilt değişimleri',
    'cilt kuruluğu',
    'kolajen',
    'elastikiyet',
    'cilt bariyeri',
    'melanin',
    'leke',
    'güneş koruması',
    '40 sonrası cilt',
    'dermatoloji',
  ],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  image={articleImage}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/beden-yakinlik/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Beden & Yakınlık · Cilt & Görünüm"
      title="Menopozda Cilt Değişimleri"
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="gonca-gokdemir"
        articleType="clinical-guide"
        publishedDate={publishedDate}
        lastUpdated={modifiedDate}
        readingMinutes={readingMinutes}
        imageSrc="/images/library/editorial/menopozda-cilt-degisimleri-byline.webp"
        imageAlt="Şehirde erken akşamüstü vitrin yansıması önünde krem trençkot ve bordo fularla duran 45-55 yaş arası zarif bir kadının doğal cilt dokusunu ve menopozda cilt değişimleri temasını sakin biçimde taşıyan editoryal fotoğraf"
        imagePosition="42% center"
      />

      <ArticleSummary title="Kısa Özet">
        <p>
          Menopoz geçişinde östrojen azalması cildin nemini, kalınlığını ve esnekliğini etkileyebilir. Kuruluk ve çizgiler
          belirginleşebilir; güneş geçmişi ve kullandığınız ürünler de bu değişime katkıda bulunur.<sup>[<a href="#kaynak-1">1</a>]</sup>
          Bakımda nazik temizleme, nemlendirme ve güneşten korunma temel adımlardır. Yanma veya kızarıklık varsa yeni ürünler
          eklemek tahrişi artırabilir. Kolajen takviyelerinin yararı ise kesinleşmiş değildir.<sup>[<a href="#kaynak-4">4</a>]</sup>
          Yeni veya değişen bir ben, kanayan alan ya da iyileşmeyen yara varsa dermatolojik değerlendirmeyi geciktirmeyin.<sup>[<a href="#kaynak-6">6</a>]</sup>
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="cildi-nasil-okurum">Cildi nasıl okurum?</h2>
        <p>
          Aynı nemlendiriciyi kullanırken yüzünüzün daha gergin olduğunu, makyajın eskisi gibi durmadığını fark
          edebilirsiniz. Bu değişimi anlamak için hemen yeni bir ürün aramanız gerekmiyor.
        </p>
        <p>
          Cilt; hormonlardan, güneşten ve zaman içinde biriken etkilerden payını alan canlı bir dokudur. Östrojen, kolajen ve
          cilde rengini veren melanin bu dokunun farklı işlevlerinde rol oynar. Cilt bariyeri ise dış etkenlere karşı koruyucu
          tabakadır; su kaybını da sınırlar.<sup>[<a href="#kaynak-1">1</a>,<a href="#kaynak-2">2</a>]</sup>
        </p>
        <p>
          Benim durduğum yer trendlerin değil, cildin tarafıdır. Yeni bir serum veya işlem konuşmadan önce neyin değiştiğini
          ayırmak isterim: Kuruluk mu baskın, yanma mı, yoksa yeni fark ettiğiniz bir leke mi? Her biri aynı bakımı gerektirmez.
          Cildinizin değişmesi, ona yanlış baktığınız anlamına gelmez.
        </p>

        <h2 id="ostrojen-bariyer">Östrojen, bariyer ve nem ilişkisi neden önemli?</h2>
        <p>
          Yüzünüzü yıkadıktan sonra beliren gerginlik, cildin nem ihtiyacını daha görünür kılabilir. Menopoz geçişindeki
          hormonal değişim bu ihtiyacın nedenlerinden biridir.<sup>[<a href="#kaynak-1">1</a>]</sup>
        </p>
        <p>
          Östrojen azalması cildin su tutma kapasitesi, kalınlığı ve esnekliğiyle ilişkilidir. Yüz, boyun, el üstü ve
          dekoltede kuruluk ya da incelme fark edebilirsiniz. Ancak bu değişimler herkeste aynı ölçüde olmaz.
          <Evidence level={4} /><sup>[<a href="#kaynak-1">1</a>,<a href="#kaynak-2">2</a>]</sup>
        </p>
        <p>
          Her kuruluğun nedeni menopoz değildir. Sıcak su, sert temizleyiciler, parfümlü ürünler ve sık peeling cildi tahriş
          edebilir. Egzama, bazı ilaçlar ve tiroid hastalıkları da değerlendirmede dikkate alınır.<sup>[<a href="#kaynak-7">7</a>]</sup>
          Bu yüzden kullandığınız ürünleri ve şikâyetin ne zaman başladığını birlikte düşünmek, yalnızca nemlendiriciyi
          değiştirmekten daha açıklayıcı olabilir.
        </p>

        <h2 id="kolajen-elastikiyet">Kolajen ve elastikiyet meselesi nasıl okunmalı?</h2>
        <p>
          Kolajen, cilde dayanıklılık kazandıran yapısal bir proteindir. Kolajen içeren bir takviyenin etkisi ise ayrıca
          klinik çalışmalarla değerlendirilir.
        </p>
        <p>
          Menopozdan sonra ciltte kolajen azalması ve esneklik kaybı belirginleşebilir. İnce çizgiler, el üstlerinde incelme
          veya boyun bölgesinde gevşeklik fark edebilirsiniz. Görünümü hormonlarla birlikte yılların güneş maruziyeti de
          etkiler.<Evidence level={4} /><sup>[<a href="#kaynak-1">1</a>,<a href="#kaynak-2">2</a>]</sup>
        </p>
        <p>
          Kolajen takviyeleriyle ilgili bazı çalışmalarda nem ve esneklik açısından olumlu sonuçlar bildirilmiştir. Ancak
          2025 tarihli bir derlemede yüksek kaliteli çalışmalar ayrı incelendiğinde belirgin yarar görülmemiştir. Finansman
          kaynağına göre de sonuçlar farklılaşmıştır. Bu veriler, menopozdaki kadınlara rutin kolajen takviyesi önermek için
          yeterli değildir.<Evidence level={2} /><sup>[<a href="#kaynak-4">4</a>]</sup>
        </p>
        <p>
          Sigaradan uzak durmak da cilt sağlığı açısından önemlidir; sigara cildin yaşlanmasını hızlandıran etkenler
          arasındadır.<sup>[<a href="#kaynak-7">7</a>]</sup>
        </p>

        <h2 id="leke-melanin">Leke, melanin ve güneş geçmişi neden menopozda daha görünür olabilir?</h2>
        <p>
          Elinizin üstündeki bir lekeyi yeni fark etmeniz, onun yalnızca menopoz nedeniyle oluştuğunu göstermez. Yılların
          güneş maruziyetiyle gelişen lekeler bu yaşlarda daha dikkat çekici olabilir.<sup>[<a href="#kaynak-1">1</a>]</sup>
        </p>
        <p>
          Melanin, cilde rengini veren pigmenttir; onu üreten hücrelere melanosit denir. Güneş, hormonal etkiler ve tahriş
          pigment oluşumunu etkileyebilir. Melazma denen yamalı koyulaşmalar ile lentigo denen güneş lekeleri farklı
          durumlardır; menopozda hepsinin aynı biçimde artması beklenmez.<sup>[<a href="#kaynak-1">1</a>,<a href="#kaynak-8">8</a>]</sup>
        </p>
        <p>
          Ben lekeyi değerlendirirken önce tipini, tetikleyicilerini ve cilt bariyerinin durumunu anlamak isterim. Özellikle
          yeni veya değişen bir lekeyi görmeden, onu yalnızca açılması gereken bir renk farkı saymak güvenli olmaz.<sup>[<a href="#kaynak-1">1</a>,<a href="#kaynak-6">6</a>]</sup>
        </p>
        <p>
          Güneş koruması, güneşe bağlı cilt yaşlanmasını yavaşlatmaya yardımcı olabilir. Katılımcıların gruplara rastgele
          ayrıldığı bir çalışmada bu yönde sonuç bulunmuştur; çalışma yalnız menopozdaki kadınlarda yapılmamıştır. Sonuç,
          hormonal kolajen kaybının tümünü önleme vaadi olarak okunamaz.<Evidence level={4} /><sup>[<a href="#kaynak-3">3</a>]</sup>
        </p>

        <h2 id="bakim-ritmi">Bakım ritmini sadeleştirmek neden iyi bir başlangıçtır?</h2>
        <p>
          Lavabo kenarında birkaç şişe biriktiğinde, hangisinin cildinize iyi geldiğini ayırt etmek zorlaşabilir. Özellikle
          yanma ve pullanma başladıysa önce rutininizi gözden geçirmek işe yarar.
        </p>
        <p>
          Ben bakım planında “ne ekleyelim?” sorusuyla birlikte “neyi azaltırsak cilt rahatlar?” sorusuna da bakarım. Yanma
          ve kızarıklık varken yeni ürünleri üst üste denemek, hangisinin tahriş yaptığını ayırt etmeyi zorlaştırır.
        </p>
        <ul>
          <li>Birkaç gün cildinizin nasıl hissettiğini izleyin: Yıkama sonrasında geriliyor mu, bir ürün sürünce yanıyor mu?</li>
          <li>Birden fazla yeni ürüne aynı anda başlamayın; hangi ürünün tahriş yaptığını ayırt etmek zorlaşır.</li>
          <li>Yanma veya batma yapan ürünü kullanmayı bırakın; yakınma sürüyorsa dermatolojik değerlendirme alın.<sup>[<a href="#kaynak-1">1</a>,<a href="#kaynak-5">5</a>]</sup></li>
          <li>Gölge ve giysiyle korunmaya ek olarak, açıkta kalan cilt için geniş spektrumlu, yani UVA ve UVB ışınlarına karşı koruma sağlayan, SPF 30 veya üzeri güneş koruyucu seçin.<sup>[<a href="#kaynak-1">1</a>]</sup></li>
          <li>İşlem ya da takviye önerildiğinde, hangi şikâyete yönelik olduğunu ve beklenen yararın ne kadar belirsiz kaldığını sorun.</li>
        </ul>
        <p>
          Bu adımlar sabit bir tedavi reçetesi değildir. Egzama gibi bir hastalık, kullandığınız ilaçlar veya devam eden
          tahriş bakım planını değiştirebilir.
        </p>

        <h2 id="aktif-madde">Aktif maddeleri nasıl düşünmeli?</h2>
        <p>
          Bir ürünün etiketini okurken önce hangi şikâyete yönelik olduğuna bakın. İçerik listesi kadar, cildinizin ürünü
          tolere edip etmediği de önemlidir.
        </p>
        <p>
          Retinoidler, A vitamini türevi maddelerin genel adıdır; retinol de bu gruptadır. Cilde uygulanan bazı retinoidler
          ince çizgi ve pigment düzensizliklerinde yararlı olabilir. Ancak kuru, kızarık veya hassas ciltte tahriş yapabilirler.
          Retinol içeren her kozmetik ürünün etkisi reçeteli retinoidlerle eşit kabul edilemez.<Evidence level={3} /><sup>[<a href="#kaynak-5">5</a>]</sup>
        </p>
        <p>
          <strong>Retinoidler gebelikte kullanılmaz.</strong> Menopoz geçişinde hâlâ gebelik ihtimali varsa veya gebelik
          planlıyorsanız, retinoid içeren ürüne başlamadan önce hekiminizle konuşun.<sup>[<a href="#kaynak-5">5</a>]</sup>
        </p>
        <p>
          Hyalüronik asit gibi nem tutucu içeriklerin amacı cildin nemini artırmaya yardımcı olmaktır.<sup>[<a href="#kaynak-1">1</a>]</sup>
          Bu, retinoidlerin çizgi ve pigment düzensizliği için kullanımından farklı bir hedeftir. Kuruluk baskınsa nemlendirme
          ihtiyacını, leke veya çizgi baskınsa bunlara yönelik seçenekleri ayrı düşünmek bakım kararını sadeleştirir.
        </p>

        <h2 id="degerlendirme">Ne zaman dermatolojik değerlendirme gerekir?</h2>
        <p>
          Yeni veya değişen bir ben, kanayan alan ya da iyileşmeyen yara varsa bakım rutininin sonucunu beklemeyin.
          Dermatolojik değerlendirme alın.<sup>[<a href="#kaynak-6">6</a>]</sup>
        </p>
        <h3>Geciktirilmemesi gereken cilt değişiklikleri</h3>
        <ul>
          <li>Yeni çıkan, büyüyen veya rengi belirgin değişen ben ya da leke.</li>
          <li>Kanayan, kabuklanan, iyileşmeyen veya tekrarlayan yara.</li>
          <li>Asimetrik, sınırları düzensiz ya da birden fazla renge sahip ben.<sup>[<a href="#kaynak-6">6</a>]</sup></li>
        </ul>
        <p>
          Bu işaretler kendi başına kanser tanısı değildir; nedeni muayeneyle ayırt edilir. Ben takibinin gerekliliği ve
          sıklığı kişisel risklerinize göre belirlenir.
        </p>
        <p>
          Yoğun kaşıntı, belirgin yanma, yaygın kızarıklık veya bir üründen sonra uzayan tahriş de değerlendirme gerektirir.<sup>[<a href="#kaynak-5">5</a>,<a href="#kaynak-7">7</a>]</sup>
          İşlem sonrası uzayan tahriş, yanık hissi veya yeni lekelenme varsa dermatoloğunuzla görüşün. Özellikle peeling
          sonrasında yanma, kaşıntı veya şişlik olduğunda işlemi uygulayan hekime haber verin.<sup>[<a href="#kaynak-11">11</a>]</sup>
        </p>
        <p>
          Ani saç dökülmesini yalnızca menopozla açıklamayın; farklı nedenleri olabilir.<sup>[<a href="#kaynak-1">1</a>]</sup>
          Kaş-kirpik kaybı ve yeni tırnak değişiklikleri de ayrıca değerlendirilmelidir.<sup>[<a href="#kaynak-9">9</a>,<a href="#kaynak-10">10</a>]</sup>
        </p>

        <RedFlagBox
          title="Dermatoloji değerlendirmesini geciktirmemenin anlamlı olduğu durumlar"
          intro="Aşağıdaki işaretler tek başına tanı koydurmaz; ama cildi yalnızca bakım ürünüyle izlemek yerine dermatoloji görüşü almayı gerektirebilir."
          markers={[
            'Yeni çıkan, hızla büyüyen veya rengi belirgin değişen ben ya da leke',
            'Kanayan, kabuklanan, iyileşmeyen veya tekrarlayan yara',
            'Asimetrik, sınırları düzensiz veya birden fazla renge sahip ben',
            'Yoğun kaşıntı, yanma, yaygın kızarıklık veya ani hassasiyet artışı',
            'Ani başlayan belirgin saç dökülmesi, kaş-kirpik kaybı veya tırnak değişikliği',
            'İşlem ya da ürün sonrası uzayan tahriş, yanık hissi veya lekelenme',
          ]}
          footnote="Bu liste panik yaratmak için değil; cilt değişimini doğru zamanda doğru uzmanlıkla değerlendirmek için hazırlanmış bir hatırlatmadır."
        />
      </ArticleProsePanel>

      <ArticleFAQ id="sik-sorulanlar" items={faqItems} class="mt-10" />

      <section id="kaynaklar" class="mt-12">
        <h2 class="text-xl font-serif text-ink">Kaynaklar</h2>
        <ol class="mt-4 space-y-3 text-sm text-ink/70 leading-relaxed list-decimal list-outside pl-5">
          <li id="kaynak-1">
            American Academy of Dermatology. <a href="https://www.aad.org/public/everyday-care/skin-care-secrets/anti-aging/skin-care-during-menopause" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Caring for your skin in menopause</a>.
            <span class="block mt-0.5 text-ink/50">Menopoz, kuruluk, lekeler, nazik bakım ve değerlendirme başlıkları. Erişim: 14 Ekim 2026.</span>
          </li>
          <li id="kaynak-2">
            Zouboulis CC ve ark. <a href="https://pubmed.ncbi.nlm.nih.gov/35377827/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Skin, hair and beyond: the impact of menopause</a>. <em>Climacteric</em>, 2022.
            <span class="block mt-0.5 text-ink/50">Hormon-cilt ilişkisini ele alan derleme; bakım yöntemlerinin hepsi için aynı düzeyde etkinlik kanıtı oluşturmaz.</span>
          </li>
          <li id="kaynak-3">
            Hughes MCB ve ark. <a href="https://pubmed.ncbi.nlm.nih.gov/23732711/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Sunscreen and prevention of skin aging: a randomized trial</a>. <em>Annals of Internal Medicine</em>, 2013.
            <span class="block mt-0.5 text-ink/50">Güneşe bağlı yaşlanma sonucu; menopozdaki kadınlara özgü çalışma değildir.</span>
          </li>
          <li id="kaynak-4">
            Myung SK, Park Y. <a href="https://pubmed.ncbi.nlm.nih.gov/40324552/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Effects of Collagen Supplements on Skin Aging: A Systematic Review and Meta-Analysis of Randomized Controlled Trials</a>. <em>American Journal of Medicine</em>, 2025.
            <span class="block mt-0.5 text-ink/50">Çalışma kalitesi ve finansman kaynağına göre sonuç farklılıkları.</span>
          </li>
          <li id="kaynak-5">
            American Academy of Dermatology. <a href="https://www.aad.org/public/everyday-care/skin-care-secrets/anti-aging/retinoid-retinol" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Retinoid or retinol?</a>
            <span class="block mt-0.5 text-ink/50">Topikal retinoidler, tahriş ve gebelik uyarısı. Erişim: 14 Ekim 2026.</span>
          </li>
          <li id="kaynak-6">
            American Academy of Dermatology. <a href="https://www.aad.org/public/diseases/skin-cancer/types/common/melanoma/symptoms" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Melanoma: Signs and symptoms</a>.
            <span class="block mt-0.5 text-ink/50">Yeni veya değişen lezyonlarda değerlendirme. Erişim: 14 Ekim 2026.</span>
          </li>
          <li id="kaynak-7">
            American Academy of Dermatology. <a href="https://www.aad.org/public/diseases/a-z/dry-skin-causes" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Dry skin: Who gets and causes</a>.
            <span class="block mt-0.5 text-ink/50">Kuruluğun ürün, ilaç ve hastalıklarla ilişkisi. Erişim: 14 Ekim 2026.</span>
          </li>
          <li id="kaynak-8">
            DermNet. <a href="https://dermnetnz.org/topics/melasma" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Melasma</a> ve <a href="https://dermnetnz.org/topics/skin-pigmentation-problems" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Skin pigmentation</a>.
            <span class="block mt-0.5 text-ink/50">Melanin, melanosit ve hormonal pigment değişikliklerinin ayrımı. Erişim: 14 Ekim 2026.</span>
          </li>
          <li id="kaynak-9">
            DermNet. <a href="https://dermnetnz.org/topics/madarosis" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Madarosis</a>.
            <span class="block mt-0.5 text-ink/50">Kaş ve kirpik kaybının farklı nedenleri ve değerlendirilmesi. Erişim: 14 Ekim 2026.</span>
