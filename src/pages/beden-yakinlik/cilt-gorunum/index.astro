---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuSection from '../../../components/site/SubmenuSection.astro';
import ChapterMasthead from '../../../components/site/ChapterMasthead.astro';
import EditorialEpigraph from '../../../components/site/EditorialEpigraph.astro';
import MarginaliaRail from '../../../components/site/MarginaliaRail.astro';
import MarginaliaItem from '../../../components/site/MarginaliaItem.astro';
import Asterism from '../../../components/site/Asterism.astro';
import ChapterCompass from '../../../components/site/ChapterCompass.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { chapterMap, getNextChapter } from '../../../data/chapter-map';
import { subHubEpigraphs } from '../../../data/sub-hub-epigraphs';

const path = '/beden-yakinlik/cilt-gorunum';
const hero = submenuHeroByRoute[path]!;
const chapter = chapterMap[path]!;
const epigraph = subHubEpigraphs[path];
const next = getNextChapter(path);

const neighbors = [
  { step: '01', href: '/beden-yakinlik/cinsel-saglik', title: 'Cinsel Sağlık', excerpt: 'Vajinal kuruluk, cinsellikte ağrı ve libido değişimleri; mahremiyetinizi yargılamayan bir dil.' },
  { step: '02', href: '/beden-yakinlik/pelvik-taban', title: 'Pelvik Taban', excerpt: 'İdrar kontrolü ve pelvik kasların menopozda değişimi; egzersiz ve davranışsal stratejiler.' },
];
---

<SiteLayout
  title="Cilt & Görünüm — Beden & Yakınlık - Estranova"
  description="Menopozda cildin hormonal yaşlanması ve günlük bakım rehberi; kollajen, nem, bariyer ve klinik destek seçenekleri sade bir okuma."
>
  <SiteNavbar currentPath="/beden-yakinlik" />

  <main id="main-content" class="text-ink">
    <ChapterMasthead number={chapter.number} parent={chapter.parent} chapter={chapter.chapter} />

    <SubmenuHero
      eyebrow="Hormonun cilde dokunduğu yer"
      title="Cilt & Görünüm"
      lede="Menopozda cilt iki cephede değişir: hormonal — kollajen, elastin, nem — ve biyolojik yaşlanma. Burada görünüm odaklı klişeyi değil, cildin kendi sağlığını desteklemenin sade yollarını buluyorsunuz."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />

    <section class="border-b border-burgundy/10 bg-[#fffaf0] px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <nav class="mb-10 text-sm text-ink/60" aria-label="İçerik yolu">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/beden-yakinlik" class="font-medium text-burgundy hover:underline">Beden & Yakınlık</a></li>
            <li aria-hidden="true">/</li>
            <li class="font-medium text-ink">Cilt & Görünüm</li>
          </ol>
        </nav>

        <div class="grid gap-12 lg:grid-cols-12 lg:items-start lg:gap-14">
          <div class="lg:col-span-8">
            <p class="editorial-dropcap mb-7 text-lg leading-relaxed text-ink/85 md:text-xl">
              Östrojen düştükçe cildin nem tutma kapasitesi, kolajen üretimi ve bariyer
              dayanıklılığı değişir. Bu doğal bir geçiş; <strong class="font-semibold text-ink">kişisel bir başarısızlık değil</strong>,
              biyolojinin sade bir gerçeği. Aynı dönemde hücresel yenilenme yavaşlar,
              ince çizgiler belirginleşir, lekelenmeye yatkınlık artabilir.
            </p>
            <p class="text-base leading-relaxed text-ink/72 md:text-lg">
              Burada amacımız ne reklam, ne kusursuz görünüm vaadidir. Sade ve sürdürülebilir
              bir bakım yolu; beslenme, uyku ve günlük güneş korumasıyla birlikte
              düşünüldüğünde çoğu zaman daha dengeli sonuç verir.
            </p>
          </div>

          <div class="lg:col-span-4 lg:pt-1">
            <MarginaliaRail>
              <MarginaliaItem label="Yayın" value="Nisan 2026 · Düzenli güncellenir" />
              <MarginaliaItem label="Kanıt" emphasized="Düzenli güneş koruması en yüksek kanıtlı tek adımdır." />
              <MarginaliaItem label="Sık sorulanlar">
                <ul class="mt-2 space-y-3 text-sm leading-snug text-ink/78">
                  <li><span class="block font-semibold text-ink">Cilt değişimi sadece hormonal mı?</span>Hayır; güneş, uyku, beslenme ve stres aynı tablonun parçasıdır.</li>
                  <li><span class="block font-semibold text-ink">En etkili tek adım nedir?</span>Düzenli güneş koruması; her yaşta kanıt düzeyi en yüksek müdahaledir.</li>
                  <li><span class="block font-semibold text-ink">Takviye almalı mıyım?</span>Genel öneri yoktur; ihtiyaç ve dozaj için hekiminizle değerlendirin.</li>
                </ul>
              </MarginaliaItem>
            </MarginaliaRail>
          </div>
        </div>
      </div>
    </section>

    {epigraph && <EditorialEpigraph quote={epigraph} />}

    <Asterism />

    <SubmenuSection variant="cream" borderedTop={false}>
      <header class="mb-10 grid gap-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-end">
        <p class="text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Aynı kategoride</p>
        <h2 class="font-serif text-4xl leading-[0.95] tracking-[-0.04em] md:text-6xl">İlgili alt başlıklar</h2>
      </header>
      <div class="divide-y divide-burgundy/14 border-y border-burgundy/14">
        {neighbors.map((n) => (
          <a href={n.href} class="group grid gap-5 py-7 transition hover:bg-white/58 md:grid-cols-[88px_1fr_auto] md:items-center md:py-8">
            <span class="font-serif text-3xl italic text-gold">{n.step}</span>
            <div>
              <h3 class="mb-2 font-serif text-3xl leading-tight text-ink group-hover:text-burgundy">{n.title}</h3>
              <p class="max-w-2xl text-sm leading-relaxed text-ink/72">{n.excerpt}</p>
            </div>
            <span class="text-2xl text-gold transition group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </SubmenuSection>

    <ChapterCompass nextHref={next?.href} nextNumber={next?.number} nextChapter={next?.chapter} nextParent={next?.parent} />
  </main>

  <SiteFooter />
</SiteLayout>
