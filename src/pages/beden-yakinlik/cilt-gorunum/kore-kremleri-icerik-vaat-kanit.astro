---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import Evidence from '../../../components/site/Evidence.astro';
import RedFlagBox from '../../../components/site/RedFlagBox.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { resolveSiteUrl } from '../../../utils/seo';

const pathname = '/beden-yakinlik/cilt-gorunum/kore-kremleri-icerik-vaat-kanit/';
// CLAUDE.md §6 — makale üst hero görseli daima parent hub'dan gelir.
const hero = submenuHeroByRoute['/beden-yakinlik/cilt-gorunum/']!;

const articleTitle = 'Kore Kremlerinin Kavanozunda Ne Var? İçerik, Vaat ve Kanıt';
const seoTitle = 'Kore Kremleri: İçerik, Vaat ve Kanıt';
const articleDescription =
  "Op. Dr. Çağrı Sade, Kore kremlerindeki içerikleri, vaatleri ve insanlarda ölçülen sonuçlarıyla birlikte okuyor; menopozda cilt için etiketten neyi okuyabileceğinizi anlatıyor.";

const tocEntries = [
  { id: 'kavanozun-arkasi', label: 'Kavanozun Arka Yüzünü Çevirdiğinizde' },
  { id: 'katman', label: 'Bir Krem Yüzün Hangi Katmanına Ulaşır?' },
  { id: 'menopozda-cilt', label: 'Menopozda Cilt Ne Yaşıyor' },
  { id: 'kore-etiketi', label: 'Kore Etiketi ve İçerik Haritası' },
  { id: 'seramid', label: 'Seramid Yazıyor Diye İş Bitmez' },
  { id: 'etiket-sorulari', label: 'Etikette Beş Soru ve Türkiye Kuralları' },
  { id: 'sade-rutin', label: 'Menopozda Daha Az Ürün' },
  { id: 'islem-oncesi-sonrasi', label: 'Bir İşlem Planlıyorsanız' },
  { id: 'sonuc', label: 'Etikete Son Bir Bakış' },
  { id: 'kaynaklar', label: 'Kaynaklar ve İleri Okuma' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'cagri-sade',
  articleType: 'clinical-guide',
  publishedDate: '30 Ekim 2026',
  modifiedDate: '30 Ekim 2026',
  pathname,
  articleSection: 'Beden & Yakınlık',
  sectionPath: '/beden-yakinlik/',
  keywords: [
    'Kore kremleri',
    'Kore cilt bakımı',
    'menopozda cilt bakımı',
    'cilt bakımı içerikleri',
    'seramid',
    'niasinamid',
    'retinol',
    'krem etiketi nasıl okunur',
  ],
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/beden-yakinlik/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Beden & Yakınlık · Cilt & Görünüm"
      title={articleTitle}
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="cagri-sade"
        articleType="clinical-guide"
        publishedDate="30 Ekim 2026"
        lastUpdated="30 Ekim 2026"
        readingMinutes={10}
        imageSrc="/images/library/editorial/kore-kremleri-icerik-vaat-kanit-byline.webp"
        imageAlt="Sokakta vitrin camına bakan, krem trençkotlu ve bordo fularlı bir kadın; camda yansıması görünüyor; temsili dosya görseli"
        imagePosition="center top"
      />

      <ArticleSummary title="Kısa Klinik Yanıt">
        <p>
          Bir kremin Kore'de üretilmiş olması, içeriğinden çok daha az şey söyler. Güneş koruyucu,
          retinoid ve niasinamid için insanlarda kontrollü çalışmalar var; salyangoz, adenozin ve PDRN
          dayanakları küçük ya da krem formunu doğrudan sınamıyor. Krem cildin yüzeyine çalışır; hacim
          kaybını ve sarkmayı düzeltmez. Menopozda daha çok ürün yerine sade bir rutin çoğu zaman daha
          iyi sonuç verir.<sup><a href="#kaynak-1">[1]</a><a href="#kaynak-2">[2]</a><a href="#kaynak-4">[4]</a><a href="#kaynak-17">[17]</a></sup>
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="kavanozun-arkasi">Kavanozun Arka Yüzünü Çevirdiğinizde</h2>
        <p>
          Kremin ön yüzü vaatle doludur, arka yüzü içerik listesiyle. Bu yazı o ikinci yüzü okumak için.
        </p>
        <p>
          Raftaki Kore kremlerinin ön yüzü bir roman gibi yazılmıştır: ışıltı, dolgunluk, "cam gibi" bir
          cilt. Arka yüzü ise zabıt tutanağı. İkisinin aynı kavanozdan çıktığına inanmak bazen zor.
        </p>
        <p>
          Çoğumuz ön yüzü okuyup sepete atarız. Arka yüzü çevirdiğimizde karşımıza Latince ve İngilizce
          adlardan oluşan, ilk beşinin ne iş yaptığı belli olmayan bir liste çıkar.
        </p>
        <p>
          Bu yazıda o listeyi birlikte okuyacağız. Hangi madde ne vaat ediyor, bu vaadin arkasında
          insanlarda ne ölçülmüş, ölçülmemişse ne eksik.
        </p>
        <p>
          Önce bir şey söyleyeyim: Kore kremi kullanıyorsanız ve memnunsanız, bu yazı sizi vazgeçirmek
          için yazılmadı.
        </p>

        <h2 id="katman">Bir Krem Yüzün Hangi Katmanına Ulaşır?</h2>
        <p>
          <em>"Kremlerim neden işe yaramadı?"</em> diye sorulduğunda cevabım hep bir karşı soruyla
          başlar.
        </p>
        <p>
          Önce hastama kremlerden tam olarak ne beklediğini sorarım. Cildindeki kuruluk mu geçmedi, ince
          kırışıklıkları mı azalmadı, yoksa yüzünün eskisi kadar sıkı görünmemesinden mi şikâyetçi?
        </p>
        <p>Çünkü bunlar aynı sorun değil.</p>
        <p>
          Kuruluk, matlık, cilt dokusundaki düzensizlikler ve bazı ince kırışıklıklar uygun bakımla
          iyileşebilir. Ancak yıllar içinde yüzümüzde yalnızca cilt değişmiyor. Cilt altındaki yağ dokusu
          azalabiliyor, yüzün bazı bölgelerinde hacim kaybı oluşuyor ve dokular aşağı doğru yer
          değiştirebiliyor.<sup><a href="#kaynak-20">[20]</a><a href="#kaynak-21">[21]</a></sup>
        </p>
        <p>
          Bir kremden yanaklardaki hacim kaybını düzeltmesini veya sarkmış çene hattını eski yerine
          getirmesini bekleyemeyiz. Ürün ne kadar pahalı olursa olsun bu değişmiyor.
        </p>
        <p>
          Bazen hastanın kullandığı ürün aslında işe yarıyor ama kendisi ondan yapamayacağı bir şey
          bekliyor.
        </p>
        <p>
          Ben bu nedenle önce sorunun cildin yüzeyinde mi, yoksa daha derindeki yapısal değişikliklerde
          mi olduğunu ayırmaya çalışıyorum. Cilt bakımıyla iyileştirebileceğimiz bir durum varsa uygun
          bir rutin planlanabilir. Belirgin hacim kaybı veya sarkma söz konusuysa farklı dermatolojik ya
          da estetik seçenekleri değerlendirmek gerekebilir.
        </p>
        <p>
          <strong>
            Hastalarıma söylediğim şu: Kreminizin işe yaramamış olması mutlaka kötü bir ürün
            kullandığınız anlamına gelmiyor. Belki de kremden çözmesini beklediğiniz sorun, kremlerin
            düzeltebileceği bir sorun değil.
          </strong>
        </p>
        <p>
          Bu yazı cildin yüzeyine bakıyor. Hacim kaybı ve sarkma için
          seçenekler ayrı bir yazının konusu; ilgili okumalarda onlara ulaşabilirsiniz.
        </p>

        <h2 id="menopozda-cilt">Menopozda Cilt Ne Yaşıyor</h2>
        <p>
          Kışın cildin bir tık daha kuru geldiğini fark ettiniz mi? Menopozda bu his, hormonlarla
          mevsimin üst üste bindiği bir yerden geliyor olabilir.
        </p>
        <p>
          Cilt kolajeni ile östrojen eksikliği arasında güçlü bir ilişki olduğu bir derlemede
          belirtilmiş<sup><a href="#kaynak-11">[11]</a></sup>.
        </p>
        <p>
          Sayı vermem gerekirse: 1987 tarihli bir çalışmada, menopozdan sonra cilt kolajen içeriği ve
          cilt kalınlığının yılda yaklaşık yüzde 1-2 azaldığı bildirildi. Bu eski bir çalışma ve herkes
          için aynı hızı göstermez <Evidence level={2} /><sup><a href="#kaynak-10">[10]</a></sup>.
        </p>
        <p>
          Bir şey daha var. Kadınlardan alınan cilt örneklerinde, cildin kendi yağ tabakasını oluşturan
          lipitlerin, özellikle seramidlerin yaşla azaldığı ve kışın belirgin biçimde düştüğü
          görülmüştü <Evidence level={2} /><sup><a href="#kaynak-12">[12]</a></sup>. Atopik dermatite
          yatkın yetişkinlerde yapılan yakın tarihli bir çalışmada tablo bu kadar tek yönlü çıkmadı;
          bazı seramid sınıfları azalmak yerine arttı, zincir uzunlukları değişti<sup><a href="#kaynak-13">[13]</a></sup>.
        </p>
        <p>
          Kısaca: cildin yağ tabakası yaşla ve mevsimle değişiyor, ama nasıl değiştiği henüz tam
          oturmuş bir hikâye değil. Kışın kuruluğun derinleşmesi bu verilerle uyumlu.
        </p>

        <h2 id="kore-etiketi">Kore Etiketi ve İçerik Haritası</h2>
        <p>
          Etikette yazan ülke adı, içeriğin ne olduğunu anlatmaz.
        </p>
        <p>
          Kore kozmetik ürünleri arasında oldukça başarılı nemlendiriciler ve cilt bakım ürünleri var.
          Ancak bir kremin Kore'de üretilmiş olması, sarkmış cildi toparlayabileceği anlamına gelmiyor.
          İyi bir krem cildi nemlendirip daha dolgun ve pürüzsüz gösterebilir, bazı ince kırışıklıkları
          azaltabilir. Fakat belirgin yüz sarkmasını veya hacim kaybını ortadan kaldıramaz.
        </p>
        <p>
          <strong>
            Ben hastalarıma ürünün hangi ülkeden geldiğine değil, içeriğine ve gerçekten neyi
            düzeltebileceğine bakmalarını öneriyorum.
          </strong>
        </p>
        <p>
          Kore'nin Kozmetik Kanunu, cildin beyazlamasına, kırışıklıkların iyileşmesine ya da güneşin
          ultraviyole ışınlarından korunmaya yardımcı olduğu söylenen ürünleri de içeren
          "fonksiyonel kozmetik" adlı ayrı bir sınıf tanımlıyor<sup><a href="#kaynak-23">[23]</a></sup>. Bu, vaadin sizin
          cildinizde doğrulandığı anlamına gelmez; yalnızca ürünün ayrı bir düzenleme sınıfında olduğunu
          gösterir.
        </p>
        <p>
          "Cam cilt" güzel bir slogan ama bir ölçü birimi değil. Nemi cihazla ölçebiliriz, camı ölçemeyiz.
          Çalışmalarda gerçekte ölçülen şey cildin su tutması, yüzey pürüzlülüğü ve kırışıklık
          derinliğidir.
        </p>

        <p>
          Aşağıdaki tablo etikette en sık görülen maddeleri, vaatleriyle ve insanlarda ölçülmüş
          olanla yan yana koyuyor. Kanıt düzeyi, buraya alınan çalışmaların gücünü gösterir.
        </p>
        <div class="my-8 overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-primary/20 bg-primary/5 text-ink font-serif">
                <th class="p-3 font-semibold">İçerik</th>
                <th class="p-3 font-semibold">Sık görülen vaat</th>
                <th class="p-3 font-semibold">İnsanlarda ölçülen</th>
                <th class="p-3 font-semibold">Kanıt</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-primary/10">
              <tr>
                <td class="p-3 font-medium">Güneş koruyucu</td>
                <td class="p-3">Yaşlanmayı geciktirir</td>
                <td class="p-3">Günlük kullanan 55 yaş altı 903 yetişkinde 4,5 yılda deri yaşlanması yaklaşık dörtte bir daha az <sup><a href="#kaynak-1" class="text-primary hover:underline">[1]</a></sup></td>
                <td class="p-3"><Evidence level={4} /></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Retinol ve retinoidler</td>
                <td class="p-3">Kırışıklığı azaltır</td>
                <td class="p-3">%0,075 retinol kremi, 26 hafta, orta yaşlı Japon kadınlar: ince kırışıklıkta 54 kadının 27’sinde (%50), etkin madde içermeyen karşılaştırma kremi tarafında 13’ünde (%24) iyileşme görüldü; üç kişi tahriş nedeniyle çalışmadan ayrıldı. Reçeteli tretinoinde düşük ve yüksek doz benzer iyileşme verdi, tahriş farklıydı <sup><a href="#kaynak-2" class="text-primary hover:underline">[2]</a><a href="#kaynak-3" class="text-primary hover:underline">[3]</a></sup></td>
                <td class="p-3"><Evidence from={3} to={4} /></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Niasinamid</td>
                <td class="p-3">Leke, çizgi, ton</td>
                <td class="p-3">%5, 12 hafta, 50 kadın, yüzün iki yarısı: çizgi, leke, kızarıklık, sararma ve elastikiyette iyileşme <sup><a href="#kaynak-4" class="text-primary hover:underline">[4]</a></sup></td>
                <td class="p-3"><Evidence from={2} to={3} /></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Hyalüronik asit</td>
                <td class="p-3">Dolgunluk, nem</td>
                <td class="p-3">60 günde 76 kadında göz çevresinde nem ve elastikiyet arttı; kırışıklık derinliği yalnızca düşük moleküler ağırlıklı formlarda azaldı. Yaşlılarda bacak derisinde 4 haftada nem arttı <sup><a href="#kaynak-5" class="text-primary hover:underline">[5]</a><a href="#kaynak-6" class="text-primary hover:underline">[6]</a></sup></td>
                <td class="p-3"><Evidence level={3} /></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Seramid</td>
                <td class="p-3">Bariyeri onarır</td>
                <td class="p-3">Yaşla ve kışla azalma verisi var. Olgun ciltte seramidli bakıma ilişkin uzman uzlaşısı var. Hassas ciltli 50 kişide altı haftalık karşılaştırmada belirli bir seramid içeren formül incelendi; sonuçlar tüm ürünlere veya menopozdaki cilde doğrudan genellenemez <sup><a href="#kaynak-12" class="text-primary hover:underline">[12]</a><a href="#kaynak-16" class="text-primary hover:underline">[16]</a><a href="#kaynak-24" class="text-primary hover:underline">[24]</a></sup></td>
                <td class="p-3"><Evidence level={2} /></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Centella</td>
                <td class="p-3">Yatıştırır, onarır</td>
                <td class="p-3">5 çift kör çalışmanın derlemesi, 172 kadın: göz çevresi ve dudak kırışıklığında iyileşme. Ürünler standart değil <sup><a href="#kaynak-7" class="text-primary hover:underline">[7]</a></sup></td>
                <td class="p-3"><Evidence level={2} /></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Salyangoz salgısı</td>
                <td class="p-3">Onarır, sıkılaştırır</td>
                <td class="p-3">25 kişi, 12 hafta: göz çevresi kırışıklığında iyileşme; katılımcılar cilt kalitesinde fark bildirmedi <sup><a href="#kaynak-8" class="text-primary hover:underline">[8]</a></sup></td>
                <td class="p-3"><Evidence from={1} to={2} /></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Adenozin</td>
                <td class="p-3">Kırışıklığı azaltır</td>
                <td class="p-3">Çalışma krem değil, eriyen film formunda; 8 haftada yüzey pürüzlülüğünde azalma <sup><a href="#kaynak-9" class="text-primary hover:underline">[9]</a></sup></td>
                <td class="p-3"><Evidence level={1} /></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">PDRN</td>
                <td class="p-3">Yeniler, toparlar</td>
                <td class="p-3">7 randomize çalışmanın derlemesi, 183 katılımcı: en tutarlı yarar yara iyileşmesinde; yedi çalışmanın altısında enjeksiyon, mikroiğneleme veya lazer uygulaması vardı; yalnızca biri yara bölgesine sürülen merhemdi. Krem etkisi bu derlemeden çıkarılamıyor <sup><a href="#kaynak-17" class="text-primary hover:underline">[17]</a></sup></td>
                <td class="p-3"><Evidence level={1} /></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Ginseng</td>
                <td class="p-3">Canlandırır</td>
                <td class="p-3">Fermente siyah ginseng içeren kremle 23 kişide, 8 hafta boyunca yüzün iki yarısı karşılaştırıldı; göz çevresi kırışıklığı ölçüldü. Bu küçük çalışma diğer formüllere genellenemez <sup><a href="#kaynak-25" class="text-primary hover:underline">[25]</a></sup></td>
                <td class="p-3"><Evidence level={1} /></td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          Güneş koruyucuyla başlayalım, çünkü tablodaki en sıkıcı satır aynı zamanda en güçlü satır.
          Sıkıcıdır, çünkü ön yüzde şiir yazmaz; kanıtı vardır.
        </p>
        <p>
          Retinoidlerde de akılda tutulacak bir ayrım var. Etkisi olan bir madde tahriş de yapabilir,
          ama tahriş etkinin kanıtı değildir. Reçeteli tretinoinin iki dozu benzer iyileşme verirken
          tahriş farklı çıktı <sup><a href="#kaynak-3">[3]</a></sup>.
        </p>
        <p>
          Tablonun alt satırları için "işe yaramaz" demiyorum. "Henüz bilmiyoruz" ya da "bu çalışma sizin
          aldığınız kremi sınamamış" diyorum. Tablodaki ginseng satırı insanda küçük bir krem çalışmasına
          dayanıyor; fare ve hücre deneyleri ayrıca var.<sup><a href="#kaynak-18">[18]</a></sup> Çıkar bağlantısına da bakmak gerekir. Niasinamid çalışmasının yazarları bir tüketici ürünleri
          şirketinin araştırma laboratuvarından, adenozin çalışmasının yazarları ise bir kozmetik
          şirketinin araştırma biriminden. Güneş koruyucu çalışması kamu fonuyla yapıldı. Bu bağlantılar çalışmaları geçersiz kılmaz; sonuçları değerlendirirken araştırmacıların kurumları ve finansman bilgileri dikkate alınmalıdır.
        </p>

        <h2 id="seramid">Seramid Yazıyor Diye İş Bitmez</h2>
        <p>
          Seramid, etiketin en güvenli görünen kelimelerinden biri. Haklı bir nedenle: cildin kendi yağ
          tabakasının ana maddelerinden biri.
        </p>
        <p>
          Ama laboratuvardaki deneylerde seramid, kolesterol ve serbest yağ asidinden yalnızca birini ya
          da ikisini cilde sürmek bariyer onarımını geciktirdi. Üçü eşit oranda verilince onarım normale
          döndü <Evidence from={1} to={2} /><sup><a href="#kaynak-14">[14]</a></sup>. Bu çalışmalar
          ağırlıkla farede ve akut bariyer hasarı üzerinde yapıldı.
        </p>
        <p>
          Yaşlı ciltte ilginç bir bulgu çıktı. Kolesterolün baskın olduğu bir karışım, yaşlı farelerde ve
          80 yaş civarındaki insan derisinde bariyer onarımını daha hızlı kıldı. İnsan kolunda yalnızca
          6 kişi vardı, tek uygulama yapıldı ve ölçüm 6. saatte alındı <Evidence level={1} /><sup><a href="#kaynak-15">[15]</a></sup>.
        </p>
        <p>
          Bu yüzden elimde bir kural yok, bir soru var: <em>"Listede seramidin yanında kolesterol ve bir
          yağ asidi de var mı?"</em> Cevabın hayır olması ürünü mahkûm etmez; "seramid" kelimesinin tek başına yeterli güvence
          olmadığını hatırlatır.
        </p>
        <p>
          Etikette "NP", "AP", "EOP" gibi harfli adlar da görürsünüz. Bunlar seramidlerin eski numaralı
          adlarının yerini alan yeni adlandırma sisteminin parçası <sup><a href="#kaynak-19">[19]</a></sup>.
          Harfler molekülün yapısını anlatır; ürünün kalitesi hakkında bir şey söylemez. Hangi harfin cildinizde ne kadar
          fark yarattığını gösteren karşılaştırmalı bir çalışmaya rastlanmadı.
        </p>

        <h2 id="etiket-sorulari">Etikette Beş Soru ve Türkiye Kuralları</h2>
        <p>
          Kavanozun arkasını okurken beş soru çoğu zaman yeter.
        </p>
        <ul>
          <li><strong>Aktif madde hangisi?</strong> Ön yüzdeki vaat hangi maddeye dayanıyor?</li>
          <li><strong>Sırası nerede?</strong> Maddeler eklendikleri andaki ağırlıklarına göre büyükten küçüğe sıralanır; yüzde birin altındaki maddeler sonrasında herhangi bir sırayla yazılabilir.<sup><a href="#kaynak-22">[22]</a></sup></li>
          <li><strong>Vaat neyi ölçüyor?</strong> Nem mi, çizgi derinliği mi, yoksa ölçülemeyen bir "ışıltı" mı?</li>
          <li><strong>Çalışma kimde, ne kadar sürmüş?</strong> Kaç kişi, kaç hafta, kimin finanse ettiği.</li>
          <li><strong>Parfüm ve alerjen var mı?</strong> Hassaslaşmış ciltte tahrişe yol açabilir.</li>
        </ul>
        <p>
          Bu sorulara cevap bulamıyorsanız, üretici sorunuzu yanıtlamıyor demektir. Bu da başlı başına
          bir bilgidir.
        </p>

        <p>
          Kozmetik ürünün tanımı hastalığı tedavi etmeyi kapsamaz; kavanozdaki ifade bu sınırı aşmamalıdır.
        </p>
        <p>
          Türkiye'de kozmetik ürünler piyasaya sürülmeden önce, sorumlu kişi tarafından Türkiye İlaç ve Tıbbi Cihaz Kurumu'na elektronik
          bir veri tabanı üzerinden bildirilir. Yönetmeliğe göre kozmetik ürünün amacı temizlik, koku
          verme, görünümü değiştirme, koruma ve iyi durumda tutmaktır. Ürünün sahip olmadığı bir özelliği
          ya da işlevi ima eden ifadelerin ve görsellerin kullanılması yasaktır.<sup><a href="#kaynak-22">[22]</a></sup>
          Bir kremin "tedavi eder" ya da "sarkmayı toparlar" diye pazarlandığını görürseniz bir adım geri
          durun.
        </p>
        <p>
          Etikette sorumlu kişinin bilgileri, ürünün miktarı, son kullanma bilgisi ve özel uyarılar gibi
          bilgilerin Türkçe verilmesi gerekir.<sup><a href="#kaynak-22">[22]</a></sup> Türkçe etiketi
          olmayan ya da satıcısı belirsiz bir üründe içerik listesini doğrulamak zorlaşır; etiket
          sorularınız orada daha da önem kazanır.
        </p>

        <h2 id="sade-rutin">Menopozda Daha Az Ürün</h2>
        <p>
          Bence en sık yapılan hatalardan biri, cilt eski canlılığını kaybettikçe daha fazla ve daha
          güçlü ürün kullanmaya çalışmak.
        </p>
        <p>
          Menopozdan sonra östrojenin azalmasıyla cildin nem tutma kapasitesi, kolajen miktarı ve
          esnekliği değişebiliyor. Cilt daha kuru, ince ve hassas hâle gelebiliyor.
        </p>
        <p>
          Ama bazı kadınlar bunu düzeltmek için aynı anda asitler, peeling ürünleri, retinoidler ve
          farklı serumlar kullanmaya başlıyor. Sonuçta cilt daha iyi olmak yerine kızarıyor, yanıyor ve
          daha fazla kuruyor.
        </p>
        <p>Oysa bu dönemde bazen yapılacak en doğru şey bakım rutinini sadeleştirmek.</p>
        <p>
          Nazik bir temizleyici, cildin ihtiyacına uygun nemlendirme ve düzenli güneş koruması benim
          için temel adımlar. Retinoidler gibi etkili içerikler de kullanılabilir ama cildin toleransına
          göre, yavaş yavaş başlamak gerekiyor.
        </p>
        <p>
          Bir de güneş korumasını ihmal etmemek önemli. Çünkü menopozdaki hormonal değişikliklere yıllar
          boyunca biriken güneş hasarı da ekleniyor.
        </p>
        <p>
          <strong>
            Benim yaklaşımım, daha fazla ürün kullanmak değil, cildin gerçekten neye ihtiyacı olduğunu
            anlamak.
          </strong>
          Özellikle incelmiş ve hassaslaşmış bir ciltte bazen daha az ürünle daha iyi sonuç alabiliyoruz.
        </p>
        <p>
          Bu üç adım, yukarıdaki tablonun en sağlam satırlarıyla örtüşüyor: güneşten korunmak, nemi ve
          bariyeri gözetmek, etkili bir maddeyi tolerans izin verdiği hızda eklemek
          <sup><a href="#kaynak-1">[1]</a><a href="#kaynak-16">[16]</a></sup>.
        </p>

        <h2 id="islem-oncesi-sonrasi">Bir İşlem Planlıyorsanız</h2>
        <p>
          Bakım rutini, yapılacak işleme göre değişir.
        </p>
        <p>
          Öncelikle yapılacak işlemi bilmek isterim. Çünkü bir enjeksiyon uygulamasıyla lazer veya
          kimyasal peeling sonrasında cildin ihtiyaçları aynı değil.
        </p>
        <p>
          İşlem öncesinde benim için en önemli konu, cildin mümkün olduğunca sağlıklı ve tahriş olmamış
          durumda olması. Özellikle cildi kızarmış, soyulan veya aktif enfeksiyonu bulunan bir hastada
          önce bu sorunu çözmek gerekebilir.
        </p>
        <p>
          Kullanılan retinoidleri, asitleri ve diğer aktif ürünleri de işlem yapacak hekimle gözden
          geçirmek gerekiyor. Bazı uygulamalardan önce bunlara ara verilmesi istenebilir, ama bütün
          işlemler için geçerli tek bir kural yok.
        </p>
        <p>
          İşlemden sonra ise genellikle daha sade bir bakım öneriyorum. Cildi nazikçe temizlemek, uygun
          nemlendiricilerle korumak ve güneşten kaçınmak önemli. Özellikle cilt yüzeyini etkileyen
          işlemlerden sonra erken dönemde peeling veya tahriş edici ürünlere dönmek doğru değil.
        </p>
        <p>
          Kabuklanma oluşmuşsa koparmamak gerekiyor. Bazı işlemlerden sonra özel yara bakımı da
          gerekebilir. Bu nedenle uygulamayı yapan hekimin önerileri, genel bakım tavsiyelerinden her
          zaman daha önemli.
        </p>
        <RedFlagBox
          title="İşlem sonrasında normal sayılmayacak belirtiler"
          intro="Bir de hastalarıma kızarıklığın giderek artması, belirgin ağrı, iltihaplı akıntı veya ateş gelişmesi durumunda bunu normal iyileşme süreci olarak kabul etmemelerini söylüyorum."
