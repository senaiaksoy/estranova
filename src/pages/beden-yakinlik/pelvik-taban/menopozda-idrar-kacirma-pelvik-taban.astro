---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';

const route = '/beden-yakinlik/pelvik-taban/menopozda-idrar-kacirma-pelvik-taban';
const hero = submenuHeroByRoute[route]!;

// Yazıyı blog koleksiyonundan çek (Streamlit / pipeline buraya yazıyor).
const posts = await getCollection('blog');
const post = posts.find((p) => p.id === '2026-04-18-menopozda-idrar-kacirma-ve-pelvik-taban-sagligi');
if (!post) {
  throw new Error('Beklenen blog girdisi bulunamadı: 2026-04-18-menopozda-idrar-kacirma-ve-pelvik-taban-sagligi');
}
const { Content } = await render(post);

const formatDate = (value: string) =>
  new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }).format(
    new Date(value),
  );
const publishedDate = formatDate(post.data.date);
---

<SiteLayout
  title="Menopozda İdrar Kaçırma ve Pelvik Taban Sağlığı - Estranova"
  description="Menopoz geçişinde idrar kontrolündeki değişiklikler, pelvik taban sağlığı, değerlendirme zamanı ve Türkiye'de ulaşılabilir destek seçenekleri."
>
  <SiteNavbar currentPath="/beden-yakinlik" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Beden & Yakınlık · Kadın sağlığı"
      title="Menopozda İdrar Kaçırma ve Pelvik Taban Sağlığı"
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <section class="rounded-[28px] border border-burgundy/15 bg-white p-7 shadow-[0_16px_44px_-24px_rgba(44,24,28,0.14)] ring-1 ring-black/[0.04] md:p-8">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
          <div class="h-20 w-20 shrink-0 rounded-full bg-gradient-to-br from-[#E8DDD4] to-gold/35 ring-2 ring-burgundy/10" aria-hidden="true"></div>
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-burgundy">Estranova Editör Ekibi</p>
            <p class="text-xl font-semibold text-ink">Tıbben gözden geçirilmiş editöryal içerik</p>
            <p class="text-ink/70">40+ kadın sağlığı odaklı editöryal içerik</p>
            <p class="mt-2 text-sm text-ink/65">Yayın tarihi: {publishedDate} · Okuma süresi: 6 dakika</p>
          </div>
        </div>
      </section>

      <section class="rounded-[28px] border border-gold/35 bg-gradient-to-br from-white to-cream-soft/90 p-7 shadow-sm ring-1 ring-gold/22 md:p-8">
        <h2 class="mb-4 font-serif text-3xl">Kısa Özet</h2>
        <p class="leading-relaxed text-ink/80">{post.data.description}</p>
      </section>

      <ArticleProsePanel>
        <Content />
      </ArticleProsePanel>

      <RelatedReadings
          class="mt-14"
          paths={[
            '/beden-yakinlik/cinsel-saglik/mahrem-bolge-degisimleri-menopoz',
            '/beden-yakinlik/cinsel-saglik/cinsellikte-agri-menopoz',
            '/hormonal-gecis/menopoz/menopoz-nedir',
            '/zamansiz-yasam/hareket-saglik-menopoz',
          ]}
        />

      <section class="mt-14 rounded-[28px] border border-dashed border-burgundy/30 bg-white/60 p-6 text-sm text-ink/70 ring-1 ring-burgundy/10 md:p-8">
        <p>
          <strong>Önemli not:</strong> Bu içerik yalnızca genel bilgilendirme amacıyla hazırlanmıştır.
          Tıbbi tavsiye, tanı veya tedavi yerine geçmez. Sağlık durumunuzla ilgili kararlar için lütfen
          bir sağlık profesyoneliyle görüşün.
        </p>
      </section>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
