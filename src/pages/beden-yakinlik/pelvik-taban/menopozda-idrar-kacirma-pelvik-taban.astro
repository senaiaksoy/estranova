---
import { getEntry, render } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import SaveForLaterButton from '../../../components/site/SaveForLaterButton.astro';
import ReadingControls from '../../../components/site/ReadingControls.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import ArticleFAQ from '../../../components/site/ArticleFAQ.astro';
import Evidence, { type EvidenceLevel } from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { resolveSiteUrl } from '../../../utils/seo';
import type { Writer } from '../../../data/writers';

// Kanonik makale: içerik src/content/blog altındaki denetlenmiş kaynaktan gelir;
// eski /blog/ rotası bu sayfaya yönlendirilir (astro.config.mjs).
const pathname = '/beden-yakinlik/pelvik-taban/menopozda-idrar-kacirma-pelvik-taban/';
const post = await getEntry('blog', '2026-04-18-menopozda-idrar-kacirma-ve-pelvik-taban-sagligi');
if (!post) throw new Error('Menopozda idrar kaçırma içeriği bulunamadı.');
const { Content, headings } = await render(post);
const hero = submenuHeroByRoute[pathname]!;
const faqItems = post.data.faqItems ?? [];

const evidenceMarker = /<span data-article-evidence="([1-5])"><\/span>/g;
const renderedHtml = post.rendered?.html;
const bodyParts: Array<{ html: string; level?: undefined } | { html?: undefined; level: EvidenceLevel }> = [];
if (renderedHtml?.includes('data-article-evidence')) {
  let start = 0;
  for (const match of renderedHtml.matchAll(evidenceMarker)) {
    bodyParts.push({ html: renderedHtml.slice(start, match.index) });
    bodyParts.push({ level: Number(match[1]) as EvidenceLevel });
    start = match.index! + match[0].length;
  }
  bodyParts.push({ html: renderedHtml.slice(start) });
}

const tocEntries = [
  ...headings.filter((heading) => heading.depth === 2).map((heading) => ({ id: heading.slug, label: heading.text })),
  ...(faqItems.length && post.data.faqId ? [{ id: post.data.faqId, label: post.data.faqTitle ?? 'Sorular' }] : []),
];

const formatDate = (value: string) =>
  new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(value));

const siteUrl = resolveSiteUrl(Astro.site);
const writerSlug = post.data.writerSlug as Writer['slug'];
const articleSchemas = buildArticleSchemas({
  title: post.data.title,
  description: post.data.description,
  writerSlug,
  articleType: post.data.articleType,
  publishedDate: post.data.date,
  modifiedDate: post.data.modifiedDate,
  image: post.data.imageSrc,
  pathname,
  articleSection: 'Beden & Yakınlık',
  sectionPath: '/beden-yakinlik/',
  keywords: ['idrar kaçırma', 'üriner inkontinans', 'pelvik taban', 'stres tipi', 'sıkışma tipi', 'menopoz', 'kadın sağlığı'],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${post.data.title} - Estranova`}
  description={post.data.description}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/beden-yakinlik/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Beden & Yakınlık · Pelvik Taban"
      title={post.data.title}
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug={writerSlug}
        articleType={post.data.articleType}
        publishedDate={formatDate(post.data.date)}
        lastUpdated={post.data.modifiedDate ? formatDate(post.data.modifiedDate) : undefined}
        readingMinutes={6}
        imageSrc={post.data.imageSrc}
        imageAlt={post.data.imageAlt}
      />

      <div class="flex flex-wrap items-center justify-end gap-3">
        <ReadingControls />
        <SaveForLaterButton slug={pathname} title={post.data.title} />
      </div>

      {post.data.summary && (
        <ArticleSummary title="Kısa Klinik Yanıt">
          <p>{post.data.summary}</p>
        </ArticleSummary>
      )}

      <ArticleProsePanel>
        {bodyParts.length > 0
          ? bodyParts.map((part) => part.level !== undefined
            ? <Evidence level={part.level} />
            : <Fragment set:html={part.html} />)
          : <Content />}
      </ArticleProsePanel>

      {faqItems.length > 0 && (
        <ArticleFAQ
          items={faqItems}
          title={post.data.faqTitle}
          intro={post.data.faqIntro}
          id={post.data.faqId}
          class="mt-10"
        />
      )}

      {post.data.relatedPaths?.length && <RelatedReadings paths={post.data.relatedPaths} class="mt-14" />}

      {post.data.medicalEditorNote && (
        <ArticleEditorNote class="mt-10"><p>{post.data.medicalEditorNote}</p></ArticleEditorNote>
      )}

      {post.data.disclaimer && (
        <ArticleDisclaimer class="mt-10"><p>{post.data.disclaimer}</p></ArticleDisclaimer>
      )}
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
