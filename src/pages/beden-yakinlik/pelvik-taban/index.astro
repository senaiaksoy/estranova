---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuSection from '../../../components/site/SubmenuSection.astro';
import ChapterMasthead from '../../../components/site/ChapterMasthead.astro';
import EditorialEpigraph from '../../../components/site/EditorialEpigraph.astro';
import MarginaliaRail from '../../../components/site/MarginaliaRail.astro';
import MarginaliaItem from '../../../components/site/MarginaliaItem.astro';
import Asterism from '../../../components/site/Asterism.astro';
import ChapterCompass from '../../../components/site/ChapterCompass.astro';
import EditorPickCard from '../../../components/site/EditorPickCard.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { chapterMap, getNextChapter } from '../../../data/chapter-map';
import { subHubEpigraphs } from '../../../data/sub-hub-epigraphs';

const path = '/beden-yakinlik/pelvik-taban';
const hero = submenuHeroByRoute[path]!;
const chapter = chapterMap[path]!;
const epigraph = subHubEpigraphs[path];
const next = getNextChapter(path);

const editorPick = {
  href: '/beden-yakinlik/pelvik-taban/menopozda-idrar-kacirma-pelvik-taban',
  title: 'Menopozda İdrar Kaçırma ve Pelvik Taban',
  lede: 'Gülerken, hapşırırken o anlık kontrol kaybı — pek çoğumuz bunu kimseye söylemeden taşır. Konuşulmadıkça çözülmez.',
  writerSlug: 'berna-aksoy',
  readingMinutes: 8,
  image: submenuHeroByRoute['/beden-yakinlik/pelvik-taban/menopozda-idrar-kacirma-pelvik-taban']!,
};

const neighbors = [
  { href: '/beden-yakinlik/cilt-gorunum', title: 'Cilt & Görünüm', excerpt: 'Cildin hormonal yaşlanması; günlük bakım ve klinik destek seçenekleri.' },
  { href: '/beden-yakinlik/cinsel-saglik', title: 'Cinsel Sağlık', excerpt: 'Vajinal kuruluk, cinsellikte ağrı ve libido değişimleri.' },
];
---

<SiteLayout
  title="Pelvik Taban — Beden & Yakınlık - Estranova"
  description="İdrar kontrolü, duruş ve pelvik kasların menopozda değişimi; egzersiz, davranışsal stratejiler ve gerektiğinde tıbbi destek."
>
  <SiteNavbar currentPath="/beden-yakinlik" />

  <main id="main-content" class="text-ink">
    <ChapterMasthead number={chapter.number} parent={chapter.parent} chapter={chapter.chapter} />

    <SubmenuHero
      eyebrow="Sessiz çalışan kaslar"
      title="Pelvik Taban"
      lede="İdrar kontrolünde değişimler menopozda yaygın ama sessizce yaşanır. Pelvik taban; cinsel yaşam, duruş ve günlük rahatlık aynı sistemden geçer."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />

    <section class="border-b border-burgundy/10 bg-cream-soft px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <nav class="mb-10 text-sm text-ink/60" aria-label="İçerik yolu">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/beden-yakinlik" class="font-medium text-burgundy hover:underline">Beden & Yakınlık</a></li>
            <li aria-hidden="true">/</li>
            <li class="font-medium text-ink">Pelvik Taban</li>
          </ol>
        </nav>

        <div class="grid gap-12 lg:grid-cols-12 lg:items-start lg:gap-14">
          <div class="lg:col-span-8">
            <p class="editorial-dropcap mb-7 text-lg leading-relaxed text-ink/85 md:text-xl">
              Östrojen düşüşü pelvik dokuların gerginliğini ve kan akımını etkiler. Öksürürken,
              gülerken ya da egzersizde istemsiz kaçaklar; <strong class="font-semibold text-ink">yaşlanmanın kaderi değildir</strong>,
              çoğu zaman geriletilebilir. Aynı sistemde pelvik organ desteği, mahrem his ve
              duruş; üçü birden uzun yıllarca sessizce çalışıp, dengelendiği gün konuşur.
            </p>
            <p class="text-base leading-relaxed text-ink/72 md:text-lg">
              Doğru egzersiz protokolü, davranışsal stratejiler ve gerektiğinde tıbbi destek;
              bu üçü birlikte planlandığında günlük yaşam kalitesi belirgin biçimde artar.
              Önce bilgi, sonra plan.
            </p>
          </div>

          <div class="lg:col-span-4 lg:pt-1">
            <MarginaliaRail>
              <MarginaliaItem label="Yayın" value="Nisan 2026 · Düzenli güncellenir" />
              <MarginaliaItem label="Yaygınlık" emphasized="50+ kadınların yarısı en az bir form idrar kaçağı yaşar." />
              <MarginaliaItem label="Sık sorulanlar">
                <ul class="mt-2 space-y-3 text-sm leading-snug text-ink/78">
                  <li><span class="block font-semibold text-ink">Kegel egzersizi yeterli mi?</span>Çoğu zaman temel adımdır; doğru tekniğe ihtiyaç vardır.</li>
                  <li><span class="block font-semibold text-ink">Gerçekten geri dönüyor mu?</span>Çoğu vakada belirgin iyileşme mümkündür.</li>
                  <li><span class="block font-semibold text-ink">Ameliyat tek seçenek mi?</span>Hayır; cerrahi son aşamadır, önce konservatif yaklaşımlar.</li>
                </ul>
              </MarginaliaItem>
            </MarginaliaRail>
          </div>
        </div>
      </div>
    </section>

    {epigraph && <EditorialEpigraph quote={epigraph} />}

    <SubmenuSection variant="white" borderedTop={false}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Editör'ün Seçimi</p>
        <h2 class="font-serif text-3xl leading-tight md:text-4xl">Bu evreden bir okuma</h2>
      </header>

      <EditorPickCard
        href={editorPick.href}
        title={editorPick.title}
        lede={editorPick.lede}
        writerSlug={editorPick.writerSlug}
        readingMinutes={editorPick.readingMinutes}
        imageSrc={editorPick.image.src}
        imageAlt={editorPick.image.alt}
      />
    </SubmenuSection>

    <Asterism />

    <SubmenuSection variant="cream" borderedTop={false}>
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Aynı kategoride</p>
      <h2 class="mb-8 font-serif text-2xl md:text-3xl">İlgili alt başlıklar</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {neighbors.map((n) => (
          <a href={n.href} class="group rounded-[26px] border border-burgundy/12 bg-white p-7 transition hover:border-burgundy/28 hover:shadow-sm">
            <h3 class="mb-2 font-serif text-xl text-ink group-hover:text-burgundy">{n.title}</h3>
            <p class="mb-4 text-sm leading-relaxed text-ink/72">{n.excerpt}</p>
            <span class="text-sm font-semibold text-burgundy group-hover:underline">Sayfaya git →</span>
          </a>
        ))}
      </div>
    </SubmenuSection>

    <ChapterCompass nextHref={next?.href} nextNumber={next?.number} nextChapter={next?.chapter} nextParent={next?.parent} />
  </main>

  <SiteFooter />
</SiteLayout>
