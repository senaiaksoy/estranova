---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuSection from '../../../components/site/SubmenuSection.astro';
import EditorPickCard from '../../../components/site/EditorPickCard.astro';
import MagazineTOC from '../../../components/site/MagazineTOC.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';

const hero = submenuHeroByRoute['/beden-yakinlik/cinsel-saglik']!;

const editorPick = {
  href: '/beden-yakinlik/cinsel-saglik/libido-degisimi-menopoz',
  title: 'Menopozda Libido Değişimi — Sessiz Bir Konunun Açık Sözlü Rehberi',
  lede: 'Bu yazıyı yazmak için kimse gönüllü olmadı… Mahrem konuları yazmak çoğumuz için zor. Masaya ben oturdum — komşu sıcaklığıyla, jargonsuz.',
  writerSlug: 'senai-aksoy',
  readingMinutes: 10,
  image: submenuHeroByRoute['/beden-yakinlik/cinsel-saglik/libido-degisimi-menopoz'] ?? submenuHeroByRoute['/beden-yakinlik/cinsel-saglik']!,
};

const tocArticles = [
  {
    href: '/beden-yakinlik/cinsel-saglik/mahrem-bolge-degisimleri-menopoz',
    title: 'Vajinal Kuruluk Yaşlanmanın Sürprizi Değil — Bir İsmi Var: GSM',
    excerpt:
      'Postmenopozal kadınların yarısına yakını yaşıyor ama çoğu konuya bir isim koyamadığı için sessiz kalıyor. Genitoüriner menopoz sendromu (GSM) — lokal vs sistemik, kanıt sınırı ve günlük bakım.',
    writerSlug: 'senai-aksoy',
    readingMinutes: 7,
  },
  {
    href: '/beden-yakinlik/cinsel-saglik/cinsellikte-agri-menopoz',
    title: 'Cinsellikte Ağrı — Mahrem Bir Şikâyet, Açık Bir Tedavi Haritası',
    excerpt:
      'Disparoni tek bir tablo değil — yüzeysel, derin, postmenopozal, vajinismus alt-tipleri farklı tedavi yollarına çıkıyor. Üç kapılı tedavi haritası ve doktora ne sormak gerektiği.',
    writerSlug: 'senai-aksoy',
    readingMinutes: 8,
  },
];

const neighbors = [
  {
    step: '01',
    href: '/beden-yakinlik/cilt-gorunum',
    title: 'Cilt & Görünüm',
    excerpt: 'Cildin hormonal değişimi; kollajen, nem ve bariyer için sade bir bakım rehberi.',
  },
  {
    step: '02',
    href: '/beden-yakinlik/pelvik-taban',
    title: 'Pelvik Taban',
    excerpt: 'İdrar kontrolü ve pelvik kasların menopozda değişimi; pratik egzersiz rehberleri.',
  },
];
---

<SiteLayout
  title="Cinsel Sağlık — Beden & Yakınlık - Estranova"
  description="Vajinal kuruluk, cinsellikte ağrı ve libido değişimleri; menopozda en sessiz yaşanan başlıklara mahremiyetinizi yargılamayan bir okuma rehberi."
>
  <SiteNavbar currentPath="/beden-yakinlik" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Beden & Yakınlık · Cinsel Sağlık"
      title="Cinsel Sağlık"
      lede="Vajinal kuruluk, cinsellikte ağrı, libido değişimleri — menopozda en az konuşulan ama en sık aranan başlıklar. Konuşulmaması, çözümsüz olması anlamına gelmez."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />

    <section class="border-b border-burgundy/10 bg-[#fffaf0] px-6 py-14 md:py-18">
      <div class="mx-auto max-w-6xl">
        <nav class="mb-8 text-sm text-ink/60" aria-label="İçerik yolu">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/beden-yakinlik" class="font-medium text-burgundy hover:underline">Beden & Yakınlık</a></li>
            <li aria-hidden="true">/</li>
            <li class="font-medium text-ink">Cinsel Sağlık</li>
          </ol>
        </nav>

        <div class="grid gap-12 lg:grid-cols-[1.12fr_0.88fr] lg:items-start lg:gap-16">
          <div>
            <p class="mb-6 max-w-3xl font-serif text-3xl italic leading-tight text-burgundy md:text-5xl">
              Mahrem olan, konuşulmadığında büyür; adını koyduğumuzda hafifler.
            </p>
            <p class="mb-5 text-lg leading-relaxed text-ink/82 md:text-xl">
              Vajinal dokuda incelme, doğal nemde azalma, cinsel ilişki sırasında konfor kaybı — menopozda yaygındır ve
              <strong class="font-semibold text-ink">utanılacak değil, çözülebilir</strong> bir başlıktır.
            </p>
            <p class="text-base leading-relaxed text-ink/72">
              Bu sayfa hekim dilinden çok, "bu konular hakkında bilgili biri" tonunda yazıldı. Tedavi kararları kişiseldir;
              burada amaç seçenekleri görmenizi ve doğru zamanda destek almak için cesareti bulmanızı sağlamak.
            </p>
          </div>

          <aside class="border-y border-burgundy/15 bg-white/62 p-7 md:p-8" aria-labelledby="intim-ozet">
            <h2 id="intim-ozet" class="mb-5 font-serif text-3xl leading-tight text-ink">Sık sorulanlar</h2>
            <ul class="space-y-4 text-sm leading-relaxed text-ink/78">
              <li class="border-b border-burgundy/10 pb-4">
                <span class="block font-semibold text-ink">Yaygın mı, yoksa benim sorunum mu?</span>
                Menopoz sonrası kadınların büyük çoğunluğu en az bir başlıkta yaşar; istatistik avantajınızda.
              </li>
              <li class="border-b border-burgundy/10 pb-4">
                <span class="block font-semibold text-ink">Tek seçenek hormon mu?</span>
                Hayır; nemlendiriciler, lokal düşük doz östrojen, davranışsal yaklaşımlar dahil çeşitli yollar var.
              </li>
              <li>
                <span class="block font-semibold text-ink">Ne zaman hekime gitmeli?</span>
                Günlük konforu etkilediğinde; kişisel değerlendirme için hekiminizle konuşmak iyi bir başlangıçtır.
              </li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-12 grid gap-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-end">
        <p class="text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Editör'ün Seçimi</p>
        <h2 class="font-serif text-4xl leading-[0.95] tracking-[-0.04em] md:text-6xl">Bu evreden bir okuma</h2>
      </header>

      <EditorPickCard
        href={editorPick.href}
        title={editorPick.title}
        lede={editorPick.lede}
        writerSlug={editorPick.writerSlug}
        readingMinutes={editorPick.readingMinutes}
        imageSrc={editorPick.image.src}
        imageAlt={editorPick.image.alt}
      />
    </SubmenuSection>

    <SubmenuSection variant="cream" borderedTop={true}>
      <header class="mb-12 grid gap-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-end">
        <p class="text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Bu Evrede Okumalar</p>
        <h2 class="font-serif text-4xl leading-[0.95] tracking-[-0.04em] md:text-6xl">Sayının diğer başlıkları</h2>
      </header>

      <MagazineTOC items={tocArticles} />
    </SubmenuSection>

    <SubmenuSection variant="cream" borderedTop={true}>
      <header class="mb-10 grid gap-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-end">
        <p class="text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Aynı kategoride</p>
        <h2 class="font-serif text-4xl leading-[0.95] tracking-[-0.04em] md:text-6xl">İlgili alt başlıklar</h2>
      </header>
      <div class="divide-y divide-burgundy/14 border-y border-burgundy/14">
        {neighbors.map((n) => (
          <a href={n.href} class="group grid gap-5 py-7 transition hover:bg-white/58 md:grid-cols-[88px_1fr_auto] md:items-center md:py-8">
            <span class="font-serif text-3xl italic text-gold">{n.step}</span>
            <div>
              <h3 class="mb-2 font-serif text-3xl leading-tight text-ink group-hover:text-burgundy">{n.title}</h3>
              <p class="max-w-2xl text-sm leading-relaxed text-ink/72">{n.excerpt}</p>
            </div>
            <span class="text-2xl text-gold transition group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </SubmenuSection>

    <section class="bg-white px-6 py-10">
      <div class="mx-auto max-w-4xl rounded-[20px] border border-burgundy/12 p-6 text-center">
        <p class="text-sm leading-relaxed text-ink/75">
          Bu sayfa genel bilgilendirme sunar; bireysel uygulama veya tedavi kararları için tıbbi değerlendirme yerine geçmez.
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
