];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Vajinal Kuruluk Yaşlanmanın Sürprizi Değil — Bir İsmi Var: GSM';
const seoTitle = 'Vajinal Kuruluk: Bir İsmi Var — GSM';
const articleDescription =
  'Menopozda vajinal kuruluk ve idrar yolu yakınmaları GSM ile ilişkili olabilir. Belirtiler, lokal östrojenin sınırları, günlük bakım ve hekimle görüşme rehberi.';
const faqItems = articleFaqs['/beden-yakinlik/cinsel-saglik/mahrem-bolge-degisimleri-menopoz/'] ?? [];
const articleSchemas = buildArticleSchemas({
