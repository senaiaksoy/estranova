import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../../components/site/ArticleFAQ.astro';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { articleFaqs } from '../../../data/article-faqs';
import { resolveSiteUrl } from '../../../utils/seo';

const hero = submenuHeroByRoute['/beden-yakinlik/cinsel-saglik/mahrem-bolge-degisimleri-menopoz/']!;

const tocEntries = [
  { id: 'isim-koymak', label: 'GSM — İsim Koymakla Başlar' },
  { id: 'belirtiler', label: 'Belirti Manzarası: Vajinal ve Üriner Yakınmalar' },
  { id: 'mekanizma', label: 'Mekanizma — Östrojen Azalması ve Doku Yanıtı' },
  { id: 'lokal-sistemik', label: 'Lokal ve Sistemik Hormon: Aynı Kelime, Farklı Yaklaşım' },
  { id: 'umut-vs-kanit', label: 'Lazer ve Radyofrekans — Umut ile Kanıt Sınırı' },
  { id: 'gunluk-bakim', label: 'Günlük Bakım: Sade ve Tutarlı Adımlar' },
