import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import SaveForLaterButton from '../../../components/site/SaveForLaterButton.astro';
import ReadingControls from '../../../components/site/ReadingControls.astro';
import RedFlagBox from '../../../components/site/RedFlagBox.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../../components/site/ArticleFAQ.astro';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { articleFaqs } from '../../../data/article-faqs';
import { resolveSiteUrl } from '../../../utils/seo';

const hero = submenuHeroByRoute['/beden-yakinlik/cinsel-saglik/cinsellikte-agri-menopoz/']!;

const tocEntries = [
  { id: 'isim-koymak', label: 'Ağrıyı Konuşmak ve Adlandırmak' },
  { id: 'alt-tipler', label: 'Ağrının Yeri ve Olası Nedenleri' },
  { id: 'degerlendirme', label: 'Muayenede Adım Adım Değerlendirme' },
  { id: 'tedavi-haritasi', label: 'Nedene Göre Tedavi Seçenekleri' },
  { id: 'iletisim-sureci', label: 'Tedavi Sürecinde Partner ve Hekimle İletişim' },
  { id: 'kaynaklar', label: 'Kaynaklar' },
  { id: 'sik-sorulanlar', label: "Dr. Aksoy'a Sorular" },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Cinsellikte Ağrı — Menopozda Disparoni Rehberi';
const seoTitle = 'Cinsellikte Ağrı — Menopozda Disparoni Rehberi';
const articleDescription =
  'Menopozda cinsel ilişkide ağrının (disparoni) olası nedenleri, muayenede değerlendirme ve lokal tedavi ile pelvik taban fizyoterapisi seçenekleri.';
const faqItems = articleFaqs['/beden-yakinlik/cinsel-saglik/cinsellikte-agri-menopoz/'] ?? [];
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'senai-aksoy',
  articleType: 'clinical-guide',
  publishedDate: '2 Mayıs 2026',
  modifiedDate: '29 Eylül 2026',
  pathname: '/beden-yakinlik/cinsel-saglik/cinsellikte-agri-menopoz/',
  articleSection: 'Beden & Yakınlık',
  sectionPath: '/beden-yakinlik/',
  keywords: ['cinsellikte ağrı', 'disparoni', 'dispareuni', 'vajinismus', 'GSM', 'menopoz', 'pelvik taban disfonksiyonu', 'vulvodini', 'lokal östrojen'],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/beden-yakinlik/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Beden & Yakınlık · Cinsel Sağlık"
      title="Cinsellikte Ağrı — Menopozda Disparoni Rehberi"
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="senai-aksoy"
        articleType="clinical-guide"
        publishedDate="2 Mayıs 2026"
        lastUpdated="29 Eylül 2026"
        readingMinutes={8}
        imageSrc="/images/library/editorial/by-vajinal-saglik.webp"
        imageAlt="Keten örtü üzerinde çiçek, su bardağı ve pamuklu dokular; menopozda cinsellikte ağrı yazısı için editoryal görsel"
      />

      <div class="flex flex-wrap items-center justify-end gap-3">
        <ReadingControls />
        <SaveForLaterButton
          slug="/beden-yakinlik/cinsel-saglik/cinsellikte-agri-menopoz/"
          title={articleTitle}
        />
      </div>

      <ArticleSummary title="Kısa Klinik Yanıt">
        <p>
          Menopozda cinsel ilişkide ağrı görülebilir; bunu yaşlanmanın kaçınılmaz bir parçası sayıp kabullenmeniz gerekmez.
          Tıbbi adı disparoni olan bu ağrı, vajina girişinde ya da daha derinde hissedilebilir.
          Tedavi altta yatan nedene göre seçilir; lokal tedaviler ve pelvik taban fizyoterapisi seçenekler arasındadır.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="isim-koymak">Ağrıyı Konuşmak ve Adlandırmak</h2>
        <p>
          Cinsel ilişkide ağrıyı konuşmak sizi utandırabilir; yine de bu, tek başınıza çözmeniz gereken bir sorun değildir.
          Hekiminizle ağrının nerede ve ne zaman başladığını konuşabilirsiniz.
        </p>
        <p>
          Bu ağrının tıbbi adı <strong>disparoni</strong>. Her ağrılı ilişki aynı nedenden kaynaklanmaz.
          Vajinal kuruluk, doku hassasiyeti ve pelvik taban kaslarındaki gerilim farklı değerlendirmeler gerektirebilir.
          Nedeni ayırt etmek, yalnızca bir kremle yetinmek yerine size uygun seçenekleri konuşmayı sağlar.
        </p>

        <h2 id="alt-tipler">Ağrının Yeri ve Olası Nedenleri</h2>
        <p>
          Ağrıyı vajina girişinde mi, daha derinde mi hissediyorsunuz? Ne zaman ortaya çıktığı da olası nedenleri ayırt etmeye yardımcı olur.
        </p>
        <p>
          <strong>Yüzeysel disparoni:</strong> Ağrının vajina girişinde veya dış genital bölgede hissedilmesidir. Menopozda
          doku incelmesi, kuruluk ve idrar yakınmalarıyla seyreden genitoüriner sendrom (GSM)<sup><a href="#kaynak-1" class="text-primary hover:underline">[1]</a></sup>,
          cilt hassasiyetleri veya giriş bölgesindeki enfeksiyonlar olası nedenlerdir.
        </p>
        <p>
          <strong>Derin disparoni:</strong> Ağrının alt karında, vajinal giriş derinleştikçe veya ilişki sonrasında
          hissedilmesidir. Endometriozis (rahim içini döşeyen dokuya benzer dokunun rahim dışında bulunması), miyomlar,
          adenomyozis (benzer dokunun rahmin kas tabakası içinde bulunması) ya da pelvik taban kaslarındaki
          kronik gerginlik değerlendirmede ele alınan nedenler arasındadır.
        </p>
        <p>
          <strong>Menopoz sonrası doku değişimleri:</strong> Östrojen seviyelerinin
          düşmesiyle vajinal dokular incelir, elastikiyetini kaybedebilir ve ilişki sırasında doku hassasiyeti ile yüzeysel
          çatlaklara yatkınlık artabilir. Bu aşamada lokal vajinal östrojen uygulamaları, kanıtlarla desteklenen tedavi
          seçenekleri arasında yer alır
          <Evidence level={5} /><sup><a href="#kaynak-4" class="text-primary hover:underline">[4]</a></sup>.
        </p>
        <p>
          <strong>Sonradan gelişen vajinismus:</strong> Vajinismus, giriş denemesinde pelvik taban kaslarının istemsizce kasılmasıyla ilişkilidir.
          Menopoz sonrasında kuruluk ve ağrıya eşlik eden koruyucu kasılmalar da değerlendirmede ele alınır.
        </p>
        <p>
          Östrojenin azalmasıyla vajinal pH daha yüksek,
          yani daha alkali bir aralığa kayabilir<sup><a href="#kaynak-2" class="text-primary hover:underline">[2]</a></sup>.
          Bu değişimler ağrıya ve idrar yakınmalarına eşlik edebilir; enfeksiyon şüphesinde ayrıca değerlendirme gerekir.
          Ağrı beklentisine kasların istemsiz kasılması da eşlik edebilir. Doku değişimleriyle kas gerilimi bir aradaysa,
          yalnızca lokal kremlerle yetinmek yerine bu nedenleri birlikte ele almak gerekir.
        </p>

        <h2 id="degerlendirme">Muayenede Adım Adım Değerlendirme</h2>
        <p>
          Ağrının vajina girişinde mi yoksa daha derinde mi olduğunu, ilişki dışında yanma veya hassasiyet bulunup bulunmadığını sorarım.
          Her ağrıyı otomatik olarak kuruluğa bağlamam.
        </p>
        <p>
          <strong>Öykü:</strong> Görüşme öncesinde ağrının yerini, başlangıcını ve ne kadar süredir devam ettiğini not edebilirsiniz.
          Kuruluk, idrar yakınmaları veya kanama varsa bunları da belirtmeniz değerlendirmeye yardımcı olur.
        </p>
        <p>
          <strong>Kademeli fizik muayene:</strong> Kendinizi güvende ve rahat hissedebilmeniz için muayenenin kademeli ilerlemesi önemlidir.
          Dış genital bölgede dokunun incelmesi, cilt değişiklikleri ve küçük çatlaklar incelenir.
          Vajinal pH ölçümü değerlendirmede kullanılabilir. Derin ağrı varsa, ultrasonografiyle pelvisteki organlar değerlendirilebilir.
        </p>
        <p>
          <strong>Hedefe yönelik incelemeler:</strong> Belirtilere ve muayene bulgularına göre idrar tahlili veya derin ağrı için MR görüntüleme düşünülebilir.
          Dış genital bölgede şüpheli bir doku değişikliği varsa biyopsi, yani doku örneği alınması gerekebilir.
        </p>

        <h2 id="tedavi-haritasi">Nedene Göre Tedavi Seçenekleri</h2>
        <p>
          Tedavi seçimi ağrının nedenine bağlıdır. Doku hassasiyeti, kas gerilimi ve ağrıya eşlik eden korku için birden fazla destek gerekebilir.
        </p>
        <p>
          <strong>Doku incelmesi ve kuruluk için:</strong> Menopoz sonrası doku incelmesine bağlı ağrıda,
          hekim kontrolünde uygulanan lokal vajinal östrojenler (krem, tablet veya halka) sık değerlendirilen tedavi seçeneklerinden
          biridir <Evidence level={5} /><sup><a href="#kaynak-4" class="text-primary hover:underline">[4]</a></sup>. Lokal uygulamalarda sistemik emilim genellikle düşüktür; ancak
          sistemik hormon tedavisiyle aynı değerlendirme ölçütleri kullanılmaz. Özellikle hormon-duyarlı
          meme kanseri öyküsü olan kadınlarda düşük doz lokal vajinal östrojen kullanımı, hormon dışı seçeneklere yanıt alınamadığında
          jinekoloji ve onkoloji ekiplerinin ortak değerlendirmesiyle planlanmalıdır<sup><a href="#kaynak-3" class="text-primary hover:underline">[3]</a></sup>.
          Hormon dışı nemlendiriciler ve kayganlaştırıcılar da konforu artırmaya yardımcı olabilir.
        </p>
        <p>
          <strong>Kas gerilimi için:</strong> Pelvik taban kasları ağrıya katkıda bulunuyorsa, bu alanda uzmanlaşmış fizyoterapistlerin
          uyguladığı gevşeme egzersizleri ve elle uygulanan teknikler tedavi planına eklenebilir.
          Kas kaynaklı disparonide pelvik taban rehabilitasyonunu inceleyen bir çalışma yarar bildirmiştir
          <Evidence level={4} /><sup><a href="#kaynak-5" class="text-primary hover:underline">[5]</a></sup>.
          Bu çalışma vajinismusu dışlamıştır ve menopoz sonrası kadınlara özgü bir araştırma değildir.
        </p>
        <p>
          <strong>Ağrıya eşlik eden korku için:</strong> Ağrının uzun süre devam etmesiyle yerleşen korku-ağrı
          döngülerini ele almak için bazı kişilerde cinsel terapi veya psikolojik destek sürece eklenebilir.
        </p>
        <p>
          Derin ağrının altında endometriozis veya miyom gibi bir sorun varsa, bu nedene yönelik tıbbi ya da cerrahi seçenekler değerlendirilir.
          Sizin için uygun plan belirtilerinizle muayene bulguları birlikte ele alınarak belirlenir.
        </p>

        <h2 id="iletisim-sureci">Tedavi Sürecinde Partner ve Hekimle İletişim</h2>
        <p>
          Ağrı cinsel ilişkinizi de etkileyebilir. Partnerinizle ne hissettiğinizi konuşmak, bu dönemi birlikte anlamanıza yardımcı olabilir.
        </p>
        <p>
          Tedavi süresince vajinal giriş içermeyen cinsel yakınlık yollarını konuşabilirsiniz.
          Hekiminizle görüşürken de şu sorular size yol gösterebilir:
        </p>
        <ul>
          <li>Ağrının özellikleri hangi nedenleri düşündürüyor?</li>
          <li>Hangi yöntemleri, ne kadar süreyle uygulayacağız?</li>
          <li>Altta yatan diğer nedenler değerlendirildi mi?</li>
        </ul>
        <p>
          Takip aralığı kullanılan yönteme, belirtilerin seyrine ve hekiminizin değerlendirmesine göre değişir.
          Ağrının nasıl değiştiğini paylaşmanız, gerektiğinde tedavi planını yeniden ele almayı sağlar.
        </p>
      </ArticleProsePanel>

      <ArticleProsePanel mode="editorial" class="mt-10">
        <h2 id="kaynaklar">Kaynaklar</h2>
        <ol class="mt-4 space-y-3 text-sm text-ink/70 leading-relaxed list-decimal list-outside pl-5">
          <li id="kaynak-1">
            Portman DJ, Gass ML. "Genitourinary syndrome of menopause: new terminology for vulvovaginal atrophy from the International Society for the Study of Women's Sexual Health and the North American Menopause Society."
            <em>Menopause</em>. 2014;21(10):1063–1068.
            PMID: <a href="https://pubmed.ncbi.nlm.nih.gov/25160739/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">25160739</a>
            <span class="block mt-0.5 text-ink/50">(GSM terminolojisi, vulvovajinal atrofiyi tanımlayan konsensüs kriterleri.)</span>
          </li>
          <li id="kaynak-2">
            The 2020 Genitourinary Syndrome of Menopause Position Statement of The North American Menopause Society.
            <em>Menopause</em>. 2020;27(9):976–992.
            PMID: <a href="https://pubmed.ncbi.nlm.nih.gov/32852449/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">32852449</a>
            <span class="block mt-0.5 text-ink/50">(GSM zemininde vajinal pH yükselmesi, klinik bulgular ve hormonal patofizyoloji; urogenital semptomların yaygınlığı.)</span>
          </li>
          <li id="kaynak-3">
            ACOG Committee Opinion No. 659. "The Use of Vaginal Estrogen in Women With a History of Estrogen-Dependent Breast Cancer."
            <em>Obstet Gynecol</em>. 2016;127(3):e93–97.
            PMID: <a href="https://pubmed.ncbi.nlm.nih.gov/26901334/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">26901334</a>
            <span class="block mt-0.5 text-ink/50">(Meme kanseri öyküsü olan kadınlarda düşük doz vajinal östrojen kullanımının risk-fayda analizi.)</span>
          </li>
          <li id="kaynak-4">
            The 2022 Hormone Therapy Position Statement of The North American Menopause Society.
            <em>Menopause</em>. 2022;29(7):767–794.
            PMID: <a href="https://pubmed.ncbi.nlm.nih.gov/35797481/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">35797481</a>
            <span class="block mt-0.5 text-ink/50">(Lokal vajinal östrojen tedavisi, kanıt düzeyleri ve uzun vadeli güvenlik profili.)</span>
          </li>
          <li id="kaynak-5">
            Ghaderi F et al. "Pelvic floor rehabilitation in the treatment of women with dyspareunia: a randomized controlled clinical trial."
            <em>Int Urogynecol J</em>. 2019;30(11):1849–1855.
            PMID: <a href="https://pubmed.ncbi.nlm.nih.gov/31286158/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">31286158</a>
            <span class="block mt-0.5 text-ink/50">(Kas kaynaklı disparonide pelvik taban rehabilitasyonunu inceleyen randomize çalışma; vajinismus dışlanmıştır, menopoz sonrası kadınlara özgü değildir.)</span>
          </li>
        </ol>
      </ArticleProsePanel>

      <RedFlagBox
        markers={[
          'Cinsel ilişki sonrası lekelenme veya tekrarlayan kanamalar',
          'Postmenopozal vajinal kanama (miktarı az olsa bile, nedeninin değerlendirilmesi için jinekolojik inceleme yapılmalıdır)',
          'Yan ağrısı veya ateşle birlikte görülen ağrılı ilişki şikâyeti',
          'Derin pelvik ağrı, adet sancısı ve kronik bağırsak/idrar yakınmalarının eşlik etmesi',
          'Vulva bölgesinde yeni ortaya çıkan lezyonlar, beyaz lekeler veya doku kalınlaşması',
          'Kötü kokulu akıntı veya dış genital bölgede yeni bir yara',
          'Lokal tedaviye rağmen belirtilerin devam etmesi veya kötüleşmesi (ayırıcı tanı tekrar değerlendirilmelidir)',
        ]}
        footnote="Bu liste teşhis amaçlı olmayıp, bir hekimle vakit kaybetmeden görüşülmesi gereken durumları hatırlatmak amacıyla hazırlanmıştır."
      />

      <ArticleFAQ id="sik-sorulanlar" title="Dr. Aksoy'a sorular" intro="Dr. Senai Aksoy, cinsel ilişkide ağrı hakkında üç soruyu yanıtlıyor." items={faqItems} class="mt-10" />

      <RelatedReadings
        class="mt-14"
        paths={[
          '/beden-yakinlik/cinsel-saglik/mahrem-bolge-degisimleri-menopoz/',
          '/beden-yakinlik/cinsel-saglik/libido-degisimi-menopoz/',
          '/beden-yakinlik/pelvik-taban/menopozda-idrar-kacirma-pelvik-taban/',
          '/hormonal-gecis/menopoz/menopoz-nedir/',
        ]}
      />

      <ArticleEditorNote>
        <p class="mb-4 text-lg font-semibold text-ink">Bilimsel Değerlendirme ve İnceleme</p>
        <div class="space-y-3 leading-relaxed text-ink/80 text-sm">
          <p>
            Cinsel ilişkide ağrı, menopoz sonrası dönemde yaşam kalitesini ve duygusal iyilik halini etkileyebilir.
            Doku değişimleriyle ilişkili ağrı, genitoüriner sendromun belirtileri arasındadır<sup><a href="#kaynak-2" class="text-primary hover:underline">[2]</a></sup>.
          </p>
          <p>
            Östrojen azalmasıyla vajinal dokuda incelme, kollajen kaybı ve pH yükselmesi görülebilir.
            Buna bağlı yüzeysel ağrıda, düşük sistemik emilimli lokal vajinal östrojen tedavisi bir seçenek olabilir.
            Derin ağrıda ise endometriozis, adenomyozis veya pelvik taban kaslarındaki gerilim gibi nedenler
            jinekolojik değerlendirme ve gerektiğinde görüntülemeyle araştırılır.
          </p>
          <p>
            Ağrıya eşlik eden korku ve koruyucu kasılmaların da değerlendirilmesi gerekir. Belirtiler sürüyorsa pelvik taban
            fizyoterapisi ya da cinsel terapi, uygun kişilerde tedavi planına eklenebilir.
            Menopoz sonrası kanama veya lokal tedaviye rağmen süren yakınmalar, nedenin yeniden değerlendirilmesini gerektirir.
          </p>
          <p class="mt-4 border-t border-gold/30 pt-3 text-xs italic text-primary">
            — Dr. Alper Mumcu, Kadın Hastalıkları ve Doğum Uzmanı, Estranova Bilimsel Danışmanı
          </p>
        </div>
      </ArticleEditorNote>

      <ArticleDisclaimer>
        <p>
          Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme yerine geçmez. Tanı ve tedavi kararları için
          hekiminize başvurunuz.
        </p>
      </ArticleDisclaimer>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
