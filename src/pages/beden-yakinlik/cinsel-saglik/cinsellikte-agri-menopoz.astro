import { articleFaqs } from '../../../data/article-faqs';
import { resolveSiteUrl } from '../../../utils/seo';

const hero = submenuHeroByRoute['/beden-yakinlik/cinsel-saglik/cinsellikte-agri-menopoz/']!;

const tocEntries = [
  { id: 'isim-koymak', label: 'Disparoni Tek Bir Tablo Değil' },
  { id: 'alt-tipler', label: 'Dört Alt-Tip ve Biyolojik Nedenleri' },
  { id: 'degerlendirme', label: 'Muayenede Adım Adım Değerlendirme' },
  { id: 'tedavi-haritasi', label: 'Tedavi Haritası — Üç Temel Kapı' },
  { id: 'iletisim-sureci', label: 'Tedavi Sürecinde Partner ve Hekimle İletişim' },
  { id: 'kaynaklar', label: 'Kaynaklar' },
  { id: 'sik-sorulanlar', label: 'Sıkça Sorulanlar' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Cinsellikte Ağrı — Menopozda Disparoni Rehberi';
const seoTitle = 'Cinsellikte Ağrı — Menopozda Disparoni Rehberi';
const articleDescription =
  'Menopozda cinsel ilişkide ağrı (disparoni) ve alt-tipleri, vajinal kuruluk ile pelvik taban tedavilerini içeren sade klinik rehber.';
const faqItems = articleFaqs['/beden-yakinlik/cinsel-saglik/cinsellikte-agri-menopoz/'] ?? [];
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'senai-aksoy',
  articleType: 'clinical-guide',
  publishedDate: '2 Mayıs 2026',
  modifiedDate: '3 Ağustos 2026',
  pathname: '/beden-yakinlik/cinsel-saglik/cinsellikte-agri-menopoz/',
  articleSection: 'Beden & Yakınlık',
  sectionPath: '/beden-yakinlik/',
  keywords: ['cinsellikte ağrı', 'disparoni', 'dispareuni', 'vajinismus', 'GSM', 'menopoz', 'pelvik taban disfonksiyonu', 'vulvodini', 'lokal östrojen'],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/beden-yakinlik/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Beden & Yakınlık · Cinsel Sağlık"
      title="Cinsellikte Ağrı — Menopozda Disparoni Rehberi"
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="senai-aksoy"
        publishedDate="2 Mayıs 2026"
        lastUpdated="3 Ağustos 2026"
        readingMinutes={8}
        imageSrc="/images/library/editorial/by-vajinal-saglik.webp"
        imageAlt="Keten örtü üzerinde çiçek, su bardağı ve pamuklu dokular; menopozda cinsellikte ağrı yazısı için editoryal görsel"
      />

      <div class="flex flex-wrap items-center justify-end gap-3">
        <ReadingControls />
        <SaveForLaterButton
          slug="/beden-yakinlik/cinsel-saglik/cinsellikte-agri-menopoz/"
          title={articleTitle}
        />
      </div>

      <ArticleSummary title="Kısa Özet">
        <p>
          Menopozda cinsel ilişkide ağrı sık görülebilir; ancak normalleştirilmesi gereken bir durum değildir.
          Tıbbi adı disparoni olan bu şikâyet, yüzeysel veya derin olmak üzere farklı alt-tiplere ayrılır.
          Östrojen düşüşü, pelvik taban gerilimi veya diğer organik nedenlerin ayırt edilmesi, lokal tedaviler,
          fizyoterapi ve bütüncül yaklaşımlarla etkili çözümlere kapı açar.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="isim-koymak">Disparoni Tek Bir Tablo Değil — İsim Koymak</h2>
        <p>
          Hastalarımın çok büyük bir kısmı için cinsel ilişkide ağrı muayene odasında en geç dile getirilen şikâyetlerden biri.
          Çoğu kadın bunu kendi başına çözmesi gereken bir durum gibi taşıyor; bazıları yaşlanmanın getirdiği kaçınılmaz
          bir sonuç sayıp kabulleniyor, bazıları ise partneriyle olan bağını zedelememek adına sessiz kalmayı seçiyor.
          Oysa söz konusu olan, tıbbi bir adı ve alt-tipleri olan, etkili biçimde yönetilebilen bir tablodur: disparoni
          (cinsel ilişkide ağrı).
        </p>
        <p>
          Adı söylenmediği sürece tedavi seçenekleri de gündeme gelemiyor. Disparoninin tek bir tablodan ibaret olduğunu sanmak
          en yaygın yanılgılardan biridir; aslında en az dört farklı alt-tipi vardır ve her biri farklı bir mekanizmadan
          ve tedavi yaklaşımından geçer. Hangi alt-tipte olduğunu bilmek, doğru planı kurmanın ilk ve en önemli adımıdır.
        </p>

        <h2 id="alt-tipler">Dört Alt-Tip ve Biyolojik Nedenleri</h2>
        <p>
          Burada en önemli adım, ağrının tam olarak nerede ve ne zaman hissedildiğini netleştirmektir. Bu sorular, tablonun
          arkasındaki biyolojik nedenleri anlamamızı kolaylaştırır.
        </p>
        <p>
          <strong>Yüzeysel disparoni:</strong> Ağrı cinsel ilişkinin başlangıcında, dış genital bölgede veya vajen girişindedir.
          Genellikle menopoza bağlı doku incelmesi ve kurulukla seyreden genitoüriner sendrom (GSM)<sup><a href="#kaynak-1" class="text-primary hover:underline">[1]</a></sup>,
          lokal cilt sorunları veya vajen girişi hassasiyetlerine bağlı gelişir.
        </p>
        <p>
          <strong>Derin disparoni:</strong> Ağrı pelvis derinliğinde, ilişkinin ilerleyen aşamalarında veya sonrasında hissedilir.
          Endometriozis, adenomyozis, miyomlar veya pelvik taban kaslarındaki kronik spazm bu tabloda öncelikle değerlendirilen
          nedenler arasındadır.
        </p>
        <p>
          <strong>Postmenopozal disparoni:</strong> Yüzeysel tipin menopoza özel bir formudur. Östrojen seviyesinin kalıcı olarak
          düşmesiyle vajinal-vulvar epitel incelir, doku elastikiyeti azalır ve sürtünmeye bağlı mikro yırtık eğilimi oluşur.
          Bu tip için lokal vajinal östrojen uygulamaları, kanıt seviyesi en güçlü tedavi seçenekleri arasında yer alır
          <Evidence level={5} /><sup><a href="#kaynak-4" class="text-primary hover:underline">[4]</a></sup>.
        </p>
        <p>
          <strong>Sekonder Vajinismus:</strong> İlişki girişiminde pelvik taban kaslarının istemsiz ve refleksif olarak
          kasılmasıdır. Postmenopozal dönemde sekonder (sonradan gelişen) vajinismus, genellikle tedavi edilmemiş şiddetli
          kuruluk ve buna bağlı ağrının oluşturduğu bir korunma refleksi olarak ortaya çıkabilir.
        </p>
        <p>
          Postmenopozal dönemdeki bu değişimlerin temelinde hormon ritminin farklılaşması yatar. Östrojen düşüşüyle birlikte,
          vajinal pH alkali tarafa (normalde 3.5–4.5 seviyelerindeyken 5.0 ve üzerine) kayar<sup><a href="#kaynak-2" class="text-primary hover:underline">[2]</a></sup>.
          Bu durum hem yüzeysel ağrıya hem de tekrarlayan idrar yolu enfeksiyonlarına zemin hazırlar.
          Ağrı beklentisi zamanla pelvik taban kaslarında koruyucu bir refleks spazmı tetikleyebilir. Kas-zihin zinciri olarak
          adlandırılan bu durumu kırmak için sadece lokal nemlendiriciler yetmeyebilir; bütüncül bir plan gerekir.
        </p>

        <h2 id="degerlendirme">Muayenede Adım Adım Değerlendirme</h2>
        <p>
          Disparoni şikâyetinde klinik değerlendirme üç temel katmandan oluşur: ayrıntılı öykü, kademeli jinekolojik muayene
          ve gerekli durumlarda yardımcı ek incelemeler.
        </p>
        <p>
          <strong>Ayrıntılı öykü:</strong> Hekiminize başvurmadan önce ağrının özellikleri (girişte mi, derinde mi), başlangıç zamanı,
          ne kadar süredir devam ettiği ve akıntı, kuruluk ya da kanama gibi eşlik eden diğer yakınmaların varlığı hakkında
          hazırlık yapmanız süreci hızlandırır.
        </p>
        <p>
          <strong>Kademeli fizik muayene:</strong> Dış genital bölgede epitel atrofisi, liken sklerozus bulguları veya
          mikro çatlaklar gözlemlenir. Vajinal pH ölçümü, atrofiyi teyit etmekte pratik bir araçtır. Pelvik taban kaslarının
          tonusu dikkatle değerlendirilir. Derin disparoni şüphesinde, bimanuel muayene ve transvajinal ultrasonografi pelvik
          patolojileri değerlendirmek adına ek bilgiler sağlar.
        </p>
        <p>
          <strong>Yardımcı incelemeler:</strong> Belirtilerin niteliğine göre idrar tetkikleri, derin pelvik ağrı
          şüphelerinde MR incelemeleri veya şüpheli vulvar lezyonlarda biyopsi gibi ek adımlar plana dahil edilebilir.
        </p>

        <h2 id="tedavi-haritasi">Tedavi Haritası — Üç Temel Kapı</h2>
        <p>
          Ağrılı ilişkinin tedavisi, saptanan alt-tipe göre şekillenir ve genellikle üç temel yaklaşımın birini veya birkaçını
          içerir.
        </p>
        <p>
          <strong>Birinci kapı — Lokal medikal ve nemlendirici destekler:</strong> Postmenopozal atrofi zeminindeki tablolarda,
          hekim kontrolünde uygulanan lokal vajinal östrojen (krem, tablet veya halka formunda) en güçlü tedavi seçeneklerinden
          biridir <Evidence level={5} /><sup><a href="#kaynak-4" class="text-primary hover:underline">[4]</a></sup>. Düşük dozlu lokal uygulamalarda sistemik emilim oldukça
          sınırlıdır. Hormon dışı hyaluronik asit bazlı nemlendiriciler ve ilişki sırasında kullanılan kayganlaştırıcılar da konforu artırmada yardımcıdır.
        </p>
        <p>
          <strong>İkinci kapı — Pelvik taban fizyoterapisi:</strong> Pelvik taban kaslarında kronik spazm veya vajinismus reaksiyonu
          gelişen kadınlarda, bu alanda spesifik eğitim almış fizyoterapistlerce uygulanan gevşeme egzersizleri, manuel terapiler ve
          biofeedback yaklaşımları tedavinin önemli bir ayağını oluşturur <Evidence level={4} /><sup><a href="#kaynak-5" class="text-primary hover:underline">[5]</a></sup>.
        </p>
        <p>
          <strong>Üçüncü kapı — Psikolojik destek ve cinsel terapi:</strong> Ağrının uzun süre devam etmesiyle yerleşen korku-ağrı
          döngülerini kırmak, beden imajını desteklemek ve çift ilişkisini yapılandırmak amacıyla bilişsel davranışçı tabanlı
          terapiler sürece entegre edilebilir.
        </p>
        <p>
          Derin disparoniye yol açan endometriozis veya miyom gibi altta yatan organik sorunlarda ise bu sorunlara yönelik tıbbi
          veya cerrahi müdahaleler öncelik kazanır. Tedavi planı her zaman kişiye özel ihtiyaçlara göre belirlenmelidir.
        </p>

        <h2 id="iletisim-sureci">Tedavi Sürecinde Partner ve Hekimle İletişim</h2>
        <p>
          Ağrılı ilişki, ilişkisel uyumu doğrudan etkileyen bir durumdur. Partnerle ağrıyı gizlemeden, hisleri nazik ve açık bir
          dille paylaşmak, iyileşme sürecinin önemli bir parçasıdır.
        </p>
        <p>
          Tedavi süresince penetrasyon dışı yakınlık yollarını denemek, bedensel bağı koparmadan sürecin yönetilmesine yardımcı olur.
          İletişimi hekim boyutunda da doğru kurmak gerekir. Randevunuz sırasında hekiminize şu temel soruları yöneltebilirsiniz:
          Ağrımın özellikleri hangi alt-tipe işaret ediyor? Tedavide hangi yöntemleri, ne kadar süreyle (örneğin ilk klinik
          değerlendirme genellikle 4–12 haftalık periyotlarla yapılır) uygulayacağız? Altta yatan diğer organik nedenler ekarte edildi mi?
        </p>
        <p>
          Tedavi sürecinde sabırlı olmak ve planlanan adımları hekiminizin önerdiği sıklıkta takip etmek kalıcı çözümün anahtarıdır.
        </p>
      </ArticleProsePanel>

      <ArticleProsePanel class="mt-10">
        <h2 id="kaynaklar" style="counter-increment: none;">Kaynaklar</h2>
        <ol class="mt-4 space-y-3 text-sm text-ink/70 leading-relaxed list-decimal list-outside pl-5">
          <li id="kaynak-1">
            Portman DJ, Gass ML. "Genitourinary syndrome of menopause: new terminology for vulvovaginal atrophy from the International Society for the Study of Women's Sexual Health and the North American Menopause Society."
            <em>Menopause</em>. 2014;21(10):1063–1068.
            PMID: <a href="https://pubmed.ncbi.nlm.nih.gov/25160739/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">25160739</a> ·
            DOI: <a href="https://doi.org/10.1097/GME.0000000000000329" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">10.1097/GME.0000000000000329</a>
            <span class="block mt-0.5 text-ink/50">(GSM terminolojisi, vulvovajinal atrofiyi tanımlayan konsensüs kriterleri.)</span>
          </li>
          <li id="kaynak-2">
            The 2020 Genitourinary Syndrome of Menopause Position Statement of The North American Menopause Society.
            <em>Menopause</em>. 2020;27(9):976–992.
            PMID: <a href="https://pubmed.ncbi.nlm.nih.gov/32852449/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">32852449</a> ·
            DOI: <a href="https://doi.org/10.1097/GME.0000000000001609" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">10.1097/GME.0000000000001609</a>
            <span class="block mt-0.5 text-ink/50">(GSM zemininde vajinal pH yükselmesi, klinik bulgular ve hormonal patofizyoloji.)</span>
          </li>
          <li id="kaynak-3">
            ACOG Committee Opinion No. 659. "The Use of Vaginal Estrogen in Women With a History of Estrogen-Dependent Breast Cancer."
            <em>Obstet Gynecol</em>. 2016;127(3):e93–97.
            PMID: <a href="https://pubmed.ncbi.nlm.nih.gov/26901334/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">26901334</a>
            <span class="block mt-0.5 text-ink/50">(Meme kanseri öyküsü olan kadınlarda düşük doz vajinal östrojen kullanımının risk-fayda analizi.)</span>
          </li>
          <li id="kaynak-4">
            The 2022 Hormone Therapy Position Statement of The North American Menopause Society.
            <em>Menopause</em>. 2022;29(7):767–794.
            PMID: <a href="https://pubmed.ncbi.nlm.nih.gov/35797481/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">35797481</a> ·
            DOI: <a href="https://doi.org/10.1097/GME.0000000000002028" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">10.1097/GME.0000000000002028</a>
            <span class="block mt-0.5 text-ink/50">(Lokal vajinal östrojen tedavisi, kanıt düzeyleri ve uzun vadeli güvenlik profili.)</span>
          </li>
          <li id="kaynak-5">
            Pelvic floor rehabilitation in the treatment of women with dyspareunia: a randomized controlled clinical trial.
            <em>Int Urogynecol J</em>. 2019;30(7):1105–1112.
            PMID: <a href="https://pubmed.ncbi.nlm.nih.gov/30128827/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">30128827</a>
            <span class="block mt-0.5 text-ink/50">(Disparonide pelvik taban fizyoterapisi, gevşeme egzersizleri ve manuel terapilerin etkinliğini gösteren klinik çalışma.)</span>
          </li>
        </ol>
      </ArticleProsePanel>

      <RedFlagBox
        markers={[
          'Cinsel ilişki sonrası tekrarlayan kanamalar',
          'Postmenopozal vajinal kanama (miktarı az olsa bile, nedeninin değerlendirilmesi için jinekolojik inceleme yapılmalıdır)',
          'Yan ağrısı veya ateşle birlikte görülen ağrılı ilişki şikâyeti',
          'Derin pelvik ağrı, adet sancısı ve kronik bağırsak/idrar yakınmalarının eşlik etmesi',
          'Vulva bölgesinde yeni ortaya çıkan lezyonlar, beyaz lekeler veya doku kalınlaşması',
          'Lokal tedavilere rağmen 8–12 hafta boyunca yanıt alınamayan ağrılı durumlar (ayırıcı tanı tekrar değerlendirilmelidir)',
        ]}
        footnote="Bu liste teşhis amaçlı olmayıp, bir hekimle vakit kaybetmeden görüşülmesi gereken durumları hatırlatmak amacıyla hazırlanmıştır."
      />

      <ArticleFAQ id="sik-sorulanlar" items={faqItems} class="mt-10" />

      <RelatedReadings
        class="mt-14"
        paths={[
          '/beden-yakinlik/cinsel-saglik/mahrem-bolge-degisimleri-menopoz/',
          '/beden-yakinlik/cinsel-saglik/libido-degisimi-menopoz/',
          '/beden-yakinlik/pelvik-taban/menopozda-idrar-kacirma-pelvik-taban/',
          '/hormonal-gecis/menopoz/menopoz-nedir/',
        ]}
      />

      <ArticleEditorNote>
        <p class="mb-4 text-lg font-semibold text-ink">Bilimsel Değerlendirme ve İnceleme</p>
        <div class="space-y-3 leading-relaxed text-ink/80 text-sm">
          <p>
            Disparoni (cinsel ilişkide ağrı), postmenopozal dönemdeki kadınların yaşam kalitesini ve psikososyal iyilik
            halini doğrudan etkileyen, yaygınlığı %20-40 arasında tahmin edilen ancak klinikte yetersiz bildirilen
            önemli bir sağlık konusudur.
          </p>
          <p>
            Atrofiye bağlı yüzeysel disparonide temel mekanizma, östrojen eksikliği sonucu vajinal epitelin
            incelmesi, kollajen kaybı ve vajinal pH değerinin alkali seviyelere kaymasıdır. Bu biyolojik tablo,
            lokal vajinal östrojen gibi düşük sistemik emilimli hormonal tedavilere oldukça iyi yanıt verir.
            Derin disparonide ise endometriozis, adenomyozis veya kronik pelvik taban kas spazmları gibi organik
            faktörlerin jinekolojik değerlendirme ve görüntüleme yöntemleriyle ayırt edilmesi esastır.
          </p>
          <p>
            Cinsel ilişkiden kaçınma veya ağrıya rağmen devam etme davranışları, pelvik taban kaslarında koruyucu
            spazmları ve anksiyete döngülerini pekiştirir. Dolayısıyla, dirençli tablolarda pelvik taban
            fizyoterapisi ve bilişsel davranışçı cinsel terapilerin eş zamanlı kullanımı tedavinin etkinliğini
            belirgin şekilde artırmaktadır. Kırmızı bayrak olarak tanımlanan postmenopozal kanama veya lokal
            tedavilere yanıtsızlık durumlarında ileri incelemeler ihmal edilmemelidir.
          </p>
          <p class="mt-4 border-t border-gold/30 pt-3 text-xs italic text-primary">
            — Dr. Alper Mumcu, Kadın Hastalıkları ve Doğum Uzmanı, Estranova Bilimsel Danışmanı
          </p>
        </div>
      </ArticleEditorNote>

      <ArticleDisclaimer>
        <p>
          Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme yerine geçmez. Tanı ve tedavi kararları için
          hekiminize başvurunuz.
        </p>
      </ArticleDisclaimer>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
