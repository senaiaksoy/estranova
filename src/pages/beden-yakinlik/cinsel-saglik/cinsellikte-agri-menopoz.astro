---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { resolveSiteUrl } from '../../../utils/seo';

const hero = submenuHeroByRoute['/beden-yakinlik/cinsel-saglik/cinsellikte-agri-menopoz']!;

const tocEntries = [
  { id: 'tanim-yayginlik', label: 'Tanım ve Yaygınlık' },
  { id: 'fizyolojik-nedenler', label: 'Fizyolojik Nedenler' },
  { id: 'psikolojik-faktorler', label: 'Psikolojik Faktörler' },
  { id: 'non-medikal-tedavi', label: 'Non-Medikal Seçenekler' },
  { id: 'tibbi-tedavi', label: 'Tıbbi Tedavi' },
  { id: 'partner-katilimi', label: 'Partner Katılımı' },
  { id: 'terapist-danismasi', label: 'Terapist Danışması' },
  { id: 'uzun-vadeli', label: 'Uzun Vadeli Bakış' },
  { id: 'ilk-adimlar', label: 'İlk Adımlar' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Cinsellikte Ağrı — Menopozda Dispareuniya Rehberi';
const articleDescription = 'Menopozda cinsellikte ağrı veya rahatsızlığın nedenleri ve tedavi seçenekleri hakkında kapsamlı rehberlik.';
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'duygu-karaosmanoglu',
  publishedDate: '3 Nisan 2026',
  pathname: '/beden-yakinlik/cinsel-saglik/cinsellikte-agri-menopoz',
  articleSection: 'Beden & Yakınlık',
  sectionPath: '/beden-yakinlik',
  keywords: ['cinsellikte ağrı', 'cinsel ilişkide ağrı', 'disparoni', 'dispareuni', 'menopoz', 'mahrem bölge', 'vajinal kuruluk', 'hormon'],
  siteUrl,
});
---

<SiteLayout
  title={`${articleTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/beden-yakinlik" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Beden & Yakınlık · Cinsel Sağlık"
      title="Cinsellikte Ağrı — Menopozda Dispareuniya Rehberi"
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <SubmenuArticleBody>
        <ArticleTOC slot="toc" entries={tocEntries} />
        <ArticleAuthorBlock authorSlug="duygu-karaosmanoglu" publishedDate="3 Nisan 2026" readingMinutes={3} />

        <section class="rounded-[28px] border border-gold/35 bg-gradient-to-br from-white to-cream-soft/90 p-7 shadow-sm ring-1 ring-gold/22 md:p-8">
          <h2 class="mb-4 font-serif text-3xl">Kısa Özet</h2>
          <p class="leading-relaxed text-ink/80">
            Menopozda cinsellikte ağrı veya rahatsızlık yaygındır ve çoğunlukla tedavi edilebilir. Vajinal kuruluk, doku esnekliğinde kayıp ve psikolojik faktörler birleşir. Bilgilendirme ve tedavi seçenekleri cinsel yaşam deneyimini yeniden mümkün kılar.
          </p>
        </section>

        <ArticleProsePanel>
          <h2 id="tanim-yayginlik">Dispareuniya Tanımı ve Yaygınlığı</h2>
          <p>
            Dispareuniya, cinsel ilişki sırasında hissedilen ağrı veya rahatsızlıktır; çok yaygındır <Evidence level={5} />.
            Postmenopoz kadınlarının 20-40%'ı bu sorunu yaşar <Evidence level={5} />. Ağrı yüzeysel (giriş bölgesinde) veya derininde (iç bölgede) oluşabilir <Evidence level={5} />.
            Fiziksel ağrının ötesinde psikolojik etkiler vardır: kaygı ("ağrı olacağından endişe"), depresyon, ilişkilerde çatışma ve kendine güven kaybı <Evidence level={4} />.
          </p>
          <p>
            Ancak bu tamamen normal değildir ve tedavi edilebilir. Konuşmasının tabu olması, birçok kadının yalnız hissetmesine neden olmuştur.
            Aslında bu, menopozun yaygın ve yönetilebilir bir yönüdür.
          </p>

          <h2 id="fizyolojik-nedenler">Fizyolojik Nedenler</h2>
          <p>
            Birincil neden, östrojen azalmasına bağlı vajinal kuruluktur <Evidence level={5} />.
            Menopozda östrojen düşüşü, vajinal dokunun incelmesine, elastikiyet kaybına ve kolajen üretiminin azalmasına yol açar.
            Bu duruma "vulvovajinal atrofi" denir. Yağlayıcı üretimi azalır; doğal nem yoktur.
          </p>
          <p>
            Doku elastisitesi kaybı esnekliği sınırlandırır ve travma riskini artırır <Evidence level={5} />.
            Ayrıca, pH değişimi (daha alkalin) <Evidence level={5} /> doğal mikrobiyota dengesini etkiler ve enfeksiyonlara yatkınlık artırabilir.
            Endometriozis, rahim miyomları ve yumurtalık kistleri gibi tıbbi durumlar ağrıyı artırabilir <Evidence level={5} />.
            Enfeksiyonlar (mantar enfeksiyonları, UTI) veya pelvik tutukluluk ek risk faktörleridir.
          </p>

          <h2 id="psikolojik-faktorler">Psikolojik Faktörler</h2>
          <p>
            Beden imajında değişiklik ve özgüven azalması menopozda yaygındır <Evidence level={4} />.
            Cinsel ilişki sırasında kaygı ve performans baskısı ağrıyı artırabilir <Evidence level={5} />.
            Partnerle iletişim sorunları veya ilişki dinamikleri stresi artırabilir <Evidence level={4} />.
            Geçmiş travma, cinsel istismar veya olumsuz cinsel deneyimleri menopozda belirtileri şiddetlendirebilir <Evidence level={4} />.
            Stres ve yaşamsal yük vücut gerginliğini artırır, kas spazması tetikler ve ağrıyı süreklileştirir <Evidence level={5} />.
          </p>

          <h2 id="non-medikal-tedavi">İlaç Dışı Destek Seçenekleri</h2>
          <p>
            Diyalog ve eğitim ilk adımdır <Evidence level={5} />. Partnerle açık konuşma, sorunun fiziksel olduğunu açıklama ve
            performans baskısının yoğunluğunu azaltma önemlidir. Belirsizlik ve utanç, durumu daha da zorlaştırır.
          </p>
          <p>
            Su bazlı veya silikon bazlı yağlayıcılar faydalıdır <Evidence level={5} />. İlişki öncesi veya düzenli kullanım (haftada 2-3 kez) doku nemine katkı sağlayabilir.
            Nemlendirici krem (örneğin hyaluronik asit) uzun vadeli iyileşmeye yardımcı olabilir <Evidence level={5} />.
          </p>
          <p>
            Düzenli cinsel yaşam, kan akışını artırır ve doku iyileşmesine yardımcı olabilir <Evidence level={5} />.
            Ön sevişmeye ve acele etmemeye alan açmak doğal yağlanmayı teşvik eder <Evidence level={5} />.
            Farkındalıklı yaklaşım, beden farkındalığı ve rahatsızlığın normalleştirilmesi de önemlidir <Evidence level={4} />.
            İlişkide iletişimi iyileştirmek, stres azaltmak ve alternatif cinsel yaşam biçimlerini keşfetmek daha fazla esneklik sağlar.
          </p>

          <h2 id="tibbi-tedavi">Tıbbi Tedavi Seçenekleri</h2>
          <p>
            Lokal (yerel) hormon tedavisi çoğunlukla etkilidir <Evidence level={5} />.
            Doğrudan mahrem bölgeye uygulanan düşük doz hormon seçenekleri farklı formlarda — krem, tablet
            veya halka şeklinde — sunulur; sistemi minimal şekilde etkiledikleri için tercih edilebilir.
            Hormonun başka türevleriyle geliştirilmiş yeni seçenekler de yakın yıllarda gündeme girmiştir <Evidence level={5} />.
          </p>
          <p>
            Sistemik hormon tedavisi (ağız veya yama yoluyla) genel kullanım için tercih edilmişse, yan fayda
            olarak mahrem bölge belirtilerini de iyileştirebilir <Evidence level={5} />; ancak yalnızca bu konu
            için tercih edildiğinde lokal tedavi genellikle daha etkilidir.
          </p>
          <p>
            Hormon dışı lokal seçenekler de bulunur (örneğin hyaluronik asit, gliserin temelli formüller) <Evidence level={4} />.
            Ağız yoluyla alınan, östrojen reseptörü üzerinden etki gösteren reçeteli bir tedavi seçeneği de
            bazı kadınlar için uygun bulunabilir <Evidence level={4} />. Seçim, kişinin tıbbi geçmişi, tercihleri
            ve risk faktörlerine göre hekimle birlikte yapılmalıdır.
          </p>

          <h2 id="partner-katilimi">Partner Katılımı</h2>
          <p>
            Partner eğitimi menopozun etkileri, cinsellik fizyolojisi ve değişen ihtiyaçlar açısından önemlidir <Evidence level={5} />.
            Tedavi planına katılma (örneğin, yağlayıcı kullanmanın doğal ve normal olduğunu anlamak) uyumu artırır <Evidence level={5} />.
            Alternatif yakınlık formlarını (çok penetratif olmayan cinsellik biçimleri) keşfetmek alanı genişletir <Evidence level={5} />.
            Duygusal destek, sabır ve anlaşma, iyileşmenin temelini oluşturur <Evidence level={5} />.
          </p>

          <h2 id="terapist-danismasi">Seks Terapist veya Jinekoloji Danışması</h2>
          <p>
            Fiziksel tedaviler başlatıldıktan sonra belirtiler devam ederse seks terapist danışması yardımcı olabilir <Evidence level={5} />.
            Jinekoloji konusunda uzmanlaşmış hekim, tıbbi seçenekleri değerlendirmek için gereklidir <Evidence level={5} />.
            Psikolojik boyutu ele alan bir terapist (psikolog, danışman) veya seks terapist, ilişki ve beden imajı üzerinde çalışmaya yardımcı olur.
          </p>

          <h2 id="uzun-vadeli">Uzun Vadeli Perspektif</h2>
          <p>
            Bu ağrı, normal bir sağlık durumu değildir; tedavi edilebilir bir sorun olarak ele alınmalıdır <Evidence level={5} />.
            Cinsel yaşam, yaşlılıkta da desteklenerek kalitatif ve doyurucu kalabilir <Evidence level={5} />.
            Yaşlılıkta sağlıklı cinsel yaşam, kardiyovasküler sağlık, hormonal denge ve ruh hali için de destekleyici olabilir.
          </p>

          <h2 id="ilk-adimlar">Başlamak İçin İlk Adımlar</h2>
          <p>
            İlk adım çoğumuz için aynı: jinekoloğun ya da birinci basamak hekiminle bu konuyu paylaşmak.
            Belirtilerini açıkça anlatabilmek — utanç duymadan — büyük bir rahatlama getirir; basit bir fiziksel muayene çoğunlukla yeterli olur.
          </p>
          <p>
            Aynı dönemde su bazlı bir yağlayıcı edinmek ve ilişki öncesi kullanmak da küçük ama gerçek bir fark yaratabilir.
            Partnerinle duygu ve ihtiyaçlarını açık konuşmak, çözüme birlikte yaklaşmak yükü hafifletir.
            Tıbbi destek ve iletişim birlikte, cinsel yaşam deneyimini yeniden güvenli ve doyurucu kılabilir.
          </p>
        </ArticleProsePanel>

        <RelatedReadings
          class="mt-14"
          paths={[
            '/beden-yakinlik/cinsel-saglik/libido-degisimi-menopoz',
            '/beden-yakinlik/cinsel-saglik/mahrem-bolge-degisimleri-menopoz',
            '/zihin-denge/duygusal-denge/ruh-hali-degisimleri-menopoz',
            '/hormonal-gecis/menopoz/menopoz-nedir',
            '/beden-yakinlik/cilt-gorunum/menopozda-cilt-degisimleri',
          ]}
        />

        <section class="mt-14 rounded-[28px] border border-burgundy/15 border-l-[6px] border-l-gold bg-gradient-to-r from-cream-warm to-cream-soft p-7 shadow-sm ring-1 ring-burgundy/10 md:p-8">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.22em] text-burgundy">Bilimsel Editör Notu</p>
          <p class="mb-4 text-lg font-semibold text-ink">Kanıt Düzeyi: <Evidence level={5} /></p>
          <p class="leading-relaxed text-ink/80">
            Dispareuniya menopozun tabu konularından biridir ancak yaygındır ve tedavi edilebilir. Açık iletişim, basit müdahaleler ve gerekirse tıbbi tedavi, kadınların cinsel yaşam deneyimini yeniden mümkün kılar. Bu makale, konuşmasını ve çözüm aranmasını normalleştirmeyi amaçlar.
          </p>
        </section>

        <section class="mt-10 rounded-[24px] border border-dashed border-burgundy/25 bg-white/95 p-6 ring-1 ring-burgundy/10">
          <p class="text-sm leading-relaxed text-ink/75">
            Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavinin yerini almaz. Sağlık kararlarınız için
            kendi hekiminizle birlikte değerlendirme yapınız.
          </p>
        </section>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
