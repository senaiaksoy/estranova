  { id: 'sik-sorulanlar', label: 'Sık Sorulanlar' },
  { id: 'kaynaklar', label: 'Kaynaklar ve İleri Okuma' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Menopozda Libido Azalması: Nedenleri ve Ne Yapılabilir?';
const seoTitle = articleTitle;
const articleDescription =
  'Menopozda libido azalması neden olur? Hormonların, vajinal kuruluğun, uykunun, ilaçların ve ilişki dinamiklerinin etkisini ve destek seçeneklerini inceleyin.';
const faqItems = articleFaqs[route] ?? [];
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'senai-aksoy',
  articleType: 'clinical-guide',
  publishedDate: '27 Nisan 2026',
  modifiedDate: '2 Ağustos 2026',
  pathname: route,
  articleSection: 'Beden & Yakınlık',
  sectionPath: '/beden-yakinlik/',
  keywords: ['libido', 'cinsel istek', 'menopoz', 'GSM', 'lokal östrojen', 'testosteron', 'cinsel sağlık', '40+ kadın', 'mahrem sağlık'],
