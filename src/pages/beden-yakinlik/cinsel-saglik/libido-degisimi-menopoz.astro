const hero = submenuHeroByRoute[route] ?? {
  src: 'https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&q=80&w=1800&h=1000',
  alt: 'Menopoz döneminde beden ve yakınlık üzerine sakin bir editoryal yaşam sahnesi',
};

const tocEntries = [
  { id: 'acilis', label: 'Libido Azalması Ne Zaman Sorundur?' },
  { id: 'uc-ayri-soru', label: 'İstek, Uyarılma ve Ağrı Aynı Şey Değil' },
  { id: 'nedenler', label: 'Neden Tek Bir Hormon Değil?' },
  { id: 'degerlendirme', label: 'Değerlendirmede Neye Bakılır?' },
  { id: 'secenekler', label: 'Hangi Destek Ne Zaman Düşünülür?' },
  { id: 'testosteron', label: 'Testosteron Hakkında Net Sınırlar' },
