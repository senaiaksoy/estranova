---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import { releasedDossiers as dossiers, getTotalReadingMinutes } from '../../data/monthly-dossier';
import type { MonthlyDossier } from '../../data/monthly-dossier';
import { writers } from '../../data/writers';

export async function getStaticPaths() {
  return dossiers.map((dossier) => ({
    params: { slug: dossier.slug },
    props: { dossier },
  }));
}

interface Props {
  dossier: MonthlyDossier;
}

const { dossier } = Astro.props;
const curator = writers.find((w) => w.slug === dossier.curatorSlug);
const totalMinutes = getTotalReadingMinutes(dossier);

// Bu dosyada yazan benzersiz yazar listesi (küratör hariç) — alt bölüm
const contributingWriters = Array.from(
  new Set(dossier.articles.map((a) => a.writerSlug)),
)
  .filter((slug) => slug !== dossier.curatorSlug)
  .map((slug) => writers.find((w) => w.slug === slug))
  .filter((w): w is NonNullable<typeof w> => Boolean(w));

const editorNoteParagraphs = dossier.editorNote.split('\n\n').filter(Boolean);
const currentPath = `/dosya/${dossier.slug}/`;
---

<SiteLayout
  title={`${dossier.title} — ${dossier.monthYear} Dosyası | Estranova`}
  description={dossier.lede}
>
  <SiteNavbar currentPath={currentPath} />

  <main id="main-content" class="text-ink">
    {/* Kapak / Hero */}
    <section class="border-t border-burgundy/10 bg-gradient-to-b from-cream-warm to-cream-soft px-6 py-14 md:py-20">
      <div class="mx-auto max-w-5xl">
        <nav aria-label="Sayfa konumu" class="mb-6 text-xs uppercase tracking-[0.22em] text-ink/55">
          <a href="/" class="text-ink/65 hover:text-burgundy">Anasayfa</a>
          <span class="mx-2 text-gold">·</span>
          <a href="/dosya/" class="text-ink/65 hover:text-burgundy">Dosya</a>
          <span class="mx-2 text-gold">·</span>
          <span class="text-burgundy">{dossier.monthYear}</span>
        </nav>

        <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.28em] text-gold">
          {dossier.kicker}
        </p>
        <h1 class="mb-5 font-serif text-5xl leading-[1.05] text-burgundy md:text-6xl lg:text-7xl">
          {dossier.title}
        </h1>
        {dossier.subtitle && (
          <p class="mb-6 max-w-3xl font-serif text-2xl italic text-ink/70 md:text-3xl">
            {dossier.subtitle}
          </p>
        )}
        <p class="max-w-3xl text-lg leading-relaxed text-ink/80 md:text-xl">{dossier.lede}</p>

        <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs uppercase tracking-[0.2em] text-ink/60">
          {curator && (
            <span>
              Küratör: <span class="text-ink">{curator.displayName}</span>
            </span>
          )}
          <span class="text-gold" aria-hidden="true">·</span>
          <span>{dossier.articles.length} yazı</span>
          {totalMinutes > 0 && (
            <>
              <span class="text-gold" aria-hidden="true">·</span>
              <span>~{totalMinutes} dakika okuma</span>
            </>
          )}
        </div>
      </div>
    </section>

    {/* Kapak görseli */}
    <section class="bg-white px-6 pt-2 pb-10">
      <div class="mx-auto max-w-5xl">
        <figure class="overflow-hidden rounded-[28px] border border-burgundy/10 shadow-[0_20px_50px_-28px_rgba(44,24,28,0.35)]">
          <img
            src={dossier.heroImage.src}
            alt={dossier.heroImage.alt}
            width="1600"
            height="900"
            loading="eager"
            decoding="async"
            class="h-auto w-full object-cover"
          />
        </figure>
      </div>
    </section>

    {/* Küratör mektubu */}
    <section class="bg-white px-6 py-12 md:py-16">
      <div class="mx-auto max-w-3xl">
        <header class="mb-8">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
            Küratör Notu
          </p>
          {curator && (
            <div class="flex items-center gap-4">
              {curator.portrait && (
                <img
                  src={curator.portrait}
                  alt={`${curator.displayName} portresi`}
                  width="80"
                  height="80"
                  loading="lazy"
                  decoding="async"
                  class="h-16 w-16 rounded-full object-cover ring-1 ring-burgundy/15"
                />
              )}
              <div>
                <h2 class="font-serif text-2xl text-ink">{curator.displayName}</h2>
                <p class="font-serif text-sm italic text-ink/65">{curator.signaturePhrase}</p>
              </div>
            </div>
          )}
        </header>

        <div class="space-y-5">
          {editorNoteParagraphs.map((paragraph) => (
            <p class="text-lg leading-relaxed text-ink/80">{paragraph}</p>
          ))}
        </div>
      </div>
    </section>

    {/* Yazılar listesi */}
    <section class="border-t border-burgundy/10 bg-cream-soft px-6 py-14 md:py-20">
      <div class="mx-auto max-w-4xl">
        <header class="mb-10">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
            Bu Dosyadaki Yazılar
          </p>
          <h2 class="font-serif text-3xl leading-tight text-ink md:text-4xl">
            {dossier.articles.length} yazı, beş farklı kapı
          </h2>
        </header>

        <ol class="space-y-5">
          {
            dossier.articles.map((article, index) => {
              const writer = writers.find((w) => w.slug === article.writerSlug);
              const writerName = writer?.displayName ?? 'Estranova';
              const isPlanned = article.status === 'planned';
              const ArticleTag = !isPlanned && article.href ? 'a' : 'div';
              const articleProps = !isPlanned && article.href ? { href: article.href } : {};
              return (
                <li>
                  <ArticleTag
                    {...articleProps}
                    class:list={[
                      'group flex flex-col gap-3 rounded-[24px] border border-burgundy/12 bg-white p-6 shadow-sm transition md:flex-row md:gap-6 md:p-7',
                      !isPlanned && article.href
                        ? 'hover:-translate-y-0.5 hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2'
                        : 'opacity-95',
                    ]}
                  >
                    <div class="shrink-0 md:w-20">
                      <span class="font-serif text-4xl tabular-nums text-gold md:text-5xl">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                    </div>
                    <div class="min-w-0 flex-1">
                      {isPlanned && (
                        <p class="mb-2 inline-flex w-fit items-center rounded-full border border-gold/40 bg-cream-warm px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-burgundy/75">
                          Yakında
                        </p>
                      )}
                      <h3
                        class:list={[
                          'mb-2 font-serif text-2xl leading-snug text-ink md:text-[28px]',
                          !isPlanned && article.href && 'group-hover:underline group-hover:decoration-burgundy/35',
                        ]}
                      >
                        {article.title}
                      </h3>
                      <p class="mb-3 leading-relaxed text-ink/75">{article.excerpt}</p>
                      <p class="font-serif text-xs italic text-ink/60">
                        Yazan: <span class="text-ink/80">{writerName}</span>
                        {article.readingMinutes && (
                          <>
                            <span class="mx-1.5 text-gold">·</span>
                            <span>{article.readingMinutes} dakika</span>
                          </>
                        )}
                      </p>
                    </div>
                  </ArticleTag>
                </li>
              );
            })
          }
        </ol>
      </div>
    </section>

    {/* Bu sayıda yazanlar */}
    {contributingWriters.length > 0 && (
      <section class="border-t border-burgundy/10 bg-white px-6 py-14 md:py-16">
        <div class="mx-auto max-w-5xl">
          <header class="mb-8 max-w-2xl">
            <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
              Bu Sayıda Yazanlar
            </p>
            <h2 class="font-serif text-3xl leading-tight text-ink">
              Küratör seçimiyle bir araya gelen sesler
            </h2>
          </header>
          <ul class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-5">
            {
              contributingWriters.map((w) => (
                <li class="flex flex-col items-center text-center">
                  {w.portrait ? (
                    <img
                      src={w.portrait}
                      alt={`${w.displayName} portresi`}
                      width="160"
                      height="160"
                      loading="lazy"
                      decoding="async"
                      class="h-20 w-20 rounded-full object-cover ring-2 ring-burgundy/15 md:h-24 md:w-24"
                    />
                  ) : (
                    <div class="flex h-20 w-20 items-center justify-center rounded-full bg-cream-warm font-serif text-2xl text-burgundy ring-2 ring-burgundy/15 md:h-24 md:w-24">
                      {w.displayName
                        .split(/\s+/)
                        .filter((part) => part.length > 0)
                        .map((n) => n[0])
                        .join('')}
                    </div>
                  )}
                  <h3 class="mt-3 font-serif text-base text-ink">{w.displayName}</h3>
                  <p class="mt-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-burgundy/75">
                    {w.role.split('/')[0].trim()}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    )}

    {/* Tıbbi sorumluluk reddi */}
    <section class="border-t border-burgundy/10 bg-cream-soft px-6 py-10">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm leading-relaxed text-ink/70">
          Bu içerik genel bilgilendirme amaçlıdır; bireysel tıbbi değerlendirme, tanı veya tedavinin
          yerine geçmez. Kişisel sağlık kararları için doktorunuza danışınız.
        </p>
        <p class="mt-3 text-xs uppercase tracking-[0.22em] text-ink/55">
          <a href="/tibbi-sorumluluk/" class="hover:text-burgundy">Tıbbi Sorumluluk Reddi</a>
          <span class="mx-2 text-gold">·</span>
          <a href="/editoryal-politika/" class="hover:text-burgundy">Editöryal Politika</a>
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
