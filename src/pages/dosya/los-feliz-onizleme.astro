---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
---

<SiteLayout
  title="Modern Tipografi Testi - Estranova"
  description="Estranova icin daha modern tipografi kombinasyonlarini karsilastiran test sayfasi."
>
  <SiteNavbar currentPath="/dosya/los-feliz-onizleme" />

  <main id="main-content" class="bg-cream-soft text-ink">
    <section class="border-b border-burgundy/10 px-6 pb-14 pt-28 md:pb-18 md:pt-36">
      <div class="mx-auto max-w-6xl">
        <p class="mb-4 text-xs font-semibold uppercase tracking-[0.22em] text-burgundy">Modern Tipografi Testi</p>
        <h1 class="max-w-4xl font-serif text-5xl leading-[0.96] tracking-[-0.04em] text-ink md:text-7xl">
          Daha modern uc kombinasyon, yan yana
        </h1>
        <p class="mt-6 max-w-3xl font-serif text-xl italic leading-relaxed text-burgundy/78">
          Burada yalnizca su uc sistemi goruyorsunuz:
          <span class="text-ink"> Literata + Manrope, Fraunces + Manrope, Source Serif 4 + Plus Jakarta Sans.</span>
        </p>
      </div>
    </section>

    <section class="px-6 py-14 md:py-20">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-6 xl:grid-cols-3">
          <article class="rounded-[34px] border border-burgundy/12 bg-white p-7 shadow-[0_24px_80px_-62px_rgba(44,22,28,0.28)] ring-1 ring-black/[0.04]">
            <p class="mb-3 font-manrope text-[11px] uppercase tracking-[0.22em] text-burgundy">En dengeli modern</p>
            <h2 class="font-literata mb-4 text-[2.65rem] leading-[0.98] tracking-[-0.03em] text-ink">
              Literata + Manrope
            </h2>
            <p class="font-literata text-[2.15rem] leading-[0.99] tracking-[-0.025em] text-ink">
              İçgörü, ölçü ve güven aynı çizgide buluşabilir
            </p>
            <p class="font-manrope mt-5 text-[1.1rem] leading-relaxed text-ink/72">
              İçeriği incele · Sağlık · Zihin & Denge · Ölçülü geçiş
            </p>
            <p class="mt-5 border-t border-burgundy/10 pt-5 font-manrope text-[1rem] leading-relaxed text-ink/72">
              İ ı Ş Ğ Ç Ö Ü
            </p>
          </article>

          <article class="rounded-[34px] border border-burgundy/12 bg-white p-7 shadow-[0_24px_80px_-62px_rgba(44,22,28,0.28)] ring-1 ring-black/[0.04]">
            <p class="mb-3 font-manrope text-[11px] uppercase tracking-[0.22em] text-burgundy">En şık modern</p>
            <h2 class="font-fraunces mb-4 text-[2.7rem] leading-[0.96] tracking-[-0.03em] text-ink">
              Fraunces + Manrope
            </h2>
            <p class="font-fraunces text-[2.15rem] leading-[0.98] tracking-[-0.02em] text-ink">
              İçgörü, ölçü ve güven aynı çizgide buluşabilir
            </p>
            <p class="font-manrope mt-5 text-[1.1rem] leading-relaxed text-ink/72">
              İçeriği incele · Sağlık · Zihin & Denge · Ölçülü geçiş
            </p>
            <p class="mt-5 border-t border-burgundy/10 pt-5 font-manrope text-[1rem] leading-relaxed text-ink/72">
              İ ı Ş Ğ Ç Ö Ü
            </p>
          </article>

          <article class="rounded-[34px] border border-burgundy/12 bg-white p-7 shadow-[0_24px_80px_-62px_rgba(44,22,28,0.28)] ring-1 ring-black/[0.04]">
            <p class="mb-3 font-plus-jakarta text-[11px] uppercase tracking-[0.22em] text-burgundy">En güvenli modern</p>
            <h2 class="font-source-serif mb-4 text-[2.65rem] leading-[0.98] tracking-[-0.03em] text-ink">
              Source Serif 4 + Plus Jakarta Sans
            </h2>
            <p class="font-source-serif text-[2.15rem] leading-[0.99] tracking-[-0.025em] text-ink">
              İçgörü, ölçü ve güven aynı çizgide buluşabilir
            </p>
            <p class="font-plus-jakarta mt-5 text-[1.1rem] leading-relaxed text-ink/72">
              İçeriği incele · Sağlık · Zihin & Denge · Ölçülü geçiş
            </p>
            <p class="mt-5 border-t border-burgundy/10 pt-5 font-plus-jakarta text-[1rem] leading-relaxed text-ink/72">
              İ ı Ş Ğ Ç Ö Ü
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="border-t border-burgundy/10 px-6 py-14 md:py-20">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <p class="mb-4 text-xs font-semibold uppercase tracking-[0.22em] text-burgundy">Adobe Fonts Yonu</p>
          <h2 class="max-w-4xl font-serif text-4xl leading-[0.98] tracking-[-0.04em] text-ink md:text-5xl">
            Mevcut testlerin altinda, Adobe icin uc ek yon
          </h2>
          <p class="mt-5 max-w-3xl text-base leading-relaxed text-ink/72">
            Bu bolumde gercek Adobe renderi yok. Freight, Acumin ve Sofia'yi burada gorsel karar karti olarak
            listeliyoruz; birebir tipografik gorunum icin production'a Adobe kit baglanmasi gerekir.
          </p>
        </div>

        <div class="mt-10 grid gap-6 xl:grid-cols-3">
          <article class="rounded-[34px] border border-burgundy/12 bg-white p-7 shadow-[0_24px_80px_-62px_rgba(44,22,28,0.28)] ring-1 ring-black/[0.04]">
            <p class="mb-3 text-[11px] uppercase tracking-[0.22em] text-burgundy">En mantikli</p>
            <h3 class="font-serif text-[2.4rem] leading-[0.98] tracking-[-0.03em] text-ink">
              Freight Text + Acumin
            </h3>
            <p class="mt-5 font-serif text-[2rem] leading-[1.02] tracking-[-0.02em] text-ink">
              Icgoru, olcu ve guven ayni cizgide bulusabilir
            </p>
            <p class="mt-5 text-[1.02rem] leading-relaxed text-ink/72">
              Icerigi incele · Saglik · Zihin & Denge · Olculu gecis
            </p>
            <p class="mt-5 border-t border-burgundy/10 pt-5 text-[0.98rem] leading-relaxed text-ink/72">
              Turkce test: I i İ ı · S s Ş ş · G g Ğ ğ · C c Ç ç · O o Ö ö · U u Ü ü
            </p>
          </article>

          <article class="rounded-[34px] border border-burgundy/12 bg-white p-7 shadow-[0_24px_80px_-62px_rgba(44,22,28,0.28)] ring-1 ring-black/[0.04]">
            <p class="mb-3 text-[11px] uppercase tracking-[0.22em] text-burgundy">En modern premium</p>
            <h3 class="font-serif text-[2.4rem] leading-[0.98] tracking-[-0.03em] text-ink">
              Sofia + Freight
            </h3>
            <p class="mt-5 font-serif text-[2rem] leading-[1.02] tracking-[-0.02em] text-ink">
              Denge, sezgi ve sakinlik daha guncel bir ritimde bulusur
            </p>
            <p class="mt-5 text-[1.02rem] leading-relaxed text-ink/72">
              Icerigi incele · Belirti rehberi · Gecis donemi · Daha yumusak siluet
            </p>
            <p class="mt-5 border-t border-burgundy/10 pt-5 text-[0.98rem] leading-relaxed text-ink/72">
              Turkce test: I i İ ı · S s Ş ş · G g Ğ ğ · C c Ç ç · O o Ö ö · U u Ü ü
            </p>
          </article>

          <article class="rounded-[34px] border border-burgundy/12 bg-white p-7 shadow-[0_24px_80px_-62px_rgba(44,22,28,0.28)] ring-1 ring-black/[0.04]">
            <p class="mb-3 text-[11px] uppercase tracking-[0.22em] text-burgundy">En dengeli editoryal-modern</p>
            <h3 class="font-serif text-[2.4rem] leading-[0.98] tracking-[-0.03em] text-ink">
              Freight Text + Sofia
            </h3>
            <p class="mt-5 font-serif text-[2rem] leading-[1.02] tracking-[-0.02em] text-ink">
              Editoryal agirlik ile guncel akis arasinda temiz bir denge kurulur
            </p>
            <p class="mt-5 text-[1.02rem] leading-relaxed text-ink/72">
              Icerigi incele · Hormonlar · Uyku · Seckin ama sakin bir yuzey
            </p>
            <p class="mt-5 border-t border-burgundy/10 pt-5 text-[0.98rem] leading-relaxed text-ink/72">
              Turkce test: I i İ ı · S s Ş ş · G g Ğ ğ · C c Ç ç · O o Ö ö · U u Ü ü
            </p>
          </article>
        </div>

        <section class="mt-10 rounded-[34px] border border-burgundy/12 bg-white px-7 py-8 shadow-[0_24px_80px_-62px_rgba(44,22,28,0.28)] ring-1 ring-black/[0.04]">
          <p class="text-[11px] uppercase tracking-[0.22em] text-burgundy">Turkce Test Metinleri</p>
          <h3 class="mt-3 font-serif text-3xl leading-tight tracking-[-0.03em] text-ink">
            Kit baglandiginda once bu satirlara bakalim
          </h3>
          <div class="mt-6 grid gap-6 md:grid-cols-2">
            <div>
              <p class="text-sm uppercase tracking-[0.18em] text-burgundy/78">Harf kontrolu</p>
              <p class="mt-3 text-lg leading-relaxed text-ink">
                I i İ ı · S s Ş ş · G g Ğ ğ · C c Ç ç · O o Ö ö · U u Ü ü
              </p>
            </div>
            <div>
              <p class="text-sm uppercase tracking-[0.18em] text-burgundy/78">Kisa UI metinleri</p>
              <p class="mt-3 text-lg leading-relaxed text-ink">
                İçeriği incele · Sağlık · Ölçülü geçiş · Uyku düzeni · Zihin & Denge
              </p>
            </div>
            <div>
              <p class="text-sm uppercase tracking-[0.18em] text-burgundy/78">Baslik ritmi</p>
              <p class="mt-3 font-serif text-[1.8rem] leading-[1.08] tracking-[-0.02em] text-ink">
                Ölçülü değişim, sakin bir dil ve güven veren bir akış
              </p>
            </div>
            <div>
              <p class="text-sm uppercase tracking-[0.18em] text-burgundy/78">Govde akisi</p>
              <p class="mt-3 max-w-xl text-[1.04rem] leading-relaxed text-ink/74">
                Perimenopoz döneminde içerik dili ne kadar sakin ve okunaklı kalırsa, güven duygusu da o kadar
                kolay kuruluyor.
              </p>
            </div>
          </div>
        </section>
      </div>
    </section>

    <section class="border-t border-burgundy/10 px-6 py-14 md:py-20">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <p class="mb-4 text-xs font-semibold uppercase tracking-[0.22em] text-burgundy">Yeni Sans Yon</p>
          <h2 class="max-w-4xl font-serif text-4xl leading-[0.98] tracking-[-0.04em] text-ink md:text-5xl">
            Helvetica Neue ana ton, Culver City govde hissi
          </h2>
          <p class="mt-5 max-w-3xl text-base leading-relaxed text-ink/72">
            Burada Helvetica Neue'yi baslik ve ana sans hissi olarak, Culver City icin de onceki stand-in yaklasimiyla
            daha yumusak bir govde ritmi icinde test ediyoruz.
          </p>
        </div>

        <article class="mt-10 rounded-[34px] border border-burgundy/12 bg-white p-7 shadow-[0_24px_80px_-62px_rgba(44,22,28,0.28)] ring-1 ring-black/[0.04]">
          <p class="mb-3 text-[11px] uppercase tracking-[0.22em] text-burgundy">Helvetica Neue + Culver City hissi</p>
          <h3 class="font-helvetica-neue text-[2.8rem] leading-[0.94] tracking-[-0.04em] text-ink md:text-[3.4rem]">
            Olculu bir modernlik, daha net bir yayin dili kurabilir
          </h3>
          <p class="font-helvetica-neue mt-5 text-[1.18rem] leading-relaxed text-ink/76">
            İÇERİĞİ İNCELE · SAĞLIK · ZİHİN & DENGE · ÖLÇÜLÜ GEÇİŞ
          </p>
          <div class="mt-6 grid gap-4 md:grid-cols-3">
            <div class="rounded-[24px] border border-burgundy/10 bg-cream-soft/45 p-4">
              <p class="text-[10px] uppercase tracking-[0.18em] text-burgundy/78">Regular</p>
              <p class="font-helvetica-neue mt-3 text-[1.35rem] leading-snug text-ink">
                Ölçülü geçiş ve sakin bir akış
              </p>
            </div>
            <div class="rounded-[24px] border border-burgundy/10 bg-cream-soft/45 p-4">
              <p class="text-[10px] uppercase tracking-[0.18em] text-burgundy/78">Bold</p>
              <p class="font-helvetica-neue mt-3 text-[1.35rem] font-bold leading-snug text-ink">
                Ölçülü geçiş ve sakin bir akış
              </p>
            </div>
            <div class="rounded-[24px] border border-burgundy/10 bg-cream-soft/45 p-4">
              <p class="text-[10px] uppercase tracking-[0.18em] text-burgundy/78">Italic</p>
              <p class="font-helvetica-neue mt-3 text-[1.35rem] italic leading-snug text-ink">
                Ölçülü geçiş ve sakin bir akış
              </p>
            </div>
          </div>
          <div class="mt-8 grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
            <div>
              <p class="text-sm uppercase tracking-[0.18em] text-burgundy/78">Govde akisi</p>
              <p class="font-kulim-park mt-3 max-w-2xl text-[1.08rem] leading-relaxed text-ink/76">
                Perimenopoz doneminde sakin, okunakli ve guven veren bir akis kurmak istiyorsak govde yazisinin fazla
                stil gostermeden zarif kalmasi onemli. Bu yuzeyde Culver City yerine yakin ritimde bir stand-in ile
                metnin nefesini test ediyoruz.
              </p>
            </div>
            <div>
              <p class="text-sm uppercase tracking-[0.18em] text-burgundy/78">Turkce kontrolu</p>
              <p class="font-kulim-park mt-3 text-[1.02rem] leading-relaxed text-ink/74">
                İçeriği incele
                <br />
                Sağlık
                <br />
                Ölçülü geçiş
                <br />
                İ, ı, Ş, Ğ, Ç, Ö, Ü
              </p>
            </div>
          </div>
        </article>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,100..900,0..100,0..1&family=Kulim+Park:wght@300;400;500;600&family=Literata:opsz,wght@7..72,200..900&family=Manrope:wght@200..800&family=Plus+Jakarta+Sans:wght@200..800&family=Source+Serif+4:opsz,wght@8..60,200..900&display=swap');

  .font-literata {
    font-family: "Literata", serif;
  }

  .font-fraunces {
    font-family: "Fraunces", serif;
  }

  .font-source-serif {
    font-family: "Source Serif 4", serif;
  }

  .font-manrope {
    font-family: "Manrope", sans-serif;
  }

  .font-plus-jakarta {
    font-family: "Plus Jakarta Sans", sans-serif;
  }

  .font-helvetica-neue {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  .font-kulim-park {
    font-family: "Kulim Park", "Helvetica Neue", Helvetica, Arial, sans-serif;
  }
</style>
