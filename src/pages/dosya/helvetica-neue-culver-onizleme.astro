---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
---

<SiteLayout
  title="Helvetica Neue ve Culver City Onizleme - Estranova"
  description="Helvetica Neue ana sans ve Culver City govde hissini tek sayfada test eden onizleme."
>
  <SiteNavbar currentPath="/dosya/helvetica-neue-culver-onizleme" />

  <main id="main-content" class="bg-cream-soft text-ink">
    <section class="border-b border-burgundy/10 px-6 pb-14 pt-28 md:pb-20 md:pt-36">
      <div class="mx-auto max-w-6xl">
        <p class="mb-4 text-xs font-semibold uppercase tracking-[0.22em] text-burgundy">Tekli Tipografi Onizlemesi</p>
        <h1 class="max-w-5xl font-helvetica-neue text-5xl font-bold leading-[0.92] tracking-[-0.05em] text-ink md:text-7xl">
          Helvetica Neue ana yuzeyi tasiyor, govdede Culver City hissi daha sakin akiyor
        </h1>
        <p class="mt-6 max-w-3xl font-kulim-park text-[1.14rem] leading-relaxed text-ink/74">
          Bu sayfa yalnizca tek kombinasyona bakmak icin hazirlandi. Baslikta Helvetica Neue, govdede ise Culver City'ye
          yakin ritimde bir stand-in kullaniyoruz.
        </p>
      </div>
    </section>

    <section class="px-6 py-14 md:py-20">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
          <article class="rounded-[36px] border border-burgundy/12 bg-white p-8 shadow-[0_24px_80px_-62px_rgba(44,22,28,0.28)] ring-1 ring-black/[0.04] md:p-10">
            <p class="text-[11px] uppercase tracking-[0.22em] text-burgundy">Ana baslik ritmi</p>
            <h2 class="font-helvetica-neue mt-4 text-[2.9rem] font-bold leading-[0.92] tracking-[-0.05em] text-ink md:text-[4.4rem]">
              Olculu modernlik, daha net bir yayin dili kurabilir
            </h2>
            <p class="font-helvetica-neue mt-5 text-[1.05rem] uppercase tracking-[0.18em] text-ink/70">
              İÇERİĞİ İNCELE · SAĞLIK · ZİHİN & DENGE · ÖLÇÜLÜ GEÇİŞ
            </p>

            <div class="mt-8 grid gap-4 md:grid-cols-3">
              <div class="rounded-[24px] border border-burgundy/10 bg-cream-soft/45 p-4">
                <p class="text-[10px] uppercase tracking-[0.18em] text-burgundy/78">Regular</p>
                <p class="font-helvetica-neue mt-3 text-[1.35rem] leading-snug text-ink">
                  Ölçülü geçiş ve sakin bir akış
                </p>
              </div>
              <div class="rounded-[24px] border border-burgundy/10 bg-cream-soft/45 p-4">
                <p class="text-[10px] uppercase tracking-[0.18em] text-burgundy/78">Bold</p>
                <p class="font-helvetica-neue mt-3 text-[1.35rem] font-bold leading-snug text-ink">
                  Ölçülü geçiş ve sakin bir akış
                </p>
              </div>
              <div class="rounded-[24px] border border-burgundy/10 bg-cream-soft/45 p-4">
                <p class="text-[10px] uppercase tracking-[0.18em] text-burgundy/78">Italic</p>
                <p class="font-helvetica-neue mt-3 text-[1.35rem] italic leading-snug text-ink">
                  Ölçülü geçiş ve sakin bir akış
                </p>
              </div>
            </div>
          </article>

          <article class="rounded-[36px] border border-burgundy/12 bg-white p-8 shadow-[0_24px_80px_-62px_rgba(44,22,28,0.28)] ring-1 ring-black/[0.04] md:p-10">
            <p class="text-[11px] uppercase tracking-[0.22em] text-burgundy">Govde ritmi</p>
            <p class="font-kulim-park mt-4 text-[1.1rem] leading-relaxed text-ink/76">
              Perimenopoz doneminde sakin, okunakli ve guven veren bir akis kurmak istiyorsak govde yazisinin fazla stil
              gostermeden zarif kalmasi onemli. Bu yuzeyde Culver City yerine yakin ritimde bir stand-in ile metnin
              nefesini, satir akisini ve Turkce karakter dengesini okuyoruz.
            </p>
            <p class="font-kulim-park mt-5 text-[1.1rem] leading-relaxed text-ink/76">
              Ikinci paragrafta ritim biraz daha uzun tutuldu. Boylece govde yazi ailesinin yormadan okunup okunmadigi,
              satir sonlarinda sertlesip sertlesmedigi ve premium ama soguk olmayan bir his verip vermedigi daha net
              anlasilir.
            </p>

            <div class="mt-8 rounded-[24px] border border-burgundy/10 bg-cream-soft/45 p-5">
              <p class="text-[10px] uppercase tracking-[0.18em] text-burgundy/78">Turkce kontrolu</p>
              <p class="font-kulim-park mt-3 text-[1.06rem] leading-relaxed text-ink/74">
                İçeriği incele
                <br />
                Sağlık
                <br />
                Ölçülü geçiş
                <br />
                İ, ı, Ş, Ğ, Ç, Ö, Ü
              </p>
            </div>
          </article>
        </div>

        <section class="mt-8 rounded-[36px] border border-burgundy/12 bg-white p-8 shadow-[0_24px_80px_-62px_rgba(44,22,28,0.28)] ring-1 ring-black/[0.04] md:p-10">
          <p class="text-[11px] uppercase tracking-[0.22em] text-burgundy">Kisa karar notu</p>
          <p class="mt-4 max-w-4xl font-kulim-park text-[1.08rem] leading-relaxed text-ink/76">
            Eger hedef daha keskin, daha net ve daha modern bir editorial sistemse Helvetica Neue baslikta guclu duruyor.
            Govde tarafinda ise Culver City hissi, bu sertligi yumusatip daha yasayan bir okuma ritmi kurabilir.
          </p>
        </section>

        <section class="mt-8 rounded-[36px] border border-burgundy/12 bg-white p-8 shadow-[0_24px_80px_-62px_rgba(44,22,28,0.28)] ring-1 ring-black/[0.04] md:p-10">
          <p class="text-[11px] uppercase tracking-[0.22em] text-burgundy">Ayni His Icin Alternatifler</p>
          <h2 class="mt-4 max-w-4xl font-serif text-4xl leading-[0.96] tracking-[-0.04em] text-ink md:text-5xl">
            Referans kombinasyon ve Google Fonts muadilleri, yan yana
          </h2>
          <p class="mt-5 max-w-3xl font-kulim-park text-[1.06rem] leading-relaxed text-ink/74">
            Burada en solda hedef his olarak `Helvetica Neue + Culver City` var. Diger uc kart ise ayni modern,
            kontrollu ve editoryal sakinligi Google Fonts tarafinda ne kadar yakalayabildigimizi gosteriyor.
          </p>

          <div class="mt-10 grid gap-6 xl:grid-cols-2">
            <article class="rounded-[30px] border border-burgundy/12 bg-cream-soft/45 p-6">
              <p class="text-[10px] uppercase tracking-[0.18em] text-burgundy/78">Referans</p>
              <h3 class="font-helvetica-neue mt-3 text-[2.15rem] font-bold leading-[0.94] tracking-[-0.04em] text-ink">
                Helvetica Neue + Culver City
              </h3>
              <p class="font-helvetica-neue mt-4 text-[1rem] uppercase tracking-[0.16em] text-ink/70">
                İÇERİĞİ İNCELE · SAĞLIK · ÖLÇÜLÜ GEÇİŞ
              </p>
              <p class="font-kulim-park mt-5 text-[1.02rem] leading-relaxed text-ink/76">
                Perimenopoz doneminde sakin, net ve daha secili bir akisin korunmasi.
              </p>
            </article>

            <article class="rounded-[30px] border border-burgundy/12 bg-cream-soft/45 p-6">
              <p class="text-[10px] uppercase tracking-[0.18em] text-burgundy/78">En yakin his</p>
              <h3 class="font-manrope mt-3 text-[2.15rem] font-semibold leading-[0.94] tracking-[-0.04em] text-ink">
                Manrope + Kulim Park
              </h3>
              <p class="font-manrope mt-4 text-[1rem] uppercase tracking-[0.16em] text-ink/70">
                İÇERİĞİ İNCELE · SAĞLIK · ÖLÇÜLÜ GEÇİŞ
              </p>
              <p class="font-kulim-park mt-5 text-[1.02rem] leading-relaxed text-ink/76">
                Netlik yuksek kalirken govde ritmi daha yumuşak ve editorial bir yone gidiyor.
              </p>
            </article>

            <article class="rounded-[30px] border border-burgundy/12 bg-cream-soft/45 p-6">
              <p class="text-[10px] uppercase tracking-[0.18em] text-burgundy/78">Daha rafine</p>
              <h3 class="font-plus-jakarta mt-3 text-[2.15rem] font-semibold leading-[0.94] tracking-[-0.04em] text-ink">
                Plus Jakarta Sans + Kulim Park
              </h3>
              <p class="font-plus-jakarta mt-4 text-[1rem] uppercase tracking-[0.16em] text-ink/70">
                İÇERİĞİ İNCELE · SAĞLIK · ÖLÇÜLÜ GEÇİŞ
              </p>
              <p class="font-kulim-park mt-5 text-[1.02rem] leading-relaxed text-ink/76">
                Biraz daha zarif, biraz daha cilali; yine de gundelik okunurlugu kaybetmiyor.
              </p>
            </article>

            <article class="rounded-[30px] border border-burgundy/12 bg-cream-soft/45 p-6">
              <p class="text-[10px] uppercase tracking-[0.18em] text-burgundy/78">Daha notr</p>
              <h3 class="font-inter mt-3 text-[2.15rem] font-semibold leading-[0.94] tracking-[-0.04em] text-ink">
                Inter + Kulim Park
              </h3>
              <p class="font-inter mt-4 text-[1rem] uppercase tracking-[0.16em] text-ink/70">
                İÇERİĞİ İNCELE · SAĞLIK · ÖLÇÜLÜ GEÇİŞ
              </p>
              <p class="font-kulim-park mt-5 text-[1.02rem] leading-relaxed text-ink/76">
                En sade ve en risksiz cozum; karakter biraz azalir ama sistem dengeli kalir.
              </p>
            </article>
          </div>
        </section>

        <section class="mt-8 rounded-[36px] border border-burgundy/12 bg-white p-8 shadow-[0_24px_80px_-62px_rgba(44,22,28,0.28)] ring-1 ring-black/[0.04] md:p-10">
          <p class="text-[11px] uppercase tracking-[0.22em] text-burgundy">Ince Ayar Varyasyonlari</p>
          <h2 class="mt-4 max-w-4xl font-serif text-4xl leading-[0.96] tracking-[-0.04em] text-ink md:text-5xl">
            Ayni cift, iki farkli ton
          </h2>

          <div class="mt-10 grid gap-6 xl:grid-cols-2">
            <article class="rounded-[30px] border border-burgundy/12 bg-[linear-gradient(135deg,rgba(255,253,249,1),rgba(250,241,235,0.92))] p-6">
              <p class="text-[10px] uppercase tracking-[0.18em] text-burgundy/78">Biraz daha luks</p>
              <h3 class="font-manrope mt-3 text-[2.2rem] font-semibold leading-[0.92] tracking-[-0.055em] text-ink">
                Daha secili, daha parlak bir editoryal yuzey
              </h3>
              <p class="font-manrope mt-4 text-[0.98rem] uppercase tracking-[0.2em] text-ink/68">
                İÇERİĞİ İNCELE · SAĞLIK · ZİHİN & DENGE
              </p>
              <p class="font-kulim-park mt-5 text-[1.06rem] leading-[1.84] tracking-[0.004em] text-ink/76">
                Bu varyasyonda baslik biraz daha sikisir, govde ise daha yumusak akar. Hedef, daha premium ve daha
                secili bir hissi fazla sogutmadan kurmaktir.
              </p>
            </article>

            <article class="rounded-[30px] border border-burgundy/12 bg-cream-soft/45 p-6">
              <p class="text-[10px] uppercase tracking-[0.18em] text-burgundy/78">Biraz daha notr</p>
              <h3 class="font-manrope mt-3 text-[2.1rem] font-semibold leading-[0.98] tracking-[-0.035em] text-ink">
                Daha sakin, daha guvenli ve daha gorunmez bir akis
              </h3>
              <p class="font-manrope mt-4 text-[1rem] uppercase tracking-[0.15em] text-ink/70">
                İÇERİĞİ İNCELE · SAĞLIK · ZİHİN & DENGE
              </p>
              <p class="font-kulim-park mt-5 text-[1.02rem] leading-[1.74] tracking-[0.001em] text-ink/76">
                Bu varyasyonda sistem biraz geri cekilir. Okuma kolayligi ve gundelik kullanim one cikar; karakter
                azalir ama uzun sureli okunurluk artar.
              </p>
            </article>
          </div>
        </section>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Kulim+Park:wght@300;400;500;600&family=Manrope:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  .font-helvetica-neue {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  .font-kulim-park {
    font-family: "Kulim Park", "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  .font-manrope {
    font-family: "Manrope", "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  .font-plus-jakarta {
    font-family: "Plus Jakarta Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  .font-inter {
    font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
  }
</style>
