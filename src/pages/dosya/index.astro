---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import { releasedDossiers as dossiers, currentDossier, getTotalReadingMinutes } from '../../data/monthly-dossier';
import { writers } from '../../data/writers';

const archived = dossiers
  .filter((d) => d.slug !== currentDossier.slug)
  .sort((a, b) => b.monthYearISO.localeCompare(a.monthYearISO));

const currentCurator = writers.find((w) => w.slug === currentDossier.curatorSlug);
const currentTotalMinutes = getTotalReadingMinutes(currentDossier);
const currentHref = `/dosya/${currentDossier.slug}/`;
---

<SiteLayout
  title="Dosya Arşivi — Estranova"
  description="Estranova'nın aylık tematik dosyaları: bir küratörün yan yana getirdiği yazı kümeleri."
>
  <SiteNavbar currentPath="/dosya/" />

  <main id="main-content" class="text-ink">
    {/* Hero */}
    <section class="relative isolate overflow-hidden border-t border-primary/10 bg-gradient-to-b from-cream-warm to-cream-soft px-6 py-14 md:py-20">
      <div class="pointer-events-none absolute -left-24 top-10 h-80 w-80 rounded-full bg-gold/12 blur-3xl"></div>
      <div class="pointer-events-none absolute right-6 top-8 hidden font-serif text-[11rem] leading-none tracking-[-0.08em] text-primary/6 lg:block">
        dosya
      </div>
      <div class="mx-auto max-w-5xl">
        <div class="mb-5 flex max-w-2xl items-center gap-4">
          <span class="h-px flex-1 bg-gold/45"></span>
          <p class="text-xs font-bold uppercase tracking-[0.24em] text-primary">Dosya</p>
        </div>
        <h1 class="mb-5 font-serif text-6xl leading-[0.92] tracking-[-0.045em] text-primary md:text-8xl">
          Aylık Dosyalar
        </h1>
        <p class="max-w-3xl border-l border-gold/50 pl-5 font-serif text-xl italic leading-relaxed text-ink/76 md:text-2xl">
          Her ay bir küratör, bir tema etrafında yan yana getirilmiş yazı kümeleri. Hızlı tüketim
          değil, durup bakmak için.
        </p>
      </div>
    </section>

    {/* Bu ayın dosyası — büyük kart */}
    <section class="relative isolate overflow-hidden bg-white px-6 py-12 md:py-16">
      <div class="pointer-events-none absolute right-[-6rem] top-24 h-72 w-72 rounded-full bg-gold/10 blur-3xl"></div>
      <div class="mx-auto max-w-5xl">
        <div class="mb-5 flex items-center gap-4">
          <p class="text-xs font-bold uppercase tracking-[0.24em] text-primary">
            Bu Ayın Dosyası
          </p>
          <span class="h-px flex-1 bg-gold/35"></span>
        </div>
        <a
          href={currentHref}
          class="group relative flex flex-col overflow-hidden rounded-[38px] border border-primary/14 bg-cream-soft shadow-2xl shadow-primary/10 ring-1 ring-white/70 transition hover:-translate-y-0.5 hover:shadow-2xl hover:shadow-primary/14 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/35 focus-visible:ring-offset-2 md:flex-row md:items-stretch"
        >
          <span class="pointer-events-none absolute inset-x-8 top-0 z-10 h-px bg-gold/60"></span>
          <div class="relative h-64 w-full shrink-0 overflow-hidden md:h-auto md:w-[48%]">
            <img
              src={currentDossier.heroImage.src}
              alt={currentDossier.heroImage.alt}
              width="900"
              height="600"
              loading="eager"
              decoding="async"
              class="h-full w-full object-cover object-center transition duration-700 group-hover:scale-[1.03]"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1c1412]/42 via-[#1c1412]/8 to-transparent"></div>
            <span class="absolute left-5 top-5 rounded-full border border-cream-soft/35 bg-white/12 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.24em] text-cream-soft backdrop-blur-sm">
              Kürasyon
            </span>
          </div>
          <div class="relative flex min-w-0 flex-1 flex-col justify-between p-7 md:p-10">
            <span class="pointer-events-none absolute right-8 top-5 font-serif text-7xl italic leading-none text-gold/12">
              ay
            </span>
            <div>
              <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.28em] text-gold">
                {currentDossier.kicker}
              </p>
              <h2 class="mb-3 font-serif text-3xl leading-tight text-primary md:text-4xl">
                {currentDossier.title}
              </h2>
              {currentDossier.subtitle && (
                <p class="mb-4 font-serif text-lg italic text-ink/70 md:text-xl">
                  {currentDossier.subtitle}
                </p>
              )}
              <p class="mb-5 leading-relaxed text-ink/75">{currentDossier.lede}</p>
              <p class="text-xs uppercase tracking-[0.2em] text-ink/55">
                {currentCurator && (
                  <>
                    <span>Küratör: <span class="text-ink">{currentCurator.displayName}</span></span>
                    <span class="mx-2 text-gold">·</span>
                  </>
                )}
                <span>{currentDossier.articles.length} yazı</span>
                {currentTotalMinutes > 0 && (
                  <>
                    <span class="mx-2 text-gold">·</span>
                    <span>~{currentTotalMinutes} dk</span>
                  </>
                )}
              </p>
            </div>
            <div class="mt-6">
              <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary underline decoration-primary/40 underline-offset-4 transition group-hover:decoration-primary">
                Dosyayı keşfet
                <span aria-hidden="true">→</span>
              </span>
            </div>
          </div>
        </a>
      </div>
    </section>

    {/* Arşiv */}
    <section class="relative isolate overflow-hidden border-t border-primary/10 bg-cream-soft px-6 py-14 md:py-20">
      <div class="pointer-events-none absolute -right-24 top-10 h-72 w-72 rounded-full bg-gold/12 blur-3xl"></div>
      <div class="mx-auto max-w-5xl">
        <header class="mb-10 grid gap-6 md:grid-cols-[0.7fr_1.3fr] md:items-end">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-primary">Arşiv</p>
          <div>
            <h2 class="font-serif text-4xl leading-tight tracking-[-0.025em] text-ink md:text-5xl">
              Önceki dosyalar
            </h2>
            <p class="mt-3 max-w-xl text-base leading-relaxed text-ink/68">
              Biriken temalar, aynı editoryal sakinlikle arşivde tutulur.
            </p>
          </div>
        </header>

        {archived.length === 0 ? (
          <div class="rounded-[24px] border border-dashed border-primary/25 bg-white px-6 py-12 text-center">
            <p class="font-serif text-lg italic text-ink/60">
              İlk dosya henüz yayında. Yeni sayılar burada birikecek.
            </p>
          </div>
        ) : (
          <ul class="grid grid-cols-1 gap-6 md:grid-cols-2">
            {
              archived.map((dossier) => {
                const curator = writers.find((w) => w.slug === dossier.curatorSlug);
                return (
                  <li>
                    <a
                      href={`/dosya/${dossier.slug}/`}
                      class="group relative flex h-full flex-col overflow-hidden rounded-[30px] border border-primary/12 bg-white shadow-xl shadow-primary/6 ring-1 ring-white/70 transition hover:-translate-y-1 hover:border-gold/35 hover:shadow-2xl hover:shadow-primary/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/35 focus-visible:ring-offset-2"
                    >
                      <span class="pointer-events-none absolute inset-x-5 top-0 z-10 h-px bg-gold/55"></span>
                      <div class="relative h-44 overflow-hidden">
                        <img
                          src={dossier.heroImage.src}
                          alt={dossier.heroImage.alt}
                          width="600"
                          height="300"
                          loading="lazy"
                          decoding="async"
                          class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]"
                        />
                        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1c1412]/32 via-transparent to-transparent"></div>
                      </div>
                      <div class="flex flex-1 flex-col bg-gradient-to-b from-white to-cream-soft/55 p-6">
                        <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.22em] text-gold">
                          {dossier.kicker}
                        </p>
                        <h3 class="mb-3 font-serif text-2xl text-primary group-hover:underline group-hover:decoration-primary/35">
                          {dossier.title}
                        </h3>
                        <p class="mb-4 flex-1 leading-relaxed text-ink/75">{dossier.lede}</p>
                        <p class="font-serif text-xs italic text-ink/55">
                          {curator && <>Küratör: <span class="text-ink/75">{curator.displayName}</span></>}
                        </p>
                      </div>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        )}
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
