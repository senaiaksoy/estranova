---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
---

<SiteLayout
  title="İletişim - Estranova"
  description="Estranova platformu için iletişim ve bilgi taleplerine yönelik bilgilendirme sayfası."
>
  <SiteNavbar currentPath="/contact" />

  <main id="main-content" class="pt-24">
    <section class="px-6 py-16 md:py-20">
      <div class="max-w-5xl mx-auto">
        <header class="max-w-3xl mb-12">
          <p class="text-secondary text-xs font-bold tracking-[0.28em] uppercase mb-4">İletişim ve Bilgi</p>
          <h1 class="text-5xl md:text-7xl font-serif leading-[1.05] text-charcoal mb-6">Platform iletişim sayfası</h1>
          <p class="text-lg md:text-xl text-charcoal/65 leading-relaxed">
            Bu sayfa, Estranova platformu ile ilgili genel bilgi ve iletişim sürecini açıklar.
            Klinik randevu veya tedavi başvurusu için kullanılmaz.
          </p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
          <section class="rounded-[30px] border border-primary/10 bg-white p-8 editorial-shadow">
            <p class="text-[11px] uppercase tracking-[0.24em] text-secondary font-bold mb-3">Yönetim</p>
            <p class="text-charcoal/80 leading-relaxed mb-3">
              Site Yöneticisi: <span class="font-semibold text-charcoal">Berna Aksoy</span>
            </p>
            <p class="text-charcoal/80 leading-relaxed">
              Danışman Doktor ve Yazı Denetleyici: <span class="font-semibold text-charcoal">Doc. Dr. Senai Aksoy</span>
            </p>
          </section>

          <section class="rounded-[30px] border border-primary/10 bg-surface-container p-8">
            <p class="text-[11px] uppercase tracking-[0.24em] text-secondary font-bold mb-3">Kapsam</p>
            <ul class="space-y-3 text-charcoal/75 leading-relaxed">
              <li>İçerik düzeltme ve güncelleme bildirimleri</li>
              <li>Yasal ve gizlilik kapsamındaki iletiler</li>
              <li>Teknik erişilebilirlik ve site geri bildirimleri</li>
            </ul>
          </section>
        </div>

        <section class="rounded-[34px] burgundy-gradient text-white p-10 md:p-12">
          <p class="text-[11px] uppercase tracking-[0.24em] text-white/70 font-bold mb-4">Önemli Not</p>
          <p class="text-white/85 leading-relaxed mb-6">
            Estranova bir editoryal bilgi platformudur. Bu alan tıbbi tanı, tedavi veya acil yönlendirme hizmeti vermez.
            Acil durumlarda resmi sağlık hatlarını ve doğrudan sağlık kuruluşlarını tercih ediniz.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/about" class="inline-flex text-sm font-semibold text-white border-b border-white/40 pb-1 hover:border-white">
              Platform hakkında
            </a>
            <a href="/editorial-policy" class="inline-flex text-sm font-semibold text-white border-b border-white/40 pb-1 hover:border-white">
              Editoryal politika
            </a>
            <a href="/privacy-policy" class="inline-flex text-sm font-semibold text-white border-b border-white/40 pb-1 hover:border-white">
              Gizlilik politikası
            </a>
          </div>
        </section>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
