---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { isFeatureActive } from '../utils/feature-flags';

const membershipActive = isFeatureActive('membershipEnabled');

const pageTitle = membershipActive
  ? 'Estranova\'ya giriş'
  : 'Giriş yakında — Estranova';
const pageDescription = membershipActive
  ? 'Estranova okur hesabına e-posta ile giriş yap. Parola yok; tek kullanımlık link gönderilir.'
  : 'Estranova okur hesabı sistemi yakında açılır. O güne kadar tüm içerikler kayıtsız erişilebilir.';
---

<SiteLayout title={pageTitle} description={pageDescription}>
  <SiteNavbar currentPath="/giris" />

  <main id="main-content" class="text-ink">
    <section class="border-t border-burgundy/10 bg-gradient-to-b from-cream-warm to-cream-soft px-6 py-14 md:py-20">
      <div class="mx-auto max-w-3xl">
        <nav aria-label="Sayfa konumu" class="mb-6 text-xs uppercase tracking-[0.22em] text-ink/55">
          <a href="/" class="text-ink/65 hover:text-burgundy">Anasayfa</a>
          <span class="mx-2 text-gold">·</span>
          <span class="text-burgundy">Giriş</span>
        </nav>

        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
          Estranova Okur
        </p>
        <h1 class="mb-5 font-serif text-5xl leading-[1.05] text-burgundy md:text-6xl">
          {membershipActive ? 'Tek tıklık giriş' : 'Giriş yakında'}
        </h1>
        <p class="text-lg leading-relaxed text-ink/80 md:text-xl">
          {membershipActive
            ? 'E-postanı yaz; tek kullanımlık bir giriş bağlantısı gönderelim. Parola hatırlamak yok, hesap güvenliği bizde.'
            : 'Estranova okur hesabı sistemi yakında açılır. O güne kadar Sonra Oku listen, Mektup kaydın ve okuma tercihlerin yalnızca bu tarayıcıda saklanır — kayıt gerektirmez.'}
        </p>
      </div>
    </section>

    {membershipActive && (
      <section class="bg-white px-6 py-12 md:py-16">
        <div class="mx-auto max-w-md">
          <p class="text-base leading-relaxed text-ink/65">
            <em class="font-serif italic">Magic-link form yer-tutucusu — Faz 2 implementasyonu için Resend + Supabase bağlantı noktası burada açılır. featureFlags.membershipEnabled true olunca MagicLinkForm bileşeni render edilir.</em>
          </p>
        </div>
      </section>
    )}

    {!membershipActive && (
      <section class="bg-white px-6 py-12 md:py-16">
        <div class="mx-auto max-w-3xl">
          <div class="rounded-[28px] border border-gold/35 bg-cream-soft/60 p-8 md:p-10">
            <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.28em] text-gold">
              Şimdi yapabileceklerin
            </p>
            <h2 class="mb-3 font-serif text-2xl leading-snug text-ink md:text-3xl">
              Hesap olmadan da okuma panelin var
            </h2>
            <p class="mb-6 text-base leading-relaxed text-ink/75">
              Sonra Oku listene, mektup kaydına ve okuma tercihlerine kayıt olmadan ulaşabilirsin.
              Tüm bilgiler sadece bu tarayıcıda durur — sunucumuza kopya gitmiyor.
            </p>
            <div class="flex flex-wrap gap-3">
              <a
                href="/hesabim"
                class="inline-flex items-center gap-1.5 rounded-xl bg-burgundy px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:opacity-95 focus:outline-none focus:ring-2 focus:ring-burgundy/35"
              >
                Okuma panelime git
              </a>
              <a
                href="/mektup"
                class="inline-flex items-center gap-1.5 rounded-xl border-2 border-burgundy px-6 py-3 text-sm font-semibold text-burgundy transition hover:bg-burgundy/5 focus:outline-none focus:ring-2 focus:ring-burgundy/35"
              >
                Mektup hakkında
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <section class="border-t border-burgundy/10 bg-cream-soft px-6 py-10">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm leading-relaxed text-ink/65">
          KVKK ve veri politikamız için <a href="/kvkk" class="font-semibold text-burgundy underline decoration-burgundy/40 underline-offset-4 hover:decoration-burgundy">KVKK Aydınlatma Metni</a>'ne göz atabilirsin.
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
