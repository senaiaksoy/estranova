---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { isFeatureActive } from '../utils/feature-flags';

const membershipActive = isFeatureActive('membershipEnabled');

const pageTitle = membershipActive
  ? 'Okur girişi — Estranova'
  : 'Okur alanı yakında — Estranova';
const pageDescription = membershipActive
  ? 'Estranova okur alanına e-posta ile giriş yapılır. Parola yok; tek kullanımlık link gönderilir.'
  : 'Estranova okur alanı yakında açılır. O güne kadar tüm içerikler kayıtsız erişilebilir.';
---

<SiteLayout title={pageTitle} description={pageDescription} allowIndexing={false}>
  <SiteNavbar currentPath="/giris" />

  <main id="main-content" class="text-ink">
    <section class="relative overflow-hidden border-t border-burgundy/10 bg-gradient-to-b from-cream-warm via-cream-soft to-white px-6 py-16 md:py-24">
      <div class="absolute right-[-6vw] top-12 hidden font-serif text-[12rem] leading-none text-burgundy/[0.045] lg:block">
        okur
      </div>
      <div class="absolute left-[-5rem] bottom-0 hidden h-72 w-72 rounded-full bg-gold/10 blur-3xl lg:block"></div>

      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1fr_0.74fr] lg:items-end">
        <div>
          <nav aria-label="Sayfa konumu" class="mb-8 text-xs uppercase tracking-[0.22em] text-ink/55">
            <a href="/" class="text-ink/65 hover:text-burgundy">Anasayfa</a>
            <span class="mx-2 text-gold">·</span>
            <span class="text-burgundy">Okur Alanı</span>
          </nav>

          <p class="mb-4 text-xs font-bold uppercase tracking-[0.3em] text-burgundy">
            Estranova Okur
          </p>
          <h1 class="mb-6 max-w-4xl font-serif text-5xl leading-[0.98] text-burgundy md:text-7xl">
            {membershipActive ? 'Tek tıklık okur girişi' : 'Okur alanı yakında; okuma açık'}
          </h1>
          <p class="max-w-3xl text-lg leading-relaxed text-ink/76 md:text-xl">
            {membershipActive
              ? 'E-postanızı yazın; tek kullanımlık bir giriş bağlantısı gönderelim. Parola hatırlamak yok, okur alanına sakin ve güvenli bir geçiş var.'
              : 'Estranova okur alanı henüz açılmadı. Bu arada okuma paneliniz, Sonra Oku listeniz ve yazı boyutu tercihiniz yalnızca bu tarayıcıda durur; içerikleri okumak için kayıt gerekmez.'}
          </p>
        </div>

        <aside class="rounded-[36px] border border-burgundy/10 bg-white/85 p-8 shadow-[0_24px_70px_rgba(74,47,39,0.10)] backdrop-blur">
          <p class="mb-3 font-serif text-3xl text-burgundy">Okur alanı notu</p>
          <p class="text-sm leading-relaxed text-ink/68">
            Estranova'da kayıt, içeriğe erişmek için zorunlu bir kapı değil. Açıldığında yalnızca okuma geçmişini ve tercihlerini daha düzenli taşımaya yarayan hafif bir katman olacak.
          </p>
          <div class="mt-6 border-t border-burgundy/10 pt-5">
            <p class="text-xs font-bold uppercase tracking-[0.24em] text-gold">Bugün</p>
            <p class="mt-2 text-sm leading-relaxed text-ink/65">
              Okuma paneli ve mektup kaydı tarayıcı içinde çalışır; kişisel sağlık verisi istemez.
            </p>
          </div>
        </aside>
      </div>
    </section>

    {membershipActive && (
      <section class="bg-white px-6 py-12 md:py-16">
        <div class="mx-auto max-w-md">
          <p class="text-base leading-relaxed text-ink/65">
            <em class="font-serif italic">Okur alanı açıldığında bu bölümde e-posta ile tek kullanımlık giriş bağlantısı isteyen sade bir form yer alır. Parola veya uzun kayıt akışı tasarlanmaz.</em>
          </p>
        </div>
      </section>
    )}

    {!membershipActive && (
      <section class="bg-white px-6 py-12 md:py-18">
        <div class="mx-auto max-w-6xl">
          <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
            <div class="rounded-[36px] bg-burgundy p-8 text-white shadow-[0_24px_70px_rgba(107,45,62,0.18)] md:p-10">
              <p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.28em] text-gold">
                Şimdi yapabilecekleriniz
              </p>
              <h2 class="mb-5 font-serif text-4xl leading-tight md:text-5xl">
                Kayıt olmadan da okuma paneliniz var
              </h2>
              <p class="mb-7 text-base leading-relaxed text-white/76">
                Sonra Oku listenize, mektup kaydınıza ve okuma tercihlerinize kayıt olmadan ulaşabilirsiniz.
                Tüm bilgiler sadece bu tarayıcıda durur; sunucumuza kopya gitmiyor.
              </p>
              <div class="flex flex-wrap gap-3">
                <a
                  href="/okuma-paneli"
                  class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 text-xs font-bold uppercase tracking-[0.18em] text-burgundy shadow-sm transition hover:bg-white/90 focus:outline-none focus:ring-2 focus:ring-white/45"
                >
                  Okuma paneline git
                </a>
                <a
                  href="/mektup"
                  class="inline-flex items-center gap-2 rounded-full border border-white/25 px-5 py-3 text-xs font-bold uppercase tracking-[0.18em] text-white transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/45"
                >
                  Mektubu incele
                </a>
              </div>
            </div>

            <div class="grid gap-5 md:grid-cols-2">
              <article class="rounded-[32px] border border-burgundy/10 bg-cream-soft p-7">
                <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-gold">01</p>
                <h3 class="mb-3 font-serif text-3xl text-ink">Kaydet</h3>
                <p class="text-sm leading-relaxed text-ink/66">
                  Uzun bir yazıyı yarım bıraktığınızda Sonra Oku listesine ekleyebilirsiniz.
                </p>
              </article>
              <article class="rounded-[32px] border border-burgundy/10 bg-cream-soft p-7">
                <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-gold">02</p>
                <h3 class="mb-3 font-serif text-3xl text-ink">Sakince dön</h3>
                <p class="text-sm leading-relaxed text-ink/66">
                  Okuma paneliniz, listeyi ve yazı boyutu tercihinizi aynı yüzeyde toplar.
                </p>
              </article>
              <article class="rounded-[32px] border border-gold/25 bg-gold/10 p-7 md:col-span-2">
                <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Veri sınırı</p>
                <p class="text-sm leading-relaxed text-ink/68">
                  Bu alan kişisel sağlık verisi toplamaz, klinik değerlendirme yapmaz ve okuma alışkanlığını sunucuda takip etmez.
                </p>
              </article>
            </div>
          </div>
        </div>
      </section>
    )}

    <section class="border-t border-burgundy/10 bg-cream-soft px-6 py-10">
      <div class="mx-auto max-w-4xl rounded-full border border-burgundy/10 bg-white/70 px-6 py-5 text-center">
        <p class="text-sm leading-relaxed text-ink/65">
          KVKK ve veri politikamız için <a href="/kvkk" class="font-semibold text-burgundy underline decoration-burgundy/40 underline-offset-4 hover:decoration-burgundy">KVKK Aydınlatma Metni</a>'ne göz atabilirsiniz.
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
