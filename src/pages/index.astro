<script>
  // Multi-carousel destek (2026-05-03): anasayfada iki ayrı yazar carousel'i var
  // (yaşam yazarları + bilim yazarları). Her birinin track / prev / next /
  // dots elemanları kendi carousel scope'unda yer alır; JS hepsini forEach
  // ile bağımsız initialize eder.
  function initWritersCarousel(carousel) {
    const track = carousel.querySelector('[data-writers-track]');
    const prevBtn = carousel.querySelector('[data-writers-prev]');
    const nextBtn = carousel.querySelector('[data-writers-next]');
    const dotsContainer = carousel.querySelector('[data-writers-dots]');
    if (!track || !prevBtn || !nextBtn || !dotsContainer) return;

    const items = Array.from(track.querySelectorAll(':scope > li'));
    if (items.length === 0) return;

    function getMetrics() {
      const cardWidth = items[0].getBoundingClientRect().width;
      const styles = getComputedStyle(track);
      const gap = parseFloat(styles.columnGap || styles.gap || '0') || 0;
      const visible = Math.max(1, Math.floor((track.clientWidth + gap) / (cardWidth + gap)));
      const pageWidth = visible * (cardWidth + gap);
      const total = Math.max(1, Math.ceil(items.length / visible));
      return { cardWidth, gap, visible, pageWidth, total };
    }

    let animFrame = 0;
    let isAnimating = false;
    function smoothScrollTo(targetLeft) {
      cancelAnimationFrame(animFrame);
      const startLeft = track.scrollLeft;
      const max = track.scrollWidth - track.clientWidth;
      const clamped = Math.max(0, Math.min(max, targetLeft));
      const distance = clamped - startLeft;
      if (Math.abs(distance) < 1) return;
      const duration = Math.min(600, Math.max(280, Math.abs(distance) * 0.6));
      const start = performance.now();
      const ease = (t) => 1 - Math.pow(1 - t, 3);
      if (!isAnimating) {
        track.style.scrollSnapType = 'none';
      }
      isAnimating = true;
      function step(now) {
        const elapsed = now - start;
        const t = Math.min(1, elapsed / duration);
        track.scrollLeft = startLeft + distance * ease(t);
        if (t < 1) {
          animFrame = requestAnimationFrame(step);
        } else {
          isAnimating = false;
          track.style.scrollSnapType = '';
        }
      }
      animFrame = requestAnimationFrame(step);
    }

    function currentPage() {
      const { pageWidth, total } = getMetrics();
      if (pageWidth <= 0) return 0;
      return Math.min(total - 1, Math.round(track.scrollLeft / pageWidth));
    }

    function dotClass(active) {
      return active
        ? 'h-2 w-6 rounded-full bg-burgundy transition focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2'
        : 'h-2 w-2 rounded-full bg-burgundy/25 transition hover:bg-burgundy/55 focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2';
    }

    function buildDots() {
      const { total, pageWidth } = getMetrics();
      dotsContainer.innerHTML = '';
      if (total <= 1) {
        dotsContainer.style.display = 'none';
        return;
      }
      dotsContainer.style.display = '';
      for (let i = 0; i < total; i++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.setAttribute('aria-label', (i + 1) + '. sayfa');
        dot.dataset.page = String(i);
        dot.className = dotClass(false);
        dot.addEventListener('click', () => {
          smoothScrollTo(i * pageWidth);
        });
        dotsContainer.appendChild(dot);
      }
      updateDots();
    }

    function updateDots() {
      const active = currentPage();
      const dots = Array.from(dotsContainer.querySelectorAll('button'));
      dots.forEach((dot, idx) => {
        dot.className = dotClass(idx === active);
        if (idx === active) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });
    }

    function updateButtons() {
      const max = track.scrollWidth - track.clientWidth - 1;
      prevBtn.disabled = track.scrollLeft <= 1;
      nextBtn.disabled = track.scrollLeft >= max;
    }

    prevBtn.addEventListener('click', () => {
      const { pageWidth } = getMetrics();
      smoothScrollTo(track.scrollLeft - pageWidth);
    });
    nextBtn.addEventListener('click', () => {
      const { pageWidth } = getMetrics();
      smoothScrollTo(track.scrollLeft + pageWidth);
    });

    let scrollRaf = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(scrollRaf);
      scrollRaf = requestAnimationFrame(() => {
        updateButtons();
        updateDots();
      });
    });

    let resizeRaf = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(resizeRaf);
      resizeRaf = requestAnimationFrame(() => {
        buildDots();
        updateButtons();
      });
    });

    buildDots();
    updateButtons();
  }

  function initAllWritersCarousels() {
    document.querySelectorAll('[data-writers-carousel]').forEach(initWritersCarousel);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllWritersCarousels);
  } else {
    initAllWritersCarousels();
  }
</script>
