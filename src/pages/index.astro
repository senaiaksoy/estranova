---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import HomeHero from '../components/site/HomeHero.astro';
import SymptomNavigation from '../components/site/SymptomNavigation.astro';
import EditorialDigestStrip from '../components/site/EditorialDigestStrip.astro';
import IssueHero from '../components/site/IssueHero.astro';
import { homePageHero, submenuHeroByRoute } from '../data/submenu-heroes';
import { activeWriters, writers } from '../data/writers';
import { currentIssue, resolveCoverDossier, formatIssuePad } from '../data/issues';
import { magazineConfig } from '../data/magazine-config';

const coverDossier = resolveCoverDossier(currentIssue);
const issuePad = formatIssuePad(currentIssue.number);

// Hub adı eşlemesi — makale URL'sinden bölüm adını çıkar
const hubLabels: Record<string, string> = {
  '/hormonal-gecis': 'Hormonal Geçiş',
  '/zamansiz-yasam': 'Zamansız Yaşam',
  '/beden-yakinlik': 'Beden & Yakınlık',
  '/zihin-denge': 'Zihin & Denge',
  '/bilimsel-pencere': 'Bilimsel Pencere',
};

function getHubLabel(href?: string): string {
  if (!href) return magazineConfig.name;
  const hub = '/' + href.split('/')[1];
  return hubLabels[hub] ?? magazineConfig.name;
}

function getHubThumbnail(href?: string): string {
  if (!href) return submenuHeroByRoute['/hormonal-gecis'].src;
  const hub = '/' + href.split('/')[1];
  const hero = submenuHeroByRoute[hub as keyof typeof submenuHeroByRoute];
  return hero?.src ?? submenuHeroByRoute['/hormonal-gecis'].src;
}

// Mevcut sayının kapak dosyasından öne çıkan 3 yazı (idx 0-2)
const editorialPicks = (coverDossier?.articles ?? []).slice(0, 3).map((article, idx) => {
  const writer = writers.find((w) => w.slug === article.writerSlug);
  return {
    tag: getHubLabel(article.href),
    title: article.title,
    body: article.excerpt,
    href: article.href ?? `/sayi/${currentIssue.slug}`,
    thumbnailSrc: getHubThumbnail(article.href),
    thumbnailAlt: article.title,
    highlight: idx === 1,
    author: writer?.displayName ?? 'Estranova',
    isPlanned: article.status === 'planned',
  };
});

// Aynı sayının kalan yazıları (idx 3+) — son yayınlar listesi
const editorialRecent = (coverDossier?.articles ?? []).slice(3).map((article) => {
  const writer = writers.find((w) => w.slug === article.writerSlug);
  return {
    dateLine: `${currentIssue.monthYear.toLocaleUpperCase('tr-TR')} · ${getHubLabel(article.href).toLocaleUpperCase('tr-TR')}`,
    title: article.title,
    excerpt: article.excerpt,
    href: article.href ?? `/sayi/${currentIssue.slug}`,
    thumbnailSrc: getHubThumbnail(article.href),
    thumbnailAlt: article.title,
    author: writer?.displayName ?? 'Estranova',
    isPlanned: article.status === 'planned',
  };
});

const journey = [
  {
    step: '01',
    title: 'Perimenopoz',
    excerpt: 'Adet düzenin değişmeye başladığında vücudunun neyi sessizce anlattığını birlikte okumak için sakin bir başlangıç rehberi.',
    href: '/hormonal-gecis/perimenopoz',
    imageKey: '/hormonal-gecis/perimenopoz' as const,
  },
  {
    step: '02',
    title: 'Menopoza Hazırlık',
    excerpt: 'Geçişe adım adım ısınırken günlük düzeninizi, takibinizi ve koruyucu alışkanlıklarınızı bu dönemden geçen birçoğumuz gibi sabırla kurabilirsiniz.',
    href: '/hormonal-gecis/menopoza-hazirlik',
    imageKey: '/hormonal-gecis/menopoza-hazirlik' as const,
  },
  {
    step: '03',
    title: 'Menopoz',
    excerpt: 'Sık karşılaştığımız belirtileri tanımanız ve günlük yaşamınızı biraz daha yumuşatmanız için yanınızda duran sade, yaşıt tonlu bir rehber.',
    href: '/hormonal-gecis/menopoz',
    imageKey: '/hormonal-gecis/menopoz' as const,
  },
  {
    step: '04',
    title: '40 Sonrası Sağlık',
    excerpt: 'Kemik, kas, uyku ve tarama başlıklarını tek dosyada oku. Amaç görev listesi değil, hayatın ritmini koruyan sakin bir sağlık hattı.',
    href: '/hormonal-gecis/40-sonrasi',
    imageKey: '/hormonal-gecis/40-sonrasi' as const,
  },
];

// Yazar kategorileri — iki ayrı carousel için filtreler
const lifestyleWriters = activeWriters.filter((w) => w.category !== 'scientific');
const scientificWriters = activeWriters.filter((w) => w.category === 'scientific');

const preventionCards = [
  {
    label: 'Güç',
    title: 'Kemik ve kas gücü',
    body: '40 sonrası sağlık yalnızca belirti yönetimi değildir. Hareket, beslenme ve düzenli takip birlikte düşünülür.',
    href: '/zamansiz-yasam/kemik-sagligi-40-sonrasi',
  },
  {
    label: 'Kayıt',
    title: 'Tarama ve kayıt düzeni',
    body: 'Kontrol tarihlerini ve aile öyküsünü sade bir dosyada topla. Soruları önceden yazmak iyi bir başlangıçtır.',
    href: '/hormonal-gecis/40-sonrasi/tarama-testleri',
  },
  {
    label: 'Ritim',
    title: 'Uyku ve toparlanma',
    body: 'Gece düzeni değiştiğinde bunu irade meselesi gibi okumayalım. Bazen bedenin yeni ritmini anlamak gerekir.',
    href: '/zihin-denge/uyku-dinlenme',
  },
];

const homeFaqs = [
  {
    question: 'Estranova bir klinik ya da randevu platformu mu?',
    answer: 'Hayır. Estranova, 40+ kadın sağlığı için hazırlanmış editoryal bir bilgi platformudur; randevu, tedavi veya hizmet yönlendirmesi yapmaz.',
  },
  {
    question: 'Yazılar tıbbi olarak gözden geçiriliyor mu?',
    answer: 'Sağlık içerikleri editoryal kontrolden geçer. Uygun olduğunda tıbbi inceleme katmanı da eklenir. Yazılar kişisel tanı veya tedavi önerisi yerine geçmez.',
  },
  {
    question: 'Nereden başlamalıyım?',
    answer: 'Yaşam evreni belliyse yolculuk haritasından başla. Belirti daha baskınsa belirti navigasyonunu kullan.',
  },
  {
    question: 'İçerikler yalnızca menopoz hakkında mı?',
    answer: 'Hayır. Perimenopoz, menopoza hazırlık, menopoz, 40 sonrası koruyucu sağlık, zihin dengesi, beden ve yakınlık gibi başlıklar birlikte ele alınır.',
  },
];
---

<SiteLayout
  title="Estranova - Kadın Sağlığı Editoryal Rehberi"
  description="Perimenopoz, menopoza hazırlık ve menopoz dönemlerinde güvenilir editoryal içerikler."
>
  <SiteNavbar currentPath="/" />

  <main id="main-content" class="text-ink">
    <HomeHero hero={homePageHero} />

    <section class="relative isolate overflow-hidden border-t border-burgundy/10 bg-white px-6 py-16 md:py-24">
      <div class="pointer-events-none absolute inset-x-6 top-0 h-px bg-gradient-to-r from-transparent via-gold/55 to-transparent"></div>
      <div class="pointer-events-none absolute left-1/2 top-10 hidden -translate-x-1/2 font-serif text-[10rem] leading-none tracking-[-0.08em] text-burgundy/5 lg:block">
        imzalar
      </div>
      <div class="mx-auto max-w-6xl">
        <header class="mb-12 grid gap-8 md:grid-cols-[0.85fr_1.15fr] md:items-end">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
            <span class="font-serif font-normal tabular-nums text-gold">01</span>
            <span class="mx-2 text-gold">—</span>
            Yolculuk Haritası
          </p>
          <div>
            <h2 class="mb-4 font-serif text-4xl leading-[0.98] tracking-[-0.03em] text-ink md:text-6xl">Hormonal geçiş için dört kapı</h2>
            <p class="max-w-2xl text-lg leading-relaxed text-ink/75">
              Her dönem farklı sorular getirir. Burada okur, kendini bir testin içinde değil, sakin bir dergi dosyasının içinde bulur.
            </p>
          </div>
        </header>

        <div class="overflow-hidden rounded-[38px] border border-burgundy/12 bg-white shadow-[0_30px_98px_-72px_rgba(44,22,28,0.36)] ring-1 ring-black/[0.04]">
          {
            journey.map((j) => {
              const img = submenuHeroByRoute[j.imageKey];
              return (
                <article class="group border-b border-burgundy/12 last:border-b-0">
                  <a href={j.href} class="grid gap-5 p-6 outline-none transition hover:bg-cream-soft/30 focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2 md:grid-cols-[88px_220px_1fr_auto] md:items-center md:gap-8 md:p-8">
                    <span class="font-serif text-5xl leading-none tabular-nums text-gold md:text-6xl">{j.step}</span>
                    <div class="relative h-32 overflow-hidden rounded-[26px] ring-1 ring-black/[0.04] md:h-36">
                      <img
                        src={img.src}
                        alt=""
                        width="600"
                        height="225"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover object-top transition duration-700 group-hover:scale-[1.04]"
                      />
                      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1c1412]/28 via-transparent to-transparent" />
                    </div>
                    <div>
                      <h3 class="mb-2 font-serif text-3xl leading-tight tracking-[-0.015em] text-ink md:text-4xl">{j.title}</h3>
                      <p class="max-w-2xl leading-relaxed text-ink/72">{j.excerpt}</p>
                    </div>
                    <span class="font-serif text-2xl text-gold transition group-hover:translate-x-1" aria-hidden="true">→</span>
                  </a>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <div class="mx-auto flex max-w-sm items-center justify-center gap-4 py-8 md:py-10">
      <span class="h-px flex-1 bg-gold/35"></span>
      <span class="font-serif text-xl text-gold" aria-hidden="true">❦</span>
      <span class="h-px flex-1 bg-gold/35"></span>
    </div>

    <SymptomNavigation sectionNumber="02" />

    <IssueHero issue={currentIssue} sectionNumber="03" />

    <section class="relative isolate overflow-hidden border-t border-burgundy/10 bg-white px-6 py-16 md:py-24">
      <div class="pointer-events-none absolute inset-x-6 top-0 h-px bg-gradient-to-r from-transparent via-gold/55 to-transparent"></div>
      <div class="pointer-events-none absolute -left-24 top-16 h-80 w-80 rounded-full bg-gold/10 blur-3xl"></div>
      <div class="pointer-events-none absolute right-4 top-12 hidden font-serif text-[11rem] leading-none tracking-[-0.08em] text-burgundy/5 lg:block">
        seçki
      </div>
      <div class="mx-auto max-w-6xl">
        <header class="mb-12 grid gap-8 md:grid-cols-[0.78fr_1.22fr] md:items-end">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
            <span class="font-serif font-normal tabular-nums text-gold">04</span>
            <span class="mx-2 text-gold">—</span>
            EDİTÖRYAL SEÇKİ
          </p>
          <div>
            <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.28em] text-gold">
              {magazineConfig.name} · Sayı {issuePad}
            </p>
            <h2 class="mb-4 font-serif text-4xl leading-[0.98] tracking-[-0.03em] md:text-6xl">Bu sayıdan öne çıkanlar</h2>
            <p class="max-w-2xl border-l border-gold/50 pl-5 font-serif text-xl italic leading-relaxed text-ink/72">
              Kapak dosyasından üç güçlü okuma; ardından sayının sakin ama tamamlayıcı parçaları.
            </p>
          </div>
        </header>

        <div class="grid gap-8 lg:grid-cols-[1.18fr_0.82fr] lg:items-stretch">
          {
            editorialPicks[0] && (
              <a
                href={editorialPicks[0].href}
                class="group relative grid overflow-hidden rounded-[38px] border border-burgundy/14 bg-white shadow-[0_34px_110px_-70px_rgba(44,22,28,0.46)] ring-1 ring-black/[0.05] focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2 md:grid-cols-[0.9fr_1fr]"
              >
                <span class="pointer-events-none absolute inset-x-8 top-0 z-10 h-px bg-gold/60"></span>
                <div class="relative min-h-[320px] overflow-hidden">
                  <img
                    src={editorialPicks[0].thumbnailSrc}
                    alt={editorialPicks[0].thumbnailAlt}
                    width="720"
                    height="900"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.035]"
                  />
                  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1c1412]/38 via-transparent to-transparent"></div>
                </div>
                <div class="relative flex flex-col justify-between p-7 md:p-9">
                  <span class="pointer-events-none absolute right-7 top-7 font-serif text-7xl italic leading-none text-gold/12">01</span>
                  <div>
                    <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-burgundy">{editorialPicks[0].tag}</p>
                    <h3 class="mb-4 font-serif text-4xl leading-[1.02] tracking-[-0.025em] text-ink group-hover:underline group-hover:decoration-gold/70 md:text-5xl">
                      {editorialPicks[0].title}
                    </h3>
                    <p class="text-lg leading-relaxed text-ink/72">{editorialPicks[0].body}</p>
                  </div>
                  <p class="mt-8 font-serif text-sm italic text-ink/55">
                    Yazan: <span class="text-ink/75">{editorialPicks[0].author}</span>
                  </p>
                </div>
              </a>
            )
          }
          <div class="overflow-hidden rounded-[34px] border border-burgundy/14 bg-white shadow-[0_24px_82px_-64px_rgba(44,22,28,0.36)] ring-1 ring-black/[0.04]">
            {
              editorialPicks.slice(1).map((z, idx) => (
                <a
                  href={z.href}
                  class="group grid gap-5 border-b border-burgundy/12 p-6 transition last:border-b-0 hover:bg-cream-soft/35 focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2 sm:grid-cols-[104px_1fr]"
                >
                  <span class="font-serif text-5xl italic leading-none tabular-nums text-gold">{String(idx + 2).padStart(2, '0')}</span>
                  <span>
                    <span class="mb-3 block text-xs font-semibold uppercase tracking-[0.18em] text-burgundy">{z.tag}</span>
                    <span class="block font-serif text-3xl leading-tight text-ink group-hover:underline group-hover:decoration-gold/70">{z.title}</span>
                    <span class="mt-3 block leading-relaxed text-ink/70">{z.body}</span>
                    <span class="mt-5 block font-serif text-xs italic text-ink/55">
                      Yazan: <span class="text-ink/75">{z.author}</span>
                    </span>
                  </span>
                </a>
              ))
            }
          </div>
        </div>

        <div class="mt-14 md:mt-16">
          <div class="mb-6 flex items-center gap-4">
            <h3 class="font-serif text-2xl text-ink">Son yayınlar</h3>
            <span class="h-px flex-1 bg-gold/35"></span>
          </div>
          <div class="overflow-hidden rounded-[30px] border border-burgundy/12 bg-white shadow-[0_22px_74px_-62px_rgba(44,22,28,0.3)] ring-1 ring-black/[0.04]">
            {
              editorialRecent.map((item) => (
                <a
                  href={item.href}
                  class="group flex items-start gap-4 border-b border-burgundy/12 p-5 transition last:border-b-0 hover:bg-cream-soft/35 focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2 md:gap-6 md:p-6"
                >
                  <img
                    src={item.thumbnailSrc}
                    alt={item.thumbnailAlt}
                    width="64"
                    height="64"
                    loading="lazy"
                    decoding="async"
                    class="h-12 w-12 shrink-0 rounded-lg object-cover ring-1 ring-burgundy/10 md:h-16 md:w-16"
                  />
                  <div class="min-w-0 flex-1">
                    <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-burgundy">{item.dateLine}</p>
                    <h4 class="mb-2 font-serif text-2xl text-ink transition group-hover:underline group-hover:decoration-gold group-hover:decoration-1 group-hover:underline-offset-[6px]">
                      {item.title}
                    </h4>
                    <p class="text-base leading-relaxed text-ink/70">{item.excerpt}</p>
                    <p class="mt-3 font-serif text-xs italic text-ink/55">
                      Yazan: <span class="text-ink/75">{item.author}</span>
                    </p>
                  </div>
                </a>
              ))
            }
          </div>
          <div class="mt-6 flex justify-end">
            <a
              href={`/sayi/${currentIssue.slug}`}
              class="text-sm font-semibold text-burgundy underline decoration-burgundy/50 underline-offset-4 transition hover:decoration-burgundy focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
            >
              Sayının tamamı →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!--
      Yazar Kadrosu — yaşam yazarları (lifestyle category).
      Konum: Editöryal Seçki sonrası (2026-05-03'te taşındı; eski konumu en altta idi).
      Bilim yazarları için ayrı carousel sayfa sonunda yer alır.
    -->
    <section class="relative isolate overflow-hidden border-t border-burgundy/10 bg-white px-6 py-16 md:py-24">
      <div class="pointer-events-none absolute inset-x-6 top-0 h-px bg-gradient-to-r from-transparent via-gold/55 to-transparent"></div>
      <div class="pointer-events-none absolute -left-20 top-20 h-72 w-72 rounded-full bg-gold/10 blur-3xl"></div>
      <div class="pointer-events-none absolute right-0 top-10 hidden font-serif text-[11rem] italic leading-none tracking-[-0.08em] text-burgundy/[0.04] lg:block">
        imza
      </div>
      <div class="mx-auto max-w-6xl">
        <header class="mb-12 grid gap-8 md:grid-cols-[0.72fr_1.28fr] md:items-end">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
            <span class="font-serif font-normal tabular-nums text-gold">05</span>
            <span class="mx-2 text-gold">—</span>
            Yazar Kadrosu
          </p>
          <div>
            <h2 class="mb-4 font-serif text-4xl leading-[0.98] tracking-[-0.03em] md:text-6xl">Bu sayıda yazanlar</h2>
            <p class="max-w-2xl text-lg leading-relaxed text-ink/75">
              Estranova bir kişisel vitrin değil. Farklı hayat ritimlerinden gelen yaşıt sesler, deneyimi parlatmak için değil anlamlandırmak için yazıyor.
            </p>
            <a
              href="/yayin-kurulu#neden-yaziyorlar"
              class="mt-5 inline-flex text-sm font-semibold text-burgundy underline decoration-burgundy/40 underline-offset-4 transition hover:decoration-burgundy"
              >Neden burada yazıyorlar? →</a
            >
          </div>
        </header>

        <div class="relative" data-writers-carousel>
          <button
            type="button"
            data-writers-prev
            aria-label="Önceki yazarlar"
            class="absolute left-0 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 -translate-x-3 items-center justify-center rounded-full border border-burgundy/25 bg-white/95 text-burgundy shadow-sm backdrop-blur transition hover:border-burgundy/55 hover:bg-white hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:border-burgundy/25 disabled:hover:bg-white/95 disabled:hover:shadow-sm md:flex"
          >
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m12 15-5-5 5-5" />
            </svg>
          </button>

          <button
            type="button"
            data-writers-next
            aria-label="Sonraki yazarlar"
            class="absolute right-0 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 translate-x-3 items-center justify-center rounded-full border border-burgundy/25 bg-white/95 text-burgundy shadow-sm backdrop-blur transition hover:border-burgundy/55 hover:bg-white hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:border-burgundy/25 disabled:hover:bg-white/95 disabled:hover:shadow-sm md:flex"
          >
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m8 5 5 5-5 5" />
            </svg>
          </button>

          <ul
            data-writers-track
            role="list"
            aria-label="Yazar kadrosu — yatay kaydırarak gezinebilirsiniz"
            class="writers-track flex snap-x snap-mandatory gap-5 overflow-x-auto pb-2 md:gap-6"
          >
            {
              lifestyleWriters.map((w) => (
                <li class="flex shrink-0 snap-start" style="width: clamp(270px, 78vw, 340px);">
                  <a
                    href={`/yazarlar/${w.slug}`}
                    class="group relative flex w-full flex-col overflow-hidden rounded-[34px] border border-burgundy/12 bg-white p-5 shadow-[0_28px_88px_-62px_rgba(44,22,28,0.32)] ring-1 ring-black/[0.04] transition duration-300 hover:-translate-y-1 hover:border-gold/40 hover:shadow-[0_38px_110px_-64px_rgba(44,22,28,0.42)] focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
                  >
                    <span class="pointer-events-none absolute inset-x-6 top-0 h-px bg-gradient-to-r from-transparent via-gold/75 to-transparent"></span>
                    {w.portrait ? (
                      <img
                        src={w.portrait}
                        alt={`${w.displayName} portresi`}
                        width="160"
                        height="160"
                        loading="lazy"
                        decoding="async"
                        class="mb-5 aspect-[4/5] w-full rounded-[30px] object-cover object-top ring-1 ring-burgundy/12 transition duration-700 group-hover:scale-[1.025] group-hover:ring-burgundy/35"
                      />
                    ) : (
                      <div class="mb-5 flex aspect-[4/5] w-full items-center justify-center rounded-[30px] bg-cream-warm font-serif text-5xl text-burgundy ring-1 ring-burgundy/12 transition group-hover:ring-burgundy/35">
                        {w.displayName
                          .split(/\s+/)
                          .filter((part) => part.length > 0)
                          .map((n) => n[0])
                          .join('')}
                      </div>
                    )}
                    <div class="min-w-0 flex-1 border-t border-burgundy/14 pt-5">
                      <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-gold-bronze">
                        {w.role.split('/')[0].trim()}
                      </p>
                      <h3 class="mt-2 font-serif text-3xl leading-[0.98] tracking-[-0.03em] text-ink transition group-hover:text-burgundy">
                        {w.displayName}
                      </h3>
