---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import HomeHero from '../components/site/HomeHero.astro';
import SymptomNavigation from '../components/site/SymptomNavigation.astro';
import EditorialDigestStrip from '../components/site/EditorialDigestStrip.astro';
import IssueHero from '../components/site/IssueHero.astro';
import { homePageHero, submenuHeroByRoute } from '../data/submenu-heroes';
import { writers } from '../data/writers';
import { currentIssue } from '../data/issues';

const journey = [
  {
    step: '01',
    title: 'Perimenopoz',
    excerpt: 'Adet düzenin değişmeye başladığında vücudunun neyi sessizce anlattığını birlikte okumak için sakin bir başlangıç rehberi.',
    href: '/hormonal-gecis/perimenopoz',
    imageKey: '/hormonal-gecis/perimenopoz' as const,
  },
  {
    step: '02',
    title: 'Menopoza Hazırlık',
    excerpt: 'Geçişe adım adım ısınırken günlük düzenini, takibini ve koruyucu alışkanlıklarını bu dönemden geçen birçoğumuz gibi sabırla kurabilirsin.',
    href: '/hormonal-gecis/menopoza-hazirlik',
    imageKey: '/hormonal-gecis/menopoza-hazirlik' as const,
  },
  {
    step: '03',
    title: 'Menopoz',
    excerpt: 'Sık karşılaştığımız belirtileri tanıman ve günlük yaşamını biraz daha yumuşatman için yanında duran sade, akran tonlu bir çerçeve.',
    href: '/hormonal-gecis/menopoz',
    imageKey: '/hormonal-gecis/menopoz' as const,
  },
  {
    step: '04',
    title: '40 Sonrası',
    excerpt: 'Bedenini, zihnini ve uzun vadeli iyi olma halini bir bütün olarak düşündüğümüz, koruyucu sağlığı birlikte planladığımız geniş bir bölüm.',
    href: '/hormonal-gecis/40-sonrasi',
    imageKey: '/hormonal-gecis/40-sonrasi' as const,
  },
];

const editorialPicks = [
  {
    tag: 'Vitaminler',
    title: 'D Vitamini ve Kemik Dengesi',
    body: '40 sonrası dönemde D vitamini takibi ve günlük yaşamla ilişkili temel noktalar.',
    href: '/zamansiz-yasam/vitaminler',
    highlight: false,
    author: 'Berna Aksoy',
  },
  {
    tag: 'Deneysel Yaklaşımlar',
    title: 'Yeni Yaklaşımlar Üzerine Ne Biliyoruz?',
    body: 'Araştırma aşamasındaki yöntemlerin sınırları, beklenti yönetimi ve güvenli okuma notları.',
    href: '/zamansiz-yasam/deneysel',
    highlight: true,
    author: 'Berna Aksoy',
  },
  {
    tag: 'Ameliyatsız',
    title: 'Nefes ve Uyku Rutinleri',
    body: 'Uyku kalitesini destekleyebilecek düşük riskli alışkanlıkların bilimsel çerçevesi.',
    href: '/zamansiz-yasam/non-invaziv',
    highlight: false,
    author: 'Berna Aksoy',
  },
];

const editorialRecent = [
  {
    dateLine: '14 NİSAN 2026 · HORMONAL GEÇİŞ',
    title: 'Perimenopozda Adet Takibi Nasıl Yapılır?',
    excerpt: 'Belirti günlüğü, düzenli takip ve günlük yaşam notları.',
    href: '/library',
    thumbnailSrc: submenuHeroByRoute['/hormonal-gecis/perimenopoz'].src,
    thumbnailAlt: 'Perimenopozda Adet Takibi Nasıl Yapılır?',
    author: 'Berna Aksoy',
  },
  {
    dateLine: '11 NİSAN 2026 · BEDEN & YAKINLIK',
    title: 'Cinsellikte Konforu Etkileyen Değişimler',
    excerpt: 'Beden sinyallerini tanımaya ve iletişimi güçlendirmeye odaklanan sade bir içerik özeti.',
    href: '/library',
    thumbnailSrc: submenuHeroByRoute['/beden-yakinlik'].src,
    thumbnailAlt: 'Cinsellikte Konforu Etkileyen Değişimler',
    author: 'Berna Aksoy',
  },
  {
    dateLine: '7 NİSAN 2026 · ZİHİN & DENGE',
    title: 'Ruh Hali Dalgalanmalarını Anlamak',
    excerpt: 'Uyku, stres ve günlük rutin ilişkisini sade bir çerçevede ele alan başlangıç rehberi.',
    href: '/library',
    thumbnailSrc: submenuHeroByRoute['/zihin-denge'].src,
    thumbnailAlt: 'Ruh Hali Dalgalanmalarını Anlamak',
    author: 'Berna Aksoy',
  },
  {
    dateLine: '2 NİSAN 2026 · YAŞAM TARZI',
    title: '40 Sonrası Hareket Planı Oluşturmak',
    excerpt: 'Uygulanabilir hareket önerileri ve sürdürülebilir planlama adımlarıyla pratik bir yol haritası.',
    href: '/library',
    thumbnailSrc: submenuHeroByRoute['/hormonal-gecis/40-sonrasi'].src,
    thumbnailAlt: '40 Sonrası Hareket Planı Oluşturmak',
    author: 'Alara Baykent',
  },
];

---

<SiteLayout
  title="Estranova - Kadın Sağlığı Editoryal Rehberi"
  description="Perimenopoz, menopoza hazırlık, menopoz ve 40 sonrası yaşam dönemlerinde güvenilir editoryal içerikler."
>
  <SiteNavbar currentPath="/" />

  <main id="main-content" class="text-ink">
    <HomeHero hero={homePageHero} />

    <section class="border-t border-burgundy/10 bg-white px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <header class="mb-10 max-w-3xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
            <span class="font-serif font-normal tabular-nums text-gold">01</span>
            <span class="mx-2 text-gold">—</span>
            Yolculuk Haritası
          </p>
          <h2 class="mb-4 font-serif text-4xl leading-tight text-ink md:text-5xl">Hormonal Geçiş Yolculuk Haritası</h2>
          <p class="text-lg leading-relaxed text-ink/75">
            Her dönem farklı sorular getirir. İçerikleri, yaşam evresine göre adım adım takip edebilirsiniz.
          </p>
        </header>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
          {
            journey.map((j) => {
              const img = submenuHeroByRoute[j.imageKey];
              return (
                <article class="group overflow-hidden rounded-[28px] border border-burgundy/12 bg-cream-soft shadow-sm transition hover:shadow-lg">
                  <a href={j.href} class="block h-full outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2">
                    <div class="relative h-36 overflow-hidden">
                      <img
                        src={img.src}
                        alt=""
                        width="600"
                        height="225"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.04]"
                      />
                      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1c1412]/65 via-[#1c1412]/15 to-transparent" />
                      <span class="absolute bottom-3 left-4 font-serif text-3xl font-medium tabular-nums text-white/95 md:text-4xl">
                        {j.step}
                      </span>
                    </div>
                    <div class="border-t border-burgundy/10 p-7">
                      <h3 class="mb-3 font-serif text-2xl">{j.title}</h3>
                      <p class="mb-4 leading-relaxed text-ink/75">{j.excerpt}</p>
                      <span class="font-semibold text-burgundy group-hover:underline">Devamını Oku</span>
                    </div>
                  </a>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <div class="mx-auto flex max-w-sm items-center justify-center gap-4 py-8 md:py-10">
      <span class="h-px flex-1 bg-gold/35"></span>
      <span class="font-serif text-xl text-gold" aria-hidden="true">❦</span>
      <span class="h-px flex-1 bg-gold/35"></span>
    </div>

    <section class="border-t border-burgundy/10 bg-gradient-to-b from-cream-warm to-[#F0E4CF] px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <div
          class="overflow-hidden rounded-[36px] border border-burgundy/12 bg-white p-8 shadow-[0_20px_50px_-24px_rgba(44,24,28,0.35)] ring-1 ring-black/5 md:p-12"
        >
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
            <span class="font-serif font-normal tabular-nums text-gold">02</span>
            <span class="mx-2 text-gold">—</span>
            Editoryal Not
          </p>
          <h2 class="mb-2 font-serif text-4xl md:text-5xl">Sıcacık Köşe</h2>
          <p class="mb-8 text-sm font-medium text-ink/65">
            Her ay site editörümüz <span class="text-ink">Berna Aksoy</span> burada yazıyor.
          </p>

          <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:gap-14">
            <div class="shrink-0 lg:w-[220px]">
              <img
                src="/images/writers/berna-aksoy.webp"
                alt="Berna Aksoy, Estranova site editörü"
                width="220"
                height="220"
                loading="lazy"
                decoding="async"
                class="mx-auto block aspect-square w-40 rounded-full border-4 border-cream-warm object-cover object-center shadow-md ring-1 ring-burgundy/10 md:w-44 lg:mx-0 lg:w-full"
              />
            </div>
            <div class="min-w-0 flex-1">
              <h3 class="mb-4 font-serif text-2xl text-burgundy md:text-3xl">Bu Ay Ne Konuşuyoruz?</h3>
              <p class="mb-3 text-lg leading-relaxed text-ink/75">
                Nisan'da masalarımızda iki başlık var: uyku ve kemik. İkisi de kendi başına yeterince sessiz konular — ama bir
                araya gelince, perimenopozun nasıl bir sabırla okunması gerektiğini hatırlatıyor. Bu ay daha çok dinlemek, daha az
                karar almak üzerine yazıyorum.
              </p>
              <p class="mb-6 text-lg leading-relaxed text-ink/75">
                Bu dönemde yoğun bir pazarlama dalgası var — yeni yaklaşımlar, yeni isimler, yeni tartışmalar. Okurken karar değil,
                bağlam arıyorum. Bu ayın seçkisini de bu gözle hazırladım: karmaşık olanı sadeleştirecek, aceleye düşmeyecek içerikler.
              </p>
              <p class="mb-4 font-serif text-base italic text-ink/70">— Berna Aksoy</p>
              <p class="mb-6 text-xs uppercase tracking-[0.2em] text-ink/55">
                <span>Editöryal inceleme: Berna Aksoy</span>
                <span class="mx-2 text-gold">·</span>
                <span>Tıbben gözden geçirilmiş editöryal içerik</span>
                <span class="mx-2 text-gold">·</span>
                <span>Son güncelleme: 14 Nisan 2026</span>
              </p>
              <a
                href="/editorun-kosesi/nisan-2026"
                class="inline-flex items-center rounded-xl bg-burgundy px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:opacity-95 focus:outline-none focus:ring-2 focus:ring-burgundy/35"
              >
                Ayın yazısını oku
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <IssueHero issue={currentIssue} sectionNumber="03" />

    <section class="border-t border-burgundy/10 bg-white px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <header class="mb-10 max-w-3xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
            <span class="font-serif font-normal tabular-nums text-gold">04</span>
            <span class="mx-2 text-gold">—</span>
            EDİTÖRYAL SEÇKİ
          </p>
          <h2 class="mb-4 font-serif text-4xl leading-tight md:text-5xl">Öne çıkanlar ve son yayınlar</h2>
          <p class="text-lg leading-relaxed text-ink/75">
            Editör seçkisi: zamansız yaşamdan üç öne çıkan başlık ve son yayınlar.
          </p>
        </header>

        <div class="grid grid-cols-1 items-stretch gap-6 md:grid-cols-3 md:gap-7">
          {
            editorialPicks.map((z) => (
              <a
                href={z.href}
                class:list={[
                  'group flex h-full flex-col rounded-[28px] border bg-cream-soft p-7 shadow-sm transition focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2',
                  z.highlight
                    ? 'border-burgundy/35 ring-2 ring-burgundy/20 md:-translate-y-1 md:shadow-xl'
                    : 'border-burgundy/12 hover:-translate-y-0.5 hover:shadow-md',
                ]}
              >
                <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-burgundy">{z.tag}</p>
                <h3 class="mb-3 font-serif text-2xl group-hover:underline group-hover:decoration-burgundy/35">{z.title}</h3>
                <p class="mb-5 flex-1 leading-relaxed text-ink/75">{z.body}</p>
                <p class="mt-2 font-serif text-xs italic text-ink/55">
                  Yazan: <span class="text-ink/75">{z.author}</span>
                </p>
              </a>
            ))
          }
        </div>

        <div class="mt-14 md:mt-16">
          <h3 class="mb-6 font-serif text-2xl text-ink">Son yayınlar</h3>
          <div>
            {
              editorialRecent.map((item) => (
                <a
                  href={item.href}
                  class="group flex items-start gap-4 border-t border-burgundy/15 py-6 focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2 md:gap-6"
                >
                  <img
                    src={item.thumbnailSrc}
                    alt={item.thumbnailAlt}
                    width="64"
                    height="64"
                    loading="lazy"
                    decoding="async"
                    class="h-12 w-12 shrink-0 rounded-lg object-cover ring-1 ring-burgundy/10 md:h-16 md:w-16"
                  />
                  <div class="min-w-0 flex-1">
                    <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-burgundy">{item.dateLine}</p>
                    <h4 class="mb-2 font-serif text-2xl text-ink transition group-hover:underline group-hover:decoration-gold group-hover:decoration-1 group-hover:underline-offset-[6px]">
                      {item.title}
                    </h4>
                    <p class="text-base leading-relaxed text-ink/70">{item.excerpt}</p>
                    <p class="mt-3 font-serif text-xs italic text-ink/55">
                      Yazan: <span class="text-ink/75">{item.author}</span>
                    </p>
                  </div>
                </a>
              ))
            }
          </div>
          <div class="mt-6 flex justify-end">
            <a
              href="/library"
              class="text-sm font-semibold text-burgundy underline decoration-burgundy/50 underline-offset-4 transition hover:decoration-burgundy focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
            >
              Tüm yazılar →
            </a>
          </div>
        </div>
      </div>
    </section>

    <SymptomNavigation />

    <section class="border-t border-b border-burgundy/12 bg-white px-6 py-10 md:py-12">
      <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 text-center">
        <p class="font-sans text-sm text-ink/75">
          İçeriklerimiz editöryal ve tıbbi incelemeden geçer.{' '}
          <a
            href="/editoryal-politika/nasil-arastiriyoruz"
            class="text-ink underline decoration-gold/60 underline-offset-4 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
            >Kanıt seviyeleri nasıl belirlenir? →</a>
        </p>
        <nav
          aria-label="Güven ve politikalar"
          class="flex flex-col items-center gap-2 font-sans sm:flex-row sm:flex-wrap sm:justify-center sm:gap-x-3 sm:gap-y-1"
        >
          <a
            href="/editoryal-politika"
            class="text-xs uppercase tracking-[0.24em] text-ink/65 transition hover:text-burgundy focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
            >Editöryal Politika</a>
          <span class="hidden text-gold sm:inline" aria-hidden="true">·</span>
          <a
            href="/tibbi-sorumluluk"
            class="text-xs uppercase tracking-[0.24em] text-ink/65 transition hover:text-burgundy focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
            >Tıbbi Sorumluluk Reddi</a>
          <span class="hidden text-gold sm:inline" aria-hidden="true">·</span>
          <a
            href="/editoryal-politika/nasil-arastiriyoruz"
            class="text-xs uppercase tracking-[0.24em] text-ink/65 transition hover:text-burgundy focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
            >Nasıl Araştırıyoruz</a>
        </nav>
      </div>
    </section>

    <section class="border-t border-burgundy/10 bg-white px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <header class="mb-12 max-w-3xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
            <span class="font-serif font-normal tabular-nums text-gold">05</span>
            <span class="mx-2 text-gold">—</span>
            Yazar Kadrosu
          </p>
          <h2 class="mb-4 font-serif text-4xl leading-tight md:text-5xl">Bu sayıda yazanlar</h2>
          <p class="text-lg leading-relaxed text-ink/75">
            Estranova editöryal ekibi: farklı yaş, uzmanlık ve hayat ritimlerinden yedi ses. Her yazar, kendi bakış açısıyla
            katkı sunuyor.
          </p>
          <p class="mt-4 text-lg leading-relaxed text-ink/75">
            Estranova bir “kişisel vitrin” ya da “influencer alanı” değil. Burada yazmak; deneyimi parlatmak değil, anlamlandırmak demek.
            <a
              href="/yayin-kurulu#neden-yaziyorlar"
              class="ml-1 font-semibold text-burgundy underline decoration-burgundy/40 underline-offset-4 transition hover:decoration-burgundy"
              >Neden burada yazıyorlar? →</a
            >
          </p>
        </header>

        <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 lg:gap-6">
          {
            writers.map((w) => (
              <li>
                <a
                  href={`/yazarlar/${w.slug}`}
                  class="group flex h-full flex-col items-center text-center focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
                >
                  {w.portrait ? (
                    <img
                      src={w.portrait}
                      alt={`${w.displayName} portresi`}
                      width="192"
                      height="192"
                      loading="lazy"
                      decoding="async"
                      class="h-24 w-24 rounded-full object-cover ring-2 ring-burgundy/15 transition group-hover:ring-burgundy/40 md:h-28 md:w-28"
                    />
                  ) : (
                    <div class="flex h-24 w-24 items-center justify-center rounded-full bg-cream-warm font-serif text-3xl text-burgundy ring-2 ring-burgundy/15 transition group-hover:ring-burgundy/40 md:h-28 md:w-28 md:text-4xl">
                      {w.displayName
                        .split(/\s+/)
                        .filter((part) => part.length > 0)
                        .map((n) => n[0])
                        .join('')}
                    </div>
                  )}
                  <p class="mt-4 text-[10px] font-bold uppercase tracking-[0.2em] text-burgundy">
                    {w.role.split('/')[0].trim()}
                  </p>
                  <h3 class="mt-2 font-serif text-xl text-ink group-hover:underline group-hover:decoration-burgundy/35">
                    {w.displayName}
                  </h3>
                  <p class="mt-3 font-serif text-sm italic leading-relaxed text-ink/70">{w.signaturePhrase}</p>
                </a>
              </li>
            ))
          }
        </ul>

        <div class="mt-10 flex justify-center">
          <a
            href="/yayin-kurulu"
            class="text-sm font-semibold text-burgundy underline decoration-burgundy/40 underline-offset-4 transition hover:decoration-burgundy"
          >
            Tüm yayın kurulu →
          </a>
        </div>
      </div>
    </section>

    <section class="border-t border-white/10 bg-burgundy px-6 py-24 text-cream-soft md:py-32">
      <div class="mx-auto max-w-4xl">
        <blockquote class="relative pl-8 md:pl-10">
          <span aria-hidden="true" class="absolute left-0 top-0 h-full w-[2px] bg-gold"></span>
          <p class="font-serif text-4xl italic leading-snug md:text-5xl md:leading-[1.1] lg:text-6xl lg:leading-[1.05]">
            Okumak, bu dönemden geçerken kendine ayırabileceğin en küçük ama en kalıcı iyiliktir.
          </p>
        </blockquote>
      </div>
    </section>

    <EditorialDigestStrip />

    <section class="border-t border-burgundy/10 bg-gradient-to-b from-cream-warm to-[#EEDFC8] px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <div class="rounded-[36px] border border-burgundy/12 bg-white p-8 shadow-sm md:p-12">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
            <span class="font-serif font-normal tabular-nums text-gold">07</span>
            <span class="mx-2 text-gold">—</span>
            Koruyucu Sağlık
          </p>
          <h2 class="mb-4 font-serif text-4xl leading-tight md:text-5xl">40 Yaşından Sonra Koruyucu Sağlık</h2>
          <p
            class="mb-4 max-w-3xl text-lg leading-relaxed text-ink/75 first-letter:float-left first-letter:mr-3 first-letter:mt-1 first-letter:font-serif first-letter:text-6xl first-letter:font-normal first-letter:leading-[0.85] first-letter:text-burgundy md:first-letter:text-7xl md:first-letter:mr-4"
          >
            Koruyucu sağlık, aslında hepimizin zaten bildiği şeylerin sakin bir takvime oturmuş hali: düzenli taramalar, yıllık kontroller ve gün içinde küçük ama tutarlı alışkanlıklar.
          </p>
          <p class="mb-4 max-w-3xl text-lg leading-relaxed text-ink/75">
            40 sonrası bedenin bazı başlıkları daha yakından izlemek istiyor. Bunu bir yük olarak değil, kendine ayırdığın zamanın bir parçası olarak düşünmen çoğu zaman yeterli oluyor.
          </p>
          <p class="mb-8 max-w-3xl text-lg leading-relaxed text-ink/75">
            Bu bölümde yaş dönemine göre önerilen kontrol başlıklarını sade bir takvim mantığıyla bulacaksın; panik yok, sadece birlikte hatırlayalım diye düzenlenmiş bir yol haritası.
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href="/hormonal-gecis/40-sonrasi"
