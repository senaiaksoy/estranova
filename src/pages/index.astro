---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import { ChevronRight, ArrowRight, AlertCircle } from 'lucide-react';

const experts = [
  { name: "Prof. Dr. Selin Yılmaz", role: "Endokrinoloji", img: "https://images.unsplash.com/photo-1559839734-2b71f153678f?auto=format&fit=crop&q=80&w=400" },
  { name: "Doç. Dr. Murat Can", role: "Kardiyoloji", img: "https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&q=80&w=400" },
  { name: "Dr. Ayşe Demir", role: "Nöroloji", img: "https://images.unsplash.com/photo-1594824476967-48c8b964273f?auto=format&fit=crop&q=80&w=400" }
];

const stages = [
  { title: "Perimenopoz", desc: "Hormonal dalgalanmaların başladığı, genellikle 40'lı yaşların başındaki evre.", color: "bg-primary/5" },
  { title: "Menopoz", desc: "Adet döngüsünün 12 ay boyunca kesintisiz olarak durduğu biyolojik nokta.", color: "bg-secondary/5" },
  { title: "Postmenopoz", desc: "Menopozdan sonraki yaşam boyu sürecek olan yeni denge dönemi.", color: "bg-charcoal/5" }
];

const symptoms = [
  "Sıcak Basmaları", "Uyku Bozuklukları", "Duygu Durum Değişimleri", "Eklem Ağrıları",
  "Cilt Değişimleri", "Hafıza Sorunları", "Metabolizma Hızı", "Saç İncelmesi"
];
---

<Layout title="Estranova - The Clinical Curator">
	<Navbar client:load currentPage="/" />
	<main class="pt-20">
		<Hero />

		{/* Expert Board Section */}
		<section class="py-24 bg-surface-container px-6">
			<div class="max-w-7xl mx-auto">
				<div class="text-center mb-16">
					<h2 class="text-4xl md:text-5xl font-serif mb-6">Bilimsel Danışma Kurulumuz</h2>
					<p class="text-charcoal/60 max-w-2xl mx-auto">
						Estranova içerikleri, alanında uzman tıp doktorları ve araştırmacılar tarafından titizlikle incelenir ve onaylanır.
					</p>
				</div>
				
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					{experts.map((expert) => (
						<div class="group cursor-pointer">
							<div class="relative aspect-square rounded-3xl overflow-hidden mb-6 shadow-lg">
								<img src={expert.img} alt={expert.name} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700" referrerpolicy="no-referrer" />
								<div class="absolute inset-0 bg-primary/20 opacity-0 group-hover:opacity-100 transition-opacity"></div>
							</div>
							<h3 class="text-xl font-serif mb-1">{expert.name}</h3>
							<p class="text-sm text-secondary font-bold tracking-wider uppercase">{expert.role}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		{/* Physiological Stages */}
		<section class="py-24 px-6">
			<div class="max-w-7xl mx-auto">
				<div class="flex flex-col md:flex-row justify-between items-end gap-8 mb-16">
					<div class="max-w-2xl">
						<h2 class="text-4xl md:text-5xl font-serif mb-6">Fizyolojik Evreler</h2>
						<p class="text-charcoal/60">
							Vücudunuzun geçtiği her evreyi anlamak, süreci yönetmenin ilk adımıdır.
						</p>
					</div>
					<a href="/library" class="text-primary font-bold flex items-center gap-2 group">
						Tümünü Keşfet <ChevronRight size={20} class="group-hover:translate-x-1 transition-transform" />
					</a>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					{stages.map((stage, i) => (
						<div class={`p-10 rounded-[40px] transition-all hover:-translate-y-2 ${stage.color}`}>
							<div class="w-12 h-12 rounded-2xl bg-white flex items-center justify-center text-primary shadow-sm mb-8">
								<span class="font-serif text-xl">0{i+1}</span>
							</div>
							<h3 class="text-2xl font-serif mb-4">{stage.title}</h3>
							<p class="text-charcoal/60 leading-relaxed mb-8">{stage.desc}</p>
							<a href="/library" class="w-10 h-10 rounded-full border border-charcoal/10 flex items-center justify-center hover:bg-charcoal hover:text-white transition-all">
								<ArrowRight size={18} />
							</a>
						</div>
					))}
				</div>
			</div>
		</section>

		{/* Featured Article Preview */}
		<section class="py-24 bg-primary text-white px-6 overflow-hidden relative">
			<div class="absolute top-0 right-0 w-1/2 h-full opacity-10 pointer-events-none">
				<svg viewBox="0 0 400 400" class="w-full h-full">
					<path d="M0,200 Q100,100 200,200 T400,200" fill="none" stroke="white" stroke-width="1" />
					<path d="M0,220 Q100,120 200,220 T400,220" fill="none" stroke="white" stroke-width="1" />
					<path d="M0,240 Q100,140 200,240 T400,240" fill="none" stroke="white" stroke-width="1" />
				</svg>
			</div>
			
			<div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
				<div class="relative z-10">
					<p class="text-secondary font-bold tracking-[0.3em] uppercase mb-6">ÖNE ÇIKAN ARAŞTIRMA</p>
					<h2 class="text-4xl md:text-6xl font-serif leading-tight mb-8">
						Östrojenin Nöro-Protektif Etkileri ve Bilişsel Sağlık
					</h2>
					<p class="text-white/70 text-lg mb-10 leading-relaxed">
						Son klinik çalışmalar, östrojenin beyin hücrelerini koruma ve hafıza fonksiyonlarını destekleme konusundaki kritik rolünü ortaya koyuyor.
					</p>
					<a 
						href="/article"
						class="bg-white text-primary px-8 py-4 rounded-full font-bold text-lg hover:bg-surface transition-all inline-flex items-center gap-2"
					>
						Makaleyi Oku
						<ArrowRight size={20} />
					</a>
				</div>
				<div class="relative">
					<div class="aspect-video rounded-3xl overflow-hidden shadow-2xl rotate-3">
						<img 
							src="https://images.unsplash.com/photo-1559757175-5700dde675bc?auto=format&fit=crop&q=80&w=1000" 
							alt="Brain Research" 
							class="w-full h-full object-cover"
							referrerpolicy="no-referrer"
						/>
					</div>
					<div class="absolute -bottom-6 -left-6 bg-secondary p-8 rounded-2xl shadow-xl -rotate-3">
						<p class="text-sm font-bold tracking-widest uppercase mb-2">OKUMA SÜRESİ</p>
						<p class="text-3xl font-serif">12 Dakika</p>
					</div>
				</div>
			</div>
		</section>

		{/* Symptoms Grid */}
		<section class="py-24 px-6">
			<div class="max-w-7xl mx-auto">
				<div class="text-center mb-16">
					<h2 class="text-4xl md:text-5xl font-serif mb-6">Semptom Kütüphanesi</h2>
					<p class="text-charcoal/60 max-w-2xl mx-auto">
						Yaşadığınız değişimleri bilimsel bir çerçevede anlamlandırın.
					</p>
				</div>

				<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
					{symptoms.map((symptom) => (
						<a href="/symptoms" class="p-8 rounded-3xl border border-charcoal/5 hover:border-primary/20 hover:bg-primary/5 transition-all text-left group">
							<div class="w-10 h-10 rounded-xl bg-surface-container flex items-center justify-center text-primary mb-4 group-hover:bg-primary group-hover:text-white transition-all">
								<AlertCircle size={20} />
							</div>
							<p class="font-serif text-lg">{symptom}</p>
						</a>
					))}
				</div>
			</div>
		</section>

		{/* CTA Section */}
		<section class="py-24 px-6">
			<div class="max-w-5xl mx-auto bg-surface-container rounded-[60px] p-12 md:p-20 text-center relative overflow-hidden">
				<div class="absolute top-0 left-0 w-32 h-32 bg-primary/5 rounded-full -translate-x-1/2 -translate-y-1/2"></div>
				<div class="absolute bottom-0 right-0 w-64 h-64 bg-secondary/5 rounded-full translate-x-1/3 translate-y-1/3"></div>
				
				<div class="relative z-10">
					<h2 class="text-4xl md:text-6xl font-serif mb-8">Kişiselleştirilmiş <br /> Rehberinizi Oluşturun</h2>
					<p class="text-lg text-charcoal/60 mb-12 max-w-xl mx-auto">
						Semptomlarınızı ve hedeflerinizi paylaşın, size özel hazırlanmış klinik öneriler ve yaşam tarzı rehberine ulaşın.
					</p>
					<a 
						href="/assessment"
						class="bg-primary text-white px-10 py-5 rounded-full font-bold text-xl hover:bg-primary-container transition-all shadow-2xl shadow-primary/20 inline-block"
					>
						Değerlendirmeye Başla
					</a>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
