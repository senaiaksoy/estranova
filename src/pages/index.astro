---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import HomeHero from '../components/site/HomeHero.astro';
import SymptomChipLink from '../components/site/SymptomChipLink.astro';
import EditorialDigestStrip from '../components/site/EditorialDigestStrip.astro';
import { homePageHero, submenuHeroByRoute } from '../data/submenu-heroes';
import { writers } from '../data/writers';

const journey = [
  {
    step: '01',
    title: 'Perimenopoz',
    excerpt: 'Adet düzenin değişmeye başladığında vücudunun neyi sessizce anlattığını birlikte okumak için sakin bir başlangıç rehberi.',
    href: '/hormonal-gecis/perimenopoz',
    imageKey: '/hormonal-gecis/perimenopoz' as const,
  },
  {
    step: '02',
    title: 'Menopoza Hazırlık',
    excerpt: 'Geçişe adım adım ısınırken günlük düzenini, takibini ve koruyucu alışkanlıklarını bu dönemden geçen birçoğumuz gibi sabırla kurabilirsin.',
    href: '/hormonal-gecis/menopoza-hazirlik',
    imageKey: '/hormonal-gecis/menopoza-hazirlik' as const,
  },
  {
    step: '03',
    title: 'Menopoz',
    excerpt: 'Sık karşılaştığımız belirtileri tanıman ve günlük yaşamını biraz daha yumuşatman için yanında duran sade, akran tonlu bir çerçeve.',
    href: '/hormonal-gecis/menopoz',
    imageKey: '/hormonal-gecis/menopoz' as const,
  },
  {
    step: '04',
    title: '40 Sonrası',
    excerpt: 'Bedenini, zihnini ve uzun vadeli iyi olma halini bir bütün olarak düşündüğümüz, koruyucu sağlığı birlikte planladığımız geniş bir bölüm.',
    href: '/hormonal-gecis/40-sonrasi',
    imageKey: '/hormonal-gecis/40-sonrasi' as const,
  },
];

const editorialPicks = [
  {
    tag: 'Vitaminler',
    title: 'D Vitamini ve Kemik Dengesi',
    body: '40 sonrası dönemde D vitamini takibi ve günlük yaşamla ilişkili temel noktalar.',
    href: '/zamansiz-yasam/vitaminler',
    highlight: false,
    author: 'Berna Aksoy',
  },
  {
    tag: 'Deneysel Yaklaşımlar',
    title: 'Yeni Yaklaşımlar Üzerine Ne Biliyoruz?',
    body: 'Araştırma aşamasındaki yöntemlerin sınırları, beklenti yönetimi ve güvenli okuma notları.',
    href: '/zamansiz-yasam/deneysel',
    highlight: true,
    author: 'Berna Aksoy',
  },
  {
    tag: 'Non-İnvaziv',
    title: 'Nefes ve Uyku Rutinleri',
    body: 'Uyku kalitesini destekleyebilecek düşük riskli alışkanlıkların bilimsel çerçevesi.',
    href: '/zamansiz-yasam/non-invaziv',
    highlight: false,
    author: 'Berna Aksoy',
  },
];

const editorialRecent = [
  {
    dateLine: '14 NİSAN 2026 · HORMONAL GEÇİŞ',
    title: 'Perimenopozda Adet Takibi Nasıl Yapılır?',
    excerpt: 'Belirti günlüğü, düzenli takip ve günlük yaşam notları.',
    href: '/library',
    thumbnailSrc: submenuHeroByRoute['/hormonal-gecis/perimenopoz'].src,
    thumbnailAlt: 'Perimenopozda Adet Takibi Nasıl Yapılır?',
    author: 'Berna Aksoy',
  },
  {
    dateLine: '11 NİSAN 2026 · BEDEN & YAKINLIK',
    title: 'Yakınlıkta Konforu Etkileyen Değişimler',
    excerpt: 'Beden sinyallerini tanımaya ve iletişimi güçlendirmeye odaklanan sade bir içerik özeti.',
    href: '/library',
    thumbnailSrc: submenuHeroByRoute['/beden-yakinlik'].src,
    thumbnailAlt: 'Yakınlıkta Konforu Etkileyen Değişimler',
    author: 'Berna Aksoy',
  },
  {
    dateLine: '7 NİSAN 2026 · ZİHİN & DENGE',
    title: 'Ruh Hali Dalgalanmalarını Anlamak',
    excerpt: 'Uyku, stres ve günlük rutin ilişkisini sade bir çerçevede ele alan başlangıç rehberi.',
    href: '/library',
    thumbnailSrc: submenuHeroByRoute['/zihin-denge'].src,
    thumbnailAlt: 'Ruh Hali Dalgalanmalarını Anlamak',
    author: 'Berna Aksoy',
  },
  {
    dateLine: '2 NİSAN 2026 · YAŞAM TARZI',
    title: '40 Sonrası Hareket Planı Oluşturmak',
    excerpt: 'Uygulanabilir hareket önerileri ve sürdürülebilir planlama adımlarıyla pratik bir yol haritası.',
    href: '/library',
    thumbnailSrc: submenuHeroByRoute['/hormonal-gecis/40-sonrasi'].src,
    thumbnailAlt: '40 Sonrası Hareket Planı Oluşturmak',
    author: 'Alara Baykent',
  },
];

const symptoms: { label: string; icon: 'flame' | 'moon' | 'heart' | 'scale' | 'bone' | 'brain' | 'sparkles' | 'leaf' }[] = [
  { label: 'Sıcak Basması', icon: 'flame' },
  { label: 'Uyku Bozukluğu', icon: 'moon' },
  { label: 'Ruh Hali Değişimi', icon: 'heart' },
  { label: 'Kilo Artışı', icon: 'scale' },
  { label: 'Eklem Ağrısı', icon: 'bone' },
  { label: 'Hafıza Sorunları', icon: 'brain' },
  { label: 'Cilt Değişimleri', icon: 'sparkles' },
  { label: 'Libido Azalması', icon: 'leaf' },
];

---

<SiteLayout
  title="Estranova - Kadın Sağlığı Editoryal Rehberi"
  description="Perimenopoz, menopoza hazırlık, menopoz ve 40 sonrası yaşam dönemlerinde güvenilir editoryal içerikler."
>
  <SiteNavbar currentPath="/" />

  <main id="main-content" class="text-[#2D2D2D]">
    <HomeHero hero={homePageHero} />

    <section class="border-t border-[#6B2D3E]/10 bg-white px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <header class="mb-10 max-w-3xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">
            <span class="font-serif font-normal tabular-nums text-[#C9A96E]">01</span>
            <span class="mx-2 text-[#C9A96E]">—</span>
            Yolculuk Haritası
          </p>
          <h2 class="mb-4 font-serif text-4xl leading-tight text-[#2D2D2D] md:text-5xl">Hormonal Geçiş Yolculuk Haritası</h2>
          <p class="text-lg leading-relaxed text-[#2D2D2D]/75">
            Her dönem farklı sorular getirir. İçerikleri, yaşam evresine göre adım adım takip edebilirsiniz.
          </p>
        </header>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
          {
            journey.map((j) => {
              const img = submenuHeroByRoute[j.imageKey];
              return (
                <article class="group overflow-hidden rounded-[28px] border border-[#6B2D3E]/12 bg-[#FDF8F0] shadow-sm transition hover:shadow-lg">
                  <a href={j.href} class="block h-full outline-none focus-visible:ring-2 focus-visible:ring-[#6B2D3E]/35 focus-visible:ring-offset-2">
                    <div class="relative h-36 overflow-hidden">
                      <img
                        src={img.src}
                        alt=""
                        width="600"
                        height="225"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.04]"
                      />
                      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1c1412]/65 via-[#1c1412]/15 to-transparent" />
                      <span class="absolute bottom-3 left-4 font-serif text-3xl font-medium tabular-nums text-white/95 md:text-4xl">
                        {j.step}
                      </span>
                    </div>
                    <div class="border-t border-[#6B2D3E]/10 p-7">
                      <h3 class="mb-3 font-serif text-2xl">{j.title}</h3>
                      <p class="mb-4 leading-relaxed text-[#2D2D2D]/75">{j.excerpt}</p>
                      <span class="font-semibold text-[#6B2D3E] group-hover:underline">Devamını Oku</span>
                    </div>
                  </a>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <div class="mx-auto flex max-w-sm items-center justify-center gap-4 py-8 md:py-10">
      <span class="h-px flex-1 bg-[#C9A96E]/35"></span>
      <span class="font-serif text-xl text-[#C9A96E]" aria-hidden="true">❦</span>
      <span class="h-px flex-1 bg-[#C9A96E]/35"></span>
    </div>

    <section class="border-t border-[#6B2D3E]/10 bg-gradient-to-b from-[#F5EDE0] to-[#F0E4CF] px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <div
          class="overflow-hidden rounded-[36px] border border-[#6B2D3E]/12 bg-white p-8 shadow-[0_20px_50px_-24px_rgba(44,24,28,0.35)] ring-1 ring-black/5 md:p-12"
        >
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">
            <span class="font-serif font-normal tabular-nums text-[#C9A96E]">02</span>
            <span class="mx-2 text-[#C9A96E]">—</span>
            Editoryal Not
          </p>
          <h2 class="mb-2 font-serif text-4xl md:text-5xl">Sıcacık Köşe</h2>
          <p class="mb-8 text-sm font-medium text-[#2D2D2D]/65">
            Her ay site editörümüz <span class="text-[#2D2D2D]">Berna Aksoy</span> burada yazıyor.
          </p>

          <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:gap-14">
            <div class="shrink-0 lg:w-[220px]">
              <img
                src="/images/writers/berna-aksoy.webp"
                alt="Berna Aksoy, Estranova site editörü"
                width="220"
                height="220"
                loading="lazy"
                decoding="async"
                class="mx-auto block aspect-square w-40 rounded-full border-4 border-[#F5EDE0] object-cover object-center shadow-md ring-1 ring-[#6B2D3E]/10 md:w-44 lg:mx-0 lg:w-full"
              />
            </div>
            <div class="min-w-0 flex-1">
              <h3 class="mb-4 font-serif text-2xl text-[#6B2D3E] md:text-3xl">Bu Ay Ne Konuşuyoruz?</h3>
              <p class="mb-3 text-lg leading-relaxed text-[#2D2D2D]/75">
                Nisan'da masalarımızda iki başlık var: uyku ve kemik. İkisi de kendi başına yeterince sessiz konular — ama bir
                araya gelince, perimenopozun nasıl bir sabırla okunması gerektiğini hatırlatıyor. Bu ay daha çok dinlemek, daha az
                karar almak üzerine yazıyorum.
              </p>
              <p class="mb-6 text-lg leading-relaxed text-[#2D2D2D]/75">
                Bu dönemde yoğun bir pazarlama dalgası var — yeni yaklaşımlar, yeni isimler, yeni tartışmalar. Okurken karar değil,
                bağlam arıyorum. Bu ayın seçkisini de bu gözle hazırladım: karmaşık olanı sadeleştirecek, aceleye düşmeyecek içerikler.
              </p>
              <p class="mb-4 font-serif text-base italic text-[#2D2D2D]/70">— Berna Aksoy</p>
              <p class="mb-6 text-xs uppercase tracking-[0.2em] text-[#2D2D2D]/55">
                <span>Editöryal inceleme: Berna Aksoy</span>
                <span class="mx-2 text-[#C9A96E]">·</span>
                <span>Tıbben gözden geçirilmiş editöryal içerik</span>
                <span class="mx-2 text-[#C9A96E]">·</span>
                <span>Son güncelleme: 14 Nisan 2026</span>
              </p>
              <a
                href="/editorun-kosesi/nisan-2026"
                class="inline-flex items-center rounded-xl bg-[#6B2D3E] px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:opacity-95 focus:outline-none focus:ring-2 focus:ring-[#6B2D3E]/35"
              >
                Ayın yazısını oku
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-[#6B2D3E]/10 bg-white px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <header class="mb-10 max-w-3xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">
            <span class="font-serif font-normal tabular-nums text-[#C9A96E]">03</span>
            <span class="mx-2 text-[#C9A96E]">—</span>
            EDİTÖRYAL SEÇKİ
          </p>
          <h2 class="mb-4 font-serif text-4xl leading-tight md:text-5xl">Öne çıkanlar ve son yayınlar</h2>
          <p class="text-lg leading-relaxed text-[#2D2D2D]/75">
            Editör seçkisi: zamansız yaşamdan üç öne çıkan başlık ve son yayınlar.
          </p>
        </header>

        <div class="grid grid-cols-1 items-stretch gap-6 md:grid-cols-3 md:gap-7">
          {
            editorialPicks.map((z) => (
              <a
                href={z.href}
                class:list={[
                  'group flex h-full flex-col rounded-[28px] border bg-[#FDF8F0] p-7 shadow-sm transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[#6B2D3E]/35 focus-visible:ring-offset-2',
                  z.highlight
                    ? 'border-[#6B2D3E]/35 ring-2 ring-[#6B2D3E]/20 md:-translate-y-1 md:shadow-xl'
                    : 'border-[#6B2D3E]/12 hover:-translate-y-0.5 hover:shadow-md',
                ]}
              >
                <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[#6B2D3E]">{z.tag}</p>
                <h3 class="mb-3 font-serif text-2xl group-hover:underline group-hover:decoration-[#6B2D3E]/35">{z.title}</h3>
                <p class="mb-5 flex-1 leading-relaxed text-[#2D2D2D]/75">{z.body}</p>
                <p class="mt-2 font-serif text-xs italic text-[#2D2D2D]/55">
                  Yazan: <span class="text-[#2D2D2D]/75">{z.author}</span>
                </p>
              </a>
            ))
          }
        </div>

        <div class="mt-14 md:mt-16">
          <h3 class="mb-6 font-serif text-2xl text-[#2D2D2D]">Son yayınlar</h3>
          <div>
            {
              editorialRecent.map((item) => (
                <a
                  href={item.href}
                  class="group flex items-start gap-4 border-t border-[#6B2D3E]/15 py-6 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#6B2D3E]/35 focus-visible:ring-offset-2 md:gap-6"
                >
                  <img
                    src={item.thumbnailSrc}
                    alt={item.thumbnailAlt}
                    width="64"
                    height="64"
                    loading="lazy"
                    decoding="async"
                    class="h-12 w-12 shrink-0 rounded-lg object-cover ring-1 ring-[#6B2D3E]/10 md:h-16 md:w-16"
                  />
                  <div class="min-w-0 flex-1">
                    <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-[#6B2D3E]">{item.dateLine}</p>
                    <h4 class="mb-2 font-serif text-2xl text-[#2D2D2D] transition group-hover:underline group-hover:decoration-[#C9A96E] group-hover:decoration-1 group-hover:underline-offset-[6px]">
                      {item.title}
                    </h4>
                    <p class="text-base leading-relaxed text-[#2D2D2D]/70">{item.excerpt}</p>
                    <p class="mt-3 font-serif text-xs italic text-[#2D2D2D]/55">
                      Yazan: <span class="text-[#2D2D2D]/75">{item.author}</span>
                    </p>
                  </div>
                </a>
              ))
            }
          </div>
          <div class="mt-6 flex justify-end">
            <a
              href="/library"
              class="text-sm font-semibold text-[#6B2D3E] underline decoration-[#6B2D3E]/50 underline-offset-4 transition hover:decoration-[#6B2D3E] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#6B2D3E]/35 focus-visible:ring-offset-2"
            >
              Tüm yazılar →
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-[#6B2D3E]/10 bg-gradient-to-b from-[#FDF8F0] to-[#F8EED8] px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <header class="mb-8 max-w-3xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">
            <span class="font-serif font-normal tabular-nums text-[#C9A96E]">04</span>
            <span class="mx-2 text-[#C9A96E]">—</span>
            Belirti Bazlı Navigasyon
          </p>
          <h2 class="mb-4 font-serif text-4xl leading-tight md:text-5xl">Bugün Ne Hissediyorsun?</h2>
          <p class="text-lg leading-relaxed text-[#2D2D2D]/75">
            Bir belirtiden başlayıp oradan ilerlemek çoğumuz için en doğal yol. Vücudunun en çok hangisiyle konuştuğunu seç, biz oradan devam edelim.
          </p>
        </header>

        <div class="mb-6 flex flex-wrap gap-3">
          <a
            href="/symptoms"
            class="inline-flex items-center rounded-full border border-[#6B2D3E]/25 bg-white px-5 py-2.5 text-sm font-semibold text-[#6B2D3E] shadow-sm transition hover:bg-[#6B2D3E]/5 focus:outline-none focus:ring-2 focus:ring-[#6B2D3E]/30"
          >
            Tüm belirtiler
          </a>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {symptoms.map((s) => <SymptomChipLink href="/symptoms" label={s.label} icon={s.icon} />)}
        </div>
      </div>
    </section>

    <section class="border-t border-b border-[#6B2D3E]/12 bg-white px-6 py-10 md:py-12">
      <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 text-center">
        <p class="font-sans text-sm text-[#2D2D2D]/75">
          İçeriklerimiz editöryal ve tıbbi incelemeden geçer.{' '}
          <a
            href="/editoryal-politika/nasil-arastiriyoruz"
            class="text-[#2D2D2D] underline decoration-[#C9A96E]/60 underline-offset-4 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[#6B2D3E]/35 focus-visible:ring-offset-2"
            >Kanıt seviyeleri nasıl belirlenir? →</a>
        </p>
        <nav
          aria-label="Güven ve politikalar"
          class="flex flex-col items-center gap-2 font-sans sm:flex-row sm:flex-wrap sm:justify-center sm:gap-x-3 sm:gap-y-1"
        >
          <a
            href="/editoryal-politika"
            class="text-xs uppercase tracking-[0.24em] text-[#2D2D2D]/65 transition hover:text-[#6B2D3E] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#6B2D3E]/35 focus-visible:ring-offset-2"
            >Editöryal Politika</a>
          <span class="hidden text-[#C9A96E] sm:inline" aria-hidden="true">·</span>
          <a
            href="/tibbi-sorumluluk"
            class="text-xs uppercase tracking-[0.24em] text-[#2D2D2D]/65 transition hover:text-[#6B2D3E] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#6B2D3E]/35 focus-visible:ring-offset-2"
            >Tıbbi Sorumluluk Reddi</a>
          <span class="hidden text-[#C9A96E] sm:inline" aria-hidden="true">·</span>
          <a
            href="/editoryal-politika/nasil-arastiriyoruz"
            class="text-xs uppercase tracking-[0.24em] text-[#2D2D2D]/65 transition hover:text-[#6B2D3E] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#6B2D3E]/35 focus-visible:ring-offset-2"
            >Nasıl Araştırıyoruz</a>
        </nav>
      </div>
    </section>

    <section class="border-t border-[#6B2D3E]/10 bg-white px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <header class="mb-12 max-w-3xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">
            <span class="font-serif font-normal tabular-nums text-[#C9A96E]">05</span>
            <span class="mx-2 text-[#C9A96E]">—</span>
            Yazar Kadrosu
          </p>
          <h2 class="mb-4 font-serif text-4xl leading-tight md:text-5xl">Bu sayıda yazanlar</h2>
          <p class="text-lg leading-relaxed text-[#2D2D2D]/75">
            Estranova editöryal ekibi: farklı yaş, uzmanlık ve hayat ritimlerinden yedi ses. Her yazar, kendi bakış açısıyla
            katkı sunuyor.
          </p>
        </header>

        <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 lg:gap-6">
          {
            writers.map((w) => (
              <li class="flex flex-col items-center text-center">
                {w.portrait ? (
                  <img
                    src={w.portrait}
                    alt={`${w.displayName} portresi`}
                    width="192"
                    height="192"
                    loading="lazy"
                    decoding="async"
                    class="h-24 w-24 rounded-full object-cover ring-2 ring-[#6B2D3E]/15 md:h-28 md:w-28"
                  />
                ) : (
                  <div class="flex h-24 w-24 items-center justify-center rounded-full bg-[#F5EDE0] font-serif text-3xl text-[#6B2D3E] ring-2 ring-[#6B2D3E]/15 md:h-28 md:w-28 md:text-4xl">
                    {w.displayName
                      .split(/\s+/)
                      .filter((part) => part.length > 0)
                      .map((n) => n[0])
                      .join('')}
                  </div>
                )}
                <p class="mt-4 text-[10px] font-bold uppercase tracking-[0.2em] text-[#6B2D3E]">
                  {w.role.split('/')[0].trim()}
                </p>
                <h3 class="mt-2 font-serif text-xl text-[#2D2D2D]">{w.displayName}</h3>
                <p class="mt-3 font-serif text-sm italic leading-relaxed text-[#2D2D2D]/70">{w.signaturePhrase}</p>
              </li>
            ))
          }
        </ul>

        <div class="mt-10 flex justify-center">
          <a
            href="/yayin-kurulu"
            class="text-sm font-semibold text-[#6B2D3E] underline decoration-[#6B2D3E]/40 underline-offset-4 transition hover:decoration-[#6B2D3E]"
          >
            Tüm yayın kurulu →
