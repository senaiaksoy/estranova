---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import HomeHero from '../components/home/HomeHero.astro';
import ExpertBoardSection from '../components/home/ExpertBoardSection.astro';
import LifeStagesSection from '../components/home/LifeStagesSection.astro';
import FeaturedResearchSection from '../components/home/FeaturedResearchSection.astro';
import SymptomLibrarySection from '../components/home/SymptomLibrarySection.astro';
import HomeEditorialSection from '../components/home/HomeEditorialSection.astro';
---

<SiteLayout
  title="Estranova - The Clinical Curator"
  description="Perimenopoz, menopoza hazirlik, menopoz ve 40+ saglik basliklarinda bilimsel editoryal icerikler."
>
  <SiteNavbar currentPath="/" />

  <main id="main-content" class="pt-24">
    <HomeHero />
    <LifeStagesSection />
    <SymptomLibrarySection />
    <ExpertBoardSection />
    <FeaturedResearchSection />
    <HomeEditorialSection />
  </main>

  <SiteFooter />
</SiteLayout>
