---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import HomeHero from '../components/site/HomeHero.astro';
import SymptomNavigation from '../components/site/SymptomNavigation.astro';
import EditorialDigestStrip from '../components/site/EditorialDigestStrip.astro';
import IssueHero from '../components/site/IssueHero.astro';
import { homePageHero, submenuHeroByRoute } from '../data/submenu-heroes';
import { activeWriters, writers } from '../data/writers';
import { currentIssue, resolveCoverDossier, formatIssuePad } from '../data/issues';
import { magazineConfig } from '../data/magazine-config';

const coverDossier = resolveCoverDossier(currentIssue);
const issuePad = formatIssuePad(currentIssue.number);

// Hub adı eşlemesi — makale URL'sinden bölüm adını çıkar
const hubLabels: Record<string, string> = {
  '/hormonal-gecis': 'Hormonal Geçiş',
  '/zamansiz-yasam': 'Zamansız Yaşam',
  '/beden-yakinlik': 'Beden & Yakınlık',
  '/zihin-denge': 'Zihin & Denge',
  '/bilimsel-pencere': 'Bilimsel Pencere',
};

function getHubLabel(href?: string): string {
  if (!href) return magazineConfig.name;
  const hub = '/' + href.split('/')[1];
  return hubLabels[hub] ?? magazineConfig.name;
}

function getHubThumbnail(href?: string): string {
  if (!href) return submenuHeroByRoute['/hormonal-gecis'].src;
  const hub = '/' + href.split('/')[1];
  const hero = submenuHeroByRoute[hub as keyof typeof submenuHeroByRoute];
  return hero?.src ?? submenuHeroByRoute['/hormonal-gecis'].src;
}

// Mevcut sayının kapak dosyasından öne çıkan 3 yazı (idx 0-2)
const editorialPicks = (coverDossier?.articles ?? []).slice(0, 3).map((article, idx) => {
  const writer = writers.find((w) => w.slug === article.writerSlug);
  return {
    tag: getHubLabel(article.href),
    title: article.title,
    body: article.excerpt,
    href: article.href ?? `/sayi/${currentIssue.slug}`,
    highlight: idx === 1,
    author: writer?.displayName ?? 'Estranova',
    isPlanned: article.status === 'planned',
  };
});

// Aynı sayının kalan yazıları (idx 3+) — son yayınlar listesi
const editorialRecent = (coverDossier?.articles ?? []).slice(3).map((article) => {
  const writer = writers.find((w) => w.slug === article.writerSlug);
  return {
    dateLine: `${currentIssue.monthYear.toLocaleUpperCase('tr-TR')} · ${getHubLabel(article.href).toLocaleUpperCase('tr-TR')}`,
    title: article.title,
    excerpt: article.excerpt,
    href: article.href ?? `/sayi/${currentIssue.slug}`,
    thumbnailSrc: getHubThumbnail(article.href),
    thumbnailAlt: article.title,
    author: writer?.displayName ?? 'Estranova',
    isPlanned: article.status === 'planned',
  };
});

const journey = [
  {
    step: '01',
    title: 'Perimenopoz',
    excerpt: 'Adet düzenin değişmeye başladığında vücudunun neyi sessizce anlattığını birlikte okumak için sakin bir başlangıç rehberi.',
    href: '/hormonal-gecis/perimenopoz',
    imageKey: '/hormonal-gecis/perimenopoz' as const,
  },
  {
    step: '02',
    title: 'Menopoza Hazırlık',
    excerpt: 'Geçişe adım adım ısınırken günlük düzenini, takibini ve koruyucu alışkanlıklarını bu dönemden geçen birçoğumuz gibi sabırla kurabilirsin.',
    href: '/hormonal-gecis/menopoza-hazirlik',
    imageKey: '/hormonal-gecis/menopoza-hazirlik' as const,
  },
  {
    step: '03',
    title: 'Menopoz',
    excerpt: 'Sık karşılaştığımız belirtileri tanıman ve günlük yaşamını biraz daha yumuşatman için yanında duran sade, yaşıt tonlu bir rehber.',
    href: '/hormonal-gecis/menopoz',
    imageKey: '/hormonal-gecis/menopoz' as const,
  },
  {
    step: '04',
    title: '40 Sonrası Sağlık',
    excerpt: 'Kemik, kas, uyku ve tarama başlıklarını tek dosyada oku. Amaç görev listesi değil, hayatın ritmini koruyan sakin bir sağlık çerçevesi.',
    href: '/hormonal-gecis/40-sonrasi',
    imageKey: '/hormonal-gecis/40-sonrasi' as const,
  },
];

// Yazar kategorileri — iki ayrı carousel için filtreler
const lifestyleWriters = activeWriters.filter((w) => w.category !== 'scientific');
const scientificWriters = activeWriters.filter((w) => w.category === 'scientific');

const preventionCards = [
  {
    title: 'Kemik ve kas gücü',
    body: '40 sonrası sağlık yalnızca belirti yönetimi değildir. Hareket, beslenme ve düzenli takip birlikte düşünülür.',
    href: '/zamansiz-yasam/kemik-sagligi-40-sonrasi',
  },
  {
    title: 'Tarama ve kayıt düzeni',
    body: 'Kontrol tarihlerini ve aile öyküsünü sade bir dosyada topla. Soruları önceden yazmak iyi bir başlangıçtır.',
    href: '/hormonal-gecis/40-sonrasi/tarama-testleri',
  },
  {
    title: 'Uyku ve toparlanma',
    body: 'Gece düzeni değiştiğinde bunu irade meselesi gibi okumayalım. Bazen bedenin yeni ritmini anlamak gerekir.',
    href: '/zihin-denge/uyku-dinlenme',
  },
];

const homeFaqs = [
  {
    question: 'Estranova bir klinik ya da randevu platformu mu?',
    answer: 'Hayır. Estranova, 40+ kadın sağlığı için hazırlanmış editoryal bir bilgi platformudur; randevu, tedavi veya hizmet yönlendirmesi yapmaz.',
  },
  {
    question: 'Yazılar tıbbi olarak gözden geçiriliyor mu?',
    answer: 'Sağlık içerikleri editoryal kontrolden geçer. Uygun olduğunda tıbbi inceleme katmanı da eklenir. Yazılar kişisel tanı veya tedavi önerisi yerine geçmez.',
  },
  {
    question: 'Nereden başlamalıyım?',
    answer: 'Yaşam evreni belliyse yolculuk haritasından başla. Belirti daha baskınsa belirti navigasyonunu kullan.',
  },
  {
    question: 'İçerikler yalnızca menopoz hakkında mı?',
    answer: 'Hayır. Perimenopoz, menopoza hazırlık, menopoz, 40 sonrası koruyucu sağlık, zihin dengesi, beden ve yakınlık gibi başlıklar birlikte ele alınır.',
  },
];
---

<SiteLayout
  title="Estranova - Kadın Sağlığı Editoryal Rehberi"
  description="Perimenopoz, menopoza hazırlık ve menopoz dönemlerinde güvenilir editoryal içerikler."
>
  <SiteNavbar currentPath="/" />

  <main id="main-content" class="text-ink">
    <HomeHero hero={homePageHero} />

    <section class="border-t border-burgundy/10 bg-white px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <header class="mb-10 max-w-3xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
            <span class="font-serif font-normal tabular-nums text-gold">01</span>
            <span class="mx-2 text-gold">—</span>
            Yolculuk Haritası
          </p>
          <h2 class="mb-4 font-serif text-4xl leading-tight text-ink md:text-5xl">Hormonal Geçiş Yolculuk Haritası</h2>
          <p class="text-lg leading-relaxed text-ink/75">
            Her dönem farklı sorular getirir. İçerikleri, yaşam evresine göre adım adım takip edebilirsiniz.
          </p>
        </header>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
          {
            journey.map((j) => {
              const img = submenuHeroByRoute[j.imageKey];
              return (
                <article class="group overflow-hidden rounded-[28px] border border-burgundy/12 bg-cream-soft shadow-sm transition hover:shadow-lg">
                  <a href={j.href} class="block h-full outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2">
                    <div class="relative h-36 overflow-hidden">
                      <img
                        src={img.src}
                        alt=""
                        width="600"
                        height="225"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.04]"
                      />
                      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1c1412]/65 via-[#1c1412]/15 to-transparent" />
                      <span class="absolute bottom-3 left-4 font-serif text-3xl font-medium tabular-nums text-white/95 md:text-4xl">
                        {j.step}
                      </span>
                    </div>
                    <div class="border-t border-burgundy/10 p-7">
                      <h3 class="mb-3 font-serif text-2xl">{j.title}</h3>
                      <p class="mb-4 leading-relaxed text-ink/75">{j.excerpt}</p>
                      <span class="font-semibold text-burgundy group-hover:underline">Yazıyı aç</span>
                    </div>
                  </a>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <div class="mx-auto flex max-w-sm items-center justify-center gap-4 py-8 md:py-10">
      <span class="h-px flex-1 bg-gold/35"></span>
      <span class="font-serif text-xl text-gold" aria-hidden="true">❦</span>
      <span class="h-px flex-1 bg-gold/35"></span>
    </div>

    <SymptomNavigation sectionNumber="02" />

    <IssueHero issue={currentIssue} sectionNumber="03" />

    <section class="border-t border-burgundy/10 bg-white px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <header class="mb-10 max-w-3xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
            <span class="font-serif font-normal tabular-nums text-gold">04</span>
            <span class="mx-2 text-gold">—</span>
            EDİTÖRYAL SEÇKİ
          </p>
          <h2 class="mb-4 font-serif text-4xl leading-tight md:text-5xl">Bu sayıdan öne çıkanlar</h2>
          <p class="text-lg leading-relaxed text-ink/75">
            {magazineConfig.name} · Sayı {issuePad} kapak dosyasından üç öne çıkan yazı, ardından sayının kalan parçaları.
          </p>
        </header>

        <div class="grid grid-cols-1 items-stretch gap-6 md:grid-cols-3 md:gap-7">
          {
            editorialPicks.map((z) => (
              <a
                href={z.href}
                class:list={[
                  'group flex h-full flex-col rounded-[28px] border bg-cream-soft p-7 shadow-sm transition focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2',
                  z.highlight
                    ? 'border-burgundy/35 ring-2 ring-burgundy/20 md:-translate-y-1 md:shadow-xl'
                    : 'border-burgundy/12 hover:-translate-y-0.5 hover:shadow-md',
                ]}
              >
                <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-burgundy">{z.tag}</p>
                <h3 class="mb-3 font-serif text-2xl group-hover:underline group-hover:decoration-burgundy/35">{z.title}</h3>
                <p class="mb-5 flex-1 leading-relaxed text-ink/75">{z.body}</p>
                <p class="mt-2 font-serif text-xs italic text-ink/55">
                  Yazan: <span class="text-ink/75">{z.author}</span>
                </p>
              </a>
            ))
          }
        </div>

        <div class="mt-14 md:mt-16">
          <h3 class="mb-6 font-serif text-2xl text-ink">Son yayınlar</h3>
          <div>
            {
              editorialRecent.map((item) => (
                <a
                  href={item.href}
                  class="group flex items-start gap-4 border-t border-burgundy/15 py-6 focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2 md:gap-6"
                >
                  <img
                    src={item.thumbnailSrc}
                    alt={item.thumbnailAlt}
                    width="64"
                    height="64"
                    loading="lazy"
                    decoding="async"
                    class="h-12 w-12 shrink-0 rounded-lg object-cover ring-1 ring-burgundy/10 md:h-16 md:w-16"
                  />
                  <div class="min-w-0 flex-1">
                    <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-burgundy">{item.dateLine}</p>
                    <h4 class="mb-2 font-serif text-2xl text-ink transition group-hover:underline group-hover:decoration-gold group-hover:decoration-1 group-hover:underline-offset-[6px]">
                      {item.title}
                    </h4>
                    <p class="text-base leading-relaxed text-ink/70">{item.excerpt}</p>
                    <p class="mt-3 font-serif text-xs italic text-ink/55">
                      Yazan: <span class="text-ink/75">{item.author}</span>
                    </p>
                  </div>
                </a>
              ))
            }
          </div>
          <div class="mt-6 flex justify-end">
            <a
              href={`/sayi/${currentIssue.slug}`}
              class="text-sm font-semibold text-burgundy underline decoration-burgundy/50 underline-offset-4 transition hover:decoration-burgundy focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
            >
              Sayının tamamı →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!--
      Yazar Kadrosu — yaşam yazarları (lifestyle category).
      Konum: Editöryal Seçki sonrası (2026-05-03'te taşındı; eski konumu en altta idi).
      Bilim yazarları için ayrı carousel sayfa sonunda yer alır.
    -->
    <section class="border-t border-burgundy/10 bg-white px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <header class="mb-12 max-w-3xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
            <span class="font-serif font-normal tabular-nums text-gold">05</span>
            <span class="mx-2 text-gold">—</span>
            Yazar Kadrosu
          </p>
          <h2 class="mb-4 font-serif text-4xl leading-tight md:text-5xl">Bu sayıda yazanlar</h2>
          <p class="text-lg leading-relaxed text-ink/75">
            Estranova editöryal ekibi: farklı yaş, uzmanlık ve hayat ritimlerinden yazıyor olan yaşıt sesler. Her yazar kendi
            bakış açısıyla katkı sunuyor.
          </p>
          <p class="mt-4 text-lg leading-relaxed text-ink/75">
            Estranova bir “kişisel vitrin” ya da “influencer alanı” değil. Burada yazmak; deneyimi parlatmak değil, anlamlandırmak demek.
            <a
              href="/yayin-kurulu#neden-yaziyorlar"
              class="ml-1 font-semibold text-burgundy underline decoration-burgundy/40 underline-offset-4 transition hover:decoration-burgundy"
              >Neden burada yazıyorlar? →</a
            >
          </p>
        </header>

        <div class="relative" data-writers-carousel>
          <button
            type="button"
            data-writers-prev
            aria-label="Önceki yazarlar"
            class="absolute left-0 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 -translate-x-3 items-center justify-center rounded-full border border-burgundy/25 bg-white/95 text-burgundy shadow-sm backdrop-blur transition hover:border-burgundy/55 hover:bg-white hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:border-burgundy/25 disabled:hover:bg-white/95 disabled:hover:shadow-sm md:flex"
          >
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m12 15-5-5 5-5" />
            </svg>
          </button>

          <button
            type="button"
            data-writers-next
            aria-label="Sonraki yazarlar"
            class="absolute right-0 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 translate-x-3 items-center justify-center rounded-full border border-burgundy/25 bg-white/95 text-burgundy shadow-sm backdrop-blur transition hover:border-burgundy/55 hover:bg-white hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:border-burgundy/25 disabled:hover:bg-white/95 disabled:hover:shadow-sm md:flex"
          >
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m8 5 5 5-5 5" />
            </svg>
          </button>

          <ul
            data-writers-track
            role="list"
            aria-label="Yazar kadrosu — yatay kaydırarak gezinebilirsiniz"
            class="writers-track flex snap-x snap-mandatory gap-5 overflow-x-auto pb-2 md:gap-6"
          >
            {
              lifestyleWriters.map((w) => (
                <li class="flex shrink-0 snap-start" style="width: clamp(240px, 78vw, 280px);">
                  <a
                    href={`/yazarlar/${w.slug}`}
                    class="group flex w-full items-start gap-4 border-r border-burgundy/12 pr-5 last:border-r-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
                  >
                    {w.portrait ? (
                      <img
                        src={w.portrait}
                        alt={`${w.displayName} portresi`}
                        width="160"
                        height="160"
                        loading="lazy"
                        decoding="async"
                        class="h-20 w-20 shrink-0 rounded-full object-cover ring-2 ring-burgundy/15 transition group-hover:ring-burgundy/45"
                      />
                    ) : (
                      <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-cream-warm font-serif text-2xl text-burgundy ring-2 ring-burgundy/15 transition group-hover:ring-burgundy/45">
                        {w.displayName
                          .split(/\s+/)
                          .filter((part) => part.length > 0)
                          .map((n) => n[0])
                          .join('')}
                      </div>
                    )}
                    <div class="min-w-0 flex-1">
                      <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-burgundy">
                        {w.role.split('/')[0].trim()}
                      </p>
                      <h3 class="mt-1.5 font-serif text-lg leading-tight text-ink group-hover:underline group-hover:decoration-burgundy/35">
                        {w.displayName}
                      </h3>
                      <p class="writer-phrase mt-2 font-serif text-sm italic leading-snug text-ink/70">
                        {w.signaturePhrase}
                      </p>
                    </div>
                  </a>
                </li>
              ))
            }
          </ul>

          <div
            data-writers-dots
            aria-hidden="true"
            class="mt-6 flex items-center justify-center gap-2"
          ></div>
        </div>

        <div class="mt-10 flex justify-center">
          <a
            href="/yayin-kurulu"
            class="text-sm font-semibold text-burgundy underline decoration-burgundy/40 underline-offset-4 transition hover:decoration-burgundy"
          >
            Tüm yayın kurulu →
          </a>
        </div>
      </div>
    </section>

    <section class="border-t border-b border-burgundy/12 bg-white px-6 py-10 md:py-12">
      <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 text-center">
        <p class="font-sans text-sm text-ink/75">
          İçeriklerimiz editöryal ve tıbbi incelemeden geçer.{' '}
          <a
            href="/editoryal-politika/nasil-arastiriyoruz"
            class="text-ink underline decoration-gold/60 underline-offset-4 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
            >Kanıt seviyeleri nasıl belirlenir? →</a>
        </p>
        <nav
          aria-label="Güven ve politikalar"
          class="flex flex-col items-center gap-2 font-sans sm:flex-row sm:flex-wrap sm:justify-center sm:gap-x-3 sm:gap-y-1"
        >
          <a
            href="/editoryal-politika"
            class="text-xs uppercase tracking-[0.24em] text-ink/65 transition hover:text-burgundy focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
            >Editöryal Politika</a>
          <span class="hidden text-gold sm:inline" aria-hidden="true">·</span>
          <a
            href="/tibbi-sorumluluk"
            class="text-xs uppercase tracking-[0.24em] text-ink/65 transition hover:text-burgundy focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
            >Tıbbi Sorumluluk Reddi</a>
          <span class="hidden text-gold sm:inline" aria-hidden="true">·</span>
          <a
            href="/editoryal-politika/nasil-arastiriyoruz"
            class="text-xs uppercase tracking-[0.24em] text-ink/65 transition hover:text-burgundy focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
            >Nasıl Araştırıyoruz</a>
        </nav>
      </div>
    </section>

    <section class="border-t border-burgundy/10 bg-cream-soft px-6 py-16 md:py-20">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <header class="lg:sticky lg:top-28">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
            <span class="font-serif font-normal tabular-nums text-gold">06</span>
            <span class="mx-2 text-gold">—</span>
            Koruyucu Sağlık
          </p>
          <h2 class="mb-5 font-serif text-4xl leading-tight text-burgundy-deep md:text-5xl">
            Sadece bugünü değil, önümüzdeki on yılı da okumak
          </h2>
          <p class="text-lg leading-relaxed text-ink/75">
            Estranova’da koruyucu sağlık bir “yapılacaklar listesi” değildir. Kemik, kas, uyku, tarama ve günlük ritim birlikte ele alınır.
          </p>
        </header>

        <div class="grid gap-4">
          {
            preventionCards.map((card, idx) => (
              <a
                href={card.href}
                class="group grid gap-5 border-t border-burgundy/15 bg-white/45 px-0 py-7 transition hover:bg-white/70 focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2 md:grid-cols-[80px_1fr_auto] md:items-start md:px-6"
              >
                <span class="font-serif text-4xl leading-none tabular-nums text-gold">{String(idx + 1).padStart(2, '0')}</span>
                <span>
                  <span class="block font-serif text-2xl leading-tight text-ink group-hover:underline group-hover:decoration-gold/70">{card.title}</span>
                  <span class="mt-2 block text-base leading-relaxed text-ink/72">{card.body}</span>
                </span>
                <span class="hidden pt-1 text-gold transition group-hover:translate-x-1 md:block" aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="border-t border-burgundy/10 bg-white px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <header class="mb-10 max-w-3xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
            <span class="font-serif font-normal tabular-nums text-gold">07</span>
            <span class="mx-2 text-gold">—</span>
