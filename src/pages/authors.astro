---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { activeWriters, editors, guestWriters, scientificWriters } from '../data/writers';

const writerGroups = [
  {
    eyebrow: 'Editoryal masa',
    title: 'Yayın çizgisini kuran ses',
    description:
      'Estranova’da konu seçimi, ton dengesi ve okuma rotası önce editoryal masada netleşir.',
    writers: editors,
  },
  {
    eyebrow: 'Yazar kadrosu',
    title: 'Yaşıt deneyimini araştırmayla buluşturan imzalar',
    description:
      'Her yazar kendi hayat ritminden, mesleki bakışından ve 40+ kadın deneyimine yakın yerden konuşur.',
    writers: guestWriters,
  },
  {
    eyebrow: 'Bilimsel yazarlar',
    title: 'Uzmanlık bilgisini editoryal açıklığa taşıyan imzalar',
    description:
      'Klinik otorite dili kurmadan, sağlık okuryazarlığını güçlendiren bilimsel bir hat sağlarlar.',
    writers: scientificWriters,
  },
].filter((group) => group.writers.length > 0);
---

<SiteLayout
  title="Yazarlar - Estranova"
  description="Estranova yazar ekibi ve tıbbi denetim rolleri."
>
  <SiteNavbar />

  <main id="main-content" class="bg-cream-soft pt-24 text-ink">
    <section class="relative overflow-hidden border-b border-burgundy/10 px-6 py-16 md:py-24">
      <div class="pointer-events-none absolute -left-20 top-20 h-64 w-64 rounded-full bg-burgundy/8 blur-3xl"></div>
      <div class="pointer-events-none absolute bottom-4 right-[6%] hidden font-serif text-[11rem] italic leading-none text-burgundy/[0.035] md:block" aria-hidden="true">
        imza
      </div>
      <div class="relative mx-auto max-w-6xl">
        <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-end">
          <header>
            <p class="mb-5 flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.32em] text-burgundy">
              <span class="h-px w-10 bg-gold"></span>
              Yazarlar
            </p>
            <h1 class="max-w-4xl font-serif text-6xl leading-[0.9] tracking-[-0.055em] text-burgundy md:text-8xl">
              Estranova imza masası
            </h1>
          </header>
          <div class="rounded-[34px] border border-burgundy/12 bg-white/75 p-7 shadow-[0_28px_90px_-62px_rgba(44,22,28,0.35)] ring-1 ring-white/80">
            <p class="font-serif text-2xl italic leading-snug text-ink/78 md:text-3xl">
              İçerikler tek bir sesin etrafında değil; editoryal sezgi, yaşıt deneyimi ve bilimsel denetim birbirini tamamlayacak şekilde hazırlanır.
            </p>
            <div class="mt-6 grid grid-cols-3 gap-3 border-t border-gold/25 pt-5 text-center">
              <div>
                <p class="font-serif text-3xl text-burgundy">{activeWriters.length}</p>
                <p class="mt-1 text-[10px] font-semibold uppercase tracking-[0.22em] text-ink/55">Aktif imza</p>
              </div>
              <div>
                <p class="font-serif text-3xl text-burgundy">{guestWriters.length}</p>
                <p class="mt-1 text-[10px] font-semibold uppercase tracking-[0.22em] text-ink/55">Yazar</p>
              </div>
              <div>
                <p class="font-serif text-3xl text-burgundy">{scientificWriters.length}</p>
                <p class="mt-1 text-[10px] font-semibold uppercase tracking-[0.22em] text-ink/55">Bilimsel yazar</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="px-6 py-14 md:py-20">
      <div class="mx-auto max-w-6xl space-y-16">
        {writerGroups.map((group) => (
          <section>
            <header class="mb-7 max-w-3xl">
              <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.28em] text-burgundy/80">
                {group.eyebrow}
              </p>
              <h2 class="font-serif text-4xl leading-tight tracking-[-0.025em] text-ink md:text-5xl">
                {group.title}
              </h2>
              <p class="mt-3 text-base leading-relaxed text-ink/68 md:text-lg">{group.description}</p>
            </header>

            <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
              {group.writers.map((writer) => (
                <a
                  href={`/yazarlar/${writer.slug}`}
                  class="group relative flex min-h-[26rem] flex-col overflow-hidden rounded-[36px] border border-burgundy/12 bg-white shadow-[0_26px_86px_-62px_rgba(44,22,28,0.38)] ring-1 ring-white/80 transition hover:-translate-y-1 hover:border-gold/45 hover:shadow-[0_34px_96px_-58px_rgba(44,22,28,0.48)] focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
                >
                  <div class="relative h-52 overflow-hidden bg-gradient-to-br from-cream-warm via-cream-soft to-white">
                    {writer.portrait ? (
                      <img
                        src={writer.portrait}
                        alt={`${writer.displayName} portresi`}
                        width="520"
                        height="520"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover object-center transition duration-700 group-hover:scale-[1.04]"
                      />
                    ) : (
                      <div class="flex h-full w-full items-center justify-center font-serif text-7xl text-burgundy/45">
                        {writer.displayName
                          .split(/\s+/)
                          .filter((part) => part.length > 0)
                          .map((namePart) => namePart[0])
                          .join('')}
                      </div>
                    )}
                    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#261318]/58 via-[#261318]/12 to-transparent"></div>
                    <p class="absolute bottom-4 left-5 right-5 text-[10px] font-bold uppercase tracking-[0.26em] text-cream-soft">
                      {writer.role}
                    </p>
                  </div>

                  <div class="flex flex-1 flex-col p-6">
                    <h3 class="font-serif text-3xl leading-none tracking-[-0.025em] text-burgundy md:text-4xl">
                      {writer.displayName}
                    </h3>
                    <p class="mt-4 line-clamp-4 text-sm leading-relaxed text-ink/72">
                      {writer.signaturePhrase}
                    </p>
                    <div class="mt-5 flex flex-wrap gap-2">
                      {writer.focusAreas.slice(0, 3).map((area) => (
                        <span class="rounded-full border border-burgundy/12 bg-cream-soft px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-ink/62">
                          {area}
                        </span>
                      ))}
                    </div>
                    <span class="mt-auto pt-6 text-xs font-semibold text-burgundy underline decoration-burgundy/35 underline-offset-4 transition group-hover:decoration-burgundy">
                      Profil ve yazı arşivi
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
