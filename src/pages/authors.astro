---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
---

<SiteLayout
  title="Yazarlar - Estranova"
  description="Estranova yazar ekibi ve tibbi denetim rolleri."
>
  <SiteNavbar />

  <main id="main-content" class="pt-24">
    <section class="px-6 py-16 md:py-20">
      <div class="max-w-5xl mx-auto">
        <header class="max-w-3xl mb-14">
          <p class="text-secondary text-xs font-bold tracking-[0.28em] uppercase mb-4">Yazarlar</p>
          <h1 class="text-5xl md:text-7xl font-serif leading-[1.05] text-charcoal mb-6">Icerik uretimi ve denetim rolleri</h1>
          <p class="text-lg md:text-xl text-charcoal/65 leading-relaxed">
            Estranova icerikleri tek bir isim etrafinda degil, yazi, denetim ve tibbi cerceve rolleri ayrilarak olusturulur.
          </p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
          <article class="rounded-[32px] border border-primary/10 bg-white p-8 editorial-shadow">
            <p class="text-[11px] uppercase tracking-[0.22em] text-secondary font-bold mb-3">Yazar</p>
            <h2 class="text-3xl font-serif mb-4">Alara Baykent</h2>
            <p class="text-charcoal/70 leading-relaxed">
              Genel saglik bilgisini okunabilir bir yapiya tasimaya odaklanan editoryal metinler ve kaynak ozetleri uzerinde calisir.
            </p>
          </article>

          <article class="rounded-[32px] border border-primary/10 bg-white p-8 editorial-shadow">
            <p class="text-[11px] uppercase tracking-[0.22em] text-secondary font-bold mb-3">Yazar</p>
            <h2 class="text-3xl font-serif mb-4">Basak Pelister</h2>
            <p class="text-charcoal/70 leading-relaxed">
              Konu akisi, icerik duzeni ve okuma rotasi kurgusuna odaklanir; metinleri editoryal butunluk icinde duzenler.
            </p>
          </article>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <article class="rounded-[32px] border border-primary/10 bg-surface-container p-8">
            <p class="text-[11px] uppercase tracking-[0.22em] text-secondary font-bold mb-3">Yazi Denetimi</p>
            <h2 class="text-3xl font-serif mb-4">Doc. Dr. Senai Aksoy</h2>
            <p class="text-charcoal/70 leading-relaxed">
              Danisman doktor ve yazi denetleyici olarak iceriklerin tibbi baglam, ifade dengesi ve hekimlik etiğine uygunlugunu gozden gecirir.
            </p>
          </article>

          <article class="rounded-[32px] border border-primary/10 bg-surface-container p-8">
            <p class="text-[11px] uppercase tracking-[0.22em] text-secondary font-bold mb-3">Site Yonetimi</p>
            <h2 class="text-3xl font-serif mb-4">Berna Aksoy</h2>
            <p class="text-charcoal/70 leading-relaxed">
              Yayin planlamasi, sayfa organizasyonu ve editoryal is akisinin operasyonel koordinasyonundan sorumludur.
            </p>
          </article>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
