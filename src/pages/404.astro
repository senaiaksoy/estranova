---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

const hubs = [
  {
    href: '/hormonal-gecis',
    label: 'Hormonal Geçiş',
    description: 'Perimenopoz, menopoza hazırlık, menopoz, 40 sonrası sağlık.',
  },
  {
    href: '/beden-yakinlik',
    label: 'Beden & Yakınlık',
    description: 'Cilt, cinsel sağlık, mahrem bölge değişimleri, pelvik taban.',
  },
  {
    href: '/zihin-denge',
    label: 'Zihin & Denge',
    description: 'Uyku, bilişsel sağlık, duygusal denge, stres.',
  },
  {
    href: '/zamansiz-yasam',
    label: 'Zamansız Yaşam',
    description: 'Beslenme, hareket, vitaminler, kemik sağlığı.',
  },
  {
    href: '/bilimsel-pencere',
    label: 'Bilimsel Pencere',
    description: 'Hormon biyolojisi, hücreler ve yaşlanma, yeni araştırmalar.',
  },
];
---

<SiteLayout
  title="Sayfa bulunamadı — Estranova"
  description="Aradığınız sayfa burada değil. Estranova'nın bilgi mimarisinden devam edebilirsiniz."
>
  <SiteNavbar />

  <main id="main-content" class="pt-24">
    <section class="px-6 py-20 md:py-28">
      <div class="mx-auto max-w-4xl">
        <header class="mb-14 max-w-2xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.28em] text-burgundy">404</p>
          <h1 class="mb-6 font-serif text-5xl leading-[1.05] text-charcoal md:text-6xl">
            Aradığınız sayfa burada değil.
          </h1>
          <p class="text-lg leading-relaxed text-charcoal/70 md:text-xl">
            Bağlantı eski ya da eksik olabilir. Aşağıdaki bilgi yollarından devam edebilir, isterseniz
            <a href="/" class="font-semibold text-burgundy underline-offset-4 hover:underline">ana sayfaya</a>
            dönebilirsiniz.
          </p>
        </header>

        <div class="grid gap-4 md:grid-cols-2">
          {hubs.map((hub) => (
            <a
              href={hub.href}
              class="group block rounded-[28px] border border-burgundy/12 bg-white p-6 transition hover:border-burgundy/30 hover:shadow-md"
            >
              <h2 class="mb-2 font-serif text-2xl text-burgundy-deep">{hub.label}</h2>
              <p class="mb-3 text-sm leading-relaxed text-charcoal/68">{hub.description}</p>
              <span class="inline-flex items-center gap-2 text-sm font-semibold text-burgundy group-hover:underline">
                İncele
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </span>
            </a>
          ))}
        </div>

        <p class="mt-12 text-sm leading-relaxed text-charcoal/60">
          Bir bağlantı kırık görünüyorsa
          <a href="/iletisim" class="font-semibold text-burgundy underline-offset-4 hover:underline">iletişim sayfasından</a>
          haber verebilirsiniz.
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
