---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { featureFlags, isFeatureActive } from '../utils/feature-flags';
import { magazineConfig } from '../data/magazine-config';

const subscriptionActive = isFeatureActive('subscriptionEnabled');
const membershipActive = isFeatureActive('membershipEnabled');

const pageTitle = subscriptionActive
  ? `${magazineConfig.name} okuru ol — Estranova`
  : `${magazineConfig.name} okurluğu yakında — Estranova`;
const pageDescription = subscriptionActive
  ? `${magazineConfig.name} dergisinin aylık okurluğu için yayın seçenekleri.`
  : `${magazineConfig.name} dergisinin aylık okurluğu yakında duyurulur. Bekleme listesine kaydolarak ilk haberi alabilirsiniz.`;
---

<SiteLayout title={pageTitle} description={pageDescription} allowIndexing={false}>
  <SiteNavbar currentPath="/abone-ol" />

  <main id="main-content" class="text-ink">
    <section class="border-t border-burgundy/10 bg-gradient-to-b from-cream-warm to-cream-soft px-6 py-14 md:py-20">
      <div class="mx-auto max-w-4xl">
        <nav aria-label="Sayfa konumu" class="mb-6 text-xs uppercase tracking-[0.22em] text-ink/55">
          <a href="/" class="text-ink/65 hover:text-burgundy">Anasayfa</a>
          <span class="mx-2 text-gold">·</span>
          <span class="text-burgundy">{magazineConfig.name} Okuru Ol</span>
        </nav>

        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
          {magazineConfig.name} · {magazineConfig.subtitle}
        </p>
        <h1 class="mb-5 font-serif text-5xl leading-[1.05] text-burgundy md:text-6xl">
          {subscriptionActive ? `${magazineConfig.name} okuru ol` : 'Yayını izleyin, ilk haber sizde olsun'}
        </h1>
        <p class="max-w-3xl text-lg leading-relaxed text-ink/80 md:text-xl">
          {subscriptionActive
            ? `${magazineConfig.name} dergisinin aylık sayısı, sayı arşivi ve özel bölümlerine erişim için yayın okurluğu seçeneklerini inceleyebilirsiniz.`
            : `${magazineConfig.name} dergisinin aylık okurluğu, ilk sayılar yola çıktıktan sonra duyurulur. O güne kadar Estranova Mektubu kaydıyla yola çıkabilirsiniz; ilk okurluk açıldığında ilk haberi siz alırsınız.`}
        </p>
      </div>
    </section>

    {!subscriptionActive && (
      <section class="bg-white px-6 py-12 md:py-16">
        <div class="mx-auto max-w-3xl">
          <div class="rounded-[28px] border border-gold/35 bg-cream-soft/60 p-8 md:p-10">
            <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.28em] text-gold">
              Bekleme Listesi
            </p>
            <h2 class="mb-3 font-serif text-2xl leading-snug text-ink md:text-3xl">
              Okurluğu açtığımızda ilk siz duyun
            </h2>
            <p class="mb-6 text-base leading-relaxed text-ink/75">
              Estranova Mektubu'na kayıt ol; aylık okurluk açıldığında ilk mektupta haber gönderiyoruz.
              Herhangi bir ödeme ya da yayın taahhüdü yok; adınız bekleme listesine yazılır — istediğiniz an ayrılırsınız.
            </p>
            <div class="flex flex-wrap gap-3">
              <a
                href="/mektup"
                class="inline-flex items-center gap-1.5 rounded-xl bg-burgundy px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:opacity-95 focus:outline-none focus:ring-2 focus:ring-burgundy/35"
              >
                Mektuba kaydol
              </a>
              <a
                href={`/sayi/${magazineConfig.firstIssue.monthYearISO === '2026-05' ? '01-mayis-2026-geceler' : ''}`}
                class="inline-flex items-center gap-1.5 rounded-xl border-2 border-burgundy px-6 py-3 text-sm font-semibold text-burgundy transition hover:bg-burgundy/5 focus:outline-none focus:ring-2 focus:ring-burgundy/35"
              >
                Bu ayın sayısına git
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    {subscriptionActive && (
      <section class="bg-white px-6 py-12 md:py-16">
        <div class="mx-auto max-w-3xl">
          <p class="text-base leading-relaxed text-ink/65">
            <em class="font-serif italic">Aylık okurluk seçenekleri yayın masası tarafından duyurulduğunda bu alanda sade bir bilgilendirme kartı yer alır. Temel sağlık rehberleri herkese açık kalır.</em>
          </p>
        </div>
      </section>
    )}

    <section class="border-t border-burgundy/10 bg-cream-soft px-6 py-12 md:py-14">
      <div class="mx-auto max-w-3xl">
        <h2 class="mb-4 font-serif text-2xl leading-snug text-ink md:text-3xl">
          Şu an açık olan değer
        </h2>
        <p class="mb-3 text-base leading-relaxed text-ink/75">
          Aylık okurluk açılana kadar Estranova'nın tüm hub içerikleri, kapak dosyaları ve sayı sayfaları
          herkese açık kalmaya devam ediyor. {magazineConfig.name} dergi serisinin etiği şu:
          kanıt-temelli temel sağlık bilgisi her zaman herkese açıktır; aylık okurluk yalnızca sayının
          kendine özgü editöryal parçalarını kapsar.
        </p>
        <p class="text-base leading-relaxed text-ink/75">
          Detaylı kural için <a href="/editoryal-politika" class="font-semibold text-burgundy underline decoration-burgundy/40 underline-offset-4 hover:decoration-burgundy">Editöryal Politika</a>'mıza göz atabilirsiniz.
        </p>
      </div>
    </section>

    <section class="border-t border-burgundy/10 bg-cream-soft px-6 py-10">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm leading-relaxed text-ink/65">
          KVKK ve veri politikamız için <a href="/kvkk" class="font-semibold text-burgundy underline decoration-burgundy/40 underline-offset-4 hover:decoration-burgundy">KVKK Aydınlatma Metni</a>'ne göz atabilirsiniz.
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
