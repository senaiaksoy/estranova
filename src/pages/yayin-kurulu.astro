---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

const editorialBoard = [
  {
    group: 'Editörler',
    description: 'Yayın çizgisini, dil tutarlılığını ve içerik önceliklerini belirleyen ekip.',
    members: [
      {
        name: 'Doç. Dr. Senai Aksoy',
        title: 'Bilimsel Editör',
        detail: 'Kadın sağlığı ve hormonal geçiş başlıklarında editoryal tıbbi denetim sağlar.',
      },
      {
        name: 'Berna Aksoy',
        title: 'Yönetici Editör',
        detail: 'Yayın planlaması, içerik akışı ve kalite süreçlerini koordine eder.',
      },
    ],
  },
  {
    group: 'Yazarlar',
    description: 'Bilimsel kaynakları sade Türkçe ile yapılandıran içerik yazarları.',
    members: [
      {
        name: 'Alara Baykent',
        title: 'Sağlık Yazarı',
        detail: 'Perimenopoz, menopoz ve 40+ yaşam rehberleri üzerine içerik üretir.',
      },
      {
        name: 'Başak Pelister',
        title: 'Araştırma Yazarı',
        detail: 'Güncel literatür taraması ve kaynak temelli içerik derlemesi yapar.',
      },
      {
        name: 'Demet Kızılkaya',
        title: 'Editoryal İçerik Yazarı',
        detail: 'Kategori sayfaları, açıklayıcı dosyalar ve okuyucu odaklı metinler hazırlar.',
      },
    ],
  },
  {
    group: 'Tıbbi Danışmanlar',
    description: 'Yayımlanmadan önce tıbbi doğruluk, kanıt düzeyi ve terminoloji denetimi yapan danışman kadro.',
    members: [
      {
        name: 'Dr. Metin Alış',
        title: 'Kurul Üyesi',
        detail:
          'Endokrinoloji, Diyabet ve Metabolizma Hastalıkları Uzmanıdır. GATA Tıp Fakültesi mezunudur (1995). İç hastalıkları uzmanlık eğitimini GATA Ankara İç Hastalıkları Bölümü’nde (1998-2002), endokrinoloji uzmanlık eğitimini ise GATA Haydarpaşa Eğitim Araştırma Hastanesi Endokrinoloji Servisi’nde (2009-2012) tamamlamıştır. 2014 yılında Mayo School of Continuous Professional Development 17th Annual Mayo Clinic Endocrine Update Postgraduate Course programına katılmıştır. 2017’den bu yana Amerikan Hastanesi Endokrinoloji Bölümü’nde görev yapmaktadır. Tiroid hastalıkları, diyabet, obezite, osteoporoz, hipofiz ve adrenal-gonad hastalıkları alanlarında klinik deneyime sahiptir; ayrıca Türkiye Endokrinoloji ve Metabolizma Derneği’nde İleri Tiroid Ultrasonografi Kursu almıştır.',
      },
      {
        name: 'Dr. Alp Aslan Eryılmaz',
        title: 'Kurul Üyesi',
        detail:
          'Kardiyoloji Uzmanı, Girişimsel Kardiyoloji alanında çalışmaktadır. Akdeniz Üniversitesi Tıp Fakültesi mezunudur. Kardiyoloji uzmanlığını İstanbul Üniversitesi İstanbul Tıp Fakültesi (Çapa) Kardiyoloji Bölümü’nde tamamlamıştır (2001). 2001-2003 yıllarında İstanbul ve Gebze’de kardiyoloji uzmanı olarak çalışmış; 2003-2005 döneminde Amerikan Hastanesi’nde girişimsel ve klinik kardiyolog olarak görev yapmıştır. 2005-2006 yıllarında İstanbul GATA Hastanesi’nde uzun dönem asteğmen tabip olarak hizmet vermiş, 2006’dan bu yana Amerikan Hastanesi’nde çalışmaya devam etmektedir. Klinik çalışma alanları ateroskleroz ilişkili damar hastalıkları, hipertansiyon, hiperkolesterolemi, insülin direnci/şeker hastalığına bağlı kardiyovasküler risk yönetimi, koroner girişimler (balon-stent, primer PTCA) ve renal denervasyon uygulamalarıdır. Türkiye’de ilk kez uygulanan TAVİ (2009) ve MitraClip (2010) işlemlerinde ekip içinde yer almıştır.',
      },
      {
        name: 'Çağrı Sade',
        title: 'Plastik Cerrah',
        detail:
          '1972 yılında Görele’de doğdu. 1994 yılında Ankara Üniversitesi Tıp Fakültesi’nden mezun oldu. Şişli Etfal Eğitim ve Araştırma Hastanesi’nden 2001 yılında Plastik ve Rekonstrüktif Cerrahi uzmanlığını aldı. Uzmanlık sonrasında pek çok önemli isimle çalışarak deneyim kazandı. 2002 yılında Dr. Sherrell J. Aston’ın observership programına katıldı. 2002 yılından itibaren Amerikan Hastanesi’nde görev yapmaktadır. Aynı zamanda Nişantaşı Abdi İpekçi Caddesi’ndeki muayenehanesinde hastalarını görmektedir.',
      },
      {
        name: 'Dr. Gonca Gökdemir',
        title: 'Dermatolog',
        detail:
          'İstanbul Üniversitesi İstanbul Tıp Fakültesi mezunu ve dermatoloji uzmanıdır. Medikal ve kozmetik dermatoloji alanında yaklaşık 20 yıllık deneyime ve ulusal-uluslararası dergilerde çok sayıda yayına sahiptir.',
      },
      {
        name: 'Duygu Karaosmanoğlu',
        title: 'Diş Hekimi',
        detail:
          'Ege Üniversitesi Diş Hekimliği Fakültesi mezunudur. 2001 yılında Creadenta’nın kurucu ortakları arasında yer almış; estetik diş hekimliği ve özellikle porselen lamina uygulamaları üzerine uzun yıllardır çalışmaktadır.',
      },
    ],
  },
  {
    group: 'Danışmanlar',
    description: 'İçerik erişilebilirliği, okuyucu deneyimi ve yayın standardı tarafında destek veren danışman ekip.',
    members: [
      {
        name: '[Danışman Adı]',
        title: 'Bilim İletişimi Danışmanı',
        detail: 'Karmaşık tıbbi bilgilerin anlaşılır ve güvenilir biçimde sunulmasını destekler.',
      },
      {
        name: '[Danışman Adı]',
        title: 'Sağlık İletişimi Danışmanı',
        detail: 'Okuyucu dili, içerik tonu ve etik iletişim standartları konusunda rehberlik sağlar.',
      },
      {
        name: '[Danışman Adı]',
        title: 'Editoryal Süreç Danışmanı',
        detail: 'Kaynak doğrulama, güncelleme planı ve yayın süreçlerinin sürekliliğine katkı verir.',
      },
    ],
  },
];
---

<SiteLayout
  title="Yayın Kurulu - Estranova"
  description="Estranova yayın kurulunda editörler, yazarlar, tıbbi danışmanlar ve danışman ekip yer alır."
>
  <SiteNavbar currentPath="/yayin-kurulu" />

  <main id="main-content" class="pt-24">
    <section class="px-6 py-16 md:py-20">
      <div class="max-w-6xl mx-auto">
        <header class="max-w-3xl mb-14">
          <p class="text-[#6B2D3E] text-xs font-bold tracking-[0.28em] uppercase mb-4">Yayın Kurulu</p>
          <h1 class="text-5xl md:text-7xl font-serif leading-[1.05] text-[#2D2D2D] mb-6">Editoryal ekip ve danışman kadro</h1>
          <p class="text-lg md:text-xl text-[#2D2D2D]/65 leading-relaxed">
            Estranova içerikleri, editoryal ekip, yazarlar ve tıbbi danışmanların ortak çalışmasıyla hazırlanır.
            Bu yapı; içeriklerin bilimsel doğruluk, dil sadeliği ve editoryal tarafsızlık ilkelerine göre yayımlanmasını destekler.
          </p>
        </header>

        <section class="rounded-[32px] border border-[#6B2D3E]/10 bg-[#FDF8F0] p-8 mb-10">
          <h2 class="text-3xl font-serif mb-4 text-[#2D2D2D]">Yayın modeli</h2>
          <p class="text-[#2D2D2D]/70 leading-relaxed">
            Estranova, bağımsız bir editoryal sağlık bilgi platformudur. Bu sayfadaki ekip yapısı, klinik tanıtımı için değil,
            içerik üretim ve doğrulama süreçlerinin şeffaf biçimde paylaşılması amacıyla sunulmaktadır.
          </p>
        </section>

        <div class="space-y-10">
          {editorialBoard.map((section) => (
            <section class="rounded-[32px] border border-[#6B2D3E]/12 bg-white p-8 shadow-sm">
              <div class="max-w-3xl mb-7">
                <h2 class="text-3xl font-serif mb-3 text-[#2D2D2D]">{section.group}</h2>
                <p class="text-[#2D2D2D]/70 leading-relaxed">{section.description}</p>
              </div>

              <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
                {section.members.map((member) => (
                  <article class="rounded-2xl border border-[#6B2D3E]/12 bg-[#FDF8F0] p-5">
                    <p class="text-xs font-bold tracking-[0.2em] uppercase text-[#6B2D3E]/70 mb-2">Estranova</p>
                    <h3 class="font-serif text-2xl text-[#2D2D2D] mb-2">{member.name}</h3>
                    <p class="text-sm font-semibold text-[#6B2D3E] mb-3">{member.title}</p>
                    <p class="text-[#2D2D2D]/70 leading-relaxed text-sm">{member.detail}</p>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>

        <section class="rounded-[32px] border border-[#6B2D3E]/12 bg-white p-8 shadow-sm mt-10">
          <h2 class="text-3xl font-serif mb-4 text-[#2D2D2D]">İletişim ve düzeltme talepleri</h2>
          <p class="text-[#2D2D2D]/70 leading-relaxed">
            Yayın kurulu, içerik doğruluğu ve güncelliğiyle ilgili geri bildirimleri değerlendirir.
            Düzeltme veya görüş iletmek için
            <a href="mailto:editoral@estranova.com" class="text-[#6B2D3E] font-semibold hover:underline"> editoral@estranova.com</a>
            adresine yazabilirsiniz.
          </p>
        </section>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
