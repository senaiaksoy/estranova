        <!-- 5. Danışmanlar -->
        <section class="relative mb-10 overflow-hidden rounded-[34px] border border-burgundy/12 bg-white/90 p-8 shadow-[0_20px_60px_rgba(79,23,28,0.07)] ring-1 ring-gold/15 md:p-10">
