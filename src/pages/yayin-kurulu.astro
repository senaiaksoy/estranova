---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import KuruluCard from '../components/site/KuruluCard.astro';
import { editors, guestWriters, guestWriterEnAlt } from '../data/writers';

// ─── Bilimsel editör ────────────────────────────────────────────────────────
const medicalReviewer = {
  anchor: 'senai-aksoy',
  name: 'Doç. Dr. Senai Aksoy',
  role: 'Bilimsel Editör',
  bio: 'Kadın sağlığı ve hormonal geçiş başlıklarında uzun yıllardır çalışan bir hekim. Estranova\'da makalelerin bilimsel doğruluk, kanıt düzeyi ve terminoloji tutarlılığı kendisinin denetiminden geçer. Karmaşık tabloları sadeleştirmeyi seven, soruyu küçümsemeyen bir akademisyen.',
  portrait: '/images/writers/senai-aksoy.webp',
  tags: ['Tıbbi Denetim', 'Hormonal Geçiş', 'Kanıt Değerlendirmesi'],
};

// ─── Tıbbi danışmanlar ───────────────────────────────────────────────────────
// Biyografiler: 2-3 cümle (kurumsal sıkıştırma + alan etiketleri)
const medicalAdvisors = [
  {
    name: 'Dr. Metin Alış',
    role: 'Tıbbi Danışman · Endokrinoloji',
    bio: 'Endokrinoloji, diyabet ve metabolizma alanında uzun yıllardır çalışan bir hekim. Estranova\'da hormonal geçiş, tiroid ve kemik sağlığı başlıklarındaki metinlerin bilimsel doğruluğunu denetliyor. Karmaşık tabloları sade dille açıklamayı seven, soruyu küçümsemeyen biri.',
    tags: ['Endokrinoloji', 'Diyabet', 'Osteoporoz', 'Tiroid'],
  },
  {
    name: 'Dr. Alp Aslan Eryılmaz',
    role: 'Tıbbi Danışman · Kardiyoloji',
    bio: 'Girişimsel kardiyoloji alanında çalışan deneyimli bir hekim. Estranova\'da kardiyovasküler risk, kalp sağlığı ve 40 sonrası önleyici takip başlıklarında danışmanlık veriyor. Riski abartmadan ama küçümsemeden anlatmaya inanan, sakin sesli bir akademisyen.',
    tags: ['Kardiyoloji', 'Girişimsel Kardiyoloji', 'Kardiyovasküler Risk'],
  },
  {
    name: 'Dr. Çağrı Sade',
    role: 'Tıbbi Danışman · Plastik Cerrahi',
    bio: 'Plastik ve rekonstrüktif cerrahi alanında yıllardır çalışan bir hekim. Estranova\'da estetik girişimler, gerçekçi beklenti yönetimi ve 40 sonrası bakım başlıklarında danışmanlık veriyor. Modaya değil yüze ve kişiye bakan; küçük dokunuşun değerini bilen bir uzman.',
    tags: ['Plastik Cerrahi', 'Rekonstrüktif Cerrahi', 'Estetik Cerrahi'],
  },
  {
    name: 'Prof. Dr. Gonca Gökdemir',
    role: 'Tıbbi Danışman · Dermatoloji',
    bio: '25 yılı aşkın süredir medikal ve kozmetik dermatoloji alanında çalışan bir akademisyen. Estranova\'da cilt sağlığı, hormonal geçişin cilde etkileri ve estetik dermatoloji başlıklarında danışmanlık veriyor. Trendin değil cildin tarafında duran, anlaşılır anlatımıyla okuru rahatlatan bir uzman.',
    tags: ['Dermatoloji', 'Estetik Dermatoloji', 'Kozmetik'],
  },
  {
    name: 'Dt. Duygu Karaosmanoğlu',
    role: 'Tıbbi Danışman · Diş Hekimliği',
    bio: 'Estetik diş hekimliği ve porselen laminalar alanında uzun yıllardır çalışan bir diş hekimi; Creadenta\'nın kurucusu. Estranova\'da ağız ve diş sağlığının hormonal geçişle ilişkisi başlıklarında danışmanlık veriyor. Doğal görünümü zorlamayı sevmeyen, "yüze yakışanı" arayan bir uzman.',
    tags: ['Estetik Diş Hekimliği', 'Porselen Laminalar', 'Dijital Diş Hekimliği'],
  },
  {
    name: 'Dt. Elif Özcan Dulundu',
    role: 'Tıbbi Danışman · Diş Hekimliği',
    bio: 'Otuz yılı aşkın süredir porselen laminalar ve estetik diş hekimliği alanında çalışan bir diş hekimi; Creadenta\'nın kurucu ortağı. Estranova\'da gülüş tasarımı ve diş sağlığı başlıklarında danışmanlık veriyor. Sade ama kalıcı olanı seven, abartıdan uzak duran bir uzman.',
    tags: ['Estetik Diş Hekimliği', 'Porselen Laminalar', 'Dijital Diş Hekimliği'],
  },
  {
    name: 'Fzt. Ersin Saraç',
    role: 'Tıbbi Danışman · Fizyoterapi',
    bio: 'Kas-iskelet rehabilitasyonu ve kadın sağlığı fizyoterapisi alanında çalışan bir fizyoterapist. Estranova\'da hareket, kronik ağrı ve doğum sonrası rehabilitasyon başlıklarında danışmanlık veriyor. Bedeni dinleyerek ilerlemeyi öğreten, küçük adımların gücüne inanan bir akran.',
    tags: ['Fizyoterapi', 'Kadın Sağlığı Fizyoterapisi', 'Rehabilitasyon', 'Doğum Sonrası'],
  },
  {
    name: 'Prof. Dr. Bülent Aksoy',
    role: 'Tıbbi Danışman · Ortopedi',
    bio: 'Ortopedi ve travmatoloji alanında deneyimli bir akademisyen ve cerrah. Estranova\'da kemik sağlığı, eklem ağrıları ve 40 sonrası ortopedik takip başlıklarında danışmanlık veriyor. Hastayı ameliyat masasından önce hayata yönlendirmeyi tercih eden, sakin bir hekim.',
    tags: ['Ortopedi', 'Travmatoloji', 'Artroplasti', 'Spor Hekimliği'],
  },
];

// ─── Danışmanlar ─────────────────────────────────────────────────────────────
const consultants = [
  {
    name: 'Rima Erdemir',
    role: 'Editöryal Süreç Danışmanı',
    bio: 'Medya ve dijital yayıncılıkta yıllarca yöneticilik yapan bir editör. Estranova\'da makalelerin kaynak doğrulama, güncelleme ve yayın akışına editöryal süreç desteği veriyor. Bir metnin nereden okunduğunu ve nasıl güvenilir kaldığını dert edinen biri.',
    tags: ['Editöryal Süreç', 'Kaynak Doğrulama', 'Dijital Yayıncılık'],
  },
  {
    name: 'Anıl Yalmaz',
    role: 'Hareket ve Egzersiz Danışmanı',
    bio: 'Spor Bilimleri mezunu bir hareket uzmanı; Pilates ve medikal fitness eğitimleri aldı. Estranova\'da hareket, güçlenme ve sürdürülebilir egzersiz rutinleri başlıklarında danışmanlık veriyor. "Önce küçük başla, sonra sıklığı koru" diyen, yargılamadan eşlik eden bir akran.',
    tags: ['Hareket & Egzersiz', 'Pilates', 'Medikal Fitness'],
  },
];
---

<SiteLayout
  title="Yayın Kurulu - Estranova"
  description="Estranova yayın kurulunda editörler, yazarlar, tıbbi danışmanlar ve danışman ekip yer alır."
>
  <SiteNavbar currentPath="/yayin-kurulu" />

  <main id="main-content" class="pt-24">
    <section class="px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">

        <header class="mb-14 max-w-3xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.28em] text-burgundy">Yayın Kurulu</p>
          <h1 class="mb-6 font-serif text-5xl leading-[1.05] text-ink md:text-7xl">Editoryal ekip ve danışman kadro</h1>
          <p class="text-lg leading-relaxed text-ink/65 md:text-xl">
            Estranova içerikleri, editoryal ekip, yazarlar ve tıbbi danışmanların ortak çalışmasıyla hazırlanır. Bu yapı;
            içeriklerin bilimsel doğruluk, dil sadeliği ve editoryal tarafsızlık ilkelerine göre yayımlanmasını destekler.
          </p>
        </header>

        <a
          id="neden-yaziyorlar"
          href="/manifesto"
          class="group mb-10 block rounded-[32px] border-2 border-burgundy/25 bg-gradient-to-br from-white to-cream-soft p-8 ring-1 ring-gold/25 transition hover:border-burgundy/45 hover:shadow-md"
        >
          <p class="mb-2 text-[10px] font-bold uppercase tracking-[0.28em] text-burgundy">Önce burayı okumanız tavsiye edilir</p>
          <h2 class="mb-3 font-serif text-3xl italic leading-snug text-burgundy-deep md:text-4xl">Bu Masada Neden Varız</h2>
          <p class="mb-2 leading-relaxed text-ink/75">
            Estranova'da yazan kadınlar; ün, etki veya marka için değil, deneyim aktarmak için yazıyor. Burada bulunmalarının
            nedeni yeni bir unvan eklemek değil; 40 yaş sonrasının bedensel ve zihinsel geçişlerini daha saygın, daha
            gerçekçi ve daha iyi bilgiyle konuşulabilir kılmak. Estranova bir vitrin değil; kadınların birbirine iyi
            düşünülmüş, sakin ve güvenilir notlar bıraktığı ortak bir masa.
          </p>
          <span class="mt-3 inline-flex items-center gap-2 font-semibold text-burgundy group-hover:underline">
            Manifestonun tamamını oku
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
          </span>
        </a>

        <section class="mb-10 rounded-[32px] border border-burgundy/10 bg-cream-soft p-8">
          <h2 class="mb-4 font-serif text-2xl text-ink">Yayın modeli</h2>
          <p class="leading-relaxed text-ink/70">
            Estranova, bağımsız bir editoryal sağlık bilgi platformudur. Bu sayfadaki ekip yapısı, klinik tanıtımı için değil,
            içerik üretim ve doğrulama süreçlerinin şeffaf biçimde paylaşılması amacıyla sunulmaktadır.
          </p>
          <p class="mt-4 leading-relaxed text-ink/70">
            Editörler, yazarlar, tıbbi danışmanlar ve süreç destekçileri dahil bu sayfadaki tüm katkılar
            <strong class="text-burgundy">gönüllülük esasıyla</strong> sağlanır; platform herhangi bir ticari ilişki veya
            hekim/klinik tanıtımı değildir.
          </p>
        </section>

        <!-- 1. Editörler -->
        <section class="mb-10 rounded-[32px] border border-burgundy/12 bg-white p-8 shadow-sm">
          <div class="mb-7 max-w-3xl">
            <h2 class="mb-3 font-serif text-3xl text-ink">Editörler</h2>
            <p class="leading-relaxed text-ink/70">
              Yayın çizgisini, bilimsel denetimi ve içerik önceliklerini birlikte şekillendiren ekip.
            </p>
          </div>
          <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            <KuruluCard
              anchor={medicalReviewer.anchor}
              name={medicalReviewer.name}
              role={medicalReviewer.role}
              bio={medicalReviewer.bio}
              portrait={medicalReviewer.portrait}
              tags={medicalReviewer.tags}
            />
            {editors.map((w) => (
              <KuruluCard
                anchor={`editor-${w.slug}`}
                name={w.displayName}
                role={w.role}
                bio={w.publicBio}
                portrait={w.portrait}
                tags={w.focusAreas}
              />
            ))}
          </div>
        </section>

        <!-- 2. Yazar kadrosu -->
        <section class="mb-10 rounded-[32px] border border-burgundy/12 bg-white p-8 shadow-sm">
          <div class="mb-7 max-w-3xl">
            <h2 class="mb-3 font-serif text-3xl text-ink">Yazar Kadromuz</h2>
            <p class="leading-relaxed text-ink/70">
              Bilimsel kaynakları sade Türkçe ile yapılandıran konuk yazarlar; odak alanlarına göre alfabetik sıralanmıştır.
            </p>
          </div>
          <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {guestWriters.map((w) => (
              <KuruluCard
                anchor={w.slug}
                name={w.displayName}
                role={w.role}
                bio={w.publicBio}
                portrait={w.portrait}
                tags={w.focusAreas}
              />
            ))}
            <KuruluCard
              anchor={guestWriterEnAlt.slug}
              name={guestWriterEnAlt.displayName}
              role={guestWriterEnAlt.role}
              bio={guestWriterEnAlt.publicBio}
              portrait={guestWriterEnAlt.portrait}
              tags={guestWriterEnAlt.focusAreas}
            >
              <p class="mt-4 rounded-xl border-l-2 border-gold bg-white/60 px-4 py-3 text-sm italic leading-relaxed text-ink/72">
                Yukarıdaki <a href="#senai-aksoy" class="font-semibold text-burgundy no-underline hover:underline">Bilimsel Editör Doç. Dr. Senai Aksoy</a> ile
                aynı kişi. Mahrem ya da hassas başlıklarda kimse yazmaya gönüllü olmadığında, hekim kimliğini bir
                kenara koyarak — komşu sıcaklığıyla, jargonsuz — masaya kendisi oturuyor. Bu kart o "geçici yazar"
                rolünün izi.
              </p>
            </KuruluCard>
          </div>
        </section>

        <!-- 3. Editöryal süreç -->
        <section class="mb-10 rounded-[32px] border border-burgundy/10 bg-cream-soft p-8">
          <h2 class="mb-3 font-serif text-2xl text-ink">Editöryal süreç</h2>
          <p class="leading-relaxed text-ink/70">
            Metinler taslak, dil düzeni ve kaynak kontrolü aşamalarından geçer; klinik ve hormonal geçiş başlıklarında bilimsel
            editör ve gerektiğinde tıbbi danışman görüşü alınır. Okuyucuya yönelik ton, panik yaratmadan bilgilendirme ilkesiyle
            tutulur.
          </p>
        </section>

        <!-- 4. Tıbbi danışmanlar -->
        <section class="mb-10 rounded-[32px] border border-burgundy/12 bg-white p-8 shadow-sm">
          <div class="mb-7 max-w-3xl">
            <h2 class="mb-3 font-serif text-3xl text-ink">Tıbbi Danışmanlar</h2>
            <p class="leading-relaxed text-ink/70">
              Yayımlanmadan önce tıbbi doğruluk, kanıt düzeyi ve terminoloji denetimi yapan danışman kadro.
            </p>
          </div>
          <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {medicalAdvisors.map((m) => (
              <KuruluCard
                name={m.name}
                role={m.role}
                bio={m.bio}
                tags={m.tags}
              />
            ))}
          </div>
        </section>

        <!-- 5. Danışmanlar -->
        <section class="mb-10 rounded-[32px] border border-burgundy/12 bg-white p-8 shadow-sm">
          <div class="mb-7 max-w-3xl">
            <h2 class="mb-3 font-serif text-3xl text-ink">Danışmanlar</h2>
            <p class="leading-relaxed text-ink/70">
              İçerik erişilebilirliği, okuyucu deneyimi, yayın standardı ve yaşam tarzı perspektifi tarafında destek veren danışman ekip.
            </p>
          </div>
          <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {consultants.map((m) => (
              <KuruluCard
                name={m.name}
                role={m.role}
                bio={m.bio}
                tags={m.tags}
              />
            ))}
          </div>
        </section>

        <section class="rounded-[32px] border border-burgundy/12 bg-white p-8 shadow-sm">
          <h2 class="mb-4 font-serif text-3xl text-ink">İletişim ve düzeltme talepleri</h2>
          <p class="leading-relaxed text-ink/70">
            Yayın kurulu, içerik doğruluğu ve güncelliğiyle ilgili geri bildirimleri değerlendirir. Düzeltme veya görüş iletmek için
            <a href="mailto:editoral@estranova.com" class="font-semibold text-burgundy hover:underline">editoral@estranova.com</a>
            adresine yazabilirsiniz.
          </p>
        </section>

      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
