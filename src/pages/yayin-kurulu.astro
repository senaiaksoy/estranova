---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import KuruluCard from '../components/site/KuruluCard.astro';
import { editors, guestWriters, guestWriterEnAlt } from '../data/writers';

// ─── Bilimsel editör ────────────────────────────────────────────────────────
const medicalReviewer = {
  anchor: 'senai-aksoy',
  name: 'Doç. Dr. Senai Aksoy',
  role: 'Bilimsel Editör',
  bio: 'Kadın sağlığı ve hormonal geçiş başlıklarında editoryal tıbbi denetim sağlar. Makalelerin bilimsel doğruluk, kanıt düzeyi ve terminoloji tutarlılığı bu incelemeden geçer.',
  portrait: '/images/writers/senai-aksoy.webp',
  tags: ['Tıbbi Denetim', 'Hormonal Geçiş', 'Kanıt Değerlendirmesi'],
};

// ─── Tıbbi danışmanlar ───────────────────────────────────────────────────────
// Biyografiler: 2-3 cümle (kurumsal sıkıştırma + alan etiketleri)
const medicalAdvisors = [
  {
    name: 'Dr. Metin Alış',
    role: 'Tıbbi Danışman · Endokrinoloji',
    bio: 'Endokrinoloji, Diyabet ve Metabolizma Hastalıkları Uzmanı; GATA Tıp Fakültesi mezunu. Endokrinoloji uzmanlığını GATA Haydarpaşa Eğitim Araştırma Hastanesi\'nde tamamlamış, 2017\'den bu yana Amerikan Hastanesi Endokrinoloji Bölümü\'nde görev yapmaktadır.',
    tags: ['Endokrinoloji', 'Diyabet', 'Osteoporoz', 'Tiroid'],
  },
  {
    name: 'Dr. Alp Aslan Eryılmaz',
    role: 'Tıbbi Danışman · Kardiyoloji',
    bio: 'Kardiyoloji Uzmanı; Girişimsel Kardiyoloji alanında çalışmaktadır. İstanbul Üniversitesi İstanbul Tıp Fakültesi\'nde (Çapa) kardiyoloji uzmanlığını tamamlamış, 2006\'dan bu yana Amerikan Hastanesi\'nde görev yapmaktadır. Koroner girişimler, ateroskleroz ve kardiyovasküler risk yönetimi alanlarında uzmanlaşmıştır.',
    tags: ['Kardiyoloji', 'Girişimsel Kardiyoloji', 'Kardiyovasküler Risk'],
  },
  {
    name: 'Dr. Çağrı Sade',
    role: 'Tıbbi Danışman · Plastik Cerrahi',
    bio: 'Plastik ve Rekonstrüktif Cerrahi Uzmanı; Ankara Üniversitesi Tıp Fakültesi mezunu. Şişli Etfal Eğitim ve Araştırma Hastanesi\'nde uzmanlığını tamamlamış, 2002\'den bu yana Amerikan Hastanesi\'nde görev yapmaktadır.',
    tags: ['Plastik Cerrahi', 'Rekonstrüktif Cerrahi', 'Estetik Cerrahi'],
  },
  {
    name: 'Prof. Dr. Gonca Gökdemir',
    role: 'Tıbbi Danışman · Dermatoloji',
    bio: 'Dermatoloji Profesörü; 25 yılı aşkın süredir medikal ve kozmetik dermatoloji alanında çalışmaktadır. Bahçeşehir Üniversitesi ve Liv Hospital başta olmak üzere pek çok sağlık kuruluşunda hizmet etmiş; estetik dermatoloji kurslarında eğitici, kozmetik markalarda danışman olarak görev yapmaktadır.',
    tags: ['Dermatoloji', 'Estetik Dermatoloji', 'Kozmetik'],
  },
  {
    name: 'Dt. Duygu Karaosmanoğlu',
    role: 'Tıbbi Danışman · Diş Hekimliği',
    bio: 'Ege Üniversitesi Diş Hekimliği Fakültesi mezunu; 1994\'ten bu yana estetik diş hekimliği ve porselen laminalar alanında uzman. 2001\'de Creadenta diş kliniğini kurmuş; Siena Üniversitesi\'nden protez, estetik ve dijital diş hekimliğinde master derecesine sahiptir.',
    tags: ['Estetik Diş Hekimliği', 'Porselen Laminalar', 'Dijital Diş Hekimliği'],
  },
  {
    name: 'Dt. Elif Özcan Dulundu',
    role: 'Tıbbi Danışman · Diş Hekimliği',
    bio: 'İstanbul Üniversitesi Diş Hekimliği Fakültesi mezunu; 30 yılı aşkın süredir porselen laminalar ve estetik diş hekimliği alanında uzman. 2001\'de Creadenta diş kliniğini kurmuş; Siena Üniversitesi\'nden protez, estetik ve dijital diş hekimliğinde master derecesine sahiptir.',
    tags: ['Estetik Diş Hekimliği', 'Porselen Laminalar', 'Dijital Diş Hekimliği'],
  },
  {
    name: 'Fzt. Ersin Saraç',
    role: 'Tıbbi Danışman · Fizyoterapi',
    bio: 'Fizyoterapist; Kas-İskelet Rehabilitasyonu ve Kadın Sağlığı alanında çalışmaktadır. Karabük Üniversitesi Fizyoterapi ve Rehabilitasyon Bölümü mezunu; doğum öncesi/sonrası rehabilitasyon, kronik ağrı ve spor sakatlanmaları konularında uzmanlaşmıştır.',
    tags: ['Fizyoterapi', 'Kadın Sağlığı Fizyoterapisi', 'Rehabilitasyon', 'Doğum Sonrası'],
  },
  {
    name: 'Prof. Dr. Bülent Aksoy',
    role: 'Tıbbi Danışman · Ortopedi',
    bio: 'Ortopedi ve Travmatoloji Uzmanı; İstanbul Üniversitesi Cerrahpaşa Tıp Fakültesi mezunu. Şişli Etfal, Vakıf Gureba ve Memorial Şişli başta olmak üzere pek çok kurumda görev yapmış; el tümörleri, kalça yaralanmaları ve artroplasti alanlarında uzmanlaşmıştır.',
    tags: ['Ortopedi', 'Travmatoloji', 'Artroplasti', 'Spor Hekimliği'],
  },
];

// ─── Danışmanlar ─────────────────────────────────────────────────────────────
const consultants = [
  {
    name: 'Rima Erdemir',
    role: 'Editöryal Süreç Danışmanı',
    bio: 'Medya ve dijital yayın yöneticiliği deneyimiyle kaynak doğrulama, güncelleme planı ve yayın süreçlerinin sürekliliğine katkı sağlar.',
    tags: ['Editöryal Süreç', 'Kaynak Doğrulama', 'Dijital Yayıncılık'],
  },
  {
    name: 'Anıl Yalmaz',
    role: 'Hareket ve Egzersiz Danışmanı',
    bio: 'İstanbul Üniversitesi Spor Bilimleri mezunu; Vücut Geliştirme, Pilates (2. Kademe) ve Medikal Fitness eğitimlerine sahip. Estranova\'da hareket, güçlenme ve sürdürülebilir egzersiz rutinleri başlıklarında danışmanlık sağlar.',
    tags: ['Hareket & Egzersiz', 'Pilates', 'Medikal Fitness'],
  },
];
---

<SiteLayout
  title="Yayın Kurulu - Estranova"
  description="Estranova yayın kurulunda editörler, yazarlar, tıbbi danışmanlar ve danışman ekip yer alır."
>
  <SiteNavbar currentPath="/yayin-kurulu" />

  <main id="main-content" class="pt-24">
    <section class="px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">

        <header class="mb-14 max-w-3xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.28em] text-[#6B2D3E]">Yayın Kurulu</p>
          <h1 class="mb-6 font-serif text-5xl leading-[1.05] text-[#2D2D2D] md:text-7xl">Editoryal ekip ve danışman kadro</h1>
          <p class="text-lg leading-relaxed text-[#2D2D2D]/65 md:text-xl">
            Estranova içerikleri, editoryal ekip, yazarlar ve tıbbi danışmanların ortak çalışmasıyla hazırlanır. Bu yapı;
            içeriklerin bilimsel doğruluk, dil sadeliği ve editoryal tarafsızlık ilkelerine göre yayımlanmasını destekler.
          </p>
        </header>

        <a
          id="neden-yaziyorlar"
          href="/manifesto"
          class="group mb-10 block rounded-[32px] border-2 border-[#6B2D3E]/25 bg-gradient-to-br from-white to-[#FDF8F0] p-8 ring-1 ring-[#C9A96E]/25 transition hover:border-[#6B2D3E]/45 hover:shadow-md"
        >
          <p class="mb-2 text-[10px] font-bold uppercase tracking-[0.28em] text-[#6B2D3E]">Önce burayı okumanız tavsiye edilir</p>
          <h2 class="mb-3 font-serif text-3xl italic leading-snug text-[#4f171c] md:text-4xl">Bu Masada Neden Varız</h2>
          <p class="mb-2 leading-relaxed text-[#2D2D2D]/75">
            Estranova'da yazan kadınlar; ün, etki veya marka için değil, deneyim aktarmak için yazıyor. Burada bulunmalarının
            nedeni yeni bir unvan eklemek değil; 40 yaş sonrasının bedensel ve zihinsel geçişlerini daha saygın, daha
            gerçekçi ve daha iyi bilgiyle konuşulabilir kılmak. Estranova bir vitrin değil; kadınların birbirine iyi
            düşünülmüş, sakin ve güvenilir notlar bıraktığı ortak bir masa.
          </p>
          <span class="mt-3 inline-flex items-center gap-2 font-semibold text-[#6B2D3E] group-hover:underline">
            Manifestonun tamamını oku
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
          </span>
        </a>

        <section class="mb-10 rounded-[32px] border border-[#6B2D3E]/10 bg-[#FDF8F0] p-8">
          <h2 class="mb-4 font-serif text-2xl text-[#2D2D2D]">Yayın modeli</h2>
          <p class="leading-relaxed text-[#2D2D2D]/70">
            Estranova, bağımsız bir editoryal sağlık bilgi platformudur. Bu sayfadaki ekip yapısı, klinik tanıtımı için değil,
            içerik üretim ve doğrulama süreçlerinin şeffaf biçimde paylaşılması amacıyla sunulmaktadır.
          </p>
          <p class="mt-4 leading-relaxed text-[#2D2D2D]/70">
            Editörler, yazarlar, tıbbi danışmanlar ve süreç destekçileri dahil bu sayfadaki tüm katkılar
            <strong class="text-[#6B2D3E]">gönüllülük esasıyla</strong> sağlanır; platform herhangi bir ticari ilişki veya
            hekim/klinik tanıtımı değildir.
          </p>
        </section>

        <!-- 1. Editörler -->
        <section class="mb-10 rounded-[32px] border border-[#6B2D3E]/12 bg-white p-8 shadow-sm">
          <div class="mb-7 max-w-3xl">
            <h2 class="mb-3 font-serif text-3xl text-[#2D2D2D]">Editörler</h2>
            <p class="leading-relaxed text-[#2D2D2D]/70">
              Yayın çizgisini, bilimsel denetimi ve içerik önceliklerini birlikte şekillendiren ekip.
            </p>
          </div>
          <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            <KuruluCard
              anchor={medicalReviewer.anchor}
              name={medicalReviewer.name}
              role={medicalReviewer.role}
              bio={medicalReviewer.bio}
              portrait={medicalReviewer.portrait}
              tags={medicalReviewer.tags}
            />
            {editors.map((w) => (
              <KuruluCard
                anchor={`editor-${w.slug}`}
                name={w.displayName}
                role={w.role}
                bio={w.publicBio}
                portrait={w.portrait}
                tags={w.focusAreas}
              />
            ))}
          </div>
        </section>

        <!-- 2. Yazar kadrosu -->
        <section class="mb-10 rounded-[32px] border border-[#6B2D3E]/12 bg-white p-8 shadow-sm">
          <div class="mb-7 max-w-3xl">
            <h2 class="mb-3 font-serif text-3xl text-[#2D2D2D]">Yazar Kadromuz</h2>
            <p class="leading-relaxed text-[#2D2D2D]/70">
              Bilimsel kaynakları sade Türkçe ile yapılandıran konuk yazarlar; odak alanlarına göre alfabetik sıralanmıştır.
            </p>
          </div>
          <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {guestWriters.map((w) => (
              <KuruluCard
                anchor={w.slug}
                name={w.displayName}
                role={w.role}
                bio={w.publicBio}
                portrait={w.portrait}
                tags={w.focusAreas}
              />
            ))}
            <KuruluCard
              anchor={guestWriterEnAlt.slug}
              name={guestWriterEnAlt.displayName}
              role={guestWriterEnAlt.role}
              bio={guestWriterEnAlt.publicBio}
              portrait={guestWriterEnAlt.portrait}
              tags={guestWriterEnAlt.focusAreas}
            >
              <p class="mt-4 rounded-xl border-l-2 border-[#C9A96E] bg-white/60 px-4 py-3 text-sm italic leading-relaxed text-[#2D2D2D]/72">
                Yukarıdaki <a href="#senai-aksoy" class="font-semibold text-[#6B2D3E] no-underline hover:underline">Bilimsel Editör Doç. Dr. Senai Aksoy</a> ile
                aynı kişi. Mahrem ya da hassas başlıklarda kimse yazmaya gönüllü olmadığında, hekim kimliğini bir
                kenara koyarak — komşu sıcaklığıyla, jargonsuz — masaya kendisi oturuyor. Bu kart o "geçici yazar"
                rolünün izi.
              </p>
            </KuruluCard>
          </div>
        </section>

        <!-- 3. Editöryal süreç -->
        <section class="mb-10 rounded-[32px] border border-[#6B2D3E]/10 bg-[#FDF8F0] p-8">
          <h2 class="mb-3 font-serif text-2xl text-[#2D2D2D]">Editöryal süreç</h2>
          <p class="leading-relaxed text-[#2D2D2D]/70">
            Metinler taslak, dil düzeni ve kaynak kontrolü aşamalarından geçer; klinik ve hormonal geçiş başlıklarında bilimsel
            editör ve gerektiğinde tıbbi danışman görüşü alınır. Okuyucuya yönelik ton, panik yaratmadan bilgilendirme ilkesiyle
            tutulur.
          </p>
        </section>

        <!-- 4. Tıbbi danışmanlar -->
        <section class="mb-10 rounded-[32px] border border-[#6B2D3E]/12 bg-white p-8 shadow-sm">
          <div class="mb-7 max-w-3xl">
            <h2 class="mb-3 font-serif text-3xl text-[#2D2D2D]">Tıbbi Danışmanlar</h2>
            <p class="leading-relaxed text-[#2D2D2D]/70">
              Yayımlanmadan önce tıbbi doğruluk, kanıt düzeyi ve terminoloji denetimi yapan danışman kadro.
            </p>
          </div>
          <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {medicalAdvisors.map((m) => (
              <KuruluCard
                name={m.name}
                role={m.role}
                bio={m.bio}
                tags={m.tags}
              />
            ))}
          </div>
        </section>

        <!-- 5. Danışmanlar -->
        <section class="mb-10 rounded-[32px] border border-[#6B2D3E]/12 bg-white p-8 shadow-sm">
          <div class="mb-7 max-w-3xl">
            <h2 class="mb-3 font-serif text-3xl text-[#2D2D2D]">Danışmanlar</h2>
            <p class="leading-relaxed text-[#2D2D2D]/70">
              İçerik erişilebilirliği, okuyucu deneyimi, yayın standardı ve yaşam tarzı perspektifi tarafında destek veren danışman ekip.
            </p>
          </div>
          <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {consultants.map((m) => (
              <KuruluCard
                name={m.name}
                role={m.role}
                bio={m.bio}
                tags={m.tags}
              />
            ))}
          </div>
        </section>

        <section class="rounded-[32px] border border-[#6B2D3E]/12 bg-white p-8 shadow-sm">
          <h2 class="mb-4 font-serif text-3xl text-[#2D2D2D]">İletişim ve düzeltme talepleri</h2>
          <p class="leading-relaxed text-[#2D2D2D]/70">
            Yayın kurulu, içerik doğruluğu ve güncelliğiyle ilgili geri bildirimleri değerlendirir. Düzeltme veya görüş iletmek için
            <a href="mailto:editoral@estranova.com" class="font-semibold text-[#6B2D3E] hover:underline">editoral@estranova.com</a>
            adresine yazabilirsiniz.
          </p>
        </section>

      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
