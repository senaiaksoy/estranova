---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import KuruluCard from '../components/site/KuruluCard.astro';
import { editors, guestWriters, scientificWriters } from '../data/writers';

// ─── Bilimsel editör ────────────────────────────────────────────────────────
const medicalReviewer = {
  anchor: 'senai-aksoy',
  name: 'Doç. Dr. Senai Aksoy',
  role: 'Bilimsel Editör',
  bio: 'Kadın sağlığı ve hormonal geçiş başlıklarında çalışan bir hekim. Estranova\'da makalelerin bilimsel doğruluk, kanıt düzeyi ve terminoloji tutarlılığı kendisinin denetiminden geçer. Karmaşık tabloları sadeleştirmeyi seven, soruyu küçümsemeyen sakin bir editör sesi var.',
  portrait: '/images/writers/senai-aksoy.webp',
  tags: ['Tıbbi Denetim', 'Hormonal Geçiş', 'Kanıt Değerlendirmesi'],
};

// ─── Tıbbi danışmanlar ───────────────────────────────────────────────────────
// Biyografiler: 2-3 cümle (kurumsal sıkıştırma + alan etiketleri)
const medicalAdvisors = [
  {
    name: 'Dr. Metin Alış',
    role: 'Tıbbi Danışman · Endokrinoloji',
    bio: 'Endokrinoloji, diyabet ve metabolizma alanında çalışan bir hekim. Estranova\'da hormonal geçiş, tiroid ve kemik sağlığı başlıklarındaki metinlerin bilimsel doğruluğunu denetliyor. Karmaşık tabloları sade dille açıklamayı seven, soruyu küçümsemeyen biri.',
    tags: ['Endokrinoloji', 'Diyabet', 'Osteoporoz', 'Tiroid'],
  },
  {
    name: 'Dr. Alp Aslan Eryılmaz',
    role: 'Tıbbi Danışman · Kardiyoloji',
    bio: 'Girişimsel kardiyoloji alanında çalışan deneyimli bir hekim. Estranova\'da kardiyovasküler risk, kalp sağlığı ve 40 sonrası önleyici takip başlıklarında danışmanlık veriyor. Riski abartmadan ama küçümsemeden anlatan sakin bir sesi var.',
    tags: ['Kardiyoloji', 'Girişimsel Kardiyoloji', 'Kardiyovasküler Risk'],
  },
  {
    name: 'Dr. Çağrı Sade',
    role: 'Tıbbi Danışman · Plastik Cerrahi',
    bio: 'Plastik ve rekonstrüktif cerrahi alanında çalışan bir hekim. Estranova\'da estetik girişimler, gerçekçi beklenti yönetimi ve 40 sonrası bakım başlıklarında danışmanlık veriyor. Modaya değil yüze ve kişiye bakan ölçülü bir yaklaşımı var.',
    tags: ['Plastik Cerrahi', 'Rekonstrüktif Cerrahi', 'Estetik Cerrahi'],
  },
  {
    name: 'Dt. Duygu Karaosmanoğlu',
    role: 'Tıbbi Danışman · Diş Hekimliği',
    bio: 'Estetik diş hekimliği alanında çalışan deneyimli bir diş hekimi. Estranova\'da ağız ve diş sağlığının hormonal geçişle ilişkisi başlıklarında danışmanlık veriyor. Doğal görünümü zorlamayan, yüze yakışanı arayan bir yaklaşımı var.',
    tags: ['Estetik Diş Hekimliği', 'Porselen Laminalar', 'Dijital Diş Hekimliği'],
  },
  {
    name: 'Fzt. Ersin Saraç',
    role: 'Tıbbi Danışman · Fizyoterapi',
    bio: 'Kas-iskelet rehabilitasyonu ve kadın sağlığı fizyoterapisi alanında çalışan bir fizyoterapist. Estranova\'da hareket, kronik ağrı ve doğum sonrası rehabilitasyon başlıklarında danışmanlık veriyor. Bedeni dinleyerek ilerlemeyi önemseyen, küçük adımları ciddiye alan bir uzman.',
    tags: ['Fizyoterapi', 'Kadın Sağlığı Fizyoterapisi', 'Rehabilitasyon', 'Doğum Sonrası'],
  },
  {
    name: 'Prof. Dr. Bülent Aksoy',
    role: 'Tıbbi Danışman · Ortopedi',
    bio: 'Ortopedi ve travmatoloji alanında çalışan deneyimli bir hekim. Estranova\'da kemik sağlığı, eklem ağrıları ve 40 sonrası ortopedik takip başlıklarında danışmanlık veriyor. Hastayı ameliyat masasından önce hayata yönlendirmeyi önemseyen sakin bir yaklaşımı var.',
    tags: ['Ortopedi', 'Travmatoloji', 'Artroplasti', 'Spor Hekimliği'],
  },
];

// ─── Danışmanlar ─────────────────────────────────────────────────────────────
const consultants = [
  {
    name: 'Rima Erdemir',
    role: 'Editöryal Süreç Danışmanı',
    bio: 'Medya ve dijital yayıncılıkta yıllarca yöneticilik yapan bir editör. Estranova\'da makalelerin kaynak doğrulama, güncelleme ve yayın akışına editöryal süreç desteği veriyor. Bir metnin nereden okunduğunu ve nasıl güvenilir kaldığını dert edinen biri.',
    tags: ['Editöryal Süreç', 'Kaynak Doğrulama', 'Dijital Yayıncılık'],
  },
  {
    name: 'Anıl Yalmaz',
    role: 'Hareket ve Egzersiz Danışmanı',
    bio: 'Spor Bilimleri mezunu bir hareket uzmanı; Pilates ve medikal fitness eğitimleri aldı. Estranova\'da hareket, güçlenme ve sürdürülebilir egzersiz rutinleri başlıklarında danışmanlık veriyor. "Önce küçük başla, sonra sıklığı koru" diyen, yargılamadan eşlik eden bir yaşıt.',
    tags: ['Hareket & Egzersiz', 'Pilates', 'Medikal Fitness'],
  },
];
---

<SiteLayout
  title="Yayın Kurulu - Estranova"
  description="Estranova yayın kurulunda editörler, yazarlar, tıbbi danışmanlar ve danışman ekip yer alır."
>
  <SiteNavbar currentPath="/yayin-kurulu" />

  <main id="main-content" class="pt-24 text-ink">
    <section class="relative overflow-hidden border-y border-burgundy/10 bg-gradient-to-br from-cream-warm via-cream-soft to-white px-6 py-16 md:py-24">
      <div class="pointer-events-none absolute -right-28 top-10 h-80 w-80 rounded-full bg-gold/15 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute left-5 top-32 hidden font-serif text-[9rem] lowercase leading-none text-burgundy/[0.035] md:block" aria-hidden="true">
        kurul
      </div>

      <div class="relative mx-auto max-w-6xl">

        <header class="mb-14 max-w-4xl">
          <div class="mb-6 h-px w-24 bg-gold"></div>
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.32em] text-burgundy">Yayın Kurulu</p>
          <h1 class="mb-7 font-serif text-5xl leading-[0.95] tracking-[-0.05em] text-burgundy md:text-8xl">Editoryal ekip ve danışman kadro</h1>
          <p class="max-w-3xl border-l border-gold/60 pl-6 font-serif text-xl italic leading-relaxed text-ink/72 md:text-2xl">
            Estranova içerikleri, editoryal ekip, yazarlar ve tıbbi danışmanların ortak çalışmasıyla hazırlanır. Bu yapı;
            içeriklerin bilimsel doğruluk, dil sadeliği ve editoryal tarafsızlık ilkelerine göre yayımlanmasını destekler.
          </p>
        </header>

        <a
          id="neden-yaziyorlar"
          href="/manifesto"
          class="group relative mb-10 block overflow-hidden rounded-[34px] border border-burgundy/15 bg-white/84 p-8 shadow-[0_24px_70px_rgba(79,23,28,0.08)] ring-1 ring-gold/20 transition hover:-translate-y-0.5 hover:border-burgundy/35 hover:shadow-[0_30px_80px_rgba(79,23,28,0.12)] md:p-10"
        >
          <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-gold via-burgundy/45 to-transparent"></div>
          <p class="mb-2 text-[10px] font-bold uppercase tracking-[0.28em] text-gold">Önce burayı okumanız tavsiye edilir</p>
          <h2 class="mb-4 font-serif text-3xl italic leading-snug text-burgundy md:text-4xl">Bu Masada Neden Varız</h2>
          <p class="mb-2 max-w-4xl leading-relaxed text-ink/75">
            Estranova'da yazan kadınlar; ün, etki veya marka için değil, deneyim aktarmak için yazıyor. Burada bulunmalarının
            nedeni yeni bir unvan eklemek değil; 40 yaş sonrasının bedensel ve zihinsel geçişlerini daha saygın, daha
            gerçekçi ve daha iyi bilgiyle konuşulabilir kılmak. Estranova bir vitrin değil; kadınların birbirine iyi
            düşünülmüş, sakin ve güvenilir notlar bıraktığı ortak bir masa.
          </p>
          <span class="mt-3 inline-flex items-center gap-2 font-semibold text-burgundy group-hover:underline">
            Manifestonun tamamını oku
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
          </span>
        </a>

        <section class="relative mb-10 overflow-hidden rounded-[34px] border border-burgundy/12 bg-white/88 p-8 shadow-[0_20px_60px_rgba(79,23,28,0.07)] ring-1 ring-gold/15 md:p-10">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-gold via-burgundy/20 to-transparent"></div>
          <h2 class="mb-4 font-serif text-3xl text-ink">Yayın modeli</h2>
          <p class="leading-relaxed text-ink/70">
            Estranova, bağımsız bir editoryal sağlık bilgi platformudur. Bu sayfadaki ekip yapısı, klinik tanıtımı için değil,
            içerik üretim ve doğrulama süreçlerinin şeffaf biçimde paylaşılması amacıyla sunulmaktadır.
          </p>
          <p class="mt-4 leading-relaxed text-ink/70">
            Editörler, yazarlar, tıbbi danışmanlar ve süreç destekçileri dahil bu sayfadaki tüm katkılar
            <strong class="text-burgundy">gönüllülük esasıyla</strong> sağlanır; platform herhangi bir ticari ilişki veya
            hekim/klinik tanıtımı değildir.
          </p>
          <p class="mt-4 leading-relaxed text-ink/70">
          Yayın felsefesi, üretim süreci, eser sahipliği ve yapay zekâ kullanım sınırlarına ilişkin ayrıntılı ilkeler için
            <a href="/editoryal-ilkeler" class="font-semibold text-burgundy hover:underline">Editöryal İlkelerimiz</a>
            sayfasına bakabilirsiniz.
          </p>

          <h3 class="mt-10 mb-3 font-serif text-xl text-ink">Bilimsel doğrulama</h3>
          <p class="leading-relaxed text-ink/70">
            Her makale, yayımlanmadan önce bilimsel editör
            <a href="#senai-aksoy" class="font-semibold text-burgundy hover:underline">Doç. Dr. Senai Aksoy</a>
            tarafından gözden geçirilir; konunun gerektirdiği uzmanlığa göre ilgili tıbbi danışmanın görüşü de alınır.
            Metindeki her iddia, yayın tarihinde erişilebilir en güncel bilimsel literatür, klinik rehber ve uzlaşı belgeleriyle
            karşılaştırılır. Uyumsuz, eskimiş veya kanıtı yetersiz ifadeler düzeltilir ya da metinden çıkarılır. Yayımlanan
            her makale, böylece yayın tarihindeki bilimsel verilerle uyumlu biçimde okuyucuya ulaşır.
          </p>

          <h3 class="mt-8 mb-3 font-serif text-xl text-ink">Güncellik taahhüdü</h3>
          <p class="leading-relaxed text-ink/70">
            Estranova'da yayımlanan her metin, yayın tarihinde geçerli bilimsel uzlaşıyı yansıtacak biçimde hazırlanır.
            Tıp bilgisi zamanla değişir; yeni kanıtlar önceki konsensüsü değiştirdiğinde metin güncellenir veya gerekirse
            geri çekilir. Her makalede yayın tarihi ve son güncelleme tarihi şeffaf biçimde belirtilir.
          </p>

          <h3 class="mt-8 mb-3 font-serif text-xl text-ink">Kanıt düzeyi sınıflaması</h3>
          <p class="mb-5 leading-relaxed text-ink/70">
            Metin içindeki iddialar, kanıtın gücüne göre beş düzeyli bir ölçekle etiketlenir. Etiket cümlenin tamamını değil,
            üzerinde durulan iddiayı sınıflandırır; aralık gerektiğinde <em>orta–iyi kanıt</em> biçiminde birleşir. Etiketler
            metin içinde italik parantezle gösterilir; örneğin <em>(güçlü kanıt)</em>. Sınıflama; kanıtın çalışma türü,
            örneklem büyüklüğü, bağımsız doğrulama sayısı ve klinik rehberlerde yerleşiklik düzeyi birlikte değerlendirilerek
            yapılır.
          </p>
          <dl class="grid gap-3 md:grid-cols-2">
            <div class="rounded-[24px] border border-gold/25 bg-cream-soft/45 p-5">
              <dt class="mb-2 font-serif italic text-burgundy">(güçlü kanıt)</dt>
              <dd class="text-sm leading-relaxed text-ink/70">Birden fazla bağımsız ve büyük ölçekli klinik çalışma, yerleşik klinik rehberler ve geniş uzlaşıyla desteklenen iddialar.</dd>
            </div>
            <div class="rounded-[24px] border border-gold/25 bg-cream-soft/45 p-5">
              <dt class="mb-2 font-serif italic text-gold-bronze">(iyi kanıt)</dt>
              <dd class="text-sm leading-relaxed text-ink/70">Kapsamlı çalışmalarla desteklenen, sonuçları büyük ölçüde tutarlı ve tartışmalı yan yönleri sınırlı iddialar.</dd>
            </div>
            <div class="rounded-[24px] border border-gold/25 bg-cream-soft/45 p-5">
              <dt class="mb-2 font-serif italic text-gold">(orta kanıt)</dt>
              <dd class="text-sm leading-relaxed text-ink/70">Mevcut çalışmaların çoğu aynı yönü işaret eder; bazı yöntemsel sınırlar veya henüz cevaplanmamış sorular bulunur.</dd>
            </div>
            <div class="rounded-[24px] border border-gold/25 bg-cream-soft/45 p-5">
              <dt class="mb-2 font-serif italic text-gold">(sınırlı kanıt)</dt>
              <dd class="text-sm leading-relaxed text-ink/70">Az sayıda veya küçük ölçekli çalışma vardır; bulgular henüz tutarlı bir desen oluşturmaz.</dd>
            </div>
            <div class="rounded-[24px] border border-gold/25 bg-cream-soft/45 p-5 md:col-span-2">
              <dt class="mb-2 font-serif italic text-gold">(zayıf kanıt)</dt>
              <dd class="text-sm leading-relaxed text-ink/70">Henüz yeterli klinik kanıt yoktur; ifade vaka serisi, küçük gözlem veya uzman görüşü düzeyindedir.</dd>
            </div>
          </dl>
        </section>

        <!-- 1. Editörler -->
        <section class="relative mb-10 overflow-hidden rounded-[34px] border border-burgundy/12 bg-white/90 p-8 shadow-[0_20px_60px_rgba(79,23,28,0.07)] ring-1 ring-gold/15 md:p-10">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-gold via-burgundy/20 to-transparent"></div>
          <div class="mb-7 max-w-3xl">
            <h2 class="mb-3 font-serif text-3xl text-ink">Editörler</h2>
            <p class="leading-relaxed text-ink/70">
              Yayın çizgisini, bilimsel denetimi ve içerik önceliklerini birlikte şekillendiren ekip.
            </p>
          </div>
          <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            <KuruluCard
              anchor={medicalReviewer.anchor}
              name={medicalReviewer.name}
              role={medicalReviewer.role}
              bio={medicalReviewer.bio}
              portrait={medicalReviewer.portrait}
              tags={medicalReviewer.tags}
              profileHref="/yazarlar/senai-aksoy"
            />
            {editors.map((w) => (
              <KuruluCard
                anchor={`editor-${w.slug}`}
                name={w.displayName}
                role={w.role}
                bio={w.publicBio}
                portrait={w.portrait}
                tags={w.focusAreas}
                profileHref={`/yazarlar/${w.slug}`}
              />
            ))}
          </div>
        </section>

        <!-- 1.5 Kurumsal Editöryal İmza — Estranova Editörleri arşiv linki.
             Kişi değil, kurumsal byline olduğu için yazar kartlarında listelenmez;
             yazıların tamamına /yazarlar/estranova-editorial üzerinden erişilir. -->
        <section class="relative mb-10 overflow-hidden rounded-[34px] border border-burgundy/12 bg-white/90 p-8 shadow-[0_20px_60px_rgba(79,23,28,0.07)] ring-1 ring-gold/15 md:p-10">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-gold via-burgundy/20 to-transparent"></div>
          <div class="grid gap-6 md:grid-cols-[1fr_0.78fr] md:items-center">
            <div>
              <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.22em] text-burgundy/75">
                Kurumsal Editöryal İmza
              </p>
              <h2 class="mb-3 font-serif text-3xl text-ink">Estranova Editörleri</h2>
              <p class="leading-relaxed text-ink/70">
                Temel rehberler, hub tamamlayıcıları ve açıklayıcı sağlık haritaları için kullanılan
                editöryal imza. Estranova Editorial Gloss tonuyla hazırlanır; her yazı bilimsel editör
                Doç. Dr. Senai Aksoy gözden geçirmesinden geçer. Kişi değil, kurumsal kimliktir; bu
                nedenle yazar kartlarında listelenmez.
              </p>
            </div>
            <div class="md:justify-self-end">
              <a
                href="/yazarlar/estranova-editorial"
                class="inline-flex items-center gap-2 rounded-full border border-burgundy/30 bg-cream-soft px-5 py-3 text-sm font-semibold text-burgundy transition hover:border-burgundy hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/40 focus-visible:ring-offset-2"
              >
                Estranova Editörlerinden yazıların tamamı
                <span class="font-serif text-lg text-gold" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </section>

        <!-- 2. Yazar kadrosu -->
        <section class="relative mb-10 overflow-hidden rounded-[34px] border border-burgundy/12 bg-white/90 p-8 shadow-[0_20px_60px_rgba(79,23,28,0.07)] ring-1 ring-gold/15 md:p-10">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-gold via-burgundy/20 to-transparent"></div>
          <div class="mb-7 max-w-3xl">
            <h2 class="mb-3 font-serif text-3xl text-ink">Yazar Kadromuz</h2>
            <p class="leading-relaxed text-ink/70">
              40+ kadın hayatının köşe yazarları; kendi uzmanlık alanları ile menopoz, perimenopoz ve hormonal geçiş
              başlıklarının kesişiminde günlük gözlem, soru ve açmazları magazinsel bir tonla aktarıyorlar. Yazılar tıbbi
          tavsiye değil; deneyim ve arka plan paylaşımıdır. Alfabetik sıralı.
            </p>
          </div>
          <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {guestWriters.map((w) => (
              <KuruluCard
                anchor={w.slug}
                name={w.displayName}
                role={w.role}
                bio={w.publicBio}
                portrait={w.portrait}
                tags={w.focusAreas}
                profileHref={`/yazarlar/${w.slug}`}
              />
            ))}
          </div>
        </section>

        <!-- 3. Bilimsel yazarlar -->
        <section class="relative mb-10 overflow-hidden rounded-[34px] border border-burgundy/12 bg-white/90 p-8 shadow-[0_20px_60px_rgba(79,23,28,0.07)] ring-1 ring-gold/15 md:p-10">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-gold via-burgundy/20 to-transparent"></div>
          <div class="mb-7 max-w-3xl">
            <h2 class="mb-3 font-serif text-3xl text-ink">Bilimsel Yazarlar</h2>
            <p class="leading-relaxed text-ink/70">
              Hekim ve klinik uzmanlardan oluşan bu kadro, kendi uzmanlık alanında bilimsel doğruluğu öne çıkaran
              metinler kaleme alır. Konunun gerektirdiği kanıt düzeyi etiketlemesi ve terminoloji denetimi bu yazılarda
              özellikle takip edilir. Alfabetik sıralı.
            </p>
          </div>
          <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {scientificWriters.map((w) => (
              <KuruluCard
                anchor={w.slug}
                name={w.displayName}
                role={w.role}
                bio={w.publicBio}
                portrait={w.portrait}
                tags={w.focusAreas}
                profileHref={`/yazarlar/${w.slug}`}
              >
                {w.slug === 'senai-aksoy' && (
                  <p class="mt-4 rounded-xl border-l-2 border-gold bg-white/60 px-4 py-3 text-sm italic leading-relaxed text-ink/72">
                    Yukarıdaki <a href="#senai-aksoy" class="font-semibold text-burgundy no-underline hover:underline">Bilimsel Editör Doç. Dr. Senai Aksoy</a> ile
                    aynı kişi. Mahrem ya da hassas başlıklarda — vajinal sağlık, idrar kaçırma, libido — masaya kendisi
                    oturuyor; jargonu bir kenara bırakıp komşu sıcaklığıyla anlatıyor.
                  </p>
                )}
              </KuruluCard>
            ))}
          </div>
        </section>

        <!-- 3. Editöryal süreç -->
        <section class="relative mb-10 overflow-hidden rounded-[34px] border border-gold/25 bg-burgundy p-8 text-white shadow-[0_26px_70px_rgba(79,23,28,0.18)] md:p-10">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-gold via-white/20 to-transparent"></div>
          <h2 class="mb-3 font-serif text-3xl">Editöryal süreç</h2>
          <p class="max-w-4xl leading-relaxed text-white/76">
            Metinler taslak, dil düzeni, kaynak kontrolü ve son okuma aşamalarından geçer; tıbbi terimler sade Türkçe ile
            açıklanır. Okuyucuya yönelik ton, panik yaratmadan bilgilendirme ilkesiyle korunur — abartılı vaat ve alarmist
            dilden uzak.
          </p>
        </section>

        <!-- 4. Tıbbi danışmanlar -->
        <section class="relative mb-10 overflow-hidden rounded-[34px] border border-burgundy/12 bg-white/90 p-8 shadow-[0_20px_60px_rgba(79,23,28,0.07)] ring-1 ring-gold/15 md:p-10">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-gold via-burgundy/20 to-transparent"></div>
          <div class="mb-7 max-w-3xl">
            <h2 class="mb-3 font-serif text-3xl text-ink">Tıbbi Danışmanlar</h2>
            <p class="leading-relaxed text-ink/70">
