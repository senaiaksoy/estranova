---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import IssueCover from '../../components/site/IssueCover.astro';
import IssueTableOfContents from '../../components/site/IssueTableOfContents.astro';
import EditorLetter from '../../components/site/EditorLetter.astro';
import IssueRelatedNav from '../../components/site/IssueRelatedNav.astro';
import { releasedIssues as issues, resolveCoverDossier, formatIssuePad } from '../../data/issues';
import type { Issue } from '../../data/issues';
import { writers } from '../../data/writers';
import { magazineConfig } from '../../data/magazine-config';

export async function getStaticPaths() {
  return issues
    .filter((i) => i.number > 0) // Sayı 0 (arşiv) için ayrı sayfa yok; /library'ye yönlendiriyoruz
    .map((issue) => ({
      params: { slug: issue.slug },
      props: { issue },
    }));
}

interface Props {
  issue: Issue;
}

const { issue } = Astro.props;
const issuePad = formatIssuePad(issue.number);
const coverDossier = resolveCoverDossier(issue);
const currentPath = `/sayi/${issue.slug}/`;

// Kapak dosyasında yazan yazarlar (küratör hariç)
const contributingWriters = coverDossier
  ? Array.from(new Set(coverDossier.articles.map((a) => a.writerSlug)))
      .map((slug) => writers.find((w) => w.slug === slug))
      .filter((w): w is NonNullable<typeof w> => Boolean(w))
  : [];

const curator = coverDossier
  ? writers.find((w) => w.slug === coverDossier.curatorSlug)
  : undefined;

const pageTitle = `${magazineConfig.name} · Sayı ${issuePad} — ${issue.monthYear} · ${issue.theme} | Estranova`;
const pageDescription = issue.lede;
---

<SiteLayout title={pageTitle} description={pageDescription}>
  <SiteNavbar currentPath={currentPath} />

  <main id="main-content" class="text-ink">
    <IssueCover issue={issue} />

    {issue.editorColumnSlug && (
      <section class="border-t border-primary/10 bg-white px-6 py-14 md:py-16">
        <div class="mx-auto max-w-4xl">
          <a
            href={`/editorun-kosesi/${issue.editorColumnSlug}/`}
            class="group block rounded-[28px] border border-gold/30 bg-gradient-to-br from-cream-warm via-cream-soft to-white p-7 shadow-[0_18px_56px_rgba(79,23,28,0.08)] ring-1 ring-gold/15 transition hover:-translate-y-0.5 hover:shadow-[0_22px_70px_rgba(79,23,28,0.12)] focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/35 focus-visible:ring-offset-2 md:p-9"
          >
            <p class="mb-3 text-xs font-bold uppercase tracking-[0.28em] text-primary">
              Sıcacık Köşe — {issue.monthYear}
            </p>
            <h2 class="mb-3 font-serif text-3xl leading-tight text-primary group-hover:underline group-hover:decoration-primary/30 md:text-[2.25rem]">
              Bu sayıya site editöründen kapı önü yazısı
            </h2>
            <p class="mb-4 max-w-2xl leading-relaxed text-ink/75">
              Berna Aksoy'un her sayıya yazdığı kısa editör notu — sayıyı neden bu temaya açtık, bu ay hangi soruyu konuşuyoruz.
            </p>
            <p class="font-serif text-sm italic text-primary/80 group-hover:text-primary">
              Köşeyi oku →
            </p>
          </a>
        </div>
      </section>
    )}

    <IssueTableOfContents issue={issue} />

    <EditorLetter letter={issue.editorLetter} />

    {coverDossier && (
      <>
        <section class="border-t border-primary/10 bg-cream-soft px-6 py-14 md:py-20">
          <div class="mx-auto max-w-4xl">
            <header class="mb-10">
              <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-primary">
                Bu Sayının Kapak Dosyası
              </p>
              <h2 class="mb-4 font-serif text-3xl leading-tight text-primary md:text-4xl">
                {coverDossier.title}
              </h2>
              {coverDossier.subtitle && (
                <p class="mb-4 font-serif text-xl italic text-ink/70 md:text-2xl">
                  {coverDossier.subtitle}
                </p>
              )}
              <p class="text-lg leading-relaxed text-ink/80">{coverDossier.lede}</p>
              {curator && (
                <p class="mt-5 text-xs uppercase tracking-[0.22em] text-ink/55">
                  Küratör: <span class="text-ink">{curator.displayName}</span>
                </p>
              )}
            </header>

            <ol class="space-y-5">
              {coverDossier.articles.map((article, index) => {
                const writer = writers.find((w) => w.slug === article.writerSlug);
                const writerName = writer?.displayName ?? 'Estranova';
                const isPlanned = article.status === 'planned';
                const ArticleTag = !isPlanned && article.href ? 'a' : 'div';
                const articleProps = !isPlanned && article.href ? { href: article.href } : {};
                return (
                  <li>
                    <ArticleTag
                      {...articleProps}
                      class:list={[
                        'group flex flex-col gap-3 rounded-[24px] border border-primary/12 bg-white p-6 shadow-sm transition md:flex-row md:gap-6 md:p-7',
                        !isPlanned && article.href
                          ? 'hover:-translate-y-0.5 hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/35 focus-visible:ring-offset-2'
                          : 'opacity-95',
                      ]}
                    >
                      <div class="shrink-0 md:w-20">
                        <span class="font-serif text-4xl tabular-nums text-gold md:text-5xl">
                          {String(index + 1).padStart(2, '0')}
                        </span>
                      </div>
                      <div class="min-w-0 flex-1">
                        {isPlanned && (
                          <p class="mb-2 inline-flex w-fit items-center rounded-full border border-gold/40 bg-cream-warm px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-primary/75">
                            Yakında
                          </p>
                        )}
                        <h3
                          class:list={[
                            'mb-2 font-serif text-2xl leading-snug text-ink md:text-[28px]',
                            !isPlanned && article.href && 'group-hover:underline group-hover:decoration-primary/35',
                          ]}
                        >
                          {article.title}
                        </h3>
                        <p class="mb-3 leading-relaxed text-ink/75">{article.excerpt}</p>
                        <p class="font-serif text-xs italic text-ink/60">
                          Yazan: <span class="text-ink/80">{writerName}</span>
                          {article.readingMinutes && (
                            <>
                              <span class="mx-1.5 text-gold">·</span>
                              <span>{article.readingMinutes} dakika</span>
                            </>
                          )}
                        </p>
                      </div>
                    </ArticleTag>
                  </li>
                );
              })}
            </ol>
          </div>
        </section>

        {contributingWriters.length > 0 && (
          <section class="border-t border-primary/10 bg-white px-6 py-14 md:py-16">
            <div class="mx-auto max-w-5xl">
              <header class="mb-8 max-w-2xl">
                <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-primary">
                  Bu Sayıda Yazanlar
                </p>
                <h2 class="font-serif text-3xl leading-tight text-ink">
                  Küratör seçimiyle bir araya gelen sesler
                </h2>
              </header>
              <ul class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-5">
                {contributingWriters.map((w) => (
                  <li class="flex flex-col items-center text-center">
                    <a
                      href={`/yazarlar/${w.slug}/`}
                      class="group flex flex-col items-center text-center focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/35 focus-visible:ring-offset-2"
                    >
                      {w.portrait ? (
                        <img
                          src={w.portrait}
                          alt={`${w.displayName} portresi`}
                          width="160"
                          height="160"
                          loading="lazy"
                          decoding="async"
                          class="h-20 w-20 rounded-full object-cover ring-2 ring-primary/15 transition group-hover:ring-primary/40 md:h-24 md:w-24"
                        />
                      ) : (
                        <div class="flex h-20 w-20 items-center justify-center rounded-full bg-cream-warm font-serif text-2xl text-primary ring-2 ring-primary/15 md:h-24 md:w-24">
                          {w.displayName
                            .split(/\s+/)
                            .filter((part) => part.length > 0)
                            .map((n) => n[0])
                            .join('')}
                        </div>
                      )}
                      <h3 class="mt-3 font-serif text-base text-ink group-hover:underline group-hover:decoration-primary/35">
                        {w.displayName}
                      </h3>
                      <p class="mt-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-primary/75">
                        {w.role.split('/')[0].trim()}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}
      </>
    )}

    <IssueRelatedNav currentIssue={issue} />

    {/* Sayı arşivine geri dönüş */}
    <section class="border-t border-primary/10 bg-cream-warm px-6 py-10">
      <div class="mx-auto max-w-3xl text-center">
        <a
          href="/sayi/"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary underline decoration-primary/40 underline-offset-4 transition hover:decoration-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/35 focus-visible:ring-offset-2"
        >
          Sayı arşivinin tamamı
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    {/* Tıbbi sorumluluk reddi */}
    <section class="border-t border-primary/10 bg-cream-soft px-6 py-10">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm leading-relaxed text-ink/70">
          Bu içerik genel bilgilendirme amaçlıdır; bireysel tıbbi değerlendirme, tanı veya tedavinin
          yerine geçmez. Kişisel sağlık kararları için doktorunuza danışınız.
        </p>
        <p class="mt-3 text-xs uppercase tracking-[0.22em] text-ink/55">
          <a href="/tibbi-sorumluluk/" class="hover:text-primary">Tıbbi Sorumluluk Reddi</a>
          <span class="mx-2 text-gold">·</span>
          <a href="/editoryal-politika/" class="hover:text-primary">Editöryal Politika</a>
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
