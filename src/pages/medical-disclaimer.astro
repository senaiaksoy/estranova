---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
---

<SiteLayout
  title="Tibbi Uyari - Estranova"
  description="Estranova tibbi sorumluluk ve bilgilendirme metni."
>
  <SiteNavbar />

  <main id="main-content" class="pt-24">
    <section class="px-6 py-16 md:py-20">
      <div class="max-w-4xl mx-auto">
        <header class="max-w-3xl mb-14">
          <p class="text-secondary text-xs font-bold tracking-[0.28em] uppercase mb-4">Tibbi Uyari</p>
          <h1 class="text-5xl md:text-7xl font-serif leading-[1.05] text-charcoal mb-6">Bu site ne icin vardir, ne icin degildir?</h1>
          <p class="text-lg md:text-xl text-charcoal/65 leading-relaxed">
            Estranova'daki butun icerikler genel bilgilendirme amaciyla hazirlanir. Hekim degerlendirmesinin yerine gecmez.
          </p>
        </header>

        <div class="space-y-6">
          <section class="rounded-[32px] border border-primary/10 bg-white p-8 editorial-shadow">
            <h2 class="text-3xl font-serif mb-4">Bilgilendirme siniri</h2>
            <p class="text-charcoal/70 leading-relaxed">
              Sayfalarda yer alan metinler tani koymaz, tedavi planlamaz ve kisiye ozel tibbi karar vermez. Saglikla ilgili bireysel kararlar doktor-hasta gorusmesi icinde ele alinmalidir.
            </p>
          </section>

          <section class="rounded-[32px] border border-primary/10 bg-white p-8 editorial-shadow">
            <h2 class="text-3xl font-serif mb-4">Belirti yorumu</h2>
            <p class="text-charcoal/70 leading-relaxed">
              Bir semptomun gorulmesi, tek basina belirli bir tibbi sonuca isaret etmez. Benzer belirtiler farkli nedenlerle ortaya cikabilir; bu nedenle klinik baglam esastir.
            </p>
          </section>

          <section class="rounded-[32px] border border-primary/10 bg-surface-container p-8">
            <h2 class="text-3xl font-serif mb-4">Editoryal sorumluluk</h2>
            <p class="text-charcoal/70 leading-relaxed">
              Estranova bir hizmet satis sayfasi degildir. Icerik sorumlulugu, yazar, site yonetimi ve tibbi denetim rolleri ayrilarak surdurulur; ancak yayinlanan metinler klinik danismanlik yerine gecmez.
            </p>
          </section>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
