---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
---

<SiteLayout
  title="İletişim - Estranova"
  description="Estranova editoryal ekibiyle iletişime geçin. Sorularınız, önerileriniz ve düzeltme talepleriniz için buradayız."
>
  <SiteNavbar />

  <main id="main-content" class="pt-24">
    <section class="px-6 py-16 md:py-20">
      <div class="max-w-4xl mx-auto">
        <header class="max-w-3xl mb-14">
          <p class="text-secondary text-xs font-bold tracking-[0.28em] uppercase mb-4">İletişim</p>
          <h1 class="text-5xl md:text-7xl font-serif leading-[1.05] text-charcoal mb-6">İletişim</h1>
          <p class="text-lg md:text-xl text-charcoal/65 leading-relaxed">
            Estranova editoryal ekibiyle iletişime geçin. Sorularınız, önerileriniz ve düzeltme talepleriniz için buradayız.
          </p>
        </header>

        <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
          <article class="rounded-[32px] border border-primary/10 bg-white p-7 editorial-shadow">
            <p class="text-secondary text-xs font-bold tracking-[0.24em] uppercase mb-3">Genel Bilgi</p>
            <p class="text-charcoal/70 leading-relaxed">
              <a href="mailto:bilgi@estranova.com" class="text-primary font-semibold hover:underline">bilgi@estranova.com</a>
            </p>
          </article>

          <article class="rounded-[32px] border border-primary/10 bg-white p-7 editorial-shadow">
            <p class="text-secondary text-xs font-bold tracking-[0.24em] uppercase mb-3">Editoryal Ekip</p>
            <p class="text-charcoal/70 leading-relaxed">
              <a href="mailto:editoral@estranova.com" class="text-primary font-semibold hover:underline">editoral@estranova.com</a>
            </p>
          </article>

          <article class="rounded-[32px] border border-primary/10 bg-white p-7 editorial-shadow">
            <p class="text-secondary text-xs font-bold tracking-[0.24em] uppercase mb-3">KVKK Talepleri</p>
            <p class="text-charcoal/70 leading-relaxed">
              <a href="mailto:kvkk@estranova.com" class="text-primary font-semibold hover:underline">kvkk@estranova.com</a>
            </p>
          </article>
        </section>

        <section class="rounded-[32px] border border-primary/10 bg-white p-8 editorial-shadow mb-6">
          <h2 class="text-3xl font-serif mb-6">Mesaj Formu</h2>

          <form class="space-y-5" aria-label="Bilgi ve öneri iletişim formu">
            <div>
              <label for="name" class="block text-sm font-semibold text-charcoal mb-2">İsim</label>
              <input
                id="name"
                name="name"
                type="text"
                class="w-full rounded-xl border border-primary/20 bg-surface px-4 py-3 text-charcoal placeholder:text-charcoal/45 focus:outline-none focus:ring-2 focus:ring-primary/35"
                placeholder="Adınız ve soyadınız"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold text-charcoal mb-2">E-posta</label>
              <input
                id="email"
                name="email"
                type="email"
                class="w-full rounded-xl border border-primary/20 bg-surface px-4 py-3 text-charcoal placeholder:text-charcoal/45 focus:outline-none focus:ring-2 focus:ring-primary/35"
                placeholder="ornek@eposta.com"
              />
            </div>

            <div>
              <label for="subject" class="block text-sm font-semibold text-charcoal mb-2">Konu</label>
              <input
                id="subject"
                name="subject"
                type="text"
                class="w-full rounded-xl border border-primary/20 bg-surface px-4 py-3 text-charcoal placeholder:text-charcoal/45 focus:outline-none focus:ring-2 focus:ring-primary/35"
                placeholder="Mesaj konunuzu yazın"
              />
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold text-charcoal mb-2">Mesaj</label>
              <textarea
                id="message"
                name="message"
                rows="6"
                class="w-full rounded-xl border border-primary/20 bg-surface px-4 py-3 text-charcoal placeholder:text-charcoal/45 focus:outline-none focus:ring-2 focus:ring-primary/35"
                placeholder="Mesajınızı buraya yazın"
              ></textarea>
            </div>

            <div class="pt-2">
              <button
                type="button"
                class="inline-flex items-center justify-center rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-white transition hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-primary/35"
              >
                Mesajınızı İletin
              </button>
            </div>
          </form>
        </section>

        <section class="rounded-[32px] border border-primary/10 bg-surface-container p-8">
          <p class="text-charcoal/70 leading-relaxed">
            Bu form bilgi ve öneri amaçlıdır. Tıbbi danışmanlık veya randevu talebi için kullanılamaz.
          </p>
        </section>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
