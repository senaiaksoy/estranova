---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
---

<SiteLayout
  title="Tıbbi Sorumluluk Reddi - Estranova"
  description="Estranova içeriklerinin bilgilendirme sınırları ve tıbbi sorumluluk reddi metni."
>
  <SiteNavbar currentPath="/tibbi-sorumluluk" />

  <main id="main-content" class="pt-24 text-[#2D2D2D]">
    <div class="bg-[#FFF8E1] px-6 py-3 text-center text-sm leading-snug text-[#2D2D2D]/90">
      Bu sayfa hazırlanıyor. İçerik yakında güncellenecek.
    </div>

    <div class="mx-auto max-w-3xl px-6 py-16 md:py-20">
      <header class="mb-12">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">YASAL BİLGİLENDİRME</p>
        <h1 class="mb-6 font-serif text-4xl leading-tight md:text-5xl">Tıbbi Sorumluluk Reddi</h1>
        <p class="text-lg leading-relaxed text-[#2D2D2D]/75">
          Estranova'daki içerikler genel bilgilendirme amaçlıdır; bireysel tıbbi değerlendirme, tanı veya tedavinin yerine
          geçmez.
        </p>
      </header>

      <div class="space-y-10">
        <section>
          <h2 class="mb-3 font-serif text-2xl">İçeriklerimizin kapsamı</h2>
          <p class="leading-relaxed text-[#2D2D2D]/75">
            Burada sunulan metinler, hormonal geçiş ve ilişkili yaşam başlıklarında genel çerçeve ve yönlendirme sağlamayı
            amaçlar. Platform bir klinik hizmeti veya uzaktan değerlendirme sunmaz; içerikler kişisel durumunuza özel
            yorum içermez.
          </p>
        </section>

        <section>
          <h2 class="mb-3 font-serif text-2xl">Sınırlamalar</h2>
          <p class="leading-relaxed text-[#2D2D2D]/75">
            Bilgiler güncel bilim ve editoryal süreçle uyumludur; yine de bireysel farklılıklar, eşlik eden durumlar ve
            değişen rehberler nedeniyle her okur için aynı anlamı taşımayabilir. İçerikler tıbbi karar veya acil müdahale
            yerine geçmez.
          </p>
        </section>

        <section>
          <h2 class="mb-3 font-serif text-2xl">Doktorunuza danışmak neden önemli</h2>
          <p class="leading-relaxed text-[#2D2D2D]/75">
            Belirtiler, ilaçlar ve yaşam planı kişiye özel değerlendirme gerektirir. Okuduklarınızı sağlık profesyonelinizle
            paylaşmanız, uygun takip ve güvenli seçimler için uygundur.
          </p>
        </section>

        <section>
          <h2 class="mb-3 font-serif text-2xl">İletişim</h2>
          <p class="leading-relaxed text-[#2D2D2D]/75">
            Metinlerle ilgili genel sorularınız için iletişim kanallarımız üzerinden yönlendirme alabilirsiniz; tıbbi teşhis
            veya tedavi talepleri bu kanallar üzerinden yürütülmez.
          </p>
        </section>
      </div>
    </div>
  </main>

  <SiteFooter />
</SiteLayout>
