---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import { magazineConfig } from '../../data/magazine-config';

const pageTitle = 'Estranova Mektubu — Eşik dergisinden ayda bir not';
const pageDescription =
  'Estranova Mektubu, Eşik dergisinin her ayki sayısı yayına girdiğinde okura ulaşan kısa bir editöryal not. Mektup arşivi yakında.';
---

<SiteLayout title={pageTitle} description={pageDescription}>
  <SiteNavbar currentPath="/mektup" />

  <main id="main-content" class="text-ink">
    <section class="relative overflow-hidden border-y border-burgundy/10 bg-gradient-to-br from-cream-warm via-cream-soft to-white px-6 py-16 md:py-24">
      <div class="pointer-events-none absolute -right-24 top-8 h-72 w-72 rounded-full bg-gold/15 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute bottom-8 left-4 hidden font-serif text-[9rem] lowercase leading-none text-burgundy/[0.035] md:block" aria-hidden="true">
        mektup
      </div>

      <div class="relative mx-auto max-w-5xl">
        <nav aria-label="Sayfa konumu" class="mb-6 text-xs uppercase tracking-[0.22em] text-ink/55">
          <a href="/" class="text-ink/65 hover:text-burgundy">Anasayfa</a>
          <span class="mx-2 text-gold">·</span>
          <span class="text-burgundy">Mektup</span>
        </nav>

        <div class="mb-6 h-px w-24 bg-gold"></div>
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.32em] text-burgundy">
          Estranova Mektubu
        </p>
        <h1 class="mb-7 max-w-4xl font-serif text-5xl leading-[0.95] tracking-[-0.05em] text-burgundy md:text-8xl">
          Ayda bir, posta kutuna düşen kısa bir not
        </h1>
        <p class="max-w-3xl border-l border-gold/60 pl-6 font-serif text-xl italic leading-relaxed text-ink/72 md:text-2xl">
          {magazineConfig.name} dergisinin her sayısı yayına girdiğinde — bilimsel editör mektubunun bir özeti, kapak
          dosyasındaki yazıların listesi ve ay boyunca dikkatimizi çeken bir-iki okuma. Sade, sakin, satışsız.
        </p>
      </div>
    </section>

    <section class="bg-white px-6 py-12 md:py-16">
      <div class="mx-auto max-w-4xl">
        <div class="relative overflow-hidden rounded-[34px] border border-burgundy/12 bg-cream-soft/60 p-8 shadow-[0_24px_70px_rgba(79,23,28,0.08)] ring-1 ring-gold/20 md:p-10">
          <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-gold via-burgundy/40 to-transparent"></div>
          <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.28em] text-gold">
            Mektup Arşivi
          </p>
          <h2 class="mb-4 font-serif text-3xl leading-snug text-ink md:text-4xl">
            İlk mektup henüz yola çıkmadı
          </h2>
          <p class="mb-6 max-w-3xl text-base leading-relaxed text-ink/75">
            Eşik dergisinin ilk sayısı yayına girdiğinde Estranova Mektubu'nun ilk yazısı buraya
            düşer. O güne kadar bu sayfa boş kalır — okurla kurulan bağ acele edilen bir şey değil.
          </p>
          <p class="max-w-3xl text-sm leading-relaxed text-ink/60">
            Mektup gelir gelmez seninle paylaşmak istersen, anasayfanın altındaki kayıt formunu kullanabilirsin.
            Hiçbir kişisel veri üçüncü taraflarla paylaşılmaz; istediğin zaman kayıttan ayrılabilirsin.
          </p>
        </div>
      </div>
    </section>

    <section class="border-t border-burgundy/10 bg-cream-soft px-6 py-12 md:py-16">
      <div class="mx-auto max-w-4xl">
        <h2 class="mb-7 font-serif text-3xl leading-snug text-ink md:text-4xl">
          Mektupta neler olur?
        </h2>
        <ul class="grid gap-4 md:grid-cols-3">
          <li class="rounded-[28px] border border-burgundy/12 bg-white/75 p-6 shadow-[0_16px_45px_rgba(79,23,28,0.06)]">
            <span class="shrink-0 font-serif text-2xl tabular-nums text-gold">01</span>
            <div class="mt-4 min-w-0">
              <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-burgundy/75">
                Bilimsel editör açılışı
              </p>
              <p class="mt-1 font-serif text-lg leading-snug text-ink md:text-xl">
                Doç. Dr. Senai Aksoy'un sayı için yazdığı kısa açılışın özeti
              </p>
            </div>
          </li>
          <li class="rounded-[28px] border border-burgundy/12 bg-white/75 p-6 shadow-[0_16px_45px_rgba(79,23,28,0.06)]">
            <span class="shrink-0 font-serif text-2xl tabular-nums text-gold">02</span>
            <div class="mt-4 min-w-0">
              <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-burgundy/75">
                Sayının kapak dosyası
              </p>
              <p class="mt-1 font-serif text-lg leading-snug text-ink md:text-xl">
                Bu ayın temasını farklı kapılardan açan dört-beş yazının listesi
              </p>
            </div>
          </li>
          <li class="rounded-[28px] border border-burgundy/12 bg-white/75 p-6 shadow-[0_16px_45px_rgba(79,23,28,0.06)]">
            <span class="shrink-0 font-serif text-2xl tabular-nums text-gold">03</span>
            <div class="mt-4 min-w-0">
              <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-burgundy/75">
                Editör seçkisi
              </p>
              <p class="mt-1 font-serif text-lg leading-snug text-ink md:text-xl">
                Ay boyunca okuduğumuz, dikkatimizi çeken bir-iki başka yazı
              </p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <section class="border-t border-burgundy/10 bg-white px-6 py-12">
      <div class="mx-auto max-w-3xl text-center">
        <p class="mb-4 font-serif text-lg italic leading-relaxed text-ink/70">
          Bütün okuma panelin için
        </p>
        <a
          href="/hesabim"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-burgundy underline decoration-burgundy/40 underline-offset-4 transition hover:decoration-burgundy focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
        >
          Okuma Panelime git
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section class="border-t border-burgundy/10 bg-cream-soft px-6 py-10">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm leading-relaxed text-ink/65">
          Mektup üyeliği üyelik veya hesap gerektirmez; e-postanın saklanması ve dağıtımı için <a href="/kvkk" class="font-semibold text-burgundy underline decoration-burgundy/40 underline-offset-4 hover:decoration-burgundy">KVKK Aydınlatma Metni</a>'ne göz atabilirsin.
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
