---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuSection from '../../../components/site/SubmenuSection.astro';
import ChapterMasthead from '../../../components/site/ChapterMasthead.astro';
import EditorialEpigraph from '../../../components/site/EditorialEpigraph.astro';
import ChapterCompass from '../../../components/site/ChapterCompass.astro';
import EditorPickCard from '../../../components/site/EditorPickCard.astro';
import MagazineTOC from '../../../components/site/MagazineTOC.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { chapterMap, getNextChapter } from '../../../data/chapter-map';
import { subHubEpigraphs } from '../../../data/sub-hub-epigraphs';

const hero = submenuHeroByRoute['/hormonal-gecis/perimenopoz']!;
const __path = '/hormonal-gecis/perimenopoz';
const chapter = chapterMap[__path]!;
const epigraph = subHubEpigraphs[__path];
const next = getNextChapter(__path);

const editorPick = {
  href: '/hormonal-gecis/perimenopoz/perimenopoz-ilk-isaretler',
  title: 'Perimenopozda İlk İşaretler',
  lede: 'Adet takvimi, uyku, ısı dalgaları, ruh hali ve odak değişimini tek tek değil, aynı geçiş haritasının küçük notları gibi okumak.',
  writerSlug: 'berna-aksoy',
  readingMinutes: 9,
  image: hero,
};

const tocArticles = [
  {
    href: '/hormonal-gecis/perimenopoz/perimenopoz-ilk-isaretler',
    title: 'Perimenopozda İlk İşaretler',
    excerpt:
      'Adet düzeni, uyku, sıcak basması, ruh hali ve beyin sisi gibi ilk işaretleri panik yaratmadan okumak için sakin bir geçiş haritası.',
    writerSlug: 'berna-aksoy',
    readingMinutes: 9,
  },
  {
    href: '/zihin-denge/uyku-dinlenme/uyku-bozuklugu-menopoz',
    title: 'Menopozda Uyku Bozukluğu — Dinlenme Rehberi',
    excerpt:
      'Gece terlemesi ve uyku bölünmesi geçiş döneminde sıktır; uyku hijyeni ve ne zaman profesyonel destek düşünülebileceği üzerine planlı bir okuma.',
    writerSlug: 'berna-aksoy',
    readingMinutes: 9,
  },
];

const themes = [
  {
    step: '01',
    title: 'Uyku ve gece terlemesi',
    text: 'Uyku bölünmesi ve gece terlemesi vasomotor belirtilerle ilişkilendirilebilir; günlük güç ve ruh hali üzerindeki etkileri birlikte ele alınır.',
    href: '/zihin-denge/uyku-dinlenme/uyku-bozuklugu-menopoz',
  },
  {
    step: '02',
    title: 'Belirtileri sınıflandırmak',
    text: 'Sıcak basması, uyku, kilo ve cilt gibi başlıklarda semptom rehberi ile kendi haritanızı çıkarabilirsiniz.',
    href: '/symptoms',
  },
];

const neighboringStages = [
  {
    step: '02',
    href: '/hormonal-gecis/menopoza-hazirlik',
    title: 'Menopoza hazırlık',
    text: 'Rutin, hareket ve beslenme başlıklarında planlı adımlar için içerik özetleri.',
  },
  {
    step: '03',
    href: '/hormonal-gecis/menopoz',
    title: 'Menopoz',
    text: 'Son adetten sonra tanımlanan dönem ve sık okunan menopoz rehberleri.',
  },
];
---

<SiteLayout
  title="Perimenopoz Rehberi — Hormonal Geçiş - Estranova"
  description="Perimenopoz nedir, adet ve ruh hali nasıl okunur? Temel rehber, seçilmiş makaleler ve Zihin & Denge bağlantılarıyla hormonal geçişin ilk evresi."
>
  <SiteNavbar currentPath="/hormonal-gecis" />
  <ChapterMasthead number={chapter.number} parent={chapter.parent} chapter={chapter.chapter} />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Hormonal Geçiş · İlk evre"
      title="Perimenopoz: menopoza giden geçiş yolu"
      lede="Üreme çağından menopoza uzanan bu süreçte hormonlar dalgalanır; burada amaç panik değil, neyin ne zaman normal sınırlarda okunabileceğini netleştirmektir."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />
    <section class="border-b border-burgundy/10 bg-[#fffaf0] px-6 py-14 md:py-18">
      <div class="mx-auto max-w-6xl">
        <nav class="mb-8 text-sm text-ink/60" aria-label="İçerik yolu">
          <ol class="flex flex-wrap items-center gap-2">
            <li>
              <a href="/hormonal-gecis" class="font-medium text-burgundy hover:underline">Hormonal Geçiş</a>
            </li>
            <li aria-hidden="true">/</li>
            <li class="font-medium text-ink">Perimenopoz</li>
          </ol>
        </nav>

        <div class="grid gap-12 lg:grid-cols-[1.12fr_0.88fr] lg:items-start lg:gap-16">
          <div>
            <p class="mb-6 font-serif text-3xl italic leading-tight text-burgundy-deep md:text-5xl">
              Hormonlar bu dönemde tek çizgi halinde değil, dalga dalga konuşur.
            </p>
            <p class="mb-5 text-lg leading-relaxed text-ink/82 md:text-xl">
              Perimenopoz, üreme çağından menopoza uzanan doğal sürecin adıdır. Hormonlar tek düz bir çizgide düşmez; dalgalanma,
              adette düzensizlik, uyku ve ruh halinde dalgalanmalar sık görülür. Burada amaç panik değil,{' '}
              <strong class="font-semibold text-ink">neyin ne zaman normal sınırlarda okunabileceğini</strong> ve hangi başlıklarda bilgi
              derinleştirmenin işe yarayacağını netleştirmektir.
            </p>
            <p class="text-base leading-relaxed text-ink/72">
              Aşağıda önce temel rehberi, ardından seçilmiş makaleleri ve günlük yaşam başlıklarına göre yönlendirmeleri bulacaksınız.
              Tedavi veya ilaç kararı bu sayfada yer almaz; kişisel değerlendirme her zaman hekiminizle yapılır.
            </p>
          </div>

          <aside
            class="border-y border-burgundy/15 bg-white/62 p-7 md:p-8"
            aria-labelledby="perimenopoz-ozet-baslik"
          >
            <h2 id="perimenopoz-ozet-baslik" class="mb-5 font-serif text-3xl leading-tight text-ink">Bu evrede sık sorulanlar</h2>
            <ul class="space-y-4 text-sm leading-relaxed text-ink/78">
              <li class="border-b border-burgundy/10 pb-4">
                <span class="block font-semibold text-ink">Ne kadar sürer?</span>
                Yaygın olarak birkaç yıl sürebilir; başlangıç yaşı ve belirti şiddeti kişiden kişiye değişir.
              </li>
              <li class="border-b border-burgundy/10 pb-4">
                <span class="block font-semibold text-ink">Tek başına testle tanımlanır mı?</span>
                Çoğu zaman öykü ve adet izlemi önemlidir; gerektiğinde hekiminiz ek değerlendirme önerir.
              </li>
              <li>
                <span class="block font-semibold text-ink">Menopozdan farkı nedir?</span>
                Perimenopoz geçiş dönemidir; menopoz ise son adetten sonra 12 ayın tamamlanmasıyla geriye dönük tanımlanır.
              </li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    {epigraph && <EditorialEpigraph quote={epigraph} />}

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-10 grid gap-8 md:grid-cols-[0.72fr_1.28fr] md:items-end">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Editör'ün Seçimi</p>
        <h2 class="font-serif text-4xl leading-[0.98] tracking-[-0.03em] md:text-6xl">Bu evreden bir okuma</h2>
      </header>

      {editorPick && (<EditorPickCard
        href={editorPick.href}
        title={editorPick.title}
        lede={editorPick.lede}
        writerSlug={editorPick.writerSlug}
        readingMinutes={editorPick.readingMinutes}
        imageSrc={editorPick.image.src}
        imageAlt={editorPick.image.alt}
      />)}
    </SubmenuSection>

    <SubmenuSection variant="cream" borderedTop={true}>
      <header class="mb-10 grid gap-8 md:grid-cols-[0.72fr_1.28fr] md:items-end">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Bu Evrede Okumalar</p>
        <h2 class="font-serif text-4xl leading-[0.98] tracking-[-0.03em] md:text-6xl">Perimenopoz okumaları</h2>
      </header>

      <MagazineTOC items={tocArticles} />
    </SubmenuSection>

    <!-- Themes -->
    <section class="bg-white px-6 py-16 md:py-24">
      <div class="mx-auto max-w-6xl">
        <header class="mb-12 grid gap-8 md:grid-cols-[0.72fr_1.28fr] md:items-end">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Konuya göre</p>
          <div>
            <h2 class="mb-4 font-serif text-4xl leading-[0.98] tracking-[-0.03em] md:text-6xl">Yaşam başlıklarıyla okumak</h2>
            <p class="max-w-2xl text-lg leading-relaxed text-ink/75">
              Hormonal geçiş yalnızca “kadın hastalıkları” kutusunda değildir; uyku, duygu düzeni ve günlük enerji aynı tablonun parçasıdır.
            </p>
          </div>
        </header>

        <div class="divide-y divide-burgundy/14 border-y border-burgundy/14">
          {
            themes.map((t) => (
              <a
                href={t.href}
                class="group grid gap-5 py-7 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2 md:grid-cols-[88px_1fr_auto] md:items-start md:gap-8"
              >
                <span class="font-serif text-5xl leading-none tabular-nums text-gold md:text-6xl">{t.step}</span>
                <span>
                  <span class="block font-serif text-3xl leading-tight text-ink group-hover:underline group-hover:decoration-gold/70">{t.title}</span>
                  <span class="mt-2 block text-base leading-relaxed text-ink/72">{t.text}</span>
                </span>
                <span class="font-serif text-2xl text-gold transition group-hover:translate-x-1" aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Neighboring stages -->
    <section class="border-t border-burgundy/10 bg-[#fffaf0] px-6 py-16 md:py-24">
      <div class="mx-auto max-w-6xl">
        <header class="mb-10 grid gap-8 md:grid-cols-[0.72fr_1.28fr] md:items-end">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Geçişin devamı</p>
          <h2 class="font-serif text-4xl leading-[0.98] tracking-[-0.03em] md:text-6xl">Komşu evreler</h2>
        </header>
        <div class="divide-y divide-burgundy/14 border-y border-burgundy/14">
          {
            neighboringStages.map((stage) => (
              <a
                href={stage.href}
                class="group grid gap-5 py-7 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2 md:grid-cols-[88px_1fr_auto] md:items-start md:gap-8"
              >
                <span class="font-serif text-5xl leading-none tabular-nums text-gold md:text-6xl">{stage.step}</span>
                <span>
                  <span class="block font-serif text-3xl leading-tight text-ink group-hover:underline group-hover:decoration-gold/70">{stage.title}</span>
                  <span class="mt-2 block text-base leading-relaxed text-ink/72">{stage.text}</span>
                </span>
                <span class="font-serif text-2xl text-gold transition group-hover:translate-x-1" aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>

        <p class="mt-12 text-center">
          <a href="/hormonal-gecis" class="font-semibold text-burgundy hover:underline">← Hormonal Geçiş ana sayfa</a>
        </p>
      </div>
    </section>

    <ChapterCompass nextHref={next?.href} nextNumber={next?.number} nextChapter={next?.chapter} nextParent={next?.parent} />
  </main>

  <SiteFooter />
</SiteLayout>
