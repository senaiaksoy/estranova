---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../../components/site/ArticleFAQ.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { articleFaqs } from '../../../data/article-faqs';
import { resolveSiteUrl } from '../../../utils/seo';

const hero = submenuHeroByRoute['/hormonal-gecis/perimenopoz/']!;

const tocEntries = [
  { id: 'ilk-isaret', label: 'İlk İşareti Nasıl Tanırız?' },
  { id: 'adet', label: 'Adet Takvimindeki Değişim' },
  { id: 'uyku-isi', label: 'Uyku ve Gece Belirtileri' },
  { id: 'ruh-hali', label: 'Ruh Hali, Odak ve Beyin Sisi' },
  { id: 'evreler-tablo', label: 'Perimenopoz Evreleri' },
  { id: 'testler', label: 'Kan Testinin Sınırı' },
  { id: 'izleme-hekim', label: 'İzleme, Kayıt ve Hekimle Konuşmak' },
  { id: 'kaynaklar', label: 'Kaynaklar', numbered: false },
  { id: 'sik-sorulanlar', label: "Dr. Aksoy'a sorular", numbered: false },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Perimenopoz Belirtileri ve İlk İşaretler: "Bende Bir Şey Değişiyor" Dedirten Dönem';
const seoTitle = 'Perimenopoz Belirtileri ve İlk İşaretler';
const articleDescription =
  'Perimenopoz belirtileri nelerdir, kaç yaşında başlar? Adet, uyku ve sıcak basmasındaki kaymalar; 45 yaş üzerinde çoğu zaman kan testi olmadan tanınır.';
const faqItems = articleFaqs['/hormonal-gecis/perimenopoz/perimenopoz-ilk-isaretler/'] ?? [];
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'senai-aksoy',
  articleType: 'clinical-guide',
  publishedDate: '4 Mayıs 2026',
  modifiedDate: '21 Ekim 2026',
  pathname: '/hormonal-gecis/perimenopoz/perimenopoz-ilk-isaretler/',
  articleSection: 'Hormonal Geçiş',
  sectionPath: '/hormonal-gecis/',
  keywords: [
    'perimenopoz belirtileri',
    'perimenopoz nedir',
    'perimenopoz kaç yaşında başlar',
    'erken menopoz belirtileri',
    'menopoz geçişi',
    'adet düzensizliği 40 yaş',
    'sıcak basması',
    'gece terlemesi',
    'uyku',
    'beyin sisi',
    'FSH',
  ],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/hormonal-gecis/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Hormonal Geçiş · Perimenopoz"
      title="Perimenopoz Belirtileri ve İlk İşaretler"
      lede="Bu dönemin ilk işaretleri çoğu zaman takvimde değil, bedene dair o tanıdık güven duygusunun sarsılmasıyla fark edilir."
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="senai-aksoy"
        articleType="clinical-guide"
        publishedDate="4 Mayıs 2026"
        lastUpdated="21 Ekim 2026"
        readingMinutes={9}
        imageSrc="/images/library/editorial/hg-perimenopoz-ilk-isaretler.webp"
        imageAlt="Aydınlık bir iç mekanda bedensel değişimi fark eden 40+ kadın portresi"
      />

      <ArticleSummary title="Kısa Klinik Yanıt">
        <p>
          Perimenopoz, yumurtalık işlevinin düzensizleşmeye başladığı ve adet döngüsünün değiştiği geçiş
          dönemidir. 45 yaş üzerinde yeni başlayan vazomotor belirtiler — sıcak basması ve gece terlemesi — ile
          adet düzeni değişikliği çoğu zaman klinik tanı için yeterlidir; tek bir kan testi bu tabloyu
          netleştirmez. Bu yazı, belirtileri okumak ve hekim görüşmesine hazırlanmak içindir.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="ilk-isaret">İlk İşareti Nasıl Tanırız?</h2>
        <p>Perimenopoz çoğu kadını beklerken yakalamaz. Büyük bir alarm da çalmaz.</p>
        <p>
          Muayene odasında bunu yıllardır duyuyorum. Takvim hâlâ kanama gösteriyor. Büyük bir şikâyet yok. Ama
          uyku eskisi gibi değil; aylık ritimde küçük bir kayma var; gece ara sıra bir ısı dalgası geliyor. Takvim
          "her şey yolunda" diye işaretliyor; gece başka bir rapor veriyor. Sizde de çoğu zaman böyle başlar. Bu
          tabloyu duyduğumda önce tek bir belirtiye değil, yan yana duran bu küçük kaymalara bakıyorum.
        </p>
        <p>
          Tıbbi olarak perimenopoz, menopoza giden geçiş dönemidir. Yumurtlama düzensizleşir; östrojen ve
          progesteron tek çizgide azalmak yerine dalgalanır. Menopoz ise son adetten sonra 12 ay tamamlandığında
          geriye dönük olarak tanımlanır. Perimenopoz hâlâ kanamanın sürdüğü, ama eski düzenin gevşediği
          dönemdir.
          <Evidence level={4} /><sup><a href="#kaynak-1">[1]</a></sup>
        </p>

        <h2 id="adet">Adet Takvimindeki Değişim</h2>
        <p>En erken ve en görünür işaret çoğu zaman adet takvimindedir. Herkesin takvimi aynı yolu izlemez.</p>
        <p>
          Adet aralığı kısalabilir ya da uzayabilir; kanama miktarı daha hafif ya da daha yoğun olabilir. Bazı
          aylarda yumurtlama gerçekleşmeyebilir. Beklenen tarih kayar, bir kanama atlanır, döngü bir aydan ötekine
          değişken görünür. <Evidence level={4} /><sup><a href="#kaynak-1">[1]</a></sup>
        </p>
        <p>
          Klinik değerlendirmede tek bir aylık sapma değil, birkaç ay boyunca tekrar eden değişimler anlamlıdır.
          STRAW+10 üreme yaşlanması sınıflamasına göre adet aralığının birden fazla dönem boyunca yedi gün veya daha fazla kayması
          erken geçiş evresine, iki kanama arasındaki sürenin 60 güne ya da daha fazlasına uzaması ise geçişin
          ilerlemiş evresine işaret edebilir. <Evidence level={4} /><sup><a href="#kaynak-1">[1]</a></sup> Bu
          sayılar, "bedenimde bir şey değişiyor" cümlesinin altına koyabileceğiniz somut gözlemlerdir.
        </p>
        <p>
          Üç ay boyunca adet başlangıç ve bitiş tarihlerini, kanama yoğunluğunu ve eşlik eden belirtileri kısa
          notlarla kaydedin. "Üç gün erken", "gece terlemesi vardı", "daha yoğundu" gibi birkaç kelime, muayene
          odasında benim için en değerli başlangıç noktasıdır.
        </p>

        <h2 id="uyku-isi">Uyku ve Gece Belirtileri</h2>
        <p>Gece, gündüzün sakladığını açar. Perimenopozun bir işareti de çoğu zaman uykuda görünür.</p>
        <p>
          <a href="/hormonal-gecis/menopoz/sicak-basmasi-gece-terlemesi/">Sıcak basması ve gece terlemesi</a> —
          klinik dilde vazomotor belirtiler — bu dönemin en sık bildirilen şikâyetleri arasındadır. Her kadında
          aynı şiddetle görülmez. Bazılarında belirgin ısı dalgası ve terleme olur. Bazılarında yalnızca sabah
          yorgunluğu veya yüzeysel uyku fark edilir.
        </p>
        <p>
          Uyku değişikliği her zaman sıcak basmasıyla gelmez. Poliklinikte bazı kadınlar hiç belirgin terleme
          olmadan daha sık uyandığını, sabah dinlenmemiş kalktığını ya da eskiye göre çok daha hafif uyuduğunu
          anlatıyor. Hormonal geçiş, terleme olmadan da uykuyu bölebilir. Aynı tabloyu tiroid sorunu, kansızlık
          (anemi), uyku apnesi veya stres de üretebilir.
        </p>
        <p>
          Hekimle görüşürken şu ayrımı taşımak işe yarar: uykuya dalmak mı zorlaştı, yoksa gece uyanıp tekrar
          uyumak mı? Sabah dinlenmemiş kalkma mı baskın, yoksa ısı dalgasıyla uyanmak mı? Bu iki cümle,
          "uyuyamıyorum" ifadesinden daha okunaklı bir klinik bilgidir.
        </p>

        <h2 id="ruh-hali">Ruh Hali, Odak ve "Beyin Sisi"</h2>
        <p>Kelime aramak ya da gözyaşının daha çabuk gelmesi, bu dönemde sık duyduğum şikâyetlerdendir.</p>
        <p>
          Kısa süren sinirlilik, aynı anda iki işe yetememe, bir cümlenin ortasında duraksamak — bunlar bu
          dönemde sık bildirilir. Bu tabloyu kalıcı bir hasar gibi yaşamayın diye yazıyorum; bu korku çoğu zaman
          belirtinin kendisinden daha ağırdır. Muayene odasında bunu çoğu zaman dalgalı, geçişle birlikte gelen bir
          şikâyet olarak görüyorum; orta yaşta demans tanısı koymak için acele etmem. Ani başlayan bilinç bulanıklığı, konuşma
          bozukluğu veya tek taraflı güçsüzlük ise acil değerlendirme gerektirir.
        </p>
        <p>
          Ruh hali değişikliklerini küçümsememek gerekir. İki haftadan uzun süren belirgin mutsuzluk hali, yoğun
          kaygı, panik atak benzeri tablolar, işlev kaybı ya da kendine zarar düşünceleri perimenopoz geçişine
          bağlanarak bekletilecek şeyler değildir. Bu ayrımı doğru kurmak, klinisyen olarak en kıymetli
          sorumluluklarımdan biridir: normalleştirmek rahatlatır; geçiştirmek geciktirir.
        </p>

        <h2 id="evreler-tablo">Perimenopoz Evreleri</h2>
        <p>
          Evre adları, hangi soruyu soracağınızı netleştirmek içindir. Sınırlar kişiden kişiye kayar.
          <Evidence level={4} /><sup><a href="#kaynak-1">[1]</a></sup>
        </p>

        <div class="my-8 overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-primary/20 bg-primary/5 text-ink font-serif">
                <th class="p-3 font-semibold">Evre</th>
                <th class="p-3 font-semibold">Adet Düzeni</th>
                <th class="p-3 font-semibold">Hormon Tablosu</th>
                <th class="p-3 font-semibold">Öne Çıkan Belirtiler</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-primary/10">
              <tr>
                <td class="p-3 font-medium">Erken Perimenopoz</td>
                <td class="p-3">Adet aralığında 7 gün veya daha fazla kayma (daha sık ya da daha seyrek).</td>
                <td class="p-3">Östrojen dalgalı, progesteron düşmeye başlar.</td>
                <td class="p-3">Hafif uyku bölünmesi, göğüs hassasiyeti, ruh halinde dalgalanma.</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Geç Perimenopoz</td>
                <td class="p-3">İki adet arası 60 gün veya daha fazla; 1–2 ay adet atlanabilir.</td>
                <td class="p-3">FSH yükselir, östrojen belirgin düşüş eğilimine girer.</td>
                <td class="p-3">Sıcak basması, gece terlemesi, beyin sisi, vajinal kuruluk başlangıcı.</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Menopoz (Tamamlanmış)</td>
                <td class="p-3">Ardışık 12 ay boyunca hiç kanama olmaması.</td>
                <td class="p-3">FSH sürekli yüksek, östrojen düşük seviyede kalıcı.</td>
                <td class="p-3">Son kanamadan geriye dönük netleşir; metabolik ve kemik takibi öne çıkar.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2 id="testler">Kan Testinin Sınırı</h2>
        <p>Belirsizlikte tek bir sayı görmek rahatlatıcı gelir. Perimenopoz o sayıya sığmayan bir dönemdir.</p>
        <p>
          Kırk beş yaş ve üzerindeki sağlıklı kişilerde perimenopoz çoğu zaman laboratuvar testi olmadan tanınır:
          yeni başlayan vazomotor belirtiler ve adet düzeni değişimi yeterlidir. Aynı yaş grubunda estradiol
          (kandaki östrojen), AMH (yumurtalık rezerv göstergesi) ve inhibinler bu tanı için rutin istenmez. Antral
          folikül sayısı da — ultrasonla sayılan küçük yumurta kesecikleri — perimenopoz tanısında rutin değildir.
          FSH (folikül uyarıcı hormon), 40–45 yaş arası belirtili kişilerde ya da 40 yaş altında erken yumurtalık
          yetmezliği şüphesinde daha anlamlıdır.
          <Evidence level={5} /><sup><a href="#kaynak-2">[2]</a></sup>
        </p>
        <p>
          Düzensiz kanama, tiroid bozukluğu, demir eksikliği veya gebelik şüphesi varsa başka testler gerekir.
          Görüşmeye "Hangi konuda netliğe ihtiyacım var?" diye gitmek, hangi testin isteneceğini birlikte
          kararlaştırmayı kolaylaştırır.
        </p>

        <h2 id="izleme-hekim">İzleme, Kayıt ve Hekimle Konuşmak</h2>
        <p>En verimli adım, fark ettiğiniz belirtileri kısa notlara dökmektir.</p>
        <p>
          Adet bölümündeki üç aylık not, seyri görmek içindir. Belirti sizi zorluyorsa takvimin dolmasını
          beklemeyin.
        </p>
        <ul>
          <li>Adet başlangıç ve bitiş tarihini, kanama yoğunluğunu ve beklenmedik ara kanamayı not edin.</li>
          <li>Gece uyanması, sıcak basması ve sabah yorgunluğunu haftalık olarak işaretleyin.</li>
          <li>Ruh hali, odaklanma, baş ağrısı veya migren değişimini birkaç kelimeyle kaydedin.</li>
          <li>Kafein, alkol, geç yemek ve yoğun stres gibi tetikleyiciler için ayrı not düşünün.</li>
        </ul>

        <p>Aşağıdaki durumlarda ertelemeden hekime başvurmanın doğru olduğunu düşünüyorum:</p>
        <ul>
          <li>Kanamanın çok yoğunlaşması, pıhtılı olması ya da günlük hayatı belirgin şekilde bozması.</li>
          <li>Adet arası kanama, ilişki sonrası kanama veya menopozdan sonra yeniden kanama görülmesi.</li>
          <li>40 yaşından önce perimenopoz benzeri belirtilerin başlaması.</li>
          <li>Gece terlemesi, çarpıntı, kilo değişimi veya yorgunluğun tiroid ya da başka bir tabloyu düşündürmesi.</li>
          <li>İki haftadan uzun süren belirgin mutsuzluk hali, yoğun kaygı, panik veya işlev kaybı.</li>
          <li>Uyku bozukluğunun üç ayı aşması ya da gündüz işlevini belirgin şekilde bozması.</li>
          <li>Ani başlayan bilinç bulanıklığı, konuşma bozukluğu veya tek taraflı güçsüzlük.</li>
        </ul>

        <p>
          Bu notlar, o görüşmede birlikte daha net düşünmemiz içindir.
          Görüşmeye gittiğinizde şu üç soruyu yanınızda götürmenizi öneririm:
        </p>
        <ul>
          <li><em>"Bu değişim benim için ne kadar anlamlı — yalnızca dikkatimi mi çekiyor, yoksa günlük hayatımı etkiliyor mu?"</em></li>
          <li><em>"Bu tabloda ayırt edilmesi gereken başka bir neden var mı?"</em></li>
          <li><em>"Şu an için bir şey yapmak gerekiyor mu, yoksa izlemek yeterli mi?"</em></li>
        </ul>
        <p>Net soru, belirsizliği küçültür.</p>
      </ArticleProsePanel>

      <ArticleProsePanel class="mt-10 prose-estranova-references">
        <h2 id="kaynaklar">Kaynaklar</h2>
        <p>
          Bu makaledeki klinik eşikler, evre sınıflandırması ve test kullanım önerileri aşağıdaki kaynaklara
          dayanır. Kaynak taraması: 21 Ekim 2026.
        </p>
        <ol>
          <li id="kaynak-1">
            Harlow SD ve arkadaşları. <a href="https://pubmed.ncbi.nlm.nih.gov/22343510/" rel="noopener noreferrer">Executive summary of the Stages of Reproductive Aging Workshop + 10 (STRAW+10): addressing the unfinished agenda of staging reproductive aging</a>. Menopause. 2012;19(4):387-395.
          </li>
          <li id="kaynak-2">
            National Institute for Health and Care Excellence (NICE). <a href="https://www.nice.org.uk/guidance/ng23/chapter/Recommendations" rel="noopener noreferrer">Menopause: identification and management — NG23</a>. 2015, son güncelleme 15 Nisan 2026.
          </li>
        </ol>
      </ArticleProsePanel>

      <ArticleFAQ
        id="sik-sorulanlar"
        title="Dr. Aksoy'a sorular"
        intro="Yaş, gebelik, sıcak basması, beyin sisi ve hormon tedavisi hakkındaki yanıtlarım."
        items={faqItems}
        class="mt-10"
      />

      <RelatedReadings
        class="mt-14"
        paths={[
          '/zihin-denge/uyku-dinlenme/perimenopoz-uyku-degisen-yan/',
          '/zihin-denge/bilissel-saglik/perimenopozda-zihinsel-bulaniklik/',
          '/hormonal-gecis/menopoz/menopoz-nedir/',
          '/hormonal-gecis/menopoz/sicak-basmasi-gece-terlemesi/',
        ]}
      />

      <ArticleEditorNote>
        <div class="space-y-3 leading-relaxed text-ink/80">
          <p>
            <strong class="text-primary">Tanı ve test:</strong> Kılavuza göre 45 yaş üzerindeki sağlıklı
            kişilerde yeni başlayan vazomotor belirtiler ve adet düzeni değişikliği çoğu zaman klinik tanı için
            yeterlidir. Perimenopoz tanısı için tek bir hormon ölçümüne dayanmak genellikle yanıltıcıdır;
            östrojen ve FSH bu dönemde belirgin dalgalanır. Estradiol, AMH ve antral folikül sayısı 45 yaş
            üzerindeki sağlıklı kişilerde rutin olarak önerilmez. FSH; 40–45 yaş arası belirtili kişilerde veya
            40 yaş altı erken yumurtalık yetmezliği şüphesinde ek bilgi sağlayabilir.
          </p>
          <p>
            <strong class="text-primary">Kanama değişiminin önemi:</strong> STRAW+10 sınıflandırmasına göre adet
            aralığının birden fazla dönem boyunca yedi gün veya daha fazla değişmesi erken geçişi, 60 gün ve üzeri
            aralıklar geç geçişi düşündürebilir. Yoğun, ara, ilişki sonrası veya postmenopozal kanama geçişten
            bağımsız olarak ayrıca değerlendirilmelidir.
          </p>
          <p>
            <strong class="text-primary">Ayırıcı tanı:</strong> Uyku, ruh hali, bilişsel yakınmalar ve vazomotor
            belirtiler perimenopozla ilişkili olabilir; ancak tiroid hastalığı, anemi, gebelik, ilaç etkisi,
            depresyon ve uyku apnesi ayırıcı tanıda akılda tutulmalıdır. Bu yazı genel bilgi niteliğindedir;
            kişisel klinik değerlendirmenin yerini almaz.
          </p>
          <p class="mt-4 border-t border-gold/30 pt-3 text-sm italic text-primary">
            — Dr. Alper Mumcu, Kadın Hastalıkları ve Doğum Uzmanı
          </p>
        </div>
      </ArticleEditorNote>

      <ArticleDisclaimer>
        <p>
          Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme yerine geçmez. Tanı ve tedavi kararları için
          sağlık profesyoneline başvurunuz.
        </p>
      </ArticleDisclaimer>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
