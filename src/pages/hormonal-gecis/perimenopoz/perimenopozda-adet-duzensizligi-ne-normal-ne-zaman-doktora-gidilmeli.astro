---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { resolveSiteUrl } from '../../../utils/seo';

const tocEntries = [
  { id: 'neden-degisir', label: 'Neden Değişir?' },
  { id: 'normal-sayilanlar', label: 'Normal Sayılabilecekler' },
  { id: 'kirmizi-bayraklar', label: 'Kırmızı Bayraklar' },
  { id: 'evde-takip', label: 'Evde Takip Planı' },
  { id: 'doktor-gorusmesi', label: 'Doktor Görüşmesine Hazırlık' },
  { id: 'sakin-kalma', label: 'Sakin Kalmak İçin Notlar' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Perimenopozda Adet Düzensizliği: Ne Normal, Ne Zaman Doktora Gidilmeli?';
const articleDescription =
  'Perimenopozda adet düzenindeki değişimleri, normal kabul edilen durumları, alarm belirtilerini ve doktora ne zaman başvurulması gerektiğini anlatan rehber.';
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'isik-selin-kuyumcu',
  publishedDate: '25 Nisan 2026',
  pathname: '/hormonal-gecis/perimenopoz/perimenopozda-adet-duzensizligi-ne-normal-ne-zaman-doktora-gidilmeli',
  articleSection: 'Hormonal Geçiş',
  sectionPath: '/hormonal-gecis',
  keywords: ['perimenopoz', 'adet düzensizliği', 'kanama', 'menopoz geçişi', 'doktor başvurusu', 'alarm belirtileri'],
  siteUrl,
});
---

<SiteLayout title={`${articleTitle} - Estranova`} description={articleDescription} ogType="article" jsonLd={articleSchemas}>
  <SiteNavbar currentPath="/hormonal-gecis" />

  <main id="main-content" class="pt-24 text-[#2D2D2D]">
    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock authorSlug="isik-selin-kuyumcu" publishedDate="25 Nisan 2026" readingMinutes={5} />

      <header class="mb-10">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">Hormonal Geçiş · Perimenopoz</p>
        <h1 class="font-serif text-4xl leading-tight md:text-6xl">
          Perimenopozda Adet Düzensizliği: Ne Normal, Ne Zaman Doktora Gidilmeli?
        </h1>
      </header>

      <section class="rounded-[28px] border border-[#C9A96E]/35 bg-gradient-to-br from-white to-[#FDF8F0]/90 p-7 shadow-sm ring-1 ring-[#C9A96E]/22 md:p-8">
        <h2 class="mb-4 font-serif text-3xl">Kısa Özet</h2>
        <p class="leading-relaxed text-[#2D2D2D]/80">
          Eğer son aylarda “bedenim eski takvimle çalışmıyor” hissi yaşıyorsan yalnız değilsin. Ben bu dönemi, rotasını bazen
          şaşıran ama aslında yeni mevsime hazırlanan bir iç saat gibi düşünmeyi öğrendim. Çoğu değişim geçişin parçası olabilir;
          yine de aşırı kanama, uzayan kanama, sık ara kanama veya kansızlık belirtileri varsa randevuyu ertelememek gerekir.
          Sakin bir takip defteri, hem zihni toparlıyor hem de doğru zamanda destek almayı kolaylaştırıyor.
        </p>
      </section>

      <ArticleProsePanel>
        <h2 id="neden-degisir">Perimenopozda Adet Neden Değişir?</h2>
        <p>
          Kendi deneyimimde bunu bir orkestra provası gibi yaşadım: bazı günler herkes aynı notayı çalıyor, bazı günler ritim dağılıyor.
          Perimenopoz da biraz böyle; yumurtalıkların hormon üretim temposu dalgalanıyor. Özellikle östrojen ve progesteron iniş-çıkışları,
          adetin bir ay düzenli bir ay dağınık görünmesine neden olabilir <Evidence level={5} />.
        </p>
        <p>
          O yüzden mesele yalnızca “gecikme” değil; kanama miktarı, süresi ve iki kanama arasındaki aralık da değişebilir.
          Benim için en rahatlatıcı farkındalık şu oldu: tek bir “kusursuz normal” yok. Kendi adet düzenindeki tekrarları tanıyınca bedeninle kavga azalıyor,
          neyin beklenebilir neyin değerlendirilmesi gerektiği daha netleşiyor.
        </p>

        <h2 id="normal-sayilanlar">Ne Tür Değişimler Sık ve Normal Sayılabilir?</h2>
        <p>
          Perimenopozda adet aralığının bazen kısalması bazen uzaması sık görülen bir durumdur. Kanamanın bir dönem daha yoğun,
          başka bir dönemde daha hafif olması da bu dalgalı tabloda görülebilir <Evidence level={4} />.
        </p>
        <ul>
          <li><strong>Adet aralığında değişim:</strong> 21-35 gün düzeninin dışına çıkılması</li>
          <li><strong>Kanama süresinde fark:</strong> 2-3 gün süren hafif dönemler veya birkaç gün uzayan dönemler</li>
          <li><strong>Kanama miktarında oynama:</strong> Bazı aylarda daha az, bazı aylarda daha fazla kanama</li>
          <li><strong>Ara sıra atlanan adetler:</strong> Özellikle geç perimenopoz evresinde daha sık görülebilir</li>
        </ul>
        <p>
          Ben bu değişimleri bir “hava durumu” gibi okumayı faydalı buldum: her yağmur fırtına değildir. Asıl belirleyici olan;
          değişimin şiddeti, sürekliliği ve günlük yaşamı ne kadar zorladığıdır.
        </p>

        <h2 id="kirmizi-bayraklar">Hangi Durumlarda Doktora Daha Erken Gitmeliyim?</h2>
        <p>
          Bazı günler iç ses “biraz daha bekle” diyebilir; ama bazı işaretlerde beklemek iyi bir fikir olmayabilir. Aşağıdaki durumlar varsa kadın doğum
          değerlendirmesini geciktirmeyin:
        </p>
        <ul>
          <li><strong>Aşırı kanama:</strong> Saat başı ped/tampon değiştirme ihtiyacı</li>
          <li><strong>Uzun kanama:</strong> 7 günden belirgin uzun süren veya tekrarlayan yoğun dönemler</li>
          <li><strong>Sık ara kanama:</strong> İki adet arasında düzenli şekilde kanama lekelenmesi</li>
          <li><strong>Büyük pıhtılar ve halsizlik:</strong> Baş dönmesi, çarpıntı, nefes darlığı gibi kansızlık bulguları</li>
          <li><strong>Uzun süre adet görmeme sonrası kanama:</strong> Menopoz açısından değerlendirme gerektirebilir</li>
        </ul>
        <p>
          Bu belirtiler perimenopozla ilişkili olabilir; yine de tek açıklama bu olmayabilir. Benim öğrendiğim en kıymetli şey,
          “emin olmayı” ertelememekti. Tiroid düzensizlikleri, polip/miyom gibi yapısal nedenler veya başka jinekolojik durumların
          dışlanması gerekir <Evidence from={4} to={5} />.
        </p>

        <h2 id="evde-takip">Evde Takip Planı: Basit Ama Çok İşe Yarar</h2>
        <p>
          Benim hayatımı kolaylaştıran şey, zihnimde dönen soruları kağıda indirmek oldu. Belirsizliği kayda dönüştürmek,
          “acaba” yükünü hafifletiyor. 2-3 aylık sade bir takip, doktor görüşmesini kolaylaştırır ve gereksiz tekrarları azaltmaya
          yardımcı olabilir.
        </p>
        <ul>
          <li><strong>Tarih kaydı:</strong> Kanamanın başladığı ve bittiği gün</li>
          <li><strong>Yoğunluk notu:</strong> Hafif-orta-yoğun şeklinde kısa sınıflama</li>
          <li><strong>Eşlik eden belirtiler:</strong> Ağrı, baş ağrısı, uyku bölünmesi, ruh hali değişimi</li>
          <li><strong>Günlük etkisi:</strong> İş, sosyal yaşam ve uykuya etkisi</li>
        </ul>
        <p>
          Burada amaç mükemmel kayıt tutmak değil; bedeninin dilini yakalamak. Küçük notlar birikince tablo netleşiyor.
        </p>

        <h2 id="doktor-gorusmesi">Doktor Görüşmesine Giderken Neleri Hazırlayayım?</h2>
        <p>
          Ben randevudan önce kısa bir liste hazırladığımda görüşmenin çok daha verimli geçtiğini fark ettim. Son 2-3 adet kaydı,
          kullandığınız ilaç ve takviyeler, daha önceki jinekolojik işlemler ve aile öyküsü notu değerlendirmeyi netleştirir.
        </p>
        <p>
          Hekim, öyküye göre kan testleri, ultrason veya ek incelemeler isteyebilir. Buradaki amaç “tek bir testle etiket koymak” değil,
          kanama değişiminin güvenli çerçevede yorumlanması ve gerekirse kişisel tedavi planı oluşturmaktır.
        </p>

        <h2 id="sakin-kalma">Bu Süreçte Sakin Kalmak İçin 3 Not</h2>
        <p>
          Birinci not: düzensizlik bu dönemde yaygındır ve tek başına alarm değildir. İkinci not: şiddet ya da süre artıyorsa
          değerlendirmeyi ertelememek gerekir. Üçüncü not: doğru kayıt + doğru zamanlama, süreci çoğu kişi için daha yönetilebilir hale getirir.
        </p>
        <p>
          Ben bunu şöyle özetliyorum: ne her dalga fırtına, ne de her sessizlik güvende olduğumuz anlamına geliyor.
          En güvenli yol; fark etmek, düzenli izlemek ve kırmızı bayraklarda profesyonel desteğe zamanında başvurmak.
        </p>
      </ArticleProsePanel>

      <RelatedReadings
          class="mt-14"
          paths={[
            '/hormonal-gecis/perimenopoz/perimenopoz-nedir',
            '/hormonal-gecis/menopoz/menopoz-nedir',
            '/hormonal-gecis/menopoz/sicak-basmasi-gece-terlemesi',
            '/zihin-denge/duygusal-denge/ruh-hali-degisimleri-menopoz',
          ]}
        />

      <section class="mt-14 rounded-[28px] border border-[#6B2D3E]/15 border-l-[6px] border-l-[#C9A96E] bg-gradient-to-r from-[#F5EDE0] to-[#FDF8F0] p-7 shadow-sm ring-1 ring-[#6B2D3E]/10 md:p-8">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.22em] text-[#6B2D3E]">Bilimsel Editör Notu</p>
        <p class="leading-relaxed text-[#2D2D2D]/80">
          Perimenopozda kanama düzeni değişebilir; ancak yoğunluk, süre ve eşlik eden belirtiler klinik değerlendirme için belirleyicidir.
          Bu rehber tanı koymaz; kişisel öykü, muayene ve gerekli tetkiklerle birlikte hekiminizle değerlendirilmelidir.
        </p>
      </section>

      <section class="mt-10 rounded-[24px] border border-dashed border-[#6B2D3E]/25 bg-white/95 p-6 ring-1 ring-[#6B2D3E]/10">
        <p class="text-sm leading-relaxed text-[#2D2D2D]/75">
          Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavi yerine geçmez. Kişisel sağlık kararlarınız için
          kendi hekim değerlendirmelerinizi esas alın.
        </p>
      </section>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
