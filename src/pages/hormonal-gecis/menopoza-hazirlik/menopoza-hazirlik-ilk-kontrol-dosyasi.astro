---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../../components/site/ArticleFAQ.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { articleFaqs } from '../../../data/article-faqs';
import { resolveSiteUrl } from '../../../utils/seo';

const pathname = '/hormonal-gecis/menopoza-hazirlik/menopoza-hazirlik-ilk-kontrol-dosyasi/';
const hero =
  submenuHeroByRoute[pathname] ?? submenuHeroByRoute['/hormonal-gecis/menopoza-hazirlik/']!;
const articleTitle =
  'Menopoza Hazırlıkta İlk Kontrol Dosyası: Hangi Test Ne Söyler, Hangisi Herkes İçin Gerekli Değildir?';
const seoTitle = 'Menopoza Hazırlık: İlk Kontrol';
const articleDescription =
  'Menopoza yaklaşırken hangi kan tahlilleri ve taramalar anlamlıdır? Bu rehber, sık istenen testleri panik yaratmadan açıklıyor ve sakin bir yol kuruyor.';
const publishedDate = '4 Mayıs 2026';
const modifiedDate = '3 Ekim 2026';
const readingMinutes = 9;

const tocEntries = [
  { id: 'neden-kontrol-dosyasi', label: 'Dağınık sonuçları tek bir dosyada toplamak' },
  { id: 'test-mi-tablo-mu', label: 'Her yakınma için test gerekmez' },
  { id: 'temel-kan-testleri', label: 'Tam kan sayımı, ferritin, B12 ve tiroid' },
  { id: 'fsh-ostrojen', label: 'FSH ve östrojen sonuçları her zaman net cevap verir mi?' },
  { id: 'metabolik-gostergeler', label: 'Kolesterol, glukoz ve metabolik göstergeler' },
  { id: 'kemik-d-vitamini', label: 'Kemik sağlığı ve D vitamini' },
  { id: 'taramalar', label: 'Mamografi, smear ve diğer taramalar' },
  { id: 'kisa-hatirlatma', label: 'Kısa hatırlatma' },
  { id: 'sik-sorulanlar', label: 'Sıkça Sorulanlar' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const faqItems = articleFaqs[pathname] ?? [];
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'estranova-editorial',
  articleType: 'editorial-guide',
  publishedDate,
  modifiedDate,
  pathname,
  articleSection: 'Hormonal Geçiş',
  sectionPath: '/hormonal-gecis/',
  image: hero.src.startsWith('http') ? hero.src : `${siteUrl}${hero.src}`,
  keywords: [
    'menopoza hazırlık',
    'kan tahlili',
    'FSH',
    'B12',
    'ferritin',
    'tiroid',
    'D vitamini',
    'mamografi',
    'smear',
    '40 sonrası sağlık',
  ],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/hormonal-gecis/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Hormonal Geçiş · Menopoza Hazırlık"
      title="Menopoza Hazırlıkta İlk Kontrol Dosyası"
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="estranova-editorial"
        articleType="editorial-guide"
        publishedDate={publishedDate}
        lastUpdated={modifiedDate}
        readingMinutes={readingMinutes}
        imageSrc="/images/library/editorial/hg-tarama-testleri.webp"
        imageAlt="Açık takvim, not defteri ve çay fincanıyla düzenlenmiş masa; menopoza hazırlıkta ilk kontrol dosyası için sakin görsel"
      />

      <ArticleSummary title="Kısa Özet">
        <p>
          Menopoza yaklaşırken uzun test listeleriyle karşılaşmak kolaydır. Ama her belirti hormon geçişinden
          kaynaklanmaz ve her test herkese aynı netliği vermez. İyi bir ilk kontrol dosyası yakınmalarınızın kısa
          özetiyle başlar; benzer belirtileri ayıran temel kan testlerini, metabolik göstergeleri, kemik sağlığını ve
          tarama tarihlerini bir arada tutar. Hangisinin size gerektiği yaşınıza, belirtilerinize ve risk öykünüze göre
          değişir <Evidence level={4} />. Tek bir FSH ya da östrojen sonucu ise bu dönemde her zaman net cevap vermez.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="neden-kontrol-dosyasi">Dağınık sonuçları tek bir dosyada toplamak</h2>
        <p>
          Çekmecede eski tahliller, bir klasörde tarama raporları, telefonun galerisinde iki kahve fotoğrafı arasında
          kaybolmuş bir sonuç: Bu dağınıklık pek çok kadına tanıdık gelir.
        </p>
        <p>
          Menopoza hazırlıkta değişim genellikle küçük işaretlerin birikmesiyle fark edilir; bu yüzden parçaları yan
          yana görmek işe yarar. Kontrol dosyası tam olarak bunun için var. Son kan sonuçlarınız, düzenli taramalar,
          uyku ve enerji notları, aile öykünüz ve sormak istediğiniz sorular tek bir yerde durur.
        </p>
        <p>
          Böylece hekiminiz o günkü yakınmanın yanında son aylara ve yıllara yayılan seyri de görebilir. Siz de kendiniz
          için okunabilir bir zaman çizelgesi kurmuş olursunuz: ne zaman neye bakıldı, ne değişti, ne sabit kaldı. Aynı
          testin gereksiz yere tekrarlanması da çoğu zaman bu çizelgeyle azalır.
        </p>

        <h2 id="test-mi-tablo-mu">Her yakınma için test gerekmez: Önce belirtilerin seyrine bakmak</h2>
        <p>
          Yeni bir belirti fark ettiğinizde aklınıza gelen ilk soru “Hangi tahlili yaptırmalıyım?” olabilir. Daha
          yararlı ilk adım, belirtinin ne zaman başladığına ve nasıl seyrettiğine bakmaktır.
        </p>
        <p>
          Yorgunluk, uyku bölünmesi, sinirlilik, sıcak basması, odaklanma güçlüğü ya da kilo değişimi birlikte
          okunduğunda daha çok şey anlatır. Adet düzeniniz değişti mi? Yakınmalar ne zamandır var, günlük işlerinizi ne
          kadar etkiliyor? Ailenizde benzer bir öykü ya da eşlik eden başka bir sağlık sorununuz var mı? Hangi testin
          anlamlı olacağını da büyük ölçüde bu cevaplar belirler.
        </p>
        <p>
          Testler bu hikâyeyi tamamlar. Yerine geçmez. Bu yüzden test listesinden önce kısa bir belirti özeti ve temel
          sağlık geçmişi hazırlamak iyi bir başlangıçtır.
        </p>

        <h2 id="temel-kan-testleri">Tam kan sayımı, ferritin, B12 ve tiroid: Benzer belirtileri ayırmak</h2>
        <p>
          Öğleden sonra çöken bir ağırlık, merdivende hızlanan kalp atışı, tarakta kalan saçlar: Bunlar ilk anda
          menopozu düşündürebilir.
        </p>
        <p>
          Oysa aynı belirtilerin arkasında başka nedenler de olabilir. Tam kan sayımı, ferritin, B12 ve tiroid
          fonksiyonları özellikle yorgunluk, halsizlik, çarpıntı, saç dökülmesi ve zihinsel bulanıklık gibi
          yakınmalarda bu ayrımı yapmaya yardımcı olabilir <Evidence level={4} />. Demir depolarının azalması, B12
          eksikliği ya da tiroid düzensizlikleri tek başına bile bu belirtilerin bir kısmını açıklayabilir.
        </p>
        <p>
          Yani yaşadığınız her yakınmayı otomatik olarak hormon geçişine bağlamak doğru olmayabilir. Temel kan testleri
          “Menopoz mu, değil mi?” sorusunun ötesine bakar: Bu yorgunluğun başka bir açıklaması var mı?
        </p>

        <h2 id="fsh-ostrojen">FSH ve östrojen sonuçları her zaman net cevap verir mi?</h2>
        <p>
          Hormon testleri kulağa en kesin sonuç gibi gelir. Yüksek bir FSH değeri gördüğünüzde endişelenmeniz bu yüzden
          çok anlaşılır.
        </p>
        <p>
          İçiniz rahat olsun: Bir hormon sonucu kendi başına bir hüküm değildir. Perimenopozda ve
          menopoza hazırlık döneminde hormonlar düz bir çizgide ilerlemez. Bu göstergeler bazı durumlarda fikir
          verebilir; ancak dalgalı seyir nedeniyle tek bir ölçüm her zaman net cevap vermez <Evidence level={4} />.
        </p>
        <p>
          Kanın döngünün hangi gününde alındığı, adet düzeniniz, yaşadığınız belirtiler ve genel sağlık durumunuz hesaba
          katılmadığında sayıların anlamı kolayca abartılabilir. Dosyada hormon sonuçlarının yeri vardır. Ama bu yer
          sınırlıdır.
        </p>

        <h2 id="metabolik-gostergeler">Kolesterol, glukoz ve metabolik göstergeler: Sessiz ama önemli başlık</h2>
        <p>
          Sıcak basması ve adet değişiklikleri kendini hemen belli eder. Kalp-damar ve metabolik sağlık ise bu yıllarda
          daha sessiz biçimde önem kazanır.
        </p>
        <p>
          Bu başlık bazen bir tahlil kâğıdında, değerin yanında beliren küçük bir “yüksek” işaretiyle gündeme gelir.
          Lipid profili, açlık glukozu, HbA1c, bel çevresi ve tansiyon gibi göstergeler zaman içinde birlikte
          okunduğunda daha anlamlı bir risk değerlendirmesi sunar <Evidence level={5} />. Karın çevrenizde değişim,
          enerji dalgalanmaları ya da ailenizde diyabet veya kalp hastalığı öyküsü varsa bu başlıklar daha da öne çıkar.
        </p>
        <p>
          “Ben sadece hormonlarıma baktırmak istemiştim” diye başlayan bir görüşme, kolayca daha geniş bir 40+ sağlık
          sohbetine dönüşebilir. Burada tek bir ölçümden çok, değerlerin yıllar içinde hangi yöne gittiği önemlidir.
        </p>

        <h2 id="kemik-d-vitamini">Kemik sağlığı ve D vitamini: Ağrı başlamadan konuşmak</h2>
        <p>
          Kemik sağlığı genellikle ağrı başlayana kadar bekletilen bir başlıktır. Menopozdan önceki yıllar, bu konuyu
          acele etmeden konuşmak için iyi bir zamandır.
        </p>
        <p>
          D vitamini düzeyi, günlük hareket, direnç egzersizi, beslenmedeki kalsiyum dengesi, ailede osteoporoz öyküsü
          ve varsa daha önce yaşanmış kırıklar birlikte ele alınır <Evidence from={4} to={5} />. Herkes için aynı tarama
          veya aynı ölçüm gerekli değildir; ama risk durumu erkenden netleştiğinde takip daha anlamlı hale gelir.
        </p>
        <p>
          Bu başlığı dosyaya eklemek için hemen test yaptırmanız gerekmez. Ailenizde osteoporoz olup olmadığını ve ne
          sıklıkla direnç egzersizi yaptığınızı bir satıra yazmak bile başlangıçtır.
        </p>

        <h2 id="taramalar">Mamografi, smear ve diğer taramalar: Tarihleri görünür kılmak</h2>
        <p>
          “Son mamografi iki yıl önce miydi, üç mü?” Bu soruyu hafızaya bırakmamak, dosyanın en işe yarar yanlarından
          biridir.
        </p>
        <p>
          Mamografi, smear, jinekolojik kontrol, kolon taraması ya da risk durumunuza göre başka değerlendirmeler; hepsi
          yaşa, aile öyküsüne ve kişisel sağlık durumuna göre planlanır. Herkese uyan tek bir liste yoktur.
        </p>
        <p>
          Ama son taramanın ne zaman yapıldığını ve bir sonraki görüşmede neyi soracağınızı biliyorsanız süreç çok daha
          rahat ilerler.
        </p>

        <h2 id="kisa-hatirlatma">Kısa hatırlatma: İlk adım için üç not</h2>
        <p>
          Sağlık söz konusu olduğunda çok test yaptırmak güven verebilir. Asıl güven ise neye neden bakıldığını bilmekten
          gelir.
        </p>
        <p>
          Gereğinden fazla test bazen netlik yerine gürültü üretir. Sade bir özet, birkaç temel başlık ve iyi sorularla
          kurulmuş bir görüşme çoğu zaman daha yol göstericidir.
        </p>
        <p>
          Nereden başlayacağınızı bilmiyorsanız ilk adım basit. Son sonuçlarınızı bir araya getirin. Tarama tarihlerini
          not edin. Hekiminize sormak istediğiniz üç soruyu yazın. Hazırlığın büyük kısmı bu kadar.
        </p>
      </ArticleProsePanel>

      <ArticleFAQ id="sik-sorulanlar" items={faqItems} class="mt-10" />

      <RelatedReadings
        class="mt-14"
        paths={[
          '/hormonal-gecis/menopoza-hazirlik/koruyucu-saglik-kayitlari/',
          '/hormonal-gecis/perimenopoz/perimenopoz-ilk-isaretler/',
          '/hormonal-gecis/40-sonrasi/tarama-testleri/',
        ]}
      />
      <ArticleEditorNote>
        <p>Menopoza yaklaşan dönemde değerlendirme, yalnızca hormon testlerinden ibaret değildir. Klinik anlam çoğu zaman yakınmaların süresi, adet kalıbı, uyku kalitesi, metabolik riskler ve genel sağlık taramalarının birlikte okunmasıyla ortaya çıkar.</p>
        <p>FSH ve östrojen gibi parametreler bazı durumlarda fikir verebilir; ancak özellikle perimenopozda dalgalı seyir nedeniyle tek başına kesin yanıt sunmaları beklenmemelidir.</p>
        <p>Yorgunluk, çarpıntı, bilişsel bulanıklık veya saç dökülmesi gibi belirtilerde anemi, ferritin düşüklüğü, B12 eksikliği, tiroid düzensizlikleri ve metabolik başlıklar da düşünülmelidir.</p>
        <p>Daha doğru yaklaşım, gereksiz test kalabalığı oluşturmak değil, kişisel risk profiline ve belirtilere göre anlamlı bir izlem planı kurmaktır.</p>
        <p class="text-sm italic text-primary">— Doç. Dr. Senai Aksoy, Estranova Bilimsel Editörü</p>
      </ArticleEditorNote>

      <ArticleDisclaimer class="mt-10">
        <p>Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavinin yerini almaz. Sağlık kararlarınız için kendi hekiminizle birlikte değerlendirme yapınız.</p>
      </ArticleDisclaimer>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
