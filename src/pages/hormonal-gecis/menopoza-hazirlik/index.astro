---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';

const hero = submenuHeroByRoute['/hormonal-gecis/menopoza-hazirlik']!;
---

<SiteLayout
  title="Menopoza Hazırlık - Estranova"
  description="Geçiş döneminde yaşam düzeni, izleme ve koruyucu adımlar hakkında yönlendirici içerikler."
>
  <SiteNavbar currentPath="/hormonal-gecis" />

  <main id="main-content" class="text-[#2D2D2D]">
    <SubmenuHero
      eyebrow="Hormonal Geçiş · Menopoza Hazırlık"
      title="Menopoza Hazırlık"
      lede="Hazırlık; tek bir liste değil, uyku, hareket, beslenme ve düzenli izleme gibi başlıkların birlikte ele alınmasıdır. Aşağıdaki rehberler geçişi daha anlaşılır kılmaya yardımcı olur."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />
    <section class="bg-[#FDF8F0] px-6 py-16 md:py-20">
      <div class="mx-auto max-w-4xl">
        <ul class="space-y-4 text-lg">
          <li>
            <a href="/hormonal-gecis/perimenopoz/perimenopoz-nedir" class="font-semibold text-[#6B2D3E] hover:underline"
              >Perimenopoz Nedir?</a
            >
          </li>
          <li>
            <a href="/hormonal-gecis/menopoz/menopoz-nedir" class="font-semibold text-[#6B2D3E] hover:underline">Menopoz Nedir?</a>
          </li>
          <li>
            <a href="/zamansiz-yasam/hareket-saglik-menopoz" class="font-semibold text-[#6B2D3E] hover:underline"
              >Hareket ve Sağlık (Menopoz Bağlamında)</a
            >
          </li>
          <li>
            <a href="/zamansiz-yasam/beslenme-yaslanma" class="font-semibold text-[#6B2D3E] hover:underline"
              >Beslenme ve Yaşlanma</a
            >
          </li>
          <li>
            <a href="/methodology" class="font-semibold text-[#6B2D3E] hover:underline">Yayın ve Kanıt Yaklaşımımız</a>
          </li>
        </ul>

        <p class="mt-10">
          <a href="/hormonal-gecis" class="font-semibold text-[#6B2D3E] hover:underline">← Hormonal Geçiş ana sayfa</a>
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
