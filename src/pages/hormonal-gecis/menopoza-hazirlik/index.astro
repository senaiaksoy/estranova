---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuSection from '../../../components/site/SubmenuSection.astro';
import EditorPickCard from '../../../components/site/EditorPickCard.astro';
import MagazineTOC from '../../../components/site/MagazineTOC.astro';
import ChapterMasthead from '../../../components/site/ChapterMasthead.astro';
import EditorialEpigraph from '../../../components/site/EditorialEpigraph.astro';
import ChapterCompass from '../../../components/site/ChapterCompass.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { chapterMap, getNextChapter } from '../../../data/chapter-map';
import { subHubEpigraphs } from '../../../data/sub-hub-epigraphs';

const hero = submenuHeroByRoute['/hormonal-gecis/menopoza-hazirlik']!;
const __path = '/hormonal-gecis/menopoza-hazirlik';
const chapter = chapterMap[__path]!;
const epigraph = subHubEpigraphs[__path];
const next = getNextChapter(__path);

const editorPick = {
  href: '/hormonal-gecis/menopoza-hazirlik/menopoza-hazirlik-ilk-kontrol-dosyasi',
  title: 'Menopoza Hazırlıkta İlk Kontrol Dosyası',
  lede: 'Hangi test ne söyler, hangisi herkese aynı netliği vermez? Kontrol dosyasını panik değil çerçeve kurmak için düşünmek üzerine editoryal rehber.',
  writerSlug: 'estranova-editorial',
  readingMinutes: 9,
  image: submenuHeroByRoute['/hormonal-gecis/menopoza-hazirlik/menopoza-hazirlik-ilk-kontrol-dosyasi']!,
};

const tocArticles = [
  {
    href: '/hormonal-gecis/menopoza-hazirlik/koruyucu-saglik-kayitlari',
    title: 'Koruyucu Sağlık Kayıtları',
    excerpt: 'Vital göstergeler, semptom günlüğü ve tarama tarihlerini tek yerde toplamak için daha kişisel bir başlangıç çerçevesi.',
    writerSlug: 'berna-aksoy',
    readingMinutes: 6,
  },
  {
    href: '/zamansiz-yasam/beslenme-yaslanma',
    title: 'Beslenme ve Yaşlanma',
    excerpt: 'Protein, lif, kalsiyum ve mikro besinlerin bu dönemde neden öne çıktığı; hazırlığın beslenme tarafı.',
    writerSlug: 'berna-aksoy',
    readingMinutes: 8,
  },
];

const neighbors = [
  {
    href: '/hormonal-gecis/perimenopoz',
    title: 'Perimenopoz',
    excerpt: 'Geçişin ilk evresi: hormonların dalgalandığı, adet düzeninin değiştiği yıllar.',
  },
  {
    href: '/hormonal-gecis/menopoz',
    title: 'Menopoz',
    excerpt: 'Son adetten sonra tanımlanan dönem ve sık okunan menopoz rehberleri.',
  },
  {
    href: '/hormonal-gecis/40-sonrasi',
    title: '40 Sonrası Sağlık',
    excerpt: 'Koruyucu adımlar, tarama testleri ve uzun vadeli sağlık planlaması.',
  },
];
---

<SiteLayout
  title="Menopoza Hazırlık - Estranova"
  description="Geçiş döneminde yaşam düzeni, izleme ve koruyucu adımlar; uyku, hareket ve beslenme başlıklarını birlikte ele alan rehber bağlantıları."
>
  <SiteNavbar currentPath="/hormonal-gecis" />
  <ChapterMasthead number={chapter.number} parent={chapter.parent} chapter={chapter.chapter} />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Hormonal Geçiş · Menopoza Hazırlık"
      title="Menopoza Hazırlık"
      lede="Hazırlık tek bir liste değil; uyku, hareket, beslenme ve düzenli izleme gibi başlıkların birlikte ele alınmasıdır. Aşağıdaki rehberler bu geçişi daha anlaşılır kılmaya yardımcı olur."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />

    <section class="border-b border-burgundy/10 bg-cream-soft px-6 py-12 md:py-16">
      <div class="mx-auto max-w-6xl">
        <nav class="mb-8 text-sm text-ink/60" aria-label="İçerik yolu">
          <ol class="flex flex-wrap items-center gap-2">
            <li>
              <a href="/hormonal-gecis" class="font-medium text-burgundy hover:underline">Hormonal Geçiş</a>
            </li>
            <li aria-hidden="true">/</li>
            <li class="font-medium text-ink">Menopoza Hazırlık</li>
          </ol>
        </nav>

        <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-start lg:gap-16">
          <div>
            <p class="mb-5 text-lg leading-relaxed text-ink/82 md:text-xl">
              Pek çoğumuz menopozun “bir gün gelip biten” bir olay değil, yıllara yayılan bir geçiş olduğunu fark etmeden
              içine giriyoruz. Hazırlık, bu geçişe sürpriz değil bilgiyle bakmak; günlük hayatın küçük çapalarını
              zamanında kurmak demek.
            </p>
            <p class="text-base leading-relaxed text-ink/72">
              Bu sayfada uyku, hareket ve beslenme gibi günlük yaşam başlıklarına bağlanan rehberleri bulacaksınız.
              Tedavi veya ilaç kararı bu sayfada yer almaz; kişisel değerlendirme her zaman hekiminizle yapılır.
            </p>
          </div>

          <aside
            class="rounded-[28px] border border-burgundy/15 bg-white p-7 shadow-sm md:p-8"
            aria-labelledby="hazirlik-ozet-baslik"
          >
            <h2 id="hazirlik-ozet-baslik" class="mb-4 font-serif text-xl text-ink">Bu evrede sık sorulanlar</h2>
            <ul class="space-y-4 text-sm leading-relaxed text-ink/78">
              <li class="border-b border-burgundy/10 pb-4">
                <span class="block font-semibold text-ink">Hazırlık ne zaman başlar?</span>
                Çoğu kadın için perimenopoz farkındalığıyla, ortalama 40-45 yaş aralığında.
              </li>
              <li class="border-b border-burgundy/10 pb-4">
                <span class="block font-semibold text-ink">Tek bir “menopoz hazırlığı” planı var mı?</span>
                Hayır; kişiye göre değişir. Uyku, hareket, beslenme ve düzenli izlem birlikte değerlendirilir.
              </li>
              <li>
                <span class="block font-semibold text-ink">Hekime ne sıklıkta görünmeli?</span>
                Düzenli yıllık kontrol; belirti şiddetlenirse ara değerlendirme önerilir.
              </li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    {epigraph && <EditorialEpigraph quote={epigraph} />}

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Editör'ün Seçimi</p>
        <h2 class="font-serif text-3xl leading-tight md:text-4xl">Bu evreden bir okuma</h2>
      </header>

      <EditorPickCard
        href={editorPick.href}
        title={editorPick.title}
        lede={editorPick.lede}
        writerSlug={editorPick.writerSlug}
        readingMinutes={editorPick.readingMinutes}
        imageSrc={editorPick.image.src}
        imageAlt={editorPick.image.alt}
      />
    </SubmenuSection>

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Bu Evrede Okumalar</p>
        <h2 class="font-serif text-3xl leading-tight md:text-4xl">Sayının diğer başlıkları</h2>
      </header>

      <MagazineTOC items={tocArticles} />
    </SubmenuSection>

    <SubmenuSection variant="cream" borderedTop={true}>
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Geçişin devamı</p>
      <h2 class="mb-8 font-serif text-2xl md:text-3xl">Komşu evreler</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          neighbors.map((n) => (
            <a
              href={n.href}
              class="group rounded-[26px] border border-burgundy/12 bg-white p-7 transition hover:border-burgundy/28 hover:shadow-sm"
            >
              <h3 class="mb-2 font-serif text-xl text-ink group-hover:text-burgundy">{n.title}</h3>
              <p class="mb-4 text-sm leading-relaxed text-ink/72">{n.excerpt}</p>
              <span class="text-sm font-semibold text-burgundy group-hover:underline">Sayfaya git →</span>
            </a>
          ))
        }
      </div>
    </SubmenuSection>

    <ChapterCompass nextHref={next?.href} nextNumber={next?.number} nextChapter={next?.chapter} nextParent={next?.parent} />
  </main>

  <SiteFooter />
</SiteLayout>
