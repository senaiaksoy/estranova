---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { resolveSiteUrl } from '../../../utils/seo';

const tocEntries = [
  { id: 'neden-kayit', label: 'Neden Bu Evrede Kayıt?' },
  { id: 'vital-gostergeler', label: 'Vital Göstergeler' },
  { id: 'lab-markerlari', label: 'Kan Değerleri Notu' },
  { id: 'semptom-gunlugu', label: 'Semptom Günlüğü' },
  { id: 'aile-oykusu', label: 'Aile Öyküsü' },
  { id: 'tarama-cercevesi', label: 'Tarama Takvimi' },
  { id: 'hekimle-paylasim', label: 'Hekimle Paylaşım' },
  { id: 'baslangic-30-gun', label: 'İlk 30 Gün' },
  { id: 'sik-sorulanlar', label: 'Sık Sorulanlar' },
  { id: 'kapanis', label: 'Kapanış' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Koruyucu Sağlık Kayıtları: Menopoza Hazırlık Döneminde Ne İzlemeli?';
const articleDescription =
  'Menopoza hazırlık döneminde tansiyon, kan değerleri, kilo, aile öyküsü ve semptom notlarını hekime götürülebilecek sade bir kişisel referans dosyasına dönüştürme rehberi.';
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'berna-aksoy',
  publishedDate: '25 Nisan 2026',
  pathname: '/hormonal-gecis/menopoza-hazirlik/koruyucu-saglik-kayitlari',
  articleSection: 'Hormonal Geçiş',
  sectionPath: '/hormonal-gecis',
  keywords: [
    'menopoza hazırlık',
    'koruyucu sağlık',
    'sağlık kayıtları',
    'semptom günlüğü',
    'tarama takvimi',
    'vital göstergeler',
    'aile öyküsü',
  ],
  siteUrl,
});
---

<SiteLayout
  title={`${articleTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/hormonal-gecis" />

  <main id="main-content" class="pt-24 text-ink">
    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock authorSlug="berna-aksoy" publishedDate="25 Nisan 2026" readingMinutes={6} />

      <header class="mb-10">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Hormonal Geçiş · Menopoza Hazırlık</p>
        <h1 class="font-serif text-4xl leading-tight md:text-6xl">{articleTitle}</h1>
      </header>

      <section
        class="rounded-[28px] border border-gold/35 bg-gradient-to-br from-white to-cream-soft/90 p-7 shadow-sm ring-1 ring-gold/22 md:p-8"
      >
        <h2 class="mb-4 font-serif text-3xl">Kısa Özet</h2>
        <p class="leading-relaxed text-ink/80">
          Menopoza hazırlık dönemi bence en değerli aralıklardan biri: kadının bedeninde büyük değişimler
          kapıda olsa da göstergeler hâlâ ölçülebilir. Okudukça şunu anladım — tansiyon, kilo, lipid profili
          gibi temel ölçümleri bugünden düzenli kaydetmek; ileride neyin "yeni" neyin "kişisel normalim"
          olduğunu ayırt etmeyi kolaylaştırıyor. Amaç hastalık aramak değil; kendi referans hattını kurmak.
        </p>
      </section>

      <ArticleProsePanel>
        <h2 id="neden-kayit">Neden Bu Evrede Kayıt?</h2>
        <p>
          Benim için dönüm noktası şu oldu: bir gün hekime gittiğimde, "Geçen yıl ne çıkmıştı, hatırlıyor musunuz?"
          sorusuna ne hekim ne ben net bir cevap verebildik. O an karar verdim, kendi referans dosyamı kurmaya başladım.
        </p>
        <p>
          Çoğu kadın için sağlık kontrolü, bir şikâyet olunca hekime gitmek demek. Oysa menopoza hazırlık
          dönemi farklı bir mantık öneriyor: belirti yokken bile küçük bir kişisel veri seti kurmak. Bu evrede
          bedende olan değişimlerin bir kısmı yıllara yayılı; bazıları kısa sürede beliriyor. "Normal
          sınırının" ne olduğuna dair kendi göstergelerin yoksa, sonradan gelen bir bulguyu yorumlamak
          zorlaşıyor.
        </p>
        <p>
          Tansiyonun hep böyle miydi, kolesterol son iki yılda mı yükseldi, kilo nereden başlayıp nereye geldi —
          bu soruların cevabı geriye dönük baktığında elinde kayıtlar varsa daha sağlam oluyor. Bu nedenle koruyucu
          sağlık kayıtlarını "hastalık dosyası" olarak değil, kişisel bir referans hattı olarak düşünmek bana çok
          yardımcı oldu.
        </p>

        <h2 id="vital-gostergeler">Hangi Vital Göstergeleri İzlemek?</h2>
        <p>
          Evde kolayca takip edebileceğin temel göstergelerle başlıyoruz; klinik olmadan, sade ölçümlerle. Bu kısım
          benim için en eğlenceli olanı oldu — küçük bir disiplin alışkanlığa dönüşünce, gerisi kendiliğinden geliyor.
        </p>
        <p>
          Düzenli tansiyon ölçümü, hazırlık döneminin en değerli alışkanlıklarından biri. Östrojendeki değişimler
          kardiyovasküler riski etkileyen bir tablonun parçası olabilir <Evidence level={4} />; bu nedenle yıllık
          ortalamaların kaydedilmesi ileride bir trend okumayı kolaylaştırıyor. Aynı şekilde kilo, bel çevresi ve
          istirahat nabzı da evde izlenebilen göstergeler arasında.
        </p>
        <p>
          Önemli olan tek bir ölçümün değeri değil; aynı koşullarda alınan ölçümlerin zaman içindeki seyri. Bir
          arkadaşım anlatmıştı: yıllık kontrolüne giderken son altı ayın küçük tansiyon notlarını yanına almış,
          hekimi "iyi ki kayıt etmişsin" demiş. O sahne kafamda kaldı — kâğıt ya da uygulama fark etmiyor,
          sadece tutarlılık önemli. Sabah aç karnına, aynı koldan, oturarak ölçülen tansiyonu haftada bir not
          etmek; üç ay sonra okunabilir bir resim ortaya çıkarıyor.
        </p>

        <h2 id="lab-markerlari">Kan Değerleri İçin Küçük Bir Not Defteri</h2>
        <p>
          Kan değerleri konusunda listeyi benim yazmam doğru olmaz; bunu kişisel sağlık öyküsünü bilen hekimle
          birlikte belirlemek gerekir. Benim burada önerdiğim şey test istemek değil, eldeki sonuçları kaybetmemek.
        </p>
        <p>
          Yıllık kontrolden sonra gelen sonuçları tek bir klasöre koymak bile tabloyu değiştiriyor. Lipid profili,
          glukoz/HbA1c, tiroid, tam kan sayımı, D vitamini, ferritin ya da B12 gibi değerler bazen farklı yıllarda
          farklı hekimlerin önünde açılıyor; o anda "geçen yıl nasıldı?" sorusuna yanıt verebilmek konuşmayı
          hızlandırıyor <Evidence level={4} />.
        </p>
        <p>
          Hormon değerleri konusunda da aynı sakinlik işe yarıyor. FSH veya östradiol gibi sonuçlar tek başına
          "menopoza girdim/girmedim" diye okunmamalı; adet öyküsü ve belirtilerle birlikte yorumlanır. Benim
          dosyamda bu sonuçların görevi karar vermek değil, hekimle konuşurken resmi tamamlamak.
        </p>

        <h2 id="semptom-gunlugu">Semptom Günlüğü Tutmak: Neden ve Nasıl?</h2>
        <p>
          Belirti günlüğü, hazırlık döneminin en çok küçümsenen ama en değerli aracı. Feed'de kaydırırken aynı
          uzmanın aynı cümlesine üçüncü kez denk geldim — algoritma beni benden iyi tanıyor olabilir; ama bu
          tekrarın altındaki cümle gerçekten kayda değerdi: "Adetin değişmeden önce uykunun değiştiğini, ancak
          günlüğüne geri baktığında fark edersin." Aynı sahne çevremdeki birçok kadının da tanıdığı bir sahne.
        </p>
        <p>
          Adet düzeni, sıcak basması sıklığı, uyku kalitesi, ruh hali ve enerji düzeyi gibi başlıkları haftalık kısa
          notlarla kaydetmek; geçişin hangi aşamasında olduğuna dair değerli bir resim çiziyor. Adet düzenindeki
          düzensizleşme, perimenopoz başlangıcının erken ipuçlarından biri <Evidence level={5} /> — ama bunu fark
          etmek ancak takip varsa mümkün oluyor.
        </p>
        <p>
          Günlüğün karmaşık olması gerekmiyor. Telefonun takvim uygulamasında küçük etiketler, kâğıt bir ajanda ya da
          özel bir uygulama; hangisi senin için sürdürülebilirse o doğru araç. Ben kendi adıma dijital bir notu tercih
          ediyorum, bir arkadaşım kâğıt ajandasına yemin ediyor — herkesin kendi tutarlılığı farklı. Önemli olan her
          gün uzun yazmak değil; haftada bir-iki dakika geriye bakmak.
        </p>

        <h2 id="aile-oykusu">Aile Öyküsünü Yazıya Dökmek</h2>
        <p>
          Çoğu kadın aile öyküsünü kafasında bilir; ama bir hekim sorduğunda anlık olarak doğru hatırlamak zor
          olabiliyor. Bunu yıllar önce annemle bir akşam masada oturup yazıya geçirmiştim ve sonradan defalarca
          işime yaradı.
        </p>
        <p>
          Anne, anneanne, babaanne, teyze ve halaların menopoz yaşı; ailede kalp-damar hastalığı, meme veya yumurtalık
          kanseri, osteoporoz ve diyabet öyküsü — bu bilgilerin tek bir notta toplanması ileride hekim
          değerlendirmelerinde belirleyici oluyor. Erken menopoz öyküsü olan ailelerde geçişin daha erken yaşlarda
          başlama eğilimi olabilir <Evidence level={4} />.
        </p>
        <p>
          Bu öyküyü bir kez derli toplu yazmak ve yıllık güncellemek, hekimle yapılan ilk konuşmanın çerçevesini
          zenginleştiriyor. Aile öyküsü, kişisel risk profilinin temel taşlarından biri; ama benim deneyimim şu: yazılı
          bir not, hafıza yardımcısından çok daha fazlası — bir tür hatırlama disiplini.
        </p>

        <h2 id="tarama-cercevesi">Tarama Takvimini Nasıl Konuşmalı?</h2>
        <p>
          Tarama konusu kolayca "hangi testi ne zaman yaptırmalıyım" listesine dönüşebiliyor. Ben bunu kendi adıma
          liste ezberlemek yerine takvim konuşması olarak tutmayı daha sağlıklı buldum.
        </p>
        <p>
          Meme görüntüleme, jinekolojik kontrol, kolon taraması, kemik mineral yoğunluğu ya da kardiyovasküler risk
          değerlendirmesi gibi başlıkların her biri yaşa, aile öyküsüne ve kişisel risklere göre değişiyor. Bu
          yüzden benim dosyamda bu bölümün başlığı "yaptırılacaklar listesi" değil: "hekime sorulacak takvim soruları".
        </p>
        <p>
          Pratikte bir sayfa yetiyor: son mamografi tarihi, son jinekolojik kontrol, varsa kolon taraması, varsa kemik
          yoğunluğu ölçümü, ailede önemli hastalık öyküleri ve "bu yıl hangisi gerekli?" sorusu. Böyle bakınca tarama
          kaygı üreten bir liste olmaktan çıkıp, yıllık görüşmenin sakin gündemi oluyor.
        </p>
      </ArticleProsePanel>

      <ArticleProsePanel class="mt-10">
        <h2 id="hekimle-paylasim">Kayıtları Hekimle Paylaşmak</h2>
        <p>
          Topladığın veri ne kadar düzenli olursa, hekimle yapılan değerlendirme o kadar verimli oluyor. Bunu kendi
          deneyimimde defalarca yaşadım.
        </p>
        <p>
          Yıllık kontrole giderken son bir yılın tansiyon ortalamasını, kilo seyrini, semptom günlüğünden birkaç
          anahtar notu, aile öyküsünün güncel hâlini ve önceki tetkik tarihlerini yanına almak; konuşmayı "şimdi
          neyiniz var" ekseninden çıkarıp "son dönemdeki seyriniz nasıl" eksenine taşıyor. Bu fark, koruyucu sağlık
          yaklaşımının özü.
        </p>
        <p>
          Verilerini bir kâğıda özetlemek ya da telefonda küçük bir not şablonu hazırlamak işi kolaylaştırır.
          Benim için işe yarayan şey, randevudan bir gün önce 10 dakikalık bir özet çıkarmak oldu; detayların tamamını
          anlatmak yerine eğilimleri ve kişisel sorularını paylaşmak, kısa randevuda en çok yer açan yaklaşım. Bu
          benim yöntemim — senin için de çalışıp çalışmayacağını ancak deneyince anlayabilirsin.
        </p>

        <h2 id="baslangic-30-gun">İlk 30 Gün: Pratik Başlangıç</h2>
        <p>
          Bu kadar başlık bir arada gelince "nereden başlamalı" sorusu doğal. Aşağıdaki çerçeve, ilk ay için bana
          işe yaramış sade bir öneri.
        </p>
        <p>
          İlk hafta yalnızca tansiyon ölçümünü düzenli yap, haftalık ortalamayı bir nota geçir. İkinci hafta semptom
          günlüğüne başla; üç-dört kısa kategoriyle sınırlı tut (uyku, enerji, ruh hali, adet). Üçüncü hafta aile
          öyküsünü tek bir nota topla. Dördüncü hafta eski kan sonuçlarını ve tarama tarihlerini aynı dosyada
          birleştir; sonraki kontrolde hekiminle hangi başlıkların gerçekten gerekli olduğunu konuş.
        </p>
        <p>
          Otuz günün sonunda elinde dört şey oluyor: tansiyon eğrisi başlangıcı, semptom referansı, aile öyküsü tek
          sayfa ve önümüzdeki yıl için bir takvim. Bu dört şey, sonraki on yıl boyunca güncellenecek temel iskelet.
          Benim için bu iskelet, "ben bunu kontrol altına aldım" hissinin başlangıcı oldu.
        </p>
      </ArticleProsePanel>

      <ArticleProsePanel class="mt-10">
        <h2 id="sik-sorulanlar">Sık Sorulanlar</h2>
        <h3>Belirtim yok, yine de bu kadar şey takip etmem gerekir mi?</h3>
        <p>
          Belirti olmaması, takip için ideal başlangıç noktasıdır. Çünkü kişisel "normal" aralığını ancak
          belirti yokken tanımlayabilirsin. Sonradan değişiklik olduğunda karşılaştırma yapılacak referans
          noktan oluyor.
        </p>
        <h3>Hangi sıklıkta lab testi yaptırmalıyım?</h3>
        <p>
          Bu sorunun tek cevabı yok; kişisel risk profiline ve önceki sonuçlara göre değişir. Benim önerim,
          "şu testi şu sıklıkta yaptır" diye ezberlemek yerine eski sonuçlarını yanında götürüp sıklığı hekiminle
          birlikte belirlemek.
        </p>
        <h3>Ev tipi tansiyon aleti güvenilir mi?</h3>
        <p>
          Üst koldan ölçen, klinik onayı olan modeller güvenilir bir takip sağlar. Bilek tipi cihazlar daha
          fazla değişkenlik gösterebilir. Cihazını ilk kullanımda hekim muayenesinde karşılaştırarak
          doğrulamak iyi bir başlangıç adımı.
        </p>
        <h3>Semptom günlüğüne ne kadar zaman ayırmalıyım?</h3>
        <p>
          Günde bir-iki dakika ve haftada bir kez geriye bakış yeterli. Detaylı yazmak yerine kategoriler ve
          kısa işaretler kullanmak sürdürülebilirliği artırıyor.
        </p>

        <h2 id="kapanis">Kapanış</h2>
        <p>
          Koruyucu sağlık kayıtları bir hastalık dosyası değil; bedenin yıllar içinde takip edebileceğin sade
          bir takvimi.
        </p>
        <p>
          Tek bir ölçüm bir günlük resim verir; aynı ölçümün üç yıllık seyri ise bir hikâye. Yıllık tansiyon
          ortalaması, kan değerleri klasörü, semptom günlüğü ve aile öyküsü — bu dört çapayı bir takvime yerleştirmek,
          "her şeyi takip edemem" kaygısının yerine sade bir ritim koyuyor. Bu benim yolum oldu, yıllar içinde
          olgunlaşarak; senin yolun başka olabilir — ve olmalı da.
        </p>
        <p>
          Belki şu soru yardımcı olur: bu yıl takvime hangi tek göstergeyi yargılamadan, sadece gözlemlemek
          niyetiyle yerleştirebilirim? Karar kendi kararın, sorumluluğu da kendine ait. Beden bir cümle
          söylemişti; sen onu kendi takvimine yazıyorsun.
        </p>
      </ArticleProsePanel>

      <RelatedReadings
          class="mt-14"
          paths={[
            '/hormonal-gecis/40-sonrasi/tarama-testleri',
            '/hormonal-gecis/menopoz/menopoz-nedir',
            '/zamansiz-yasam/beslenme-yaslanma',
          ]}
        />

      <section
        class="mt-14 rounded-[28px] border border-burgundy/15 border-l-[6px] border-l-gold bg-gradient-to-r from-cream-warm to-cream-soft p-7 shadow-sm ring-1 ring-burgundy/10 md:p-8"
      >
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.22em] text-burgundy">Bilimsel Editör Notu</p>
        <p class="mb-3 leading-relaxed text-ink/80">
          Menopoza hazırlık dönemi (perimenopoz öncesi 40+ yaşları), koruyucu sağlık çerçevesinin sistematik
          biçimde kurulması için klinik açıdan değerli bir aralıktır. Bu yazının ana önerisi test istemek değil;
          mevcut ölçüm, belirti ve aile öyküsü bilgilerinin düzenli tutulmasıdır.
        </p>
        <p class="mb-3 leading-relaxed text-ink/80">
          Hangi kan değerlerinin ve hangi taramaların izleneceği kişisel risk profiline göre değişir. Kan basıncı,
          kilo-bel çevresi, metabolik göstergeler, tiroid, tam kan sayımı, D vitamini, ferritin/B12 gibi başlıklar
          klinikte sık konuşulabilir; ancak bu liste kişiye özel olarak hekim tarafından düzenlenmelidir.
        </p>
        <p class="mb-3 leading-relaxed text-ink/80">
          Tek bir ölçüm değerinden çok, aynı koşullarda alınan ölçümlerin zaman içindeki seyri (eğri) klinik
          olarak bilgilendiricidir. Vital göstergelerin yıllık ortalamalarının ve lab değerlerinin
          longitudinal trendlerinin izlenmesi, bireysel kardiyovasküler ve metabolik risk profilinin daha
          erken fark edilmesini sağlar.
        </p>
        <p class="mb-3 leading-relaxed text-ink/80">
          Ölçüm sıklığı, izlenecek parametre seti ve tarama testleri bireyin yaşı, aile öyküsü, mevcut sağlık
          durumu ve ulusal rehberlere göre kişiselleştirilmelidir. Bu yazıdaki çerçeve kişisel kayıt düzeni
          içindir; kişisel ölçüm, tarama ve değerlendirme planı her zaman hekimle birlikte oluşturulur.
        </p>
        <p class="text-sm italic text-burgundy">
          — Doç. Dr. Senai Aksoy, Estranova Bilimsel Editörü
        </p>
      </section>

      <section class="mt-10 rounded-[24px] border border-dashed border-burgundy/25 bg-white/95 p-6 ring-1 ring-burgundy/10">
        <p class="text-sm leading-relaxed text-ink/75">
          Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavinin yerini almaz. Sağlık
          kararlarınız için kendi hekiminizle birlikte değerlendirme yapınız.
        </p>
      </section>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
