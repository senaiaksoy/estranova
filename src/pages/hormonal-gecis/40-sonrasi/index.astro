---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuSection from '../../../components/site/SubmenuSection.astro';
import SubmenuLinkCard from '../../../components/site/SubmenuLinkCard.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';

const hero = submenuHeroByRoute['/hormonal-gecis/40-sonrasi']!;

const articles = [
  {
    href: '/hormonal-gecis/40-sonrasi/tarama-testleri',
    title: 'Tarama ve İzlem: Genel Çerçeve',
    excerpt:
      '40 sonrası dönemde hangi taramaların ne sıklıkta önemli olduğu, kişisel risk profiline göre nasıl planlanabileceği üzerine bütüncül bir bakış.',
    image: submenuHeroByRoute['/hormonal-gecis/40-sonrasi/tarama-testleri']!,
  },
  {
    href: '/hormonal-gecis/menopoz/menopozda-kemik-erimesi-onleme-ve-egzersiz',
    title: 'Kemik Erimesi: Önleme ve Egzersiz',
    excerpt:
      'Menopoz sonrası kemik kaybını yavaşlatan günlük direnç çalışmaları, beslenme ve izleme başlıklarını birlikte ele alan rehber.',
    image: submenuHeroByRoute['/hormonal-gecis/menopoz/menopozda-kemik-erimesi-onleme-ve-egzersiz']!,
  },
  {
    href: '/zamansiz-yasam/kemik-sagligi-40-sonrasi',
    title: '40 Yaşından Sonra Kemik Sağlığı',
    excerpt:
      'D vitamini, kalsiyum, hareket ve düzenli izlem; kemik sağlığını uzun vadede korumak için günlük çerçeveler.',
    image: {
      src: '/images/library/editorial/journey-40-sonrasi.webp',
      alt: 'Sonbahar ormanında sakin yürüyen kadın; uzun vadeli sağlık ve hareket teması',
    },
  },
];

const neighbors = [
  {
    href: '/hormonal-gecis/perimenopoz',
    title: 'Perimenopoz',
    excerpt: 'Geçişin ilk evresi: hormonların dalgalandığı, adet düzeninin değiştiği yıllar.',
  },
  {
    href: '/hormonal-gecis/menopoza-hazirlik',
    title: 'Menopoza Hazırlık',
    excerpt: 'Uyku, hareket ve beslenme başlıklarını birlikte düşünmek için hazırlık çerçevesi.',
  },
  {
    href: '/hormonal-gecis/menopoz',
    title: 'Menopoz',
    excerpt: 'Son adetten sonra tanımlanan dönem ve sık okunan menopoz rehberleri.',
  },
];
---

<SiteLayout
  title="40 Sonrası Sağlık - Estranova"
  description="Koruyucu sağlık, tarama testleri ve uzun dönem iyi olma hali için hormonal geçiş sonrası rehber bağlantıları."
>
  <SiteNavbar currentPath="/hormonal-gecis" />

  <main id="main-content" class="text-[#2D2D2D]">
    <SubmenuHero
      eyebrow="Hormonal Geçiş · 40 Sonrası"
      title="40 Sonrası Sağlık"
      lede="Bu evrede koruyucu adımlar, düzenli izleme ve yaşam tarzı seçimleri uzun vadeli sağlık için destekleyici olabilir. Kişisel risk profili her zaman hekiminizle değerlendirilmelidir."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />

    <section class="border-b border-[#6B2D3E]/10 bg-[#FDF8F0] px-6 py-12 md:py-16">
      <div class="mx-auto max-w-6xl">
        <nav class="mb-8 text-sm text-[#2D2D2D]/60" aria-label="İçerik yolu">
          <ol class="flex flex-wrap items-center gap-2">
            <li>
              <a href="/hormonal-gecis" class="font-medium text-[#6B2D3E] hover:underline">Hormonal Geçiş</a>
            </li>
            <li aria-hidden="true">/</li>
            <li class="font-medium text-[#2D2D2D]">40 Sonrası Sağlık</li>
          </ol>
        </nav>

        <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-start lg:gap-16">
          <div>
            <p class="mb-5 text-lg leading-relaxed text-[#2D2D2D]/82 md:text-xl">
              40 sonrası bizim için yalnızca yaş değil; vücudumuzu daha iyi tanıdığımız, küçük sinyalleri daha çabuk
              fark ettiğimiz bir dönem. Burada amaç tek bir “çözüm listesi” değil; uzun vadeli sağlığın günlük
              alışkanlıklarla nasıl korunabileceğine sakin bir çerçeve sunmak.
            </p>
            <p class="text-base leading-relaxed text-[#2D2D2D]/72">
              Aşağıda tarama ve izlem, kemik sağlığı ve uzun dönem iyi oluşa dair seçilmiş rehberleri bulacaksınız.
              Bireysel değerlendirme ve risk profili her zaman hekiminizle birlikte yapılır.
            </p>
          </div>

          <aside
            class="rounded-[28px] border border-[#6B2D3E]/15 bg-white p-7 shadow-sm md:p-8"
            aria-labelledby="kirk-sonrasi-ozet-baslik"
          >
            <h2 id="kirk-sonrasi-ozet-baslik" class="mb-4 font-serif text-xl text-[#2D2D2D]">Bu evrede sık sorulanlar</h2>
            <ul class="space-y-4 text-sm leading-relaxed text-[#2D2D2D]/78">
              <li class="border-b border-[#6B2D3E]/10 pb-4">
                <span class="block font-semibold text-[#2D2D2D]">Bu dönemde hangi taramalar önemli?</span>
                Meme, kolon, kemik yoğunluğu ve kalp sağlığı; risk profiline göre planlanır.
              </li>
              <li class="border-b border-[#6B2D3E]/10 pb-4">
                <span class="block font-semibold text-[#2D2D2D]">Belirtisiz olsam da kontrole gitmeli miyim?</span>
                Evet; koruyucu sağlık temel ilkedir, düzenli izlem yıllık çerçevede önerilir.
              </li>
              <li>
                <span class="block font-semibold text-[#2D2D2D]">Kemik sağlığını korumak için günlük ne yapabilirim?</span>
                Direnç çalışması, D vitamini–kalsiyum dengesi ve yeterli protein temel başlıklardır.
              </li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">İçerikler</p>
        <h2 class="mb-4 font-serif text-3xl leading-tight md:text-4xl">40 sonrası seçilmiş rehberler</h2>
        <p class="text-lg leading-relaxed text-[#2D2D2D]/75">
          Tarama planlaması, kemik sağlığı ve günlük koruyucu adımlar; bu evrede sık karşılaşılan başlıklar üzerine
          yapılandırılmış okumalar.
        </p>
      </header>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          articles.map((a) => (
            <SubmenuLinkCard
              href={a.href}
              title={a.title}
              excerpt={a.excerpt}
              imageSrc={a.image.src}
              imageAlt={a.image.alt}
              cta="Rehberi oku"
            />
          ))
        }
      </div>
    </SubmenuSection>

    <SubmenuSection variant="cream" borderedTop={true}>
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">Geçişin önceki adımları</p>
      <h2 class="mb-8 font-serif text-2xl md:text-3xl">Komşu evreler</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          neighbors.map((n) => (
            <a
              href={n.href}
              class="group rounded-[26px] border border-[#6B2D3E]/12 bg-white p-7 transition hover:border-[#6B2D3E]/28 hover:shadow-sm"
            >
              <h3 class="mb-2 font-serif text-xl text-[#2D2D2D] group-hover:text-[#6B2D3E]">{n.title}</h3>
              <p class="mb-4 text-sm leading-relaxed text-[#2D2D2D]/72">{n.excerpt}</p>
              <span class="text-sm font-semibold text-[#6B2D3E] group-hover:underline">Sayfaya git →</span>
            </a>
          ))
        }
      </div>
    </SubmenuSection>

    <section class="bg-white px-6 py-10">
      <div class="mx-auto max-w-4xl rounded-[20px] border border-[#6B2D3E]/12 p-6 text-center">
        <p class="text-sm leading-relaxed text-[#2D2D2D]/75">
          Bu sayfa genel bilgilendirme sunar; belirtileriniz için bireysel tıbbi değerlendirme, tanı veya tedavi yerine geçmez.
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
