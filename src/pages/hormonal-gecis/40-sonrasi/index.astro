---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuSection from '../../../components/site/SubmenuSection.astro';
import ChapterMasthead from '../../../components/site/ChapterMasthead.astro';
import EditorialEpigraph from '../../../components/site/EditorialEpigraph.astro';
import ChapterCompass from '../../../components/site/ChapterCompass.astro';
import EditorPickCard from '../../../components/site/EditorPickCard.astro';
import MagazineTOC from '../../../components/site/MagazineTOC.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { chapterMap, getNextChapter } from '../../../data/chapter-map';
import { subHubEpigraphs } from '../../../data/sub-hub-epigraphs';

const __path = '/hormonal-gecis/40-sonrasi';
const hero = submenuHeroByRoute[__path]!;
const chapter = chapterMap[__path]!;
const epigraph = subHubEpigraphs[__path];
const next = getNextChapter(__path);

interface ArticleEntry {
  href: string;
  title: string;
  excerpt: string;
  lede: string;
  writerSlug: string;
  readingMinutes: number;
  image: { src: string; alt: string };
}

const articles: ArticleEntry[] = [
  {
    href: '/hormonal-gecis/40-sonrasi/tarama-testleri',
    title: 'Tarama ve İzlem: Başlangıç Rehberi',
    excerpt:
      '40 sonrası koruyucu sağlıkta tarama, izlem ve bireysel risk değerlendirmesi için sakin bir başlangıç.',
    lede: 'Koruyucu sağlık, tek bir listeyi ezberlemekten çok, hangi soruları hekiminizle ne zaman konuşacağınızı bilmekle başlar.',
    writerSlug: 'senai-aksoy',
    readingMinutes: 6,
    image: submenuHeroByRoute['/hormonal-gecis/40-sonrasi/tarama-testleri']!,
  },
];

const featuredSlug = '/hormonal-gecis/40-sonrasi/tarama-testleri';
const editorPick = articles.find((a) => a.href === featuredSlug)!;
const tocArticles = articles.filter((a) => a.href !== featuredSlug);

const neighbors = [
  {
    href: '/hormonal-gecis/menopoza-hazirlik',
    title: 'Menopoza Hazırlık',
    excerpt: 'Uyku, hareket ve beslenme başlıklarını birlikte düşünmek için hazırlık notu.',
  },
  {
    href: '/hormonal-gecis/menopoz',
    title: 'Menopoz',
    excerpt: 'Tanım, belirtiler, hormon tedavisi kararı ve uzun vadeli sağlık gündemi.',
  },
  {
    href: '/zamansiz-yasam/vitaminler',
    title: 'Zamansız Yaşam · Vitaminler',
    excerpt: 'D vitamini, B12 ve takviye kararlarını kanıt ve klinik değerlendirme diliyle okumak için.',
  },
];
---

<SiteLayout
  title="40 Sonrası Sağlık - Estranova"
  description="40 sonrası koruyucu sağlık, tarama takvimi, ağız-diş sağlığı ve uzun vadeli planlama başlıklarını hormonal geçiş zemininde toplayan rehber."
>
  <SiteNavbar currentPath="/hormonal-gecis" />
  <ChapterMasthead number={chapter.number} parent={chapter.parent} chapter={chapter.chapter} />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Hormonal Geçiş · 40 Sonrası Sağlık"
      title="40 Sonrası Sağlık"
      lede="Kırktan sonra sağlık yalnızca belirti çıktığında bakılan bir alan değil; tarama takvimi, ağız-diş sağlığı, kemik, metabolizma ve günlük ritmin birlikte izlendiği uzun vadeli bir sağlık hattıdır."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />

    <section class="border-b border-burgundy/10 bg-cream-soft px-6 py-12 md:py-16">
      <div class="mx-auto max-w-6xl">
        <nav class="mb-8 text-sm text-ink/60" aria-label="İçerik yolu">
          <ol class="flex flex-wrap items-center gap-2">
            <li>
              <a href="/hormonal-gecis" class="font-medium text-burgundy hover:underline">Hormonal Geçiş</a>
            </li>
            <li aria-hidden="true">/</li>
            <li class="font-medium text-ink">40 Sonrası Sağlık</li>
          </ol>
        </nav>

        <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-start lg:gap-16">
          <div>
            <p class="mb-5 text-lg leading-relaxed text-ink/82 md:text-xl">
              40 sonrası sağlık, tek bir kontrol listesine indirgenemeyecek kadar kişiseldir. Aile öyküsü,
              önceki tanılar, kullanılan ilaçlar, yaşam biçimi ve hormonal geçişin seyri aynı masada
              değerlendirilir.
            </p>
            <p class="text-base leading-relaxed text-ink/72">
              Bu bölüm; tarama ve izlem dilini sadeleştirmek, ağız-diş sağlığı gibi bazen kenarda kalan
              başlıkları görünür kılmak ve okurun hekimiyle daha hazırlıklı konuşmasına yardım etmek için
              tasarlandı.
            </p>
          </div>

          <aside
            class="rounded-[28px] border border-burgundy/15 bg-white p-7 shadow-sm md:p-8"
            aria-labelledby="kirk-sonrasi-ozet-baslik"
          >
            <h2 id="kirk-sonrasi-ozet-baslik" class="mb-4 font-serif text-xl text-ink">Bu bölümde ne var?</h2>
            <ul class="space-y-4 text-sm leading-relaxed text-ink/78">
              <li class="border-b border-burgundy/10 pb-4">
                <span class="block font-semibold text-ink">Tarama ne zaman konuşulur?</span>
                Yaş, risk profili ve aile öyküsüne göre hekiminizle kişisel bir izlem planı kurulur.
              </li>
              <li class="border-b border-burgundy/10 pb-4">
                <span class="block font-semibold text-ink">Hangi alanlar birlikte düşünülür?</span>
          Kemik, metabolizma, kalp-damar riski, meme/kolon taramaları ve jinekolojik izlem aynı hatta ele alınır.
              </li>
              <li>
                <span class="block font-semibold text-ink">Ağız-diş sağlığı neden burada?</span>
                Menopoz sonrası doku, kemik ve bakım rutinleri ağız sağlığını da etkileyebilir.
              </li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    {epigraph && <EditorialEpigraph quote={epigraph} />}

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Editör'ün Seçimi</p>
        <h2 class="font-serif text-3xl leading-tight md:text-4xl">Bu bölümden bir başlangıç</h2>
      </header>

      <EditorPickCard
        href={editorPick.href}
        title={editorPick.title}
        lede={editorPick.lede}
        writerSlug={editorPick.writerSlug}
        readingMinutes={editorPick.readingMinutes}
        imageSrc={editorPick.image.src}
        imageAlt={editorPick.image.alt}
        eyebrow="Koruyucu Sağlık"
      />
    </SubmenuSection>

    <SubmenuSection variant="cream" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Bu Bölümde Okumalar</p>
        <h2 class="font-serif text-3xl leading-tight md:text-4xl">40 sonrası başlıkları</h2>
      </header>

      <MagazineTOC items={tocArticles} />
    </SubmenuSection>

    <SubmenuSection variant="cream" borderedTop={true}>
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Geçişin devamı</p>
      <h2 class="mb-8 font-serif text-2xl md:text-3xl">Komşu bölümler</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          neighbors.map((n) => (
            <a
              href={n.href}
              class="group rounded-[26px] border border-burgundy/12 bg-white p-7 transition hover:border-burgundy/28 hover:shadow-sm"
            >
              <h3 class="mb-2 font-serif text-xl text-ink group-hover:text-burgundy">{n.title}</h3>
              <p class="mb-4 text-sm leading-relaxed text-ink/72">{n.excerpt}</p>
              <span class="text-sm font-semibold text-burgundy group-hover:underline">Sayfaya git →</span>
            </a>
          ))
        }
      </div>
    </SubmenuSection>

    <ChapterCompass nextHref={next?.href} nextNumber={next?.number} nextChapter={next?.chapter} nextParent={next?.parent} />
  </main>

  <SiteFooter />
</SiteLayout>
