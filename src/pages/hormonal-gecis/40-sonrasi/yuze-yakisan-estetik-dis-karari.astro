---

<SiteLayout title={`${articleTitle} - Estranova`} description={articleDescription}
  image="/images/library/editorial/duygu-karaosmanoglu-yuze-yakisan-byline.webp"
  ogType="article" jsonLd={articleSchemas}>
  <SiteNavbar currentPath="/hormonal-gecis/" />
