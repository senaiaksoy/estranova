const pathname = '/hormonal-gecis/40-sonrasi/yuze-yakisan-estetik-dis-karari/';
const faqItems = articleFaqs[pathname] ?? [];
const sources = [
  { label: 'Menopoz sonrası osteoporoz ve dişeti hastalığı ilişkisi: sistematik derleme ve meta-analiz (2023).', href: 'https://pubmed.ncbi.nlm.nih.gov/37920517/' },
  { label: 'Diş beyazlatma: mekanizma, değerlendirme ve yan etkiler — American Dental Association.', href: 'https://www.ada.org/resources/ada-library/oral-health-topics/whitening' },
  { label: 'Kompozit bonding: mine korunması, bakım ve sınırlar — Cleveland Clinic.', href: 'https://my.clevelandclinic.org/health/treatments/10922-dental-bonding' },
  { label: 'Mine konturu (enameloplasti): işlem ve geri dönüşsüz mine kaybı — Cleveland Clinic.', href: 'https://my.clevelandclinic.org/health/procedures/enameloplasty' },
  { label: 'Laminat kaplamalar: hazırlık, uygunluk ve bakım — American Dental Association.', href: 'https://www.mouthhealthy.org/all-topics-a-z/veneers' },
  { label: 'Porselen laminatların uzun dönem dayanıklılığı ve komplikasyonları: sistematik derleme (2021).', href: 'https://pubmed.ncbi.nlm.nih.gov/33807504/' },
  { label: 'Şeffaf plak tedavisi: endikasyonlar ve sınırlar — uluslararası Delphi uzlaşı çalışması.', href: 'https://www.ncbi.nlm.nih.gov/pmc/articles/PMC12321729/' },
  { label: 'Yüz ölçüleri ve üst santral kesici formu arasındaki ilişki: iki boyutlu radyografi ve model çalışması (2014).', href: 'https://doaj.org/article/e1f85bfa496e4d43bee3d92e8364756c' },
  { label: 'Osteoporoz ilaçları ve ilaca bağlı çene kemiği osteonekrozu — American Dental Association.', href: 'https://www.ada.org/resources/ada-library/oral-health-topics/osteoporosis-medications' },
