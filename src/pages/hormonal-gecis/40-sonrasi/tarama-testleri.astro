---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';

const hero = submenuHeroByRoute['/hormonal-gecis/40-sonrasi/tarama-testleri']!;
---

<SiteLayout
  title="Tarama ve İzlem: Başlangıç Rehberi - Estranova"
  description="40 sonrası dönemde koruyucu sağlık ve tarama kavramını editoryal bir bakışla özetleyen bilgilendirici sayfa."
>
  <SiteNavbar currentPath="/hormonal-gecis" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Hormonal Geçiş · 40 Sonrası"
      title="Tarama ve İzlem: Başlangıç Rehberi"
      lede="Bilgilendirme amaçlıdır; kişisel tarama planı hekiminizle belirlenir."
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <SubmenuArticleBody>
        <ArticleProsePanel>
          <p>
            Koruyucu sağlıkta “tarama”, belirti olmadan belirli riskleri erken dönemde değerlendirmeyi ifade eder. Hangi testin
            ne sıklıkla yapılacağı; yaş, aile öyküsü, eşlik eden hastalıklar ve kullandığınız ilaçlara göre değişir. Tek bir
            liste herkes için geçerli değildir.
          </p>
          <p>
            Menopozal geçiş döneminde kemik sağlığı, kalp-damar riskleri, metabolik göstergeler ve jinekolojik izlem sık
            birlikte konuşulur. Bu başlıkların her biri ayrı ayrı hekimlik değerlendirmesi ve gerektiğinde yönlendirme gerektirir.
          </p>
          <p>
            Estranova’da amaç size “ne sorulabileceği” ve “hangi gözle düşünülebileceği” konusunda sade bir başlangıç sunmaktır.
            Son karar her zaman bireysel klinik değerlendirmeye aittir.
          </p>
        </ArticleProsePanel>

        <RelatedReadings
          class="mt-14"
          paths={[
            '/zamansiz-yasam/kemik-sagligi-40-sonrasi',
            '/hormonal-gecis/40-sonrasi',
          ]}
        />

         <ArticleDisclaimer>
<p>
            Bu içerik yalnızca genel bilgilendirme amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavinin yerini almaz.
          </p>
      </ArticleDisclaimer>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
