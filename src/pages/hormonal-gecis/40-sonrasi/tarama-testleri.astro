---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';

const hero = submenuHeroByRoute['/hormonal-gecis/40-sonrasi/tarama-testleri']!;
---

<SiteLayout
  title="Tarama ve İzlem: Genel Çerçeve - Estranova"
  description="40 sonrası dönemde koruyucu sağlık ve tarama kavramını editoryal bir çerçevede özetleyen bilgilendirici sayfa."
>
  <SiteNavbar currentPath="/hormonal-gecis" />

  <main id="main-content" class="text-[#2D2D2D]">
    <SubmenuHero
      eyebrow="Hormonal Geçiş · 40 Sonrası"
      title="Tarama ve İzlem: Genel Çerçeve"
      lede="Bilgilendirme amaçlıdır; kişisel tarama planı hekiminizle belirlenir."
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <article class="px-6 py-16 md:py-20">
      <div class="mx-auto max-w-4xl">
        <div class="prose prose-lg max-w-none prose-headings:font-serif prose-headings:text-[#2D2D2D] prose-p:text-[#2D2D2D]/80">
          <p>
            Koruyucu sağlıkta “tarama”, belirti olmadan belirli riskleri erken dönemde değerlendirmeyi ifade eder. Hangi testin
            ne sıklıkla yapılacağı; yaş, aile öyküsü, eşlik eden hastalıklar ve kullandığınız ilaçlara göre değişir. Tek bir
            liste herkes için geçerli değildir.
          </p>
          <p>
            Menopozal geçiş döneminde kemik sağlığı, kalp-damar riskleri, metabolik göstergeler ve jinekolojik izlem sık
            birlikte konuşulur. Bu başlıkların her biri ayrı ayrı hekimlik değerlendirmesi ve gerektiğinde yönlendirme gerektirir.
          </p>
          <p>
            Estranova’da amaç size “ne sorulabileceği” ve “hangi çerçevede düşünülebileceği” konusunda sade bir başlangıç sunmaktır.
            Son karar her zaman bireysel klinik değerlendirmeye aittir.
          </p>
        </div>

        <section class="mt-12 rounded-[28px] border border-[#6B2D3E]/12 bg-[#FDF8F0] p-7 md:p-8">
          <h2 class="mb-4 font-serif text-2xl">İlgili İçerikler</h2>
          <ul class="space-y-3 text-lg">
            <li>
              <a href="/zamansiz-yasam/kemik-sagligi-40-sonrasi" class="font-semibold text-[#6B2D3E] hover:underline"
                >40 Yaşından Sonra Kemik Sağlığı</a
              >
            </li>
            <li>
              <a href="/article/menopoz-kalp-sagligi" class="font-semibold text-[#6B2D3E] hover:underline">Menopoz ve Kalp Sağlığı</a>
            </li>
            <li>
              <a href="/hormonal-gecis/40-sonrasi" class="font-semibold text-[#6B2D3E] hover:underline">40 Sonrası bölüm özeti</a>
            </li>
          </ul>
        </section>

        <section class="mt-10 rounded-[20px] border border-[#6B2D3E]/12 bg-white p-6">
          <p class="text-sm leading-relaxed text-[#2D2D2D]/75">
            Bu içerik yalnızca genel bilgilendirme amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavinin yerini almaz.
          </p>
        </section>
      </div>
    </article>
  </main>

  <SiteFooter />
</SiteLayout>
