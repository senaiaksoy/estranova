---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import RedFlagBox from '../../../components/site/RedFlagBox.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { resolveSiteUrl } from '../../../utils/seo';

const hero = submenuHeroByRoute['/hormonal-gecis/40-sonrasi/tarama-testleri/']!;
const tocEntries = [
  { id: 'tarama-ne-demek', label: 'Tarama Ne Demek?' },
  { id: 'temel-bes-baslik', label: '40 Sonrası Takvim' },
  { id: 'kadina-ozgu-izlem', label: 'Meme, Rahim Ağzı, Kalın Bağırsak' },
  { id: 'kemik-yogunlugu', label: 'Kemik Ölçümü' },
  { id: 'metabolik-izlem', label: 'Kan Testleri' },
  { id: 'kisisel-plan', label: 'Planı Kişiye Göre Kurmak' },
  { id: 'hekim-gorusmesi', label: 'Görüşmeye Hazırlık' },
  { id: 'kapanis', label: 'Kapanış' },
  { id: 'kaynaklar', label: 'Kaynaklar' },
];
const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = '40 Sonrası Tarama Testleri — Ne Zaman, Neden, Ne Sıklıkla?';
const seoTitle = '40 Sonrası Tarama Testleri';
const articleDescription =
  'Mamografi, HPV testi, kalın bağırsak taraması, kemik ölçümü ve kan testleri: 40 sonrası hangi yaşta, ne sıklıkla? Türkiye programıyla sade takvim.';
const articlePath = '/hormonal-gecis/40-sonrasi/tarama-testleri/';
const articleImage = '/images/library/editorial/hg-tarama-testleri-vapur.webp';
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'senai-aksoy',
  articleType: 'clinical-guide',
  publishedDate: '5 Mayıs 2026',
  modifiedDate: '11 Ekim 2026',
  pathname: articlePath,
  image: articleImage,
  articleSection: 'Hormonal Geçiş',
  sectionPath: '/hormonal-gecis/40-sonrasi/',
  keywords: [
    '40 sonrası tarama',
    'mamografi',
    'HPV testi',
    'kalın bağırsak kanseri taraması',
    'kemik yoğunluğu',
    'kan basıncı',
    'koruyucu sağlık',
    'menopoz',
  ],
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  image={articleImage}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/hormonal-gecis/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Hormonal Geçiş · 40 Sonrası"
      title={articleTitle}
      lede="Hangi test, hangi yaşta, ne sıklıkla: Türkiye programı ve güncel kılavuzlar üzerinden sade bir takvim."
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="senai-aksoy"
        articleType="clinical-guide"
        publishedDate="5 Mayıs 2026"
        lastUpdated="11 Ekim 2026"
        readingMinutes={9}
        imageSrc="/images/library/editorial/hg-tarama-testleri-vapur-byline.webp"
        imageAlt="Boğaz vapurunun güvertesinde gülen iki arkadaş; başörtülü kadın telefonundaki takvimi gösteriyor, arkadaşı bir tarihi işaret ediyor"
      />

      <ArticleSummary title="Kısa Klinik Yanıt">
        <p>
          40 sonrasında belirtisi olmayan bir kadın için takvimin omurgası şudur: yılda bir kan basıncı ölçümü;
          40–69 yaş arasında iki yılda bir mamografi; 30–65 yaş arasında beş yılda bir HPV testi;
          50 yaşından itibaren kalın bağırsak taraması. Kemik ölçümü 65 yaşında, risk varsa daha önce gündeme gelir.
          Türkiye'de bu üç kanser taraması aile sağlığı merkezlerinde ve Kanser Erken Teşhis, Tarama ve Eğitim Merkezlerinde (KETEM)
          ücretsizdir <sup><a href="#kaynak-1" class="text-primary hover:underline">[1]</a></sup><sup><a href="#kaynak-4" class="text-primary hover:underline">[4]</a></sup>.
          Aile öyküsü ve kişisel risk bu takvimi öne çekebilir.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="tarama-ne-demek">Tarama, Belirti Yokken Sorulan Sorudur</h2>
        <p>
          Tarama testi, hiçbir şikâyetiniz yokken gizli bir sorunu erken yakalamak için yapılır.
          Şikâyet başladıktan sonra yapılan test ise tanı testidir; ikisinin kuralları farklıdır.
        </p>
        <p>
          Bu ayrım küçük görünür ama çok şey değiştirir. Göğsünüzde yeni bir sertlik fark ettiyseniz iki yıllık mamografi
          sıranızı beklemezsiniz; aynı gün hekime gidersiniz. Tarama takvimi, kendinizi iyi hissettiğiniz yıllar içindir.
        </p>
        <p>
          Uzun bir tahlil listesi insana güven verir. Ne yazık ki güven ile fayda her zaman aynı sütunda durmaz.
          Gereksiz tetkikler bazen hastayı korumak yerine, önemsiz sonuçlar nedeniyle yeni incelemelere ve endişelere yol açabiliyor.
          Benim yaklaşımım, mümkün olduğunca çok test istemek değil, gerçekten gerekli taramaları zamanında yapmaktır.
        </p>

        <h2 id="temel-bes-baslik">40 Sonrası Takvimin Omurgası</h2>
        <p>
          Aşağıdaki tablo, ortalama risk taşıyan ve belirtisi olmayan kadınlar içindir. Aile öyküsü veya önceki bir sonuç
          sizi bu tablonun dışına çıkarabilir.
        </p>
        <div class="my-8 overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-primary/20 bg-primary/5 text-ink font-serif">
                <th class="p-3 font-semibold">Ne?</th>
                <th class="p-3 font-semibold">Kimin için?</th>
                <th class="p-3 font-semibold">Ne sıklıkla?</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-primary/10">
              <tr>
                <td class="p-3 font-medium">Kan basıncı ölçümü</td>
                <td class="p-3">40 yaş ve üstü herkes</td>
                <td class="p-3">Yılda bir <sup><a href="#kaynak-4" class="text-primary hover:underline">[4]</a></sup></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Mamografi</td>
                <td class="p-3">40–69 yaş arası kadınlar</td>
                <td class="p-3">İki yılda bir; ayrıca yılda bir klinik meme muayenesi <sup><a href="#kaynak-1" class="text-primary hover:underline">[1]</a></sup></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">HPV testi (rahim ağzı)</td>
                <td class="p-3">30–65 yaş arası kadınlar</td>
                <td class="p-3">Beş yılda bir <sup><a href="#kaynak-1" class="text-primary hover:underline">[1]</a></sup></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Kalın bağırsak taraması</td>
                <td class="p-3">50–70 yaş arası kadın ve erkekler</td>
                <td class="p-3">İki yılda bir dışkıda gizli kan testi; on yılda bir kolonoskopi <sup><a href="#kaynak-1" class="text-primary hover:underline">[1]</a></sup></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Kan şekeri (açlık şekeri veya HbA1c)</td>
                <td class="p-3">35–70 yaş arası, fazla kilolu kişiler</td>
                <td class="p-3">Sonuç normalse üç yılda bir makul <sup><a href="#kaynak-5" class="text-primary hover:underline">[5]</a></sup></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Kan yağları (kolesterol)</td>
                <td class="p-3">40–75 yaş arası</td>
                <td class="p-3">Kalp-damar riski hesabının parçası; aralık riske göre belirlenir <sup><a href="#kaynak-6" class="text-primary hover:underline">[6]</a></sup></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Kemik yoğunluğu ölçümü (DXA)</td>
                <td class="p-3">65 yaş ve üstü; risk taşıyorsanız menopozdan sonra daha erken</td>
                <td class="p-3">Tekrar aralığı ilk sonuca göre belirlenir <sup><a href="#kaynak-7" class="text-primary hover:underline">[7]</a></sup></td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          Tabloda kan basıncının en üstte durması tesadüf değil. Ucuzdur, birkaç dakika sürer ve yararı yüksek kesinlikle gösterilmiştir
          <Evidence level={5} /> <sup><a href="#kaynak-4" class="text-primary hover:underline">[4]</a></sup>.
          Yıllık aralık ise uzman önerisidir; en uygun ölçüm aralığına dair kanıt sınırlıdır <sup><a href="#kaynak-4" class="text-primary hover:underline">[4]</a></sup>.
          Muayenehanede yüksek çıkan bir değer, ilaç başlamadan önce evde veya 24 saatlik ölçümle doğrulanır.
        </p>

        <h2 id="kadina-ozgu-izlem">Meme, Rahim Ağzı ve Kalın Bağırsak İçin Üç Randevu</h2>
        <p>
          Kanser taramalarında takvim nettir ve Türkiye'de üçü de ücretsizdir.
          Aile sağlığı merkezinize, bir KETEM'e ya da mobil tarama aracına başvurabilirsiniz <sup><a href="#kaynak-1" class="text-primary hover:underline">[1]</a></sup>.
        </p>
        <p>
          <strong>Meme:</strong> 40–69 yaş arasında iki yılda bir mamografi çekilir. Bu yaş grubunda iki yılda bir mamografinin
          yararının zararlarından ağır bastığı gösterilmiştir <Evidence level={4} />
          <sup><a href="#kaynak-2" class="text-primary hover:underline">[2]</a></sup>.
          Bazı uluslararası kılavuzlar taramayı 74 yaşına kadar sürdürür; 75 yaş sonrası için kanıt henüz yetersizdir
          <sup><a href="#kaynak-2" class="text-primary hover:underline">[2]</a></sup>.
          Raporunuzda "yoğun meme dokusu" yazıyorsa ek ultrason veya MR'ın herkese yararı henüz gösterilemedi; bunu hekiminizle konuşun.
        </p>
        <p>
          <strong>Rahim ağzı:</strong> Türkiye programında 30–65 yaş arasında beş yılda bir HPV testi yapılır <sup><a href="#kaynak-1" class="text-primary hover:underline">[1]</a></sup>.
          Bu yaş grubunda beş yılda bir HPV testinin yararı güçlü kanıtla gösterilmiştir <Evidence level={5} />
          <sup><a href="#kaynak-9" class="text-primary hover:underline">[9]</a></sup>.
          Menopoza girmek bu testi bırakmanın nedeni değildir. Programın 65 yaşta bitmesi ise herkesin o yaşta taramayı
          bırakabileceği anlamına gelmez: bunun için önceki taramalarınızın düzenli ve temiz olması gerekir. Geçmişte rahim ağzında
          ileri derecede hücre değişikliği ya da kanser öyküsü varsa tarama 65 yaşından sonra da sürebilir. Rahminiz rahim ağzıyla
          birlikte alındıysa ve bu ameliyat bir ön kanser ya da kanser nedeniyle yapılmadıysa tarama genellikle gerekmez <sup><a href="#kaynak-9" class="text-primary hover:underline">[9]</a></sup>.
        </p>
        <p>
          <strong>Kalın bağırsak:</strong> Türkiye programı 50 yaşında iki yılda bir dışkıda gizli kan testiyle başlar;
          on yılda bir kolonoskopi de seçenekler arasındadır <sup><a href="#kaynak-1" class="text-primary hover:underline">[1]</a></sup>.
          50–75 yaş arasında taramanın yararı güçlü kanıtla gösterilmiştir <Evidence level={5} />
          <sup><a href="#kaynak-3" class="text-primary hover:underline">[3]</a></sup>.
          Bazı kılavuzlar 45 yaşında başlamayı önerir <sup><a href="#kaynak-3" class="text-primary hover:underline">[3]</a></sup>.
          Annenizde, babanızda ya da kardeşinizde kalın bağırsak kanseri öyküsü varsa başlangıç yaşınızı hekiminizle ayrıca konuşun.
        </p>
        <p>
          Sonucu öğrenmekten çekinmek, bu randevuları ertelemenin nedenlerinden biri olabilir. Bu çok insani bir duygu.
          Taramanın amacı ise bir sorunu belirti vermeden, erken bir evrede saptayıp gerekli değerlendirmeyi zamanında başlatmaktır.
        </p>

        <h2 id="kemik-yogunlugu">Kemik Ölçümü Ne Zaman Gündeme Gelir?</h2>
        <p>
          Kemik yoğunluğu taraması 65 yaş ve üzerindeki kadınlarda önerilir. Daha genç ama menopoza girmiş bir kadında ise kırık riski
          yüksek görünüyorsa öne alınır <Evidence level={4} />
          <sup><a href="#kaynak-7" class="text-primary hover:underline">[7]</a></sup>.
        </p>
        <p>
          Ben her kadının 65 yaşına gelmesini beklemem; ama yalnızca 40 ya da 50 yaşına girdi diye de herkesten bu testi istemem.
          Erken menopoza giren kadınlarda kemik sağlığını daha dikkatli değerlendiririm, çünkü östrojenin beklenenden erken azalması
          kemik kaybını hızlandırabilir.
        </p>
        <p>
          Daha önce basit bir düşmeyle kırık geçirmiş olmak, uzun süre kortizon kullanmak, çok düşük vücut ağırlığı ya da anne veya
          babada kalça kırığı öyküsü kararımı etkiler. Sigara, aşırı alkol ve kemik kaybına yol açabilen bazı kronik hastalıklar da
          hesaba girer. 43 yaşında menopoza girmiş bir kadınla, 53 yaşında hâlâ düzenli adet gören ve başka risk taşımayan bir kadını
          aynı şekilde değerlendirmem.
        </p>
        <p>
          Bu durumların bir kısmı aslında tarama takviminin dışında kalır. Basit bir düşmeyle kırık geçirmiş, uzun süre kortizon
          kullanan ya da kemik kaybına yol açan bir hastalığı olan bir kadında ölçüm, sıradan taramanın değil, o duruma yönelik
          değerlendirmenin parçasıdır <sup><a href="#kaynak-7" class="text-primary hover:underline">[7]</a></sup>.
        <p>
          Benim için belirleyici olan takvim yaşı değil, kemik kaybı ve kırık riskidir. Risk yüksekse ölçümü erkene alırım.
          Risk düşükse ölçümü gereksiz yere tekrarlamak yerine beslenmeye, yeterli kalsiyuma, direnç egzersizlerine ve diğer koruyucu
          önlemlere ağırlık veririm. İlk ölçüm normal çıktığında testin ne zaman tekrarlanacağına dair kanıt da zaten sınırlıdır
          <sup><a href="#kaynak-7" class="text-primary hover:underline">[7]</a></sup>.
          Ayrıntıları <a href="/zamansiz-yasam/kemik-gucu-kirigi-beklemeden-sorulacak-sorular/" class="text-primary hover:underline">kemik sağlığı rehberinde</a> bulabilirsiniz.
        </p>

        <h2 id="metabolik-izlem">Kan Testlerinde Daha Uzun Liste Daha İyi Sonuç Demek Değil</h2>
        <p>
          Bu bölümde iki temel başlığa odaklanıyoruz: şekeriniz yükseliyor mu ve kalp-damar riskiniz ne düzeyde?
        </p>
        <p>
          Fazla kilonuz varsa 35 yaşından itibaren açlık şekeri veya HbA1c (son iki-üç ayın ortalama kan şekerini gösteren test) ölçülür. Sonuç normalse üç yılda bir tekrarlamak
          makul bir aralıktır <Evidence level={4} /> <sup><a href="#kaynak-5" class="text-primary hover:underline">[5]</a></sup>.
          Kolesterol tek başına bir not gibi okunmaz. Kan basıncı, sigara ve şekerle birlikte on yıllık kalp-damar riskinizi
          hesaplamaya yarar. Kolesterol düşürücü ilaç kararında bu hesap, diğer risk etkenleriyle birlikte önemli bir yer tutar <sup><a href="#kaynak-6" class="text-primary hover:underline">[6]</a></sup>.
        </p>
        <p>
          Muayenede bazen hiçbir şikâyeti olmayan kadınlar bütün hormonlarına, tiroidlerine, vitaminlerine ve tümör belirteçlerine
          bakılmasını istiyor. Oysa çok sayıda test yapmak mutlaka daha iyi bir sağlık kontrolü anlamına gelmiyor.
          Tiroid hastalığını düşündüren bir belirti veya risk faktörü yoksa her kadına rutin olarak geniş bir tiroid paneli istemem;
          gerektiğinde önce TSH (tiroid uyarıcı hormon) ölçümüyle başlarız. Belirtisi olmayan erişkinde rutin tiroid taramasının yararı da gösterilemedi
          <sup><a href="#kaynak-8" class="text-primary hover:underline">[8]</a></sup>.
          Benzer şekilde, yalnızca menopoz yaklaşıyor diye FSH, estradiol veya AMH ölçmenin çoğu kadında bir yararı yok.
          Bu, belirtisi olmayan bir kadında rutin test beklentisi için geçerlidir. 40–45 yaşlarında adet düzeni değişen ve menopoz
          belirtileri başlayan bir kadında ya da 40 yaşından önce erken menopoz düşünülen bir kadında FSH ölçümü değerlendirmenin
          parçası olabilir <sup><a href="#kaynak-10" class="text-primary hover:underline">[10]</a></sup>.
          Çarpıntı, belirgin yorgunluk ya da açıklanamayan kilo değişimi varsa test zaten tarama olmaktan çıkar; belirtiye
          yönelik bir sorudur. Menopozun bazı belirtileri tiroid sorunlarıyla karışabildiği için bu ayrım muayenede yapılır.
        </p>
        <p>
          Tek bir sonuçtan çok, yıllar içindeki yön önemlidir. Geçen yılki değerlerinizi yanınıza almanız, bu yüzden yeni bir testten
          daha çok iş görebilir.
        </p>

        <h2 id="kisisel-plan">Planı Kendi Öykünüze Göre Kurmak</h2>
        <p>
          Tablodaki yaşlar ortalama riski anlatır. Takviminizi öne çeken şey çoğu zaman aile öykünüzdür.
        </p>
        <p>
          Kırklı yaşlarında hiçbir şikâyeti olmayan bir kadının planını kurarken önce yaşına, kendisinin ve ailesinin hastalık öyküsüne,
          adet düzenine ve daha önce yaptırdığı taramalara bakarım. Çünkü kırklı yaşlara giren her kadına aynı testleri yapmak doğru değil.
        </p>
        <p>
          Ailesinde erken yaşta meme, yumurtalık veya kalın bağırsak kanseri olup olmadığını özellikle öğrenmek isterim.
          Tansiyon, kilo, sigara ve diyabet gibi kalp-damar risklerini de aynı görüşmede değerlendiririm.
          Kişisel veya ailesel risk varsa ulusal programdaki takvimi değiştirmek gerekebilir; o zaman "herkes için" yazılmış tablo
          size yetmez, kendi takviminizi birlikte çıkarırız.
        </p>
        <p>
          Planı yürütmenin en kolay yolu, son testlerinizi tek sayfada toplamaktır: tarih, sonuç ve bir sonraki adım.
          Bu sayfayı nasıl tutabileceğinizi <a href="/hormonal-gecis/menopoza-hazirlik/koruyucu-saglik-kayitlari/" class="text-primary hover:underline">koruyucu sağlık kayıtları yazısında</a> bulabilirsiniz.
        </p>

        <h2 id="hekim-gorusmesi">Görüşmeye Üç Soruyla Gitmek</h2>
        <p>
          Hazırlıklı gittiğiniz görüşme kısa sürer ve size özel bir plan çıkarır.
        </p>
        <ol>
          <li>Yaşıma ve aile öyküme göre bu yıl hangi taramalar sırada?</li>
          <li>Takvimimi değiştiren bir risk var mı; varsa hangi testi ne zaman öne almalıyız?</li>
          <li>Sonuçlar normal gelse bile hangi belirtide sırayı beklemeden gelmeliyim?</li>
        </ol>
        <p>
          Bu üç soru, "her şeye bakalım" telaşını bir takvime dönüştürür.
        </p>

        <RedFlagBox
          markers={[
            'Memede yeni ele gelen sertlik, meme ucundan kanlı akıntı veya meme derisinde çekinti',
            'Adet kesildikten sonra vajinal kanama ya da lekelenme',
            'Dışkıda kan, dışkılama alışkanlığında haftalardır süren değişiklik',
            'Ani ve açıklanamayan kilo kaybı, gece terlemesi veya uzamış halsizlik',
            'Küçük bir düşmede kırık (özellikle kalça, omurga, el bileği)',
            'Yeni başlayan göğüs ağrısı, nefes darlığı veya çarpıntı',
          ]}
          footnote="Bu maddeler tanı koymaz; tarama sırasını beklemeden hekim değerlendirmesi gerektirebilecek durumları hatırlatır. Ani ve şiddetli göğüs ağrısı veya nefes darlığında 112'yi arayın."
        />

        <h2 id="kapanis">Tarihi Bilmek, Değişikliği Fark Etmek</h2>
        <p>
          İyi bir tarama planını ezberlemeniz gerekmez; bir sonraki tarihi bilmeniz işinizi çok kolaylaştırır.
        </p>
        <p>
          Takvim, her şey yolundayken işe yarar. Yeni bir belirti, anormal bir sonuç ya da ailenizde yeni öğrendiğiniz bir hastalık
          planı değiştirir; böyle bir durumda sıranızı beklemeyin. Listenin dışında kalan her test için sorulacak soru ise hep aynıdır:
          Sonucu bende neyi değiştirecek?
        </p>

