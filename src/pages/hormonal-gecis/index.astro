---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuHero from '../../components/site/SubmenuHero.astro';
import SubmenuLinkCard from '../../components/site/SubmenuLinkCard.astro';
import SubmenuSection from '../../components/site/SubmenuSection.astro';
import SubmenuSpotlightCard from '../../components/site/SubmenuSpotlightCard.astro';
import { submenuHeroByRoute } from '../../data/submenu-heroes';

const hero = submenuHeroByRoute['/hormonal-gecis']!;

const pillars = [
  {
    step: '01',
    title: 'Perimenopoz',
    excerpt: 'Nedir, ne zaman başlar, belirtileri neler?',
    href: '/hormonal-gecis/perimenopoz',
    image: submenuHeroByRoute['/hormonal-gecis/perimenopoz']!,
  },
  {
    step: '02',
    title: 'Menopoza Hazırlık',
    excerpt: 'Geçiş sürecine nasıl hazırlanırsınız?',
    href: '/hormonal-gecis/menopoza-hazirlik',
    image: submenuHeroByRoute['/hormonal-gecis/menopoza-hazirlik']!,
  },
  {
    step: '03',
    title: 'Menopoz',
    excerpt: 'Menopoz nedir, vücudunuzda neler değişir?',
    href: '/hormonal-gecis/menopoz',
    image: submenuHeroByRoute['/hormonal-gecis/menopoz']!,
  },
  {
    step: '04',
    title: '40 Sonrası Sağlık',
    excerpt: 'Koruyucu sağlık, tarama testleri, uzun vadeli planlama.',
    href: '/hormonal-gecis/40-sonrasi',
    image: submenuHeroByRoute['/hormonal-gecis/40-sonrasi']!,
  },
];
---

<SiteLayout
  title="Hormonal Geçiş - Estranova"
  description="Perimenopozdan menopoza, hormonal geçiş sürecinizi anlamak için kapsamlı bilgi rehberleri."
>
  <SiteNavbar currentPath="/hormonal-gecis" />

  <main id="main-content" class="text-[#2D2D2D]">
    <SubmenuHero
      eyebrow="Kategori"
      title="Hormonal Geçiş"
      lede="Perimenopozdan menopoza, hormonal geçiş sürecinizi anlamak için kapsamlı bilgi rehberleri. Bu bölümde geçiş dönemlerini adım adım inceleyebilir, her evreye dair sorulara sade ve dengeli bir çerçevede ulaşabilirsiniz."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />

    <SubmenuSection variant="cream" borderedTop={true}>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          pillars.map((p) => (
            <SubmenuLinkCard
              href={p.href}
              title={p.title}
              excerpt={p.excerpt}
              imageSrc={p.image.src}
              imageAlt={p.image.alt}
              step={p.step}
            />
          ))
        }
      </div>
    </SubmenuSection>

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">Öne Çıkanlar</p>
        <h2 class="mb-4 font-serif text-4xl leading-tight md:text-5xl">Öne Çıkan İçerikler</h2>
        <p class="text-lg leading-relaxed text-[#2D2D2D]/75">
          Geçiş sürecini daha iyi anlamaya yardımcı olacak örnek içerikleri buradan inceleyebilirsiniz.
        </p>
      </header>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <SubmenuSpotlightCard
          tag="Perimenopoz"
          title="Adet Değişimlerini Okumak"
          body="İlk dönemde sık görülen değişimleri sade bir anlatımla ele alan başlangıç içeriği."
          href="/article/perimenopozda-dongu-duzensizlikleri"
        />
        <SubmenuSpotlightCard
          highlight={true}
          tag="Menopoza Hazırlık"
          title="Günlük Rutin Planı"
          body="Uyku, hareket ve beslenme başlıklarını düzenli bir plana dönüştürmek için temel öneriler."
          href="/library"
        />
        <SubmenuSpotlightCard
          tag="Menopoz"
          title="Sık Sorulan Sorular"
          body="Geçiş dönemine dair temel sorulara kısa ve güvenilir yanıtlar sunan derleme içerik."
          href="/hormonal-gecis/menopoz"
        />
      </div>
    </SubmenuSection>

    <SubmenuSection variant="sand" borderedTop={true}>
      <div class="rounded-[32px] border border-[#6B2D3E]/12 bg-white p-8 shadow-sm ring-1 ring-black/5 md:p-10">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">İlgili Kategoriler</p>
        <h2 class="mb-6 font-serif text-3xl leading-tight md:text-4xl">Bilgi yollarına devam edin</h2>
        <div class="flex flex-wrap gap-3">
          <a
            href="/zamansiz-yasam"
            class="rounded-xl border border-[#6B2D3E]/20 bg-[#FDF8F0] px-5 py-3 font-medium text-[#2D2D2D] transition hover:border-[#6B2D3E]/40"
            >Zamansız Yaşam</a
          >
          <a
            href="/beden-yakinlik"
            class="rounded-xl border border-[#6B2D3E]/20 bg-[#FDF8F0] px-5 py-3 font-medium text-[#2D2D2D] transition hover:border-[#6B2D3E]/40"
            >Beden & Yakınlık</a
          >
          <a
            href="/zihin-denge"
            class="rounded-xl border border-[#6B2D3E]/20 bg-[#FDF8F0] px-5 py-3 font-medium text-[#2D2D2D] transition hover:border-[#6B2D3E]/40"
            >Zihin & Denge</a
          >
        </div>
      </div>
    </SubmenuSection>
  </main>

  <SiteFooter />
</SiteLayout>
