---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuHero from '../../components/site/SubmenuHero.astro';
import SubmenuLinkCard from '../../components/site/SubmenuLinkCard.astro';
import SubmenuSection from '../../components/site/SubmenuSection.astro';
import SubmenuSpotlightCard from '../../components/site/SubmenuSpotlightCard.astro';
import CategoryRelatedLinks from '../../components/site/CategoryRelatedLinks.astro';
import Evidence from '../../components/site/Evidence.astro';
import ChapterMasthead from '../../components/site/ChapterMasthead.astro';
import EditorialEpigraph from '../../components/site/EditorialEpigraph.astro';
import ChapterCompass from '../../components/site/ChapterCompass.astro';
import HubStartingPath from '../../components/site/HubStartingPath.astro';
import { hubStartingPaths } from '../../data/hub-starting-paths';

const startingPath = hubStartingPaths['/hormonal-gecis'];
import { submenuHeroByRoute } from '../../data/submenu-heroes';
import { subHubEpigraphs } from '../../data/sub-hub-epigraphs';

const hero = submenuHeroByRoute['/hormonal-gecis']!;
const __hubPath = '/hormonal-gecis';
const epigraph = subHubEpigraphs[__hubPath];

const pillars = [
  {
    step: '01',
    title: 'Perimenopoz',
    excerpt: 'Nedir, ne zaman başlar, belirtileri neler?',
    href: '/hormonal-gecis/perimenopoz',
    image: submenuHeroByRoute['/hormonal-gecis/perimenopoz']!,
  },
  {
    step: '02',
    title: 'Menopoza Hazırlık',
    excerpt: 'Geçiş sürecine nasıl hazırlanırsınız?',
    href: '/hormonal-gecis/menopoza-hazirlik',
    image: submenuHeroByRoute['/hormonal-gecis/menopoza-hazirlik']!,
  },
  {
    step: '03',
    title: 'Menopoz',
    excerpt: 'Menopoz nedir, vücudunuzda neler değişir?',
    href: '/hormonal-gecis/menopoz',
    image: submenuHeroByRoute['/hormonal-gecis/menopoz']!,
  },
  {
    step: '04',
    title: '40 Sonrası Sağlık',
    excerpt: 'Koruyucu sağlık, tarama testleri, uzun vadeli planlama.',
    href: '/hormonal-gecis/40-sonrasi',
    image: submenuHeroByRoute['/hormonal-gecis/40-sonrasi']!,
  },
];
---

<SiteLayout
  title="Hormonal Geçiş - Estranova"
  description="Perimenopozdan menopoza, hormonal geçiş sürecinizi anlamak için kapsamlı bilgi rehberleri."
>
  <SiteNavbar currentPath="/hormonal-gecis" />

  <ChapterMasthead variant="section" chapter="Hormonal Geçiş" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Kategori"
      title="Hormonal Geçiş"
      lede="Perimenopozdan menopoza, hormonal geçiş sürecinizi anlamak için kapsamlı bilgi rehberleri. Bu bölümde geçiş dönemlerini adım adım inceleyebilir, her evreye dair sorulara sade ve dengeli bir çerçevede ulaşabilirsiniz."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />

    <HubStartingPath
      kicker={startingPath.kicker}
      title={startingPath.title}
      intro={startingPath.intro}
      steps={startingPath.steps}
    />

    <SubmenuSection variant="cream" borderedTop={true}>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
        {
          pillars.map((p) => (
            <SubmenuLinkCard
              href={p.href}
              title={p.title}
              excerpt={p.excerpt}
              imageSrc={p.image.src}
              imageAlt={p.image.alt}
              step={p.step}
            />
          ))
        }
      </div>
    </SubmenuSection>

    {epigraph && <EditorialEpigraph quote={epigraph} />}

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Öne Çıkanlar</p>
        <h2 class="mb-4 font-serif text-4xl leading-tight md:text-5xl">Öne Çıkan İçerikler</h2>
        <p class="text-lg leading-relaxed text-ink/75">
          Geçiş sürecini daha iyi anlamaya yardımcı olacak örnek içerikleri buradan inceleyebilirsiniz.
        </p>
      </header>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <SubmenuSpotlightCard
          tag="Perimenopoz"
          title="Perimenopoza Sakin Bir Giriş"
          body="İlk dönemde sık görülen değişimleri ve geçişin nasıl seyrettiğini ele alan alt-kategori — derin okumalar yakında."
          href="/hormonal-gecis/perimenopoz"
        >
          <span slot="footer">Kanıt Düzeyi: <Evidence level={4} /></span>
        </SubmenuSpotlightCard>
        <SubmenuSpotlightCard
          highlight={true}
          tag="Menopoz · Karar"
          title="Hormon Tedavisi Karar Rehberi"
          body="Hormon tedavisi seçeneklerini fayda-risk dengesi içinde sade bir karar çerçevesinde ele alan rehber."
          href="/hormonal-gecis/menopoz/hormon-tedavisi-karar-rehberi"
        >
          <span slot="footer">Kanıt Düzeyi: <Evidence level={4} /></span>
        </SubmenuSpotlightCard>
        <SubmenuSpotlightCard
          tag="Menopoz"
          title="Sık Sorulan Sorular"
          body="Geçiş dönemine dair temel sorulara kısa ve güvenilir yanıtlar sunan derleme içerik."
          href="/hormonal-gecis/menopoz"
        >
          <span slot="footer">Kanıt Düzeyi: <Evidence level={4} /></span>
        </SubmenuSpotlightCard>
      </div>
    </SubmenuSection>

    <SubmenuSection variant="sand" borderedTop={true}>
      <CategoryRelatedLinks exclude="/hormonal-gecis" />
    </SubmenuSection>

    <ChapterCompass nextHref="/hormonal-gecis/perimenopoz" nextNumber="01" nextChapter="Perimenopoz" nextParent="Hormonal Geçiş" />
  </main>

  <SiteFooter />
</SiteLayout>
