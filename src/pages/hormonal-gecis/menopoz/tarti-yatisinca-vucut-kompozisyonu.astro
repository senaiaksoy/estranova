---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { articleFaqs } from '../../../data/article-faqs';
import { resolveSiteUrl } from '../../../utils/seo';

const pathname = '/hormonal-gecis/menopoz/tarti-yatisinca-vucut-kompozisyonu/';
const hero = submenuHeroByRoute[pathname]!;

const tocEntries = [
  { id: 'tartinin-yatistigi-yer', label: 'Tartının yatıştığı yer' },
  { id: 'soyledigi-soylemedigi', label: 'Tartının söylediği — ve söylemediği' },
  { id: 'sessiz-aritmetik', label: 'Östrojen yatışınca beden ne yapıyor' },
  { id: 'ayna-tartı-arasında', label: 'Ölçü ile his arasındaki mesafe' },
  { id: 'kontrol-teslim', label: 'Her şeyi takip etmek — bir yere kadar' },
  { id: 'uc-kucuk-not', label: 'Üç küçük pratik yön' },
  { id: 'sss', label: 'Sıkça Sorulan Sorular' },
  { id: 'kapanis', label: 'Kapanış' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Tartı yatışınca geriye kalan: vücut kompozisyonunun sessiz kayması';
const seoTitle = 'Tartı Yatışınca: Vücut Kompozisyonu';
const articleDescription =
  'Tartı sayısı uzun süre değişmese de beden değişmeye devam edebilir. Menopozun ölçüye gelmeyen tarafına — kas-yağ oranındaki sessiz kaymaya — sakin bir bakış.';
const faqItems = articleFaqs[pathname] ?? [];
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'estranova-editorial',
  publishedDate: '15 Temmuz 2026',
  modifiedDate: '16 Temmuz 2026',
  pathname,
  articleSection: 'Hormonal Geçiş',
  sectionPath: '/hormonal-gecis/menopoz/',
  keywords: [
    'menopoz',
    'vücut kompozisyonu',
    'kas kaybı',
    'viseral yağ',
    'tartı',
    'BMI sınırlılığı',
    'menopozda kilo',
    'kompozisyon değişimi',
    'östrojen düşüşü',
    'direnç antrenmanı',
    'protein',
  ],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/hormonal-gecis/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Hormonal Geçiş · Menopoz"
      title="Tartı yatışınca geriye kalan: vücut kompozisyonunun sessiz kayması"
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="estranova-editorial"
        publishedDate="15 Temmuz 2026"
        readingMinutes={9}
        imageSrc="/images/library/editorial/pair-window-cafe-reflection.webp"
        imageAlt="Pencere kenarında iki yaşıt kadının sakin sohbeti; tartı ve vücut kompozisyonu yazısı için editoryal görsel"
      />

      <ArticleSummary title="Kısa Özet">
        <p>
          Tartı uzun süre aynı kalsa da beden değişmeye devam edebilir. Kas yavaşça azalır; yağ bazen başka bir
          yere yerleşir. Bu rehber bir reçete değil. Tartının yetmediği noktada nereye bakabileceğinize dair
          sakin bir bakış.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="tartinin-yatistigi-yer">Tartının yatıştığı yer</h2>
        <p>
          Yazlık bir bluzun omuz çizgisi. Ayna karşısında on saniye. Bazen tartıdan daha çok şey söyler.
        </p>
        <p>
          Aylardır aynı sayıyı görmek mümkündür — belki artık bakmayı da bıraktınız. Ama pantolon belden başka
          oturur. Kolun kumaşla buluştuğu yerde ince bir sıkılık belirir. Aynı sayı. Farklı bir görüntü.
        </p>
        <p>
          Tartı yatışmıştır. Beden değil.
        </p>
        <p>
          Sabahın ilk on saniyesi çoğu zaman aynı soruyla geçer: "İyi miyim?" Tartı bu soruyu cevaplamaz;
          kısa bir teselli ya da tedirginlik bırakır, sonra susar. Bu yüzden bazı evlerde tartı artık dolabın
          üst rafındadır. Büyük bir özgürleşme değil. Sabahın on saniyesinin boşalmasıdır sadece. Boşalan yere
          başka bir gözlem yerleşebilir: ayna, kumaşın oturuşu, merdiven sonunda nefesin tonu.
        </p>
        <p>
          Sizin de tanıdık gelebilecek tablo budur: tartı sayısı uzun zamandır pek değişmez. Aynı kilodaki bir
          kadın, üç yıl önceki bedeninden farklı hissedebilir. Sayı yatışmış olsa da altında sessiz bir şey
          değişmeyi sürdürebilir.
        </p>

        <h2 id="soyledigi-soylemedigi">Tartının söylediği — ve söylemediği</h2>
        <p>
          Tartı tek bir şey söyler: toplam kütle.
        </p>
        <p>
          Altında neyin değiştiğini söylemez. Beden ağırlığı kabaca üç bileşenin toplamıdır: kas, yağ ve geri
          kalan (kemik, su, organlar, doku). Tartı bunları tek sayıda birleştirir; dengeyi göstermez. Bu yüzden
          iki kadın aynı kiloda olabilir, ama farklı bedenlerde durabilir. Vücut kütle endeksi (BMI) de aynı
          sınırlılığı taşır. Araştırmalar, kompozisyonu yok sayan ölçümlerin menopoz döneminde riski olduğundan
          eksik gösterebileceğini belirtiyor <Evidence level={4} />.
        </p>
        <p>
          Sayı sabit kalır. Beden hareket hâlinde olabilir.
        </p>
        <p>
          "Kompozisyon" sözcüğü ilk duyulduğunda teknik gelebilir. Oysa sizin gündelik cümlenizin tam
          ortasındadır. "Bedenim değişti" demek çoğu zaman kompozisyondan bahsetmektir. Adı henüz konulmamış
          olabilir.
        </p>
        <p>
          İçiniz rahat olsun diye ekleyelim: tartının yetersiz kalması sizin yanılmanız demek değildir. Ölçü
          aletinin sınırıdır.
        </p>

        <h2 id="sessiz-aritmetik">Östrojen yatışınca beden ne yapıyor</h2>
        <p>
          Menopoz tek bir günde bitmez. Bir geçiştir. Ve bedende sessiz bir aritmetik işler.
        </p>
        <p>
          Östrojen yatışmaya başladığında beden iki şeyi birden yapabilir: kas kütlesini koruma yetisi biraz
          zayıflar (sarkopeni eğilimi); yağ da farklı bir bölgeye — özellikle karın çevresine — yerleşmeye
          başlar (viseral yağa kayış). Toplam kilo aynı kalabilir. Kompozisyon değişmiş olabilir. Araştırmalar,
          östrojen düşüşünün kas–yağ dengesi üzerindeki etkisinin yalnızca yaşa bağlı genel kayışla
          açıklanamayabileceğini gösteriyor <Evidence level={4} />. Menopoz, yaş almanın içinde ayrı bir
          katmandır.
        </p>
        <p>
          Bunu duymak bazen rahatlatır. Bazen de omuzlara küçük bir yük biner. İkisi yan yana durabilir.
          Rahatlatıcı taraf: bu yalnızca irade meselesi değildir. Diğer taraf: bedenin yön değiştirdiği noktada
          atılan küçük adımların bir yeri vardır — sizin yolunuzda, kendi temposunuzda.
        </p>
        <p>
          Bu aritmetik herkeste aynı işlemez. Kiminde daha hızlı, kiminde daha yavaş. Yağ bazen bele, bazen
          başka bir yere kayar. Genetik, uyku, hareket, beslenme ve stres birbirine dokunur. Tek formül yok.
          Bir yön ve bir dizi seçim vardır.
        </p>

        <h2 id="ayna-tartı-arasında">Ölçü ile his arasındaki mesafe</h2>
        <p>
          Deniz kenarında çekilmiş bir fotoğraf. Ya da mayo provası. Mesafe bir anda duyulur hâle gelir.
        </p>
        <p>
          Bazen tartı susar. Ayna susmaz. Kıyafet de susmaz. Önceki yıllarda beden değişimi çoğu zaman sessiz
          taşınırdı. "Geçiyor" denirdi. Bugün ise beden hakkında daha çok konuşuluyor; bazen fazlasıyla. Her
          ölçüm, her eğri, her sayı izlenebilir hâle geliyor. İki uç da yorucu olabilir: hiç konuşmamak veya her
          şeyi ölçmek.
        </p>
        <p>
          Orta yol çoğu zaman sayıdan önce hisse bakmaktır. Kompozisyon kelimesini bilmek yararlıdır. Ama önce
          bedeninizde ne hissettiğinizi fark etmek de bir beceridir. Ölçü ile his birbirinden uzaklaştığında bu
          yalnızlık değildir. Yaygın bir tablo.
        </p>

        <h2 id="kontrol-teslim">Her şeyi takip etmek — bir yere kadar</h2>
        <p>
          Ölçmek yardımcı olabilir. Ondan sonrası, izlemenin kaygıya dönüştüğü yerdir.
        </p>
        <p>
          Hekim odasında sık duyulan sade soru şudur: "Bu bilgi sizi rahatlatıyor mu, yoruyor mu?" Ölçüm bazen
          cevap değildir. Bazen oyalanma olur. Telefondaki eğriye bakarken omuzların gerilmesi, o oyalanmanın
          somut hâli olabilir.
        </p>
        <p>
          Ölçüm ritmini hekimle belirli aralıklarla gözden geçirmek; kalan zamanda bedeninizde ne
          hissettiğinizi fark etmek — ölçümü reddetmek değil, yerine oturtmaktır. Sayı bir not. Gözlem gövde. His de tam orada.
          Üçü yaklaştığında tablo netleşir.
        </p>
        <p>
          En doğru sıklık kişiden kişiye değişir. Her izlenen şeyin kesin cevaba bağlanması gerekmez.
        </p>

        <h2 id="uc-kucuk-not">Üç küçük pratik yön</h2>
        <p>
          Bunlar reçete değil. Hekimle birlikte değerlendirilebilecek üç yaklaşımdır. Yolunuz farklı olabilir.
        </p>
        <p>
          <strong>Bir.</strong> Direnç antrenmanı, kompozisyonu kasla destekleyen somut araçlardan biridir.
          Menopozdaki kadınlarda düzenli direnç antrenmanının kas kütlesini korumaya yardımcı olabileceğini
          gösteren çalışmalar artıyor <Evidence level={4} />. Kritik kelime "düzenli"dir — ayda iki kez değil,
          haftaya yerleşmiş bir ritim. Yürüyüş iyi bir çapa olabilir; haftada bir-iki gün ağırlık eklemek de
          zamanla fark bırakabilir.
        </p>
        <p>
          <strong>İki.</strong> Protein, menopoz döneminde yeniden konuşulan bir konudur. Yaş aldıkça bedenin
          proteini işleme biçimi biraz değişebilir; yeterli protein almak daha bilinçli bir tercih hâline
          gelebilir. Sayısal hedef hekimle belirlenir. Ana öğünlerde proteinin tabakta görünür yer alması
          yardımcı olabilir — hesap makinesi değil, alışkanlık.
        </p>
        <p>
          <strong>Üç.</strong> Kompozisyonu zaman zaman ölçmek — her gün değil. Uygun bir kompozisyon ölçümü
          (hekimle karar verilen yöntem) yılda bir-iki kez referans noktası verebilir. Sayıdan çok eğriye
          bakmaya yardım eder. Sıklık da hekimle alınan bir karardır.
        </p>
        <p>
          Üçünün arkasında aynı tutum vardır: bedeni sürekli izlemek değil, bedeni tanımak. En değerli adım
          çoğu zaman kişisel sağlık geçmişinizi bilen bir hekimle kurulan uzun bağdır.
        </p>

        <h2 id="sss">Sıkça Sorulan Sorular</h2>
        <p>
          Bu konuda en sık gelen soruların kısa yanıtları:
        </p>
        <p>
          <strong>Tartı pek değişmiyor ama beden değişti — bu menopoza özgü mü?</strong> Tek başına menopoza özgü
          değildir; ama menopoz bu süreci hızlandırabilir. Kompozisyon değişimi yaş almanın bir parçasıdır —
          kas yavaşça azalır, yağ farklı bölgelere yerleşebilir. Östrojen düşüşü bu kayışın eğimini biraz daha
          dikleştirebilir. Sayının yatışıp bedenin değişmeye devam etmesi yaygın bir gözlemdir. Bu bir hata
          değildir; ölçü aletini değiştirme zamanının gelmiş olabileceğinin işaretidir.
        </p>
        <p>
          <strong>BMI normal aralıkta ama yağ oranı yüksek; ne yapmalı?</strong> Önce hekimle birlikte
          değerlendirmek gerekir — özellikle yağın nereye yerleştiği (karın çevresi mi, başka yerler mi)
          metabolik açıdan farklı anlamlar taşıyabilir. Bu bir panik göstergesi olmak zorunda değildir; bir yön
          göstergesi olabilir. Direnç antrenmanı, yeterli protein ve uyku düzeni, kompozisyon tablosunu zaman
          içinde değiştirebilen üç ana sütundur. Ölçüm alarm için değil, görmek içindir.
        </p>
        <p>
          <strong>Kompozisyon takibi için tek bir doğru yöntem var mı?</strong> "Tek doğru yöntem" fazla iddialı
          olur. "Yararlı bulunan yöntem" daha dürüst bir yaklaşımdır. Ev tartısının da bir yeri vardır; yanına
          bedeni gözlemleme alışkanlığı ve hekimle karar verilen aralıklı bir kompozisyon ölçümü tablonun
          gövdesini görmeye yardım edebilir. İzlemek de bir doza sahiptir.
        </p>
        <p>
          <strong>Direnç antrenmanı menopozda gerçekten kritik mi?</strong> "Kritik" biraz büyük bir kelimedir;
          "değerli" daha doğru durur. Düzenli direnç antrenmanının kas kütlesini korumaya yardımcı olabileceği
          araştırmalarda sık konuşuluyor; menopoz döneminde bu eğilim özellikle önemlidir. Zorunluluk diline
          çevirmemek de önemli — başlama eşiği kişiden kişiye değişir. Küçük başlangıçlar zamanla fark
          yaratabilir.
        </p>
        <p>
          <strong>Protein için bir kural var mı?</strong> Sayısal hedefi hekim belirler. Genel prensip olarak
          ana öğünlerde proteinin tabakta görünür yer alması, öğünleri kompozisyon açısından daha bilinçli
          kurgulamaya yardımcı olabilir. Bu, sürekli tartmaktan çok bir alışkanlık konusudur. Yerleştiğinde
          hesap yapmadan da işler.
        </p>

        <h2 id="kapanis">Kapanış</h2>
        <p>
          Tartı bir başlangıç noktası olabilir. Gösterdiği tek şey kütledir.
        </p>
        <p>
          Sayı yatışınca geriye kalan, bedenle kurulan farklı bir ilişki biçimidir. Ölçüden çok gözlem. Anlık
          karardan çok eğrinin yönü. Bu yaklaşım kişiden kişiye değişir — ve bu iyi bir şeydir.
        </p>
        <p>
          Belki şu soru yardımcı olur: Bu altı ayda tartı dışında neyi, yargılamadan, yalnızca fark etmek
          niyetiyle gözlemleyebilirsiniz? Bir pantolonun düşüşü. Merdivenin sonunda nefesin tonu. Sabah belin
          nasıl açıldığı. Tartı susar; bu ayrıntılar görünür kalır. Bu dönemde öğrenilebilecek en sade yön
          belki de budur.
        </p>
      </ArticleProsePanel>

      <RelatedReadings
          class="mt-14"
          paths={[
            '/zamansiz-yasam/kilo-artisi-menopoz/',
            '/zamansiz-yasam/kemik-sagligi-40-sonrasi/',
            '/zamansiz-yasam/beslenme-yaslanma/',
            '/hormonal-gecis/menopoz/menopoz-nedir/',
          ]}
        />

      <ArticleEditorNote>
<p class="mb-3 leading-relaxed text-ink/80">
          Menopoz dönemindeki vücut kompozisyonu değişimi — kas kütlesinin yavaşça azalması (sarkopenik
          eğilim) ve yağın özellikle karın çevresine yeniden dağılması (viseral kayış) — östrojen düşüşünün
          yaş alma sürecine eklediği ayrı bir katmandır. Araştırmalar, bu kayışın yalnızca yaşa bağlı genel
          düşüşle açıklanamayabileceğini gösteriyor <Evidence level={4} />.
        </p>
        <p class="mb-3 leading-relaxed text-ink/80">
          Vücut kütle endeksi (BMI) tek başına kompozisyonu yansıtmaz; aynı kilo değerinde farklı metabolik
          profilleri gizleyebilir. Özellikle viseral yağ oranı, kardiyovasküler ve metabolik risk
          değerlendirmesinde tartı veya BMI'den daha bilgilendirici olabilir <Evidence level={4} />. Bu nedenle
          ölçüm aracı tek başına yeterli değildir; kompozisyon ölçümleri ek bilgi sağlar.
        </p>
        <p class="mb-3 leading-relaxed text-ink/80">
          Düzenli direnç antrenmanının menopoz dönemindeki kadınlarda kas kütlesi korunmasına yardımcı
          olabileceğini ve yeterli protein alımının kompozisyon korumasına yardımcı olabileceğini gösteren
          veriler giderek güçlenmektedir <Evidence level={4} />. Antrenman tipi, sıklık ve yoğunluk bireysel ortopedik
          tabloya göre titrize edilir; protein hedefi ise böbrek fonksiyonu, mevcut hastalıklar ve ilaç
          kullanımıyla birlikte değerlendirilir.
        </p>
        <p class="mb-3 leading-relaxed text-ink/80">
          Ölçüm sıklığı, antrenman protokolü, beslenme planı ve kompozisyon takip yöntemi her bireyin sağlık
          geçmişine, mevcut tıbbi durumuna ve yaşam koşullarına göre kişiselleştirilmelidir. Bu yazıdaki
          gözlemler genel bir bilgilendirme amacı taşır; ölçüm sıklığında, antrenman tipinde ya da protein
          hedeflerinde belirgin değişiklik yapmadan önce mevcut sağlık durumu, ilaçlar ve laboratuvar
          değerleri hekimle birlikte gözden geçirilmelidir.
        </p>
        <p class="text-sm italic text-primary">
          — Doç. Dr. Senai Aksoy, Estranova Bilimsel Editörü
        </p>
      </ArticleEditorNote>

       <ArticleDisclaimer>
<p>
          Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme yerine geçmez. Tanı ve tedavi kararları için sağlık profesyoneline başvurunuz.
        </p>
      </ArticleDisclaimer>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
