---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuSection from '../../../components/site/SubmenuSection.astro';
import ChapterMasthead from '../../../components/site/ChapterMasthead.astro';
import EditorialEpigraph from '../../../components/site/EditorialEpigraph.astro';
import ChapterCompass from '../../../components/site/ChapterCompass.astro';
import EditorPickCard from '../../../components/site/EditorPickCard.astro';
import MagazineTOC from '../../../components/site/MagazineTOC.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { chapterMap, getNextChapter } from '../../../data/chapter-map';
import { subHubEpigraphs } from '../../../data/sub-hub-epigraphs';

const hero = submenuHeroByRoute['/hormonal-gecis/menopoz']!;
const __path = '/hormonal-gecis/menopoz';
const chapter = chapterMap[__path]!;
const epigraph = subHubEpigraphs[__path];
const next = getNextChapter(__path);

interface ArticleEntry {
  href: string;
  title: string;
  excerpt: string;
  lede: string;
  writerSlug: string;
  readingMinutes: number;
  image: { src: string; alt: string };
}

const articles: ArticleEntry[] = [
  {
    href: '/hormonal-gecis/menopoz/menopoz-nedir',
    title: 'Menopoz Nedir? — Temel Rehber',
    excerpt:
      'Tanım, evreler, hormon değişimleri ve uzun vadeli sağlık gündemi.',
    lede: 'Menopoz pek çoğumuz için "gün gelip biten bir şey" değil; fark ettiğimiz an geriye dönük adlandırdığımız bir geçiş.',
    writerSlug: 'berna-aksoy',
    readingMinutes: 8,
    image: submenuHeroByRoute['/hormonal-gecis/menopoz']!,
  },
  {
    href: '/hormonal-gecis/menopoz/hormon-tedavisi-karar-rehberi',
    title: 'Hormon Tedavisi: Karar Rehberi',
    excerpt:
      'HRT ne zaman gündeme gelir, kim için uygundur, neye dikkat edilir.',
    lede: 'Bilgilendirilmiş karar; aceleye getirilmiş bir tercih değil, planlı bir okumayla başlayan bir süreç.',
    writerSlug: 'berna-aksoy',
    readingMinutes: 10,
    image: submenuHeroByRoute['/hormonal-gecis/menopoz/hormon-tedavisi-karar-rehberi']!,
  },
  {
    href: '/hormonal-gecis/menopoz/hrt-yillar-sonra-baslamak',
    title: "HRT'ye Yıllar Sonra Başlamak: Bir Karar, Bir Yolculuk",
    excerpt:
      'Dokuz yıl HRT olmadan geçen menopoz yolculuğu, klinik kılavuzların değişimi ve hekimle birlikte yeni bir adıma karar verme süreci.',
    lede: 'Annem hiç düşünmedi… ben dokuz yıl bekledim… kızım ise bu kararı çok daha erken alabilecek. Üç kuşağın aynı eşikte üç farklı duruşu.',
    writerSlug: 'basak-pelister',
    readingMinutes: 9,
    image: submenuHeroByRoute['/hormonal-gecis/menopoz/hrt-yillar-sonra-baslamak']!,
  },
  {
    href: '/hormonal-gecis/menopoz/hrt-ilk-alti-ay',
    title: "HRT'nin İlk Altı Ayı — Bir Akran Hikayesi",
    excerpt:
      'HRT başlayan 58 yaşında bir kadının ilk altı aylık deneyimi: karar süreci, ilk haftalar, üç–dört ay, beş–altı ay ve aile bağı.',
    lede: 'Altı aydır küçük bir merhem ve bir hap mutfak tezgâhımın bir köşesinde sessizce duruyor… İşte tam o yerde duruyorum, sıcağı sıcağına anlatabilirim.',
    writerSlug: 'demet-kizilkaya',
    readingMinutes: 9,
    image: submenuHeroByRoute['/hormonal-gecis/menopoz/hrt-ilk-alti-ay'] ?? submenuHeroByRoute['/hormonal-gecis/menopoz/hrt-yillar-sonra-baslamak']!,
  },
  {
    href: '/hormonal-gecis/menopoz/sicak-basmasi-gece-terlemesi',
    title: 'Sıcak Basması ve Gece Terlemesi',
    excerpt:
      'Vazomotor belirtilerin nedenleri, tetikleyicileri ve kanıt-temelli destek seçenekleri.',
    lede: 'Gece yarısı uyandıran o ısı dalgası rastgele değil; bedenin termostat ayarının ince bir düzenleme istemesi.',
    writerSlug: 'berna-aksoy',
    readingMinutes: 7,
    image: submenuHeroByRoute['/hormonal-gecis/menopoz/sicak-basmasi-gece-terlemesi']!,
  },
  {
    href: '/hormonal-gecis/menopoz/b12-vitamini-ve-menopoz',
    title: 'B12 Vitamini ve Menopoz: Sessiz Eksikliği Tanımak',
    excerpt:
      'Yorgunluk, unutkanlık, ellerde uyuşma — yaşa bağlamadan önce B12 ile menopozun nerede kesiştiğine bakan rehber.',
    lede: 'Belirtiler benziyor; mekanizmalar farklı. Tabloyu çözmek için önce ikisini birbirinden ayırt edebilmek gerekiyor.',
    writerSlug: 'rima-erdemir',
    readingMinutes: 9,
    image: submenuHeroByRoute['/hormonal-gecis/menopoz/b12-vitamini-ve-menopoz']!,
  },
  {
    href: '/hormonal-gecis/menopoz/menopozda-kemik-erimesi-onleme-ve-egzersiz',
    title: 'Kemik Erimesi: Önleme ve Egzersiz',
    excerpt:
      'Menopoz sonrası kemik kaybını yavaşlatan günlük direnç çalışmaları, beslenme ve izleme başlıklarını birlikte ele alan rehber.',
    lede: 'Kaslarım düşünmeden yanımda olsun istiyorum — kemikler sessiz çalışır, ama biz onları sessiz bırakmak zorunda değiliz.',
    writerSlug: 'alara-baykent',
    readingMinutes: 8,
    image: submenuHeroByRoute['/hormonal-gecis/menopoz/menopozda-kemik-erimesi-onleme-ve-egzersiz']!,
  },
];

// Editor's Pick — bu sub-hub için manuel atama (Magazine kapağı mantığı)
const featuredSlug = '/hormonal-gecis/menopoz/hrt-yillar-sonra-baslamak';
const editorPick = articles.find((a) => a.href === featuredSlug)!;
const tocArticles = articles.filter((a) => a.href !== featuredSlug);

const neighbors = [
  {
    href: '/hormonal-gecis/perimenopoz',
    title: 'Perimenopoz',
    excerpt: 'Geçişin ilk evresi: hormonların dalgalandığı, adet düzeninin değiştiği yıllar.',
  },
  {
    href: '/hormonal-gecis/menopoza-hazirlik',
    title: 'Menopoza Hazırlık',
    excerpt: 'Uyku, hareket ve beslenme başlıklarını birlikte düşünmek için hazırlık çerçevesi.',
  },
  {
    href: '/hormonal-gecis/40-sonrasi',
    title: '40 Sonrası Sağlık',
    excerpt: 'Koruyucu adımlar, tarama testleri ve uzun vadeli sağlık planlaması.',
  },
];
---

<SiteLayout
  title="Menopoz - Estranova"
  description="Menopoz dönemini anlamak için temel rehberler: tanım, hormon tedavisi kararı ve kemik sağlığı gibi sık okunan başlıklar."
>
  <SiteNavbar currentPath="/hormonal-gecis" />
  <ChapterMasthead number={chapter.number} parent={chapter.parent} chapter={chapter.chapter} />

  <main id="main-content" class="text-[#2D2D2D]">
    <SubmenuHero
      eyebrow="Hormonal Geçiş · Menopoz"
      title="Menopoz"
      lede="Menopoz, son adetten sonra geriye dönük tanımlanan bir dönemdir; östrojen ve progesteron düzeninde kalıcı bir değişim yaşanır. Burada bulacağınız içerikler bu dönemi anlamayı, kendi sorularınıza çerçeve bulmayı kolaylaştırmak içindir."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />

    <section class="border-b border-[#6B2D3E]/10 bg-[#FDF8F0] px-6 py-12 md:py-16">
      <div class="mx-auto max-w-6xl">
        <nav class="mb-8 text-sm text-[#2D2D2D]/60" aria-label="İçerik yolu">
          <ol class="flex flex-wrap items-center gap-2">
            <li>
              <a href="/hormonal-gecis" class="font-medium text-[#6B2D3E] hover:underline">Hormonal Geçiş</a>
            </li>
            <li aria-hidden="true">/</li>
            <li class="font-medium text-[#2D2D2D]">Menopoz</li>
          </ol>
        </nav>

        <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-start lg:gap-16">
          <div>
            <p class="mb-5 text-lg leading-relaxed text-[#2D2D2D]/82 md:text-xl">
              Menopoz pek çoğumuz için “gün gelip biten bir şey” değil, fark ettiğimiz an geriye dönük adlandırdığımız
              bir geçiş. Hormonal değişim sürse de günlük yaşamı yönetmenin yolları; kendi haritanızı çıkarmak ise her
              zamankinden mümkün.
            </p>
            <p class="text-base leading-relaxed text-[#2D2D2D]/72">
              Bu sayfa; menopozun tanımı, hormon tedavisi kararı ve uzun vadeli sağlık başlıklarına dair seçilmiş
              rehberleri bir araya getirir. Bireysel değerlendirme ve tedavi kararı her zaman hekiminizle yapılır.
            </p>
          </div>

          <aside
            class="rounded-[28px] border border-[#6B2D3E]/15 bg-white p-7 shadow-sm md:p-8"
            aria-labelledby="menopoz-ozet-baslik"
          >
            <h2 id="menopoz-ozet-baslik" class="mb-4 font-serif text-xl text-[#2D2D2D]">Bu evrede sık sorulanlar</h2>
            <ul class="space-y-4 text-sm leading-relaxed text-[#2D2D2D]/78">
              <li class="border-b border-[#6B2D3E]/10 pb-4">
                <span class="block font-semibold text-[#2D2D2D]">Menopoz ne zaman tanımlanır?</span>
                Son adetten sonra 12 ay geçtiğinde geriye dönük olarak; ortalama 45-55 yaş aralığında.
              </li>
              <li class="border-b border-[#6B2D3E]/10 pb-4">
                <span class="block font-semibold text-[#2D2D2D]">Hormon tedavisi herkese uygun mu?</span>
                Hayır; yaş, geçmiş öykü ve kişisel risk profiline göre değerlendirilir. Karar hekiminizle birlikte alınır.
              </li>
              <li>
                <span class="block font-semibold text-[#2D2D2D]">Belirtiler ne kadar sürer?</span>
                Kişiden kişiye değişir; bazıları için birkaç yıl, bazıları için daha uzun bir geçiş söz konusu olabilir.
              </li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    {epigraph && <EditorialEpigraph quote={epigraph} />}

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">Editör'ün Seçimi</p>
        <h2 class="font-serif text-3xl leading-tight md:text-4xl">Bu evreden bir okuma</h2>
      </header>

      <EditorPickCard
        href={editorPick.href}
        title={editorPick.title}
        lede={editorPick.lede}
        writerSlug={editorPick.writerSlug}
        readingMinutes={editorPick.readingMinutes}
        imageSrc={editorPick.image.src}
        imageAlt={editorPick.image.alt}
      />
    </SubmenuSection>

    <SubmenuSection variant="cream" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">Bu Evrede Okumalar</p>
        <h2 class="font-serif text-3xl leading-tight md:text-4xl">Sayının diğer başlıkları</h2>
      </header>

      <MagazineTOC items={tocArticles} />
    </SubmenuSection>

    <SubmenuSection variant="cream" borderedTop={true}>
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">Geçişin devamı</p>
      <h2 class="mb-8 font-serif text-2xl md:text-3xl">Komşu evreler</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          neighbors.map((n) => (
            <a
              href={n.href}
              class="group rounded-[26px] border border-[#6B2D3E]/12 bg-white p-7 transition hover:border-[#6B2D3E]/28 hover:shadow-sm"
            >
              <h3 class="mb-2 font-serif text-xl text-[#2D2D2D] group-hover:text-[#6B2D3E]">{n.title}</h3>
              <p class="mb-4 text-sm leading-relaxed text-[#2D2D2D]/72">{n.excerpt}</p>
              <span class="text-sm font-semibold text-[#6B2D3E] group-hover:underline">Sayfaya git →</span>
            </a>
          ))
        }
      </div>
    </SubmenuSection>

    <ChapterCompass nextHref={next?.href} nextNumber={next?.number} nextChapter={next?.chapter} nextParent={next?.parent} />
  </main>

  <SiteFooter />
</SiteLayout>
