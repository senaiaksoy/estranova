---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuSection from '../../../components/site/SubmenuSection.astro';
import ChapterMasthead from '../../../components/site/ChapterMasthead.astro';
import EditorialEpigraph from '../../../components/site/EditorialEpigraph.astro';
import ChapterCompass from '../../../components/site/ChapterCompass.astro';
import EditorPickCard from '../../../components/site/EditorPickCard.astro';
import MagazineTOC from '../../../components/site/MagazineTOC.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { chapterMap, getNextChapter } from '../../../data/chapter-map';
import { subHubEpigraphs } from '../../../data/sub-hub-epigraphs';

const hero = submenuHeroByRoute['/hormonal-gecis/menopoz']!;
const __path = '/hormonal-gecis/menopoz';
const chapter = chapterMap[__path]!;
const epigraph = subHubEpigraphs[__path];
const next = getNextChapter(__path);

interface ArticleEntry {
  href: string;
  title: string;
  excerpt: string;
  lede: string;
  writerSlug: string;
  readingMinutes: number;
  image: { src: string; alt: string };
}

const articles: ArticleEntry[] = [
  {
    href: '/hormonal-gecis/menopoz/menopoz-nedir',
    title: 'Menopoz Nedir? — Temel Rehber',
    excerpt:
      'Tanım, evreler, hormon değişimleri ve uzun vadeli sağlık gündemi.',
    lede: 'Menopoz pek çoğumuz için "gün gelip biten bir şey" değil; fark ettiğimiz an geriye dönük adlandırdığımız bir geçiş.',
    writerSlug: 'berna-aksoy',
    readingMinutes: 8,
    image: submenuHeroByRoute['/hormonal-gecis/menopoz']!,
  },
  {
    href: '/hormonal-gecis/menopoz/hormon-tedavisi-karar-rehberi',
    title: 'Hormon Tedavisi: Karar Rehberi',
    excerpt:
      'HRT ne zaman gündeme gelir, kim için uygundur, neye dikkat edilir.',
    lede: 'Bilgilendirilmiş karar; aceleye getirilmiş bir tercih değil, planlı bir okumayla başlayan bir süreç.',
    writerSlug: 'berna-aksoy',
    readingMinutes: 10,
    image: submenuHeroByRoute['/hormonal-gecis/menopoz/hormon-tedavisi-karar-rehberi']!,
  },
  {
    href: '/hormonal-gecis/menopoz/hrt-yan-etkileri-ve-izleme',
    title: 'HRT Yan Etkileri ve İzleme — İlk Aylar',
    excerpt:
      'İlk haftaların yumuşak yan etkileri, kanama düzeninde değişimler, üç–altı–on iki aylık izleme takvimi ve gecikmeden hekime götürülmesi gereken alarm belirtileri.',
    lede: 'HRT\'ye başlayan hemen herkesin mutfak tezgâhının bir köşesinde, görünmez bir defter var — beklenenle yaşanan arasındaki aralığı yazarak öğreniyoruz.',
    writerSlug: 'berna-aksoy',
    readingMinutes: 10,
    image: submenuHeroByRoute['/hormonal-gecis/menopoz/hrt-yan-etkileri-ve-izleme']!,
  },
  {
    href: '/hormonal-gecis/menopoz/menopozda-hekim-hasta-iliskisi',
    title: 'Eşim Hekim, Hekimim Başkası — Modern Kadın Menopoz Takibinde Ne Arıyor',
    excerpt:
      'Hekim-hasta ilişkisinin yıllar içinde nasıl olgunlaştığına dair kişisel notlar; dört doktor profili, paydaş karar verme ve etik bir mesafenin önemi.',
    lede: 'Eşim jinekolog ama beni takip eden hekim o değil — bu, etik bir tercih. Bu yazı bir cevap değil, kendime sorduğum bir soru: modern kadın menopoz takibinde hekiminden ne arıyor?',
    writerSlug: 'berna-aksoy',
    readingMinutes: 10,
    image: submenuHeroByRoute['/hormonal-gecis/menopoz/menopozda-hekim-hasta-iliskisi']!,
  },
  {
    href: '/hormonal-gecis/menopoz/sicak-basmasi-gece-terlemesi',
    title: 'Sıcak Basması ve Gece Terlemesi',
    excerpt:
      'Vazomotor belirtilerin nedenleri, tetikleyicileri ve kanıt-temelli destek seçenekleri.',
    lede: 'Gece yarısı uyandıran o ısı dalgası rastgele değil; bedenin termostat ayarının ince bir düzenleme istemesi.',
    writerSlug: 'berna-aksoy',
    readingMinutes: 7,
    image: submenuHeroByRoute['/hormonal-gecis/menopoz/sicak-basmasi-gece-terlemesi']!,
  },
  {
    href: '/hormonal-gecis/menopoz/tarti-yatisinca-vucut-kompozisyonu',
    title: 'Tartı yatışınca geriye kalan: vücut kompozisyonunun sessiz kayması',
    excerpt:
      'Tartı sayısı uzun zamandır pek değişmiyor; ama beden değişmeye devam ediyor. Menopozun ölçüye gelmeyen tarafına — kas-yağ oranındaki sessiz kaymaya — sakin bir gözlemcinin günlüğünden bakış.',
    lede: 'Bir noktada şunu fark ettim — tartı uzun zamandır pek değişmiyordu, ama beden değişmeye devam ediyordu. Sayı yatışınca geriye kalan, ölçüye tam gelmeyen bir kayış.',
    writerSlug: 'berna-aksoy',
    readingMinutes: 9,
    image: submenuHeroByRoute['/hormonal-gecis/menopoz/tarti-yatisinca-vucut-kompozisyonu']!,
  },
];

// Editor's Pick — bu sub-hub için manuel atama (Magazine kapağı mantığı)
const featuredSlug = '/hormonal-gecis/menopoz/menopoz-nedir';
const editorPick = articles.find((a) => a.href === featuredSlug)!;
const tocArticles = articles.filter((a) => a.href !== featuredSlug);

const neighbors = [
  {
    step: '01',
    href: '/hormonal-gecis/perimenopoz',
    title: 'Perimenopoz',
    excerpt: 'Geçişin ilk evresi: hormonların dalgalandığı, adet düzeninin değiştiği yıllar.',
  },
  {
    step: '02',
    href: '/hormonal-gecis/menopoza-hazirlik',
    title: 'Menopoza Hazırlık',
    excerpt: 'Uyku, hareket ve beslenme başlıklarını birlikte düşünmek için hazırlık notu.',
  },
  {
    step: '03',
    href: '/hormonal-gecis/40-sonrasi',
    title: '40 Sonrası Sağlık',
    excerpt: 'Koruyucu adımlar, tarama testleri ve uzun vadeli sağlık planlaması.',
  },
];
---

<SiteLayout
  title="Menopoz - Estranova"
  description="Menopoz dönemini anlamak için temel rehberler: tanım, hormon tedavisi kararı ve kemik sağlığı gibi sık okunan başlıklar."
>
  <SiteNavbar currentPath="/hormonal-gecis" />
  <ChapterMasthead number={chapter.number} parent={chapter.parent} chapter={chapter.chapter} />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Hormonal Geçiş · Menopoz"
      title="Menopoz"
      lede="Menopoz, son adetten sonra geriye dönük tanımlanan bir dönemdir; östrojen ve progesteron düzeninde kalıcı bir değişim yaşanır. Burada bulacağınız içerikler bu dönemi anlamayı, kendi sorularınıza daha net bir yön bulmayı kolaylaştırmak içindir."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />

    <section class="border-b border-burgundy/10 bg-[#fffaf0] px-6 py-14 md:py-18">
      <div class="mx-auto max-w-6xl">
        <nav class="mb-8 text-sm text-ink/60" aria-label="İçerik yolu">
          <ol class="flex flex-wrap items-center gap-2">
            <li>
              <a href="/hormonal-gecis" class="font-medium text-burgundy hover:underline">Hormonal Geçiş</a>
            </li>
            <li aria-hidden="true">/</li>
            <li class="font-medium text-ink">Menopoz</li>
          </ol>
        </nav>

        <div class="grid gap-12 lg:grid-cols-[1.12fr_0.88fr] lg:items-start lg:gap-16">
          <div>
            <p class="mb-6 max-w-3xl font-serif text-3xl italic leading-tight text-burgundy md:text-5xl">
              Menopoz bir kapanış değil; bedenin yeni düzenini okumayı öğrendiğimiz uzun bir eşiktir.
            </p>
            <p class="mb-5 text-lg leading-relaxed text-ink/82 md:text-xl">
              Menopoz pek çoğumuz için “gün gelip biten bir şey” değil, fark ettiğimiz an geriye dönük adlandırdığımız
              bir geçiş. Hormonal değişim sürse de günlük yaşamı yönetmenin yolları; kendi haritanızı çıkarmak ise her
              zamankinden mümkün.
            </p>
            <p class="text-base leading-relaxed text-ink/72">
              Bu sayfa; menopozun tanımı, hormon tedavisi kararı ve uzun vadeli sağlık başlıklarına dair seçilmiş
              rehberleri bir araya getirir. Bireysel değerlendirme ve tedavi kararı her zaman hekiminizle yapılır.
            </p>
          </div>

          <aside
            class="border-y border-burgundy/15 bg-white/62 p-7 md:p-8"
            aria-labelledby="menopoz-ozet-baslik"
          >
            <h2 id="menopoz-ozet-baslik" class="mb-5 font-serif text-3xl leading-tight text-ink">Bu evrede sık sorulanlar</h2>
            <ul class="space-y-4 text-sm leading-relaxed text-ink/78">
              <li class="border-b border-burgundy/10 pb-4">
                <span class="block font-semibold text-ink">Menopoz ne zaman tanımlanır?</span>
                Son adetten sonra 12 ay geçtiğinde geriye dönük olarak; ortalama 45-55 yaş aralığında.
              </li>
              <li class="border-b border-burgundy/10 pb-4">
                <span class="block font-semibold text-ink">Hormon tedavisi herkese uygun mu?</span>
                Hayır; yaş, geçmiş öykü ve kişisel risk profiline göre değerlendirilir. Karar hekiminizle birlikte alınır.
              </li>
              <li>
                <span class="block font-semibold text-ink">Belirtiler ne kadar sürer?</span>
                Kişiden kişiye değişir; bazıları için birkaç yıl, bazıları için daha uzun bir geçiş söz konusu olabilir.
              </li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    {epigraph && <EditorialEpigraph quote={epigraph} />}

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-12 grid gap-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-end">
        <p class="text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Editör'ün Seçimi</p>
        <h2 class="font-serif text-4xl leading-[0.95] tracking-[-0.04em] md:text-6xl">Bu evreden bir okuma</h2>
      </header>

      <EditorPickCard
        href={editorPick.href}
        title={editorPick.title}
        lede={editorPick.lede}
        writerSlug={editorPick.writerSlug}
        readingMinutes={editorPick.readingMinutes}
        imageSrc={editorPick.image.src}
        imageAlt={editorPick.image.alt}
      />
    </SubmenuSection>

    <SubmenuSection variant="cream" borderedTop={true}>
      <header class="mb-12 grid gap-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-end">
        <p class="text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Bu Evrede Okumalar</p>
        <h2 class="font-serif text-4xl leading-[0.95] tracking-[-0.04em] md:text-6xl">Sayının diğer başlıkları</h2>
      </header>

      <MagazineTOC items={tocArticles} />
    </SubmenuSection>

    <SubmenuSection variant="cream" borderedTop={true}>
      <header class="mb-10 grid gap-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-end">
        <p class="text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Geçişin devamı</p>
        <h2 class="font-serif text-4xl leading-[0.95] tracking-[-0.04em] md:text-6xl">Komşu evreler</h2>
      </header>
      <div class="divide-y divide-burgundy/14 border-y border-burgundy/14">
        {
          neighbors.map((n) => (
            <a
              href={n.href}
              class="group grid gap-5 py-7 transition hover:bg-white/58 md:grid-cols-[88px_1fr_auto] md:items-center md:py-8"
            >
              <span class="font-serif text-3xl italic text-gold">{n.step}</span>
              <div>
                <h3 class="mb-2 font-serif text-3xl leading-tight text-ink group-hover:text-burgundy">{n.title}</h3>
                <p class="max-w-2xl text-sm leading-relaxed text-ink/72">{n.excerpt}</p>
              </div>
              <span class="text-2xl text-gold transition group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </SubmenuSection>

    <ChapterCompass nextHref={next?.href} nextNumber={next?.number} nextChapter={next?.chapter} nextParent={next?.parent} />
  </main>

  <SiteFooter />
</SiteLayout>
