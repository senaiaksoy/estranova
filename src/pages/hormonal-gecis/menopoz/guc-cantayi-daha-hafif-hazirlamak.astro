---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import SaveForLaterButton from '../../../components/site/SaveForLaterButton.astro';
import ReadingControls from '../../../components/site/ReadingControls.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import MedicalContextNote from '../../../components/site/MedicalContextNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { resolveSiteUrl } from '../../../utils/seo';

const pathname = '/hormonal-gecis/menopoz/guc-cantayi-daha-hafif-hazirlamak/';
const hero = submenuHeroByRoute['/hormonal-gecis/menopoz/']!;
const articleTitle = 'Güç Dediğiniz Şey Bazen Çantayı Daha Hafif Hazırlamaktır';
const seoTitle = 'Güç Dediğiniz Şey — Çantayı Hafifletmek';
const articleDescription =
  'Başak Pelister, dokuz yıllık menopoz deneyiminden yola çıkarak güç, günlük yükler ve anne-kız konuşmaları üzerine düşünüyor.';
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'basak-pelister',
  articleType: 'experience-essay',
  publishedDate: '1 Haziran 2026',
  modifiedDate: '15 Ekim 2026',
  medicalReviewer: 'Dr. Alper Mumcu',
  medicalReviewerTitle: 'Kadın Hastalıkları ve Doğum Uzmanı',
  pathname,
  articleSection: 'Hormonal Geçiş · Menopoz',
  sectionPath: '/hormonal-gecis/menopoz/',
  keywords: ['menopoz deneyimi', 'HRT yolculuğu', '40 sonrası güç', 'menopozda yorgunluk', 'anne kız sohbeti', 'beden farkındalığı', 'günlük hayat'],
  siteUrl: resolveSiteUrl(Astro.site),
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  image="/images/library/editorial/basak-guc-canta-hafifletmek.webp"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/hormonal-gecis/" />
  <main id="main-content" class="text-ink">
    <SubmenuHero eyebrow="Hormonal Geçiş · Menopoz" title={articleTitle} imageSrc={hero.src} imageAlt={hero.alt} compact />
    <SubmenuArticleBody>
      <ArticleAuthorBlock
        authorSlug="basak-pelister"
        articleType="experience-essay"
        publishedDate="1 Haziran 2026"
        lastUpdated="15 Ekim 2026"
        medicalReviewer="Dr. Alper Mumcu"
        readingMinutes={4}
        imageSrc="/images/library/editorial/basak-guc-canta-hafifletmek-byline.webp"
        imageAlt="Açık gardırobun yanında duran ve aynada yansıması görünen bir kadın."
        imagePosition="left center"
      />
      <div class="flex flex-wrap items-center justify-end gap-3">
        <ReadingControls />
        <SaveForLaterButton slug={pathname} title={articleTitle} />
      </div>
      <ArticleSummary title="Bu yazıya başlarken">
        <p>
          Menopozdan sonra güçten ne anladığım değişti. Her şeye yetişmeye çalışırken kendimden ne
          beklediğimi, neyi başkasına bırakabileceğimi de düşünmeye başladım.
        </p>
      </ArticleSummary>
      <ArticleProsePanel mode="experience">
        <h2 id="canta">Aslında Her Şey Bir Çantayla Başladı...</h2>
        <p>
          Hepimizin yaşadığı bir an vardır: evden çıkmadan önce çantaya bir şey daha koyarız. Sonra bir
          şey daha... Merdivene geldiğimizde omzumuzdaki ağırlığı hissederiz.
        </p>
        <p>
          Ben bunu yıllarca “hazırlıklı olmak” sandım. Gözlük, şal, su, küçük çanta içinde başka küçük
          çanta, belki lazım olur diye bir şey daha. Bir gün merdiven çıkarken kendime sordum: gerçekten
          ihtiyacım olanı mı taşıyorum, yoksa her ihtimale karşı kendimi mi yoruyorum?
        </p>
        <p>
          Çantayı yere koyup içinden üç şey çıkardım. Dünya değişmedi. Omzum rahatladı.
        </p>

        <h2 id="guc-ne">Güç Benim İçin Kapasiteye Dönüştü</h2>
        <p>
          Güç kelimesi bazen fazla sert geliyor. Sanki hep daha fazlasını kaldırmak, daha çok dayanmak,
          daha az yorulmak zorundayız.
        </p>
        <p>
          Menopozdan sonra güç benim için yavaş yavaş başka bir kelimeye dönüştü: kapasite.
          Bugün neyi yapabilirim, neyi bölebilirim, neyi başkasına bırakabilirim?
        </p>
        <p>
          Eskiden “yaparım” demeyi çok severdim. Şimdi ise her davete evet demeden önce duruyorum. Bir işi yapabilecek olmakla o gün ona zaman ve enerji ayırabilmek
          aynı şey mi? Kendime bunu sorduğumda, “yaparım” cevabımın bazen eski bir alışkanlık olduğunu fark ediyorum.
        </p>

        <h2 id="dokuz-yil">Dokuz Yıllık Menopozdan Sonra Sabahlar</h2>
        <p>
          Dokuz yılda uykunun ve sabah enerjisinin değerini daha çok fark ettim.
        </p>
        <p>
          Sıcak basmasıyla sosyal hayatımı ayarlıyorum. Merdivende ne kadar yorulduğuma bile dikkat ediyorum...
          Başta birbirinden ayrı görünen bu gündelik deneyimler, zamanla kendimden beklediklerimi yeniden düşünmeme yol açtı.
        </p>
        <p>
          Yakın dönemde hormon replasman tedavisine (HRT) başlama kararımı da hekimimle konuşarak aldım.
          Kişisel risklerim ve düzenli takip bu kararın parçasıydı. Sizin için uygun olan yol farklı olabilir;
          kendi hekiminizle değerlendirmeniz gerekir.
        </p>

        <h2 id="anne-kiz">Üç Kuşak, Aynı Kelime</h2>
        <p>
          Annem, ben ve kızım güç kelimesine farklı anlamlar veriyoruz.
        </p>
        <p>
          Annem için güç, uzun süre şikâyet etmeden ve kimseye yük olmadan yapmak demekti. Kızımın kuşağında daha çok
          “sınırımı biliyorum” cümlesine benziyor. Ben ikisinin arasında, eski reflekslerimle yeni
          fark ettiklerim arasında gidip geliyorum. Siz hangi kuşağın cümlesine daha yakınsınız?
        </p>
        <p>
          Bu konuşmalarda şunu seviyorum: sıcak basmasını, uykuyu, enerjiyi, cinsel istekteki değişimi
          konuşabiliyoruz. Menopoz aile içinde saklanması gereken bir konu olmaktan çıkıyor.
          Bazen kızımın tek bir bakışı bile kendi alışkanlıklarıma dışarıdan bakmama yetiyor.
        </p>

        <span id="self-care" aria-hidden="true"></span>
        <h2 id="bedenle-anlasma">Yorgunluğu Planın Parçası Yapmak</h2>
        <p>
          Kendine bakım sözünü bazen fazla süslü buluyorum. Oysa günün planında dinlenmeye yer bırakmak
          da bunun parçası.
        </p>
        <p>
          Uykusuz kaldığımda ya da fazla yüklendiğimde daha çabuk yorulduğumu fark ediyorum.
          Eskiden “niye böyle oldum?” diye düşünürdüm; şimdi o gün neleri yapabileceğime daha sakin
          bakmaya çalışıyorum. Hepimiz bilir: uykusuz bir gecenin ertesi sabahı her şey ağır gelir.
        </p>

        <p>
          Her gün iyi hissetmiyorum. Böyle günlerde kendime kızmadan bunu kabul etmeyi öğreniyorum. Önce şunu söyleyeyim: iyi hissetmediğiniz günler bir başarısızlık değil.
        </p>
        <p>
          Bugün çantadan neyi çıkaracağımı biliyorum. Günün planından neyi çıkaracağımı bulmaksa
          bazen hâlâ daha zor.
        </p>
      </ArticleProsePanel>

      <MedicalContextNote class="mt-14" reviewer="Dr. Alper Mumcu">
        <p>
          40 yaş sonrasında fiziksel aktivite, menopoz döneminde de kas kütlesini ve gücünü korumaya yardımcı olur.
          Kemik sağlığı, metabolik sağlık, uyku ve enerjiyle ilgili yakınmalar, kişinin sağlık geçmişi ve mevcut
          durumuyla birlikte değerlendirilir.
        </p>
        <p>
          HRT kararı yakınmalar, yaş, menopozdan geçen süre ve kişisel riskler dikkate alınarak verilir.
          Meme sağlığı, rahmin bulunup bulunmaması, pıhtı riski ve kalp-damar öyküsü değerlendirmede önemlidir.
          Bu değerlendirme, kişiye uygun tedavi seçiminin ve takip planının temelini oluşturur.
        </p>
      </MedicalContextNote>

      <RelatedReadings class="mt-14" paths={[
        '/hormonal-gecis/menopoz/dokuz-yillik-menopoz-sonunda-hrt-karari/',
        '/hormonal-gecis/menopoz/hrt-ilk-alti-ay/',
        '/zamansiz-yasam/40-sonrasi-harekete-yeniden-baslamak/',
      ]} />
      <ArticleDisclaimer class="mt-10">
        <p>
          Bu içerik genel bilgilendirme ve kişisel deneyim aktarımı amaçlıdır. Tanı, tedavi, HRT kararı,
          ilaç düzenlemesi veya kişisel tıbbi öneri yerine geçmez. Menopoz yakınmalarınız, sağlık geçmişiniz
          veya tedavi seçenekleriniz için sağlık profesyoneliyle bireysel değerlendirme yapınız.
        </p>
      </ArticleDisclaimer>
    </SubmenuArticleBody>
  </main>
  <SiteFooter />
</SiteLayout>
