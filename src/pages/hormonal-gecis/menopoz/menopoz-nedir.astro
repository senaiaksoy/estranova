---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../../components/site/ArticleFAQ.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { articleFaqs } from '../../../data/article-faqs';
import { resolveSiteUrl } from '../../../utils/seo';

const tocEntries = [
  { id: 'esik', label: 'Geriye dönük netleşen eşik' },
  { id: 'evreler', label: 'Üç evre: perimenopoz, menopoz, postmenopoz' },
  { id: 'hormon-degisim', label: 'Hormon değişimleri bu evrede' },
  { id: 'belirtiler', label: 'Belirtiler ve postmenopoz dönemi' },
  { id: 'saglik-gundemi', label: 'Uzun vadeli sağlık ve izlem' },
  { id: 'iyi-olus', label: 'İyi oluşu destekleyen alışkanlıklar' },
  { id: 'sik-sorulanlar', label: 'Tanım hakkında sorular', numbered: false },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Menopoz Nedir? — Temel Rehber';
const seoTitle = 'Menopoz Nedir? Belirtileri ve Evreleri';
const articleDescription =
  'Menopoz nedir, kaç yaşında başlar, belirtileri nelerdir? Perimenopoz, menopoz ve postmenopoz evreleri, östrojen değişimi ve 40+ başlangıç rehberi.';
const pathname = '/hormonal-gecis/menopoz/menopoz-nedir/';
const publishedDate = '11 Mayıs 2026';
const modifiedDate = '22 Ekim 2026';
const readingMinutes = 7;
const hero = submenuHeroByRoute['/hormonal-gecis/menopoz/']!;
const faqItems = articleFaqs[pathname] ?? [];
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'estranova-editorial',
  articleType: 'editorial-guide',
  publishedDate,
  modifiedDate,
  pathname,
  articleSection: 'Hormonal Geçiş',
  sectionPath: '/hormonal-gecis/',
  keywords: ['menopoz nedir', 'menopoz belirtileri', 'menopoz kaç yaşında başlar', 'menopoz evreleri', 'perimenopoz', 'postmenopoz', 'FSH', 'östrojen'],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/hormonal-gecis/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Hormonal Geçiş · Menopoz"
      title={articleTitle}
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="estranova-editorial"
        articleType="editorial-guide"
        publishedDate={publishedDate}
        lastUpdated={modifiedDate}
        readingMinutes={readingMinutes}
        imageSrc="/images/library/editorial/portrait-cream-turtleneck-smile.webp"
        imageAlt="Doğal ışıkta gülümseyen, krem kazak ve altın yuvarlak küpe takmış 50'li yaşlardaki bir kadının yakın editöryal portresi"
      />

      <ArticleSummary title="Kısa Özet">
        <p>
          Menopoz, son adetten sonra ardışık on iki ay adet görmeyince geriye dönük teyit edilen doğal bir eşiktir.
          Ortalama yaş 51–52 olarak bildiriliyor; dağılım 45–55 bandında yoğunlaşıyor, kişisel zaman çizgisi ise
          farklılaşıyor. Perimenopoz, menopoz ve postmenopoz ayrı gündemler taşır: belirtiler değişirken uzun vadeli
          odak kemik ve kalp-metabolizma dengesine kayar.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="esik">Geriye Dönük Netleşen Bir Eşik</h2>
        <p>
          Takvimde bir işaret, sonra iki ay boşluk, sonra yine bir leke. İsim henüz yok.
        </p>
        <p>
          Belirsizlik yorar. Adı konmayınca kendinizi savruk hissedebilirsiniz; oysa takvim düzgün durmak ister,
          adet o kadar uysal olmayabilir.
        </p>
        <p>
          Önce şunu söyleyeyim: bu eşiği kaçırmış değilsiniz. Tanım zaten geriye bakar — o gün değil, bir yıl sonra
          anlaşılır.
        </p>
        <p>
          Menopoz tıbbi olarak sadedir: son adet kanamasının üzerinden on iki ay geçmesi. Perimenopoz bu eşiğe uzanan
          geçiştir; postmenopoz sonraki yılların tamamını kapsar.
        </p>
        <p>
          Günlük dilde “menopoz” bazen bütün süreci anlatır. Evreler ayrı durur, çünkü her birinin sağlık sorusu
          farklıdır: dalgalanma başka, kemik ve kalp izlemi başkadır.
        </p>
        <p>
          Büyük çalışmalarda ortalama menopoz yaşı 51–52 olarak bildiriliyor; genel dağılım 45–55 bandında
          yoğunlaşıyor. Genetik yapı, sigara kullanımı ve bazı tedaviler bu zamanlamayı öne ya da arkaya çekebilir.
          Tek doğru yaş yoktur; kişisel bir zaman çizgisi vardır.
        </p>

        <h2 id="evreler">Üç Evre: Perimenopoz, Menopoz, Postmenopoz</h2>
        <p>
          Tek kelimeye sığmayan bir dönemi üç başlıkta düşünmek, sizin takviminizi okumayı kolaylaştırır.
        </p>
        <p>
          <strong>Perimenopoz</strong> hormon dalgalanmalarının belirginleştiği geçiş dönemidir. İlk adet
          düzensizliğiyle başlar, son adet gününe kadar sürer. Gözlemsel veriler ortalama süreyi 4–8 yıl olarak
          gösteriyor; bu da kişiden kişiye önemli ölçüde farklılaşıyor.
        </p>
        <p>
          <strong>Menopoz</strong>, perimenopozun bittiği yerde geriye dönük teyit edilen eşiktir. Bir gerçekleşmedir;
          takvim yaprağı gibi tek bir güne indirgenmez.
        </p>
        <p>
          <strong>Postmenopoz</strong> bu eşiğin ardından yaşamın geri kalanını kapsar. Belirtiler değişebilir; sağlık
          gündeminin ağırlık merkezi de kayar.
        </p>

        <div class="my-8 overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-primary/20 bg-primary/5 text-ink font-serif">
                <th class="p-3 font-semibold">Evre</th>
                <th class="p-3 font-semibold">Ne zaman?</th>
                <th class="p-3 font-semibold">Hormonlar</th>
                <th class="p-3 font-semibold">Bu evrede öne çıkan</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-primary/10">
              <tr>
                <td class="p-3 font-medium">Perimenopoz</td>
                <td class="p-3">İlk adet düzensizliğiyle başlar, son adet gününe kadar sürer (ortalama 4–8 yıl).</td>
                <td class="p-3">Östrojen dalgalanır, progesteron azalır.</td>
                <td class="p-3">Sıcak basması, uykusuzluk, adet düzensizliği.</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Menopoz</td>
                <td class="p-3">Ardışık 12 ay hiç adet görmeyince geriye dönük teyit edilir.</td>
                <td class="p-3">Yumurtalık östrojen üretimi kalıcı olarak düşmüştür.</td>
                <td class="p-3">Eşiğin netleşmesi, yaşam tarzı ve hekimle değerlendirme.</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Postmenopoz</td>
                <td class="p-3">12 aylık menopoz eşiğinden sonraki yaşamın tamamını kapsar.</td>
                <td class="p-3">Östrojen düşük seviyede durulur, FSH yüksek seyreder.</td>
                <td class="p-3">Kemik yoğunluğu, kalp-metabolizma, vajinal ve idrar yolu konforu.</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          Perimenopozda düzensiz adet ve sıcak basması öne çıkarken; postmenopozda kemik yoğunluğu ile kalp-metabolizma
          dengesi daha düzenli bir takibi hak eder. Bu fark, sizin sağlık planınızı döneme göre kurmanıza yardım eder.
        </p>

        <h2 id="hormon-degisim">Hormon Değişimleri Bu Evrede</h2>
        <p>
          “Östrojen düştü” diye özetlenir bu dönem. Tablo biraz daha kalabalık.
        </p>
        <p>
          Folikül uyarıcı hormon (FSH) ve yumurtlamayı uyaran hormon (LH) yükselir; bu, yumurtalık yanıtının
          azalmasına bağlı tanınan bir biyolojik bulgudur <Evidence level={4} />. Östrojen ve progesteron düzeylerinde kalıcı bir
          düşüş gözlenir <Evidence level={4} />. Postmenopozda bu yeni denge daha durulur, dalgalanma hafifler; tüm
          belirtilerin birden bittiği anlamına gelmez.
        </p>
        <p>
          Hormon ölçümleri bu dönemde tek başına karar aracı değildir. Belirtiler, yaş, adet öyküsü ve diğer sağlık
          verileriyle birlikte anlam kazanır. Düzensiz geçişte tek bir kan sonucu sizi yanıltabilir; o sayı bütün
          hikâyeyi taşımak zorunda değildir.
        </p>

        <h2 id="belirtiler">Belirtiler ve Postmenopoz Dönemi</h2>
        <p>
          Sıcak basması gece terlemesine, uyku bölünmesine bakıyor olabilirsiniz. “Bitti mi?” sorusu tek başına yetmez.
        </p>
        <p>
          En sık yaşanan değişim, sıcak basması ve gece terlemesinin zamanla hafiflemesidir. Bu eğilim genel nüfus
          çalışmalarında gözlemleniyor — bireysel dağılım ise geniş <Evidence level={3} />. Kiminde yıllarca sürebilir,
          kiminde beklenenden erken geçer. Uyku kalitesindeki bozulma, cilt ve mukozalarda kuruluk, libido değişimi ya
          da odaklanma güçlüğü bazı kadınlarda bir süre daha eşlik edebilir.
        </p>
        <p>
          Bu dönemde yeni başlıklar da gündeme girer: metabolik hızdaki değişim, yağ dağılımının karın çevresine
          kayması, kalp-damar risk profilindeki bireysel farklılaşmalar. Bunlar belirti yönetiminin yanında sağlık
          gündeminin yeni katmanlarını oluşturur.
        </p>
        <p>
          Postmenopozun ilk yılları sağlık takvimini yeniden kurmak için iyi bir başlangıç noktasıdır. Vücut yeni
          dengeye alışırken kemik kaybı görece hızlanabiliyor — bu gözlemsel verilerle destekleniyor
          <Evidence level={4} />. Düzenli hareket,
          yeterli protein, kalsiyum ve D vitamini dengesi önem taşır. Kemik mineral yoğunluğu değerlendirmesinin
          zamanlaması kişisel öykünüze ve hekimle yapılan plana göre şekillenir.
        </p>
        <p>
          Kan basıncı, lipid profili, glukoz ve bel çevresi gibi verilerin izlenmesi de erken dönemde düzenleme fırsatı
          sağlar. Hangisinin ne sıklıkla takip edileceği herkese aynı ölçekte geçerli değildir; bireysel risk öyküsü
          belirleyicidir.
        </p>

        <h2 id="saglik-gundemi">Uzun Vadeli Sağlık ve İzlem</h2>
        <p>
          Liste uzun görünebilir. Sırayı kurmak yeter.
        </p>
        <p>
          Çoğu kadında üç ana eksen ortaklaşır: kemik sağlığı, kalp-metabolizma dengesi ve zihinsel iyi oluş. Tarama
          testlerini kişisel öyküye göre planlamak, yaşam alışkanlıklarını sürdürülebilir şekilde kurmak ve gerektiğinde
          tıbbi destek almak bu yolun temelini oluşturur. Hormon tedavisi (HRT) ve diğer seçenekler herkes için aynı
          değildir; kişisel risk-fayda dengesiyle, hekimle birlikte değerlendirilen kararlardır.
        </p>
        <p>
          Eşik netleştikten sonraki ilk yıl, izlenebilir bir ritim kurmak için değerlidir. Haftalık hareket planı,
          öğünlerde protein ve lif dengesi, sabit uyku saatleri günü tutmaya yardım eder. Hangi göstergenin ne sıklıkta
          izleneceği sizin planınızda, hekimle yapılan değerlendirmeye göre kişiselleşir.
        </p>

        <h2 id="iyi-olus">İyi Oluşu Destekleyen Alışkanlıklar</h2>
        <p>
          Büyük bir dönüşüm projesi kurmak zorunda değilsiniz.
        </p>
        <p>
          Düzenli hareket — özellikle kas kütlesini koruyan egzersizler — menopoz sonrası dönemde sık öne çıkan
          alışkanlıklardan biridir. Direnç egzersizi ile tempolu yürüyüşü birlikte planlamak, kemik ve metabolik dengeye
          eş zamanlı yardımcı olabilir. Beslenmede yeterli protein, renkli sebze-meyve ve kaliteli yağ kaynakları temel
          yolu oluşturur. Hangi düzeyin size uyduğu bireysel bir sorudur; genel öneriler başlangıç noktasıdır, kişisel
          plan hekim değerlendirmesiyle şekillenir.
        </p>
        <p>
          Duygusal iyi oluş tarafında sosyal bağları korumak ve stresi düzenleyen küçük rutinler kurmak önemlidir. Kısa
          nefes egzersizleri, gün ışığında yürüyüş, ekran süresini yönetmek ruh hali ve uyku kalitesi için destekleyici
          olabilir.
        </p>
        <p>
          Adet belirsizliğinin sona ermesi, bazı kadınlar için zaman ve enerji yönetimini sadeleştirir. Kemik, kalp,
          beslenme ve uyku üzerinden kurulmuş küçük bir ritim, sizin için bu eşiği planlı bir başlangıca çevirebilir.
        </p>
      </ArticleProsePanel>

      <ArticleFAQ
        id="sik-sorulanlar"
        title="Menopoz tanımı hakkında sorular"
        intro="Eşiğin nasıl kurulduğu, belirtilerin ne zaman değiştiği ve sonrasında hangi sağlık başlıklarının öne çıktığı üzerine üç kısa soru."
        items={faqItems}
        class="mt-10"
      />

      <RelatedReadings
        class="mt-14"
        paths={[
          '/hormonal-gecis/40-sonrasi/',
          '/zamansiz-yasam/kemik-gucu-kirigi-beklemeden-sorulacak-sorular/',
          '/bilimsel-pencere/hormonlarin-bilimi/estrogen-biyolojisi-saglik/',
        ]}
      />

      <ArticleEditorNote>
        <p class="mb-3 leading-relaxed text-ink/80">
          Menopoz bir hastalık değil, yaşamın doğal evrelerinden biridir. Klinik tanım son adetin üzerinden on iki ay
          geçmesiyle geriye dönük olarak konulur. Perimenopoz, menopoz ve postmenopoz farklı hormonal dinamikler ve
          sağlık öncelikleri taşır; evreler karışınca sorulan sağlık sorusu da kayar.
        </p>
        <p class="mb-3 leading-relaxed text-ink/80">
          Folikül uyarıcı hormon (FSH) yükselişi ile östrojen ve progesteron düşüşü bu evrenin beklenen biyolojik
          tablosudur. Tek bir hormon ölçümü tanı için yeterli değildir; klinik bulgu, yaş ve adet öyküsüyle birlikte
          okunur. Uzun vadeli izlemin kapsamı kişisel risk öyküsüne göre şekillenir.
        </p>
        <p class="text-sm italic text-primary">
          — Doç. Dr. Senai Aksoy, Estranova Bilimsel Editörü
        </p>
      </ArticleEditorNote>

      <ArticleDisclaimer>
        <p>
          Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavinin yerini almaz. Sağlık
          kararlarınız için kendi hekiminizle birlikte değerlendirme yapınız.
        </p>
      </ArticleDisclaimer>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
