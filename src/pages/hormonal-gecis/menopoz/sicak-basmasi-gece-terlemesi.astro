---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { articleFaqs } from '../../../data/article-faqs';
import { resolveSiteUrl } from '../../../utils/seo';

const hero = submenuHeroByRoute['/hormonal-gecis/menopoz/sicak-basmasi-gece-terlemesi/']!;

const tocEntries = [
  { id: 'nedir', label: 'Vazomotor Belirti Ne Demek?' },
  { id: 'seyir', label: 'Belirtilerin Seyri Bize Ne Söyler?' },
  { id: 'sure', label: 'Ne Kadar Sürebilir?' },
  { id: 'gunluk-adimlar', label: 'Günlük Hayatta Ne Yardımcı Olabilir?' },
  { id: 'tedavi-karari', label: 'Tedavi Kararı Nasıl Verilir?' },
  { id: 'hormon-disi', label: 'Hormon Dışı Seçenekler' },
  { id: 'baska-nedenler', label: 'Ne Zaman Başka Neden Aranır?' },
  { id: 'sik-sorulanlar', label: 'Sıkça Sorulanlar' },
  { id: 'kaynaklar', label: 'Kaynaklar ve İleri Okuma' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Menopozda Sıcak Basması ve Gece Terlemesi: Neden Olur, Ne İyi Gelir?';
const seoTitle = 'Menopozda Sıcak Basması: Neden Olur, Ne İyi Gelir?';
const articleDescription =
  'Menopozda sıcak basması ve gece terlemesi neden olur, ne iyi gelir? Tetikleyicileri, günlük adımları ve hormonlu-hormonsuz seçenekleri inceleyin.';
const faqItems = articleFaqs['/hormonal-gecis/menopoz/sicak-basmasi-gece-terlemesi/'] ?? [];
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'senai-aksoy',
  articleType: 'clinical-guide',
  publishedDate: '25 Nisan 2026',
  modifiedDate: '2 Ağustos 2026',
  pathname: '/hormonal-gecis/menopoz/sicak-basmasi-gece-terlemesi/',
  articleSection: 'Hormonal Geçiş',
  sectionPath: '/hormonal-gecis/',
  keywords: [
    'sıcak basması',
    'gece terlemesi',
    'ateş basması',
    'gece ateş basması',
    'menopozda gece terlemeleri',
    'sıcak basması terleme',
    'menopoz',
    'perimenopoz',
    'uyku',
    'tetikleyiciler',
  ],
  faqItems,

  siteUrl,
});
---

<SiteLayout title={`${seoTitle} - Estranova`} description={articleDescription} ogType="article" jsonLd={articleSchemas}>
  <SiteNavbar currentPath="/hormonal-gecis/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Hormonal Geçiş · Menopoz"
      title={articleTitle}
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="senai-aksoy"
        publishedDate="25 Nisan 2026"
        lastUpdated="2 Ağustos 2026"
        readingMinutes={9}
        medicalReviewer="Dr. Alper Mumcu"
        imageSrc="/images/library/editorial/sicak-basmasi-gece-terlemesi-byline.webp"
        imageAlt="İstanbul terasında yelpaze tutan olgun kadın; sıcak basması ve gece terlemesi yazısı"
      />

      <ArticleSummary title="Kısa Klinik Yanıt">
        <p>
          Sıcak basması ve gece terlemesi menopoz geçişinde sık görülür; fakat her kadın aynı biçimde yaşamaz.
          Bazen kısa bir sıcaklık dalgası olarak geçer, bazen geceyi ve ertesi günü böler. Serinleme önlemleri
          rahatlatabilir ama belirtiler uykunuzu veya gündelik yaşamınızı bozuyorsa bununla yetinmek zorunda
          değilsiniz. Hormon tedavisi ve hormon dışı seçenekler, sağlık öykünüz ve önceliklerinizle birlikte değerlendirilir.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="nedir">Vazomotor Belirti Ne Demek?</h2>
        <p>Sıcak basması bazen gerçekten “içeriden açılmış bir ısı” gibi gelir. Oysa beden, küçük bir değişime güçlü bir serinleme yanıtı vermektedir.</p>
        <p>
          Muayene odasında tarif çoğu zaman benzerdir: “Önce yüzüm yanıyor, sonra terliyorum; bittiğinde de
          üşüyorum.” Gece olduğunda aynı dalga uykuyu böler. Bu tek bir hastanın öyküsü değil, görüşmelerde
          tekrar eden anonim bir gözlemdir. Yine de sizin dalganızın sıklığı, şiddeti ve yanında getirdikleri
          farklı olabilir.
        </p>
        <p>
          Tıp dilinde bunlara <em>vazomotor belirtiler</em> denir. Menopoz geçişindeki hormonal değişimlerin,
          beynin ısı düzenleme sistemini etkilediği düşünülür. Bu sistemdeki değişiklikler cilt damarlarının
          genişlemesini ve terlemeyi başlatan ısı kaybı yanıtıyla ilişkilidir <Evidence level={4} />.
          <sup><a href="#kaynak-4">[4]</a></sup>
        </p>

        <h2 id="seyir">Belirtilerin Seyri Bize Ne Söyler?</h2>
        <p>Ben yalnızca “Günde kaç kez oluyor?” diye sormam. Asıl belirleyici olan, bu dalgaların hayatınızda neyi böldüğüdür.</p>
        <p>
          Bazı kadınlarda dalgalar seyrek ve kısa sürer. Bazılarında gecede birkaç kez uyanmaya, ertesi gün
          yorgunluğa ve odaklanma güçlüğüne yol açar. Bu fark bir dayanıklılık sınavı değildir. Tedavi gereksinimini
          belirti sayısından çok uykuya, işe ve yaşam kalitesine etkisi belirler.
        </p>
        <p>
          Birkaç haftalık kısa kayıt yararlı olabilir: dalganın saati, gece uyanması, o gün kullanılan ilaçlarda
          değişiklik ve olağandışı bir eşlikçi belirti. Amaç uzun bir yasak listesi çıkarmak değil, sizde tekrar
          eden tabloyu fark etmektir. Başka bir kadını etkileyen unsur sizde hiçbir şey değiştirmeyebilir.
        </p>

        <h2 id="sure">Ne Kadar Sürebilir?</h2>
        <p>“Ne zaman geçecek?” muayene odasında cevaplaması en zor sorulardan biri. Çünkü sıcak basmasının tek bir takvimi yok.</p>
        <p>
          Büyük bir uzunlamasına çalışmada sık vazomotor belirti yaşayan kadınlarda toplam ortanca süre yaklaşık
          7,4 yıl bulunmuştur; belirtiler son adet döneminden önce başlayanlarda süre daha uzun olabilmiştir.
          Bu sayı sizin için başlatılmış bir geri sayım değildir. Belirli bir çalışma grubunun ortanca sonucunu
          gösterir; tek bir kadının ne kadar süre belirti yaşayacağını söylemez <Evidence level={4} />.
          <sup><a href="#kaynak-2">[2]</a></sup>
        </p>
        <p>
          Belirtiler haftalar arasında dalgalanabilir. Birkaç kötü gece, mutlaka sürekli kötüleşme anlamına
          gelmez. Buna karşılık aylar sonra hâlâ uykunuz ve gündüz işleviniz belirgin etkileniyorsa “geçmesini
          beklemek” tek seçenek değildir.
        </p>

        <h2 id="gunluk-adimlar">Günlük Hayatta Ne Yardımcı Olabilir?</h2>
        <p>Küçük hazırlıklar dalgayı ortadan kaldırmayabilir ama o birkaç dakikayı daha yönetilebilir kılabilir.</p>
        <ul>
          <li>Kolay çıkarılabilen ince katmanlar giymek</li>
          <li>Uyku ortamını kişisel olarak rahat edilen serinlikte tutmak</li>
          <li>Başucunda su ve gerektiğinde kullanılabilecek serinletici bir araç bulundurmak</li>
          <li>Yalnızca sizde tekrar eden tetikleyicileri not etmek</li>
        </ul>
        <p>
          Düzenli hareket, sigarayı bırakma ve genel uyku sağlığı başka sağlık nedenleriyle değerlidir; ancak
          bunları sıcak basmasını kesin olarak durduran reçeteler gibi sunmak doğru olmaz. Nefes egzersizleri
          o anda sakinleşmenize yardımcı olabilir, fakat vazomotor belirtilerin tedavisinde güçlü ve tutarlı kanıtlı
          bir yöntem olarak kabul edilmez <Evidence from={2} to={3} />.<sup><a href="#kaynak-3">[3]</a></sup>
        </p>

        <h2 id="tedavi-karari">Tedavi Kararı Nasıl Verilir?</h2>
        <p>Birçok kadın tedaviyi ancak “Artık dayanamıyorum” noktasında konuşabileceğini sanıyor. O noktayı beklemek gerekmiyor.</p>
        <p>
          Menopoz hormon tedavisi, uygun adaylarda sıcak basması ve gece terlemesini azaltmada en etkili tedavi
          seçeneğidir <Evidence level={5} />.<sup><a href="#kaynak-1">[1]</a></sup> Fakat karar yalnızca belirtinin
          şiddetine göre verilmez. Yaş, menopozdan geçen süre, rahmin bulunup bulunmaması, kişisel sağlık öyküsü,
          tromboz ve bazı kanserler açısından riskler ile kişinin öncelikleri birlikte değerlendirilir.
        </p>
        <p>
          Bu görüşmelerde sık karşılaştığım düşünce şu: “Hormon tedavisi ya herkes için iyidir ya da herkes için
          tehlikelidir.” Tıp çoğu zaman bu kadar siyah-beyaz değildir. Aynı belirtiyle gelen iki kadının farklı
          karar vermesi son derece doğaldır.
        </p>

        <h2 id="hormon-disi">Hormon Dışı Seçenekler</h2>
        <p>Hormon tedavisi sizin için uygun değilse veya bunu tercih etmiyorsanız konuşma burada bitmez.</p>
        <p>
          Bazı antidepresan grupları, gabapentin, bilişsel davranışçı terapi ve belirli yeni hormon dışı ilaçlar
          kılavuzlarda seçenekler arasında yer alır <Evidence level={4} />.<sup><a href="#kaynak-3">[3]</a></sup>
          Bunların hepsini aynı sepete koymamak gerekir. Uykunuz, kullandığınız diğer ilaçlar, olası yan etkiler
          ve eşlik eden sağlık durumları hangi seçeneğin sizin için daha makul olduğunu değiştirir.
        </p>
        <p>
          Özellikle reçeteli seçeneklerde “hormonsuz” sözcüğü “risksiz” anlamına gelmez. İlaç etkileşimleri,
          yan etkiler ve gerekli takip daha tedavi başlamadan konuşulmalıdır.
        </p>

        <h2 id="baska-nedenler">Ne Zaman Başka Neden Aranır?</h2>
        <p>Menopoz sık rastlanan bir açıklamadır; ama her terlemeyi ve çarpıntıyı onun üzerine bırakmak doğru olmaz.</p>
        <p>
          Yeni başlayan veya alışılmış seyrinizden belirgin farklı gece terlemeleri; ateş, açıklanamayan kilo
          kaybı, sürekli çarpıntı, titreme, göğüs ağrısı, bayılma ya da belirgin genel durum değişikliğiyle
          birlikteyse değerlendirme gerekir. Tiroid işlev bozuklukları, enfeksiyonlar, kullanılan ilaçlar ve
          başka durumlar benzer yakınmalara yol açabilir.
        </p>
        <p>
          Uykusuzluk gündüz işlevinizi bozuyorsa veya belirgin kaygı ve depresif belirtiler eşlik ediyorsa bunu
          da görüşmenin parçası yapın. Bunları anlatmak konuyu dağıtmaz; tam tersine, tablonun tamamını görmemizi sağlar.
        </p>

        <h2 id="sik-sorulanlar">Sıkça Sorulanlar</h2>
        {faqItems.map((item) => (
          <>
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </>
        ))}

        <h2 id="kaynaklar">Kaynaklar ve İleri Okuma</h2>
        <p>
          Tedavi, süre ve kanıt sınırları aşağıdaki klinik görüş bildirileri ve uzunlamasına çalışma üzerinden
          gözden geçirildi. Kaynak taraması: 2 Ağustos 2026.
        </p>
        <ol>
          <li id="kaynak-1">
            North American Menopause Society. <a href="https://pubmed.ncbi.nlm.nih.gov/35797481/" rel="noopener noreferrer">2022 hormon tedavisi görüş bildirisi</a>.
          </li>
          <li id="kaynak-2">
            Avis NE ve arkadaşları. <a href="https://pubmed.ncbi.nlm.nih.gov/25686030/" rel="noopener noreferrer">Menopoz geçişinde vazomotor belirtilerin süresi</a>. 2015.
          </li>
          <li id="kaynak-3">
            North American Menopause Society. <a href="https://pubmed.ncbi.nlm.nih.gov/37252752/" rel="noopener noreferrer">2023 hormon dışı tedavi görüş bildirisi</a>.
          </li>
          <li id="kaynak-4">
            Baker FC ve arkadaşları. <a href="https://pubmed.ncbi.nlm.nih.gov/40330614/" rel="noopener noreferrer">Menopozun ısı düzenleme sistemi üzerindeki etkileri</a>. 2025.
          </li>
        </ol>
      </ArticleProsePanel>

      <RelatedReadings
          class="mt-14"
          paths={[
            '/hormonal-gecis/perimenopoz/perimenopoz-ilk-isaretler/',
            '/hormonal-gecis/menopoz/menopoz-nedir/',
            '/zihin-denge/uyku-dinlenme/uyku-bozuklugu-menopoz/',
            '/zihin-denge/duygusal-denge/stres-yonetimi-menopoz/',
          ]}
        />

      <ArticleEditorNote>
        <p class="mb-3 leading-relaxed text-ink/80">
          Vazomotor belirtilerde tedavi gereksinimini yalnızca dalga sayısı değil, uyku ve gündelik yaşam
          üzerindeki etki belirler. Hormon tedavisi uygun adaylarda en etkili seçenektir; hormon dışı yolların
          seçimi ise eşlik eden yakınmalar, kullanılan ilaçlar ve yan etki profiline göre yapılır. Serinleme
          önlemleri konfor sağlayabilir, ancak nefes egzersizi veya tetikleyici kaçınmasını güçlü tıbbi tedavilerle
          aynı kanıt düzeyinde sunmamak gerekir. Ateş, açıklanamayan kilo kaybı, sürekli çarpıntı veya alışılmış
          seyirden belirgin sapma varsa başka nedenler ayrıca değerlendirilmelidir.
        </p>
        <p class="text-sm italic text-primary">
          — Dr. Alper Mumcu, Kadın Hastalıkları ve Doğum Uzmanı
        </p>
      </ArticleEditorNote>

       <ArticleDisclaimer>
<p>
          Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavinin yerini almaz. Sağlık kararlarınız için kendi
          hekiminizle birlikte değerlendirme yapınız.
        </p>
      </ArticleDisclaimer>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
