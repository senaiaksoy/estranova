---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

const pageTitle = 'Sonra Oku — Estranova';
const pageDescription =
  'Estranova\'da sonra okumak için kaydettiğin yazıların listesi. Liste yalnızca senin tarayıcında saklanır; üyelik veya e-posta gerekmez.';
---

<SiteLayout title={pageTitle} description={pageDescription}>
  <SiteNavbar currentPath="/sonra-oku" />

  <main id="main-content" class="text-ink">
    <section class="border-t border-burgundy/10 bg-gradient-to-b from-cream-warm to-cream-soft px-6 py-14 md:py-20">
      <div class="mx-auto max-w-4xl">
        <nav aria-label="Sayfa konumu" class="mb-6 text-xs uppercase tracking-[0.22em] text-ink/55">
          <a href="/" class="text-ink/65 hover:text-burgundy">Anasayfa</a>
          <span class="mx-2 text-gold">·</span>
          <span class="text-burgundy">Sonra Oku</span>
        </nav>

        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">
          Senin Listen
        </p>
        <h1 class="mb-4 font-serif text-5xl leading-[1.05] text-burgundy md:text-6xl">
          Sonra Oku
        </h1>
        <p class="max-w-2xl text-lg leading-relaxed text-ink/80 md:text-xl">
          Sonra okumak için kaydettiğin yazılar burada birikir. Liste yalnızca senin tarayıcında durur; üyelik, e-posta
          veya kayıt gerektirmez.
        </p>
      </div>
    </section>

    <section class="bg-white px-6 py-12 md:py-16">
      <div class="mx-auto max-w-4xl">
        <div data-saved-empty class="rounded-[28px] border border-burgundy/12 bg-cream-soft p-8 text-center md:p-12">
          <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.28em] text-gold">
            Liste boş
          </p>
          <h2 class="mb-3 font-serif text-2xl leading-snug text-ink md:text-3xl">
            Henüz kaydedilmiş yazı yok
          </h2>
          <p class="mb-6 max-w-2xl mx-auto text-base leading-relaxed text-ink/70">
            Bir yazıyı okurken sağ üstteki <span class="font-semibold text-burgundy">Sonra Oku</span> düğmesine
            basarsan listende birikir. Listeye yalnızca sen erişirsin — kayıt veya hesap gerekmez.
          </p>
          <a
            href="/sayi"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-burgundy underline decoration-burgundy/40 underline-offset-4 transition hover:decoration-burgundy"
          >
            Bu ayın sayısına göz at
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <ul data-saved-list class="border-t border-burgundy/12"></ul>
      </div>
    </section>

    <section class="border-t border-burgundy/10 bg-white px-6 py-10">
      <div class="mx-auto max-w-3xl text-center">
        <p class="mb-4 font-serif text-base italic leading-relaxed text-ink/70">
          Bütün okuma panelin için
        </p>
        <a
          href="/hesabim"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-burgundy underline decoration-burgundy/40 underline-offset-4 transition hover:decoration-burgundy focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
        >
          Okuma Panelime git
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section class="border-t border-burgundy/10 bg-cream-soft px-6 py-10">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm leading-relaxed text-ink/70">
          Liste yalnızca bu tarayıcıda saklanır. Tarayıcı verisini sildiğinde liste de kaybolur.
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
