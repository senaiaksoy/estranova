---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

const pageTitle = 'Sonra Oku — Estranova';
const pageDescription =
  'Estranova\'da sonra okumak için kaydettiğiniz yazıların listesi. Liste yalnızca sizin tarayıcınızda saklanır; üyelik veya e-posta gerekmez.';
---

<SiteLayout title={pageTitle} description={pageDescription}>
  <SiteNavbar currentPath="/sonra-oku" />

  <main id="main-content" class="bg-cream-soft text-ink">
    <section class="relative overflow-hidden border-t border-burgundy/10 px-6 py-16 md:py-24">
      <div class="pointer-events-none absolute -left-24 top-12 h-72 w-72 rounded-full bg-burgundy/8 blur-3xl"></div>
      <div class="pointer-events-none absolute bottom-0 right-[5%] hidden font-serif text-[11rem] italic leading-none text-burgundy/[0.035] lg:block" aria-hidden="true">
        liste
      </div>
      <div class="relative mx-auto max-w-6xl">
        <nav aria-label="Sayfa konumu" class="mb-6 text-xs uppercase tracking-[0.22em] text-ink/55">
          <a href="/" class="text-ink/65 hover:text-burgundy">Anasayfa</a>
          <span class="mx-2 text-gold">·</span>
          <span class="text-burgundy">Sonra Oku</span>
        </nav>

        <div class="grid gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:items-end">
          <header>
            <p class="mb-5 flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.32em] text-burgundy">
              <span class="h-px w-10 bg-gold"></span>
            Sizin Listeniz
            </p>
            <h1 class="max-w-3xl font-serif text-6xl leading-[0.9] tracking-[-0.055em] text-burgundy md:text-8xl">
              Sonra Oku çekmecesi
            </h1>
          </header>
          <aside class="rounded-[34px] border border-burgundy/12 bg-white/75 p-7 shadow-[0_28px_90px_-62px_rgba(44,22,28,0.35)] ring-1 ring-white/80">
            <p class="font-serif text-2xl italic leading-snug text-ink/78 md:text-3xl">
          Kaydettiğiniz yazılar burada birikir; üyelik, e-posta ya da görünür profil gerekmez. Bu küçük okuma çekmecesi yalnızca tarayıcınızda durur.
            </p>
            <div class="mt-6 border-t border-gold/25 pt-5">
              <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-ink/55">
                Yerel liste · Hesap zorunlu değil · Sessiz okuma alanı
              </p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="px-6 py-14 md:py-20">
      <div class="mx-auto max-w-5xl">
        <div data-saved-empty class="relative overflow-hidden rounded-[38px] border border-burgundy/12 bg-white p-8 text-center shadow-[0_28px_90px_-66px_rgba(44,22,28,0.36)] ring-1 ring-white/80 md:p-12">
          <span class="pointer-events-none absolute inset-x-10 top-0 h-px bg-gold/60"></span>
          <div class="mx-auto mb-7 flex h-20 w-20 items-center justify-center rounded-[26px] bg-cream-soft font-serif text-5xl italic text-burgundy shadow-inner ring-1 ring-gold/25">
            0
          </div>
          <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.28em] text-gold">
            Liste boş
          </p>
          <h2 class="mb-3 font-serif text-3xl leading-snug tracking-[-0.02em] text-ink md:text-5xl">
            Henüz kaydedilmiş yazı yok
          </h2>
          <p class="mx-auto mb-7 max-w-2xl text-base leading-relaxed text-ink/70">
            Bir yazıyı okurken sağ üstteki <span class="font-semibold text-burgundy">Sonra Oku</span> düğmesine
              basarsanız listenizde birikir. Listeye yalnızca siz erişirsiniz; kayıt veya hesap gerekmez.
          </p>
          <a
            href="/sayi"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-burgundy underline decoration-burgundy/40 underline-offset-4 transition hover:decoration-burgundy"
          >
            Bu ayın sayısına göz at
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <ul data-saved-list class="rounded-[34px] border border-burgundy/12 bg-white/75 shadow-[0_24px_82px_-66px_rgba(44,22,28,0.32)] ring-1 ring-white/80"></ul>
      </div>
    </section>

    <section class="border-t border-burgundy/10 bg-white px-6 py-12">
      <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <p class="mb-2 text-[11px] font-bold uppercase tracking-[0.24em] text-burgundy/80">
            Okuma paneli
          </p>
          <p class="font-serif text-2xl italic leading-snug text-ink/72 md:text-3xl">
            Listeyi daha geniş bir okuma düzeni içinde görmek isterseniz panel sayfasına geçebilirsiniz.
          </p>
        </div>
        <div class="md:text-right">
          <a
            href="/hesabim"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-burgundy underline decoration-burgundy/40 underline-offset-4 transition hover:decoration-burgundy focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35 focus-visible:ring-offset-2"
          >
            Okuma panelimi aç
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="border-t border-burgundy/10 bg-cream-soft px-6 py-10">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm leading-relaxed text-ink/70">
          Liste yalnızca bu tarayıcıda saklanır. Tarayıcı verisini sildiğinde liste de kaybolur.
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
