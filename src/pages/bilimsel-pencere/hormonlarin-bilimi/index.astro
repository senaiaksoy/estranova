---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuSection from '../../../components/site/SubmenuSection.astro';
import ChapterMasthead from '../../../components/site/ChapterMasthead.astro';
import EditorialEpigraph from '../../../components/site/EditorialEpigraph.astro';
import MarginaliaRail from '../../../components/site/MarginaliaRail.astro';
import MarginaliaItem from '../../../components/site/MarginaliaItem.astro';
import Asterism from '../../../components/site/Asterism.astro';
import ChapterCompass from '../../../components/site/ChapterCompass.astro';
import EditorPickCard from '../../../components/site/EditorPickCard.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { chapterMap, getNextChapter } from '../../../data/chapter-map';
import { subHubEpigraphs } from '../../../data/sub-hub-epigraphs';

const path = '/bilimsel-pencere/hormonlarin-bilimi';
const hero = submenuHeroByRoute[path]!;
const chapter = chapterMap[path]!;
const epigraph = subHubEpigraphs[path];
const next = getNextChapter(path);

const editorPick = {
  href: '/bilimsel-pencere/hormonlarin-bilimi/estrogen-biyolojisi-saglik',
  title: 'Östrojen Biyolojisi ve Sağlık — Tek Hormon Değil, Bir Aile',
  lede: 'Östrojen tek bir hormon değil — E1, E2, E3, E4 ailesi. Doku-spesifik etkiler, ER-α/ER-β reseptör çeşitliliği, karaciğer ve estrobolome metabolizması, HRT formları ve kanser ilişkisinin karmaşık tablosu — mekanizmadan klinik kararın pratik sınırlarına.',
  writerSlug: 'senai-aksoy',
  readingMinutes: 10,
  image: submenuHeroByRoute['/bilimsel-pencere/hormonlarin-bilimi/estrogen-biyolojisi-saglik']!,
};

const neighbors = [
  { step: '01', href: '/bilimsel-pencere/hucreler-ve-yaslanma', title: 'Hücreler ve Yaşlanma', excerpt: 'NAD+, mitokondri, senesans — yaşlanma biyolojisinin son 20 yılı.' },
  { step: '02', href: '/bilimsel-pencere/yeni-arastirmalar', title: 'Yeni Araştırmalar', excerpt: 'Editöryal kuruldaki yeni çalışma derlemeleri ve meta-analizler.' },
];
---

<SiteLayout
  title="Hormonların Bilimi — Bilimsel Pencere - Estranova"
  description="Östrojen, progesteron ve testosteronun temel mekanizmaları; vücudun her dokusuyla nasıl konuştuklarını sade bir dille açıklayan derlemeler."
>
  <SiteNavbar currentPath="/bilimsel-pencere" />

  <main id="main-content" class="text-ink">
    <ChapterMasthead number={chapter.number} parent={chapter.parent} chapter={chapter.chapter} />

    <SubmenuHero
      eyebrow="Bedenin sessiz dili"
      title="Hormonların Bilimi"
      lede="Östrojen yalnızca bir üreme hormonu değildir; beyni, damarı, kemiği, cildi aynı anda dinleyen geniş bir orkestra şefidir. Onun çekilmesi bedeni tek bir noktadan değil, eş zamanlı olarak pek çok yerden değiştirir."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />

    <section class="border-b border-burgundy/10 bg-[#fffaf0] px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <nav class="mb-10 text-sm text-ink/60" aria-label="İçerik yolu">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/bilimsel-pencere" class="font-medium text-burgundy hover:underline">Bilimsel Pencere</a></li>
            <li aria-hidden="true">/</li>
            <li class="font-medium text-ink">Hormonların Bilimi</li>
          </ol>
        </nav>

        <div class="grid gap-12 lg:grid-cols-12 lg:items-start lg:gap-14">
          <div class="lg:col-span-8">
            <p class="editorial-dropcap mb-7 text-lg leading-relaxed text-ink/85 md:text-xl">
              Östrojen, progesteron ve testosteron; reseptörleri neredeyse her dokuda bulunan
              üç moleküldür. Beyindeki sinaptik plastisiteyi, damar endotelinin esnekliğini,
              kemik döngüsündeki <strong class="font-semibold text-ink">osteoklast-osteoblast dengesini</strong>, ciltteki kolajen
              sentezini hep birlikte düzenlerler. Menopozda yaşanan şey bu nedenle bir
              "eksiklik" değil; çok merkezli bir yeniden ayarlanmadır.
            </p>
            <p class="text-base leading-relaxed text-ink/72 md:text-lg">
              Bu yeniden ayarlanmanın iyi anlaşılması, hem hormon tedavisi kararlarının hem de
              yaşam tarzı müdahalelerinin kalitesini doğrudan değiştiriyor. Buradaki yazılar;
              mekanizmayı, kanıtı ve tartışmalı alanları üçünü birden masaya yatırıyor.
            </p>
          </div>

          <div class="lg:col-span-4 lg:pt-1">
            <MarginaliaRail>
              <MarginaliaItem label="Yayın" value="Şubat 2026 · Düzenli güncellenir" />
              <MarginaliaItem label="Mekanizma" emphasized="200+ doku tipinde östrojen reseptörü ifadesi belgelenmiş." />
              <MarginaliaItem label="Sık sorulanlar">
                <ul class="mt-2 space-y-3 text-sm leading-snug text-ink/78">
                  <li><span class="block font-semibold text-ink">Östrojen yalnızca üreme sistemini mi etkiler?</span>Hayır; reseptörleri beyin, damar, kemik, deri, hatta bağırsak mukozasında bulunur.</li>
                  <li><span class="block font-semibold text-ink">Progesteron sadece dengeleyici mi?</span>Çok daha fazlası — GABA-erjik etkiyle uyku ve anksiyete üzerinde bağımsız rolü vardır.</li>
                  <li><span class="block font-semibold text-ink">Testosteron kadın hormonu mu?</span>Evet — libido, kas kütlesi, bilişsel keskinlik üzerinde etkilidir.</li>
                </ul>
              </MarginaliaItem>
            </MarginaliaRail>
          </div>
        </div>
      </div>
    </section>

    {epigraph && <EditorialEpigraph quote={epigraph} />}

    <SubmenuSection variant="white" borderedTop={false}>
      <header class="mb-12 grid gap-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-end">
        <p class="text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Editör'ün Seçimi</p>
        <h2 class="font-serif text-4xl leading-[0.95] tracking-[-0.04em] md:text-6xl">Bu evreden bir okuma</h2>
      </header>

      <EditorPickCard
        href={editorPick.href}
        title={editorPick.title}
        lede={editorPick.lede}
        writerSlug={editorPick.writerSlug}
        readingMinutes={editorPick.readingMinutes}
        imageSrc={editorPick.image.src}
        imageAlt={editorPick.image.alt}
      />
    </SubmenuSection>

    <Asterism />

    <SubmenuSection variant="cream" borderedTop={false}>
      <header class="mb-10 grid gap-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-end">
        <p class="text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Aynı kategoride</p>
        <h2 class="font-serif text-4xl leading-[0.95] tracking-[-0.04em] md:text-6xl">İlgili alt başlıklar</h2>
      </header>
      <div class="divide-y divide-burgundy/14 border-y border-burgundy/14">
        {neighbors.map((n) => (
          <a href={n.href} class="group grid gap-5 py-7 transition hover:bg-white/58 md:grid-cols-[88px_1fr_auto] md:items-center md:py-8">
            <span class="font-serif text-3xl italic text-gold">{n.step}</span>
            <div>
              <h3 class="mb-2 font-serif text-3xl leading-tight text-ink group-hover:text-burgundy">{n.title}</h3>
              <p class="max-w-2xl text-sm leading-relaxed text-ink/72">{n.excerpt}</p>
            </div>
            <span class="text-2xl text-gold transition group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </SubmenuSection>

    <ChapterCompass nextHref={next?.href} nextNumber={next?.number} nextChapter={next?.chapter} nextParent={next?.parent} />
  </main>

  <SiteFooter />
</SiteLayout>
