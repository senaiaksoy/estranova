---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../../components/site/ArticleFAQ.astro';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { articleFaqs } from '../../../data/article-faqs';
import { resolveSiteUrl } from '../../../utils/seo';

const pathname = '/bilimsel-pencere/yeni-arastirmalar/menopozda-hrt-avantajlari/';
const hero = submenuHeroByRoute[pathname] ?? submenuHeroByRoute['/bilimsel-pencere/yeni-arastirmalar/']!;

const tocEntries = [
  { id: 'neden-yeniden-konusuluyor', label: "HRT kararına sizi zorlayan yakınmadan başlayın" },
  { id: 'belirti-rahatlamasi', label: "En belirgin yarar sıcak basması ve gece terlemesinde" },
  { id: 'uyku-ve-yasam-kalitesi', label: "Gece belirtileri azaldığında uyku da rahatlayabilir" },
  { id: 'urogenital-konfor', label: "Vajinal kuruluk ve ilişkide ağrı için lokal tedavi" },
  { id: 'kemik-sagligi', label: "Kemik koruması tedavi sürdükçe devam eder" },
  { id: 'erken-menopoz-penceresi', label: "Erken menopozda hormon tedavisinin amacı değişir" },
  { id: 'kalp-ve-metabolizma', label: "Kalp ve metabolizma için beklentinin sınırları" },
  { id: 'kilo-ve-vucut-kompozisyonu', label: "Kilo ve yağ dağılımındaki etki sınırlıdır" },
  { id: 'cilt-ve-sac', label: "Cilt ve saç için hangi yararlar gösterilmiş?" },
  { id: 'yaslanma-karsiti-soylem', label: "Belirtilerin azalması yaşlanmayı durdurmaz" },
  { id: 'herkes-icin-ayni-degil', label: "Sağlık geçmişi tedavi seçimini belirler" },
  { id: 'gorusmede-sorular', label: "Hekim görüşmesine hazırlanırken" },
  { id: 'kapanis', label: "Tedaviden ne beklediğinizi netleştirin" },
  { id: 'kaynaklar', label: "Kaynaklar ve ileri okuma" },
  { id: 'sik-sorulanlar', label: "Dr. Aksoy'a sorular" },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = "Menopozda HRT'nin Avantajları: Hangi Faydalar Daha Net, Hangilerinde Daha Temkinli Olmalı?";
const seoTitle = 'Menopozda HRT Avantajları';
const articleDescription =
  'Menopozda HRT hangi belirtileri azaltabilir? Uyku, vajinal yakınmalar ve kemik sağlığındaki yararlar; kalp, kilo, cilt ve saç için kanıtın sınırları.';
const faqItems = articleFaqs[pathname] ?? [];
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'senai-aksoy',
  articleType: 'clinical-guide',
  publishedDate: '6 Mayıs 2026',
  modifiedDate: '20 Ekim 2026',
  pathname,
  articleSection: 'Bilimsel Pencere',
  sectionPath: '/bilimsel-pencere/',
  keywords: [
    'menopoz',
    'HRT',
    'hormon tedavisi',
    'menopozda hormon tedavisi',
    'sıcak basması',
    'kemik sağlığı',
    'vajinal kuruluk',
    'erken menopoz',
    'yaşam kalitesi',
    'kilo artışı',
    'bel çevresi',
    'vücut kompozisyonu',
    'cilt sağlığı',
    'saç dökülmesi',
    'yaşlanma karşıtı söylem',
  ],
  image: hero.src,
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  image={hero.src}
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/bilimsel-pencere/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Bilimsel Pencere · Yeni Araştırmalar"
      title={articleTitle}
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="senai-aksoy"
        articleType="clinical-guide"
        publishedDate="6 Mayıs 2026"
        lastUpdated="20 Ekim 2026"
        readingMinutes={15}
        medicalReviewer="Dr. Alper Mumcu"
        imageSrc="/images/library/editorial/senai-hrt-avantajlari-window-portrait.webp"
        imageAlt="Pencere kenarında duran, deve tüyü renkli ceket giymiş bir kadın."
        imagePosition="center"
      />

      <p class="mb-6 text-sm leading-relaxed text-ink/70">
        20 Ekim 2026 revizyonunun bağımsız tıbbi incelemesi Dr. Alper Mumcu tarafından tamamlandı.
      </p>

      <ArticleSummary title="Kısa Klinik Yanıt">
        <p>
          Hormon replasman tedavisi (HRT), sıcak basması ve gece terlemesini azaltabilir
          <Evidence level={5} />.<sup><a href="#kaynak-1">[1]</a></sup>
          Geceyi bu belirtiler bölüyorsa uyku da düzelebilir <Evidence level={3} />.<sup><a href="#kaynak-3">[3]</a></sup>
          Sistemik tedavi kemik kaybını ve kırık riskini azaltır; yalnızca vajinal kuruluk ve
          ilişkide ağrı içinse düşük doz lokal vajinal östrojen ayrıca değerlendirilir.<sup><a href="#kaynak-2">[2]</a></sup>
        </p>
        <p>
          Seçim; yakınmalara, yaşa, menopozdan geçen süreye ve sağlık geçmişine bağlıdır.
          Erken yumurtalık yetmezliğinin yaklaşımı farklıdır. Olağan menopoz yaşında HRT, kilo verme, saç çıkarma,
          gençleşme veya kalp ve bellek hastalıklarından korunma amacıyla başlanacak bir tedavi değildir.
          Fayda ve risk, tedavinin türüyle birlikte değerlendirilir.<sup><a href="#kaynak-1">[1]</a></sup><sup><a href="#kaynak-4">[4]</a></sup><sup><a href="#kaynak-5">[5]</a></sup>
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="neden-yeniden-konusuluyor">HRT kararına sizi zorlayan yakınmadan başlayın</h2>
        <p>
          Gece terleyerek uyanıyor, sabah dinlenememiş hissediyor ve hormon tedavisinin buna değip
          değmeyeceğini düşünüyorsanız, önce hangi yakınmanın hayatınızı zorladığını ayırmak gerekir.
        </p>
        <p>
          Bu konuyu konuşurken kullandığım bir cümle var: “Önce sizi neyin zorladığını konuşalım;
          sonra seçeneklerin yararlarını ve risklerini birlikte değerlendirip size uygun kararı verelim.”
        </p>
        <p>
          HRT, menopoz döneminde azalan hormonların yerine konmasını ifade eder. Sistemik tedavide
          hormon kana geçerek vücutta etki gösterir; tablet, bant veya jel bu gruptadır.
          Düşük doz vajinal östrojen ise esas olarak vajina ve çevresindeki yakınmaları hedefler;
          aynı başlık altında anılsalar da amaçları ve risk değerlendirmeleri farklıdır.<sup><a href="#kaynak-1">[1]</a></sup>
        </p>
        <p>
          İçiniz rahat olsun: HRT hakkında bir yanda korkutucu başlıklarla, diğer yanda çok iddialı
          vaatlerle karşılaştığınızda çekince ya da korku hissetmeniz son derece anlaşılır bir durum.
          Bu yazıda yararları kanıt gücüne göre tek tek ele alacağız: günlük hayatta fark
          edilebilen rahatlama, kemik sağlığı ve henüz yeterli kanıtı bulunmayan beklentiler; çünkü
          hepsine aynı ağırlığı vermek kararınızı zorlaştırır.
        </p>

        <h2 id="belirti-rahatlamasi">En belirgin yarar sıcak basması ve gece terlemesinde</h2>
        <p>
          Sıcak basması ve gece terlemesinin sıklığını, şiddetini azaltmak HRT'nin en güçlü
          kanıtla desteklenen yararları arasındadır <Evidence level={5} />.<sup><a href="#kaynak-1">[1]</a></sup>
        </p>
        <p>
          Tıbbi metinlerde <em>vazomotor belirtiler</em> olarak adlandırılan bu tablo, sizin için
          toplantının ortasında aniden yüzünüze hücum eden bir sıcaklık ya da gece kıyafet
          değiştirecek kadar terlemek olabilir. Tedavinin hedefi bu yakınmaların gününüzü ve
          gecenizi daha az bölmesidir; yanıtın derecesi ise kişiden kişiye değişir.
        </p>

        <h2 id="uyku-ve-yasam-kalitesi">Gece belirtileri azaldığında uyku da rahatlayabilir</h2>
        <p>
          Uykunuz özellikle sıcak basmalarıyla bölünüyorsa, bu belirtilerin azalması daha rahat
          uyumanıza yardım edebilir <Evidence level={3} />.<sup><a href="#kaynak-3">[3]</a></sup>
        </p>
        <p>
          Çalışmaları birlikte değerlendiren bir derlemede uyku yararı, başlangıçta sıcak basması
          veya gece terlemesi olan kadınlarda daha belirgindi; bu belirtileri olmayan grupta ise
          aynı sonuç gösterilmedi. Bu yüzden HRT'yi her tür uykusuzluğa yanıt veren bir uyku ilacı
          gibi düşünmemek gerekir.<sup><a href="#kaynak-3">[3]</a></sup>
        </p>
        <p>
          Daha az bölünen bir gecenin ertesi gün dikkatinize, enerjinize ve ruh halinize olumlu
          katkısı olabilir; ancak süregelen depresif belirtiler, kaygı veya uykusuzluğun kendi
          değerlendirmesi vardır. HRT klinik depresyonun rutin tedavisi olarak önerilmez ve bu
          yakınmaların tamamını menopoza bağlamak başka nedenleri gözden kaçırabilir.<sup><a href="#kaynak-5">[5]</a></sup>
        </p>

        <h2 id="urogenital-konfor">Vajinal kuruluk ve ilişkide ağrı için lokal tedavi</h2>
        <p>
          Kuruluk, yanma ve ilişkide ağrı günlük hayatınızı etkiliyorsa, düşük doz vajinal östrojen
          bu yakınmaları azaltabilen seçeneklerdendir <Evidence level={4} />.<sup><a href="#kaynak-2">[2]</a></sup>
        </p>
        <p>
          Östrojen azalması vajina ve alt idrar yolu dokusunda incelme ve kuruluğa yol açabilir;
          <em>menopozun genitoüriner sendromu</em> adıyla da anılan bu değişiklikleri pek çok kadın
          mahcubiyetten dile getirmekte zorlanır. Yalnızca bu yakınmalarınız varsa tüm vücudu
          etkileyen sistemik tedaviye ihtiyaç olmayabilir; ancak lokal tedavinin sıcak basmasını
          gidermeyeceğini ve kemik koruması sağlamayacağını da bilmek gerekir.<sup><a href="#kaynak-1">[1]</a></sup><sup><a href="#kaynak-2">[2]</a></sup>
        </p>
        <p>
          Menopoz sonrası tekrarlayan idrar yolu enfeksiyonlarında da vajinal östrojenin yeri olabilir;
          fakat yeni başlayan yanma veya ağrının nedeni önce değerlendirilir. Meme kanseri öyküsünde
          hormon dışı seçenekler ve gerekirse lokal tedavi, ilgili hekimlerle birlikte ele alınır.<sup><a href="#kaynak-2">[2]</a></sup>
        </p>

        <h2 id="kemik-sagligi">Kemik koruması tedavi sürdükçe devam eder</h2>
        <p>
          Sistemik HRT kullanıldığı dönemde kemik kaybını yavaşlatır ve kırık riskini azaltır
          <Evidence level={5} />.<sup><a href="#kaynak-2">[2]</a></sup>
        </p>
        <p>
          Bu yararı günlük hayatınızda hissetmezsiniz. Östrojen azalmasıyla hızlanan kemik
          yıkımı yıllar içinde sessizce ilerleyerek kemik yoğunluğunu düşürebilir; tedavi
          bırakıldıktan sonra ise koruyucu etki azaldığı için kemik sağlığı planı o noktada
          yeniden değerlendirilir.<sup><a href="#kaynak-2">[2]</a></sup>
        </p>
        <p>
          Özellikle menopoz belirtilerinizle birlikte kemik kaybı riskiniz varsa bu yarar kararda
          önem kazanır. HRT kemik sağlığı için tek seçenek olmasa da, osteoporozu (kemik erimesi)
          olan bir kadında geçirilmiş kırıklar, kemik yoğunluğu, yaş ve diğer tedavilerle birlikte
          değerlendirilir.<sup><a href="#kaynak-5">[5]</a></sup>
        </p>

        <h2 id="erken-menopoz-penceresi">Erken menopozda hormon tedavisinin amacı değişir</h2>
        <p>
          Hormon eksikliği beklenenden erken başladığında, belirtilerin ötesinde uzun dönem sağlık
          da tedavi planının parçası olur.<sup><a href="#kaynak-4">[4]</a></sup>
        </p>
        <p>
          Kırk yaşından önce gelişen erken yumurtalık yetmezliği (POI) ile 40–44 yaşındaki erken
          menopoz aynı tanım değildir. Özellikle POI'de, kullanımına engel yoksa, sıcak basması
          bulunması şart olmadan hormon tedavisinin olağan menopoz yaşına kadar sürdürülmesi
          önerilir ve sonrasında ihtiyaç ile riskler yeniden ele alınır.<sup><a href="#kaynak-4">[4]</a></sup><sup><a href="#kaynak-5">[5]</a></sup>
        </p>
        <p>
          Uzun dönem hastalık ve ölüm riskini azaltmaya yönelik öneri güçlüdür; ancak bu sonuçlar
          için POI'ye özgü kanıtın kesinliği düşüktür <Evidence level={2} />.
          Sizin için temel amaç, erken başlayan hormon eksikliğinin vücuttaki etkilerini azaltmaktır.<sup><a href="#kaynak-4">[4]</a></sup>
        </p>

        <h2 id="kalp-ve-metabolizma">Kalp ve metabolizma için beklentinin sınırları</h2>
        <p>
          HRT, kalp-damar hastalığını önlemek amacıyla başlanmaz; ancak menopoz belirtilerinizi
          gidermek için kullanıldığında tedaviye başlama zamanınız ve damar sağlığınız yarar-risk
          dengesini etkiler.<sup><a href="#kaynak-5">[5]</a></sup>
        </p>
        <p>
          Genel olarak 60 yaşın altındaysanız veya menopoz başlangıcından itibaren ilk 10 yıl
          içindeyseniz, kullanımına engel bulunmayan durumlarda denge daha elverişlidir. Yine de bu
          zaman aralığı risksizlik garantisi vermez; daha geç başlamakla, daha önce başlanmış
          tedaviyi sürdürmek de birbirinden farklı kararlardır.<sup><a href="#kaynak-5">[5]</a></sup>
        </p>
        <p>
          Tansiyonunuz, sigara kullanımınız, kan yağlarınız ve geçirilmiş damar hastalıklarınız
          görüşmede birlikte ele alınır; kan şekeri veya yağ dağılımında görülebilen değişimler de
          kendi başına kalp krizi riskinin azaldığını kanıtlamaz.<sup><a href="#kaynak-5">[5]</a></sup>
        </p>

        <h2 id="kilo-ve-vucut-kompozisyonu">Kilo ve yağ dağılımındaki etki sınırlıdır</h2>
        <p>
          HRT kilo verme tedavisi değildir; karın çevresindeki yağ birikimi üzerinde bildirilen
          etki küçüktür <Evidence level={3} />.<sup><a href="#kaynak-1">[1]</a></sup>
        </p>
        <p>
          Kıyafetlerinizin bel kısmı sıkmaya başladığında tartıdaki sayı kadar yağın dağılımı da
          dikkatinizi çekebilir. Menopoz geçişinde karın çevresinde yağlanma artabilir; hormon
          tedavisinin bunu bir ölçüde sınırlayabildiğini düşündüren bulgular ise belirgin bir kilo
          kaybı beklentisini desteklemez.<sup><a href="#kaynak-1">[1]</a></sup>
        </p>

        <h2 id="cilt-ve-sac">Cilt ve saç için hangi yararlar gösterilmiş?</h2>
        <p>
          Ciltteki bazı biyofiziksel ölçümlerde olumlu bulgular bildirilse de, saç dökülmesini
          ayrı bir başlık olarak ele almak gerekir.<sup><a href="#kaynak-1">[1]</a></sup><sup><a href="#kaynak-6">[6]</a></sup>
        </p>
        <p>
          Çalışmalarda incelenen cilt kalınlığı, elastikiyet ve kolajen değişimleri, aynada
          belirgin bir gençleşme göreceğiniz veya kuruluğun tek başına kaybolacağı beklentisini
          desteklemez; çalışmaların yöntem ve tedavi farklılıkları da yorumu sınırlar <Evidence level={2} />.<sup><a href="#kaynak-6">[6]</a></sup>
          Bu nedenle yalnızca cildi gençleştirmek amacıyla sistemik HRT başlanması önerilmez.<sup><a href="#kaynak-5">[5]</a></sup>
        </p>
        <p>
          Saçınızın seyrelmesi ise farklı nedenlerle ayrıca değerlendirilmelidir; çünkü HRT'nin saç
          kalitesini artıracağını söylemek için yeterli kanıt yoktur.<sup><a href="#kaynak-1">[1]</a></sup>
        </p>

        <h2 id="yaslanma-karsiti-soylem">Belirtilerin azalması yaşlanmayı durdurmaz</h2>
        <p>
          Daha rahat uyumak ve gününüzün daha az bölünmesi yaşam kalitenizi artırabilir;
          bu yarar, yaşlanmayı durdurma veya yaşamı uzatma iddiasından ayrıdır.<sup><a href="#kaynak-2">[2]</a></sup>
        </p>
        <p>
          HRT genel bir yaşlanma karşıtı tedavi olarak önerilmediği gibi, belleği korumak ya da
          demansı önlemek ve tedavi etmek için de kullanılmaz. Özellikle zihinsel bulanıklık
          hissini, ileride demans gelişme riskiyle aynı sonuç gibi değerlendirmemek gerekir.<sup><a href="#kaynak-5">[5]</a></sup>
        </p>

        <h2 id="herkes-icin-ayni-degil">Sağlık geçmişi tedavi seçimini belirler</h2>
        <p>
          Sizin için beklenen yarar kadar, hangi hormonun hangi yoldan ve hangi sağlık geçmişiyle
          kullanılacağı da önemlidir.
        </p>
        <p>
          Rahim varsa sistemik östrojene, rahim iç tabakasını koruyan bir progestojen eklenmesi
          gerekir <Evidence level={5} />. Düşük doz lokal vajinal östrojen bu açıdan ayrı
          değerlendirilir; genellikle progestojen gerektirmez.<sup><a href="#kaynak-1">[1]</a></sup><sup><a href="#kaynak-2">[2]</a></sup>
        </p>
        <p>
          Açıklanamayan vajinal kanama tedavi öncesinde mutlaka araştırılır. 2022 tarihli
          uluslararası menopoz kılavuzu; meme kanseri gibi östrojene duyarlı kanser öyküsünü,
          geçirilmiş koroner kalp hastalığını, kalp krizini, inmeyi, toplardamar pıhtısını ve
          karaciğer hastalığını ağızdan ya da ciltten sistemik HRT kullanımına engel durumlar
          arasında sayar; bu hastalık öyküleri yalnızca doz veya uygulama yolu seçilerek
          aşılabilecek sıradan risk faktörleri değildir.<sup><a href="#kaynak-1">[1]</a></sup>
        </p>
        <p>
          Geçirilmiş toplardamar pıhtısında ise kılavuzlar arasında bir yaklaşım farkı vardır:
          2025 tarihli güncel endokrinoloji kılavuzu, bireysel yarar-risk değerlendirmesinden
          sonra seçilmiş kadınlarda düşük doz ciltten östrojeni bir seçenek olarak ele alır. Ancak
          bu karar uzman değerlendirmesi gerektirir; bant ya da jel kullanmak pıhtı öyküsünü
          önemsiz kılmaz.<sup><a href="#kaynak-5">[5]</a></sup>
        </p>
        <p>
          Kombine sistemik tedavide meme kanseri riski kullanım süresiyle artabilir; yalnız
          östrojenin risk profili farklıdır. Ağızdan östrojen ile ciltten uygulamanın pıhtı riski
          de aynı olmadığı için, ayrıntıları <a href="/bilimsel-pencere/yeni-arastirmalar/menopoz-hrt-meme-kanseri-riski/">HRT ve meme kanseri</a>
          yazısında ayrıca okuyabilirsiniz.<sup><a href="#kaynak-2">[2]</a></sup>
        </p>
        <p>
          Migren, auralı olsa bile, tek başına HRT'yi dışlayan bir durum değildir; uygulama yolu
          ve doz seçimini etkiler. Görme belirtileriyle seyreden auralı migrende ciltten östrojen
          tercih edilebilir; kontrolsüz hipertansiyonda ise tedaviye başlanmaması önerilir.<sup><a href="#kaynak-5">[5]</a></sup><sup><a href="#kaynak-7">[7]</a></sup>
        </p>

        <h2 id="gorusmede-sorular">Hekim görüşmesine hazırlanırken</h2>
        <p>
          Görüşmeye, sizi en çok zorlayan yakınmayı ve tedaviden ne beklediğinizi yazarak
          gelebilirsiniz; kullandığınız ilaçların ve sağlık geçmişinizin listesi de yanınızda olsun.
        </p>
        <ul>
          <li>Hangi yakınmayı hedefliyoruz; bu yakınma için hormon dışı seçenekler neler?</li>
          <li>Lokal tedavi yeterli mi, sistemik tedavinin ek yararı ne olacak?</li>
          <li>Benim öykümde hangi riskler önemli; uygulama yolu bunları nasıl etkiliyor?</li>
          <li>Yanıtı ne zaman değerlendireceğiz; hangi yan etkileri bildirmeliyim?</li>
        </ul>
        <p>
          Tedaviye başladıktan sonra ilk değerlendirme genellikle üç ayda, ardından en az yılda bir
          yapılır; sorun olduğunda daha erken görüşülür. Hedef yararı ve yan etkileri birlikte
          izlemek olduğu için, dozu kendi başınıza değiştirmeden önce hekiminizle konuşmanız
          önemlidir.<sup><a href="#kaynak-2">[2]</a></sup>
        </p>

        <h2 id="kapanis">Tedaviden ne beklediğinizi netleştirin</h2>
        <p>
          Tedaviden ne beklediğinizi bilmek, fayda listesini uzatmaktan daha çok işe yarar.
        </p>
        <p>
          Görüşmeden çıktığınızda hedeflenen yakınmayı, sizin için önemli riski ve sonraki
          kontrolün zamanını açıklayabiliyorsanız kararın temelini kurmuşsunuz demektir.
          Kararınızı hemen vermek zorunda değilsiniz; anlaşılmayan noktaları yeniden sorabilirsiniz.
        </p>

        <h2 id="kaynaklar">Kaynaklar ve ileri okuma</h2>
        <p>Yararlar ve güvenlik sınırları için kullanılan seçilmiş kaynaklar aşağıdadır.</p>
        <ol>
          <li id="kaynak-1">The North American Menopause Society. 2022 hormon tedavisi konum bildirisi. <a href="https://menopause.org/wp-content/uploads/professional/nams-2022-hormone-therapy-position-statement.pdf" target="_blank" rel="noopener noreferrer">Sistemik ve lokal tedavi, kilo ve saç için kanıtın sınırları</a>.</li>
          <li id="kaynak-2">NICE. NG23, Menopause: identification and management, güncel öneriler. <a href="https://www.nice.org.uk/guidance/ng23/chapter/Recommendations" target="_blank" rel="noopener noreferrer">Belirtiler, kemik sağlığı, tedavi riskleri ve izlem</a>.</li>
          <li id="kaynak-3">Cintron D ve ark. Efficacy of menopausal hormone therapy on sleep quality: systematic review and meta-analysis. Endocrine. 2017;55:702–711. <a href="https://pubmed.ncbi.nlm.nih.gov/27515805/" target="_blank" rel="noopener noreferrer">Başlangıçtaki sıcak basması ve gece terlemesine göre uyku yararı</a>.</li>
          <li id="kaynak-4">ESHRE, ASRM, CRE-WHiRL ve IMS. Evidence-based guideline: Premature Ovarian Insufficiency, 2024 kılavuzu / 2025 dergi yayını. <a href="https://www.asrm.org/practice-guidance/practice-committee-documents/evidence-based-guideline-premature-ovarian-insufficiency--2024/" target="_blank" rel="noopener noreferrer">Erken yumurtalık yetmezliğinde hormon tedavisi önerileri ve kanıt kesinliği</a>.</li>
          <li id="kaynak-5">European Society of Endocrinology. Clinical practice guideline for evaluation and management of menopause and the perimenopause. Eur J Endocrinol. 2025;193:G49–G81. <a href="https://doi.org/10.1093/ejendo/lvaf206" target="_blank" rel="noopener noreferrer">Zamanlama, kemik, kalp-damar hastalığı, ruh hali, demans ve özel durumlar</a>.</li>
          <li id="kaynak-6">Skin Rejuvenation in Women using Menopausal Hormone Therapy: A Systematic Review and Meta-Analysis. J Menopausal Med. 2023;29:97–111. <a href="https://e-jmm.org/DOIx.php?id=10.6118/jmm.22042" target="_blank" rel="noopener noreferrer">Cilt ölçümlerindeki değişimler ve çalışmaların sınırlılıkları</a>.</li>
