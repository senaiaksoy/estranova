  articleSection: 'Bilimsel Pencere',
  sectionPath: '/bilimsel-pencere/',
  keywords: [
    'GLP-1 analogları',
    'semaglutid',
    'tirzepatid',
    'menopozal kilo',
    'obezite tedavisi',
    'STEP çalışması',
