const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Menopozal Kilo İçin GLP-1 Analogları: Abartısız Klinik Karar';
const seoTitle = 'Menopozal Kilo İçin GLP-1 Analogları';
const articleDescription =
  'Menopozda GLP-1 ilaçları: obezitedeki kilo kaybı verileri, kas ve kemik sağlığı, hormon tedavisiyle kullanım ve güvenlik sınırları.';
const faqItems = articleFaqs['/bilimsel-pencere/yeni-arastirmalar/glp1-analoglari-menopozal-kilo/'] ?? [];
const articleSchemas = buildArticleSchemas({
