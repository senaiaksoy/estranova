import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import SaveForLaterButton from '../../../components/site/SaveForLaterButton.astro';
import ReadingControls from '../../../components/site/ReadingControls.astro';
import RedFlagBox from '../../../components/site/RedFlagBox.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../../components/site/ArticleFAQ.astro';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { articleFaqs } from '../../../data/article-faqs';
import { resolveSiteUrl } from '../../../utils/seo';

const pathname = '/bilimsel-pencere/yeni-arastirmalar/menopoz-hrt-meme-kanseri-riski/';
const hero = submenuHeroByRoute[pathname] ?? submenuHeroByRoute['/bilimsel-pencere/yeni-arastirmalar/']!;

const tocEntries = [
  { id: 'neden-korku', label: 'Korku Nereden Geliyor' },
  { id: 'yeni-veri', label: 'Yeni Verinin Katkısı' },
  { id: 'risk-tek-parca-degil', label: 'Risk Tek Parça Değil' },
  { id: 'rota-ve-progesteron', label: 'Uygulama Yolu ve Progesteron' },
  { id: 'kimlerde-daha-dikkatli', label: 'Kimlerde Daha Dikkatli' },
  { id: 'mutlak-risk', label: 'Göreceli ve Mutlak Risk' },
  { id: 'doktora-uc-soru', label: 'Hekime Üç Soru' },
  { id: 'kapanis', label: 'Görüşmeye Hazırlanırken' },
  { id: 'kaynaklar', label: 'Kaynaklar' },
  { id: 'sik-sorulanlar', label: "Dr. Aksoy'a Sorular" },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Menopozda Hormon Tedavisi ve Meme Kanseri Riski: Yeni Veriler Gerçekten Neyi Değiştirdi?';
const seoTitle = 'HRT ve Meme Kanseri Riski';
const articleDescription =
  'Menopozda hormon tedavisi ve meme kanseri riski: kombine tedavi, yalnızca östrojen, uygulama yolu ve kullanım süresine ilişkin veriler ne söylüyor?';
const articleImage = '/images/library/editorial/senai-hrt-meme-kanseri-hero.webp';
const faqItems = articleFaqs[pathname] ?? [];
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'senai-aksoy',
  articleType: 'clinical-guide',
  publishedDate: '6 Mayıs 2026',
  modifiedDate: '12 Ekim 2026',
  image: articleImage,
  pathname,
  articleSection: 'Bilimsel Pencere',
  sectionPath: '/bilimsel-pencere/',
  keywords: [
    'menopoz',
    'hormon tedavisi',
    'HRT',
    'meme kanseri riski',
    'östrojen',
    'progesteron',
    'transdermal östrojen',
    'mutlak risk',
    'menopoz araştırmaları',
  ],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  image={articleImage}
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/bilimsel-pencere/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Bilimsel Pencere · Yeni Araştırmalar"
      title={articleTitle}
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="senai-aksoy"
        articleType="clinical-guide"
        publishedDate="6 Mayıs 2026"
        lastUpdated="12 Ekim 2026"
        readingMinutes={10}
        imageSrc={articleImage}
        imageAlt="Krem tonlarda giyinmiş, düşünceli ifadesiyle pencereden ışık alan zarif bir kadın portresi."
        imagePosition="center top"
      />

      <div class="flex flex-wrap items-center justify-end gap-3">
        <ReadingControls />
        <SaveForLaterButton slug={pathname} title={articleTitle} />
      </div>

      <ArticleSummary title="Kısa Klinik Yanıt">
        <p>
          <strong>Östrojen ve progestajen içeren kombine sistemik hormon tedavisi meme kanseri
          riskini artırabilir; kullanım uzadıkça artış belirginleşir.</strong> Yalnızca östrojen
          ve düşük doz vajinal östrojen farklı değerlendirilir; ciltten uygulama ise meme
          kanseri riskinin daha düşük olduğunu kanıtlamaz. Kişisel meme kanseri öyküsü,
          tedavinin uygunluğu açısından ayrıca değerlendirilmesi gereken bir güvenlik sınırıdır.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="neden-korku">Yirmi Yıllık Korku Cümlesinin İzi</h2>
        <p>
          Sıcak basmaları için bir çözüm ararken okuduğunuz bir kanser başlığı, tedaviden
          beklediğiniz faydayı bir anda geri plana itebilir. Böyle bir kaygıyı konuşmak için
          önce hangi tedaviden söz edildiğini bilmek gerekir.
        </p>
        <p>
          Menopozal hormon tedavisi, sık kullanılan kısaltmasıyla <strong>HRT</strong>, tek
          bir ilaç değildir. Sistemik tedavi hormonun kan dolaşımına geçerek bütün vücudu
          etkilemesini anlatır. Kombine tedavide östrojene, progesteron veya benzeri etki
          gösteren bir hormon eklenir; bu grubun ortak adı <strong>progestajen</strong>dir.
        </p>
        <p>
          Rahmi olan kadınlarda bu ek hormonun amacı rahim iç tabakasını östrojenin etkisine
          karşı korumaktır. Rahmi alınmış kadınlarda çoğunlukla yalnızca östrojen kullanılır.
          Meme riskini azaltmak düşüncesiyle progestajeni çıkarmak, rahim iç tabakası açısından
          başka bir risk yaratabilir <sup><a href="#kaynak-6">[6]</a></sup>.
        </p>

        <h2 id="yeni-veri">Yeni Verinin Eski Tartışmaya Kattığı</h2>
        <p>
          Uzun dönem takipler, farklı tedavilerin meme üzerindeki etkisini daha açık
          gösteriyor. Buradaki “yeni veri”, 2026'da yapılmış tek bir araştırmayı değil,
          önceki çalışmaların izlem sonuçlarını anlatıyor.
        </p>
        <p>
          Kadınların tedavi ve etkin ilaç içermeyen plasebo gruplarına rastgele ayrıldığı iki büyük araştırmanın
          2020'de yayımlanan uzun dönem sonuçları önemli bir ayrım gösterdi. Rahmi olan
          kadınlarda <strong>konjuge östrojen (bir östrojen karışımı) ve medroksiprogesteron asetat</strong> birleşimi,
          plaseboya göre daha fazla yeni meme kanseri tanısıyla ilişkiliydi. Rahmi alınmış
          kadınlarda yalnızca konjuge östrojen verilen grupta ise daha az tanı görüldü
          <sup><a href="#kaynak-4">[4]</a></sup> <Evidence level={5} />.
        </p>
        <p>
          Bunlar farklı rahim durumlarına sahip iki ayrı çalışma grubuydu; östrojen ve
          kombine tedavi aynı kadınlarda doğrudan karşılaştırılmadı. Sonuçlar araştırmada
          kullanılan ilaçlara aittir. Özellikle yalnızca östrojen bulgusu, bütün östrojen
          ürünlerinin meme kanserinden koruduğu şeklinde yorumlanamaz.
        </p>
        <p>
          Kadınları zaman içinde izleyen gözlemsel araştırmalar ise bazı farklı sonuçlar
          veriyor. Bu çalışmalarda kombine tedavilerde risk artışı daha belirgin; progestajenin
          her gün alındığı düzenlerde, ayın bir bölümünde alındığı düzenlere göre daha yüksek
          bulunabiliyor. Bu veriler önemli olsa da tedavi seçimi ve diğer risk etkenlerinin
          etkisini bütünüyle ayıramıyor <sup><a href="#kaynak-1">[1]</a></sup>
          <sup><a href="#kaynak-7">[7]</a></sup> <Evidence level={3} />.
        </p>

        <h2 id="risk-tek-parca-degil">Risk Tek Parça Değil: Yaş, Zamanlama ve Süre</h2>
        <p>
          Başlangıç yaşı genel fayda-risk dengesini, kullanım süresi ise meme kanseri
          riskindeki artışı anlamak için önemlidir. Bu iki soruyu ayrı değerlendirmek,
          erken başlanmış tedavinin risksiz olduğu yanılgısını önler.
        </p>
        <p>
          Tedaviye 60 yaşından önce veya menopoz başlangıcından sonraki 10 yıl içinde
          başlandığında, kullanımına engel bir hastalığı olmayan kadınlarda genel denge
          daha elverişli kabul edilir. Burada sıcak basmalarının hafiflemesi ve kemik kaybının
          önlenmesi gibi yararlar da hesaba katılır. Bu zaman aralığı meme kanseri açısından
          bir güvenlik garantisi değildir <sup><a href="#kaynak-6">[6]</a></sup>.
        </p>
        <p>
          Kombine sistemik tedavide kullanım uzadıkça meme kanseri riski artar. Bırakıldıktan
          sonra risk azalabilir; ancak uzun süre kullananlarda artışın bir bölümü yıllarca
          sürebilir. Bu yüzden beş yıl, her kadın için geçerli bir “güvenli kullanım sınırı”
          değildir <sup><a href="#kaynak-3">[3]</a></sup>
          <sup><a href="#kaynak-7">[7]</a></sup> <Evidence level={3} />.
        </p>
        <p>
          Aile öyküsü, önceki meme biyopsilerinin sonucu, meme yoğunluğu, obezite, alkol
          kullanımı ve fiziksel aktivite de kişisel değerlendirmeye dahildir. Bunlar,
          tedavi almadan önceki <strong>temel riskinizi</strong> anlamaya yardımcı olur.
          Temel risk ile tedavinin eklediği risk aynı ölçü değildir
          <sup><a href="#kaynak-6">[6]</a></sup>.
        </p>

        <h2 id="rota-ve-progesteron">Oral, Transdermal ve Progesteron Eşlikleri Aynı Değil</h2>
        <p>
          Bir ilacın ciltten verilmesi pıhtı riski açısından avantaj sağlayabilir; meme
          kanseri açısından aynı avantaj gösterilmiş değildir. Progesteron türüyle ilgili
          bulgular da bu ayrımdan ayrı okunmalıdır.
        </p>
        <p>
          <strong>Transdermal</strong>, hormonun yama veya jel gibi ürünlerle ciltten
          verilmesidir; <strong>oral</strong> ise ağızdan alınmasıdır. Ciltten östrojen ve
          daha düşük dozlar, toplardamarda pıhtı ve inme riskini azaltabilir; fakat bu yolları
          doğrudan karşılaştıran randomize veriler yetersizdir
          <sup><a href="#kaynak-6">[6]</a></sup>.
        </p>
        <p>
          2018'de yayımlanan İsveç çalışması, 290 186 hormon tedavisi kullanıcısını izledi.
          Meme kanseriyle ilişki ağızdan ve ciltten uygulamada benzerdi
          <sup><a href="#kaynak-1">[1]</a></sup> <Evidence level={3} />.
          2017 tarihli başka bir gözlemsel çalışmada da genel fayda-risk indeksi benzer
          bulundu; ancak bu indeks meme kanseriyle birlikte kalp-damar olayları, kırık ve
          ölüm gibi sonuçları içeriyordu. Dolayısıyla yalnızca meme kanseri riskini ölçen
          bir karşılaştırma değildir <sup><a href="#kaynak-2">[2]</a></sup>.
        </p>
        <p>
          Progesteron ve onun sentetik benzerleri olan progestinler arasında da fark olabilir.
          2014 tarihli Fransız takip çalışmasında, <strong>beş yıl veya daha kısa süre</strong>
          östrojen ile progesteron ya da didrogesteron kullananlarda istatistiksel olarak
          belirgin risk artışı görülmedi. Diğer progestajenleri kullananlarda artış saptandı.
          Bu gözlemsel bulgu, progesteronun bütün kullanım sürelerinde risksiz olduğunu
          göstermez <sup><a href="#kaynak-3">[3]</a></sup> <Evidence level={3} />.
        </p>
        <p>
          2012 tarihli bir derleme de progesteronun daha düşük riskli olabileceğini
          tartışıyor. Bu olasılık, güçlü karşılaştırmalı klinik kanıtla doğrulanmış bir
          güvenlik üstünlüğü değildir <sup><a href="#kaynak-5">[5]</a></sup>
          <Evidence from={1} to={2} />.
        </p>

        <h2 id="kimlerde-daha-dikkatli">Daha Dikkatli Değerlendirme Gereken Durumlar</h2>
        <p>
          Ailede meme kanseri bulunması ile sizin meme kanseri geçirmiş olmanız aynı
          durum değildir. Kişisel kanser öyküsü, tedavinin uygunluğunu doğrudan etkileyen
          bir güvenlik sınırıdır.
        </p>
        <p>
          <strong>Meme kanseri öyküsünde sistemik hormon tedavisi genellikle önerilmez.</strong>
          Hormonlardan etkilenen kanser öyküsü ve açıklanmamış vajinal kanama, sistemik
          tedavinin kullanılmaması gereken durumlar arasında yer alır. Önceden geçirilmiş pıhtı, inme, kalp krizi veya kalbi besleyen damarların hastalığı, karaciğer hastalığı ve kalıtsal yüksek pıhtı riski de sistemik tedavinin kullanılmaması gereken durumlar arasında sayılır.
          Ağır belirtiler için düşünülebilecek istisnai kararlar, onkoloji ekibiyle birlikte
          ele alınır; yalnızca daha sık takip yapılması bu riskleri ortadan kaldırmaz
          <sup><a href="#kaynak-6">[6]</a></sup>.
        </p>
        <p>
          Aile öyküsü, bilinen kalıtsal yüksek risk veya netleşmemiş meme görüntüleme bulgusu
          ise ayrıca incelenir. Özellikle 60 yaş sonrasında ya da menopozdan 10 yıldan fazla
          zaman geçince yeni tedaviye başlamak, genel fayda-risk dengesini daha az elverişli
          kılabilir <sup><a href="#kaynak-6">[6]</a></sup>.
        </p>
        <p>
          <strong>Düşük doz lokal vajinal östrojen</strong>, vajinal kuruluk ve idrar yolu
          çevresindeki yakınmalar için kullanılır; kana geçen miktarı sistemik tedaviden
          çok daha düşüktür. Meme kanseri geçirmiş kişilerde hormon dışı seçenekler yeterli
          olmazsa, bu tedavi onkoloji ekibiyle ortak değerlendirme sonucunda düşünülebilir.
          Özellikle aromataz inhibitörü adlı kanser ilaçlarını kullananlarda belirsizlikler
          ayrıca konuşulur <sup><a href="#kaynak-6">[6]</a></sup>.
        </p>
        <RedFlagBox
          title="Tedavi öncesinde ayrıca değerlendirilmesi gerekenler"
          intro="Bu durumların bir bölümü ek değerlendirme, bir bölümü ise sistemik hormon tedavisinden kaçınmayı gerektirir."
          markers={[
            'Kişisel meme kanseri öyküsü veya aktif meme değerlendirme süreci',
            'Güçlü aile öyküsü ya da bilinen kalıtsal yüksek risk tablosu',
            'Uzun süreli kombine sistemik tedavi gereksinimi',
            '60 yaş sonrasında yeni tedavi başlangıcı',
            'Açıklanmamış vajinal kanama veya netleşmemiş meme görüntüleme bulguları',
            'Geçirilmiş pıhtı, inme veya koroner kalp hastalığı; karaciğer hastalığı',
          ]}
          footnote="Tarama ve izlem planı kişisel öyküye göre düzenlenir; normal bir mamografi tedavinin risksiz olduğunu göstermez."
        />

        <h2 id="mutlak-risk">Göreceli Risk ile Mutlak Risk Neden Aynı Şey Değil?</h2>
        <p>
          Göreceli risk, iki gruptaki olasılıkların oranıdır. Mutlak risk ise belirli bir
          zaman aralığında kaç kişide ek tanı beklendiğini anlatır; karar verirken bu zaman
          aralığını bilmek gerekir.
        </p>
        <p>
          Gözlemsel çalışmaların 2019'da birlikte değerlendirildiği analiz, ortalama kilodaki
          ve gelişmiş ülkelerde yaşayan kadınlar için bir tahmin verdi. Tedaviye 50 yaşında
          başlayıp beş yıl östrojen ve her gün progestajen kullanılması, <strong>50–69 yaş
          arasındaki toplam dönemde yaklaşık her 50 kullanıcı için bir ek meme kanseri
          tanısı</strong> ile ilişkiliydi. Yalnızca östrojende tahmin her 200 kullanıcı için
          bir ek tanıydı. Bunlar beş yıllık kullanım sırasında veya her yıl beklenen sayılar
          değildir; ilişkinin büyük ölçüde nedensel olduğu varsayımına dayanır
          <sup><a href="#kaynak-7">[7]</a></sup> <Evidence level={3} />.
        </p>
        <p>
          Yalnızca östrojen için bu tahminin, rastgele gruplama yapılan araştırmanın
          sonucundan farklı olduğunu fark etmiş olabilirsiniz. Gözlemsel veri ile
          randomize veri aynı sonuca varmadığında bu farkı saklamamak gerekir. Rakamları
          kişisel risk hesabı gibi kullanmak veya östrojenin koruyucu olduğunu varsaymak
          doğru olmaz <sup><a href="#kaynak-4">[4]</a></sup>
          <sup><a href="#kaynak-7">[7]</a></sup>.
        </p>
        <p>
          Temel riski yüksek olan bir kadında aynı göreceli artış, daha fazla ek tanıya
          karşılık gelebilir. Bu nedenle “Risk artıyor mu?” sorusunun yanında,
          “Benim yaşımda ve planlanan kullanım süremde bu artışın mutlak karşılığı nedir?”
          sorusu da önemlidir.
        </p>

        <h2 id="doktora-uc-soru">Hekiminize sorabileceğiniz üç net soru</h2>
        <p>
          Görüşmeye giderken kullandığınız ilacın adını ve kullanım süresini not edebilirsiniz.
          Aşağıdaki üç soru, konuşmayı genel bir korkudan sizin durumunuza taşımaya yardımcı olur.
        </p>
        <p>
          <strong>Birinci soru:</strong> <em>“Benim kişisel meme kanseri riskim nedir ve hormon
          tedavisi buna ne kadar eklenebilir?”</em> Aile öyküsü, meme yoğunluğu, önceki biyopsi
          sonuçları ve yaşam tarzı bu değerlendirmenin parçalarıdır.
        </p>
        <p>
          <strong>İkinci soru:</strong> <em>“Sistemik kombine tedaviyi mi, yalnızca östrojeni mi,
          yoksa düşük doz lokal vajinal tedaviyi mi konuşuyoruz?”</em> İlacın hangi belirti
          için düşünüldüğünü ve rahim durumunuzla ilişkisini öğrenebilirsiniz.
        </p>
        <p>
          <strong>Üçüncü soru:</strong> <em>“Faydayı, yan etkileri ve tedaviyi sürdürme ihtiyacını
          ne zaman yeniden değerlendireceğiz?”</em> Takipte yalnızca bir tarihin dolması değil,
          belirtilerin ve risklerin değişmesi de önemlidir
          <sup><a href="#kaynak-6">[6]</a></sup>.
        </p>

        <h2 id="kapanis">Görüşmeye Hazırlanırken</h2>
        <p>
          Bir risk başlığını okuduktan sonra kararınızı hemen vermeniz gerekmez. Önce
          tedavinin size ne sağlayacağını ve hangi güvenlik sınırlarının sizin için geçerli
          olduğunu anlamaya zaman ayırabilirsiniz.
        </p>
        <p>
          Aklınıza takılan bir cümleyi, önceki meme incelemelerinizi ve belirtilerinizin
          günlük yaşamınıza etkisini görüşmeye götürün. Böylece sizin için önemli olan
          sorular, genel başlıkların arasında kaybolmaz.
        </p>
      </ArticleProsePanel>


      <ArticleProsePanel class="mt-10 [&_.prose-estranova]:[counter-reset:estranova-chapter_8]">
        <h2 id="kaynaklar">Kaynaklar</h2>
        <p>İlaç türü, kullanım süresi ve güvenlik ayrımlarının dayandığı seçilmiş çalışmalar ve kılavuz:</p>
        <ol>
          <li id="kaynak-1">Brusselaers N, Tamimi RM, Konings P, Rosner B, Adami HO, Lagergren J. <em>Different menopausal hormone regimens and risk of breast cancer.</em> Ann Oncol. 2018;29(8):1771-1776. <a href="https://doi.org/10.1093/annonc/mdy212" rel="noopener noreferrer">DOI</a>.</li>
          <li id="kaynak-2">Crandall CJ ve ark. <em>Comparison of clinical outcomes among users of oral and transdermal estrogen therapy in the Women's Health Initiative Observational Study.</em> Menopause. 2017;24(10):1145-1153. <a href="https://doi.org/10.1097/GME.0000000000000899" rel="noopener noreferrer">DOI</a>.</li>
          <li id="kaynak-3">Fournier A ve ark. <em>Risk of breast cancer after stopping menopausal hormone therapy in the E3N cohort.</em> Breast Cancer Res Treat. 2014;145(2):535-543. <a href="https://doi.org/10.1007/s10549-014-2934-6" rel="noopener noreferrer">DOI</a>.</li>
