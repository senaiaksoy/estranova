  { id: 'biyoloji', label: 'Biyoloji Sağlam — Klinik Sonuç Henüz Belirsiz' },
  { id: 'yasla-dusus', label: 'Yaşla Düşüş — Farede Net, İnsanda Karışık' },
  { id: 'nmn-nr', label: 'NMN ve NR — Kandaki Sayı Başka, Sağlık Kazancı Başka' },
  { id: 'fertilite', label: 'Fertilite İddiaları — Fareden Kadına Geçmeyen Basamak' },
  { id: 'guvenlik', label: 'Güvenlik ve Düzenleme — Kısa Vade Rahat, Uzun Vade Belirsiz' },
  { id: 'urun-kalitesi', label: 'Ürün Kalitesi — Etiketteki ile Kutudaki' },
