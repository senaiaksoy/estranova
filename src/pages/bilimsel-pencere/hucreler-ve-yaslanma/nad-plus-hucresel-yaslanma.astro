import { buildArticleSchemas } from '../../../utils/article-schema';
import { articleFaqs } from '../../../data/article-faqs';
import { resolveSiteUrl } from '../../../utils/seo';

const hero = submenuHeroByRoute['/bilimsel-pencere/hucreler-ve-yaslanma/']!;

const tocEntries = [
  { id: 'once-soru', label: 'NAD+ — Hücrenin Enerji ve Onarım Koenzimi' },
  { id: 'kanit-merdiveni', label: 'Kanıt Merdiveni — Hücreden Kliniğe Altı Basamak' },
  { id: 'biyoloji', label: 'Biyoloji Sağlam — Klinik Sonuç Henüz Belirsiz' },
  { id: 'yasla-dusus', label: 'Yaşla Düşüş — Farede Net, İnsanda Karışık' },
  { id: 'nmn-nr', label: 'NMN ve NR — Kandaki Sayı Başka, Sağlık Kazancı Başka' },
  { id: 'fertilite', label: 'Fertilite İddiaları — Fareden Kadına Geçmeyen Basamak' },
  { id: 'guvenlik', label: 'Güvenlik ve Düzenleme — Kısa Vade Rahat, Uzun Vade Belirsiz' },
  { id: 'urun-kalitesi', label: 'Ürün Kalitesi — Etiketteki ile Kutudaki' },
  { id: 'karar', label: 'Denemeyi Düşünüyorsanız Nereden Başlamalı?' },
  { id: 'acik-sorular', label: 'Menopoz ve Bilinmeyenler — Açık Kalan Biyoloji Soruları' },
  { id: 'kapanis', label: 'Kapanış — Hücrede Önemli, Klinikte Açık Soru' },
