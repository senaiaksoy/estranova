const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'NAD+ ve Hücresel Yaşlanma — Biyobelirteç ile Klinik Fayda Arasındaki Mesafe';
const seoTitle = 'NAD+ ve Hücresel Yaşlanma';
const articleDescription =
  'NAD+ öncülleri kandaki NAD+ düzeyini yükseltebilir; ama kas, metabolizma ve uzun yaşam faydası için insan kanıtı sınırlı. Mesafe sakin bir dille açıklanıyor.';
const faqItems = articleFaqs['/bilimsel-pencere/hucreler-ve-yaslanma/nad-plus-hucresel-yaslanma/'] ?? [];
const articleSchemas = buildArticleSchemas({
