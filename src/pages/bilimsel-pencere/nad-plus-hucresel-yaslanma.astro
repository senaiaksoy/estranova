---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuHero from '../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../components/site/ArticleProsePanel.astro';
import { submenuHeroByRoute } from '../../data/submenu-heroes';
import Evidence from '../../components/site/Evidence.astro';
import { buildArticleSchemas } from '../../utils/article-schema';
import { resolveSiteUrl } from '../../utils/seo';

const hero = submenuHeroByRoute['/bilimsel-pencere/nad-plus-hucresel-yaslanma']!;

const tocEntries = [
  { id: 'nad-nedir', label: 'NAD+ Nedir?' },
  { id: 'yas-ile-degisim', label: 'Yaşla Değişim' },
  { id: 'yaslanma-baglantisi', label: 'Yaşlanma Bağlantısı' },
  { id: 'arastirma-bulgulari', label: 'Araştırma Bulguları' },
  { id: 'artirma-yaklasimlari', label: 'Artırma Yaklaşımları' },
  { id: 'ticari-takviyeler', label: 'Ticari Takviyeler' },
  { id: 'pratik-yol-haritasi', label: 'Pratik Yol Haritası' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'NAD+ ve Hücresel Yaşlanma — Gelişmekte Olan Bilim';
const articleDescription = 'NAD+ biyolojisi, yaşlanma ilişkisi ve erken evre insan araştırmalarını kanıt düzeyleriyle açıklayan bilimsel derleme.';
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'basak-pelister',
  publishedDate: '14 Nisan 2026',
  pathname: '/bilimsel-pencere/nad-plus-hucresel-yaslanma',
  articleSection: 'Bilimsel Pencere',
  sectionPath: '/bilimsel-pencere',
  keywords: ['NAD+', 'hücresel yaşlanma', 'sirtuin', 'biohacking', 'menopoz'],
  siteUrl,
});
---

<SiteLayout
  title={`${articleTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/bilimsel-pencere" />

  <main id="main-content" class="text-[#2D2D2D]">
    <SubmenuHero
      eyebrow="Bilimsel Pencere · Araştırma özeti"
      title="NAD+ ve Hücresel Yaşlanma — Gelişmekte Olan Bilim"
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <SubmenuArticleBody>
        <ArticleTOC slot="toc" entries={tocEntries} />
        <ArticleAuthorBlock authorSlug="basak-pelister" publishedDate="14 Nisan 2026" readingMinutes={3} />

        <section class="rounded-[28px] border border-[#C9A96E]/35 bg-gradient-to-br from-white to-[#FDF8F0]/90 p-7 shadow-sm ring-1 ring-[#C9A96E]/22 md:p-8">
          <h2 class="mb-4 font-serif text-3xl">Kısa Özet</h2>
          <p class="leading-relaxed text-[#2D2D2D]/80">
            NAD+ hücresel enerji ve onarımda kritik bir moleküldür. Yaşla birlikte NAD+ seviyeleri azalabilir ve bu değişim yaşlanma biyolojisiyle ilişkilidir.
            Araştırmalar ilgi çekici olsa da insan uygulamalarında kanıt henüz erken evrededir. Bu yazı, mevcut bilimin bugün nerede durduğunu dengeli biçimde açıklar.
          </p>
        </section>

        <ArticleProsePanel>
          <h2 id="nad-nedir">NAD+ Nedir?</h2>
          <p>
            NAD+ adı teknik gelebilir, ama merak ettiğimiz şey çok gündelik: enerjimiz, toparlanmamız ve yaş alma ritmimiz. NAD+ (Nikotinamid Adenin Dinükleotid), hücre içinde enerji üretimi ve redoks dengesi için gerekli temel bir koenzimdir <Evidence level={5} />.
            Mitokondriyal ATP üretiminden DNA onarımına kadar birçok biyolojik süreçte rol oynar.
          </p>
          <p>
            Sirtuin adı verilen bazı enzimlerin çalışması da NAD+ varlığına bağlıdır <Evidence level={5} />. Bu nedenle NAD+, yalnızca enerji metabolizmasının değil,
            hücresel dayanıklılık ve yaşlanma biyolojisinin de önemli bir parçası olarak görülür.
          </p>

          <h2 id="yas-ile-degisim">Yaş ile NAD+ Seviyeleri Nasıl Değişir?</h2>
          <p>
            40 sonrası “neden eskisi kadar çabuk toparlanmıyorum?” sorusu çoğumuzun aklından geçer; araştırmalar yaş ilerledikçe çeşitli dokularda NAD+ düzeylerinde azalma olabileceğini göstermektedir <Evidence level={4} />.
            Bu düşüşün düzeyi kişiye, dokuya ve eşlik eden sağlık durumlarına göre farklılık gösterebilir.
          </p>
          <p>
            Olası nedenler arasında artan oksidatif stres, PARP aktivitesinde artış, CD38 ekspresyonundaki değişimler ve metabolik yük bulunur <Evidence level={4} />.
            Bu mekanizmalar umut verici olsa da insanlar üzerindeki uzun dönem etkiler hâlâ netleştirilmektedir.
          </p>

          <h2 id="yaslanma-baglantisi">NAD+ Düşüşü ile Yaşlanma Belirtileri Arasındaki Bağlantı</h2>
          <p>
            NAD+ anlatısını değerli kılan şey, laboratuvar terimlerinin günlük hislerimize bağlanabilmesidir. Düşen NAD+ düzeyleri, mitokondri işlevi, DNA onarım kapasitesi ve metabolik esneklikte azalma ile ilişkilendirilmektedir <Evidence level={4} />.
            Bu ilişki özellikle hayvan modellerinde belirgin biçimde gösterilmiştir.
          </p>
          <p>
            İnsan çalışmalarında ise enerji düzeyi, kas performansı, bilişsel süreçler ve metabolik göstergeler üzerinden dolaylı ilişkiler bildirilmektedir.
            Ancak bu ilişkilerin neden-sonuç düzeyinde yorumlanabilmesi için daha büyük ve uzun süreli çalışmalara ihtiyaç vardır.
          </p>

          <h2 id="arastirma-bulgulari">Araştırma Bulguları: Hayvan Modelleri ve Erken İnsan Çalışmaları</h2>
          <p>
            Burada heyecanı da temkini de aynı anda tutmak gerekir; C. elegans, Drosophila ve fare çalışmalarında NAD+ yolaklarını hedefleyen müdahalelerin bazı yaşlanma belirteçlerinde iyileşme sağladığı
            bildirilmiştir <Evidence level={4} />. Bu bulgular araştırma açısından değerlidir, fakat doğrudan insan sonucu olarak yorumlanamaz.
          </p>
          <p>
            Erken dönem insan çalışmalarında NR ve NMN gibi NAD+ öncüllerinin biyobelirteç düzeylerinde artış sağlayabildiği görülmüştür <Evidence level={4} />.
            Buna rağmen örneklem büyüklükleri sınırlıdır ve klinik sonlanım noktaları açısından sonuçlar henüz heterojendir <Evidence level={3} />.
          </p>

          <h2 id="artirma-yaklasimlari">NAD+ Artırmaya Yönelik Yaklaşımlar</h2>
          <p>
            NAD+ seviyesini artırma fikri kulağa takviyeyle başlayacakmış gibi gelebilir; oysa çalışmalarda en çok değerlendirilen yollar NR, NMN ve B3 türevleri gibi öncül takviyelerle birlikte yaşam tarzı müdahaleleridir.
            Düzenli egzersiz, uyku kalitesi ve beslenme düzeninin mitokondriyal işlev üzerinde güçlü etkisi olduğu bilinmektedir <Evidence level={5} />.
          </p>
          <p>
            Takviye stratejileri için kanıt düzeyi daha çok orta ve gelişen kanıt aralığındadır <Evidence from={3} to={4} />.
            Yaşam alışkanlığı müdahaleleri ise hem maliyet etkinlik hem güvenlik hem de kanıt gücü açısından halen temel yaklaşım olarak öne çıkar.
          </p>

          <h2 id="ticari-takviyeler">Ticari NAD+ Takviyelerine Eleştirel Bakış</h2>
          <p>
            Bir ürün “hücresel gençlik” vadettiğinde durup nefes almak iyi gelir; ticari içeriklerde NAD+ takviyelerine dair iddialar bazen mevcut bilimsel verinin ötesine geçebilir. Oysa bugünkü tablo,
            “ilgi çekici ve umut veren, fakat gelişen kanıt” şeklinde özetlenmelidir.
          </p>
          <p>
            Biyoyararlanım, optimum doz, kullanım süresi ve uzun dönem güvenlik gibi temel soruların bir kısmı hâlâ araştırma aşamasındadır.
            Bu nedenle karar verirken yalnızca pazarlama mesajına değil, kanıt düzeyine ve kişisel sağlık profiline bakmak gerekir.
          </p>

          <h2 id="pratik-yol-haritasi">Kanıt-Tabanlı Pratik Yol Haritası</h2>
          <p>
            Bugün kendi hayatında uygulayabileceğin en sakin başlangıç, hâlâ temel alışkanlıklardır: düzenli hareket, yeterli uyku, dengeli beslenme ve stres yönetimi <Evidence level={5} />.
            Bunlar hem NAD+ biyolojisiyle ilişkili yolları hem de genel sağlıklı yaşlanma göstergelerine katkı sağlayabilir.
          </p>
          <p>
            NAD+ takviyeleri değerlendirilirken hekim görüşü almak, ilaç etkileşimlerini kontrol etmek ve beklentiyi gerçekçi tutmak gerekir.
            Araştırma ilerledikçe bu alan daha netleşecektir; bugün için en dengeli yaklaşım, güçlü yaşam alışkanlıkları üzerine kurulu bir planla ilerlemektir.
          </p>
        </ArticleProsePanel>

        <section class="mt-14 rounded-[28px] border border-[#6B2D3E]/12 bg-[#FDF8F0] p-7 shadow-sm ring-1 ring-[#6B2D3E]/10 md:p-8">
          <h2 class="mb-5 font-serif text-3xl">İlgili İçerikler</h2>
          <ul class="space-y-3">
            <li><a href="/bilimsel-pencere/mitler" class="font-semibold text-[#6B2D3E] hover:underline">Bilimsel Pencere / Mitler ve Gerçekler</a></li>
            <li><a href="/zamansiz-yasam/hareket-saglik-menopoz" class="font-semibold text-[#6B2D3E] hover:underline">Zamansız Yaşam / Hareket ve Yaşam Süresi</a></li>
            <li><a href="/zamansiz-yasam/beslenme-yaslanma" class="font-semibold text-[#6B2D3E] hover:underline">Zamansız Yaşam / Beslenme ve Yaşlanma</a></li>
            <li><a href="/zihin-denge/uyku-bozuklugu-menopoz" class="font-semibold text-[#6B2D3E] hover:underline">Zihin & Denge / Uyku ve Nöral Sağlık</a></li>
            <li><a href="/hormonal-gecis/40-sonrasi" class="font-semibold text-[#6B2D3E] hover:underline">Hormonal Geçiş / Menopoz Sonrası Sağlık</a></li>
          </ul>
        </section>

        <section class="mt-14 rounded-[28px] border border-[#6B2D3E]/15 border-l-[6px] border-l-[#C9A96E] bg-gradient-to-r from-[#F5EDE0] to-[#FDF8F0] p-7 shadow-sm ring-1 ring-[#6B2D3E]/10 md:p-8">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.22em] text-[#6B2D3E]">Bilimsel Editör Notu</p>
          <p class="leading-relaxed text-[#2D2D2D]/80">
            NAD+ araştırması hücresel yaşlanma alanına değerli bir perspektif sunmaktadır. Ancak insan sağlığındaki uygulamalar için güvenilir kanıtın
            önemli bir bölümü hâlâ erken aşamadadır. Takviye kararları sağlık profesyoneli eşliğinde verilmeli, temel yaklaşım olarak düzenli hareket,
            uyku ve beslenme alışkanlıkları korunmalıdır.
          </p>
        </section>

        <section class="mt-10 rounded-[24px] border border-dashed border-[#6B2D3E]/25 bg-white/95 p-6 ring-1 ring-[#6B2D3E]/10">
          <p class="text-sm leading-relaxed text-[#2D2D2D]/75">
            Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme yerine geçmez. Tanı ve tedavi kararları için sağlık profesyoneline başvurunuz.
          </p>
        </section>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
