---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
---

<SiteLayout
  title="Bilimsel Pencere - Estranova"
  description="Uzman görüşleri, güncel araştırma özetleri ve sağlık dünyasının yaygın mitlerinin bilimsel gerçeklerle karşılaştırılması."
>
  <SiteNavbar currentPath="/bilimsel-pencere" />

  <main id="main-content" class="pt-24 text-[#2D2D2D]">
    <section class="bg-[#FDF8F0] px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <header class="mb-12 max-w-4xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.26em] text-[#6B2D3E]">Kategori</p>
          <h1 class="mb-6 font-serif text-5xl leading-[1.06] md:text-7xl">Bilimsel Pencere</h1>
          <p class="mb-4 text-lg leading-relaxed text-[#2D2D2D]/80 md:text-xl">
            Uzman görüşleri, güncel araştırma özetleri ve sağlık dünyasının yaygın mitlerinin bilimsel gerçeklerle karşılaştırılması.
          </p>
          <p class="text-lg leading-relaxed text-[#2D2D2D]/75">
            Bu bölüm, tıbbi veriyi erişilebilir bir dille sunar. Amaç, bilimsel derinliği korurken okurun konuyu
            daha açık ve dengeli biçimde değerlendirmesine yardımcı olmaktır.
          </p>
        </header>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          <article class="rounded-[32px] border border-[#6B2D3E]/12 bg-white p-7 md:p-8">
            <div class="mb-6 h-44 rounded-2xl bg-gradient-to-br from-[#F5EDE0] via-[#FDF8F0] to-[#C9A96E]/25"></div>
            <h2 class="mb-3 font-serif text-3xl">Uzman Görüşleri</h2>
            <p class="mb-5 leading-relaxed text-[#2D2D2D]/75">Editoryal danışman hekimlerin perspektifleri</p>
            <a href="/bilimsel-pencere/uzman-gorusleri" class="font-semibold text-[#6B2D3E] hover:underline">Devamını Oku</a>
          </article>

          <article class="rounded-[32px] border border-[#6B2D3E]/12 bg-white p-7 md:p-8">
            <div class="mb-6 h-44 rounded-2xl bg-gradient-to-br from-[#F5EDE0] via-[#FDF8F0] to-[#C9A96E]/25"></div>
            <h2 class="mb-3 font-serif text-3xl">Araştırma Özetleri</h2>
            <p class="mb-5 leading-relaxed text-[#2D2D2D]/75">Güncel bilimsel literatürün anlaşılır özetleri</p>
            <a href="/bilimsel-pencere/arastirma" class="font-semibold text-[#6B2D3E] hover:underline">Devamını Oku</a>
          </article>

          <article class="rounded-[32px] border border-[#6B2D3E]/12 bg-white p-7 md:p-8">
            <div class="mb-6 h-44 rounded-2xl bg-gradient-to-br from-[#F5EDE0] via-[#FDF8F0] to-[#C9A96E]/25"></div>
            <h2 class="mb-3 font-serif text-3xl">Mitler vs. Gerçekler</h2>
            <p class="mb-5 leading-relaxed text-[#2D2D2D]/75">Yaygın sağlık inançlarının bilimsel değerlendirmesi</p>
            <a href="/bilimsel-pencere/mitler" class="font-semibold text-[#6B2D3E] hover:underline">Devamını Oku</a>
          </article>
        </div>
      </div>
    </section>

    <section class="bg-white px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <header class="mb-10 max-w-3xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">Güncel Bilim</p>
          <h2 class="mb-4 font-serif text-4xl leading-tight md:text-5xl">Son Araştırma Özetleri</h2>
          <p class="text-lg leading-relaxed text-[#2D2D2D]/75">
            Sağlık literatüründeki yeni yayınlardan örnek özetler.
          </p>
        </header>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          <article class="rounded-[28px] border border-[#6B2D3E]/12 bg-[#FDF8F0] p-7">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[#6B2D3E]">Araştırma Özeti</p>
            <h3 class="mb-3 font-serif text-2xl">Uyku Kalitesi ve Hormonal Denge</h3>
            <p class="leading-relaxed text-[#2D2D2D]/75">Son yayınlarda uyku düzeni ile hormon dalgalanmaları arasındaki ilişkinin nasıl ele alındığına dair kısa bir çerçeve.</p>
          </article>

          <article class="rounded-[28px] border border-[#6B2D3E]/12 bg-[#FDF8F0] p-7">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[#6B2D3E]">Araştırma Özeti</p>
            <h3 class="mb-3 font-serif text-2xl">Fiziksel Aktivite ve Ruh Hali</h3>
            <p class="leading-relaxed text-[#2D2D2D]/75">Düzenli hareketin duygusal denge üzerindeki etkisini inceleyen yeni çalışmaların anlaşılır özeti.</p>
          </article>

          <article class="rounded-[28px] border border-[#6B2D3E]/12 bg-[#FDF8F0] p-7">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[#6B2D3E]">Araştırma Özeti</p>
            <h3 class="mb-3 font-serif text-2xl">Beslenme Kalıpları ve Metabolik Sağlık</h3>
            <p class="leading-relaxed text-[#2D2D2D]/75">Metabolik dengeyi destekleyen beslenme yaklaşımlarına dair güncel verilerin kısa değerlendirmesi.</p>
          </article>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
