---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuHero from '../../components/site/SubmenuHero.astro';
import SubmenuLinkCard from '../../components/site/SubmenuLinkCard.astro';
import SubmenuSection from '../../components/site/SubmenuSection.astro';
import SubmenuSpotlightCard from '../../components/site/SubmenuSpotlightCard.astro';
import { submenuHeroByRoute } from '../../data/submenu-heroes';

const hero = submenuHeroByRoute['/bilimsel-pencere']!;
const imgEst = submenuHeroByRoute['/bilimsel-pencere/estrogen-biyolojisi-saglik']!;
const imgNad = submenuHeroByRoute['/bilimsel-pencere/nad-plus-hucresel-yaslanma']!;

const pillars = [
  {
    step: '01',
    title: 'Uzman Görüşleri',
    excerpt: 'Editoryal danışman hekimlerin perspektifleri.',
    href: '/bilimsel-pencere/uzman-gorusleri',
    image: hero,
  },
  {
    step: '02',
    title: 'Araştırma Özetleri',
    excerpt: 'Güncel bilimsel literatürün anlaşılır özetleri.',
    href: '/bilimsel-pencere/nad-plus-hucresel-yaslanma',
    image: imgNad,
  },
  {
    step: '03',
    title: 'Mitler vs. Gerçekler',
    excerpt: 'Yaygın sağlık inançlarının bilimsel değerlendirmesi.',
    href: '/bilimsel-pencere/estrogen-biyolojisi-saglik',
    image: imgEst,
  },
];
---

<SiteLayout
  title="Bilimsel Pencere - Estranova"
  description="Uzman görüşleri, güncel araştırma özetleri ve sağlık dünyasının yaygın mitlerinin bilimsel gerçeklerle karşılaştırılması."
>
  <SiteNavbar currentPath="/bilimsel-pencere" />

  <main id="main-content" class="text-[#2D2D2D]">
    <SubmenuHero
      eyebrow="Kategori"
      title="Bilimsel Pencere"
      lede="Uzman görüşleri, güncel araştırma özetleri ve mitlerin bilimle karşılaştırılması. Tıbbi veriyi erişilebilir bir dille sunarız."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />
    <SubmenuSection variant="cream" borderedTop={true}>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          pillars.map((p) => (
            <SubmenuLinkCard
              href={p.href}
              title={p.title}
              excerpt={p.excerpt}
              imageSrc={p.image.src}
              imageAlt={p.image.alt}
              step={p.step}
            />
          ))
        }
      </div>
    </SubmenuSection>

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">Güncel Bilim</p>
        <h2 class="mb-4 font-serif text-4xl leading-tight md:text-5xl">Son Araştırma Özetleri</h2>
        <p class="text-lg leading-relaxed text-[#2D2D2D]/75">
          Sağlık literatüründeki yeni yayınlardan örnek özetler.
        </p>
      </header>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <SubmenuSpotlightCard
          tag="Araştırma Özeti"
          title="Uyku Kalitesi ve Hormonal Denge"
          body="Son yayınlarda uyku düzeni ile hormon dalgalanmaları arasındaki ilişkinin nasıl ele alındığına dair kısa bir çerçeve."
          href="/zihin-denge/uyku-bozuklugu-menopoz"
        />
        <SubmenuSpotlightCard
          highlight={true}
          tag="Araştırma Özeti"
          title="Fiziksel Aktivite ve Ruh Hali"
          body="Düzenli hareketin duygusal denge üzerindeki etkisini inceleyen yeni çalışmaların anlaşılır özeti."
          href="/zihin-denge/stres-yonetimi-menopoz"
        />
        <SubmenuSpotlightCard
          tag="Araştırma Özeti"
          title="Beslenme Kalıpları ve Metabolik Sağlık"
          body="Metabolik dengeyi destekleyen beslenme yaklaşımlarına dair güncel verilerin kısa değerlendirmesi."
          href="/zamansiz-yasam/beslenme-yaslanma"
        />
      </div>
    </SubmenuSection>
  </main>

  <SiteFooter />
</SiteLayout>
