---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import ArticleTransparencyPanel from '../../components/article/ArticleTransparencyPanel.astro';
import SubmenuArticleBody from '../../components/site/SubmenuArticleBody.astro';
import ArticleProsePanel from '../../components/site/ArticleProsePanel.astro';
import { publishedArticles, type Article } from '../../data/articles';
import { getRelatedArticles } from '../../utils/relatedArticles';

interface Props {
  article: Article;
}

export function getStaticPaths() {
  return publishedArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props as Props;

const categoryLabelMap: Record<string, string> = {
  perimenopoz: 'Perimenopoz',
  menopoz: 'Menopoz',
  'kadin-sagligi': '40+ Sağlık',
  'kalp-sagligi': 'Kalp Sağlığı',
  bilgi: 'Bilgi',
};

const categoryLabel = categoryLabelMap[article.category] ?? article.category;
const formatDate = (value: string) =>
  new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(value));
const publishedDate = formatDate(article.date);
const reviewDateLabel = formatDate(article.reviewDate);
const lastModifiedLabel = formatDate(article.lastModified);
const siteUrl = (Astro.site ? Astro.site.toString() : 'https://estranova.com').replace(/\/$/, '');
const articleUrl = `${siteUrl}/article/${article.slug}`;
const articleListUrl = `${siteUrl}/article`;

const articleCitations = article.references.map((ref) => ({
  '@type': 'CreativeWork',
  headline: ref.title,
  author: ref.authors,
  isPartOf: ref.journal,
  datePublished: String(ref.year),
  url: ref.url,
  ...(ref.doi ? { identifier: `https://doi.org/${ref.doi}` } : {}),
}));

const medicalWebPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: article.title,
  description: article.excerpt,
  url: articleUrl,
  inLanguage: 'tr-TR',
  datePublished: article.date,
  dateModified: article.lastModified,
  reviewedBy: {
    '@type': 'Person',
    name: article.reviewer,
    jobTitle: article.medicalReviewerTitle,
  },
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.excerpt,
  datePublished: article.date,
  dateModified: article.lastModified,
  inLanguage: 'tr-TR',
  mainEntityOfPage: articleUrl,
  articleSection: categoryLabel,
  keywords: article.tags.join(', '),
  author: {
    '@type': 'Person',
    name: article.author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Estranova',
    url: siteUrl,
  },
  reviewedBy: {
    '@type': 'Person',
    name: article.reviewer,
    jobTitle: article.medicalReviewerTitle,
  },
  citation: articleCitations,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Anasayfa',
      item: siteUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Makaleler',
      item: articleListUrl,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: article.title,
      item: articleUrl,
    },
  ],
};

const relatedPool = publishedArticles.filter((item) => item.slug !== article.slug);
const relatedArticles = getRelatedArticles(article, relatedPool, { limit: 3 });
---

<SiteLayout
  title={`${article.title} - Estranova`}
  description={article.excerpt}
  canonical={articleUrl}
  ogType="article"
  jsonLd={[medicalWebPageSchema, articleSchema, breadcrumbSchema]}
>
  <SiteNavbar />

  <main id="main-content" class="pt-24">
    <SubmenuArticleBody>
        <a href="/library" class="inline-flex text-sm font-semibold text-primary border-b border-primary/30 pb-1 hover:border-primary mb-10">
          Kütüphaneye dön
        </a>

        <header class="mb-12">
          <div class="flex flex-wrap items-center gap-4 mb-6">
            <span class="px-3 py-1 rounded-full bg-primary/10 text-primary text-[11px] font-bold tracking-[0.22em] uppercase">
              {categoryLabel}
            </span>
            <time class="text-[11px] font-bold text-charcoal/40 uppercase tracking-[0.22em]">{publishedDate}</time>
            <span class="text-[11px] font-bold text-charcoal/40 uppercase tracking-[0.22em]">{article.readTime}</span>
          </div>

          <h1 class="text-4xl md:text-6xl font-serif leading-[1.08] text-charcoal mb-6">{article.title}</h1>

          <p class="text-lg md:text-xl text-charcoal/65 leading-relaxed max-w-3xl mb-8">{article.excerpt}</p>

          <ArticleTransparencyPanel
            variant="meta"
            author={article.author}
            reviewer={article.reviewer}
            reviewerTitle={article.medicalReviewerTitle}
            reviewDate={reviewDateLabel}
            lastModified={lastModifiedLabel}
          />
        </header>

        <div class="rounded-[36px] burgundy-gradient text-white p-10 md:p-12 mb-12">
          <p class="text-[11px] uppercase tracking-[0.22em] text-white/70 font-bold mb-4">Kısa Özet</p>
          <p class="text-xl md:text-2xl font-serif leading-relaxed">{article.excerpt}</p>
        </div>

        <ArticleProsePanel>
          <div set:html={article.content} />
        </ArticleProsePanel>

        <ArticleTransparencyPanel variant="disclaimer" disclaimerVersion={article.disclaimerVersion} />

        {relatedArticles.length > 0 && (
          <section class="mt-16 pt-10 border-t border-primary/10">
            <p class="text-secondary text-xs font-bold tracking-[0.24em] uppercase mb-4">İlgili Okumalar</p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
              {relatedArticles.map((item) => (
                <a href={`/article/${item.slug}`} class="rounded-2xl border border-primary/10 bg-white p-5 hover:border-primary/30 transition-colors">
                  <p class="text-[11px] uppercase tracking-[0.22em] text-charcoal/40 font-bold mb-2">{item.readTime}</p>
                  <p class="font-serif text-lg leading-tight text-charcoal">{item.title}</p>
                </a>
              ))}
            </div>
          </section>
        )}
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
