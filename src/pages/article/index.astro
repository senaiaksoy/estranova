---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import { articles } from '../../data/articles';

const sortedArticles = [...articles].sort((a, b) => (a.date < b.date ? 1 : -1));

const categoryLabelMap: Record<string, string> = {
  perimenopoz: 'Perimenopoz',
  menopoz: 'Menopoz',
  'kadin-sagligi': '40+ Saglik',
  'kalp-sagligi': 'Kalp Sagligi',
  bilgi: 'Bilgi',
};

const getCategoryLabel = (category: string) => categoryLabelMap[category] ?? category;
---

<SiteLayout
  title="Makaleler - Estranova"
  description="Estranova editoryal makale arsivi: perimenopoz, menopoz ve 40+ saglik yazilari."
>
  <SiteNavbar currentPath="/library" />

  <main id="main-content" class="pt-24">
    <section class="px-6 py-16 md:py-20">
      <div class="max-w-6xl mx-auto">
        <header class="max-w-3xl mb-14">
          <p class="text-secondary text-xs font-bold tracking-[0.28em] uppercase mb-4">Makale Arsivi</p>
          <h1 class="text-5xl md:text-7xl font-serif leading-[1.05] text-charcoal mb-6">Tum editoryal yazilar</h1>
          <p class="text-lg md:text-xl text-charcoal/65 leading-relaxed">
            Kanita dayali icerikleri kategori bazli takip edebilir, ilgili basliklara derinleserek ilerleyebilirsiniz.
          </p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {sortedArticles.map((article) => (
            <article class="rounded-[30px] border border-primary/10 bg-white p-7 editorial-shadow">
              <div class="flex items-center justify-between gap-4 mb-4">
                <p class="text-[11px] uppercase tracking-[0.24em] text-secondary font-bold">{getCategoryLabel(article.category)}</p>
                <p class="text-[11px] uppercase tracking-[0.24em] text-charcoal/40 font-bold">{article.readTime}</p>
              </div>

              <h2 class="text-2xl md:text-3xl font-serif mb-4 leading-tight">{article.title}</h2>
              <p class="text-charcoal/65 leading-relaxed mb-6">{article.excerpt}</p>

              <div class="flex items-center justify-between gap-4">
                <p class="text-[11px] uppercase tracking-[0.22em] text-charcoal/40 font-bold">{article.author}</p>
                <a href={`/article/${article.slug}`} class="inline-flex text-sm font-semibold text-primary border-b border-primary/30 pb-1 hover:border-primary">
                  Yaziyi inceleyin
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
