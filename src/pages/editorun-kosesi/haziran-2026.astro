---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuArticleBody from '../../components/site/SubmenuArticleBody.astro';
import ArticleProsePanel from '../../components/site/ArticleProsePanel.astro';
import ArticleSummary from '../../components/site/ArticleSummary.astro';
import ArticleAuthorBlock from '../../components/site/ArticleAuthorBlock.astro';
import ArticleDisclaimer from '../../components/site/ArticleDisclaimer.astro';
import RelatedReadings from '../../components/site/RelatedReadings.astro';
import { buildArticleSchemas } from '../../utils/article-schema';
import { resolveSiteUrl } from '../../utils/seo';
import { getIssueBySlug } from '../../data/issues';

const issue = getIssueBySlug('02-haziran-2026-guc-esigi');
const issuePath = `/sayi/${issue?.slug ?? '02-haziran-2026-guc-esigi'}/`;
const pathname = '/editorun-kosesi/haziran-2026/';

const articleTitle = 'Sıcacık Köşe — Haziran 2026: Güç Eşiği';
const articleDescription =
  "Eşik dergisinin Haziran 2026 sayısı: Güç Eşiği. Berna Aksoy'un kapı önü yazısı; bu ay kas, kemik, denge ve sürdürülebilir hareketi birlikte düşünüyoruz.";

const siteUrl = resolveSiteUrl(Astro.site);
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'berna-aksoy',
  articleType: 'experience-essay',
  publishedDate: '2026-06-01',
  modifiedDate: '2026-10-15',
  image: issue?.coverImage.src,
  pathname,
  articleSection: "Editörün Köşesi",
  sectionPath: '/sayi/',
  keywords: [
    'Eşik dergisi',
    'Estranova editör köşesi',
    'Sıcacık Köşe',
    'Berna Aksoy',
    'Haziran 2026 sayısı',
    'Güç Eşiği',
    '40 sonrası hareket',
    'menopozda güç',
  ],
  siteUrl,
});
---

<SiteLayout
  title={`${articleTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  image={issue?.coverImage.src}
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath={pathname} />

  <main id="main-content" class="pt-24 text-ink">
    <SubmenuArticleBody>
      <header
        class="relative mb-12 overflow-hidden rounded-[36px] border border-primary/12 bg-gradient-to-br from-cream-warm via-cream-soft to-white p-8 shadow-[0_24px_70px_rgba(79,23,28,0.08)] ring-1 ring-gold/20 md:p-12"
      >
        <div class="pointer-events-none absolute -right-20 top-0 h-64 w-64 rounded-full bg-gold/15 blur-3xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute bottom-6 right-8 hidden font-serif text-[7rem] lowercase leading-none text-primary/[0.04] md:block" aria-hidden="true">
          güç
        </div>
        <div class="relative max-w-4xl">
          <div class="mb-6 h-px w-24 bg-gold"></div>
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.32em] text-primary">
            Sıcacık Köşe · Haziran 2026
          </p>
          <h1 class="font-serif text-5xl leading-[0.95] tracking-[-0.05em] text-primary md:text-7xl">
            Güç Eşiği
          </h1>
          <p class="mt-6 max-w-2xl border-l border-gold/60 pl-6 font-serif text-xl italic leading-relaxed text-ink/72 md:text-2xl">
            Bu ay güce, gün içinde bedeninize ne kadar güvenebildiğiniz üzerinden bakıyoruz.
          </p>
        </div>
      </header>

      <ArticleAuthorBlock authorSlug="berna-aksoy"
        articleType="experience-essay" publishedDate="1 Haziran 2026" lastUpdated="15 Ekim 2026" readingMinutes={3} medicalReviewer="Yok" />

      <ArticleSummary title="Bu Sayıya Giriş">
        <p>
          <strong>Eşik · Sayı 02 — Güç Eşiği</strong>, 40 sonrasında kas, kemik, denge, enerji ve uykuyu
          birlikte ele alıyor. Altı yazar, hareketi gündelik hayatta nasıl sürdürebileceğimizden
          yorgunluk hakkında hangi soruları sorabileceğimize kadar farklı konulara bakıyor.
        </p>
      </ArticleSummary>

      <ArticleProsePanel mode="experience">
        <h2 id="neden-guc">Bu Ay Neden Güç?</h2>
        <p>
          Güç deyince aklınıza önce spor salonu gelebilir. Ben bu sayıda, merdiven çıkarken veya
          alışveriş çantasını taşırken ihtiyaç duyduğumuz güce de yer açmak istedim.
        </p>
        <p>
          Bir gün diziniz, başka bir gün omzunuz dikkatinizi çekebilir. Yorgunluğunuzu anlamaya çalışırken
          de nereden başlayacağınızı bilemeyebilirsiniz. Haziran dosyasını bu gündelik sorular etrafında kurduk.
        </p>
        <p>
          Hemen yoğun bir program kurmanız gerekmiyor. Bu sayının amacı, hareketle ilişkinizi
          düşünürken kas, kemik, denge ve dinlenme için ayrı ayrı sorular sorabilmek.
        </p>

        <h2 id="sayi-02">Sayı 02 — Güç Eşiği</h2>
        <p>
          Mayıs'ta gecelere bakmıştık; Haziran'da gündüz yaptığınız hareketlere geçiyoruz.
          Bu sayının altı yazısı, gücün hayatın farklı anlarında neye karşılık geldiğini ele alıyor.
        </p>
        <p>Dosyada kim hangi soruya bakıyor?</p>
        <ul>
          <li>
            <strong>Anıl Yalmaz</strong> 40 sonrasında harekete yeniden dönmeyi, bedeni zorlamadan
            nasıl kurabileceğinizi anlatıyor.
          </li>
          <li>
            <strong>Prof. Dr. Bülent Aksoy</strong> kemik sağlığı hakkında kırık oluşmadan önce
            sorulabilecek soruları ele alıyor.
          </li>
          <li>
            <strong>Fzt. Ersin Saraç</strong> dengeyi ayak, kalça ve gövdenin birlikte çalışması
            üzerinden açıklıyor.
          </li>
          <li>
            <strong>Dr. Metin Alış</strong> yorgunluğu kas, tiroid ve metabolizma yönünden inceliyor.
          </li>
          <li>
            <strong>Alara Baykent</strong> yaz başlarken hareketi günlük hayat içinde sürdürmeye odaklanıyor.
          </li>
          <li>
            <strong>Başak Pelister</strong> kendi menopoz deneyimini çanta, merdiven ve anne-kız
            sohbeti üzerinden anlatıyor.
          </li>
        </ul>

        <h2 id="bu-sayiya-nasil-baslanir">Merak Ettiğiniz Konudan Başlayın</h2>
        <p>
          Dosyayı baştan sona okumak zorunda değilsiniz. Harekete yeniden başlamak istiyorsanız Anıl'ın,
          yorgunluğunuzu anlamaya çalışıyorsanız Dr. Metin Alış'ın yazısını açabilirsiniz.
        </p>
        <p>
          Yazıların hepsi, bilimsel editör mektubuyla birlikte <a href={issuePath}>Eşik · Sayı 02 — Haziran 2026 · Güç Eşiği</a>
          sayfasında bir araya geliyor. Geceleri konuştuğumuz ilk sayının kapı yazısı da
          <a href="/editorun-kosesi/mayis-2026/">Mayıs 2026 Sıcacık Köşe</a>'de duruyor.
        </p>
        <p class="italic">
          Ben bu sayıyı günlük hayatta yaptığımız hareketleri düşünerek hazırladım. Sizin aklınıza
          ilk hangi an geldi: merdiven, çanta, yürüyüş?
        </p>
        <p>— Berna Aksoy, Site Editörü</p>
      </ArticleProsePanel>

      <RelatedReadings
        class="mt-14"
        paths={[
          issuePath,
          '/editorun-kosesi/mayis-2026/',
          '/zamansiz-yasam/40-sonrasi-harekete-yeniden-baslamak/',
          '/zamansiz-yasam/kemik-gucu-kirigi-beklemeden-sorulacak-sorular/',
        ]}
      />

      <ArticleDisclaimer>
        <p>
          Bu içerik genel bilgilendirme amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavinin
          yerini almaz. Dergi yazılarında geçen klinik konular için Eşik'in her sayısında yayımlanan
          editör mektubu ve ilgili yazıların altındaki Bilimsel Editör Notu yaklaşımı geçerlidir.
        </p>
      </ArticleDisclaimer>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
