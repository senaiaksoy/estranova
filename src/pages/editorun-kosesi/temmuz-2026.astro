---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuArticleBody from '../../components/site/SubmenuArticleBody.astro';
import ArticleProsePanel from '../../components/site/ArticleProsePanel.astro';
import ArticleSummary from '../../components/site/ArticleSummary.astro';
import ArticleAuthorBlock from '../../components/site/ArticleAuthorBlock.astro';
import ArticleDisclaimer from '../../components/site/ArticleDisclaimer.astro';
import RelatedReadings from '../../components/site/RelatedReadings.astro';
import { buildArticleSchemas } from '../../utils/article-schema';
import { resolveSiteUrl } from '../../utils/seo';
import { getIssueBySlug } from '../../data/issues';

const issue = getIssueBySlug('03-temmuz-2026-tarti-susunca');
const issuePath = `/sayi/${issue?.slug ?? '03-temmuz-2026-tarti-susunca'}/`;
const pathname = '/editorun-kosesi/temmuz-2026/';

const articleTitle = 'Sıcacık Köşe — Temmuz 2026: Tartı Susunca';
const articleDescription =
  "Eşik dergisinin Temmuz 2026 sayısı: Tartı Susunca. Berna Aksoy'un kapı önü yazısı; vücut kompozisyonu ve beden algısını diyet kültüründen uzak konuşuyoruz.";

const siteUrl = resolveSiteUrl(Astro.site);
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'berna-aksoy',
  articleType: 'experience-essay',
  publishedDate: '2026-07-16',
  modifiedDate: '2026-10-15',
  pathname,
  articleSection: "Editörün Köşesi",
  sectionPath: '/sayi/',
  keywords: [
    'Eşik dergisi',
    'Estranova editör köşesi',
    'Sıcacık Köşe',
    'Berna Aksoy',
    'Temmuz 2026 sayısı',
    'Tartı Susunca',
    'vücut kompozisyonu',
    'menopozda kilo',
    'beden algısı',
  ],
  siteUrl,
});
---

<SiteLayout
  title={`${articleTitle} - Estranova`}
  description={articleDescription}
  image="/images/library/editorial/temmuz-2026-sicacik-kose.webp"
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath={pathname} />

  <main id="main-content" class="pt-24 text-ink">
    <SubmenuArticleBody>
      <header
        class="relative mb-12 overflow-hidden rounded-[36px] border border-primary/12 bg-gradient-to-br from-cream-warm via-cream-soft to-white p-8 shadow-[0_24px_70px_rgba(79,23,28,0.08)] ring-1 ring-gold/20 md:p-12"
      >
        <div class="pointer-events-none absolute -right-20 top-0 h-64 w-64 rounded-full bg-gold/15 blur-3xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute bottom-6 right-8 hidden font-serif text-[7rem] lowercase leading-none text-primary/[0.04] md:block" aria-hidden="true">
          ölçü
        </div>
        <div class="relative max-w-4xl">
          <div class="mb-6 h-px w-24 bg-gold"></div>
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.32em] text-primary">
            Sıcacık Köşe · Temmuz 2026
          </p>
          <h1 class="font-serif text-5xl leading-[0.95] tracking-[-0.05em] text-primary md:text-7xl">
            Tartı Susunca
          </h1>
          <p class="mt-6 max-w-2xl border-l border-gold/60 pl-6 font-serif text-xl italic leading-relaxed text-ink/72 md:text-2xl">
            Kiloyu bu ay tartıdaki sayıyla sınırlamadan, kimseyi yargılamadan konuşuyoruz.
          </p>
        </div>
      </header>

      <ArticleAuthorBlock
        authorSlug="berna-aksoy"
        articleType="experience-essay"
        publishedDate="16 Temmuz 2026"
        lastUpdated="15 Ekim 2026"
        readingMinutes={3}
        medicalReviewer="Yok"
        imageSrc="/images/library/editorial/temmuz-2026-sicacik-kose-byline.webp"
        imageAlt="Yaz sabahı gardırop önünde keten bluz seçen kadın"
        imagePosition="center"
      />

      <ArticleSummary title="Bu Sayıya Giriş">
        <p>
          <strong>Eşik · Sayı 03 — Tartı Susunca</strong>, kilo ile beden algısına üç yazıyla bakıyor.
          Vücut kompozisyonu, yani bedenin kas ve yağ gibi bileşenlerinin dağılımı; menopozda kilo artışı,
          iştah ve metabolizma bu ayın konuları. Dosyayı, okura bir beden ölçüsü dayatmadan hazırladık.
        </p>
      </ArticleSummary>

      <ArticleProsePanel mode="experience">
        <h2 id="yanlis-soruyu-fark-etmek">Önce Yanlış Soruyu Fark Etmek</h2>
        <p>“Kaç kilo?” Kısa bir soru ama kilo hakkında konuşmaya buradan başlamak, başka sorulara pek yer bırakmayabiliyor.</p>
        <p>
          Haziran'da Güç Eşiği ile gündelik hareketlere bakmıştık. Temmuz'da tartıdaki sayıya
          verdiğimiz anlamı ve o sayının yanında gözden kaçan bilgileri, duyguları konuşuyoruz.
        </p>
        <p>
          Açık kollu bir bluz seçerken ya da tatil fotoğrafına bakarken bedeniniz hakkında
          daha çok düşünmeye başlayabilirsiniz. Kilo konuşmak o anlarda rahat bir sohbet olmayabilir.
          Tartıdaki sayı aynı kaldığında bile kendinizi farklı hissedebilirsiniz. O rahatsızlığı
          ve bu farkın uyandırdığı soruları dosyanın dışında bırakmadık.
        </p>
        <p>
          Burada kendinizi açıklamak zorunda değilsiniz. Benim editör olarak yapabileceğim,
          sağlıkla ilgili soruları ve beden algısına dair deneyimleri birbirine karıştırmadan
          yan yana sunmak. Her ikisi için de dosyada yer var.
        </p>

        <h2 id="sayi-03">Sayı 03 — Tartı Susunca</h2>
        <p>
          Bu sayıda size bir diyet programı sunmuyoruz. Kapak dosyasındaki üç yazı, kilo konusunun
          ayrı yönlerine bakıyor:
        </p>
        <ul>
          <li>
            <strong>Estranova Editörleri</strong> vücut kompozisyonunu, kas ve yağ dağılımı hakkında
            tartının söyleyebildiklerini ve söyleyemediklerini anlatıyor.
          </li>
          <li>
            <strong>Estranova Editörleri</strong> menopozda kilo artışını, günlük yaşam alışkanlıkları
            ile değişen beden arasındaki ilişki üzerinden ele alıyor.
          </li>
          <li>
            <strong>Başak Pelister</strong> beden ölçülerine dair kaygıyı ayna, kıyafet ve aile
            sohbetleri üzerinden kendi deneyimiyle anlatıyor.
          </li>
        </ul>

        <h2 id="bu-sayiya-nasil-baslanir">Bu Sayıya Nasıl Başlanır?</h2>
        <p>
          Önce neyi merak ettiğinize bakın. Kas ve yağ dağılımını anlamak istiyorsanız vücut
          kompozisyonu yazısıyla, kıyafet ve ayna karşısındaki hisler size daha tanıdık geliyorsa
          Başak'ın denemesiyle başlayabilirsiniz.
        </p>
        <p>
          Dördünü de bitirmeniz gerekmiyor. Bir yazıda durup sonra dönmek de bu sayıyı okumanın bir yolu.
        </p>
        <p>
          Bilimsel editör mektubunu ve üç yazıyı bir arada görmek isterseniz
          <a href={issuePath}>Eşik · Sayı 03 — Temmuz 2026 · Tartı Susunca</a> sayfasına geçebilirsiniz.
          Güç Eşiği'ni açan yazı ise <a href="/editorun-kosesi/haziran-2026/">Haziran 2026 Sıcacık Köşe</a>'de.
        </p>
        <p class="italic">
          Bu ay kilo hakkında konuşurken kendinize de söz hakkı tanımanızı dilerim.
        </p>
        <p>— Berna Aksoy, Site Editörü</p>
      </ArticleProsePanel>

      <RelatedReadings
        class="mt-14"
        paths={[
          issuePath,
          '/hormonal-gecis/menopoz/tarti-yatisinca-vucut-kompozisyonu/',
          '/zamansiz-yasam/kilo-artisi-menopoz/',
        ]}
      />

      <ArticleDisclaimer>
        <p>
          Bu içerik genel bilgilendirme amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavinin
          yerini almaz. Dergideki klinik konular için her sayıdaki bilimsel editör mektubuna ve ilgili yazıların
          sonundaki Bilimsel Editör Notu'na bakabilirsiniz.
        </p>
      </ArticleDisclaimer>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
