---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuArticleBody from '../../components/site/SubmenuArticleBody.astro';
import ArticleProsePanel from '../../components/site/ArticleProsePanel.astro';
import ArticleSummary from '../../components/site/ArticleSummary.astro';
import ArticleAuthorBlock from '../../components/site/ArticleAuthorBlock.astro';
import ArticleDisclaimer from '../../components/site/ArticleDisclaimer.astro';
import RelatedReadings from '../../components/site/RelatedReadings.astro';
import { buildArticleSchemas } from '../../utils/article-schema';
import { resolveSiteUrl } from '../../utils/seo';
import { getIssueBySlug } from '../../data/issues';

const issue = getIssueBySlug('01-mayis-2026-geceler');
const issuePath = `/sayi/${issue?.slug ?? '01-mayis-2026-geceler'}/`;
const pathname = '/editorun-kosesi/mayis-2026/';

const articleTitle = "Sıcacık Köşe — Mayıs 2026: Eşik'in İlk Sayısı";
const seoTitle = "Sıcacık Köşe: Eşik'in İlk Sayısı";
const articleDescription =
  "Eşik dergisinin ilk sayısı yayında: Sayı 01 — Geceler. Berna Aksoy'un kapı önü yazısı: dergi neden 'Eşik', bu ay neden uyku ve sayıya nasıl başlanır.";

const siteUrl = resolveSiteUrl(Astro.site);
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'berna-aksoy',
  articleType: 'experience-essay',
  publishedDate: '1 Mayıs 2026',
  modifiedDate: '2026-10-15',
  image: '/images/library/editorial/mayis-2026-sicacik-kose.webp',
  pathname,
  articleSection: 'Editörün Köşesi',
  sectionPath: '/sayi/',
  keywords: [
    'Eşik dergisi',
    'Estranova editör köşesi',
    'Sıcacık Köşe',
    'Berna Aksoy',
    'Mayıs 2026 sayısı',
    'Geceler dosyası',
    'perimenopoz uyku',
    'aylık dergi',
  ],
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  image="/images/library/editorial/mayis-2026-sicacik-kose.webp"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath={pathname} />

  <main id="main-content" class="pt-24 text-ink">
    <SubmenuArticleBody>
      <header
        class="relative mb-12 overflow-hidden rounded-[36px] border border-primary/12 bg-gradient-to-br from-cream-warm via-cream-soft to-white p-8 shadow-[0_24px_70px_rgba(79,23,28,0.08)] ring-1 ring-gold/20 md:p-12"
      >
        <div class="pointer-events-none absolute -right-20 top-0 h-64 w-64 rounded-full bg-gold/15 blur-3xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute bottom-6 right-8 hidden font-serif text-[7rem] lowercase leading-none text-primary/[0.04] md:block" aria-hidden="true">
          köşe
        </div>
        <div class="relative max-w-4xl">
          <div class="mb-6 h-px w-24 bg-gold"></div>
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.32em] text-primary">
            Sıcacık Köşe · Mayıs 2026
          </p>
          <h1 class="font-serif text-5xl leading-[0.95] tracking-[-0.05em] text-primary md:text-7xl">
            Eşik'in İlk Sayısı
          </h1>
          <p class="mt-6 max-w-2xl border-l border-gold/60 pl-6 font-serif text-xl italic leading-relaxed text-ink/72 md:text-2xl">
            Eşik'in ilk sayısı uykuyla açılıyor: geceleri değişen uyku, terleme ve akşam saatlerinde yapılan hareket.
          </p>
        </div>
      </header>

      <ArticleAuthorBlock
        authorSlug="berna-aksoy"
        articleType="experience-essay"
        publishedDate="1 Mayıs 2026"
        lastUpdated="15 Ekim 2026"
        readingMinutes={3}
        medicalReviewer="Yok"
        imageSrc="/images/library/editorial/mayis-2026-sicacik-kose-byline.webp"
        imageAlt="Pencere ışığında kıvrık keten yatak ve sakin bir yatak odası"
        imagePosition="center"
      />

      <ArticleSummary title="Bu Sayıya Giriş">
        <p>
          <strong>Eşik</strong>, Estranova'nın aylık dijital dergisi, Mayıs 2026'da ilk sayısıyla yayında.
          <strong>Sayı 01 — Geceler</strong>, perimenopozda uyku, gece terlemesi ve akşam hareketini
          üç yazarın bakışıyla ele alıyor. İlk köşede derginin adını ve sayıya nereden başlayabileceğinizi anlatıyorum.
        </p>
      </ArticleSummary>

      <ArticleProsePanel mode="experience">
        <h2 id="esik-neden">Bir Derginin Adı Neden "Eşik"?</h2>
        <p>
          Kapıdan çıkarken bir an durursunuz; henüz sokağa adım atmamışsınızdır, evden de ayrılmak üzeresinizdir.
          Derginin adı o kısa aradan geliyor.
        </p>
        <p>
          Perimenopozu, yani menopoza geçiş dönemini anlatırken de bu arada kalmışlık hissiyle karşılaşıyoruz.
          Alıştığınız düzen değişirken yeni duruma bir ad koymak her zaman kolay olmuyor. Eşik'i, bu ara
          dönemde akla gelen sorulara yer açan bir dergi olarak düşündüm.
        </p>
        <p>
          Her ay bir konu seçip farklı yazarların bakışlarını yan yana getiriyoruz. Siz de aynı konuyu
          hem gündelik hayatın içinden hem bilimsel açıklamasıyla okuyabiliyorsunuz.
        </p>

        <h2 id="sayi-01-geceler">Sayı 01 — Geceler</h2>
        <p>
          İlk sayının konusu uyku. Gece uyanmak, çarşaf değiştirmek, sabah dinlenememiş kalkmak gibi
          ayrı ayrı yaşanan anları aynı dosyada ele alıyoruz.
        </p>
        <p>
          Üç yazı aynı geceyi farklı yönlerden anlatıyor:
        </p>
        <ul>
          <li>
            <strong>Berna Aksoy</strong> — <em>Perimenopozda uykunun gerçekten değişen yanı.</em>
            Bu yazımda hormonal geçiş ile uyku arasındaki ilişkiyi ve geceleri anlamaya çalışırken
            sorulabilecek soruları ele alıyorum.
          </li>
          <li>
            <strong>Doç. Dr. Senai Aksoy</strong> — <em>Gece terlemesi ve uyku: utançsız bakış.</em>
            Gece terlemesinin pek konuşulmayan mahrem yanını, tıbbi açıklamasıyla birlikte ve
            utandırmadan anlatıyor.
          </li>
          <li>
            <strong>Alara Baykent</strong> — <em>Akşam hareketi uykuyu bozar mı, toparlar mı?</em>
            Akşam egzersizinin melatonin hormonu ve beden ısısı üzerinden uykuyla bağına sporcu
            deneyiminden bakıyor.
          </li>
        </ul>

        <h2 id="kose-niyeti">Bu Köşede Her Ay Sayıyı Tanıtacağım</h2>
        <p>
          Sıcacık Köşe'de her ay sayının nasıl bir araya geldiğini anlatacağım: hangi sorudan yola
          çıktık, yazılar birbirini nerede tamamlıyor.
        </p>
        <p>
          Bu köşede benim yerim editör masası. Yazılar kendi sözünü söylüyor; ben yalnızca kapıyı
          aralayıp içeride ne olduğunu gösteriyorum.
        </p>

        <h2 id="nasil-baslanir">Sizin Okuma Sıranız</h2>
        <p>
          Sayının tamamını okumanız gerekmez. Gece terlemesi aklınızı kurcalıyorsa o yazıyı açın; akşam
          yaptığınız hareketin uykuyla bağını merak ediyorsanız Alara'nın yazısına geçin. Birini okuyup
          diğerine geçmek, hâlâ açık kalan soruyu görmenizi de sağlayabilir.
        </p>
        <p>
          Baştan sona okumayı sevenler için üç yazı <a href={issuePath}>Eşik · Sayı 01 — Mayıs 2026 · Geceler</a>
          sayfasında sıralı duruyor. Bilimsel editör Doç. Dr. Senai Aksoy'un açılış mektubu da orada. Bir sonraki
          ayın kapı yazısı ise <a href="/editorun-kosesi/haziran-2026/">Haziran 2026 Sıcacık Köşe</a>.
        </p>
        <p class="italic">
          İlk sayıyı burada açıyorum. Sizin hangi yazıda daha uzun kalacağınızı merak ediyorum.
        </p>
        <p>— Berna Aksoy, Site Editörü</p>
      </ArticleProsePanel>

      <RelatedReadings
        class="mt-14"
        paths={[
          issuePath,
          '/editorun-kosesi/haziran-2026/',
          '/zihin-denge/uyku-dinlenme/perimenopoz-uyku-degisen-yan/',
          '/zihin-denge/uyku-dinlenme/gece-terlemesi-uyku-utancsiz/',
        ]}
      />

      <ArticleDisclaimer>
        <p>
          Bu içerik genel bilgilendirme amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavinin yerini almaz.
          Dergi yazılarında geçen klinik konular için Eşik'in her sayısında yayımlanan editör mektubu ve ilgili
          yazıların altındaki Bilimsel Editör Notu yaklaşımı geçerlidir.
        </p>
      </ArticleDisclaimer>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
