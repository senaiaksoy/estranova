---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

const symptoms = [
  {
    name: 'Sicak basmasi',
    category: 'Vazomotor',
    note: 'Gun icindeki ani isi artisi, terleme ve ardindan gelen usume hissi ile tarif edilir.',
  },
  {
    name: 'Beyin sisi',
    category: 'Bilissel',
    note: 'Konsantrasyon daginigi, kelime bulmakta zorlanma veya gecici unutkanlik hissi olarak anlatilir.',
  },
  {
    name: 'Uyku bolunmesi',
    category: 'Uyku',
    note: 'Gece boyunca sik uyanma, sabaha karsi uykuya dalamama veya erken uyanma biciminde gorulebilir.',
  },
  {
    name: 'Kaygi artisi',
    category: 'Duygudurum',
    note: 'Hormonal degisim, stres duzeyi ve uyku bozulmasi bir araya geldiginde belirginlesebilir.',
  },
  {
    name: 'Eklem ve kas hassasiyeti',
    category: 'Kas-iskelet',
    note: 'Sabah sertligi, hareket baslangicinda zorlanma veya gun sonuna dogru yorgunluk hissi ile fark edilebilir.',
  },
  {
    name: 'Cilt ve sac degisiklikleri',
    category: 'Dermatolojik',
    note: 'Kuruluk, hassasiyet veya sac tellerinde incelme gibi daha yavas ilerleyen degisimler seklinde gorulebilir.',
  },
] as const;

const howToUse = [
  'Semptomun ne zaman ortaya ciktigini ve ne kadar surdugunu not edin.',
  'Tek bir belirtiye degil, birlikte gorulen degisimlerin toplam etkisine bakin.',
  'Uyku, stres, hareket ve adet duzeni gibi basliklari ayni cercevede degerlendirin.',
];

const relatedReading = [
  'Perimenopozda hangi degisimler beklenebilir?',
  'Uyku bozulmasi ile gece terlemesi nasil ayri okunur?',
  'Belirti gunlugu tutarken hangi detaylar gereklidir?',
] as const;
---

<SiteLayout
  title="Semptom Rehberi - Estranova"
  description="Perimenopoz ve menopoz surecinde gorulebilen semptomlar icin editoryal rehber."
>
  <SiteNavbar currentPath="/symptoms" />

  <main id="main-content" class="pt-24">
    <section class="px-6 py-16 md:py-20">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-3xl mb-14" data-reveal="up">
          <p class="text-secondary text-xs font-bold tracking-[0.28em] uppercase mb-4">Semptom Rehberi</p>
          <h1 class="text-5xl md:text-7xl font-serif leading-[1.05] text-charcoal mb-6">Degisimleri adlandirmaya yardimci bir okuma alani</h1>
          <p class="text-lg md:text-xl text-charcoal/65 leading-relaxed">
            Bu sayfa tani koymak icin degil, sik gorulen degisimleri anlamlandirmak icin hazirlandi.
            Semptomlarin hangi baglamda ele alinabilecegini gosterir ve ilgili iceriklere gecis saglar.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-[1.65fr_0.95fr] gap-8 items-start">
          <div class="space-y-5" data-reveal-stagger>
            {symptoms.map((symptom, index) => (
              <article class="rounded-[32px] border border-primary/10 bg-card p-7 md:p-8 editorial-shadow card-hover" data-reveal="up">
                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-5">
                  <div class="max-w-2xl">
                    <div class="flex items-center gap-3 mb-3">
                      <span class:list={[
                        'w-3 h-3 rounded-full shrink-0',
                        index % 3 === 0 ? 'bg-primary' : index % 3 === 1 ? 'bg-secondary' : 'bg-charcoal/60',
                      ]}></span>
                      <p class="text-[11px] uppercase tracking-[0.24em] text-secondary font-bold">{symptom.category}</p>
                    </div>
                    <h2 class="text-2xl md:text-3xl font-serif mb-3 leading-tight">{symptom.name}</h2>
                    <p class="text-charcoal/65 leading-relaxed">{symptom.note}</p>
                  </div>

                  <div class="md:text-right md:min-w-[160px]">
                    <p class="text-[11px] uppercase tracking-[0.24em] text-charcoal/35 font-bold mb-2">Devam Okumasi</p>
                    <a href="/library" class="inline-flex text-sm font-semibold text-primary border-b border-primary/30 pb-1 hover:border-primary">
                      Ilgili icerikleri inceleyin
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <aside class="space-y-6 lg:sticky lg:top-28">
            <section class="rounded-[36px] burgundy-gradient text-white p-8 md:p-10">
              <p class="text-[11px] uppercase tracking-[0.24em] text-white/70 font-bold mb-4">Kullanim Notu</p>
              <h2 class="text-3xl font-serif leading-tight mb-6">Bu rehber nasil okunmali?</h2>
              <ul class="space-y-4">
                {howToUse.map((item) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-white/80">
                    <span class="mt-1 w-2 h-2 rounded-full bg-secondary shrink-0"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </section>

            <section class="rounded-[32px] border border-primary/10 bg-surface-container p-8">
              <p class="text-[11px] uppercase tracking-[0.24em] text-secondary font-bold mb-4">Ilgili Basliklar</p>
              <ul class="space-y-4 mb-8">
                {relatedReading.map((item) => (
                  <li class="text-sm leading-relaxed text-charcoal/70 border-b border-primary/10 pb-4 last:border-b-0 last:pb-0">{item}</li>
                ))}
              </ul>
              <a href="/library" class="inline-flex text-sm font-semibold text-primary border-b border-primary/30 pb-1 hover:border-primary">
                Kutuphane sayfasina gecin
              </a>
            </section>
          </aside>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
