---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

const symptoms = [
  {
    name: 'Sıcak basması',
    category: 'Vazomotor',
    note: 'Gün içindeki ani ısı artışı, terleme ve ardından gelen üşüme hissi ile tarif edilir.',
  },
  {
    name: 'Beyin sisi',
    category: 'Bilişsel',
    note: 'Konsantrasyon dağınıklığı, kelime bulmakta zorlanma veya geçici unutkanlık hissi olarak anlatılır.',
  },
  {
    name: 'Uyku bölünmesi',
    category: 'Uyku',
    note: 'Gece boyunca sık uyanma, sabaha karşı uykuya dalamama veya erken uyanma biçiminde görülebilir.',
  },
  {
    name: 'Kaygı artışı',
    category: 'Duygudurum',
    note: 'Hormonal değişim, stres düzeyi ve uyku bozulması bir araya geldiğinde belirginleşebilir.',
  },
  {
    name: 'Eklem ve kas hassasiyeti',
    category: 'Kas-iskelet',
    note: 'Sabah sertliği, hareket başlangıcında zorlanma veya gün sonuna doğru yorgunluk hissi ile fark edilebilir.',
  },
  {
    name: 'Cilt ve saç değişiklikleri',
    category: 'Dermatolojik',
    note: 'Kuruluk, hassasiyet veya saç tellerinde incelme gibi daha yavaş ilerleyen değişimler şeklinde görülebilir.',
  },
] as const;

const howToUse = [
  'Semptomun ne zaman ortaya çıktığını ve ne kadar sürdüğünü not edin.',
  'Tek bir belirtiye değil, birlikte görülen değişimlerin toplam etkisine bakın.',
  'Uyku, stres, hareket ve adet düzeni gibi başlıkları aynı çerçevede değerlendirin.',
];

const relatedReading = [
  'Perimenopozda hangi değişimler beklenebilir?',
  'Uyku bozulması ile gece terlemesi nasıl ayrı okunur?',
  'Belirti günlüğü tutarken hangi detaylar gereklidir?',
] as const;

const journalTemplate = [
  'Semptomun başlangıç saati ve yaklaşık süresi',
  'Eşlik eden durumlar (uyku, stres, yoğun iş günü, fiziksel aktivite)',
  'Günlük yaşam etkisi (iş, odaklanma, sosyal tempo)',
  'Bir önceki haftaya göre artış/azalış gözlemi',
] as const;

const reviewSignals = [
  'Beklenmedik şekilde sıklaşan veya günlük işlevi belirgin bozan belirtiler',
  'Uzun süren, tekrar eden ve kendi kendine gerilemeyen semptom örüntüsü',
  'Uyku, duygu durumu ve enerji alanlarını birlikte etkileyen dönemsel kötüleşme',
] as const;
---

<SiteLayout
  title="Semptom Rehberi - Estranova"
  description="Perimenopoz ve menopoz sürecinde görülebilen semptomlar için editoryal rehber."
>
  <SiteNavbar currentPath="/symptoms" />

  <main id="main-content" class="pt-24">
    <section class="px-6 py-16 md:py-20">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-3xl mb-14">
          <p class="text-secondary text-xs font-bold tracking-[0.28em] uppercase mb-4">Semptom Rehberi</p>
          <h1 class="text-5xl md:text-7xl font-serif leading-[1.05] text-charcoal mb-6">Değişimleri adlandırmaya yardımcı bir okuma alanı</h1>
          <p class="text-lg md:text-xl text-charcoal/65 leading-relaxed">
            Bu sayfa tanı koymak için değil, sık görülen değişimleri anlamlandırmak için hazırlandı.
            Semptomların hangi bağlamda ele alınabileceğini gösterir ve ilgili içeriklere geçiş sağlar.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-[1.65fr_0.95fr] gap-8 items-start">
          <div class="space-y-5">
            {symptoms.map((symptom, index) => (
              <article class="rounded-[32px] border border-primary/10 bg-white p-7 md:p-8 editorial-shadow">
                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-5">
                  <div class="max-w-2xl">
                    <div class="flex items-center gap-3 mb-3">
                      <span class:list={[
                        'w-3 h-3 rounded-full shrink-0',
                        index % 3 === 0 ? 'bg-primary' : index % 3 === 1 ? 'bg-secondary' : 'bg-charcoal/60',
                      ]}></span>
                      <p class="text-[11px] uppercase tracking-[0.24em] text-secondary font-bold">{symptom.category}</p>
                    </div>
                    <h2 class="text-2xl md:text-3xl font-serif mb-3 leading-tight">{symptom.name}</h2>
                    <p class="text-charcoal/65 leading-relaxed">{symptom.note}</p>
                  </div>

                  <div class="md:text-right md:min-w-[160px]">
                    <p class="text-[11px] uppercase tracking-[0.24em] text-charcoal/35 font-bold mb-2">Devam Okuması</p>
                    <a href="/library" class="inline-flex text-sm font-semibold text-primary border-b border-primary/30 pb-1 hover:border-primary">
                      İlgili içerikleri inceleyin
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <aside class="space-y-6 lg:sticky lg:top-28">
            <section class="rounded-[36px] burgundy-gradient text-white p-8 md:p-10">
              <p class="text-[11px] uppercase tracking-[0.24em] text-white/70 font-bold mb-4">Kullanım Notu</p>
              <h2 class="text-3xl font-serif leading-tight mb-6">Bu rehber nasıl okunmalı?</h2>
              <ul class="space-y-4">
                {howToUse.map((item) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-white/80">
                    <span class="mt-1 w-2 h-2 rounded-full bg-secondary shrink-0"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </section>

            <section class="rounded-[32px] border border-primary/10 bg-surface-container p-8">
              <p class="text-[11px] uppercase tracking-[0.24em] text-secondary font-bold mb-4">İlgili Başlıklar</p>
              <ul class="space-y-4 mb-8">
                {relatedReading.map((item) => (
                  <li class="text-sm leading-relaxed text-charcoal/70 border-b border-primary/10 pb-4 last:border-b-0 last:pb-0">{item}</li>
                ))}
              </ul>
              <a href="/library" class="inline-flex text-sm font-semibold text-primary border-b border-primary/30 pb-1 hover:border-primary">
                Kütüphane sayfasına geçin
              </a>
            </section>
          </aside>
        </div>

        <section class="mt-14 grid grid-cols-1 lg:grid-cols-2 gap-6">
          <article class="rounded-[32px] border border-primary/10 bg-white p-8 editorial-shadow">
            <p class="text-[11px] uppercase tracking-[0.24em] text-secondary font-bold mb-3">Semptom Günlüğü</p>
            <h2 class="text-3xl font-serif mb-5">Pratik izlem şablonu</h2>
            <p class="text-charcoal/65 leading-relaxed mb-6">
              Uzun ve ayrıntılı kayıt yerine kısa, düzenli ve karşılaştırılabilir notlar almak değerlendirme kalitesini artırır.
            </p>
            <ul class="space-y-3">
              {journalTemplate.map((item) => (
                <li class="flex gap-3 text-sm text-charcoal/70 leading-relaxed">
                  <span class="mt-1 w-2 h-2 rounded-full bg-primary shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>

          <article class="rounded-[32px] border border-primary/10 bg-surface-container p-8">
            <p class="text-[11px] uppercase tracking-[0.24em] text-secondary font-bold mb-3">Değerlendirme Eşiği</p>
            <h2 class="text-3xl font-serif mb-5">Klinik görüşmeyi ne zaman düşünmeli?</h2>
            <p class="text-charcoal/65 leading-relaxed mb-6">
              Bu başlıklar tanı koydurmaz; ancak semptom örüntüsünün profesyonel değerlendirme ile ele alınmasının yararlı olabileceğini gösterir.
            </p>
            <ul class="space-y-3 mb-8">
              {reviewSignals.map((item) => (
                <li class="flex gap-3 text-sm text-charcoal/70 leading-relaxed">
                  <span class="mt-1 w-2 h-2 rounded-full bg-secondary shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <p class="text-xs text-charcoal/55 leading-relaxed">
              Not: Bu rehber genel bilgilendirme amaçlıdır; kişisel tıbbi değerlendirme yerine geçmez.
            </p>
          </article>
        </section>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
