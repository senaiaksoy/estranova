---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { symptoms } from '../data/symptoms';

const howToUse = [
  'Semptomun ne zaman ortaya çıktığını ve ne kadar sürdüğünü not edin.',
  'Tek bir belirtiye değil, birlikte görülen değişimlerin toplam etkisine bakın.',
  'Uyku, stres, hareket ve adet düzeni gibi başlıkları birlikte değerlendirin.',
];

const relatedReading = [
  'Perimenopozda hangi değişimler beklenebilir?',
  'Uyku bozulması ile gece terlemesi nasıl ayrı okunur?',
  'Belirti günlüğü tutarken hangi detaylar gereklidir?',
] as const;

const journalTemplate = [
  'Semptomun başlangıç saati ve yaklaşık süresi',
  'Eşlik eden durumlar (uyku, stres, yoğun iş günü, fiziksel aktivite)',
  'Günlük yaşam etkisi (iş, odaklanma, sosyal tempo)',
  'Bir önceki haftaya göre artış/azalış gözlemi',
] as const;

const reviewSignals = [
  'Beklenmedik şekilde sıklaşan veya günlük işlevi belirgin bozan belirtiler',
  'Uzun süren, tekrar eden ve kendi kendine gerilemeyen semptom gidişatı',
  'Uyku, duygu durumu ve enerji alanlarını birlikte etkileyen dönemsel kötüleşme',
] as const;
---

<SiteLayout
  title="Semptom Rehberi - Estranova"
  description="Perimenopoz ve menopoz sürecinde görülebilen sekiz ana belirti için editoryal rehber: sıcak basması, uyku bozukluğu, ruh hali, hafıza, cilt, eklem, kilo ve libido."
>
  <SiteNavbar currentPath="/symptoms/" />

  <!--
    Duotone SVG filter — anasayfa SymptomNavigation ile aynı.
    Bordo (#D81B60) shadow → altın (#000000) highlight.
  -->
  <svg width="0" height="0" aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden;">
    <defs>
      <filter id="duotone-estranova" color-interpolation-filters="sRGB">
        <feColorMatrix
          type="matrix"
          values="0.299 0.587 0.114 0 0
                  0.299 0.587 0.114 0 0
                  0.299 0.587 0.114 0 0
                  0     0     0     1 0"
        ></feColorMatrix>
        <feComponentTransfer>
          <feFuncR type="table" tableValues="0.31 0.79"></feFuncR>
          <feFuncG type="table" tableValues="0.09 0.66"></feFuncG>
          <feFuncB type="table" tableValues="0.11 0.43"></feFuncB>
        </feComponentTransfer>
      </filter>
    </defs>
  </svg>

  <main id="main-content" class="bg-cream-soft pt-24 text-ink">
    <section class="relative overflow-hidden border-b border-primary/10 px-6 py-16 md:py-24">
      <div class="pointer-events-none absolute -left-24 top-16 h-72 w-72 rounded-full bg-primary/8 blur-3xl"></div>
      <div class="pointer-events-none absolute bottom-0 right-[5%] hidden font-serif text-[11rem] italic leading-none text-primary/[0.035] lg:block" aria-hidden="true">
        beden
      </div>
      <div class="relative mx-auto max-w-7xl">
        <div class="grid gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:items-end">
          <header>
            <p class="mb-5 flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.32em] text-primary">
              <span class="h-px w-10 bg-gold"></span>
              Semptom Rehberi
            </p>
            <h1 class="max-w-4xl font-serif text-6xl leading-[0.9] tracking-[-0.055em] text-primary md:text-8xl">
              Değişimleri adlandıran belirti atlası
            </h1>
          </header>
          <aside class="rounded-[34px] border border-primary/12 bg-white/75 p-7 shadow-[0_28px_90px_-62px_rgba(44,22,28,0.35)] ring-1 ring-white/80">
            <p class="mb-5 text-[11px] font-bold uppercase tracking-[0.24em] text-primary/75">Bu normal mi?</p>
            <p class="font-serif text-2xl italic leading-snug text-ink/78 md:text-3xl">
              Bu sayfa tanı koymak için değil; sık görülen değişimleri daha sakin, daha doğru kelimelerle okumak için hazırlandı.
            </p>
            <a
              href="/belirti-degerlendirme/"
              class="mt-6 inline-flex min-h-11 items-center justify-center rounded-xl bg-primary px-5 py-3 text-sm font-semibold text-white transition hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
            >
              Belirtileri değerlendirin
            </a>
            <div class="mt-6 grid grid-cols-3 gap-3 border-t border-gold/25 pt-5 text-center">
              <div>
                <p class="font-serif text-3xl text-primary">{symptoms.length}</p>
                <p class="mt-1 text-[10px] font-semibold uppercase tracking-[0.22em] text-ink/55">Belirti</p>
              </div>
              <div>
                <p class="font-serif text-3xl text-primary">3</p>
                <p class="mt-1 text-[10px] font-semibold uppercase tracking-[0.22em] text-ink/55">İzlem notu</p>
              </div>
              <div>
                <p class="font-serif text-3xl text-primary">0</p>
                <p class="mt-1 text-[10px] font-semibold uppercase tracking-[0.22em] text-ink/55">Panik dili</p>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="px-6 py-14 md:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="mb-10 max-w-3xl">
          <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.28em] text-primary/80">
            Belirti haritası
          </p>
          <h2 class="font-serif text-4xl leading-tight tracking-[-0.025em] text-ink md:text-5xl">
            Önce adını koy, sonra okuma rotasına geç
          </h2>
        </div>

        <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[1.65fr_0.95fr]">
          <div class="space-y-5">
            {symptoms.map((symptom, index) => (
              <a
                href={symptom.href}
                class="group block overflow-hidden rounded-[34px] border border-primary/12 bg-white shadow-[0_24px_82px_-62px_rgba(44,22,28,0.36)] ring-1 ring-white/80 transition hover:-translate-y-1 hover:border-gold/45 hover:shadow-[0_34px_98px_-60px_rgba(44,22,28,0.45)] focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/35 focus-visible:ring-offset-2"
                aria-label={`${symptom.title} okuma rotasını aç`}
              >
                <article class="flex flex-col md:flex-row gap-0 md:gap-6">
                  <div class="relative md:w-[220px] md:shrink-0 aspect-[3/2] md:aspect-auto md:self-stretch overflow-hidden">
                    <img
                      src={symptom.image}
                      alt={symptom.alt}
                      loading="lazy"
                      decoding="async"
                      class="symptom-photo h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]"
                    />
                    <span class="absolute right-3 top-3 inline-flex items-center gap-1.5 rounded-full border border-white/35 bg-white/10 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.16em] text-white backdrop-blur-sm">
                      <span class="inline-block h-1.5 w-1.5 rounded-full bg-white"></span>
                      {symptom.evidence}
                    </span>
                  </div>

                  <div class="flex flex-1 flex-col gap-5 p-7 md:flex-row md:items-start md:justify-between md:p-8 md:pl-0">
                    <div class="max-w-2xl">
                      <div class="mb-3 flex items-center gap-3">
                        <span class:list={[
                          'w-3 h-3 rounded-full shrink-0',
                          index % 3 === 0 ? 'bg-primary' : index % 3 === 1 ? 'bg-gold' : 'bg-ink/60',
                        ]}></span>
                        <p class="text-[11px] font-bold uppercase tracking-[0.24em] text-gold">{symptom.category}</p>
                      </div>
                      <h2 class="mb-3 font-serif text-3xl italic leading-tight tracking-[-0.02em] text-primary md:text-4xl">
                        {symptom.title}
                      </h2>
                      <p class="leading-relaxed text-ink/70">{symptom.longDesc}</p>
                    </div>

                    <div class="md:text-right md:min-w-[160px] md:pt-1">
                      <p class="mb-2 text-[11px] font-bold uppercase tracking-[0.24em] text-ink/35">Okuma Rotası</p>
                      <span class="inline-flex items-center gap-2 text-sm font-semibold text-primary underline decoration-primary/35 underline-offset-4 transition group-hover:decoration-primary">
                        <span>Rehberi oku</span>
                        <span aria-hidden="true" class="text-gold transition group-hover:translate-x-0.5">→</span>
                      </span>
                    </div>
                  </div>
                </article>
              </a>
            ))}
          </div>

          <aside class="space-y-6 lg:sticky lg:top-28">
            <section class="relative overflow-hidden rounded-[36px] bg-primary p-8 text-white shadow-[0_30px_96px_-64px_rgba(44,22,28,0.7)] md:p-10">
              <div class="pointer-events-none absolute -right-16 -top-16 h-52 w-52 rounded-full bg-gold/15 blur-3xl"></div>
              <p class="text-[11px] uppercase tracking-[0.24em] text-white/70 font-bold mb-4">Kullanım Notu</p>
              <h2 class="mb-6 font-serif text-3xl leading-tight md:text-4xl">Bu rehber nasıl okunmalı?</h2>
              <ul class="space-y-4">
                {howToUse.map((item) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-white/80">
                    <span class="mt-1 w-2 h-2 rounded-full bg-secondary shrink-0"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </section>

            <section class="rounded-[34px] border border-primary/12 bg-white/80 p-8 shadow-[0_24px_82px_-66px_rgba(44,22,28,0.32)] ring-1 ring-white/80">
              <p class="mb-4 text-[11px] font-bold uppercase tracking-[0.24em] text-primary/80">İlgili Başlıklar</p>
              <ul class="space-y-4 mb-8">
                {relatedReading.map((item) => (
                  <li class="border-b border-primary/10 pb-4 text-sm leading-relaxed text-ink/70 last:border-b-0 last:pb-0">{item}</li>
                ))}
              </ul>
              <a href="/library/" class="inline-flex text-sm font-semibold text-primary underline decoration-primary/35 underline-offset-4 hover:decoration-primary">
                Kütüphane sayfasını aç
              </a>
            </section>
          </aside>
        </div>

        <section class="mt-14 grid grid-cols-1 gap-6 lg:grid-cols-2">
          <article class="rounded-[34px] border border-primary/12 bg-white p-8 shadow-[0_24px_82px_-66px_rgba(44,22,28,0.32)] ring-1 ring-white/80">
            <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.24em] text-primary/80">Semptom Günlüğü</p>
            <h2 class="mb-5 font-serif text-3xl leading-tight tracking-[-0.02em] text-ink md:text-4xl">Pratik izlem şablonu</h2>
            <p class="mb-6 leading-relaxed text-ink/65">
              Uzun ve ayrıntılı kayıt yerine kısa, düzenli ve karşılaştırılabilir notlar almak değerlendirme kalitesini artırır.
            </p>
            <ul class="space-y-3">
              {journalTemplate.map((item) => (
                <li class="flex gap-3 text-sm leading-relaxed text-ink/70">
                  <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-primary"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>

          <article class="rounded-[34px] border border-primary/12 bg-white/70 p-8 shadow-[0_24px_82px_-66px_rgba(44,22,28,0.28)] ring-1 ring-white/80">
            <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.24em] text-primary/80">Değerlendirme Eşiği</p>
            <h2 class="mb-5 font-serif text-3xl leading-tight tracking-[-0.02em] text-ink md:text-4xl">Uzman değerlendirmesini ne zaman düşünmeli?</h2>
            <p class="mb-6 leading-relaxed text-ink/65">
              Bu başlıklar tanı koydurmaz; ancak semptom gidişatının profesyonel değerlendirme ile ele alınmasının yararlı olabileceğini gösterir.
            </p>
            <ul class="space-y-3 mb-8">
              {reviewSignals.map((item) => (
                <li class="flex gap-3 text-sm leading-relaxed text-ink/70">
                  <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-gold"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <p class="text-xs leading-relaxed text-ink/55">
              Not: Bu rehber genel bilgilendirme amaçlıdır; kişisel tıbbi değerlendirme yerine geçmez.
            </p>
          </article>
        </section>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>

<style>
  .symptom-photo {
    filter: url('#duotone-estranova');
    transition:
      filter 600ms ease,
      transform 700ms ease;
  }

  .group:hover .symptom-photo,
  .group:focus-visible .symptom-photo {
    filter: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .symptom-photo {
      transition: none;
    }
  }
</style>
