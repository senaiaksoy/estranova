---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuArticleBody from '../../components/site/SubmenuArticleBody.astro';
import ArticleProsePanel from '../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../components/site/ArticleSummary.astro';
import ArticleAuthorBlock from '../../components/site/ArticleAuthorBlock.astro';
import ArticleFAQ from '../../components/site/ArticleFAQ.astro';
import ArticleTOC from '../../components/site/ArticleTOC.astro';
import RelatedReadings from '../../components/site/RelatedReadings.astro';
import Evidence, { type EvidenceLevel } from '../../components/site/Evidence.astro';
import { buildArticleSchemas } from '../../utils/article-schema';
import type { Writer } from '../../data/writers';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props as Props;
const { Content, headings } = await render(post);
const faqItems = post.data.faqItems ?? [];
// Markdown markers keep evidence beside its claim while reusing the canonical component.
const evidenceMarker = /<span data-article-evidence="([1-5])"><\/span>/g;
const renderedHtml = post.rendered?.html;
const bodyParts: Array<{ html: string; level?: undefined } | { html?: undefined; level: EvidenceLevel }> = [];
if (renderedHtml?.includes('data-article-evidence')) {
  let start = 0;
  for (const match of renderedHtml.matchAll(evidenceMarker)) {
    bodyParts.push({ html: renderedHtml.slice(start, match.index) });
    bodyParts.push({ level: Number(match[1]) as EvidenceLevel });
    start = match.index! + match[0].length;
  }
  bodyParts.push({ html: renderedHtml.slice(start) });
}
const tocEntries = post.data.summary && post.data.articleType === 'clinical-guide'
  ? [
      ...headings.filter((heading) => heading.depth === 2).map((heading) => ({ id: heading.slug, label: heading.text })),
      ...(faqItems.length && post.data.faqId ? [{ id: post.data.faqId, label: post.data.faqTitle ?? 'Sorular' }] : []),
    ]
  : [];

const formatDate = (value: string) =>
  new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }).format(
    new Date(value),
  );
const publishedDate = formatDate(post.data.date);
const siteUrl = (Astro.site ? Astro.site.toString() : 'https://estranova.com').replace(/\/$/, '');
const pageUrl = `${siteUrl}/blog/${post.id}`;

const writerSlug = post.data.writerSlug as Writer['slug'] | undefined;

const jsonLd = writerSlug
  ? buildArticleSchemas({
      title: post.data.title,
      description: post.data.description,
      writerSlug,
      articleType: post.data.articleType,
      publishedDate: post.data.date,
      modifiedDate: post.data.modifiedDate,
      image: post.data.imageSrc,
      pathname: `/blog/${post.id}/`,
      faqItems,
      siteUrl,
    })
  : {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.date,
      inLanguage: 'tr-TR',
      url: pageUrl,
    };
---

<SiteLayout
  title={`${post.data.title} - Estranova`}
  description={post.data.description}
  canonical={pageUrl}
  ogType="article"
  image={post.data.imageSrc}
  jsonLd={jsonLd}
>
  <SiteNavbar currentPath="/blog/" />

  <main id="main-content" class="pt-24">
    <SubmenuArticleBody>
      {tocEntries.length > 0 && <ArticleTOC slot="toc" entries={tocEntries} />}
      <a
        href="/blog/"
        class="inline-flex text-sm font-semibold text-primary border-b border-primary/30 pb-1 hover:border-primary mb-10"
      >
        Yazılara dön
      </a>

      <header class="mb-12">
        <time class="text-[11px] font-bold text-charcoal/40 uppercase tracking-[0.22em] block mb-4">
          {publishedDate}
        </time>
        <h1 class="text-4xl md:text-5xl font-serif leading-[1.08] text-charcoal mb-6">{post.data.title}</h1>
        <p class="text-lg md:text-xl text-charcoal/65 leading-relaxed max-w-3xl">{post.data.description}</p>
        {post.data.tags && post.data.tags.length > 0 && (
          <ul class="flex flex-wrap gap-2 mt-6">
            {post.data.tags.map((tag) => (
              <li class="px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold">{tag}</li>
            ))}
          </ul>
        )}
      </header>

      {writerSlug && (
        <div class="mb-10">
          <ArticleAuthorBlock
            authorSlug={writerSlug}
            articleType={post.data.articleType}
            publishedDate={publishedDate}
            lastUpdated={post.data.modifiedDate ? formatDate(post.data.modifiedDate) : undefined}
            readingMinutes={5}
            imageSrc={post.data.imageSrc}
            imageAlt={post.data.imageAlt}
          />
        </div>
      )}

      {post.data.summary && (
        <ArticleSummary title={post.data.articleType === 'clinical-guide' ? 'Kısa Klinik Yanıt' : 'Kısa Özet'} class="mb-10">
          <p>{post.data.summary}</p>
        </ArticleSummary>
      )}

      <ArticleProsePanel>
        {bodyParts.length > 0
          ? bodyParts.map((part) => part.level !== undefined
            ? <Evidence level={part.level} />
            : <Fragment set:html={part.html} />)
          : <Content />}
      </ArticleProsePanel>

      {faqItems.length > 0 && (
        <ArticleFAQ
          items={faqItems}
          title={post.data.faqTitle}
          intro={post.data.faqIntro}
          id={post.data.faqId}
          class="mt-10"
        />
      )}
      {post.data.relatedPaths?.length && <RelatedReadings paths={post.data.relatedPaths} class="mt-10" />}
      {post.data.medicalEditorNote && (
        <ArticleEditorNote class="mt-10"><p>{post.data.medicalEditorNote}</p></ArticleEditorNote>
      )}
      {post.data.disclaimer && (
        <ArticleDisclaimer class="mt-10"><p>{post.data.disclaimer}</p></ArticleDisclaimer>
      )}
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
