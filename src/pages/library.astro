---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

const categories = [
  {
    eyebrow: 'Hormonal Geçiş',
    title: 'Perimenopoz',
    summary: 'Hormonal geçiş dönemindeki belirtiler, güncel yaklaşımlar ve günlük hayata uyarlanan bilgi notları.',
    href: '/hormonal-gecis/perimenopoz/',
  },
  {
    eyebrow: 'Hormonal Geçiş',
    title: 'Menopoz',
    summary: 'Menopoz sürecindeki değişiklikleri açıklayan, tıbbi dili sade tutan temel okuma rotası.',
    href: '/hormonal-gecis/menopoz/',
  },
  {
    eyebrow: 'Zihin & Denge',
    title: 'Uyku ve duygusal denge',
    summary: 'Gece uyanmaları, ruh hâli değişimleri ve zihinsel bulanıklık için sakin okuma başlıkları.',
    href: '/zihin-denge/',
  },
  {
    eyebrow: 'Beden & Yakınlık',
    title: 'Mahrem sağlık',
    summary: 'Cinsellik, pelvik taban, vajinal sağlık ve bedenle yeniden yakınlaşma üzerine yargısız içerikler.',
    href: '/beden-yakinlik/',
  },
  {
    eyebrow: 'Zamansız Yaşam',
    title: '40 sonrası koruyucu sağlık',
    summary: 'Kemik, kas, beslenme, D vitamini ve uzun vadeli sağlık okuryazarlığı için düzenli rehberler.',
    href: '/zamansiz-yasam/',
  },
  {
    eyebrow: 'Bilimsel Pencere',
    title: 'Kanıtı okuma masası',
    summary: 'Hormon biyolojisi, hücresel yaşlanma ve yeni araştırmaları abartısız bir dille izleyen yazılar.',
    href: '/bilimsel-pencere/',
  },
];

const readingPath = [
  'İlk olarak semptom ve dönem bilgisini okuyarak kişisel bağlamınızı netleştirin.',
  'Ardından seçili temel yazılarla ana kavramları tamamlayın ve not alın.',
  'Son adımda ilişkili başlıklara geçerek daha derin okuma planınızı oluşturun.',
];

const startGuides = [
  {
    title: 'Hormonal geçişe yeni misiniz?',
    description: 'Önce perimenopoz hub\'ında genel hattı okuyun, sonra menopoz alt-kategorisindeki rehberlere geçin.',
    href: '/hormonal-gecis/perimenopoz/',
    cta: 'Perimenopoz rehberini aç',
  },
  {
    title: 'Uyku, sıcak basması ve günlük enerji düşüşü',
    description: 'Menopozda uyku yönetimi içeriği ile başlayıp ilişkili başlıkları kademeli okuyun.',
    href: '/zihin-denge/uyku-dinlenme/uyku-bozuklugu-menopoz/',
    cta: 'Uyku içeriğine git',
  },
  {
    title: 'Uzun vadeli koruyucu sağlık planı',
    description: 'Kemik sağlığı başlığını okuyarak 40+ dönemi için temel bir yol kurun.',
    href: '/zamansiz-yasam/kemik-sagligi-40-sonrasi/',
    cta: 'Kemik sağlığı rehberini aç',
  },
] as const;
---

<SiteLayout
  title="Kütüphane - Estranova"
  description="Perimenopoz, menopoz ve 40+ sağlık konularında editoryal bilgi kütüphanesi."
>
  <SiteNavbar currentPath="/library/" />

  <main id="main-content" class="bg-cream-soft pt-24 text-ink">
    <section class="relative overflow-hidden border-b border-primary/10 px-6 py-16 md:py-24">
      <div class="pointer-events-none absolute -left-24 top-14 h-72 w-72 rounded-full bg-primary/8 blur-3xl"></div>
      <div class="pointer-events-none absolute bottom-0 right-[5%] hidden font-serif text-[11rem] italic leading-none text-primary/[0.035] lg:block" aria-hidden="true">
        arşiv
      </div>
      <div class="relative mx-auto max-w-7xl">
        <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
          <header>
            <p class="mb-5 flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.32em] text-primary">
              <span class="h-px w-10 bg-gold"></span>
              Editoryal Kütüphane
            </p>
            <h1 class="max-w-4xl font-serif text-6xl leading-[0.9] tracking-[-0.055em] text-primary md:text-8xl">
              Konulara göre düzenlenmiş okuma salonu
            </h1>
          </header>
          <aside class="rounded-[34px] border border-primary/12 bg-white/75 p-7 shadow-[0_28px_90px_-62px_rgba(44,22,28,0.35)] ring-1 ring-white/80">
            <p class="font-serif text-2xl italic leading-snug text-ink/78 md:text-3xl">
              Güncel ve temel içerikler burada hızlı tüketim için değil, bir konuyu sakin sakin kavramak için yan yana durur.
            </p>
            <div class="mt-6 grid grid-cols-3 gap-3 border-t border-gold/25 pt-5 text-center">
              <div>
                <p class="font-serif text-3xl text-primary">{categories.length}</p>
                <p class="mt-1 text-[10px] font-semibold uppercase tracking-[0.22em] text-ink/55">Ana rota</p>
              </div>
              <div>
                <p class="font-serif text-3xl text-primary">{startGuides.length}</p>
                <p class="mt-1 text-[10px] font-semibold uppercase tracking-[0.22em] text-ink/55">Başlangıç</p>
              </div>
              <div>
                <p class="font-serif text-3xl text-primary">40+</p>
                <p class="mt-1 text-[10px] font-semibold uppercase tracking-[0.22em] text-ink/55">Odak</p>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="px-6 py-14 md:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="mb-10 max-w-3xl">
          <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.28em] text-primary/80">Konu rafları</p>
          <h2 class="font-serif text-4xl leading-tight tracking-[-0.025em] text-ink md:text-5xl">
            Her raf bir okuma niyetiyle açılır
          </h2>
        </div>

        <div class="mb-20 grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
          {categories.map((category) => (
            <a
              href={category.href}
              class="group relative flex min-h-[17rem] flex-col overflow-hidden rounded-[34px] border border-primary/12 bg-white p-7 shadow-[0_24px_82px_-62px_rgba(44,22,28,0.36)] ring-1 ring-white/80 transition hover:-translate-y-1 hover:border-gold/45 hover:shadow-[0_34px_98px_-60px_rgba(44,22,28,0.45)] focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/35 focus-visible:ring-offset-2"
            >
              <span class="pointer-events-none absolute inset-x-7 top-0 h-px bg-gold/55"></span>
              <p class="mb-4 text-[10px] font-bold uppercase tracking-[0.26em] text-gold">
                {category.eyebrow}
              </p>
              <h2 class="mb-4 font-serif text-3xl leading-tight tracking-[-0.025em] text-primary md:text-4xl">
                {category.title}
              </h2>
              <p class="mb-7 flex-1 text-sm leading-relaxed text-ink/68">{category.summary}</p>
              <span class="text-sm font-semibold text-primary underline decoration-primary/35 underline-offset-4 transition group-hover:decoration-primary">
                Bölümü aç
              </span>
            </a>
          ))}
        </div>

        <section class="mb-20 rounded-[38px] border border-primary/12 bg-white p-8 shadow-[0_28px_90px_-66px_rgba(44,22,28,0.36)] ring-1 ring-white/80 md:p-10">
          <div class="max-w-3xl mb-8">
            <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.28em] text-primary/80">Nereden başlamalı?</p>
            <h2 class="mb-4 font-serif text-3xl leading-tight tracking-[-0.02em] text-ink md:text-5xl">
              İhtiyaca göre başlangıç rotası
            </h2>
            <p class="leading-relaxed text-ink/68">
              Tek bir makaleye odaklanmak yerine, önce temel soruyu netleştirip uygun içerik sırasıyla ilerlemek daha dengeli bir okuma deneyimi sunar.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            {startGuides.map((guide, index) => (
              <article class="rounded-[30px] border border-primary/10 bg-cream-soft/70 p-6">
                <p class="mb-3 font-serif text-4xl italic leading-none text-gold">
                  {String(index + 1).padStart(2, '0')}
                </p>
                <h3 class="mb-3 font-serif text-2xl leading-tight text-primary">{guide.title}</h3>
                <p class="mb-5 text-sm leading-relaxed text-ink/68">{guide.description}</p>
                <a href={guide.href} class="inline-flex text-sm font-semibold text-primary underline decoration-primary/35 underline-offset-4 hover:decoration-primary">
                  {guide.cta}
                </a>
              </article>
            ))}
          </div>
        </section>

        <aside class="relative overflow-hidden rounded-[38px] bg-primary p-8 text-white shadow-[0_30px_96px_-64px_rgba(44,22,28,0.7)] md:p-10">
          <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-gold/15 blur-3xl"></div>
          <p class="text-[11px] uppercase tracking-[0.24em] text-white/70 font-bold mb-4">Okuma Rotası</p>
          <h2 class="text-3xl md:text-5xl font-serif leading-tight mb-6">Bu kütüphane nasıl kullanılır?</h2>
          <ul class="space-y-4 mb-8 max-w-3xl">
            {readingPath.map((item) => (
              <li class="flex gap-3 text-base leading-relaxed text-white/85">
                <span class="mt-2 w-2 h-2 rounded-full bg-secondary shrink-0"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <div class="pt-6 border-t border-white/15">
            <a href="/symptoms/" class="inline-flex text-sm font-semibold text-white underline decoration-white/35 underline-offset-4 hover:decoration-white">
              Semptom rehberini aç
            </a>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
