---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { perimenopozArticles, menopozArticles, healthArticles } from '../data/articles';
import { featuredArticles } from '../data/articles';

const categories = [
  {
    title: 'Perimenopoz',
    count: `${perimenopozArticles.length} yazi`,
    summary: 'Hormonal gecis donemindeki belirtiler, guncel yaklasimlar ve gunluk hayata uyarlanan bilgi notlari.',
  },
  {
    title: 'Menopoz',
    count: `${menopozArticles.length} yazi`,
    summary: 'Menopoz surecindeki degisiklikleri aciklayan, tibbi dili sade tutan temel okuma rotasi.',
  },
  {
    title: '40+ Saglik',
    count: `${healthArticles.length} yazi`,
    summary: 'Kalp sagligi, metabolik denge ve koruyucu yasam aliskanliklari icin uzun vadeli yol haritasi.',
  },
];

const readingPath = [
  'Ilk olarak semptom ve donem bilgisini okuyarak kisisel baglaminizi netlestirin.',
  'Ardindan secili temel yazilarla ana kavramlari tamamlayin ve not alin.',
  'Son adimda iliskili basliklara gecerek daha derin okuma planinizi olusturun.',
];

const featuredAccents: Array<'primary' | 'secondary' | 'charcoal'> = ['primary', 'secondary', 'charcoal'];
---

<SiteLayout
  title="Kutuphane - Estranova"
  description="Perimenopoz, menopoz ve 40+ saglik konularinda editoryal bilgi kutuphanesi."
>
  <SiteNavbar currentPath="/library" />

  <main id="main-content" class="pt-24">
    <section class="px-6 py-16 md:py-20">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-3xl mb-14">
          <p class="text-secondary text-xs font-bold tracking-[0.28em] uppercase mb-4">Editoryal Kutuphane</p>
          <h1 class="text-5xl md:text-7xl font-serif leading-[1.05] text-charcoal mb-6">Konulara gore duzenlenmis bilgi arsivi</h1>
          <p class="text-lg md:text-xl text-charcoal/65 leading-relaxed">
            Estranova kutuphanesi, guncel ve temel icerikleri bir arada toplar. Hedef, okuru tek bir cevaba degil,
            konuyu daha iyi anlamaya goturen acik bir okuma duzenine ulasmak.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 mb-20">
          {categories.map((category, index) => (
            <article class="rounded-[32px] border border-primary/10 bg-white p-7 editorial-shadow">
              <div class:list={[
                'w-12 h-12 rounded-2xl mb-6',
                index % 3 === 0 ? 'bg-primary/10' : index % 3 === 1 ? 'bg-secondary/10' : 'bg-charcoal/5',
              ]}></div>
              <p class="text-[11px] uppercase tracking-[0.24em] text-secondary font-bold mb-3">{category.count}</p>
              <h2 class="text-3xl font-serif mb-4 leading-tight">{category.title}</h2>
              <p class="text-charcoal/65 leading-relaxed text-sm">{category.summary}</p>
            </article>
          ))}
        </div>

        <section class="grid grid-cols-1 lg:grid-cols-[1.6fr_0.9fr] gap-8 items-start">
          <div>
            <div class="flex items-end justify-between gap-6 mb-8">
              <div>
                <p class="text-secondary text-xs font-bold tracking-[0.24em] uppercase mb-3">Secili Okumalar</p>
                <h2 class="text-3xl md:text-4xl font-serif">Baslangic icin uc temel okuma</h2>
              </div>
              <a href="/methodology" class="hidden md:inline-flex text-sm font-semibold text-primary border-b border-primary/30 pb-1 hover:border-primary">
                Icerik metodolojisini inceleyin
              </a>
            </div>

            <div class="space-y-6">
              {featuredArticles.map((article, index) => (
                <ArticleCard
                  article={article}
                  href={`/article/${article.slug}`}
                  variant="featured"
                  accent={featuredAccents[index % featuredAccents.length]}
                />
              ))}
            </div>
          </div>

          <aside class="rounded-[36px] burgundy-gradient text-white p-8 md:p-10">
            <p class="text-[11px] uppercase tracking-[0.24em] text-white/70 font-bold mb-4">Okuma Rotasi</p>
            <h2 class="text-3xl font-serif leading-tight mb-6">Bu kutuphane nasil kullanilir?</h2>
            <ul class="space-y-4 mb-8">
              {readingPath.map((item) => (
                <li class="flex gap-3 text-sm leading-relaxed text-white/80">
                  <span class="mt-1 w-2 h-2 rounded-full bg-secondary shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <div class="pt-6 border-t border-white/10">
              <a href="/symptoms" class="inline-flex text-sm font-semibold text-white border-b border-white/30 pb-1 hover:border-white">
                Semptom rehberine gecin
              </a>
            </div>
          </aside>
        </section>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
