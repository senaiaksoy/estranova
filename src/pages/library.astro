---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

const categories = [
  {
    title: 'Perimenopoz',
    count: '12 baslik',
    summary: 'Dongu degisiklikleri, sicak basmasi, uyku ve duygudurum konularina giris metinleri.',
  },
  {
    title: 'Menopoza Hazirlik',
    count: '10 baslik',
    summary: 'Yas alma ile birlikte izlenebilecek testler, yasam aliskanliklari ve beklenen degisimler.',
  },
  {
    title: 'Menopoz',
    count: '14 baslik',
    summary: 'Belirti yorumu, gunluk yasam etkileri ve guncel klinik yaklasimlarin sade ozeti.',
  },
  {
    title: '40+ Saglik',
    count: '9 baslik',
    summary: 'Kemik, kalp-damar, metabolizma ve bilissel saglik gibi uzun donem basliklar.',
  },
  {
    title: 'Yasam Bicimi',
    count: '8 baslik',
    summary: 'Beslenme, hareket, uyku rutini ve gunluk isleyisi destekleyen rehberler.',
  },
  {
    title: 'Kaynak Okuma',
    count: '6 baslik',
    summary: 'Klinik calismalari ve rehberleri hasta gozuyle okumaya yardimci aciklamalar.',
  },
] as const;

const featuredArticles = [
  {
    category: 'Temel Rehber',
    title: 'Perimenopoz belirtileri ayni anda neden degismez?',
    description:
      'Belirtilerin ayni yogunlukta gitmemesi, hormonal dalgalanmanin herkeste farkli gorunmesinden kaynaklanir. Bu baslik, dalga dalga gelen semptom mantigini aciklar.',
  },
  {
    category: 'Guncel Baslik',
    title: 'Uyku bozuldugunda once hangi degiskenlere bakmak gerekir?',
    description:
      'Gece terlemesi, stres, kafein duzeni ve gun ici hareket miktari gibi temel etkenleri adim adim ayiran bir giris rehberi.',
  },
  {
    category: 'Uzun Donem Saglik',
    title: 'Kemik ve kas sagligi neden menopozdan once konusulmali?',
    description:
      'Menopoz sonrasini beklemeden hangi koruyucu basliklarin ele alinabilecegini anlatan yonlendirici bir okuma rotasi.',
  },
] as const;

const readingPath = [
  'Once ilgi duydugunuz donemi secin: perimenopoz, menopoz veya 40+ saglik.',
  'Sonra semptom ile genel bilgi arasindaki farki ayiran iceriklere bakin.',
  'Kavramlar karisiyorsa tibbi terimler yerine temel yorum metinlerinden ilerleyin.',
];
---

<SiteLayout
  title="Kutuphane - Estranova"
  description="Perimenopoz, menopoz ve 40+ saglik konularinda editoryal bilgi kutuphanesi."
>
  <SiteNavbar currentPath="/library" />

  <main id="main-content" class="pt-24">
    <section class="px-6 py-16 md:py-20">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-3xl mb-14" data-reveal="up">
          <p class="text-secondary text-xs font-bold tracking-[0.28em] uppercase mb-4">Editoryal Kutuphane</p>
          <h1 class="text-5xl md:text-7xl font-serif leading-[1.05] text-charcoal mb-6">Konulara gore duzenlenmis bilgi arsivi</h1>
          <p class="text-lg md:text-xl text-charcoal/65 leading-relaxed">
            Estranova kutuphanesi, guncel ve temel icerikleri bir arada toplar. Hedef, okuru tek bir cevaba degil,
            konuyu daha iyi anlamaya goturen acik bir okuma duzenine ulasmak.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 mb-20" data-reveal-stagger>
          {categories.map((category, index) => (
            <article class="rounded-[32px] border border-primary/10 bg-card p-7 editorial-shadow card-hover" data-reveal="scale-up">
              <div class:list={[
                'w-12 h-12 rounded-2xl mb-6',
                index % 3 === 0 ? 'bg-primary/10' : index % 3 === 1 ? 'bg-secondary/10' : 'bg-charcoal/5',
              ]}></div>
              <p class="text-[11px] uppercase tracking-[0.24em] text-secondary font-bold mb-3">{category.count}</p>
              <h2 class="text-3xl font-serif mb-4 leading-tight">{category.title}</h2>
              <p class="text-charcoal/65 leading-relaxed text-sm">{category.summary}</p>
            </article>
          ))}
        </div>

        <section class="grid grid-cols-1 lg:grid-cols-[1.6fr_0.9fr] gap-8 items-start" data-reveal="up">
          <div>
            <div class="flex items-end justify-between gap-6 mb-8">
              <div>
                <p class="text-secondary text-xs font-bold tracking-[0.24em] uppercase mb-3">Secili Okumalar</p>
                <h2 class="text-3xl md:text-4xl font-serif">Baslangic icin uc temel okuma</h2>
              </div>
              <a href="/methodology" class="hidden md:inline-flex text-sm font-semibold text-primary border-b border-primary/30 pb-1 hover:border-primary">
                Icerik metodolojisini inceleyin
              </a>
            </div>

            <div class="space-y-6">
              {featuredArticles.map((article, index) => (
                <article class="rounded-[34px] overflow-hidden border border-primary/10 bg-card">
                  <div class:list={[
                    'h-3',
                    index === 0 ? 'bg-primary' : index === 1 ? 'bg-secondary' : 'bg-charcoal',
                  ]}></div>
                  <div class="p-8 md:p-10">
                    <p class="text-[11px] uppercase tracking-[0.24em] text-secondary font-bold mb-4">{article.category}</p>
                    <h3 class="text-3xl font-serif leading-tight mb-4">{article.title}</h3>
                    <p class="text-charcoal/65 leading-relaxed mb-6">{article.description}</p>
                    <a href="/article" class="inline-flex text-sm font-semibold text-primary border-b border-primary/30 pb-1 hover:border-primary">
                      Yaziyi inceleyin
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </div>

          <aside class="rounded-[36px] burgundy-gradient text-white p-8 md:p-10">
            <p class="text-[11px] uppercase tracking-[0.24em] text-white/70 font-bold mb-4">Okuma Rotasi</p>
            <h2 class="text-3xl font-serif leading-tight mb-6">Bu kutuphane nasil kullanilir?</h2>
            <ul class="space-y-4 mb-8">
              {readingPath.map((item) => (
                <li class="flex gap-3 text-sm leading-relaxed text-white/80">
                  <span class="mt-1 w-2 h-2 rounded-full bg-secondary shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <div class="pt-6 border-t border-white/10">
              <a href="/symptoms" class="inline-flex text-sm font-semibold text-white border-b border-white/30 pb-1 hover:border-white">
                Semptom rehberine gecin
              </a>
            </div>
          </aside>
        </section>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
