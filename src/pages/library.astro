---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { Info, Search, CheckCircle2, AlertCircle, Play, User } from 'lucide-react';

const categories = [
  { title: "Hormon Sağlığı", count: 24, icon: Info },
  { title: "Bilişsel Fonksiyonlar", count: 18, icon: Search },
  { title: "Beslenme & Metabolizma", count: 32, icon: CheckCircle2 },
  { title: "Kemik & Eklem Sağlığı", count: 15, icon: AlertCircle },
  { title: "Uyku Hijyeni", count: 12, icon: Play },
  { title: "Duygusal Esneklik", count: 20, icon: User },
];
---

<Layout title="Klinik Kütüphane - Estranova">
	<Navbar client:load currentPage="/library" />
	<div class="pt-32 pb-24 px-6">
		<div class="max-w-7xl mx-auto">
			<header class="mb-16">
				<h1 class="text-5xl font-serif mb-6">Klinik Kütüphane</h1>
				<p class="text-charcoal/60 max-w-2xl text-lg">
					Kadın sağlığı üzerine en güncel klinik araştırmalar, uzman makaleleri ve bilimsel rehberler.
				</p>
			</header>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
				{categories.map((cat) => (
					<div class="p-8 rounded-[32px] bg-surface-container hover:bg-primary/5 transition-all cursor-pointer group">
						<div class="w-12 h-12 rounded-2xl bg-white flex items-center justify-center text-primary mb-6 shadow-sm group-hover:bg-primary group-hover:text-white transition-all">
							<cat.icon size={24} />
						</div>
						<h3 class="text-2xl font-serif mb-2">{cat.title}</h3>
						<p class="text-sm text-charcoal/40 font-bold uppercase tracking-widest">{cat.count} Makale</p>
					</div>
				))}
			</div>

			<section>
				<h2 class="text-3xl font-serif mb-10">Son Eklenenler</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-12">
					<ArticleCard 
						title="Mikrobiyota ve Hormonal Denge Arasındaki İlişki"
						description="Bağırsak sağlığının östrojen metabolizması üzerindeki etkileri son on yılda yapılan çalışmalarla daha net anlaşılmaya başlandı..."
						image="https://picsum.photos/seed/medical0/1200/800"
						category="ARAŞTIRMA"
						readTime="8 DAKİKA"
						href="/article"
					/>
					<ArticleCard 
						title="Kortizol Yönetimi: Stres ve Perimenopoz"
						description="Stres hormonlarının perimenopoz semptomlarını nasıl tetiklediğini ve yönetme stratejilerini keşfedin."
						image="https://picsum.photos/seed/medical1/1200/800"
						category="ARAŞTIRMA"
						readTime="10 DAKİKA"
						href="/article"
					/>
				</div>
			</section>
		</div>
	</div>
	<Footer />
</Layout>
