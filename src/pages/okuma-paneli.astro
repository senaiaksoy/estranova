---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

const pageTitle = 'Okuma Paneliniz — Estranova';
const pageDescription =
  'Sonra Oku listenize, Estranova Mektubu kaydınıza ve okuma tercihlerinize buradan erişebilirsiniz. Hiçbir bilgi sunucuda saklanmaz; tüm veri tarayıcınızda durur.';
---

<SiteLayout title={pageTitle} description={pageDescription} allowIndexing={false}>
  <SiteNavbar currentPath="/okuma-paneli" />

  <main id="main-content" class="text-ink">
    <section class="relative overflow-hidden border-t border-burgundy/10 bg-gradient-to-b from-cream-warm via-cream-soft to-white px-6 py-16 md:py-24">
      <div class="absolute left-[-4rem] top-10 hidden h-64 w-64 rounded-full bg-gold/10 blur-3xl lg:block"></div>
      <div class="absolute right-[-7vw] top-16 hidden font-serif text-[11rem] leading-none text-burgundy/[0.045] lg:block">
        oku
      </div>

      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1.05fr_0.72fr] lg:items-end">
        <div>
          <nav aria-label="Sayfa konumu" class="mb-8 text-xs uppercase tracking-[0.22em] text-ink/55">
            <a href="/" class="text-ink/65 hover:text-burgundy">Anasayfa</a>
            <span class="mx-2 text-gold">·</span>
            <span class="text-burgundy">Okuma Paneliniz</span>
          </nav>

          <p class="mb-4 text-xs font-bold uppercase tracking-[0.3em] text-burgundy">
            Sizin Köşeniz
          </p>
          <h1 class="mb-6 max-w-4xl font-serif text-5xl leading-[0.98] text-burgundy md:text-7xl">
            Sessiz bir okuma çekmecesi
          </h1>
          <p class="max-w-3xl text-lg leading-relaxed text-ink/76 md:text-xl">
            Sonra okumak için kaydettikleriniz, Estranova Mektubu kaydınız ve yazı boyutu tercihiniz tek bir yerde durur. Bu alan bir profil panosu değil; tarayıcınızda saklanan küçük, kişisel bir okuma not defteridir.
          </p>
        </div>

        <aside class="rounded-[36px] border border-burgundy/10 bg-white/85 p-8 shadow-[0_24px_70px_rgba(74,47,39,0.10)] backdrop-blur">
          <p class="mb-3 font-serif text-3xl text-burgundy">Yerel ve hafif</p>
          <p class="text-sm leading-relaxed text-ink/68">
            Hiçbir bilgi sunucuda saklanmaz. Tarayıcı verisini temizlediğinizde liste de temizlenir; bu yüzden burası bir hesap kasası değil, günlük okuma düzeni için sade bir hatırlatıcıdır.
          </p>
          <div class="mt-6 grid grid-cols-2 gap-3 border-t border-burgundy/10 pt-5">
            <div>
              <p class="font-serif text-3xl text-gold">3</p>
              <p class="text-xs uppercase tracking-[0.2em] text-ink/50">panel</p>
            </div>
            <div>
              <p class="font-serif text-3xl text-gold">0</p>
              <p class="text-xs uppercase tracking-[0.2em] text-ink/50">sunucu kaydı</p>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section class="bg-white px-6 py-12 md:py-18">
      <div class="mx-auto max-w-6xl">
        <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
          <div>
            <p class="mb-3 text-xs font-bold uppercase tracking-[0.28em] text-gold">Okuma Masası</p>
            <h2 class="font-serif text-4xl leading-tight text-ink md:text-5xl">Bugün bıraktığınız izler</h2>
          </div>
          <p class="max-w-md text-sm leading-relaxed text-ink/62">
            Bu üç kart, okuma alışkanlığınızı ölçmekten çok sizi yarım kalan içeriklere nazikçe geri çağırmak için var.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {/* Sonra Oku panel */}
          <article
            data-panel="sonra-oku"
            class="group relative flex min-h-[21rem] flex-col overflow-hidden rounded-[34px] border border-burgundy/12 bg-cream-soft p-7 shadow-[0_18px_55px_rgba(74,47,39,0.08)] transition duration-300 hover:-translate-y-1 md:p-8"
          >
            <span class="absolute right-6 top-6 font-serif text-6xl text-burgundy/[0.06]">01</span>
            <div class="mb-6 flex h-16 w-16 items-center justify-center rounded-[24px] border border-gold/35 bg-white/72 shadow-inner">
              <span data-panel-count="sonra-oku" class="font-serif text-4xl leading-none text-burgundy">0</span>
            </div>
            <p class="mb-3 text-[10px] font-semibold uppercase tracking-[0.24em] text-burgundy/75">
              Sonra Oku
            </p>
            <h3 class="mb-4 font-serif text-3xl leading-snug text-ink">
              Listenizdeki yazılar
            </h3>
            <p
              data-panel-summary="sonra-oku"
              class="mb-7 flex-1 text-base leading-relaxed text-ink/72"
            >
              Henüz kaydedilmiş yazı yok. Bir yazıyı okurken sağ üstteki Sonra Oku düğmesine basarak
              listeye ekleyebilirsiniz.
            </p>
            <p
              data-panel-latest="sonra-oku"
              hidden
              class="mb-5 border-t border-burgundy/10 pt-4 text-xs font-semibold uppercase tracking-[0.18em] text-burgundy/65"
            >
            </p>
            <a
              href="/sonra-oku"
              class="inline-flex w-fit items-center gap-2 rounded-full border border-burgundy/20 bg-white px-4 py-2 text-xs font-bold uppercase tracking-[0.18em] text-burgundy transition hover:border-burgundy/45 hover:bg-white/80 focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35"
            >
              <span>Listeyi aç</span>
              <span aria-hidden="true">→</span>
            </a>
          </article>

          {/* Estranova Mektubu panel */}
          <article
            data-panel="mektup"
            class="group relative flex min-h-[21rem] flex-col overflow-hidden rounded-[34px] border border-burgundy/12 bg-burgundy p-7 text-white shadow-[0_22px_65px_rgba(107,45,62,0.18)] transition duration-300 hover:-translate-y-1 md:p-8"
          >
            <span class="absolute right-6 top-6 font-serif text-6xl text-white/[0.08]">02</span>
            <p class="mb-3 text-[10px] font-semibold uppercase tracking-[0.24em] text-cream-warm">
              Estranova Mektubu
            </p>
            <h3 class="mb-4 font-serif text-3xl leading-snug text-white">
              Mektup kaydınız
            </h3>
            <p
              data-panel-summary="mektup"
              class="mb-7 flex-1 text-base leading-relaxed text-white/76"
            >
              Mektup kaydınız henüz başlamadı. İlk sayı yayına girdiğinde mektup yola çıkar; isterseniz
              hemen kaydolabilirsiniz.
            </p>
            <a
              href="/mektup"
              class="inline-flex w-fit items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.18em] text-white transition hover:border-white/45 hover:bg-white/15 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/45"
            >
              <span>Mektup hakkında</span>
              <span aria-hidden="true">→</span>
            </a>
          </article>

          {/* Okuma tercihi panel */}
          <article
            data-panel="okuma-tercihi"
            class="group relative flex min-h-[21rem] flex-col overflow-hidden rounded-[34px] border border-gold/25 bg-gold/10 p-7 shadow-[0_18px_55px_rgba(74,47,39,0.08)] transition duration-300 hover:-translate-y-1 md:p-8"
          >
            <span class="absolute right-6 top-6 font-serif text-6xl text-burgundy/[0.06]">03</span>
            <p class="mb-3 text-[10px] font-semibold uppercase tracking-[0.24em] text-burgundy/75">
              Okuma Tercihi
            </p>
            <h3 class="mb-4 font-serif text-3xl leading-snug text-ink">
              Yazı boyutu
            </h3>
            <p
              data-panel-summary="okuma-tercihi"
              class="mb-7 flex-1 text-base leading-relaxed text-ink/72"
            >
              Şu anki tercihiniz: <span data-reader-scale-label class="font-semibold text-burgundy">varsayılan</span>.
              Bir makaleye girdiğinizde sağ üstteki <span class="font-semibold">A− / A / A+</span> butonlarıyla
              değiştirebilirsiniz; tercih bu tarayıcıda saklanır.
            </p>
            <button
              type="button"
              data-reader-reset
              class="inline-flex w-fit items-center gap-1.5 rounded-full border border-burgundy/25 bg-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-burgundy transition hover:border-burgundy/45 hover:bg-cream-warm focus:outline-none focus-visible:ring-2 focus-visible:ring-burgundy/35"
            >
              Varsayılana dön
            </button>
          </article>
        </div>
      </div>
    </section>

    <section class="border-t border-burgundy/10 bg-cream-soft px-6 py-12 md:py-16">
      <div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-[0.8fr_1.2fr]">
        <div class="rounded-[34px] bg-white p-8 shadow-[0_16px_45px_rgba(74,47,39,0.06)]">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.26em] text-gold">Gizlilik</p>
          <h2 class="font-serif text-4xl leading-tight text-ink">
            Verileriniz nerede duruyor?
          </h2>
        </div>
        <div class="rounded-[34px] border border-burgundy/10 bg-white/70 p-8">
          <p class="mb-4 text-base leading-relaxed text-ink/75">
            Bu paneldeki tüm bilgiler — kayıtlı yazılar, mektup kaydınız, okuma boyutunuz — yalnızca sizin
            tarayıcının yerel deposunda durur. Estranova sunucularında bu bilgilerin hiçbir kopyası yok.
          </p>
          <p class="text-base leading-relaxed text-ink/75">
            Tarayıcı verisini sildiğinizde bu liste de kaybolur. Yeni bir cihazda devam etmek için
            tekrar Sonra Oku ya da Mektup kaydını başlatabilirsiniz.
          </p>
        </div>
      </div>
    </section>

    <section class="border-t border-burgundy/10 bg-white px-6 py-10">
      <div class="mx-auto max-w-4xl rounded-full border border-burgundy/10 bg-cream-soft px-6 py-5 text-center">
        <p class="text-sm leading-relaxed text-ink/65">
          KVKK ve veri politikamız için <a href="/kvkk" class="font-semibold text-burgundy underline decoration-burgundy/40 underline-offset-4 hover:decoration-burgundy">KVKK Aydınlatma Metni</a>'ne göz atabilirsiniz.
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>

<script>
  /**
   * /okuma-paneli doldurucu — localStorage'tan veri okuyup özetler.
   * Hiçbir veri sunucuya gönderilmez; sayfa tamamen client-side.
   */
  (() => {
    const SAVED_KEY = 'estranova:save-for-later';
    const NEWSLETTER_KEY = 'estranova:mektup-bekleyenler';
    const READER_KEY = 'estranova:reader-scale';

    const SCALE_LABELS: Record<string, string> = {
      '0.9': 'küçük',
      '1': 'varsayılan',
      '1.15': 'büyük',
      '1.3': 'en büyük',
    };

    function safeRead<T>(key: string, fallback: T): T {
      try {
        const raw = localStorage.getItem(key);
        if (!raw) return fallback;
        return JSON.parse(raw) as T;
      } catch {
        return fallback;
      }
    }

    function readScale(): string {
      try {
        return localStorage.getItem(READER_KEY) ?? '1';
      } catch {
        return '1';
      }
    }

    function escapeHtml(value: string): string {
      return value
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // Sonra Oku özet
    const savedItems = safeRead<Array<{ slug: string; title: string }>>(SAVED_KEY, []);
    const sonraOkuSummary = document.querySelector<HTMLElement>(
      '[data-panel-summary="sonra-oku"]',
    );
    const sonraOkuCount = document.querySelector<HTMLElement>('[data-panel-count="sonra-oku"]');
    const sonraOkuLatest = document.querySelector<HTMLElement>('[data-panel-latest="sonra-oku"]');
    if (sonraOkuCount) {
      sonraOkuCount.textContent = String(savedItems.length);
    }
    if (sonraOkuSummary && savedItems.length > 0) {
      const count = savedItems.length;
      const latestTitle = savedItems[0]?.title ?? '';
      const latestEscaped = escapeHtml(latestTitle);
      sonraOkuSummary.innerHTML =
        `Listenizde ${count} ${count === 1 ? 'yazı' : 'yazı'} var. ` +
        (latestEscaped ? `Son eklenen: <em class="font-serif italic text-ink/85">"${latestEscaped}"</em>.` : '');
      if (sonraOkuLatest && latestEscaped) {
        sonraOkuLatest.hidden = false;
        sonraOkuLatest.textContent = 'Son eklenen yazı listenizin en üstünde duruyor.';
      }
    }

    // Mektup özet
    const pendingList = safeRead<Array<{ email: string; formType: string }>>(NEWSLETTER_KEY, []);
    const mektupSummary = document.querySelector<HTMLElement>(
      '[data-panel-summary="mektup"]',
    );
    if (mektupSummary && pendingList.length > 0) {
      const latest = pendingList[0];
      const emailEscaped = escapeHtml(latest.email);
      mektupSummary.innerHTML =
        `Mektup için <strong class="font-semibold text-burgundy">${emailEscaped}</strong> adresini kaydettik. ` +
        'Estranova Mektubu yayına girdiğinde gelen kutunuza düşecek; istediğiniz an ayrılabilirsiniz.';
    }

    // Okuma tercihi etiketi
    const scale = readScale();
    const scaleLabel = SCALE_LABELS[scale] ?? 'varsayılan';
    document.querySelectorAll<HTMLElement>('[data-reader-scale-label]').forEach((el) => {
      el.textContent = scaleLabel;
    });

    // "Varsayılana dön" butonu
    const resetButton = document.querySelector<HTMLButtonElement>('[data-reader-reset]');
    if (resetButton) {
      resetButton.addEventListener('click', () => {
        try {
          localStorage.setItem(READER_KEY, '1');
        } catch {
          /* empty */
        }
        document.documentElement.style.setProperty('--reader-scale', '1');
        document.querySelectorAll<HTMLElement>('[data-reader-scale-label]').forEach((el) => {
          el.textContent = SCALE_LABELS['1'];
        });
        // Eğer bir makaledeyse ReadingControls butonlarını da güncelle
        document.querySelectorAll<HTMLButtonElement>('[data-reading-scale]').forEach((btn) => {
          if (btn.dataset.readingScale === '1') {
            btn.dataset.active = 'true';
            btn.setAttribute('aria-pressed', 'true');
          } else {
            delete btn.dataset.active;
            btn.setAttribute('aria-pressed', 'false');
          }
        });
      });
    }
  })();
</script>
