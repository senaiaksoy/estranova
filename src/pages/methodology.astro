---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer.astro';
---

<Layout title="Metodoloji - Estranova">
  <Navbar client:load currentPage="/methodology" />
  <div class="pt-32 pb-24 px-6">
    <div class="max-w-4xl mx-auto">
      <header class="text-center mb-20">
        <p class="text-secondary font-bold tracking-[0.3em] uppercase mb-6">BIZIM YAKLASIMIMIZ</p>
        <h1 class="text-5xl md:text-7xl font-serif mb-8">Editoryal Metodoloji</h1>
        <p class="text-charcoal/60 text-lg leading-relaxed">
          Estranova'da icerikler; kaynak tarama, editoryal yazim, tibbi denetim ve yayin onayi adimlariyla hazirlanir.
        </p>
      </header>

      <div class="space-y-24">
        {[
          {
            step: "01",
            title: "Kanita Dayali Secki",
            desc: "Hakemli dergilerde yayimlanan ve guncel klinik kilavuzlarla uyumlu calismalar temel alinir. Spekulatif yaklasimlar ayiklanir.",
          },
          {
            step: "02",
            title: "Yazi ve Tibbi Denetim",
            desc: "Yazar ekibinin metinleri once editoryal kontrolden gecer, ardindan danisman doktor tarafindan tibbi dogruluk acisindan denetlenir.",
          },
          {
            step: "03",
            title: "Yayin Onayi ve Guncelleme",
            desc: "Icerikler periyodik olarak gozden gecirilir; yeni kanitlar ortaya ciktiginda sayfa revizyonu yapilir.",
          },
        ].map((m) => (
          <div class="flex flex-col md:flex-row gap-12 items-start">
            <div class="text-6xl font-serif text-primary/10 leading-none">{m.step}</div>
            <div>
              <h3 class="text-3xl font-serif mb-6">{m.title}</h3>
              <p class="text-charcoal/70 text-lg leading-relaxed">{m.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-24 p-10 bg-surface-container rounded-[40px]">
        <h3 class="text-3xl font-serif mb-6">Yonetim Modeli</h3>
        <div class="space-y-4 text-charcoal/70 leading-relaxed">
          <p><span class="font-semibold text-charcoal">Site Yoneticisi:</span> Berna Aksoy</p>
          <p><span class="font-semibold text-charcoal">Danisman Doktor ve Yazi Denetleyici:</span> Doc. Dr. Senai Aksoy</p>
          <p><span class="font-semibold text-charcoal">Yazarlar:</span> Alara Baykent, Basak Pelister</p>
          <p><span class="font-semibold text-charcoal">Tibbi Kurul:</span> Dr. Metin Alis, Dr. Alp Aslan Eryilmaz</p>
        </div>
      </div>

      <div class="mt-12 p-12 bg-surface-container rounded-[60px] text-center">
        <h3 class="text-3xl font-serif mb-6">Seffaflik Taahhudu</h3>
        <p class="text-charcoal/60 mb-8 max-w-2xl mx-auto">
          Kullandigimiz kaynaklar makale sonlarinda belirtilir. Yonetim ve denetim rolleri sayfa bazinda acik sekilde sunulur.
        </p>
        <a href="/library" class="text-primary font-bold border-b-2 border-primary pb-1">Kaynak Iceriklerini Inceleyin</a>
      </div>
    </div>
  </div>
  <Footer />
</Layout>
