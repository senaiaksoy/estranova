---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuHero from '../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../components/site/ArticleProsePanel.astro';
import { submenuHeroByRoute } from '../../data/submenu-heroes';
import Evidence from '../../components/site/Evidence.astro';
import { buildArticleSchemas } from '../../utils/article-schema';
import { resolveSiteUrl } from '../../utils/seo';

const hero = submenuHeroByRoute['/zamansiz-yasam/beslenme-yaslanma']!;

const tocEntries = [
  { id: 'neden-degisir', label: 'Neden Değişir' },
  { id: 'makronutrientler', label: 'Makronutrientler' },
  { id: 'mikronutrientler', label: 'Mikronutrientler' },
  { id: 'antioksidanlar', label: 'Antioksidanlar' },
  { id: 'ogun-modeli', label: 'Öğün Modeli' },
  { id: 'beslenme-sekilleri', label: 'Beslenme Şekilleri' },
  { id: 'tercih-sinirla', label: 'Tercih ve Sınırlama' },
  { id: 'ek-takviyeler', label: 'Ek Takviyeler' },
  { id: 'kisisellestirme', label: 'Kişiselleştirilmiş Yaklaşım' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Beslenme ve Yaşlanma — 40+ Kadınlar için Beslenme Rehberi';
const articleDescription = 'Menopoz döneminde metabolik değişiklikleri desteklemek için protein, vitaminler ve antioksidanlar hakkında rehberlik.';
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'gamze-cizreli',
  publishedDate: '14 Nisan 2026',
  pathname: '/zamansiz-yasam/beslenme-yaslanma',
  articleSection: 'Zamansız Yaşam',
  sectionPath: '/zamansiz-yasam',
  keywords: ['menopoz', 'beslenme', 'protein', 'kalsiyum', 'omega-3', 'anti-inflamatuar'],
  siteUrl,
});
---

<SiteLayout
  title={`${articleTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/zamansiz-yasam" />

  <main id="main-content" class="text-[#2D2D2D]">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Beslenme"
      title="Beslenme ve Yaşlanma — 40+ Kadınlar için Beslenme Rehberi"
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <SubmenuArticleBody>
        <ArticleTOC slot="toc" entries={tocEntries} />
        <ArticleAuthorBlock authorSlug="gamze-cizreli" publishedDate="14 Nisan 2026" readingMinutes={6} />

        <section class="rounded-[28px] border border-[#C9A96E]/35 bg-gradient-to-br from-white to-[#FDF8F0]/90 p-7 shadow-sm ring-1 ring-[#C9A96E]/22 md:p-8">
          <h2 class="mb-4 font-serif text-3xl">Kısa Özet</h2>
          <p class="leading-relaxed text-[#2D2D2D]/80">
            Menopoz döneminde metabolik değişiklikler beslenme ihtiyaçlarını değiştirir. Protein, B vitaminleri, omega-3 yağlar ve antioksidanlar, yaşlanma sürecini desteklemede kritik rol oynar. Bilgili seçimler sağlık yıllarını uzatmaya yardımcı olur.
          </p>
        </section>

        <ArticleProsePanel>
          <h2 id="neden-degisir">40+ Yaşta Beslenme Neden Değişir?</h2>
          <p>
            40 yaşından sonra vücut ihtiyaçları belirgin biçimde değişir. Temel metabolik hız (bazal metabolizma) yavaşlar,
            kas kütlesinin doğal kaybı hızlanır ve hormon üretimi dalgalanmaya başlar <Evidence level={5} />.
            Bu değişikliklerin yanında sindirim sistemi de yaşlanmaya başlar; bazı kadınlar laktoz intoleransı veya B12 emilimi sorunları yaşayabilir <Evidence level={4} />.
          </p>
          <p>
            Menopoz döneminde hormon değişiklikleri, vücudun yağ depoladığı yerler, enerji harcaması ve besin tercihlerini etkiler <Evidence level={5} />.
            Aktivite seviyesi sık düşer; hatta aynı yer almasa bile kalori ihtiyacı azalır <Evidence level={5} />.
            Bu nedenle daha önceki beslenme alışkanlıkları artık yetmeyebilir; seçimlerin daha bilinçli olması gerekir.
          </p>

          <h2 id="makronutrientler">Makronutrientler: Protein, Yağ, Karbohidrat</h2>
          <p>
            Protein, bu dönemde beslenmenin en kritik elemanı haline gelir. İhtiyaç miktarı 1.0-1.2 gram/kilogram vücut ağırlığıdır <Evidence level={5} />.
            Kas kaybı (sarcopenia), tişeli sağlık, kemik bütünlüğü ve metabolik işlevler protein bağlıdır.
            60 kiloluk bir kadının günde 60-70 gram protein alması gerekir. Et, balık, yumurta, legüm ve süt ürünleri iyi kaynaklar arasında yer alır.
          </p>
          <p>
            Yağlara gelince, doymuş ve doymuş olmayan yağ dengesesi önemlidir <Evidence level={5} />.
            Omega-3 yağ asitleri (balık, chia tohumu, ceviz, keten tohumu) inflamasyonu azaltır ve beyin sağlığını destekler.
            Karbohidrat seçimi kaliteli olmalı: tam tahıllar, sebzeler ve meyveler tercih edilir; şeker ve beyaz tahıl kısıtlanır <Evidence level={5} />.
            Lif, sindirim sağlığı ve doygunluk açısından kritiktir.
          </p>

          <h2 id="mikronutrientler">Kritik Mikronutrientler</h2>
          <p>
            B vitamines (B6, B12, folat) enerji üretimi, beyin sağlığı ve hücre bölünmesi açısından önemlidir <Evidence level={5} />.
            B12, özellikle 50+ yaştan sonra emilim sıkıntısı nedeniyle dikkat edilmelidir; yumurta, et, tavuk ve yeşil yapraklı sebzeler iyi kaynaklardır.
            Demir, özellikle postmenopoz dönemde ihtiyaç azalırken (aylık kanama durdu), yine de önemli bir mineralddir <Evidence level={5} />.
          </p>
          <p>
            Çinko bağışıklık sistemi ve cilt sağlığı açısından değerlidir <Evidence level={5} />.
            Magnesium uyku, kas esnekliği ve kemik sağlığı için kritiktir <Evidence level={5} />.
            Yeşil yapraklı sebzeler (ıspanak, pazı), kuru yemişler ve tam tahıllar iyi kaynaklardır.
            Kalsiyum ve D vitamini, kemik kaybını yavaşlatmada vazgeçilmezdir; süt ürünleri, başak balıkları, fortifiye bitkisel sütler ve güneş ışığı temel kaynaklar arasında yer alır.
          </p>

          <h2 id="antioksidanlar">Antioksidanlar ve Fitonutrientler</h2>
          <p>
            Renklü sebzeler (sarı, kırmızı, yeşil, mor) farklı antioksidanlar içerir ve enflamasyon karşıtı özellikleri vardır <Evidence level={5} />.
            Meyveler (özellikle mirtil, çilek) hücre hasarına karşı koruma sağlar <Evidence level={5} />.
            Yeşil ve siyah çay, epigalovkatekini gibi bileşiklerle antiyaşlanma özellikleri taşır <Evidence level={5} />.
            Zerdeçal gibi baharatlar, kurkumin içeriğiyle inflamasyonu azaltır <Evidence level={4} />.
          </p>

          <h2 id="ogun-modeli">Beslenme Alışkanlıkları ve Öğün Modeli</h2>
          <p>
            Düzenli öğünler (her 3-4 saatte) kan şekeri ve enerji seviyesini stabilize eder <Evidence level={5} />.
            Sabit uyku-uyanış saat ve beslenme senkronizasyonu biyolojik ritimleri destekler <Evidence level={4} />.
            Su tüketimi minimum 2-3 litre/gün olmalı; yaşlanmayla tıkınma hissi azaldığı için bilinçli su içme gerekir <Evidence level={5} />.
          </p>
          <p>
            Porsyon kontrolü önemlidir; hatta aynı kaloriyi alsa bile daha büyük porsiyonlar saç kaybı veya aşırı yemesine yol açabilir <Evidence level={5} />.
            Ultra-işlenmiş gıdalar (paketli atıştırmalıklar, hazır yemekler, şeker içecekler) kısıtlanmalıdır <Evidence level={5} />.
            Evde pişen, basit ve tanıyabildiklerimiz optimal tercihlerdir.
          </p>

          <h2 id="beslenme-sekilleri">Beslenme Şekilleri: Hangisi Uygun?</h2>
          <p>
            Akdeniz Diyeti, menopoz döneminde en çok kanıt-tabanlı yaklaşımdır <Evidence level={5} />.
            Balık, zeytinyağı, sebzeler ve tam tahıl ağırlıklı olan bu diyetin kalp ve beyin sağlığı yararları geniş çalışmalarla gösterilmiştir.
          </p>
          <p>
            DASH Diyeti hipertansiyon ve kardiyovasküler sağlık için tasarlanmış; menopoz döneminde de etkilidir <Evidence level={5} />.
            Vejetaryen ve vegan yaklaşımlar mümkündür ancak dikkatli planlama gerekir (B12, demir, protein kaynakları) <Evidence level={4} />.
            Düşük karbohidrat diyetleri bazı kadınlara uyarken, başkalarında enerji veya ruh hali sorunlarına neden olabilir <Evidence level={4} />.
            Intermittent fasting menopoza özgü çalışma sayısı sınırlıdır; bireysel danışma önerilir <Evidence level={3} />.
          </p>

          <h2 id="tercih-sinirla">Yiyecekler: Tercih Et, Sınırla</h2>
          <p>
            Tercih ettiğimiz gıdalar: tam tahıllar, balık, tavuk, yumurta, legüm, yeşil yapraklı sebzeler, meyveler, nüts ve tohumlar.
            Sınırlandırmaya değer gıdalar: işlenmiş et, şeker içi içecekler, ultra-işlenmiş ürünler, aşırı tuz.
          </p>
          <p>
            Kafein ve alkol özel dikkat gerektirir. Kafein uyku kalitesini bozabilir (öğleden sonra saat 2'den sonra sınırla).
            Alkol, sıcak basması ve uyku bozukluğunu artırabilir; haftada bir veya iki kadeh sınırlamak akıllıcadır <Evidence level={5} />.
          </p>

          <h2 id="ek-takviyeler">Ek Takviyeler: Gerekli mi?</h2>
          <p>
            D vitamini, özellikle kış aylarında veya kapalı ortamlarda yaşayanlara ihtiyaç duyan bir takviyedir <Evidence level={5} />.
            Kan testleriyle durum kontrol edildikten sonra karar alınır.
          </p>
          <p>
            Kalsiyum, takviye ile birlikte beslenme de gözönüne alınmalı <Evidence level={5} />.
            Omega-3 (balık yağı) kaynakları yeterli değilse takviye faydalıdır <Evidence level={4} />.
            50+ yaşındaki tüm kadınlara B12 (beslenme veya takviye) önerilir <Evidence level={5} />.
            Multivitamin takviyesi, dengeli bir diyet alınanlar için çoğu zaman gerekli değildir <Evidence level={4} />.
          </p>

          <h2 id="kisisellestirme">Kişiselleştirilmiş Yaklaşım</h2>
          <p>
            Beslenme ihtiyaçları kişi kişi değişir. Kronik hastalık (diyabet, hipertansiyon), ilaçlar, sindirim sorunu veya
            belirli beslenme kısıtlamaları (alerji, intolerans) danışmanın kapsamını değiştirir.
            Diyetisyen veya beslenme danışmanından tavsiye almak, kişiye uygun bir plan oluşturmaya yardımcı olur.
          </p>
        </ArticleProsePanel>

        <section class="mt-14 rounded-[28px] border border-[#6B2D3E]/12 bg-[#FDF8F0] p-7 shadow-sm ring-1 ring-[#6B2D3E]/10 md:p-8">
          <h2 class="mb-5 font-serif text-3xl">İlgili İçerikler</h2>
          <ul class="space-y-3">
            <li><a href="/zamansiz-yasam/d-vitamini-rehberi" class="font-semibold text-[#6B2D3E] hover:underline">Zamansız Yaşam / D Vitamini Rehberi</a></li>
            <li><a href="/zamansiz-yasam/hareket-saglik-menopoz" class="font-semibold text-[#6B2D3E] hover:underline">Zamansız Yaşam / Hareket ve Sağlık</a></li>
            <li><a href="/zamansiz-yasam/kemik-sagligi" class="font-semibold text-[#6B2D3E] hover:underline">Zamansız Yaşam / Kemik Sağlığı</a></li>
            <li><a href="/zihin-denge/uyku-bozuklugu-menopoz" class="font-semibold text-[#6B2D3E] hover:underline">Zihin & Denge / Uyku Bozukluğu</a></li>
            <li><a href="/bilimsel-pencere/mitokondrial-saglik" class="font-semibold text-[#6B2D3E] hover:underline">Bilimsel Pencere / Mitokondrial Sağlık</a></li>
          </ul>
        </section>

        <section class="mt-14 rounded-[28px] border border-[#6B2D3E]/15 border-l-[6px] border-l-[#C9A96E] bg-gradient-to-r from-[#F5EDE0] to-[#FDF8F0] p-7 shadow-sm ring-1 ring-[#6B2D3E]/10 md:p-8">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.22em] text-[#6B2D3E]">Bilimsel Editör Notu · Doç. Dr. Senai Aksoy</p>
          <p class="mb-4 text-lg font-semibold text-[#2D2D2D]">Kanıt Düzeyi: A — Güçlü Kanıt <Evidence level={5} /></p>
          <p class="leading-relaxed text-[#2D2D2D]/80">
            Beslenme, yaşlanmanın hızı ve kalitesi üzerinde güçlü kontrol sağlar. Menopoz döneminde bilgili, planlı seçimler belirtileri yönetmeye ve uzun vadeli sağlık risklerini azaltmaya katkı sağlar. Kişiselleştirilmiş rehberlik için diyetisyen danışması değerlidir.
          </p>
        </section>

        <section class="mt-10 rounded-[24px] border border-dashed border-[#6B2D3E]/25 bg-white/95 p-6 ring-1 ring-[#6B2D3E]/10">
          <p class="text-sm leading-relaxed text-[#2D2D2D]/75">
            Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavinin yerini almaz. Sağlık kararlarınız için
            kendi hekiminizle birlikte değerlendirme yapınız.
          </p>
        </section>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
