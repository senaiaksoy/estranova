---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuHero from '../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../components/site/ArticleSummary.astro';
import RelatedReadings from '../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../components/site/ArticleFAQ.astro';
import Evidence from '../../components/site/Evidence.astro';
import { submenuHeroByRoute } from '../../data/submenu-heroes';
import { buildArticleSchemas } from '../../utils/article-schema';
import { articleFaqs } from '../../data/article-faqs';
import { resolveSiteUrl } from '../../utils/seo';

const pathname = '/zamansiz-yasam/yuz-mudahalesi-olcu-sorusu';
// CLAUDE.md §6 — makale üst hero görseli daima parent hub'dan gelir.
// memory: feedback_makale_hero_degismez_2026_05_10
const hero = submenuHeroByRoute['/zamansiz-yasam']!;

const articleTitle = "Hangi Yüz Müdahalesi Sizin İçin? — 40 Sonrası 'Ölçü Sorusu'";
const articleDescription =
  "40 sonrası yüz müdahalelerine bakarken hangi sorular size aittir, hangileri başkasının? Yüzünüzün dört katmanı, 'yapılabilir mi' yerine 'size uygun mu' sorusu, müdahale haritası ve hekiminize sormaya değer dört soru üzerinden sade bir karar çerçevesi.";

const tocEntries = [
  { id: 'aynanin-karsisinda', label: 'Aynanın Karşısındaki Soru' },
  { id: 'dort-katman', label: 'Yüzünüzün Dört Katmanı' },
  { id: 'olcu-sorusu', label: '"Size Uygun mu?" Sorusu' },
  { id: 'mudahale-haritasi', label: 'Müdahale Haritası' },
  { id: 'kabul-mudahale', label: 'Kabul ve Müdahale Dengesi' },
  { id: 'cerrahla-konusmak', label: 'Hekiminize Sormaya Değer Sorular' },
  { id: 'sss', label: 'Sık Sorulanlar' },
];

const faqItems = articleFaqs[pathname] ?? [];
const siteUrl = resolveSiteUrl(Astro.site);
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'cagri-sade',
  publishedDate: '10 Mayıs 2026',
  pathname,
  articleSection: 'Zamansız Yaşam',
  sectionPath: '/zamansiz-yasam',
  keywords: [
    '40 sonrası estetik',
    'yüz müdahalesi karar',
    'yüz yaşlanması',
    'non-invaziv yüz tedavileri',
    'estetik karar kriterleri',
    'doğal yaşlanma kabulü',
    'menopozda cilt',
    'estetik beklenti yönetimi',
    'size uygun mu sorusu',
  ],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${articleTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/zamansiz-yasam" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Yüz Yaşlanması"
      title={articleTitle}
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="cagri-sade"
        publishedDate="10 Mayıs 2026"
        readingMinutes={8}
        imageSrc="/images/library/editorial/zy-yuz-mudahalesi-olcu-sorusu-byline.webp"
        imageAlt="Sabah ışığında ev içi sade bir köşede yandan profil duran, parmaklarını çene-yanak hattına yumuşakça değdirmiş 50+ kadın portresi; bordo bluz ve doğal pencere ışığında 'ölçü sorusu' atmosferi taşıyan dikey dosya görseli"
        imagePosition="center center"
      />

      <ArticleSummary title="Özet">
        <p>
          40 sonrası yüz müdahalelerine bakarken asıl yardımcı olan soru "yapılabilir mi" değil, <em>"size uygun
          mu"</em>. Op. Dr. Çağrı Sade yüzün dört katmanını (cilt, yağ, kemik, kas), kararın beş eksenini
          (yaş, beklenti, yaşam tarzı, sağlık zemini, motivasyon kaynağı), müdahale haritasının kanıt sıralamasını
          ve hekiminize sormaya değer dört somut soruyu sade bir tabloyla aktarıyor. Modaya değil yüzün kendi
          tarihine bakan bir çerçeve.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="aynanin-karsisinda">Aynanın Karşısındaki Soru</h2>
        <p>
          Aynaya bakıp "bir şeyler değişmiş" demek 40'tan sonra çoğu kadının paylaştığı bir an. Sonrasında gelen
          soru bazen sessiz, bazen biraz kararsız: "Şimdi ne yapsam?"
        </p>
        <p>
          Bu soruya hızlı bir cevap aramak çoğu zaman aceleye getirir. Aşağıda öneri listesi yok; karar verirken
          zihninizde tutmaya değer bir çerçeve var. Çoğunlukla sorduğumuz "yapılabilir mi" sorusu teknik bir
          sorudur — cevabı genellikle evettir. Asıl yardımcı olan soru farklı: <em>"Size uygun mu?"</em>
        </p>

        <h2 id="dort-katman">Yüzünüzün Dört Katmanı Birlikte Konuşur</h2>
        <p>
          Yüz, tek bir noktanın değil; cilt, yağ, kemik ve kasın aynı anda konuştuğu bir tablodur. Hangi katmanın
          daha çok değiştiğini anlamak ilk adımdır.
        </p>
        <p>
          Cildiniz hormonal geçişle birlikte incelir, kollajen ve nem kaybı belirginleşir <Evidence level={5} />.
          Yüzdeki yağ paketleri (medikal terim: <em>yağ kompartmanları</em>) zamanla hem azalır hem yer değiştirir;
          bu, yüze "biraz düşmüş" görünüm verir. Kemik tarafında yıllar içinde küçük bir erime
          (<em>rezorpsiyon</em>) olur; gözle görünmez ama yüzün dış çerçevesini değiştirir. Kaslar ise tekrar eden
          mimik desenleriyle bazı bölgelerde derinleşir.
        </p>
        <p>
          Bu dört katman aynı anda değişir — ama her kadında aynı oranda değil. Birinde cilt, başkasında yağ
          kaybı, başkasında kemik kaynaklı çerçeve değişimi öne çıkar. Önce kendi fotoğraflarınıza yıllar
          üzerinden bakmak çoğu zaman dışarıdan gelen yorumlardan daha fazla şey söyler.
        </p>
        <p class="border-l-2 border-gold/50 pl-4 italic text-ink/75">
          Yüzdeki "düşme" hissi çoğu zaman cildin sarkmasından değil, alttaki yağ ve kemik desteğinin
          azalmasından gelir. Yüzeysel müdahalelerin bazı tablolarda neden yetersiz kaldığı bu mekanikten okunur.
        </p>

        <h2 id="olcu-sorusu">Asıl Soru: "Size Uygun mu?"</h2>
        <p>
          Bir teknik bugün yapılabilir olabilir; ama her teknik herkese aynı uygunlukta değildir. Asıl soruyu
          beş eksen şekillendirir.
        </p>
        <p>
          <strong>Yaş ve dönem.</strong> Aynı işlem 42 yaşındaki bir kadında ve 58 yaşındaki bir kadında farklı
          sonuç verir; hormonal zemin ve doku elastikiyeti farklıdır.
        </p>
        <p>
          <strong>Beklentiniz.</strong> "Daha dinlenmiş görünmek" ile "daha genç görünmek" aynı şey değil;
          ikincisi çoğu zaman aşırı müdahaleye yol açar.
        </p>
        <p>
          <strong>Yaşam tarzınız.</strong> Açık havada çok zaman geçiren ya da uzun iyileşme sürelerine vakti
          olmayan bir kadın için aynı işlem aynı uygunlukta değildir.
        </p>
        <p>
          <strong>Sağlık zemininiz.</strong> Tiroid, otoimmün durum, kanama eğilimi, ilaç kullanımı — bunlar
          müdahale seçimini doğrudan etkiler.
        </p>
        <p>
          <strong>Motivasyonunuzun kaynağı.</strong> Karar siz, eşiniz, sosyal çevreniz, yoksa bir paylaşım
          algoritması mı? Bu sorunun cevabı netse, sonuç da çoğu zaman tutarlı olur.
        </p>
        <p>
          Bu beş ekseni kendi başınıza dile getirebiliyorsanız, hekiminizle konuşma çok daha verimli açılır.
          Aksi halde teknik soru ("yapılabilir mi") asıl sorunun yerine geçer ve tablo zamanla sürdürülebilir
          olmaz.
        </p>

        <h2 id="mudahale-haritasi">Hafiften Ağıra: Müdahale Haritası</h2>
        <p>
          Müdahaleleri dik bir merdiven gibi değil, kanıt ve geri dönüşebilirliğe göre sıralanmış bir hat olarak
          düşünmek daha sağlıklı. Bu sıralama bir reçete değil; başlangıç noktanız bambaşka bir basamak da
          olabilir.
        </p>

        <ul>
          <li>
            <strong>Bakım katmanı.</strong> Cilt bakımı, beslenme, uyku ve güneşle ilişkinizin dengesi. Güneş
            hem cilt yaşlanmasının hem de D vitamini sentezinin kaynağıdır; bu yüzden yoğun saatlerde korunmak,
            öğle sonrası kısa süreli (15-20 dakika) kontrollü güneş almak iki yönlü bir denge demek
            <Evidence level={5} />. Bu zemin atlandığında üst basamakların etkisi azalır.
          </li>
          <li>
            <strong>Enerji bazlı non-invaziv uygulamalar.</strong> Odaklanmış ultrason ve radyofrekans gibi
            cilt sıkılaştırma teknolojileri, alt katmanlarda ısı ile kollajen üretimini uyarmayı amaçlar. Etki
            ılımlı, kalıcılık değişkendir <Evidence level={3} />. En uygun aday: doku tonusu hâlâ taşıyabilen
            bir cilt zemini.
          </li>
          <li>
            <strong>Lazer tabanlı uygulamalar.</strong> Yüzeysel ten tonu, lekeler ve ince çizgiler için.
            Etki belirli <Evidence from={3} to={4} />; cilt tonuna ve iyileşme süresine göre uygunluk değişir.
          </li>
          <li>
            <strong>Enjeksiyonlar.</strong> Botulinum toksini mimik kaslarını, dolgular hacim kaybını
            hedefler — iki farklı mantıkla çalışırlar. Etki belirli ama geçicidir; doğru endikasyonda kullanım
            yıllar içinde sürdürülebilir bir tablo verir, aşırı kullanım vermez <Evidence level={5} />.
          </li>
          <li>
            <strong>İplik askılama.</strong> Cilt altına yerleştirilen ipliklerle yumuşak askılama amaçlanır.
            Kanıt seviyesi sınırlıdır <Evidence level={2} />; etki kısa, beklenti yönetimi en kritik alandır.
          </li>
          <li>
            <strong>Cerrahi müdahaleler.</strong> Göz kapağı estetiği ve yüz germe gibi seçenekler en kalıcı
            sonucu verir; uygun adayda en bütünlüklü tabloyu sunar <Evidence level={5} />. Karşılığında
            iyileşme süresi, anestezi yükü ve geri dönüşsüzlük gibi ağır kriterler taşır.
          </li>
        </ul>

        <p class="border-l-2 border-gold/50 pl-4 italic text-ink/75">
          Bir üst basamak, bir alt basamağın eksiğini her zaman tamamlamaz: bakım katmanı atlanmış bir ciltte
          enerji bazlı uygulamalar beklenen sonucu vermez; yağ ve kemik kaynaklı hacim kaybı varsa yalnız
          yüzey müdahalesi yetersiz kalır.
        </p>

        <h2 id="kabul-mudahale">Doğal Yaşlanma ve Müdahale: İki Ucu Birden Tutmak</h2>
        <p>
          Bir uçta hiç dokunmamak, diğer uçta her değişime hemen müdahale etmek var. Sürdürülebilir karar
          genellikle ikisinin arasında, kişiden kişiye değişen bir yerde durur.
        </p>
        <p>
          Doğal yaşlanmayı tamamen reddetmek zor; her müdahale yıllar içinde <em>zaten yaşlanan bir yüz
          üzerinde</em> yapılır. Bu yüzden müdahalenin amacı yaşlanmayı durdurmak değil, <em>zamanın yüze
          işleyiş ritmini biraz daha ölçülü hale getirmek</em> olabilir. Bu çerçeve "panik dili" yerine "ritim
          dili" kurar.
        </p>
        <p>
          Karar verirken bazı cümleler durdurmalıdır. <em>"Bunu yapmazsan geç kalırsın"</em> çoğu zaman
          bilgiden değil ticari aciliyetten gelir. <em>"Şu an çok popüler"</em> modaya işaret eder; oysa moda
          değişir, yüz aynı kalır. <em>"Sırrı bu"</em> yetersiz kanıtlı bir teknik için satış cümlesidir. Bu
          cümleleri bir reklamda, bir röportajda ya da görüşme odasında duyarsanız, bir adım geri durup zemini
          yeniden tartmak anlamlıdır.
        </p>
        <p>
          Modaya değil, kendi yüzünüzün tarihine bakan bir yaklaşım her zaman daha sürdürülebilir.
        </p>

        <h2 id="cerrahla-konusmak">Hekiminize Sormaya Değer Dört Soru</h2>
        <p>
          Aşağıdakiler bir test değil, görüşmenin sade bir açılışıdır. Sorduğunuzda hekiminiz bunları doğal
          karşılıyorsa, zemin sağlam demektir.
        </p>

        <ul>
          <li>
            <strong>"Bu işlem yüzümün hangi katmanına cevap verir, hangisine vermez?"</strong> Tek bir işlemin
            yüzü bütünüyle değiştirmesini beklemekten korur.
          </li>
          <li>
            <strong>"Aynı sonuca daha az müdahaleli bir yol var mı?"</strong> Hekiminizin tedavi haritasını
            sizinle paylaşmasını sağlar.
          </li>
          <li>
            <strong>"Sonuç ne kadar kalıcı, sonra ne yapılır?"</strong> Kararı kısa vadeli değil, yıllar boyu
            görmek için.
          </li>
          <li>
            <strong>"Yapmamayı seçersem ne olur?"</strong> Cevabı dürüstçe verilebiliyorsa, kararın ölçü
            diliyle kurulduğunu gösterir.
          </li>
        </ul>
      </ArticleProsePanel>

      <ArticleFAQ
        id="sss"
        class="mt-10"
        items={faqItems}
        title="Bu Yazıdan Sonra Akla Gelen Sorular"
        intro="Yüz müdahalesi karar süreci üzerine en sık dönülen soruları konuya özgü kısa yanıtlarla topladık."
      />

      <RelatedReadings
        class="mt-10"
        paths={[
          '/zamansiz-yasam/non-invaziv/cilt-cihazlari-rehberi',
          '/hormonal-gecis/menopoz/dokuz-yillik-menopoz-sonunda-hrt-karari',
          '/zamansiz-yasam/40-sonrasi-diz-agrisi-izlem-mudahale',
        ]}
      />

      <ArticleEditorNote class="mt-10">
        <p>
          Yüz ve cilt yaşlanması 40 sonrası kadınlarda farklı katmanlarda farklı hızla ilerler. Estetik
          müdahaleler kanıt seviyesi açısından geniş bir yelpazede yer alır: bakım katmanı ve cerrahi
          seçenekler için kanıt görece sağlamdır; bazı non-invaziv teknolojiler için kanıt gelişmektedir;
          iplik askılama gibi bazı tekniklerde kanıt sınırlıdır. Bu farkı anlamak, beklenti yönetimi ile
          sürdürülebilir karar arasındaki köprüdür.
        </p>
        <p>
          Estetik karar daima <strong>bireyseldir</strong>: yaş, hormonal zemin, sağlık geçmişi, ilaç
          kullanımı, doku özellikleri ve kişisel beklenti birlikte değerlendirilir. Müdahale öncesi
          konsültasyonda kişisel risk faktörleri, gerçekçi beklenti ve takip planı birlikte konuşulur.
          Hangi tipte müdahale olursa olsun <strong>uzun vadeli sürdürülebilirlik</strong>, kısa vadeli
          sonuçtan daha belirleyicidir. Beklenmedik belirti ya da iyileşme süreciyle ilgili soruda planlı
          zamandan önce hekiminize başvurmak güvenli tercihtir.
        </p>
      </ArticleEditorNote>

      <ArticleDisclaimer class="mt-10" />
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
