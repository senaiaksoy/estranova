---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuHero from '../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../components/site/ArticleSummary.astro';
import { submenuHeroByRoute } from '../../data/submenu-heroes';
import Evidence from '../../components/site/Evidence.astro';
import RelatedReadings from '../../components/site/RelatedReadings.astro';
import { buildArticleSchemas } from '../../utils/article-schema';
import { articleFaqs } from '../../data/article-faqs';
import { resolveSiteUrl } from '../../utils/seo';

const pathname = '/zamansiz-yasam/kilo-artisi-menopoz/';
const hero = submenuHeroByRoute['/zamansiz-yasam/']!;

const tocEntries = [
  { id: 'neden-simdi', label: 'Yaşam Aynı Kalırken Tartı Neden Değişir?' },
  { id: 'yag-cografyasi', label: 'Östrojen ve Yağın Yeni Coğrafyası' },
  { id: 'az-yemek-yetmez', label: 'Porsiyonu Küçültmenin Bu Dönemdeki Sınırı' },
  { id: 'kas-motoru', label: 'Kas Kütlesi: Görünmeyen Metabolizma Motoru' },
  { id: 'uyku-stres-seker', label: 'Uyku, Stres ve Kan Şekeri' },
  { id: 'tabakta-denge', label: 'Tabakta Denge: Protein, Lif, Sağlıklı Yağ' },
  { id: 'hareket-yolu', label: 'Hareket Yolu: Direnç Çalışması' },
  { id: 'hekime-gitme', label: 'Hekime Danışma Zamanı' },
  { id: 'sik-sorulanlar', label: 'Sıkça Sorulanlar' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Menopozda Kilo Artışı: Tartının Söylemediği Kısım';
const seoTitle = 'Menopozda Kilo Artışı';
const articleDescription =
  'Menopoz geçişinde kilo değişimini östrojen, yağın yerleşimi, kas kütlesi, uyku ve stres açısından anlatır; hekime ne zaman danışılacağını belirtir.';
const faqItems = articleFaqs[pathname] ?? [];
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'estranova-editorial',
  articleType: 'editorial-guide',
  publishedDate: '15 Temmuz 2026',
  modifiedDate: '22 Ekim 2026',
  pathname,
  articleSection: 'Zamansız Yaşam',
  sectionPath: '/zamansiz-yasam/',
  keywords: [
    'menopoz',
    'kilo artışı',
    'östrojen',
    'visseral yağ',
    'bel çevresi',
    'sarkopeni',
    'kas kütlesi',
    'metabolizma',
    'insülin direnci',
    'protein',
    'direnç egzersizi',
    '40+ kadın',
  ],
  faqItems,

  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/zamansiz-yasam/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Beden ve Metabolizma"
      title="Menopozda Kilo Artışı: Tartının Söylemediği Kısım"
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <SubmenuArticleBody>
        <ArticleTOC slot="toc" entries={tocEntries} />
        <ArticleAuthorBlock
          authorSlug="estranova-editorial"
        articleType="editorial-guide"
          publishedDate="15 Temmuz 2026"
          lastUpdated="22 Ekim 2026"
          readingMinutes={9}
          imageSrc="/images/library/editorial/casual-cream-sweater-pampas.webp"
          imageAlt="Balkonda otlarla ilgilenen, elinde sebze tabağı tutan 40 yaş üstü bir kadın"
        />

        <ArticleSummary title="Kısa Özet">
          <p>
            Menopoz geçişinde kilo değişimi tek bir nedene bağlanamaz. Östrojen düşünce yağ bel çevresine
            kayabilir; aynı yıllarda kas kütlesi sessizce azalır, uyku ve stres de tabloya katılır. Kalori
            saymak bu yüzden çoğu zaman yetmez. Kısa sürede, beklenmedik biçimde gelen kilo değişiminde hekim
            değerlendirmesi gerekir.
          </p>
        </ArticleSummary>

        <ArticleProsePanel>
          <h2 id="neden-simdi">Yaşam Aynı Kalırken Tartı Neden Değişir?</h2>
          <p>
            Aynı dolap. Aynı pantolon. Numara artık eskisi gibi durmuyor.
          </p>
          <p>
            Bazen değişim tartıda değil, kıyafetin bedene oturuşunda fark edilir. Bel bandındaki ince sıkılık,
            sabah aynadaki kısa duraksama — sayıdan önce gelen sinyaller çoğu zaman bunlardır.
          </p>
          <p>
            Menopoz geçişi yıllarında kilo artışı genellikle iki ile beş kilogram aralığında seyrediyor. Daha
            belirgin olan çoğu zaman kilonun nereye yerleştiğidir <Evidence level={5} />. Bu birkaç yıllık
            pencerede hormonal geçiş, yaşa bağlı kas kaybı, metabolizmanın kademeli yavaşlaması ve uyku
            dalgalanması aynı anda etkili oluyor.
          </p>
          <p>
            Merak etmeyin diye ekleyelim: bu tablo sizin iradenizin yetmediği anlamına gelmez.
          </p>

          <h2 id="yag-cografyasi">Östrojen ve Yağın Yeni Coğrafyası</h2>
          <p>
            Östrojen yıllarca yağı kalça ve uyluk çevresine yönlendirir, bel bölgesini ise büyük ölçüde korurdu.
          </p>
          <p>
            Geçişle birlikte bu düzen değişiyor. Östrojen düşünce yağ, cilt altından iç organ çevresine —
            visseral alana — kayabiliyor <Evidence level={5} />. Visseral yağ pasif bir depo değil; metabolik
            olarak etkin, hafif bir iltihap zemini oluşturan bir doku.
          </p>
          <p>
            Bel çevresindeki artış bu yüzden görünümün ötesinde, insülin direnci (hücrelerin şekere verdiği
            yanıtın zorlaşması) ve kalp-damar sağlığıyla ilişkili bir sinyal olarak değerlendiriliyor
            <Evidence level={5} />.
          </p>
          <p>
            Kadınlarda 88 santimetre üzerindeki bel çevresi, kilo değerinden bağımsız olarak metabolik risk
            işareti kabul ediliyor <Evidence level={4} />. Tartı bu eşiği göstermez; bel ölçüsü gösterir.
            Pantolonun belde farklı oturması, bazen bu kaymanın gündelik karşılığıdır.
          </p>

          <h2 id="az-yemek-yetmez">Porsiyonu Küçültmenin Bu Dönemdeki Sınırı</h2>
          <p>
            Pantolonun belini bir delik içeri almak. Öğle yemeğini yarıda bırakmak. Tartı yukarı kayınca ilk
            refleks bu olur.
          </p>
          <p>
            Bu dönemde aynı denklem her zaman işlemiyor. Belirgin kalori kısıtlaması metabolizmayı önce
            yavaşlatıyor, kas kaybını hızlandırıyor, ardından küçük bir gevşemede kiloyu geri çağırıyor
            <Evidence level={4} />. Bu tekrar her seferinde kas kütlesini biraz daha azaltabiliyor. Tartı
            benzer bir sayı gösterse de kompozisyon değişmiş oluyor.
          </p>
          <p>
            Sizin için mesele kalori miktarından çok kasın korunması olabilir. Kası koruyan, kan şekerini
            dengeleyen ve uykuyu onaran küçük adımlar, hızlı sonuç vaat eden kısıtlama yöntemlerine göre uzun
            vadede daha sürdürülebilir görünüyor. Utanç burada yön göstermez.
          </p>

          <h2 id="kas-motoru">Kas Kütlesi: Görünmeyen Metabolizma Motoru</h2>
          <p>
            Kilo konuşmasının en az görünen parçası kas dokusu. Günlük enerji dengesini sessizce yönetir.
          </p>
          <p>
            Otuz yaşından sonra her on yılda kas kütlesinin yüzde üç ile sekiz arasında azalması yaygın bir
            bulgu; bu süreç sarkopeni olarak tanımlanıyor <Evidence level={5} />. Menopozla birlikte
            östrojenin kas yapımını destekleyen sinyallere etkisi azaldığından bu eğri biraz daha dikleşiyor.
          </p>
          <p>
            Kas dinlenirken bile enerji harcar. Kaybedilen her kilogram kas, günlük metabolizmada küçük ama
            sürekli bir düşüşe karşılık gelebiliyor. Bu yüzden tartı aynı sayıyı gösterirken bile kasınızın
            durumu ayrı bir bilgi taşır.
          </p>

          <h2 id="uyku-stres-seker">Uyku, Stres ve Kan Şekeri</h2>
          <p>
            Gece üçte uyanmak. Sabah mutfakta daha tatlı bir şey aramak. Tabağın dışındaki hikâye bazen burada
            başlar.
          </p>
          <p>
            Yetersiz uyku, iştahı düzenleyen leptin ve ghrelin hormonlarının dengesini etkiliyor; ertesi gün
            yüksek kalorili ve karbonhidrat yoğun besinlere yönelimi artırabiliyor <Evidence level={5} />.
            Menopoz dönemine özgü uyku bölünmeleri veya sıcak basmaları varsa bu etki yıllar boyu birikebiliyor.
          </p>
          <p>
            Kronik stres, kortizol düzeyini yüksek tutarak bel çevresindeki yağ birikimiyle ilişkilendiriliyor
            <Evidence level={4} />. İnsülin duyarlılığındaki değişim de karbonhidrat yanıtını
            farklılaştırabiliyor. Bu üç etken genellikle birlikte hareket eder. Sizin tablonuzda hangisinin
            öne çıktığını görmek, hekimle yapılacak konuşmayı daha net kılar.
          </p>

          <h2 id="tabakta-denge">Tabakta Denge: Protein, Lif, Sağlıklı Yağ</h2>
          <p>
            Öğle tabağına bakınca ilk soru hâlâ "ne kadar" olabiliyor. Bu dönemde tabağın nasıl kurulduğu daha
            çok şey söyler.
          </p>
          <p>
            Protein ilk dayanak noktası. Araştırmalarda sık geçen yaklaşım, vücut ağırlığına göre günlük
            protein alımını artırmayı işaret ediyor <Evidence level={5} />. Kesin miktar, hekim veya
            diyetisyenle birlikte belirlenmesi gereken bireysel bir aralıktır. Üç ana öğüne dağıtılmış protein,
            kas korunmasına katkı sağlayabiliyor ve tokluk hissini uzatabiliyor.
          </p>
          <p>
            Lifli sebzeler tabağın büyük kısmını oluşturduğunda kan şekeri eğrisi yumuşuyor; tam tahıl,
            baklagil ve sebzelerden gelen lif bağırsak sağlığına destek olabiliyor <Evidence level={4} />.
            Zeytinyağı, ceviz ve balık kaynaklı sağlıklı yağlar tokluğu uzatıyor.
          </p>
          <p>
            Akdeniz tarzı bir düzen — sebze, tam tahıl, balık, zeytinyağı, baklagiller — bu dönem için sık
            başvurulan yaklaşımlardan biri olarak görülüyor <Evidence level={5} />. Katı kısıtlama genellikle
            uzun vadede tersine döner; sizin tabağınızda protein, lif ve sağlıklı yağın yan yana durması daha
            sürdürülebilir bir yol olabilir.
          </p>

          <h2 id="hareket-yolu">Hareket Yolu: Direnç Çalışması</h2>
          <p>
            Düzenli yürüyüş, bel bandını tek başına eski haline getirmeyebilir.
          </p>
          <p>
            Düşük etkili aerobik hareket kalp-damar sağlığı için önemini koruyor. Kilo yerleşimi ve metabolik
            denge açısından bu dönemde öne çıkan ise direnç çalışmasıdır. Haftada birkaç gün, ana kas
            gruplarını kapsayan kısa seanslar, kas korunması ve insülin duyarlılığı için yararlı bulunan bir
            müdahale olarak değerlendiriliyor <Evidence level={5} />.
          </p>
          <p>
            Yürüyüşü kenara koymak gerekmez. Düzenli orta tempolu yürüyüş, direnç çalışmasının yanına sağlam
            bir katman ekliyor <Evidence level={4} />. Yalnızca yürüyerek kilo kaybı beklemek bu dönemde
            genellikle karşılığını vermiyor; çünkü yürüyüş yağ yakabilir ama kas kütlesini aynı ölçüde
            korumaz. Küçük ağırlıklarla başlamak, sizin için daha gerçekçi bir kapı olabilir.
          </p>

          <h2 id="hekime-gitme">Hekime Danışma Zamanı</h2>
          <p>
            Kilo değişimlerinin çoğu menopoz başlığına sığar. Bazı tablolar ise gecikmeden değerlendirilmeli.
          </p>
          <p>
            Kısa sürede, beklenmedik biçimde alınan ya da kaybedilen kilo hekimle konuşma zamanı olabilir.
            Sürekli halsizlik de öyle; kilo artışına saç dökülmesi, cilt kuruluğu ya da soğuğa
            tahammülsüzlük eşlik ediyorsa da aynısı geçerli. Çarpıntı ve iştah artışıyla birlikte gelen kilo kaybı da bu gruba girer
            <Evidence level={5} />. Bu işaretler tiroid işlev
            değişiklikleri, insülin direnci ya da başka metabolik tablolarla ilişkili olabilir.
          </p>
          <p>
            Ailede tip 2 diyabet, tiroid hastalığı ya da metabolik sendrom öyküsü varsa, sizin için erken bir
            hekim değerlendirmesi anlamlı olabilir. Açlık kan şekeri, tiroid fonksiyonları, lipid profili ve D
            vitamini gibi temel tahliller tabloyu netleştirmede yardımcı olur.
          </p>

          <h2 id="sik-sorulanlar">Sıkça Sorulanlar</h2>
          <h3>Kilo artışı yalnızca daha az hareket etmekten mi olur?</h3>
          <p>
            Hayır. Yaş, uyku, stres, kas kütlesi, yağın nereye yerleştiği ve hormonal değişim birlikte etkili
            oluyor. Düzenli hareket eden kadınlarda da aynı tablo görülebilir. Bu yüzden tabloyu yalnızca
            hareketsizliğe bağlamak eksik bir okuma olur.
          </p>
          <h3>Tartı aynı kalırken bedende değişim olması mümkün mü?</h3>
          <p>
            Evet, bu dönem için tanıdık bir durum. Kas kütlesi azalırken yağ başka bir bölgeye kayabiliyor.
            Sayı sabit kalsa bile kıyafetlerin üzerinizdeki duruşu ve genel his değişebilir.
          </p>
          <h3>Hızlı kilo verme yöntemleri bu dönemde işe yarar mı?</h3>
          <p>
            Çoğunlukla kalıcı bir sonuç sunmuyor. Belirgin kısıtlama kısa vadede tartıyı hareket ettirse de
            kas kaybını hızlandırabiliyor ve kilo genellikle geri geliyor <Evidence level={4} />. Yavaş ama
            sürdürülebilir bir denge daha kalıcı olabiliyor.
          </p>
          <h3>Protein miktarı nasıl belirlenmeli?</h3>
          <p>
            Genel bir formül herkese uymuyor. Araştırmalarda sık geçen yaklaşım protein alımını artırmayı
            işaret ediyor; kesin miktar yaş, aktivite düzeyi ve genel sağlık durumuna göre hekim veya
            diyetisyenle birlikte değerlendirilmesi gereken bir aralıktır <Evidence level={4} />.
          </p>
          <h3>Bel çevresi ölçümü neden tartıdan daha bilgilendirici kabul ediliyor?</h3>
          <p>
            Tartı toplam kütleyi gösterir, yerleşimi göstermez. Bel çevresi, visseral yağ artışına dair daha
            doğrudan bir sinyal taşıdığı için kilo değerinden bağımsız bir risk göstergesi olarak
            değerlendiriliyor <Evidence level={4} />.
          </p>
        </ArticleProsePanel>

      <RelatedReadings
          class="mt-14"
          paths={[
            '/zamansiz-yasam/beslenme-yaslanma/',
            '/zamansiz-yasam/kemik-gucu-kirigi-beklemeden-sorulacak-sorular/',
            '/bilimsel-pencere/hormonlarin-bilimi/estrogen-biyolojisi-saglik/',
          ]}
        />

        <ArticleEditorNote>
          <p>
            Menopozla ilişkili kilo değişimi tek bir mekanizmaya bağlanamaz; yağın visseral alana kayması,
            kas kütlesindeki azalma ve uyku-stres ekseni birlikte değerlendirilir. Belirgin kalori kısıtlaması
            yerine protein temelli tabak yapısı, düzenli direnç çalışması ve uykunun korunması daha
            sürdürülebilir bir yol sunar. Hızlı ve açıklanamayan kilo değişimleri ya da eşlik eden sistemik belirtiler
            varsa plan hekim değerlendirmesiyle şekillendirilmelidir.
          </p>
        </ArticleEditorNote>

         <ArticleDisclaimer>
<p>
            Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavinin yerini almaz.
            Sağlık kararlarınız için kendi hekiminizle birlikte değerlendirme yapınız.
          </p>
      </ArticleDisclaimer>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
