---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuHero from '../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../components/site/ArticleProsePanel.astro';
import { submenuHeroByRoute } from '../../data/submenu-heroes';
import Evidence from '../../components/site/Evidence.astro';
import RelatedReadings from '../../components/site/RelatedReadings.astro';
import { buildArticleSchemas } from '../../utils/article-schema';
import { resolveSiteUrl } from '../../utils/seo';

const hero = submenuHeroByRoute['/zamansiz-yasam/hareket-saglik-menopoz']!;

const tocEntries = [
  { id: 'hareketin-etkileri', label: 'Hareketin Etkileri' },
  { id: 'hareket-turleri', label: 'Hareket Türleri' },
  { id: 'baslama-rehberi', label: 'Başlama Rehberi' },
  { id: 'yas-spesifik', label: 'Yaş Spesifik Hususlar' },
  { id: 'guvenlik', label: 'Güvenlik ve Prevansiyon' },
  { id: 'motivasyon', label: 'Motivasyon ve Tutarlılık' },
  { id: 'profesyonel-rehberlik', label: 'Profesyonel Rehberlik' },
  { id: 'ilk-adimlar', label: 'İlk Adımlar' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Hareket ve Sağlık — Menopozda Egzersiz Rehberi';
const articleDescription = 'Menopozda hareketin belirtileri hafifletme, kemik sağlığını koruma ve kardiyovasküler sağlığı destekleme yolları.';
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'alara-baykent',
  publishedDate: '5 Mart 2026',
  pathname: '/zamansiz-yasam/hareket-saglik-menopoz',
  articleSection: 'Zamansız Yaşam',
  sectionPath: '/zamansiz-yasam',
  keywords: ['menopoz', 'hareket', 'egzersiz', 'direnç antrenmanı', 'kardiyovasküler', 'kemik sağlığı'],
  siteUrl,
});
---

<SiteLayout
  title={`${articleTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/zamansiz-yasam" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Hareket"
      title="Hareket ve Sağlık — Menopozda Egzersiz Rehberi"
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <SubmenuArticleBody>
        <ArticleTOC slot="toc" entries={tocEntries} />
        <ArticleAuthorBlock authorSlug="alara-baykent" publishedDate="5 Mart 2026" readingMinutes={4} />

        <section class="rounded-[28px] border border-gold/35 bg-gradient-to-br from-white to-cream-soft/90 p-7 shadow-sm ring-1 ring-gold/22 md:p-8">
          <h2 class="mb-4 font-serif text-3xl">Kısa Özet</h2>
          <p class="leading-relaxed text-ink/80">
            Düzenli hareket menopoz belirtilerini hafifletmeye, kemik sağlığını korumaya ve kalp damar sağlığını
            desteklemeye yardımcı olabilir. Aerobik, direnç ve esneklik çalışmalarının dengeli bir kombinasyonu
            iyi sonuç verir; ama burada büyük plan değil, sürdürülebilir küçük adımlar konuşacağız. Yaşın ve
            başlangıç noktan ne olursa olsun, bugün küçük bir hareket başlatmak mümkün.
          </p>
        </section>

        <ArticleProsePanel>
          <h2 id="hareketin-etkileri">Hareketin Menopoza Etkileri</h2>
          <p>
            40 sonrasında hareket etmek isteyen birçoğumuz, eski programların artık aynı etkiyi vermediğinden
            yakınır. Oysa bu durum direnç ya da yaş değil; bedenin değişen kimyasıyla ilgili ve doğru okumayı
            beklemekte.
          </p>
          <p>
            Düzenli egzersiz, sıcak basması ve gece terlemesi gibi vazomotor belirtilerin şiddetini hafifletebiliyor
            <Evidence level={5} />. Çoğu zaman bunu "antrenmanın bedeni soğuttuğu" basit denklemiyle düşünürüz; oysa
            arka planda termoregülasyon (vücut ısısının düzenlenmesi) yolaklarının yeniden eğitilmesi, otonom sinir sisteminin (kalp atışı, terleme gibi istemsiz tepkilerin yönetildiği sistem) dengelenmesi ve
            stres tepki sisteminin sıfırlanması gibi katmanlı bir resim var. Tek bir seans değil; düzenli olmanın
            biriken etkisi.
          </p>
          <p>
            Ruh hali ve uyku tarafındaki etki de belirgin <Evidence level={5} />. Aerobik hareket sırasında üretilen
            BDNF (beyin kökenli nörotrofik faktör), nöronlar arası bağlantıları besleyen bir tür "bahçıvan" gibi
            çalışıyor; düzenli hareket uyku mimarisini destekleyerek gece uyanmalarını azaltabiliyor. Kemik tarafına
            gelince — birçoğumuz yürüyüşü "kalp için" diye tanımlar; oysa kemik dokusu da yer çekimine karşı yapılan
            her adımı bir uyaran olarak okuyor. Yük taşıyan egzersizlerin ve direnç çalışmasının kemik kaybını
            yavaşlatmadaki rolü sağlam kanıta dayanıyor <Evidence level={5} />.
          </p>
          <p>
            Kalp damar tarafında menopoz sonrasında risk profili değişir <Evidence level={5} />. Çoğu zaman "yaşla
            beraber gelen kaçınılmaz bir tablo" olarak okunur; oysa düzenli aerobik hareket kan basıncını yumuşatabilir,
            kan şekeri kontrolüne katkı sağlayabilir, lipid profilini olumlu etkileyebilir. Metabolik sağlık ve kilo
            dengesi de aynı tablonun parçası <Evidence level={5} />.
          </p>

          <h2 id="hareket-turleri">Hareket Türleri ve Faydaları</h2>
          <p>
            Çoğumuz "egzersiz" deyince tek bir şey hayal ederiz: ya yürüyüş, ya pilates, ya da spor salonu. Oysa
            beden tek bir uyarıyla beslenmiyor; üç farklı dilde "anlat" diyor — aerobik, direnç ve esneklik.
            Her biri farklı bir yerden konuşuyor.
          </p>
          <p>
            Aerobik hareket (yürüyüş, hafif koşu, bisiklet, yüzme) için yaygın çerçeve haftada toplam 150 dakika
            orta yoğunluktur <Evidence level={5} />. Bunu günlük 20-25 dakikaya bölersen programına oturuyor. Yoğunluk
            için sade bir ölçü var: konuşabiliyor ama şarkı söyleyemiyorsan, o aralıktasın. Kendi nefesin pusula
            işlevi görüyor.
          </p>
          <p>
            Direnç çalışması (ağırlık, lastik bant, kendi vücut ağırlığı) haftada 2-3 gün, ana kas gruplarını
            kapsayacak şekilde planlandığında kas kütlesini ve kemik yoğunluğunu desteklemeye yardımcı olabilir
            <Evidence level={5} />. Çoğu zaman direnç çalışmasını "vücut geliştirme" zannederiz; oysa burada amaç
            kas büyütmek değil, sarkopeni denen sessiz erimeyi yavaşlatmak. 30 yaşından sonra her on yılda kas
            kütlesinin yaklaşık %3-8 erimesi yaygın bir bulgu <Evidence level={4} />; menopozla bu eğri biraz daha
            dikleşiyor. Küçük dambıllarla, lastik bantla başlamak fazlasıyla yeterli.
          </p>
          <p>
            Esneklik çalışması (yoga, pilates, açma-germe) haftada 2-3 gün, kısa seanslarla bile mobiliteyi ve
            yaralanmadan korunmaya yardımcı olabilir <Evidence level={5} />. Denge çalışmaları (tek ayak duruşu, yavaş
            geçişler) özellikle 50 sonrasında düşme riskini belirgin ölçüde azaltabiliyor <Evidence level={5} />.
            Düşme — yaşlandıkça en sık karşılaşılan ortopedik kırılma nedeni — birçoğumuz için "yaşa bağlı kaza"
            gibi okunur; oysa proprioseptif sistem (bedenin kendisini boşlukta yerlendirme yetisi) çalıştırıldıkça
            keskinleşiyor. Bu üç katman birbirinin yerini tutmuyor; birbirini tamamlıyor.
          </p>

          <h2 id="baslama-rehberi">Başlama Rehberi — Kendi Hızında</h2>
          <p>
            Hareket etmeyen biri için en doğru başlangıç hızı kendi hızıdır. "Önce küçük başla, sonra sıklığı
            koru" kuralı bütün spor hayatımdaki en sağlam tavsiye oldu.
          </p>
          <p>
            Hareketsiz bir başlangıç noktasındaysan haftada üç gün, 20-30 dakikalık yürüyüş hem güvenli hem
            sürdürülebilir bir başlangıç olabilir. Hafif tempoda başlamak bedenin uyum süreci için iyi geliyor
            <Evidence level={5} />. Haftalık artışı yaklaşık yüzde 10'la sınırlamak yaralanma riskini düşürür.
            Orta düzeyde aktif olan biri için haftada 3-4 gün karışık plan (aerobik + direnç) güzel bir denge.
          </p>
          <p>
            Zaten aktif birinin yapabileceği akıllı bir adım çeşitlendirmek: aynı yürüyüşü her gün yapmak yerine bir
            gün yüzme, bir gün hafif direnç, bir gün esneklik. Bütün seviyelerde altta duran tek kelime
            <em>tutarlılık</em>: haftada bir kez iki saat yorulmaktansa, haftada beş gün yarım saat hafifçe
            hareket etmek bedene daha sade bir mesaj veriyor.
          </p>

          <h2 id="yas-spesifik">Yaş Aralığına Göre Notlar</h2>
          <p>
            Annemi izleyerek fark ettim ki menopoz dönemine ne durumda girildiği, sonraki yıllarda çok şeyi
            belirliyor. Her yaş için odak biraz farklı.
          </p>
          <p>
            40-50 yaş aralığında perimenopoz döneminde kemik sağlığı sessiz bir önceliktir <Evidence level={5} />.
            Bu yıllarda yük taşıyan egzersize başlamak, ileri yaşlardaki kemik kaybını hafifletmeye yardımcı
            olabiliyor. 50 sonrasında denge ve gündelik fonksiyonel hareket (merdiven, çantayı taşıma, yerden
            kalkma) sahnenin önüne geçiyor <Evidence level={5} />.
          </p>
          <p>
            Mevcut sağlık başlıkları (eklem ağrısı, hipertansiyon, diyabet) hareket planının çerçevesini etkiler
            <Evidence level={5} />. Kronik hastalığı olanlar için başlangıç öncesinde hekimle kısa bir konuşma
            iyi bir refleks; çoğu durumda uygun egzersizin kendisi tedavinin bir parçası gibi davranabiliyor.
          </p>

          <h2 id="guvenlik">Güvenlik ve Yaralanmadan Korunma</h2>
          <p>
            Spor hayatımda öğrendiğim ikinci sağlam kural: ısınma ve soğuma "atlanır" değil "yapılır". Beş-on
            dakikalık hafif bir başlangıç ve sonunda nazik bir geçiş çoğu yaralanmanın önüne geçer
            <Evidence level={5} />.
          </p>
          <p>
            Doğru form, ağırlıktan önce gelir. İlk kez başlıyorsan bir antrenör veya fizyoterapistten kısa bir
            başlangıç desteği almak yıllarca işe yarayan bir yatırım <Evidence level={5} />. Aşamalı artış
            (bir hafta aynı yoğunluk, sonra küçük bir kademe) bedeni dinleme yoludur, dayatma değil.
          </p>
          <p>
            Eklem veya kasta keskin ağrı, şiddetli nefes darlığı, göğüs rahatsızlığı — hareketi durdurma işaretleri
            <Evidence level={5} />. Hafif yorgunluk doğal bir karşılık; bitkinlik, ağrı ve baş dönmesi değil.
            "Bedenim ne diyor" sorusu, bu dönemin en sade rehberi.
          </p>

          <h2 id="motivasyon">Motivasyon ve Tutarlılık</h2>
          <p>
            Tutarlılığın sırrı disiplin değil — hatırlatıcılar ve sevdiğin şeyler. Köpeğimi yürüttüğüm sabahlar
            bana bunu çok kez gösterdi: bedenim "egzersiz yapacağım" demeyince hareketi unutuyor; bir başkasıyla
            buluşunca otomatikleşiyor.
          </p>
          <p>
            Sosyal destek hareketin sürekliliğine katkı sağlıyor <Evidence level={4} />. Bir arkadaş, küçük bir
            grup veya aile üyesiyle birlikte hareket etmek "yapacak mıyım" sorusunu kendiliğinden cevaplıyor.
            Net ve ölçülebilir hedefler (haftada beş gün, otuzar dakika), muğlak amaçlardan daha çok takip
            edilebiliyor <Evidence level={5} />. Çeşitlilik (farklı günde farklı hareket) tek tipliğin yarattığı
            yorgunluğu kırıyor <Evidence level={4} />.
          </p>
          <p>
            Rutine bağlamak işin en sevdiğim tarafı: sabah yürüyüş, öğleden sonra hafif esneklik gibi sabit
            saatler bedenin kendi takvimini öğrenmesine yardımcı oluyor. İlk üç-dört hafta zorlanmak doğal;
            bu süre dolduğunda hareket "yapılacak iş" olmaktan çıkıp gündelik bir alışkanlığa dönüşüyor.
          </p>

          <h2 id="profesyonel-rehberlik">Bir Uzmanla Konuşmak Ne Zaman Anlamlı?</h2>
          <p>
            Sıfırdan başlıyorsan, doğru form ve sana uygun bir başlangıç planı kurmak için bir fizyoterapist
            veya antrenörle bir-iki seans çok şey kazandırıyor <Evidence level={4} />. Bu, "antrenmanı al"
            dayatması değil; ilk haftaların güvenli ve sürdürülebilir olmasının pratik yolu.
          </p>
          <p>
            Yaralanma geçmişin varsa, kronik bir hastalıkla yaşıyorsan ya da kemik veya kalp sağlığı gibi
            belirli bir hedef üzerinde çalışıyorsan profesyonel rehberlik daha da değerli oluyor
            <Evidence level={5} />. Sağlık durumun değişirse (yeni bir tanı, operasyon, uzun bir ara) hareket
            planını güncellemek bedene saygının bir biçimi.
          </p>

          <h2 id="ilk-adimlar">Başlamak İçin İlk Adımlar</h2>
          <p>
            Çoğu zaman "harekete başlamak için doğru zaman geçti" diye düşünürüz. Oysa bu bedenin değil, zihnin
            kurduğu bir cümle. 60 sonrasında düzenli hareketle belirgin iyileşmeler gözlemlenmiş — kas, denge,
            uyku ve ruh hali tablosu hâlâ esneyebiliyor.
          </p>
          <p>
            Bu hafta için sade bir teklif: bir aktivite seç (yürüyüş, yüzme, pilates, yoga), yirmi dakikayla başla,
            üç gün dene. Bedenini dinle, performansı değil sürekliliği kovala. Birkaç hafta içinde "şu zaman
            yürüyüş zamanı" duygusu kendiliğinden geliyor; gerisi onun üzerine kurulan küçük bir mimari. Önce
            küçük başla, sonra sıklığı koru — gerisi zamanın işi.
          </p>
        </ArticleProsePanel>

        <RelatedReadings
          class="mt-14"
          paths={[
            '/zamansiz-yasam/kilo-artisi-menopoz',
            '/zamansiz-yasam/eklem-agrisi-menopoz',
            '/zamansiz-yasam/beslenme-yaslanma',
            '/zamansiz-yasam/kemik-sagligi-40-sonrasi',
            '/zihin-denge/uyku-dinlenme/uyku-bozuklugu-menopoz',
            '/zihin-denge/duygusal-denge/stres-yonetimi-menopoz',
          ]}
        />

        <section class="mt-14 rounded-[28px] border border-burgundy/15 border-l-[6px] border-l-gold bg-gradient-to-r from-cream-warm to-cream-soft p-7 shadow-sm ring-1 ring-burgundy/10 md:p-8">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.22em] text-burgundy">Bilimsel Editör Notu</p>
          <p class="leading-relaxed text-ink/80">
            Düzenli hareket, menopoz belirtilerini yönetmenin ve uzun vadeli sağlığı korumanın kanıta dayanan
            araçlarından biridir. Doğru form, uygun başlangıç hızı ve tutarlılık sağlandığında çoğu kadında etkisi
            belirgin biçimde ortaya çıkar. Plan kişisel sağlık durumuna ve hareket geçmişine göre hekim veya
            uzman tarafından uyarlandığında en sürdürülebilir sonucu verir.
          </p>
        </section>

        <section class="mt-10 rounded-[24px] border border-dashed border-burgundy/25 bg-white/95 p-6 ring-1 ring-burgundy/10">
          <p class="text-sm leading-relaxed text-ink/75">
            Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavinin yerini almaz. Sağlık kararlarınız için
            kendi hekiminizle birlikte değerlendirme yapınız.
          </p>
        </section>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
