---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import SaveForLaterButton from '../../../components/site/SaveForLaterButton.astro';
import ReadingControls from '../../../components/site/ReadingControls.astro';
import RedFlagBox from '../../../components/site/RedFlagBox.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../../components/site/ArticleFAQ.astro';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { articleFaqs } from '../../../data/article-faqs';
import { resolveSiteUrl } from '../../../utils/seo';

const faqItems = articleFaqs['/zamansiz-yasam/deneysel/resveratrol-takviyesi/'] ?? [];

const hero = submenuHeroByRoute['/zamansiz-yasam/deneysel/']!;

const tocEntries = [
  { id: 'kadeh', label: 'Bir Kadeh Şaraptan Kapsüle' },
  { id: 'kanit-merdiveni', label: 'Kanıt Merdiveninde Resveratrol' },
  { id: 'yolculuk', label: 'Yutulan Resveratrolün Yolculuğu' },
  { id: 'menopoz', label: 'Menopoz Sonrası Kadınlarda Ne Bulundu?' },
  { id: 'bes-eksen', label: 'Beş Eksende Resveratrol' },
  { id: 'iddialar', label: 'Raftaki Vaatler, Çalışmadaki Sonuçlar' },
  { id: 'guvenlik', label: 'Doz Büyüdükçe Büyüyen Güvenlik Soruları' },
  { id: 'turkiye', label: 'Türkiye’de Raf Sınırı' },
  { id: 'bilinmeyenler', label: 'Açık Sorular ve Süren Çalışmalar' },
  { id: 'denemek', label: 'Denemeyi Düşünüyorsanız' },
  { id: 'kaynaklar', label: 'Kaynaklar', numbered: false },
  { id: 'sik-sorulanlar', label: 'Dr. Aksoy’a Sorular', numbered: false },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Resveratrol — Şarap Kadehinden Takviye Kutusuna Ne Kaldı?';
const seoTitle = 'Resveratrol Takviyesi İşe Yarar mı?';
const articleDescription =
  'Resveratrol takviyesinin menopozdaki sınırlı kanıtları, ilaç etkileşimleri ve sentetik trans-resveratrol için Türkiye’deki 150 mg/gün sınırı.';
const articleImage = '/images/library/editorial/resveratrol-takviyesi.webp';
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'senai-aksoy',
  articleType: 'clinical-guide',
  publishedDate: '29 Ekim 2026',
  modifiedDate: '29 Ekim 2026',
  image: articleImage,
  pathname: '/zamansiz-yasam/deneysel/resveratrol-takviyesi/',
  articleSection: 'Zamansız Yaşam',
  sectionPath: '/zamansiz-yasam/',
  keywords: ['resveratrol', 'trans-resveratrol', 'resveratrol takviyesi', 'kırmızı şarap', 'sirtuin', 'SIRT1', 'fitoöstrojen', 'menopoz', 'yaşlanma karşıtı', 'kanıt seviyesi', 'ilaç etkileşimi'],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  image={articleImage}
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/zamansiz-yasam/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Deneysel Yaklaşımlar"
      title={articleTitle}
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="senai-aksoy"
        articleType="clinical-guide"
        publishedDate="29 Ekim 2026"
        lastUpdated="29 Ekim 2026"
        readingMinutes={11}
        medicalReviewer="Dr. Alper Mumcu"
        imageSrc="/images/library/editorial/resveratrol-takviyesi-byline.webp"
        imageAlt="Ege’de bir bağda elinde bir salkım kırmızı üzümle gülümseyen kadın ve yanında gülen arkadaşı"
      />

      <div class="flex flex-wrap items-center justify-end gap-3">
        <ReadingControls />
        <SaveForLaterButton
          slug="/zamansiz-yasam/deneysel/resveratrol-takviyesi/"
          title={articleTitle}
        />
      </div>

      <ArticleSummary title="Kısa Klinik Yanıt">
        <p>
          Resveratrol, üzüm kabuğunda ve bazı bitkilerde bulunan bir polifenol. Menopoz sonrası kadınlarda ağrı ve kemik
          ölçümlerinde bazı olumlu sonuçlar var; ancak bunlar rutin kullanımını destekleyecek kadar sağlam değil. Birleşik
          analizlerde aynı araştırma grubunun farklı yayınları da yer aldığı için kanıtın genişliği dikkatle yorumlanmalı.
          İnsanda yaşam süresini uzattığı gösterilmedi.
        </p>
        <p>
          Asıl dikkat noktası ilaçlar: yüksek dozda bazı ilaçların karaciğerde parçalanmasını değiştirebiliyor. Düzenli ilaç,
          kan sulandırıcı ya da hormon duyarlı kanser öyküsü varsa başlamadan önce hekimle konuşmak gerekir.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="kadeh">Bir Kadeh Şaraptan Kapsüle</h2>
        <p>
          Resveratrolün ünü bir kadehle başladı. Akşam yemeğindeki kırmızı şarabın aynı zamanda bir sağlık alışkanlığı olabileceği
          fikri, kabul edelim, kulağa fazlasıyla hoş geliyordu.
        </p>
        <p>
          Hikâyenin bilimsel tarafı daha sade. Resveratrol, üzüm kabuğunda, yer fıstığında, dut türü meyvelerde ve Japon
          poligonumu adlı bir bitkinin kökünde bulunan bir polifenol. Hücre ve hayvan çalışmalarında iltihabı azaltan, damarları
          koruyan ve sirtuin adı verilen enzimleri uyaran bir madde olarak anlatıldı. Sirtuinler yaşlanma araştırmalarının gözde
          konusu olunca resveratrol de kısa sürede "uzun ömür molekülü" diye anılmaya başladı.
        </p>
        <p>
          Bugün takviye rafında kapsül olarak duruyor. Peki kadehten kapsüle geçince ne kaldı? Bu yazı, o sorunun insan
          çalışmalarındaki karşılığını arıyor.
        </p>

        <h2 id="kanit-merdiveni">Kanıt Merdiveninde Resveratrol</h2>
        <p>
          Resveratrol, merdivenin insan basamaklarına çıkmış uzun yaşam moleküllerinden biri. Ama her basamakta
          bulduğu şey farklı.
        </p>
        <ol>
          <li><strong>Hücrede mekanizma:</strong> Laboratuvarda pek çok yolağı etkiliyor; östrojen reseptörüne de bağlanıyor<sup><a href="#kaynak-16" class="text-primary hover:underline">[16]</a></sup>. Ağızdan alınınca ise kana değişmeden çok az geçiyor<sup><a href="#kaynak-1" class="text-primary hover:underline">[1]</a>, <a href="#kaynak-2" class="text-primary hover:underline">[2]</a></sup>.</li>
          <li><strong>Hayvanda ömür:</strong> Farelerde ilaçları üç merkezde standart koşullarda test eden büyük bir programda, iki farklı dozda verilen resveratrol iki cinsiyette de yaşam süresini uzatmadı<sup><a href="#kaynak-3" class="text-primary hover:underline">[3]</a></sup>.</li>
          <li><strong>İnsanda biyobelirteç:</strong> Kan ve doku ölçümleri, maddenin vücutta ne yaptığını araştırıyor. Bu ara göstergeler klinik yararla aynı şey değil<sup><a href="#kaynak-4" class="text-primary hover:underline">[4]</a>, <a href="#kaynak-5" class="text-primary hover:underline">[5]</a>, <a href="#kaynak-24" class="text-primary hover:underline">[24]</a></sup>.</li>
          <li><strong>İnsanda işlev:</strong> Ağrı, bilişsel testler ve menopoz belirtileri ölçüldü. Çalışmaların sonuçlarını ve birbirinden ne kadar bağımsız olduklarını aşağıda birlikte değerlendiriyoruz<sup><a href="#kaynak-9" class="text-primary hover:underline">[9]</a></sup>.</li>
          <li><strong>İnsanda güvenlik:</strong> Günde 150 mg civarında bir yıl boyunca kullanılan çalışmalar var<sup><a href="#kaynak-6" class="text-primary hover:underline">[6]</a></sup>. Gram düzeyindeki dozlarda mide-bağırsak şikâyetleri ve ilaç etkileşimi soruları öne çıkıyor<sup><a href="#kaynak-12" class="text-primary hover:underline">[12]</a>, <a href="#kaynak-14" class="text-primary hover:underline">[14]</a></sup>.</li>
          <li><strong>Ömür ve hastalık:</strong> Takviye olarak alınan resveratrolün ömre, kalp krizine ya da kansere etkisini ölçen bir çalışmaya rastlamadık. Besinle alınan resveratrolün izlendiği dokuz yıllık bir çalışmada ölümle ilişki bulunmadı<sup><a href="#kaynak-13" class="text-primary hover:underline">[13]</a></sup>.</li>
        </ol>
        <p>
          Kısacası test edildi. Sonuçlar ise reklam metninden çok daha dar.
        </p>

        <h2 id="yolculuk">Yutulan Resveratrolün Yolculuğu</h2>
        <p>
          Resveratrolle ilgili en çok gözden kaçan bilgi şu: kapsülün içindeki madde, kana neredeyse hiç aynı haliyle ulaşmıyor.
        </p>
        <p>
          İşaretli resveratrol kullanılan bir çalışmada, ağızdan alınan dozun en az yüzde 70'i bağırsaktan emildi. Ancak bağırsak
          duvarı ve karaciğer onu hızla başka bileşiklere dönüştürdü; kanda değişmemiş resveratrol yalnızca iz düzeyinde
          ölçülebildi<sup><a href="#kaynak-1" class="text-primary hover:underline">[1]</a></sup>. Aynı araştırmacının derlemesine
          göre ağızdan alınan resveratrolün kana aynı haliyle geçen kısmı yüzde birin çok altında; dozu artırmak bu oranı belirgin
          biçimde değiştirmiyor <Evidence level={3} /><sup><a href="#kaynak-2" class="text-primary hover:underline">[2]</a></sup>.
          Dönüşen bileşiklerin bir kısmının da etkili olabileceği düşünülüyor; bu hâlâ araştırılan bir konu.
        </p>
        <p>
          Sirtuin hikâyesi de insanda henüz net bir yere varmadı. Katılımcıların gruplara rastgele ayrıldığı on bir çalışmayı birleştiren bir analizde resveratrol, kandaki
          ve dokudaki SIRT1 düzeyini genel olarak anlamlı biçimde değiştirmedi; yalnızca 12 haftadan kısa süren çalışmalarda kanda SIRT1 üretimine ilişkin gen etkinliği arttı<sup><a href="#kaynak-4" class="text-primary hover:underline">[4]</a></sup>. Diz kireçlenmesi olan yaşlılarda yapılan bazı küçük çalışmalar kan SIRT1 düzeyinde artış bildirdi<sup><a href="#kaynak-24" class="text-primary hover:underline">[24]</a></sup>.
          Menopoz sonrası kadınlarda kas ve yağ dokusu örneklerine bakılan bir çalışmada da sirtuin ve ilişkili enerji yolaklarında
          değişiklik görülmedi<sup><a href="#kaynak-5" class="text-primary hover:underline">[5]</a></sup>.
        </p>

        <h2 id="menopoz">Menopoz Sonrası Kadınlarda Ne Bulundu?</h2>
        <p>
          Önce şunu söyleyeyim: resveratrol, menopoz sonrası kadınlarda doğrudan test edilmiş uzun yaşam takviyelerinden biri.
          Bu yazının en değerli verisi de burada.
        </p>
        <p>
          Avustralya'da yapılan iki yıllık bir çalışmada, 45 ile 85 yaş arasındaki 125 kadın bir yıl günde iki kez 75 mg resveratrol,
          bir yıl da etkin madde içermeyen karşılaştırma ürünü olan plaseboyu aldı. Genel bilişsel performans resveratrol döneminde daha iyiydi; ancak iki dönem arasındaki fark küçüktü
          <Evidence level={3} /><sup><a href="#kaynak-6" class="text-primary hover:underline">[6]</a></sup>. Aynı çalışmada ağrı
          skorları azaldı; menopozun bedensel belirtileri ve genel iyi oluş da düzeldi<sup><a href="#kaynak-7" class="text-primary hover:underline">[7]</a></sup>.
          Kemik ölçümlerinde bel omurgasında ve uyluk kemiği boynunda kemik yoğunluğu plaseboya göre biraz arttı, kemik yıkımını
          gösteren bir kan belirteci yüzde 7 kadar düştü<sup><a href="#kaynak-8" class="text-primary hover:underline">[8]</a></sup>.
          Alt grup analizinde kemikteki yarar, D vitamini ve kalsiyum kullanan kadınlarda daha belirgindi.
        </p>
        <p>
          Bu sonuçları değerlendirirken yayın sayısı ile bağımsız araştırma sayısını ayırmak gerekiyor.
        </p>
        <p>
          2025 tarihli bir derleme, on yayında toplam 928 katılımcı bildiriyor. Ancak aynı araştırmanın ara sonuçları,
          son sonuçları ve farklı ölçümleri ayrı yayınlar olarak yer alıyor. Bu nedenle toplamı 928 ayrı kadın ya da on
          bağımsız doğrulama gibi okuyamayız. Ağrı sonucu iki yayına dayanıyor; ağrı skorlarından birindeki fark istatistiksel
          anlamlılık sınırına yakın. Kemik yıkımını gösteren CTX adlı kan belirtecinde de düşüş bildirilmiş, fakat bu sonuç
          kırıkların azaldığını göstermiyor <Evidence level={2} /><sup><a href="#kaynak-9" class="text-primary hover:underline">[9]</a>, <a href="#kaynak-25" class="text-primary hover:underline">[25]</a></sup>.
        </p>
        <p>
          Aynı derlemede bilişsel işlev, ruh hali, kan şekeri, kan yağları, tansiyon, uyku, menopoz belirtileri ve yaşam
          kalitesinde anlamlı fark bulunmadı. Örtüşen katılımcı verileri bu sonuçların kesinliğini de sınırlar.
          Farklı yetişkin gruplarını kapsayan 2021 tarihli kemik derlemesinde ise kemik yoğunluğu ve kemik belirteçlerinde
          anlamlı değişiklik görülmedi <Evidence level={2} /><sup><a href="#kaynak-10" class="text-primary hover:underline">[10]</a></sup>.
        </p>
        <p>
          Sağlıklı, kilosu normal ve şeker değerleri yerinde olan menopoz sonrası kadınlarla yapılan 12 haftalık bir çalışma da
          aynı yöne işaret ediyor. Günde 75 mg resveratrol kandaki düzeyi yükseltti; vücut yağı, metabolizma hızı, kan yağları,
          iltihap belirteçleri ve insülin duyarlılığı değişmedi <Evidence level={3} /><sup><a href="#kaynak-5" class="text-primary hover:underline">[5]</a></sup>.
        </p>
        <p>
          Umutla takviyeye başlamış biri için bu tablo hayal kırıklığı yaratabilir. Bugünkü araştırmaların asıl sınırı,
          küçük yarar sinyallerinin bağımsız gruplarda yeterince doğrulanmamış olması. Ağrıdaki farkın günlük yaşamda ne
          kadar hissedildiği ve kemik belirtecindeki değişimin kırıkları önleyip önlemediği açık kalıyor.
        </p>

        <h2 id="bes-eksen">Beş Eksende Resveratrol</h2>
        <p>
          Bir takviyeye tek bir not vermek kararı kolaylaştırmıyor. Aşağıdaki tablo, kararınızı etkileyen beş ayrı soruyu ayrı ayrı
          yanıtlıyor.
        </p>
        <div class="my-8 overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-primary/20 bg-primary/5 text-ink font-serif">
                <th class="p-3 font-semibold">Eksen</th>
                <th class="p-3 font-semibold">Bugünkü yanıt</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-primary/10">
              <tr>
                <td class="p-3 font-medium">Etkinlik kanıtı</td>
                <td class="p-3">Rutin kullanım için yeterli değil. Ayrıntılı sonuçlar yukarıda; yayınların aynı katılımcılardan gelip gelmediği de değerlendirmeyi etkiliyor <Evidence level={2} /><sup><a href="#kaynak-9" class="text-primary hover:underline">[9]</a></sup>.</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Güvenlik kanıtı</td>
                <td class="p-3">Bir yıllık düşük doz kullanım verisi var; daha uzun kullanımın ve seyrek zararların güvenliği kesinleşmiş değil. Yüksek dozda yan etkiler ve ilaç parçalayan enzimlerde değişiklik bildirildi<sup><a href="#kaynak-6" class="text-primary hover:underline">[6]</a>, <a href="#kaynak-12" class="text-primary hover:underline">[12]</a>, <a href="#kaynak-14" class="text-primary hover:underline">[14]</a></sup>.</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Biyolojik olarak mantıklı mı?</td>
                <td class="p-3">Emilim, vücutta dönüşüm ve SIRT1 ölçümleri birlikte değerlendirilmeli. Laboratuvar mekanizması, kapsülün insanda aynı sonucu vereceğini göstermiyor<sup><a href="#kaynak-2" class="text-primary hover:underline">[2]</a>, <a href="#kaynak-4" class="text-primary hover:underline">[4]</a></sup>.</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Ürün ve yasal durum</td>
                <td class="p-3">Türkiye'de takviye edici gıda; sentetik trans-resveratrol için yetişkinde günde en fazla 150 mg. Etikette ilaç kullananların yalnızca tıbbi gözetim altında kullanması gerektiği yazmalı<sup><a href="#kaynak-18" class="text-primary hover:underline">[18]</a></sup>.</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Bırakınca ne olur?</td>
                <td class="p-3">Bırakma sonrasında olası yararın sürüp sürmediği ve yan etkilerin nasıl seyrettiği yeterince bilinmiyor. Maddenin vücuttan atılması, oluşmuş bir sorunun kendiliğinden düzeleceği güvencesini vermez.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2 id="iddialar">Raftaki Vaatler, Çalışmadaki Sonuçlar</h2>
        <p>
          Resveratrolde ilginç bir durum var: iddiaların çoğu gerçekten test edildi. Aşağıdaki tablo, her birinin bugün nerede
          durduğunu kanıt sırasıyla gösteriyor.
        </p>
        <div class="my-8 overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-primary/20 bg-primary/5 text-ink font-serif">
                <th class="p-3 font-semibold">İddia</th>
                <th class="p-3 font-semibold">Ne biliyoruz?</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-primary/10">
              <tr>
                <td class="p-3 font-medium">Eklem ve kas ağrısını azaltır</td>
                <td class="p-3">Menopoz sonrası kadınlarda test edildi, sınırlı biçimde desteklendi <Evidence level={2} />; iki yayının birleşik analizinde ağrı skorlarından birindeki fark sınırda anlamlıydı. Diz kireçlenmesinde düşük dozla yapılan faz 3 çalışmada plasebodan farksızdı; bazı sonraki çalışmalar olumlu sonuç bildirdi<sup><a href="#kaynak-7" class="text-primary hover:underline">[7]</a>, <a href="#kaynak-9" class="text-primary hover:underline">[9]</a>, <a href="#kaynak-23" class="text-primary hover:underline">[23]</a>, <a href="#kaynak-24" class="text-primary hover:underline">[24]</a></sup></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Tansiyonu düşürür</td>
                <td class="p-3">Tip 2 diyabeti olanlarda test edildi, desteklendi <Evidence level={4} />; sağlıklı menopoz sonrası kadınlarda fark bulunmadı<sup><a href="#kaynak-11" class="text-primary hover:underline">[11]</a>, <a href="#kaynak-9" class="text-primary hover:underline">[9]</a></sup></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Kemikleri güçlendirir</td>
                <td class="p-3">Test edildi; iki yıllık araştırmanın 12 aylık resveratrol döneminde kemik yoğunluğu arttı. Farklı yetişkin gruplarını birleştiren analizde artış görülmedi <Evidence level={2} /><sup><a href="#kaynak-8" class="text-primary hover:underline">[8]</a>, <a href="#kaynak-10" class="text-primary hover:underline">[10]</a></sup></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Hafızayı korur, beyni gençleştirir</td>
                <td class="p-3">Test edildi; iki yıllık çalışmada küçük iyileşme, birleşik analizde etki yok. Alzheimer hastalarındaki bir yıllık faz 2 çalışmada birincil sonuçlar belirteçlerdi; bazılarının seyri değişti, beyin hacmi kaybı ise resveratrolde daha fazlaydı<sup><a href="#kaynak-6" class="text-primary hover:underline">[6]</a>, <a href="#kaynak-9" class="text-primary hover:underline">[9]</a>, <a href="#kaynak-12" class="text-primary hover:underline">[12]</a></sup></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Sıcak basmasını ve menopoz belirtilerini hafifletir</td>
                <td class="p-3">İki yıllık çalışmada bedensel menopoz belirtileri düzeldi<sup><a href="#kaynak-7" class="text-primary hover:underline">[7]</a></sup>; birleşik analizde menopoz belirtileri için anlamlı etki bulunmadı<sup><a href="#kaynak-9" class="text-primary hover:underline">[9]</a></sup>. Sıcak basmasını tek başına inceleyen bir analiz bulamadık</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Kilo verdirir, kan şekerini düzenler</td>
                <td class="p-3">Farklı yetişkin gruplarını kapsayan şemsiye derlemede bel çevresinde ortalama 0,8 cm azalma bildirildi; bu, menopozdaki kadınlara özgü bir kilo kaybı sonucu değil. Sağlıklı menopoz sonrası kadınlarda insülin duyarlılığı ve metabolizma değişmedi<sup><a href="#kaynak-11" class="text-primary hover:underline">[11]</a>, <a href="#kaynak-5" class="text-primary hover:underline">[5]</a></sup></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">NMN ile birlikte alınınca etkisi artar</td>
                <td class="p-3">Bu birleşimi insanda test eden randomize bir çalışmaya rastlamadık</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Sirtuinleri çalıştırır, ömrü uzatır</td>
                <td class="p-3">İnsanda sirtuin düzeyi birleşik analizde değişmedi<sup><a href="#kaynak-4" class="text-primary hover:underline">[4]</a></sup>; üç merkezli fare programında ömür uzamadı<sup><a href="#kaynak-3" class="text-primary hover:underline">[3]</a></sup>. İnsanda yaşam süresini uzattığı gösterilmedi</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          Muayene odasında en sık duyduğum soru, kırmızı şarapla kapsül arasındaki bağ üzerine. Yanıtım iki parçalı. Besinle alınan
          resveratrolün izlendiği bir İtalyan çalışmasında, idrardaki resveratrol düzeyi dokuz yıl boyunca ölüm, kalp hastalığı ve
          kanserle ilişkili bulunmadı<sup><a href="#kaynak-13" class="text-primary hover:underline">[13]</a></sup>. Kapsülün sağladığı
          miktar ise şaraptan çok daha yüksek ve o miktarın uzun dönemde ne yaptığını da tam bilmiyoruz. Yani ne kadehin sağlık
          gerekçesi var, ne de kapsül kadehin "güçlendirilmiş" hali.
        </p>

        <h2 id="guvenlik">Doz Büyüdükçe Büyüyen Güvenlik Soruları</h2>
        <p>
          Düşük dozda resveratrol genellikle iyi tolere ediliyor. Güvenlik soruları, doz gram düzeyine çıktığında ve başka ilaçlarla
          birlikte kullanıldığında belirginleşiyor.
        </p>
        <p>
          Alzheimer hastalarında yapılan bir yıllık çalışmada doz kademeli olarak günde 2 grama kadar çıkarıldı. En sık yan
          etkiler bulantı, ishal ve kilo kaybıydı<sup><a href="#kaynak-12" class="text-primary hover:underline">[12]</a></sup>. Beyin hacmi kaybı resveratrol grubunda plasebodan fazlaydı; yazarlar bu belirteç değişikliklerinin yorumlanması için ek çalışma gerektiğini bildirdi.
          Bu dozun, Türkiye'de sentetik trans-resveratrol için izin verilen günlük 150 mg sınırının on katından fazla olduğunu hatırlatayım.
        </p>
        <p>
          İlaç etkileşimi daha önemli konu. Sağlıklı gönüllülerde dört hafta günde 1 gram resveratrol, karaciğerde ilaçları
          parçalayan enzimlerden üçünü (CYP3A4, CYP2D6, CYP2C9) baskıladı, birini (CYP1A2) uyardı <Evidence level={2} /><sup><a href="#kaynak-14" class="text-primary hover:underline">[14]</a></sup>.
          Bu enzimler; bazı kan sulandırıcıları, tansiyon ve kolesterol ilaçlarını, antidepresanları ve pek çok başka ilacı
          parçalıyor. Yazarlar, bu dozun ilaç etkilerini değiştirebileceği ve yan etkileri artırabileceği uyarısında bulundu.
          Düşük dozda etkinin ne kadar olduğu ayrıca çalışılmadı.
        </p>
        <p>
          Kan sulandırıcı kullananlar için ayrı bir soru var. Laboratuvar çalışmalarında resveratrolün trombositlerin kümelenmesini
          azalttığı bildirildi<sup><a href="#kaynak-22" class="text-primary hover:underline">[22]</a></sup>. Bunun kan sulandırıcı ilaçlarla birlikte kanama riskini artırıp artırmadığını
          insanda gösteren bir çalışmaya rastlamadık; bu yüzden olası bir etkileşim olarak ele almak gerekir.
        </p>
        <p>
          Bir kanser çalışması da ihtiyatı anlatıyor. Tekrarlayan multipl miyelom (bir kemik iliği kanseri) hastalarında, çok yüksek
          doz resveratrolün bir kemoterapi ilacıyla birlikte verildiği faz 2 çalışma, böbrek sorunları nedeniyle erken
          sonlandırıldı<sup><a href="#kaynak-15" class="text-primary hover:underline">[15]</a></sup>. Bu sonuç sağlıklı bir kadının
          düşük doz takviyesine doğrudan aktarılamaz; ama "doğal" bir maddenin yüksek dozda ilaç gibi davranabileceğini gösteriyor.
        </p>
        <p>
          Bir de östrojen boyutu var. Resveratrol laboratuvarda östrojen reseptörüne bağlanıyor ve östrojene duyarlı meme kanseri
          hücrelerinin çoğalmasını uyarabiliyor<sup><a href="#kaynak-16" class="text-primary hover:underline">[16]</a></sup>. İnsanda
          bunun bir kanser riski yarattığına dair veri yok; ama olmadığını gösteren veri de yok. Hormon duyarlı meme kanseri öyküsü
          olan bir kadında resveratrolü önermem; onkoloğuyla konuşmadan başlamamasını isterim. Koroner kalp hastalığı olan
          menopoz sonrası 20 kadında 90 gün yüksek doz resveratrol, damar onarımına katılan bir hücre grubunu azalttı; yazarlar bu
          grupta sonuçların dikkatle yorumlanması gerektiğini belirtti<sup><a href="#kaynak-17" class="text-primary hover:underline">[17]</a></sup>.
        </p>
        <p>
          Takviye kullananların kendi bildirimleri kanıt yerine geçmez, ama iki ayrı sinyal taşır.
          Fayda bildirimlerine temkinli bakmak gerekir; "kendimi daha enerjik hissediyorum" duygusu plasebodan, mevsimden ya
          da aynı dönemde değişen alışkanlıklardan etkilenir. Yan etki bildirimleri ise tekrarlıyorsa ciddiye alınması gereken
          sinyallerdir.
        </p>

        <RedFlagBox
          intro="Aşağıdaki durumlarda resveratrol kullanımını başlamadan önce ya da kullanırken hekiminizle konuşmanız gerekir."
          markers={[
