---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import SaveForLaterButton from '../../../components/site/SaveForLaterButton.astro';
import ReadingControls from '../../../components/site/ReadingControls.astro';
import RedFlagBox from '../../../components/site/RedFlagBox.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../../components/site/ArticleFAQ.astro';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { articleFaqs } from '../../../data/article-faqs';
import { resolveSiteUrl } from '../../../utils/seo';

const hero = submenuHeroByRoute['/zamansiz-yasam/deneysel/']!;

const tocEntries = [
  { id: 'isim-koymak', label: 'Reklam Vaadi ile Bilim Arası — Önce İsim Koymak' },
  { id: 'kanit-merdiveni', label: 'Kanıt Merdiveninde NAD+ Öncülleri' },
  { id: 'mekanizma-dusus', label: 'NAD+ Hücre Mekanizması ve Yaşla Düşüş' },
  { id: 'kanit-durumu', label: 'İnsan Çalışmalarının Bugünkü Durumu' },
  { id: 'bes-soru', label: 'Beş Soruda NAD+ Öncülleri' },
  { id: 'iddialar', label: 'İnternette Dolaşan İddialar' },
  { id: 'urun-serum', label: 'Ürün, Doz Sınırı ve Damardan Uygulama' },
  { id: 'fayda-guvenlik', label: 'Güvenlik Sınırları ve Sık Bildirilen Şikâyetler' },
  { id: 'menopoz', label: 'Menopoz ve 40 Sonrası İçin Ne Biliyoruz?' },
  { id: 'bilinmeyenler', label: 'Henüz Bilmediklerimiz' },
  { id: 'iletisim-sureci', label: 'Takviyeyi Düşünürken Hekimle Konuşmak' },
  { id: 'kaynaklar', label: 'Kaynaklar', numbered: false },
  { id: 'sik-sorulanlar', label: "Dr. Aksoy'a Sorular", numbered: false },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'NAD+ Takviyesi — Umut Etiketi ve Kanıt Sınırı';
const articleDescription =
  'NMN ve NR kandaki NAD+ düzeyini yükseltiyor; peki sağlığa yansıyor mu? Kanıtın nerede durduğu, internetteki iddialar, damardan NAD+ ve Türkiye’deki doz sınırları.';
const faqItems = articleFaqs['/zamansiz-yasam/deneysel/nad-plus-takviyesi/'] ?? [];
const articleImage = '/images/library/editorial/nad-plus-takviyesi.webp';
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'senai-aksoy',
  articleType: 'clinical-guide',
  publishedDate: '2 Mayıs 2026',
  modifiedDate: '26 Ekim 2026',
  image: articleImage,
  pathname: '/zamansiz-yasam/deneysel/nad-plus-takviyesi/',
  articleSection: 'Zamansız Yaşam',
  sectionPath: '/zamansiz-yasam/',
  keywords: ['NAD+', 'NAD Plus', 'NMN', 'NR', 'nikotinamid mononükleotid', 'nikotinamid ribozid', 'NAD serum', 'damardan NAD', 'yaşlanma karşıtı', 'takviye', 'kanıt seviyesi', 'menopoz'],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${articleTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  image={articleImage}
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/zamansiz-yasam/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Deneysel Yaklaşımlar"
      title={articleTitle}
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="senai-aksoy"
        articleType="clinical-guide"
        publishedDate="2 Mayıs 2026"
        lastUpdated="26 Ekim 2026"
        readingMinutes={12}
        medicalReviewer="Dr. Alper Mumcu"
        imageSrc="/images/library/editorial/nad-plus-takviyesi-byline.webp"
        imageAlt="Pencere yanında oturup açık defterini inceleyen olgun kadın"
      />

      <div class="flex flex-wrap items-center justify-end gap-3">
        <ReadingControls />
        <SaveForLaterButton
          slug="/zamansiz-yasam/deneysel/nad-plus-takviyesi/"
          title={articleTitle}
        />
      </div>

      <ArticleSummary title="Kısa Klinik Yanıt">
        <p>
          NAD+, hücrenin enerji üretiminde görev alan bir koenzim; NMN ve NR ise vücudun NAD+ üretmek için kullandığı öncüllerdir.
          Ağızdan alınan NMN ve NR, kandaki NAD+ düzeyini güvenilir biçimde yükseltiyor. Bu artışın kas gücüne, bilişsel işleve veya
          yaşam süresine yansıdığı gösterilemedi; şeker metabolizmasında ve tansiyonda yalnızca zayıf sinyaller var.
        </p>
        <p>
          Bir yıl süren ve 410 kişinin katıldığı bir NR çalışmasında, Parkinson hastalarında yarar görülmedi. Kısa dönemde iyi tolere
          ediliyorlar; yıllarca kullanımın sonuçlarını bilmiyoruz. Gebelik, emzirme, kanser tedavisi veya düzenli ilaç kullanımı varsa
          başlamadan önce hekimle konuşmak gerekir.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="isim-koymak">Reklam Vaadi ile Bilim Arası — Önce İsim Koymak</h2>
        <p>
          NMN ve NR gibi NAD+ öncülleri, yaşlanma karşıtı takviyeler arasında yoğun biçimde pazarlanıyor.
          Reklamlarda enerji, gençlik ve uzun ömür birlikte anılıyor; insan çalışmaları ise çok daha dar sorulara yanıt veriyor.
        </p>
        <p>
          NMN, nikotinamid mononükleotid; NR ise nikotinamid ribozid adının kısaltması. İkisi de vücudun NAD+ üretirken
          kullandığı yapı taşları. Takviyeden beklediğiniz yararı anlamak içinse hücredeki görevlerinden çok, insan
          çalışmalarında ölçülen sonuçlara bakmak gerekiyor.
        </p>

        <h2 id="kanit-merdiveni">Kanıt Merdiveninde NAD+ Öncülleri Nerede Duruyor?</h2>
        <p>
          NAD+ öncülleri merdivenin üçüncü basamağında güçlü kanıta sahip; dördüncü basamakta ise olumlu bulgu az, sonuçların çoğu
          nötr. Yani kandaki düzeyi yükseltiyorlar, ama bunun sağlığa yansıdığı henüz gösterilemedi.
        </p>
        <p>
          Bir takviyenin "işe yarayıp yaramadığı" tek bir soru değil. Kanıt, basamak basamak ilerleyen bir merdivene benziyor:
        </p>
        <ol>
          <li><strong>Hücrede mekanizma:</strong> NAD+ hücrenin enerji üretiminde ve onarımında görev alıyor. Bu iyi biliniyor<sup><a href="#kaynak-1" class="text-primary hover:underline">[1]</a></sup>.</li>
          <li><strong>Hayvanda ömür:</strong> Farelerde ilaçları standart koşullarda test eden büyük bir programda NR, iki cinsiyette de yaşam süresini uzatmadı<sup><a href="#kaynak-2" class="text-primary hover:underline">[2]</a></sup>.</li>
          <li><strong>İnsanda kan değeri:</strong> NMN ve NR, kandaki NAD+ düzeyini tutarlı biçimde yükseltiyor; ikisini doğrudan karşılaştıran bir çalışmada artış benzer bulundu <Evidence level={4} /><sup><a href="#kaynak-3" class="text-primary hover:underline">[3]</a>, <a href="#kaynak-18" class="text-primary hover:underline">[18]</a></sup>.</li>
          <li><strong>İnsanda işlev:</strong> Kas gücü, şeker ve yağ metabolizması, bilişsel işlev gibi ölçülebilir sonuçlarda bulgular çoğunlukla nötr<sup><a href="#kaynak-3" class="text-primary hover:underline">[3]</a></sup>.</li>
          <li><strong>İnsanda güvenlik:</strong> Haftalar ile bir yıl arasında süren çalışmalarda ciddi yan etkiler plaseboya göre artmadı<sup><a href="#kaynak-10" class="text-primary hover:underline">[10]</a>, <a href="#kaynak-9" class="text-primary hover:underline">[9]</a></sup>; ancak Parkinson hastalarında bir yıllık NR kullanımı plasebodan daha kötü klinik sonuçlarla ilişkili bulundu. Yıllarca kullanımın sonuçları bilinmiyor.</li>
          <li><strong>Ömür ve hastalık:</strong> İnsanda yaşam süresi, kalp krizi, inme veya demans üzerine veri yok.</li>
        </ol>
        <p>
          İnsan çalışması var; çoğu, kan değerinin ötesinde bir yarar bulamadı.
        </p>

        <h2 id="mekanizma-dusus">NAD+ Hücre Mekanizması ve Yaşla Düşüş</h2>
        <p>
          NAD+ (nikotinamid adenin dinükleotid), hücrenin enerji üretmesine yardım eden bir koenzimdir. Bu görevi iyi biliniyor;
          takviye olarak alınan öncüllerin insana ne kazandırdığı ise ayrı bir soru<sup><a href="#kaynak-1" class="text-primary hover:underline">[1]</a></sup>.
        </p>
        <p>
          NAD+ hemen her hücrede bulunur. Hücrenin enerji üreten yapıları olan mitokondrilerde
          elektron taşınmasına katkıda bulunur. Enerji üretiminin yanında, sirtuinler ve PARP adı verilen enzimlerin yürüttüğü
          hücresel onarım ve DNA hasarına yanıt süreçlerinde tüketilir<sup><a href="#kaynak-1" class="text-primary hover:underline">[1]</a></sup>.
        </p>
        <p>
          Hayvan ve insan dokusu çalışmaları, çeşitli dokulardaki NAD+ düzeylerinin yaşla birlikte azaldığına işaret ediyor<sup><a href="#kaynak-1" class="text-primary hover:underline">[1]</a></sup>.
          Hücresel stres ve iltihabi süreçlerle NAD+ tüketen enzimlerin aktivitesinin artması, bu azalmaya katkıda bulunabilecek mekanizmalar arasında.
          Yaşlanmada NAD+ düşüşünün neden mi yoksa sonuç mu olduğu hâlâ açık bir soru. Bu yüzden "eksikliği yerine koyma" fikri mantıklı
          görünse de yaşlanmayı durdurma vaadi sayılamaz. Mekanizma makul; klinik yarar henüz net değil.
        </p>

        <h2 id="kanit-durumu">İnsan Çalışmalarının Bugünkü Durumu</h2>
        <p>
          Çalışmaların ortak tablosu şu: kandaki NAD+ artıyor, ama ölçülen sağlık sonuçlarının çoğu değişmiyor.
        </p>
        <p>
          Menopoz sonrası dönemdeki, prediyabeti (diyabet öncesi evre) olan ve fazla kilolu ya da obez 25 kadının tamamladığı
          10 haftalık bir çalışmada NMN, kasın insüline yanıtını artırdı <Evidence level={3} /><sup><a href="#kaynak-4" class="text-primary hover:underline">[4]</a></sup>.
          Ancak kas gücünde ve kasın ne kadar çabuk yorulduğunda iyileşme görülmedi. Yani yarar, ölçülen her sonuca yayılmadı.
        </p>
        <p>
          Sonraki yıllarda çalışmalar çoğaldı ve birleştirilerek incelendi. 60 yaş üzerindeki yetişkinlerde NMN ve NR, kas kütlesini
          ve kas işlevini korumada yarar göstermedi <Evidence level={3} /><sup><a href="#kaynak-6" class="text-primary hover:underline">[6]</a></sup>.
          Dokuz çalışmayı birleştiren başka bir analiz ise yürüme hızında küçük bir yarar ve insülin direnci göstergesinde (HOMA-IR)
          düşüş bildirdi<sup><a href="#kaynak-20" class="text-primary hover:underline">[20]</a></sup>; analizlerin sonuçları birbiriyle tutarlı değil.
          Sekiz randomize çalışmayı birleştiren bir analizde NMN; açlık şekeri, insülin, HbA1c ve kan yağları üzerinde anlamlı bir
          değişiklik yaratmadı <Evidence level={3} /><sup><a href="#kaynak-7" class="text-primary hover:underline">[7]</a></sup>.
          Bir başka analiz, 12 çalışmanın beşinde yanlılık riskinin yüksek olduğunu ve alandaki yararların abartılmış olabileceğini
          bildirdi<sup><a href="#kaynak-21" class="text-primary hover:underline">[21]</a></sup>.
          Hafif bilişsel bozukluğu olan yaşlılarda 12 haftalık NR, kandaki NAD+ düzeyini iki katına çıkardı; bilişsel işlevde ise
          iyileşme görülmedi <Evidence level={2} /><sup><a href="#kaynak-8" class="text-primary hover:underline">[8]</a></sup>.
        </p>
        <p>
          Bir yıl süren bir çalışma da var. Erken evre Parkinson hastası 410 kişi, 52 hafta boyunca günde
          1000 mg NR ya da plasebo aldı. NR grubunda hastalık skoru plasebo grubuna göre 2,7 puan daha fazla kötüleşti; motor dışı
          belirtiler de NR ile daha fazla arttı <Evidence level={4} /><sup><a href="#kaynak-9" class="text-primary hover:underline">[9]</a></sup>.
          Yazarlar, NR'nin klinik sonuçları iyileştirmediğini ve plasebodan daha kötü sonuçlarla ilişkili olduğunu bildirdi. Aradaki
          fark (2,7 puan), çalışmanın klinik olarak önemli kabul ettiği kötüleşme eşiğinin (5,2 puan) altında kaldı; yani NR'nin
          hastalığı belirgin biçimde kötüleştirdiği söylenemez, ama yarar da sağlamadı. "Beyni korur" iddiası, büyük bir insan
          çalışmasında desteklenmedi.
        </p>
        <p>
          Bu sonucu zaten NR ya da NMN kullanan bir hastama şöyle anlatırım: Parkinson hastalarındaki sonuç, menopozdaki sağlıklı
          kadınlara doğrudan uygulanamaz; ama bir maddenin düzeyini artırmanın sağlık yararı getireceği anlamına gelmediğini
          hatırlatıyor. Hastayı korkutmak istemem, ancak yeni ve güçlü bir araştırma beklentilerimizi desteklemiyorsa bunu görmezden
          de gelmem. Yalnızca yaşlanmayı geciktirmek için kullanan birine, devam etmesini gerektiren güçlü bir kanıt bulunmadığını
          açıkça söylerim.
        </p>
        <p>
          Mayıs 2026'da yayımlanan bir pilot araştırmada 40 kadın, NR ile pterostilben adlı bir maddenin birleşimini yedi gün kullandı.
          Belirti bildiren 32 kadında sıcak basması, uyku ve şişkinlik açısından iyileşmeler bildirildi <Evidence level={1} /><sup><a href="#kaynak-11" class="text-primary hover:underline">[11]</a></sup>.
          Ancak plasebo grubu yoktu ve katılımcılar ne kullandıklarını biliyordu. Çalışma üretici şirket tarafından finanse edildi;
          bazı yazarlar şirket çalışanıydı. Sonuçlar NR ile pterostilbenin birlikte etkisini yansıtıyor; uzun dönem yarar ve güvenlik ise bu kısa çalışmanın kapsamı dışında.
        </p>

        <h2 id="bes-soru">Beş Soruda NAD+ Öncülleri</h2>
        <p>
          Tek bir kanıt notu bu takviyeleri anlatmaya yetmiyor. Aşağıdaki beş soru, kararı etkileyen farklı yanları ayrı ayrı gösteriyor.
        </p>
        <div class="my-8 overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-primary/20 bg-primary/5 text-ink font-serif">
                <th class="p-3 font-semibold">Soru</th>
                <th class="p-3 font-semibold">Bugünkü yanıt</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-primary/10">
              <tr>
                <td class="p-3 font-medium">Sağlığa yararı gösterildi mi?</td>
                <td class="p-3">Sınırlı. Kan değeri yükseliyor; kas, metabolizma ve bilişsel sonuçlar çoğunlukla değişmiyor<sup><a href="#kaynak-3" class="text-primary hover:underline">[3]</a>, <a href="#kaynak-6" class="text-primary hover:underline">[6]</a>, <a href="#kaynak-7" class="text-primary hover:underline">[7]</a>, <a href="#kaynak-8" class="text-primary hover:underline">[8]</a></sup>.</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Güvenliği ne kadar biliniyor?</td>
                <td class="p-3">Bir yıla kadar orta düzeyde. Daha uzun kullanım, gebelik ve emzirme için veri yok<sup><a href="#kaynak-10" class="text-primary hover:underline">[10]</a>, <a href="#kaynak-9" class="text-primary hover:underline">[9]</a></sup>.</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Biyolojik olarak mantıklı mı?</td>
                <td class="p-3">Orta. NAD+ yaşla azalıyor; ama bu düşüş yaşlanmanın nedeni mi sonucu mu, bilinmiyor<sup><a href="#kaynak-1" class="text-primary hover:underline">[1]</a></sup>.</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Türkiye'de ne kadarı yasal?</td>
                <td class="p-3">Takviyede yasal üst sınır var (NMN günde 50 mg, NR günde 300 mg); NMN çalışmalarında kullanılan miktarın çok altında. Damardan uygulanan NAD+ için ruhsatlı ilaç yok<sup><a href="#kaynak-14" class="text-primary hover:underline">[14]</a>, <a href="#kaynak-15" class="text-primary hover:underline">[15]</a>, <a href="#kaynak-16" class="text-primary hover:underline">[16]</a></sup>.</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Bırakınca ne olur?</td>
                <td class="p-3">Bilmiyoruz. Bırakma sonrasını inceleyen bir çalışmaya rastlamadık.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2 id="iddialar">İnternette Dolaşan İddialar Neyle Karşılaşıyor?</h2>
        <p>
          İddiaların bir kısmı test edilip desteklenmedi, bir kısmı sınırlı olarak test edildi, bir kısmı için kontrollü çalışmaya
          rastlamadık, bir kısmı da bu haliyle test edilemiyor. Bu ayrımı bilmek, reklam metnini okumayı kolaylaştırıyor.
        </p>
        <div class="my-8 overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-primary/20 bg-primary/5 text-ink font-serif">
                <th class="p-3 font-semibold">İddia</th>
                <th class="p-3 font-semibold">Ne biliyoruz?</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-primary/10">
              <tr>
                <td class="p-3 font-medium">Kasları güçlendirir</td>
                <td class="p-3">Test edildi, desteklenmedi<sup><a href="#kaynak-6" class="text-primary hover:underline">[6]</a></sup></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Beyni korur, hafızayı güçlendirir</td>
                <td class="p-3">Test edildi, desteklenmedi<sup><a href="#kaynak-8" class="text-primary hover:underline">[8]</a>, <a href="#kaynak-9" class="text-primary hover:underline">[9]</a></sup></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Şeker metabolizmasını düzeltir</td>
                <td class="p-3">Tek çalışmada kasın insüline yanıtı arttı; birleştirilmiş analizlerin çoğunda kan şekeri değişmedi, bir analiz ise insülin direnci göstergesinde düşüş bildirdi<sup><a href="#kaynak-4" class="text-primary hover:underline">[4]</a>, <a href="#kaynak-7" class="text-primary hover:underline">[7]</a>, <a href="#kaynak-20" class="text-primary hover:underline">[20]</a></sup></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Tansiyonu düşürür</td>
                <td class="p-3">Küçük bir düşüş sinyali var; yazarlar bunu ön bulgu sayıyor <Evidence level={2} /><sup><a href="#kaynak-17" class="text-primary hover:underline">[17]</a></sup></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Sıcak basmasını ve uykuyu iyileştirir</td>
                <td class="p-3">Menopozda yalnızca plasebosuz, yedi günlük bir pilot çalışma var<sup><a href="#kaynak-11" class="text-primary hover:underline">[11]</a></sup>. Yaşlılarda 12 haftalık bir NMN çalışmasında öğleden sonra alanlarda uykululuk ve kalkıp oturma testi düzeldi; plasebo gruplarında da düzelme görüldü<sup><a href="#kaynak-19" class="text-primary hover:underline">[19]</a></sup></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Yumurta kalitesini artırır</td>
                <td class="p-3">Yalnızca hayvan ve laboratuvar verisi<sup><a href="#kaynak-13" class="text-primary hover:underline">[13]</a></sup>; insanda randomize bir çalışma kayıtlı, sonucu henüz yayımlanmadı<sup><a href="#kaynak-22" class="text-primary hover:underline">[22]</a></sup></td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Enerji verir, yorgunluğu azaltır, cildi gençleştirir</td>
                <td class="p-3">Yorgunluk için yaşlılarda 12 haftalık tek bir kontrollü çalışma var; sonuçlar plasebo gruplarındaki düzelmeyle karışıyor<sup><a href="#kaynak-19" class="text-primary hover:underline">[19]</a></sup>. Cilt için ağızdan alınan NMN veya NR ile kontrollü bir çalışmaya rastlamadık.</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Hücreleri gençleştirir, ömrü uzatır</td>
                <td class="p-3">Bu haliyle insanda test edilemiyor; farede NR yaşam süresini uzatmadı<sup><a href="#kaynak-2" class="text-primary hover:underline">[2]</a></sup></td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          Bir hasta "enerjim arttı" dediğinde bunu ciddiye alırım; kendini daha enerjik hissetmesi onun için gerçek bir deneyimdir.
          Ama aynı dönemde daha iyi uyumaya başlamış, yürüyüşlerini artırmış ya da beslenmesini değiştirmiş olabilir; plasebo etkisi de
          işin içinde. Bu yüzden somut sorarım: Öğleden sonra dinlenme zorunluluğu azaldı mı? Eskiden yapamadığı yürüyüşleri yapabiliyor
          mu? Değişim birkaç günden uzun sürdü mü? Hissedilen iyileşmeyi küçümsemem, ama onu takviyenin kanıtlanmış etkisiyle de
          karıştırmam.
        </p>

        <h2 id="urun-serum">Ürün, Doz Sınırı ve Damardan Uygulama</h2>
        <p>
          Türkiye'deki yasal üst sınırlar, NMN çalışmalarında kullanılan miktarların çok altında; NR için fark daha küçük. Bu yüzden
          çalışma sonuçları raftaki ürünlere doğrudan aktarılamaz.
        </p>
        <p>
          Bakanlığın 21 Ekim 2026 tarihli listesine göre Türkiye'de NMN takviye edici gıdalarda günde en fazla 50 mg, NR ise günde en fazla 300 mg ile kullanılabiliyor<sup><a href="#kaynak-14" class="text-primary hover:underline">[14]</a>, <a href="#kaynak-15" class="text-primary hover:underline">[15]</a></sup>.
          NR için hamile ve emziren kadınlarda yasal üst sınır daha düşük, günde 230 mg<sup><a href="#kaynak-15" class="text-primary hover:underline">[15]</a></sup>;
          bu bir güvenlik kanıtı değil, bir kullanım sınırı.
          Oysa NMN çalışmalarında günde 250 ile 2000 mg arasında miktarlar kullanıldı<sup><a href="#kaynak-10" class="text-primary hover:underline">[10]</a></sup>;
          NR için sekiz haftalık bir çalışmada 100, 300 ve 1000 mg denendi; kandaki NAD+ artışı dozla yükseldi<sup><a href="#kaynak-5" class="text-primary hover:underline">[5]</a></sup>.
          Parkinson çalışmasında NR günde 1000 mg verildi<sup><a href="#kaynak-9" class="text-primary hover:underline">[9]</a></sup>.
          Bu bilgi bir doz önerisi değil; kanıtın hangi koşulda elde edildiğini gösteriyor.
        </p>
        <p>
          Bakanlık, onay verdiği takviye edici gıdaların listesini yayımlıyor<sup><a href="#kaynak-26" class="text-primary hover:underline">[26]</a></sup>. Kullandığınız ya da kullanmayı düşündüğünüz ürünün
          bu listede olup olmadığına bakmak, içerik ve üretim denetimi hakkında fikir verir.
        </p>
        <p>
          Damardan uygulanan NAD+ serumları ise ayrı bir konu. Ekim 2025'e kadar yayımlanan çalışmaları tarayan bir derleme, bu uygulamanın
          yaşlanma veya iyi oluş amacıyla test edildiği bir sonuç çalışması bulamadı<sup><a href="#kaynak-3" class="text-primary hover:underline">[3]</a></sup>. Ticari bir merkezin
          kayıtlarına dayanan geriye dönük bir çalışmada, damardan NAD+ alanlarda orta ile şiddetli mide-bağırsak şikâyetleri,
          kalp hızında artış ve göğüste baskı bildirildi. Şikâyetler infüzyon bitince geçti; infüzyon ortalama 97 dakika
          sürdü<sup><a href="#kaynak-12" class="text-primary hover:underline">[12]</a></sup>. Türkiye'de NAD+ içeren ruhsatlı bir
          ilaç bulunmuyor<sup><a href="#kaynak-16" class="text-primary hover:underline">[16]</a></sup>.
        </p>

        <h2 id="fayda-guvenlik">Güvenlik Sınırları ve Sık Bildirilen Şikâyetler</h2>
        <p>
          Kısa ve orta vadeli çalışmalarda NMN ve NR genellikle iyi tolere edildi. Yıllarca kullanım ve özel durumlar ise bu
          çalışmaların kapsamı dışında kaldı.
        </p>
        <p>
          On beş randomize çalışmayı birleştiren bir analizde (güvenlik sonuçlarına on çalışma katkı verdi), 14 gün ile 24 hafta
          arasında kullanılan NMN genel ya da ciddi yan etkileri ve karaciğer enzimlerini artırmadı <Evidence level={3} /><sup><a href="#kaynak-10" class="text-primary hover:underline">[10]</a></sup>.
          Sekiz haftalık bir NR çalışmasında da yan etkiler plasebo grubundan anlamlı biçimde farklı değildi <Evidence level={3} /><sup><a href="#kaynak-5" class="text-primary hover:underline">[5]</a></sup>;
          bu çalışmanın üç yazarından ikisi takviyenin üreticisi olan şirketle bağlantılıydı. Parkinson çalışmasında ciddi yan etkiler
          NR grubunda plasebo grubundan daha seyrek görüldü<sup><a href="#kaynak-9" class="text-primary hover:underline">[9]</a></sup>.
        </p>
        <p>
          Satış ve klinik tanıtım sayfalarında baş ağrısı, yüz kızarması, uyku bozukluğu ve mide şikâyetleri sık anılıyor; bunlar
          kontrollü veri değil, tanıtım metinleri. Kontrollü çalışmalarda toplam yan etkiler plasebodan farklı çıkmadı; bir NR
          çalışmasında kızarma hiç bildirilmedi<sup><a href="#kaynak-5" class="text-primary hover:underline">[5]</a></sup>. Yine de takviyeye
          başladıktan sonra yeni bir şikâyet gelişirse hekimle konuşmak gerekir.
        </p>
        <p>
          Aktif kanser tedavisi, kanser nedeniyle takip veya bağışıklığı baskılayan tedavi varsa, kullanımı ilgili hekimle değerlendirmek gerekir.
          Bu, söz konusu gruplarda kanıtlanmış bir ilaç etkileşimi veya insanlarda gösterilmiş bir kanser riski iddiası değil;
          uzun dönem güvenlik belirsizliği karşısında klinik ihtiyattır.
        </p>

        <RedFlagBox
          intro="Aşağıdaki durumlar, takviye kullanımı öncesinde veya kullanım sırasında hekiminizle konuşmanız gereken noktaları hatırlatır."
