---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import SaveForLaterButton from '../../../components/site/SaveForLaterButton.astro';
import ReadingControls from '../../../components/site/ReadingControls.astro';
import RedFlagBox from '../../../components/site/RedFlagBox.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../../components/site/ArticleFAQ.astro';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { articleFaqs } from '../../../data/article-faqs';
import { resolveSiteUrl } from '../../../utils/seo';

const hero = submenuHeroByRoute['/zamansiz-yasam/deneysel/']!;

const tocEntries = [
  { id: 'isim-koymak', label: 'Reklam Vaadi ile Bilim Arası — Önce İsim Koymak' },
  { id: 'mekanizma-dusus', label: 'NAD+ Hücre Mekanizması ve Yaşla Düşüş' },
  { id: 'kanit-durumu', label: 'İnsan Çalışmalarının Bugünkü Durumu' },
  { id: 'fayda-guvenlik', label: 'Olası Klinik Faydalar ve Güvenlik Sınırları' },
  { id: 'iletisim-sureci', label: 'Takviyeyi Düşünürken Hekimle Konuşmak' },
  { id: 'kaynaklar', label: 'Kaynaklar' },
  { id: 'sik-sorulanlar', label: "Dr. Aksoy'a Sorular" },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'NAD+ Takviyesi — Umut Etiketi ve Kanıt Sınırı';
const articleDescription =
  'NAD+ öncülleri NMN ve NR için insan çalışmaları ne gösteriyor? Menopozda beklenen yararı, güvenlik sınırlarını ve hekimle konuşulacak soruları inceliyoruz.';
const faqItems = articleFaqs['/zamansiz-yasam/deneysel/nad-plus-takviyesi/'] ?? [];
const articleImage = '/images/library/editorial/nad-plus-takviyesi.webp';
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'senai-aksoy',
  articleType: 'clinical-guide',
  publishedDate: '2 Mayıs 2026',
  modifiedDate: '13 Ekim 2026',
  image: articleImage,
  pathname: '/zamansiz-yasam/deneysel/nad-plus-takviyesi/',
  articleSection: 'Zamansız Yaşam',
  sectionPath: '/zamansiz-yasam/',
  keywords: ['NAD+', 'NAD Plus', 'NMN', 'NR', 'nikotinamid mononükleotid', 'nikotinamid ribozid', 'yaşlanma karşıtı', 'takviye', 'kanıt seviyesi', 'menopoz'],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${articleTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  image={articleImage}
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/zamansiz-yasam/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Deneysel Yaklaşımlar"
      title={articleTitle}
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="senai-aksoy"
        articleType="clinical-guide"
        publishedDate="2 Mayıs 2026"
        lastUpdated="13 Ekim 2026"
        readingMinutes={8}
        medicalReviewer="Dr. Alper Mumcu"
        imageSrc="/images/library/editorial/nad-plus-takviyesi-byline.webp"
        imageAlt="Pencere yanında oturup açık defterini inceleyen olgun kadın"
      />

      <div class="flex flex-wrap items-center justify-end gap-3">
        <ReadingControls />
        <SaveForLaterButton
          slug="/zamansiz-yasam/deneysel/nad-plus-takviyesi/"
          title={articleTitle}
        />
      </div>

      <ArticleSummary title="Kısa Klinik Yanıt">
        <p>
          NAD+, hücrenin enerji üretiminde görev alan bir koenzim; NMN ve NR ise vücudun NAD+ üretmek için kullandığı öncüllerdir.
          Bu öncüllerin takviye olarak alınması, menopozda enerji artışı veya gençleşme için güvenilir biçimde kanıtlanmış bir çözüm değildir.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="isim-koymak">Reklam Vaadi ile Bilim Arası — Önce İsim Koymak</h2>
        <p>
          NMN ve NR gibi NAD+ öncülleri, yaşlanma karşıtı takviyeler arasında yoğun biçimde pazarlanıyor.
          Reklamlarda enerji, gençlik ve uzun ömür birlikte anılıyor; insan çalışmaları ise çok daha dar sorulara yanıt veriyor.
        </p>
        <p>
          NMN, nikotinamid mononükleotid; NR ise nikotinamid ribozid adının kısaltması. İkisi de vücudun NAD+ üretirken
          kullandığı yapı taşları. Takviyeden beklediğiniz yararı anlamak içinse hücredeki görevlerinden çok, insan
          çalışmalarında ölçülen sonuçlara bakmak gerekiyor. Güçlü bir vaat ile eksik kanıt arasında kalmak kafa karıştırabilir.
        </p>

        <h2 id="mekanizma-dusus">NAD+ Hücre Mekanizması ve Yaşla Düşüş</h2>
        <p>
          NAD+ (nikotinamid adenin dinükleotid), hücrenin enerji üretmesine yardım eden bir koenzimdir. Bu görevi iyi biliniyor;
          takviye olarak alınan öncüllerin insana ne kazandırdığı ise ayrı bir soru<sup><a href="#kaynak-1" class="text-primary hover:underline">[1]</a></sup>.
        </p>
        <p>
          NAD+ hemen her hücrede bulunur. Hücrenin enerji üreten yapıları olan mitokondrilerde
          elektron taşınmasına katkıda bulunur. Enerji üretiminin yanında, sirtuinler ve PARP adı verilen enzimlerin yürüttüğü
          hücresel onarım ve DNA hasarına yanıt süreçlerinde tüketilir<sup><a href="#kaynak-1" class="text-primary hover:underline">[1]</a></sup>.
        </p>
        <p>
          Hayvan ve insan dokusu çalışmaları, çeşitli dokulardaki NAD+ düzeylerinin yaşla birlikte azaldığına işaret ediyor<sup><a href="#kaynak-1" class="text-primary hover:underline">[1]</a></sup>.
          Hücresel stres ve iltihabi süreçlerle NAD+ tüketen enzimlerin aktivitesinin artması, bu azalmaya katkıda bulunabilecek mekanizmalar arasında.
          Yaşlanmada NAD+ düşüşünün neden mi yoksa sonuç mu olduğu hâlâ açık bir soru. Bu yüzden "eksikliği yerine koyma" mantığı,
          yaşlanmayı durdurma vaadi gibi okunmamalı. Mekanizma makul; klinik yarar henüz net değil.
        </p>

        <h2 id="kanit-durumu">İnsan Çalışmalarının Bugünkü Durumu</h2>
        <p>
          NMN ve NR takviyeleri bazı çalışmalarda kandaki NAD+ gibi ölçülebilir biyolojik göstergeleri artırıyor<sup><a href="#kaynak-1" class="text-primary hover:underline">[1]</a>, <a href="#kaynak-3" class="text-primary hover:underline">[3]</a></sup>.
          Ancak uzun vadeli sağlık yararı ve menopoz belirtileri için mevcut veriler, genel popülasyona
          standart bir takviye önerisi kurmaya yetmiyor.
        </p>
        <p>
          Bu yazıdaki iki plasebo kontrollü çalışmadan biri NMN'nin metabolizmaya etkisini, diğeri NR'nin güvenliğini inceledi.
          NMN çalışmasını menopoz sonrası dönemdeki, prediyabeti (diyabet öncesi evre) olan ve fazla kilolu ya da obez 25 kadın tamamladı;
          uygulama 10 hafta sürdü<sup><a href="#kaynak-2" class="text-primary hover:underline">[2]</a></sup>.
          NR çalışmasına 140 yetişkin alındı; takviye 8 hafta boyunca kullanıldı<sup><a href="#kaynak-3" class="text-primary hover:underline">[3]</a></sup>.
          Bu iki çalışmanın süresi haftalarla ölçülüyor; yıllarca kullanımın sonuçlarını henüz yeterince bilmiyoruz.
        </p>
        <p>
          NMN çalışmasında kasın insüline yanıtı arttı <Evidence level={3} /><sup><a href="#kaynak-2" class="text-primary hover:underline">[2]</a></sup>.
          Ancak kas gücünde ve kasın ne kadar çabuk yorulduğunda iyileşme görülmedi. Yani yarar, ölçülen her sonuca yayılmadı.
          Öte yandan yaşam süresi, kalp krizi ve inme gibi kalp-damar olaylarının önlenmesi ya da demans gibi uzun vadeli klinik sonuçlara dair
          kontrollü ve geniş kapsamlı insan verisi henüz yok.
        </p>
        <p>
          Mayıs 2026'da yayımlanan bir pilot araştırmada 40 kadın, NR ile pterostilben adlı bir maddenin birleşimini yedi gün kullandı.
          Belirti bildiren 32 kadında sıcak basması, uyku ve şişkinlik açısından iyileşmeler bildirildi <Evidence level={1} /><sup><a href="#kaynak-4" class="text-primary hover:underline">[4]</a></sup>.
          Ancak plasebo grubu yoktu ve katılımcılar ne kullandıklarını biliyordu. Çalışma üretici şirket tarafından finanse edildi;
          bazı yazarlar şirket çalışanıydı. Sonuçlar NR ile pterostilbenin birlikte etkisini yansıtıyor; uzun dönem yarar ve güvenlik ise bu kısa çalışmanın kapsamı dışında.
        </p>

        <h2 id="fayda-guvenlik">Olası Klinik Faydalar ve Güvenlik Sınırları</h2>
        <p>
          Kısa süreli denemelerde NMN ve NR genellikle iyi tolere edildi; yani kullananlarda belirgin bir yan etki sorunu görülmedi<sup><a href="#kaynak-2" class="text-primary hover:underline">[2]</a>, <a href="#kaynak-3" class="text-primary hover:underline">[3]</a></sup>.
          Ancak bu sonuçlar 8–10 haftalık kullanımı kapsıyor; yıllarca kullanım ya da kanser tedavisi gibi özel durumlarda kullanım bu çalışmaların kapsamı dışında kaldı.
        </p>
        <p>
          Sekiz haftalık NR çalışmasında, araştırılan dozlarda yan etkiler plasebo grubundan anlamlı biçimde farklı değildi <Evidence level={3} /><sup><a href="#kaynak-3" class="text-primary hover:underline">[3]</a></sup>.
          Makalenin üç yazarından ikisi takviyenin üreticisi olan şirketle bağlantılıydı.
          Bu bulgular incelenen NR ürününe ait; NMN ve diğer ticari NAD+ formülleri için ayrı veri gerekir. Çalışmaya alınanlar fazla kilolu fakat
          genel olarak sağlıklı yetişkinlerdi; gebe ve emziren kadınlar araştırmaya alınmadı<sup><a href="#kaynak-3" class="text-primary hover:underline">[3]</a></sup>.
        </p>
        <p>
          Aktif kanser tedavisi, kanser nedeniyle takip veya bağışıklığı baskılayan tedavi varsa, kullanımı ilgili hekimle değerlendirmek gerekir.
          Bu, söz konusu gruplarda kanıtlanmış bir ilaç etkileşimi veya insanlarda gösterilmiş bir kanser riski iddiası değil;
          uzun dönem güvenlik belirsizliği karşısında klinik ihtiyattır.
        </p>

        <h2 id="iletisim-sureci">Takviyeyi Düşünürken Hekimle Konuşmak</h2>
        <p>
          Acele etmenize gerek yok. Önce bu takviyeden ne beklediğinizi netleştirmek işinizi kolaylaştırabilir.
        </p>
        <p>
          Hastaya ilk sorduğum şey de bu: daha fazla enerji mi, daha iyi uyku mu, yaşlanmayı geciktirmek mi?
          Kandaki veya hücrelerdeki NAD+ düzeyinin yükselmesini, kişinin sağlığında anlamlı bir iyileşmeyle aynı şey saymam.
          Bu yüzden NAD+ takviyelerini bugün menopozun ya da yaşlanma karşıtı tedavinin rutin bir parçası olarak önermiyorum.
        </p>
        <p>
          NAD+ öncüllerini denemeyi planlıyorsanız, jinekoloğunuz ya da iç hastalıkları uzmanınızla görüşürken şu soruları yanınıza
          almanız işinize yarar: Mevcut sağlık geçmişim ve kullandığım ilaçlar açısından bu takviyenin güvenliği nasıl değerlendirilmelidir?
          Olası etkileri hangi sürede ve hangi ölçümlerle izleyeceğiz?
        </p>
        <p>
          Yaşlanma karşıtı bir takviyeyi düşünürken uyku, dengeli beslenme ve düzenli egzersiz gibi temel alışkanlıkları geri plana atmamak gerekir.
          Bu sıra önemli. Takviyeler bu temelin yerine geçemez; en fazla hekim onayıyla eklenebilecek deneysel birer destek olarak
          düşünülebilir.
        </p>
      </ArticleProsePanel>

      <ArticleProsePanel class="mt-10 prose-estranova-references">
        <h2 id="kaynaklar">Kaynaklar</h2>
        <ol class="mt-4 space-y-3 text-sm text-ink/70 leading-relaxed list-decimal list-outside pl-5">
          <li id="kaynak-1">
            Covarrubias AJ et al. "NAD+ metabolism and its roles in cellular processes during ageing."
            <em>Nat Rev Mol Cell Biol</em>. 2021;22(2):119–141.
            PMID: <a href="https://pubmed.ncbi.nlm.nih.gov/33353981/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">33353981</a>
            <span class="block mt-0.5 text-ink/50">(NAD+ metabolizmasının hücresel onarım, mitokondriyal fonksiyon ve yaşlanma süreçlerindeki rollerine dair derleme.)</span>
          </li>
          <li id="kaynak-2">
            Yoshino M et al. "Nicotinamide mononucleotide increases muscle insulin sensitivity in prediabetic women."
            <em>Science</em>. 2021;372(6547):1224–1229.
            PMID: <a href="https://pubmed.ncbi.nlm.nih.gov/33888596/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">33888596</a>
            <span class="block mt-0.5 text-ink/50">(Menopoz sonrası dönemde, prediyabeti olan kadınlarda NMN takviyesinin kasın insüline duyarlılığı üzerindeki etkilerini inceleyen klinik çalışma.)</span>
          </li>
          <li id="kaynak-3">
            Conze D et al. "Safety and Metabolism of Long-term Administration of NIAGEN (Nicotinamide Riboside Chloride) in a Randomized, Double-Blind, Placebo-controlled Clinical Trial of Healthy Overweight Adults."
            <em>Sci Rep</em>. 2019;9(1):9772.
            PMID: <a href="https://pubmed.ncbi.nlm.nih.gov/31278280/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">31278280</a>
            <span class="block mt-0.5 text-ink/50">(NR takviyesinin güvenliğini, yan etkilerini ve dozla artan NAD+ düzeylerini değerlendiren sekiz haftalık insan çalışması; üç yazardan ikisinin üretici şirketle bağlantısı bildiriliyor.)</span>
          </li>
          <li id="kaynak-4">
            Holmes HE et al. "Nicotinamide riboside and pterostilbene reduces frequency and severity of undesirable symptoms of the menopause transition: an open-label, pilot clinical trial."
            <em>Front Aging</em>. 2026;7:1773667.
            PMID: <a href="https://pubmed.ncbi.nlm.nih.gov/42211736/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">42211736</a>
            <span class="block mt-0.5 text-ink/50">(NR ve pterostilben kombinasyonunun menopoz belirtileri üzerine yedi günlük, plasebosuz pilot araştırması; üretici finansmanı ve yazarların şirket bağlantıları bildiriliyor.)</span>
          </li>
        </ol>
      </ArticleProsePanel>

      <RedFlagBox
        intro="Aşağıdaki durumlar, takviye kullanımı öncesinde veya kullanım sırasında hekiminizle konuşmanız gereken noktaları hatırlatır."
        markers={[
          'Aktif kanser tedavisi, kanser nedeniyle takip veya bağışıklığı baskılayan bir tedavi (NMN/NR kullanımına başlamadan önce ilgili hekimlerle değerlendirilmelidir; uzun dönem güvenlik verileri sınırlıdır)',
          'Düzenli reçeteli ilaç kullanımı (ilaç-takviye etkileşimlerine dair veri sınırlıdır)',
          'Gebelik veya emzirme dönemleri (bu yazıda ele alınan çalışmalar bu dönemlerdeki güvenliği göstermiyor)',
          'Araştırmalarda kullanılan miktarları aşan, kontrolsüz kullanım (daha yüksek dozun ek yarar sağladığı gösterilmedi)',
          'Takviye kullanımına başladıktan sonra yeni gelişen bulantı, baş ağrısı veya döküntü gibi şikâyetlerin varlığı',
        ]}
        footnote="Bu liste klinik ihtiyat içindir. Kısa dönem araştırmaların kapsamı ve dışlanan gruplar güvenlik bölümünde kaynaklarıyla açıklanmıştır."
      />

      <ArticleFAQ id="sik-sorulanlar" title="Dr. Aksoy'a Sorular" intro="NAD+ öncüllerini değerlendirirken yarar ve güvenlik hakkında sorularınız." items={faqItems} class="mt-10" />

      <RelatedReadings
        class="mt-14"
        paths={[
          '/bilimsel-pencere/hucreler-ve-yaslanma/nad-plus-hucresel-yaslanma/',
          '/zamansiz-yasam/deneysel/deneysel-tedaviyi-okuma-kilavuzu/',
          '/zamansiz-yasam/d-vitamini-rehberi/',
          '/hormonal-gecis/menopoz/menopoz-nedir/',
        ]}
      />

      <ArticleEditorNote>
        <p class="mb-4 text-lg font-semibold text-ink">Bilimsel Değerlendirme ve İnceleme</p>
        <div class="space-y-3 leading-relaxed text-ink/80 text-sm">
          <p>
            NAD+ öncülleri (NMN, NR), yaşlanma biyolojisi ve hücrelerin enerji üretimi açısından yoğun biçimde incelenen
            moleküllerdir. Bu alandaki çalışmaların çoğu hayvan modellerinde yapıldı; insanda uzun vadeli klinik etkileri
            hâlâ araştırılıyor.
          </p>
          <p>
            NR ve pterostilben kombinasyonuyla menopoz belirtilerini ele alan kısa bir pilot çalışma vardır; plasebosuz tasarımı
            ve yedi günlük süresi nedeniyle etkinlik ve güvenlik hakkında kesin sonuç vermez<sup><a href="#kaynak-4" class="text-primary hover:underline">[4]</a></sup>.
            Bu bulgu, NMN veya NR'nin menopoz tedavisinde rutin kullanımını ya da standart tedavilere alternatif olmasını desteklemez.
          </p>
          <p>
            Kısa süreli araştırmalarda belirgin yan etki görülmemesi, kanser tedavisi veya bağışıklığı baskılayan tedavi alan
            kişilerde uzun dönem güvenlik hakkında bilgi vermez; bu durumlarda kullanım ilgili hekimle birlikte değerlendirilmelidir.
          </p>
          <p class="mt-4 border-t border-gold/30 pt-3 text-xs italic text-primary">
            — Dr. Alper Mumcu, Kadın Hastalıkları ve Doğum Uzmanı · Bağımsız tıbbi inceleme: 13 Ekim 2026
          </p>
        </div>
      </ArticleEditorNote>

      <ArticleDisclaimer>
        <p>
          Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme yerine geçmez. Tanı ve tedavi kararları için
          hekiminize başvurunuz.
        </p>
      </ArticleDisclaimer>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
