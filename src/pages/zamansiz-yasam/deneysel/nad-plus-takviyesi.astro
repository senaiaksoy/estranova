---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import Evidence from '../../../components/site/Evidence.astro';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { resolveSiteUrl } from '../../../utils/seo';

const tocEntries = [
  { id: 'nad-nedir', label: 'NAD+ Nedir?' },
  { id: 'neden-duser', label: 'Yaşla Neden Düşer' },
  { id: 'nmn-nr-arastirmalari', label: 'NMN ve NR Araştırmaları' },
  { id: 'fayda-sinirlar', label: 'Fayda ve Sınırlılıklar' },
  { id: 'guvenlik', label: 'Güvenlik ve Yan Etkiler' },
  { id: 'sonuc', label: 'Sonuç: Bilim Nerede?' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'NAD+ Takviyesi: Bilim Ne Diyor?';
const articleDescription = 'NAD+ takviyeleri hakkında güncel bilimsel verileri, olası faydaları, sınırlılıkları ve güvenlik başlıklarını sade bir dille ele alan rehber.';
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'basak-pelister',
  publishedDate: '14 Nisan 2026',
  pathname: '/zamansiz-yasam/deneysel/nad-plus-takviyesi',
  articleSection: 'Zamansız Yaşam · Deneysel',
  sectionPath: '/zamansiz-yasam',
  keywords: ['NMN', 'NR', 'NAD+', 'takviye', 'menopoz', 'güvenlik'],
  siteUrl,
});
---

<SiteLayout
  title={`${articleTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar />

  <main id="main-content" class="pt-24 text-[#2D2D2D]">
    <SubmenuArticleBody>
        <ArticleTOC slot="toc" entries={tocEntries} />
        <ArticleAuthorBlock authorSlug="basak-pelister" publishedDate="14 Nisan 2026" readingMinutes={7} />

        <header class="mb-10">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">Zamansız Yaşam · Deneysel Yaklaşımlar</p>
          <h1 class="font-serif text-4xl leading-tight md:text-6xl">NAD+ Takviyesi: Bilim Ne Diyor?</h1>
        </header>

        <section class="rounded-[28px] border border-[#C9A96E]/35 bg-gradient-to-br from-white to-[#FDF8F0]/90 p-7 shadow-sm ring-1 ring-[#C9A96E]/22 md:p-8">
          <h2 class="mb-4 font-serif text-3xl">Bu yazıda öğrenecekleriniz</h2>
          <ul class="mb-5 list-disc space-y-2 pl-5 leading-relaxed text-[#2D2D2D]/80">
            <li>NAD+ molekülünün hücresel enerji üretimindeki temel rolü</li>
            <li>NMN ve NR takviyeleriyle ilgili insan çalışmalarının bugün geldiği nokta</li>
            <li>Olası faydalar, güvenlik verileri ve belirsiz kalan alanlar</li>
          </ul>
          <p class="text-sm font-medium text-[#2D2D2D]/70">Okuma süresi: 7 dakika</p>
        </section>

        <ArticleProsePanel>
          <h2 id="nad-nedir">NAD+ Nedir?</h2>
          <p>
            NAD+ (nikotinamid adenin dinükleotid), hücrelerin enerji üretiminde görev alan temel bir koenzimdir.
            Mitokondride gerçekleşen enerji döngüsünde rol oynar ve birçok enzimatik sürecin çalışmasına katkı sağlar.
          </p>
          <p>
            Hücresel onarım, oksidatif stres yanıtı ve metabolik denge gibi başlıklarda NAD+ ile ilişkili mekanizmalar
            uzun süredir araştırılmaktadır. Bu nedenle son yıllarda takviye formunda NAD+ öncülleri daha görünür hale gelmiştir.
          </p>

          <h2 id="neden-duser">Yaşla Birlikte NAD+ Düzeyi Neden Düşer?</h2>
          <p>
            Yaş ilerledikçe hücre içi metabolik süreçlerde değişim olur. Kronik düşük düzeyli inflamasyon, oksidatif stres
            ve enerji üretim zincirindeki yavaşlama NAD+ havuzunu etkileyebilir. Bu düşüş, yaşlanma biyolojisi araştırmalarında
            sık incelenen bir başlıktır.
          </p>
          <p>
            Ancak NAD+ düzeyindeki değişim her kişide aynı hızda olmaz. Genetik yapı, yaşam biçimi, uyku düzeni, beslenme
            ve eşlik eden sağlık durumları bu süreci birlikte şekillendirir.
          </p>

          <h2 id="nmn-nr-arastirmalari">NAD+ Takviyesi Araştırmaları (NMN, NR)</h2>
          <p>
            NAD+ doğrudan takviye edilmekten çok, çoğunlukla öncül bileşikler üzerinden desteklenmeye çalışılır.
            Bu alanda en sık çalışılan iki bileşik NMN (nikotinamid mononükleotid) ve NR (nikotinamid ribozid) olarak öne çıkar.
          </p>
          <p>
            İnsan çalışmalarında bazı biyobelirteçlerde iyileşme ve enerji metabolizmasına dair olumlu sinyaller bildirilmiştir.
            Buna karşılık çalışma sürelerinin kısa olması, örneklem sayılarının sınırlı kalması ve sonuçların her araştırmada
            aynı yönde olmaması nedeniyle net bir klinik sonuçtan söz etmek için henüz erkendir.
          </p>

          <h2 id="fayda-sinirlar">Olası Faydalar ve Sınırlılıklar</h2>
          <p>
            Olası faydalar arasında enerji metabolizmasına katkı, bazı yorgunluk parametrelerinde iyileşme ve metabolik
            işaretleyicilerde sınırlı olumlu değişimler sayılmaktadır. Bu bulgular ilgi çekicidir ve araştırma alanını canlı tutmaktadır.
          </p>
          <p>
            Ancak bu sonuçlar, her kullanıcıda aynı etkiyi garantilemez. Uzun dönem etkinlik verileri sınırlı olduğu için
            NAD+ takviyelerini net ve değişmez bir sonuç olarak değerlendirmek bilimsel açıdan doğru değildir.
          </p>

          <h2 id="guvenlik">Güvenlik ve Yan Etkiler</h2>
          <p>
            Kısa süreli çalışmalarda NMN ve NR genellikle iyi tolere edilmiştir. Bazı kişilerde hafif mide-bağırsak şikayetleri,
            baş ağrısı veya geçici rahatsızlık hissi bildirilebilir.
          </p>
          <p>
            Uzun süreli kullanımda güvenlik verileri henüz sınırlı olduğundan, özellikle kronik hastalığı olanlar veya düzenli ilaç
            kullananlar için hekim görüşü almadan başlanması uygun değildir. Deneysel alanlarda kişisel risk-fayda değerlendirmesi önemlidir.
          </p>

          <h2 id="sonuc">Sonuç: Bilim Henüz Nerede?</h2>
          <p>
            NAD+ takviyeleri için mevcut tablo “umut verici ama henüz kesin değil” şeklinde özetlenebilir. Laboratuvar ve erken dönem
            klinik veriler araştırmayı desteklerken, uzun vadeli klinik sonuçlar için daha güçlü çalışmalara ihtiyaç vardır.
          </p>
          <p>
            Bu nedenle NAD+ takviyelerini değerlendirirken beklentiyi gerçekçi tutmak, güncel kanıt düzeyini takip etmek
            ve kişisel sağlık durumuna göre profesyonel görüş almak en dengeli yaklaşımdır.
          </p>
        </ArticleProsePanel>

        <section class="mt-14 rounded-[28px] border border-[#6B2D3E]/12 bg-[#FDF8F0] p-7 shadow-sm ring-1 ring-[#6B2D3E]/10 md:p-8">
          <h2 class="mb-5 font-serif text-3xl">İlgili İçerikler</h2>
          <ul class="space-y-3">
            <li>
              <a href="/zamansiz-yasam/deneysel/ozon-terapisi-inceleme" class="font-semibold text-[#6B2D3E] hover:underline">
                Ozon Tedavisi: Kanıtlar Ne Söylüyor?
              </a>
            </li>
            <li>
              <a href="/zamansiz-yasam/non-invaziv/hifu-ve-rf-karsilastirma" class="font-semibold text-[#6B2D3E] hover:underline">
                HIFU ve RF Uygulamaları: Temel Farklar
              </a>
            </li>
            <li>
              <a href="/zamansiz-yasam/vitaminler/d-vitamini-rehberi" class="font-semibold text-[#6B2D3E] hover:underline">
                D Vitamini: 40 Yaşından Sonra Ne Kadar Almanız Gerekiyor?
              </a>
            </li>
          </ul>
        </section>

        <section class="mt-14 rounded-[28px] border border-[#6B2D3E]/15 border-l-[6px] border-l-[#C9A96E] bg-gradient-to-r from-[#F5EDE0] to-[#FDF8F0] p-7 shadow-sm ring-1 ring-[#6B2D3E]/10 md:p-8">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.22em] text-[#6B2D3E]">Bilimsel Editör Notu</p>
          <p class="mb-4 text-lg font-semibold text-[#2D2D2D]">Kanıt Düzeyi: C — Gelişen Kanıt <Evidence level={3} /></p>
          <p class="leading-relaxed text-[#2D2D2D]/80">
            NAD+ takviyesinin hücresel yaşlanma üzerindeki etkisini inceleyen 12 klinik çalışma bulunmaktadır. Sonuçlar laboratuvar ortamında umut verici olsa da, insanlarda uzun vadeli etkinlik ve güvenlik verileri henüz yeterli değildir. Bu konuda araştırmalar devam etmektedir.
          </p>
          <p class="mt-4 text-sm text-[#2D2D2D]/65">Son güncelleme: Nisan 2026</p>
        </section>

        <section class="mt-10 rounded-[24px] border border-dashed border-[#6B2D3E]/25 bg-white/95 p-6 ring-1 ring-[#6B2D3E]/10">
          <p class="text-sm leading-relaxed text-[#2D2D2D]/75">
            Bu içerik yalnızca genel bilgilendirme amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavinin yerini almaz.
          </p>
        </section>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
