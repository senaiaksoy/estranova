import Evidence from '../../../components/site/Evidence.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { articleFaqs } from '../../../data/article-faqs';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { resolveSiteUrl } from '../../../utils/seo';

const pathname = '/zamansiz-yasam/deneysel/bpc-157-tb-500-menopoz/';
const hero = submenuHeroByRoute['/zamansiz-yasam/deneysel/']!;
const articleTitle = 'BPC-157 ve TB-500: Tendon, Eklem ve Kas İçin Kanıt Nerede Duruyor?';
const seoTitle = 'BPC-157 ve TB-500 İşe Yarar mı?';
const articleDescription =
  'BPC-157 ve TB-500 tendon, eklem ve kas onarımı için birlikte satılıyor. İnsanda kanıt çok az ya da hiç yok; FDA dosyalarındaki güvenlik bulguları ve menopozda bilinmeyenler.';
const publishedDate = '28 Ekim 2026';
const readingMinutes = 13;
const cardImage = '/images/library/editorial/bpc-157-tb-500-menopoz.webp';

const tocEntries = [
  { id: 'kahramanin-adi', label: 'Kahramanın Adı, Tendonun Takvimi' },
  { id: 'iki-molekul', label: 'İki Ayrı Molekül' },
  { id: 'kanit-merdiveni', label: 'Kanıt Merdiveni' },
  { id: 'bes-soru', label: 'Beş Soruda Değerlendirme' },
  { id: 'fda-dosyalari', label: 'FDA Dosyaları' },
  { id: 'kanser', label: 'Kanser Sorusu' },
  { id: 'iddialar', label: 'Dolaşımdaki İddialar' },
  { id: 'yan-etkiler', label: 'Bildirilen İstenmeyen Etkiler' },
  { id: 'menopoz', label: 'Menopoz ve 40 Sonrası' },
  { id: 'guclu-yollar', label: 'Kanıtı Daha Güçlü Yollar' },
  { id: 'hekimle', label: 'Hekiminizle Konuşulacaklar' },
  { id: 'bilinmeyenler', label: 'Henüz Bilmediklerimiz' },
  { id: 'sik-sorulanlar', label: "Dr. Aksoy'a sorular", numbered: false },
  { id: 'kaynaklar', label: 'Kaynaklar', numbered: false },
];

const faqItems = articleFaqs[pathname] ?? [];
const siteUrl = resolveSiteUrl(Astro.site);
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'senai-aksoy',
  articleType: 'clinical-guide',
  publishedDate,
  modifiedDate: '29 Ekim 2026',
  pathname,
  articleSection: 'Zamansız Yaşam · Deneysel',
  sectionPath: '/zamansiz-yasam/',
  image: cardImage,
  keywords: [
    'BPC-157',
    'TB-500',
    'timosin beta-4',
    'peptid',
    'tendon',
    'donuk omuz',
    'eklem ağrısı',
    'menopoz',
    'kanıt düzeyi',
  ],
  faqItems,
  siteUrl,
