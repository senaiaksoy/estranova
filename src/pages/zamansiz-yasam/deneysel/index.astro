---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuSection from '../../../components/site/SubmenuSection.astro';
import EditorPickCard from '../../../components/site/EditorPickCard.astro';
import MagazineTOC from '../../../components/site/MagazineTOC.astro';
import ChapterMasthead from '../../../components/site/ChapterMasthead.astro';
import EditorialEpigraph from '../../../components/site/EditorialEpigraph.astro';
import ChapterCompass from '../../../components/site/ChapterCompass.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { chapterMap, getNextChapter } from '../../../data/chapter-map';
import { subHubEpigraphs } from '../../../data/sub-hub-epigraphs';

const hero = submenuHeroByRoute['/zamansiz-yasam/deneysel']!;
const __path = '/zamansiz-yasam/deneysel';
const chapter = chapterMap[__path]!;
const epigraph = subHubEpigraphs[__path];
const next = getNextChapter(__path);

const editorPick = {
  href: '/zamansiz-yasam/deneysel/nad-plus-takviyesi',
  title: 'NAD+ Takviyesi — Umut Etiketi vs Kanıt Sınırı',
  lede: 'Anti-aging takviyeleri arasında NAD+ öncülleri yoğun pazarlanıyor; sosyal medyada vaatler yoğun, dürüst yorum az. Mekanizma + insan kanıtı + güvenlik — bilen biri olarak.',
  writerSlug: 'senai-aksoy',
  readingMinutes: 8,
  image: submenuHeroByRoute['/zamansiz-yasam/deneysel/nad-plus-takviyesi'] ?? submenuHeroByRoute['/zamansiz-yasam/deneysel']!,
};

const tocArticles = [
  {
    href: '/zamansiz-yasam/deneysel/deneysel-tedaviyi-okuma-kilavuzu',
    title: 'Deneysel Tedaviyi Okuma Kılavuzu',
    excerpt: 'Bir tedaviye "deneysel" demek ne anlama gelir? Kanıt yelpazesi, off-label vs deneysel ayrımı, pazarlama sinyalleri ve doktora sorabileceğiniz üç soru — sınır bilen sakin editöryal bir çerçeve.',
    writerSlug: 'senai-aksoy',
    readingMinutes: 8,
  },
  {
    href: '/zamansiz-yasam/deneysel/coenzyme-q10-takviyesi',
    title: 'Coenzyme Q10 Hangi Durumda Klinik Kanıtlı, Hangi Durumda Reklam?',
    excerpt: 'CoQ10 anti-aging reklamlarının başrol oyuncularından biri; oysa moleküle ait kanıt tek bir hikaye değil. Statin, migren, kalp yetmezliğinde gerçek klinik kanıt; anti-aging ve menopoz iddialarında belirgin sınır.',
    writerSlug: 'senai-aksoy',
    readingMinutes: 9,
  },
  {
    href: '/bilimsel-pencere/hucreler-ve-yaslanma/nad-plus-hucresel-yaslanma',
    title: 'Bilimsel Pencere: NAD+ ve Hücresel Yaşlanma — Mekanizmadan Pratik Sınırlara',
    excerpt: 'Sirtuin, PARP ve CD38 yolakları yaşlanma biyolojisinin kalbinde. Mekanizma sağlam, klinik kanıt sınırlı, hayvan-insan çeviri zorlu — laboratuvardan kliniğe yolun neden uzun olduğunu anlatan derin okuma.',
    writerSlug: 'senai-aksoy',
    readingMinutes: 9,
  },
];

const neighbors = [
  {
    href: '/zamansiz-yasam/vitaminler',
    title: 'Vitaminler',
    excerpt: 'D vitamini başta olmak üzere temel mikro besinler ve takviye okuması.',
  },
  {
    href: '/zamansiz-yasam/non-invaziv',
    title: 'Ameliyatsız Uygulamalar',
    excerpt: 'Ameliyat veya enjeksiyon gerektirmeyen yaklaşımlar üzerine editöryal çerçeve.',
  },
  {
    href: '/zamansiz-yasam/beslenme-yaslanma',
    title: 'Beslenme ve Yaşlanma',
    excerpt: 'Protein, lif ve mineral dengesinin uzun dönem sağlık üzerindeki etkileri.',
  },
];
---

<SiteLayout
  title="Deneysel Yaklaşımlar - Estranova"
  description="Araştırma aşamasındaki yaklaşımlar hakkında kanıt düzeyiyle değerlendirilmiş zamansız yaşam içerikleri."
>
  <SiteNavbar currentPath="/zamansiz-yasam" />
  <ChapterMasthead number={chapter.number} parent={chapter.parent} chapter={chapter.chapter} />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Deneysel"
      title="Deneysel Yaklaşımlar"
      lede="“Deneysel” etiketi, bir yaklaşımın henüz herkes için standart öneri olmadığını hatırlatır. Bu sayfadaki içerikler güçlü kanıt ile sınırlı kanıt arasındaki farkı okumaya yardımcı olur."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />

    <section class="border-b border-burgundy/10 bg-cream-soft px-6 py-12 md:py-16">
      <div class="mx-auto max-w-6xl">
        <nav class="mb-8 text-sm text-ink/60" aria-label="İçerik yolu">
          <ol class="flex flex-wrap items-center gap-2">
            <li>
              <a href="/zamansiz-yasam" class="font-medium text-burgundy hover:underline">Zamansız Yaşam</a>
            </li>
            <li aria-hidden="true">/</li>
            <li class="font-medium text-ink">Deneysel</li>
          </ol>
        </nav>

        <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-start lg:gap-16">
          <div>
            <p class="mb-5 text-lg leading-relaxed text-ink/82 md:text-xl">
              Yaşlanma ve uzun ömür alanında çok hızlı bir konuşma var; her hafta yeni bir “çığır açıcı” vaat duyuyoruz.
              Bu sayfanın amacı heyecanı yatıştırmak değil, kanıtın hangi adımda olduğunu görünür kılmak —
              umut da, ihtiyat da bu çerçeveyle daha sağlam oturuyor.
            </p>
            <p class="text-base leading-relaxed text-ink/72">
              Aşağıdaki içeriklerde ürün önerisi yapılmaz; mekanizma, mevcut çalışmaların sınırı ve hâlâ açık olan
              sorular sade bir dille aktarılır. Kişisel kullanım kararı her zaman hekiminizle değerlendirilmelidir.
            </p>
          </div>

          <aside
            class="rounded-[28px] border border-burgundy/15 bg-white p-7 shadow-sm md:p-8"
            aria-labelledby="deneysel-ozet-baslik"
          >
            <h2 id="deneysel-ozet-baslik" class="mb-4 font-serif text-xl text-ink">Bu konuda sık sorulanlar</h2>
            <ul class="space-y-4 text-sm leading-relaxed text-ink/78">
              <li class="border-b border-burgundy/10 pb-4">
                <span class="block font-semibold text-ink">“Deneysel” ne anlama gelir?</span>
                Yaklaşımın henüz herkes için standart öneri olmadığını, kanıt gücünün sınırlı olduğunu gösterir.
              </li>
              <li class="border-b border-burgundy/10 pb-4">
                <span class="block font-semibold text-ink">Güçlü kanıt nasıl ayırt edilir?</span>
                Randomize klinik çalışma, geniş örneklem ve tekrarlanabilir sonuç temel güvenilirlik göstergeleridir.
              </li>
              <li>
                <span class="block font-semibold text-ink">Bu içerikler ürün reklamı mı?</span>
                Hayır; marka veya satış önerisi yapılmaz. Yalnızca kanıt çerçevesi ve mekanizma açıklanır.
              </li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    {epigraph && <EditorialEpigraph quote={epigraph} />}

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Editör'ün Seçimi</p>
        <h2 class="font-serif text-3xl leading-tight md:text-4xl">Bu evreden bir okuma</h2>
      </header>

      <EditorPickCard
        href={editorPick.href}
        title={editorPick.title}
        lede={editorPick.lede}
        writerSlug={editorPick.writerSlug}
        readingMinutes={editorPick.readingMinutes}
        imageSrc={editorPick.image.src}
        imageAlt={editorPick.image.alt}
      />
    </SubmenuSection>

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Bu Evrede Okumalar</p>
        <h2 class="font-serif text-3xl leading-tight md:text-4xl">Sayının diğer başlıkları</h2>
      </header>

      <MagazineTOC items={tocArticles} />
    </SubmenuSection>

    <SubmenuSection variant="cream" borderedTop={true}>
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Aynı kategoride</p>
      <h2 class="mb-8 font-serif text-2xl md:text-3xl">İlgili alt başlıklar</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          neighbors.map((n) => (
            <a
              href={n.href}
              class="group rounded-[26px] border border-burgundy/12 bg-white p-7 transition hover:border-burgundy/28 hover:shadow-sm"
            >
              <h3 class="mb-2 font-serif text-xl text-ink group-hover:text-burgundy">{n.title}</h3>
              <p class="mb-4 text-sm leading-relaxed text-ink/72">{n.excerpt}</p>
              <span class="text-sm font-semibold text-burgundy group-hover:underline">Sayfaya git →</span>
            </a>
          ))
        }
      </div>
    </SubmenuSection>

    <ChapterCompass nextHref={next?.href} nextNumber={next?.number} nextChapter={next?.chapter} nextParent={next?.parent} />
  </main>

  <SiteFooter />
</SiteLayout>
