---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';

const hero = submenuHeroByRoute['/zamansiz-yasam/deneysel']!;
---

<SiteLayout
  title="Deneysel Yaklaşımlar - Estranova"
  description="Araştırma aşamasındaki yaklaşımlar hakkında kanıt düzeyiyle değerlendirilmiş zamansız yaşam içerikleri."
>
  <SiteNavbar currentPath="/zamansiz-yasam" />

  <main id="main-content" class="text-[#2D2D2D]">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Deneysel"
      title="Deneysel Yaklaşımlar"
      lede="“Deneysel” etiketi, yaklaşımın henüz herkes için standart öneri olmadığını hatırlatır. Aşağıdaki içerikler güçlü kanıt ile zayıf kanıt arasındaki farkı okumaya yardımcı olur."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />
    <section class="bg-[#FDF8F0] px-6 py-16 md:py-20">
      <div class="mx-auto max-w-4xl">
        <ul class="space-y-4 text-lg">
          <li>
            <a href="/zamansiz-yasam/deneysel/nad-plus-takviyesi" class="font-semibold text-[#6B2D3E] hover:underline"
              >NAD+ Takviyesi: Bilim Ne Diyor?</a
            >
          </li>
          <li>
            <a href="/bilimsel-pencere/nad-plus-hucresel-yaslanma" class="font-semibold text-[#6B2D3E] hover:underline"
              >Bilimsel Pencere: NAD+ ve Hücresel Yaşlanma</a
            >
          </li>
        </ul>

        <p class="mt-10">
          <a href="/zamansiz-yasam" class="font-semibold text-[#6B2D3E] hover:underline">← Zamansız Yaşam ana sayfa</a>
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
