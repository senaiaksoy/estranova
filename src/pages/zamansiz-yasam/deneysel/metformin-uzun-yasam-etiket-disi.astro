---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import SaveForLaterButton from '../../../components/site/SaveForLaterButton.astro';
import ReadingControls from '../../../components/site/ReadingControls.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../../components/site/ArticleFAQ.astro';
import Evidence from '../../../components/site/Evidence.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { articleFaqs } from '../../../data/article-faqs';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { resolveSiteUrl } from '../../../utils/seo';

const pathname = '/zamansiz-yasam/deneysel/metformin-uzun-yasam-etiket-disi/';
const hero = submenuHeroByRoute['/zamansiz-yasam/deneysel/']!;
const articleTitle = 'Metformin Uzun Yaşam İçin Kullanılır mı? Diyabeti Olmayanlarda Etiket Dışı Kullanım';
const seoTitle = 'Metformin Uzun Yaşam İçin Kullanılır mı?';
const articleDescription =
  'Metformin tip 2 diyabet ilacıdır; uzun yaşam için kullanımı etiket dışıdır. Diyabeti olmayanlarda ömür verisi yok, egzersizle kas kazanımı azalabiliyor, B12 ve böbrek izlenmeli.';
const publishedDate = '27 Ekim 2026';
const readingMinutes = 14;

const tocEntries = [
  { id: 'ayni-kutu', label: 'Aynı Kutu, İki Soru' },
  { id: 'neden-konusuluyor', label: 'Neden Konuşuluyor' },
  { id: 'kanit-merdiveni', label: 'Kanıt Merdiveni' },
  { id: 'egzersiz', label: 'Egzersiz Yapanlar İçin' },
  { id: 'degerlendirme', label: 'Beş Eksende Değerlendirme' },
  { id: 'iddialar', label: 'Dolaşan İddialar' },
  { id: 'riskler', label: 'Etiket Dışı Kullanımın Riskleri' },
  { id: 'devam-eden', label: 'Devam Eden Çalışmalar' },
  { id: 'menopoz', label: 'Menopoz ve 40 Sonrası' },
  { id: 'hekimle', label: 'Hekimle Konuşulacaklar' },
  { id: 'guclu-yollar', label: 'Kanıtı Daha Güçlü Yollar' },
  { id: 'bilinmeyenler', label: 'Henüz Bilmediklerimiz' },
  { id: 'sik-sorulanlar', label: "Dr. Aksoy'a sorular" },
  { id: 'kaynaklar', label: 'Kaynaklar' },
];

const faqItems = articleFaqs[pathname] ?? [];
const siteUrl = resolveSiteUrl(Astro.site);
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'senai-aksoy',
  articleType: 'clinical-guide',
  publishedDate,
  pathname,
  articleSection: 'Zamansız Yaşam · Deneysel',
  sectionPath: '/zamansiz-yasam/',
  image: hero.src.startsWith('http') ? hero.src : `${siteUrl.replace(/\/$/, '')}${hero.src}`,
  keywords: [
    'metformin',
    'uzun yaşam',
    'etiket dışı kullanım',
    'yaşlanma',
    'menopoz',
    'kanıt düzeyi',
    'B12 eksikliği',
    'direnç egzersizi',
  ],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  image={hero.src}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/zamansiz-yasam/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Deneysel"
      title={articleTitle}
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="senai-aksoy"
        articleType="clinical-guide"
        publishedDate={publishedDate}
        readingMinutes={readingMinutes}
        imageSrc="/images/library/editorial/metformin-uzun-yasam-etiket-disi-byline.webp"
        imageAlt="Sabah ışığında çalışma masasında not defteri ve su bardağıyla düşünceli duran 50 yaş civarı bir kadın; yapay zekâ ile üretilmiş temsili görsel"
        imagePosition="center"
      />

      <div class="flex flex-wrap items-center justify-end gap-3">
        <ReadingControls />
        <SaveForLaterButton slug={pathname} title={articleTitle} />
      </div>

      <ArticleSummary title="Kısa Klinik Yanıt">
        <p>
          Metformin, tip 2 diyabet için onlarca yıldır kullanılan ve güvenlik kaydı geniş bir ilaçtır. Diyabeti olmayan
          birinde uzun yaşam için kullanılması etiket dışıdır: bu amaçla ruhsatı yoktur ve ömür ya da hastalık
          sonlanımlı bir insan çalışması sonuçlanmış değildir. Diyabetlilerde gözlenen sağkalım avantajı umut vericidir
          ama gözlemseldir <Evidence level={2} />. Direnç egzersizi yapan sağlıklı yaşlılarda tek randomize çalışma,
          metforminin kas kazanımını azalttığını gösterdi <Evidence level={3} />. Uzun süre kullananlarda B12 eksikliği
          ve böbrek işlevi izlenmelidir. Karar, muayene ve tahlille birlikte hekimle verilir.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="ayni-kutu">Aynı kutu, iki ayrı soru</h2>
        <p>
          Eczanede aynı kutuyu iki kişi alabilir. Biri şekerini düşürmek için, öteki yaşlanmayı yavaşlatmak için. Kutu
          aynı. Soru aynı değil.
        </p>
        <p>
          Muayene odasında bu soruyu, ayrıntıları değişse de, sık duyuyorum: "Diyabetim yok ama metformin kullanmak
          istiyorum. Uzun yaşam için." İnternette okunan bir yazı, bir podcast bölümü ya da bir arkadaşın anlattığı şey
          çoğu zaman bu sorunun arkasındadır. Merak etmenizde yanlış bir şey yok. Hatta iyi bir işaret: sağlığınızla
          ilgileniyorsunuz.
        </p>
        <p>
          İlacın adı ve etiketi bu soruda iki ayrı şeyi karıştırıyor. Birincisi, ilacın tanımlı bir hastalıkta
          çalıştığının gösterilmiş olması. İkincisi, o ilacın hastalığı olmayan birinde ömrü ya da sağlıklı yılları
          uzattığının gösterilmesi. Metformin için birincisi var. İkincisi henüz yok.
        </p>
        <p>
          Önce şunu söyleyeyim: bu yazıda sizi korkutmak ya da ilacı küçümsemek gibi bir niyetim yok. Amacım, "alsam
          mı?" sorusunun hangi sorulara bölündüğünü göstermek.
        </p>
        <p>
          Etiket dışı kullanım ne demek? Bir ilacın ruhsatında yazılmayan bir amaçla, bir hekimin sorumluluğuyla
          yazılması. Hekimler bunu kimi zaman yapar, çünkü kanıt biriktikçe ruhsat metinleri geride kalabilir. Ama
          "yapılabiliyor" ile "kanıtlandı" aynı cümle değildir.
        </p>

        <h2 id="neden-konusuluyor">Metformin neden bu kadar konuşuluyor</h2>
        <p>
          Yaşlanma araştırmacılarının metformine bakmasının sebebi ilacın reklamı değil, dosyasının kalınlığı.
        </p>
        <p>
          Metformin tip 2 diyabette ilk seçenek ilaçlardan biri. Bir derlemeye göre dünyada her gün yaklaşık 150 milyon
          kişi kullanıyor <Evidence level={3} /> <sup><a href="#kaynak-8" aria-label="Kaynak 8">[8]</a></sup>. Bu kadar geniş kullanım, yan etkilerin iyi tanınması demek. Başka
          bir deyişle bu ilacın karanlık köşeleri çoğu yeni molekülden daha az.
        </p>
        <p>
          Gündeme gelişi de buradan: diyabetli kullanıcılarda kanser, kalp-damar hastalığı ve bilişsel gerileme gibi
          yaşa bağlı sorunlarda daha az olay gözlendiğine dair çalışmalar yayımlandı <sup><a href="#kaynak-7" aria-label="Kaynak 7">[7]</a><a href="#kaynak-8" aria-label="Kaynak 8">[8]</a></sup>. Bunlardan biri, Birleşik
          Krallık kayıtlarından 78 binden fazla metformin kullanıcısını ve 90 binden fazla eşleştirilmiş diyabeti
          olmayan kişiyi karşılaştırdı. Metformin ile başlanan diyabetlilerin sağkalımı, eşleştirilmiş diyabetsizlerden
          daha uzundu <Evidence level={2} /> <sup><a href="#kaynak-3" aria-label="Kaynak 3">[3]</a></sup>.
        </p>
        <p>
          Bu bulgu insanın gözünü açıyor. Ama yazarlar dahil kimse "kanıtlandı" demiyor. Çünkü ilaç kullananları
          kullanmayanlarla gözlemle karşılaştırdığınızda, ilaç dışındaki farklar (kime hangi ilacın yazıldığı, kimin
          daha düzenli takip edildiği) sonucu etkileyebilir. Bunu gözlemsel verinin doğal sınırı olarak düşünün.
        </p>

        <h2 id="kanit-merdiveni">Kanıt merdiveni: hücreden sağlıklı yetişkine</h2>
        <p>
          Metformin merdivenin ortasına kadar çıkmış. Yukarıdaki basamaklar boş değil, ama bazılarına henüz kimse
          ayak basmadı.
        </p>
        <ol>
          <li><strong>Mekanizma:</strong> Metformin, hücrede enerji sensörü olan AMPK'yı harekete geçirir ve mTOR denen büyüme yolağını yavaşlatır <sup><a href="#kaynak-7" aria-label="Kaynak 7">[7]</a></sup>. Biyolojik olarak mantıklı; ama klinik faydanın büyük kısmı insülin duyarlılığı ve kan şekeri etkisinden gelebilir <sup><a href="#kaynak-8" aria-label="Kaynak 8">[8]</a></sup>. Derlemeler, metforminin yaşlanmadaki etki mekanizmalarının büyük ölçüde bilinmediğini ve ilacı kullanan herkesin aynı yararı görmediğini de vurgular <sup><a href="#kaynak-19" aria-label="Kaynak 19">[19]</a></sup>.</li>
          <li><strong>Hayvanda ömür:</strong> Fare ömrünü bağımsız merkezlerde sınayan ulusal programda metformin tek başına ömrü anlamlı uzatmadı <sup><a href="#kaynak-4" aria-label="Kaynak 4">[4]</a></sup>. Sonraki bir yeniden analiz, erken ölümlere duyarlı bir testle, metforminin yalnızca erkek farelerde sağkalımı artırdığını bildirdi <sup><a href="#kaynak-5" aria-label="Kaynak 5">[5]</a></sup>. Solucan türlerinde sonuç genetik zemine göre değişti: bazı türde ömür uzadı, bazısında etkisiz kaldı, bazısında kısaldı <sup><a href="#kaynak-6" aria-label="Kaynak 6">[6]</a></sup>. Erkek maymunlarla yapılan 40 aylık bir çalışmada ise metformin, ölçülen yaşlanma göstergelerini ve beyin yaşı göstergelerini yavaşlattı; bu bir ömür sonucu değil, tek cinsiyette bir hayvan çalışmasıdır <sup><a href="#kaynak-18" aria-label="Kaynak 18">[18]</a></sup>.</li>
          <li><strong>İnsanda biyobelirteç:</strong> Yaklaşık 70 yaşındaki 14 kişiyle yapılan çapraz tasarımlı bir çalışmada, 6 hafta metformin ve 6 hafta plasebo sonrası kas ve yağ dokusunda yüzlerce genin ifadesi değişti; bunlar arasında DNA onarımı ve mTORC1 gibi yaşlanmayla ilişkili yolaklar da vardı <Evidence level={2} /> <sup><a href="#kaynak-15" aria-label="Kaynak 15">[15]</a></sup>. Bunlar yerine geçen göstergedir, ömür değil; çalışma küçük ve kısa.</li>
          <li><strong>İnsanda işlev:</strong> Sağlıklı 65 yaş üstünde direnç egzersizine eklenen metformin kas büyümesini azalttı <Evidence level={3} /> <sup><a href="#kaynak-1" aria-label="Kaynak 1">[1]</a></sup>. Ayrıntısı bir sonraki bölümde.</li>
          <li><strong>İnsanda güvenlik:</strong> Diyabetlilerde geniş ve uzun. Diyabeti olmayan sağlıklıda uzun süreli veri çok daha dar. Bu fark yazının en önemli cümlelerinden biri.</li>
          <li><strong>Sert sonlanım (ömür, hastalık):</strong> Diyabeti olmayanlarda sonuçlanmış bir çalışma yok. TAME adlı büyük çalışma 65-79 yaş arası 3.000'den fazla kişiyi altı yıl izleyecek şekilde tasarlandı <sup><a href="#kaynak-10" aria-label="Kaynak 10">[10]</a><a href="#kaynak-17" aria-label="Kaynak 17">[17]</a></sup>. Bu yazıyı hazırlarken çalışmanın başladığına ya da finansmanın tamamlandığına dair güncel bir duyuru doğrulayamadık; sonuç beklemek için erken.</li>
        </ol>

        <h2 id="egzersiz">Egzersiz yapanlar için beklenmedik bir bulgu</h2>
        <p>
          Kası korumak istiyorsanız, bu bölümü bir kez daha okuyun.
        </p>
        <p>
          Kas kaybı, 40 sonrasında çoğumuzun sessizce yaşadığı bir konu. Direnç egzersizi bu kaybı yavaşlatan kanıtı en sağlam olan yol. Araştırmacılar şunu denedi: metformin, kaslardaki iltihabı azaltarak egzersizin etkisini
          artırabilir mi?
        </p>
        <p>
          MASTERS adlı çalışmada 65 yaş üstü 94 sağlıklı kişi, 14 hafta süren denetimli direnç egzersizi programına
          katıldı. Yarısı günde 1.700 mg metformin, yarısı plasebo aldı. Sonuç beklenenin tersiydi: plasebo grubu daha
          fazla yağsız kütle ve uyluk kası kazandı. Kuvvet kazanımında da metformin lehine değil, aleyhine bir eğilim
          vardı; bu fark istatistiksel olarak anlamlı değildi <Evidence level={3} /> <sup><a href="#kaynak-1" aria-label="Kaynak 1">[1]</a></sup>.
        </p>
        <p>
          Bir ayrıntı: katılımcıların yaklaşık üçte biri statin kullanıyordu. Sonradan yapılan ikincil bir analizde,
          metformin ve statin birlikte alanlarda bu körelme görülmedi <sup><a href="#kaynak-2" aria-label="Kaynak 2">[2]</a></sup>. Bu bir hipotez; kanıt değil. İki ilacı
          birleştirmek için bir gerekçe olarak okunmamalı.
        </p>
        <p>
          Bu çalışma, "sağlıklı biri için metformin zararsız bir olasılık" fikrine tatlı bir uyarı. İlaç bir hedef için
          çalışırken başka bir hedefe ters gelebilir.
        </p>

        <h2 id="degerlendirme">Beş eksende değerlendirme</h2>
        <p>
          Tek bir not vermiyorum. Beş soru soruyorum.
        </p>
        <div class="my-8 overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-primary/20 bg-primary/5 text-ink font-serif">
                <th class="p-3 font-semibold">Eksen</th>
                <th class="p-3 font-semibold">Değerlendirme</th>
                <th class="p-3 font-semibold">Gerekçe</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-primary/10">
              <tr>
                <td class="p-3 font-medium">Etkinlik kanıtı (uzun yaşam)</td>
                <td class="p-3">Sınırlı</td>
                <td class="p-3">Diyabetlide gözlemsel sağkalım avantajı <sup><a href="#kaynak-3" aria-label="Kaynak 3">[3]</a></sup>; sağlıklıda sert sonlanımlı çalışma yok; fare verisi karışık <sup><a href="#kaynak-4" aria-label="Kaynak 4">[4]</a><a href="#kaynak-5" aria-label="Kaynak 5">[5]</a></sup>.</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Güvenlik kanıtı</td>
                <td class="p-3">Diyabetlide güçlü, sağlıklıda sınırlı</td>
                <td class="p-3">Geniş kullanım <sup><a href="#kaynak-8" aria-label="Kaynak 8">[8]</a></sup>; ama uzun süreli, diyabetsiz kullanıcı verisi dar.</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Mekanizma inandırıcılığı</td>
                <td class="p-3">Orta</td>
                <td class="p-3">AMPK ve mTOR yolağı makul <sup><a href="#kaynak-7" aria-label="Kaynak 7">[7]</a></sup>; faydanın bir kısmı glukoz etkisiyle açıklanabilir <sup><a href="#kaynak-8" aria-label="Kaynak 8">[8]</a></sup>.</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Ürün ve düzenleyici durum</td>
                <td class="p-3">Reçeteli ilaç; yaşlanma için endikasyon yok</td>
                <td class="p-3">ABD etiketindeki endikasyon yetişkinlerde tip 2 diyabette glisemik kontroldür <sup><a href="#kaynak-16" aria-label="Kaynak 16">[16]</a></sup>. Türkiye'deki ruhsat metni için hekiminize ve ürünün kısa ürün bilgisine bakın.</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Geri dönüşebilirlik</td>
                <td class="p-3">Çoğu etki bırakınca geçer</td>
                <td class="p-3">B12 eksikliği izlenmezse sinir hasarına ilerleyebilir <sup><a href="#kaynak-12" aria-label="Kaynak 12">[12]</a></sup>.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2 id="iddialar">Dolaşan iddialar ve kanıtın durumu</h2>
        <p>
          Her iddia aynı güçte değil. Onları kanıt sırasına dizelim.
        </p>
        <div class="my-8 overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-primary/20 bg-primary/5 text-ink font-serif">
                <th class="p-3 font-semibold">İddia</th>
                <th class="p-3 font-semibold">Durum</th>
                <th class="p-3 font-semibold">Not</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-primary/10">
              <tr>
                <td class="p-3 font-medium">Metformin kullanan diyabetlilerin sağkalımı, eşleştirilmiş diyabetsizlerden uzundur</td>
                <td class="p-3">Test edildi, desteklendi (gözlemsel)</td>
                <td class="p-3"><sup><a href="#kaynak-3" aria-label="Kaynak 3">[3]</a></sup>; karıştırıcılar var, ilacın nedeni olduğu gösterilmedi.</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Metformin diyabeti olmayanda ömrü uzatır</td>
                <td class="p-3">Henüz test edilmedi ama test edilebilir</td>
                <td class="p-3">TAME tasarımı <sup><a href="#kaynak-10" aria-label="Kaynak 10">[10]</a></sup>; sonuç yok.</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Metformin yaşlılarda kas yapımına yardımcı olur</td>
                <td class="p-3">Test edildi, desteklenmedi</td>
                <td class="p-3">MASTERS <sup><a href="#kaynak-1" aria-label="Kaynak 1">[1]</a></sup>.</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Metformin sağlıklıda "yaşlanmayı yavaşlatır"</td>
                <td class="p-3">Bu haliyle test edilemez</td>
                <td class="p-3">"Yaşlanma" tek bir sonlanım değil; yerine geçen göstergeler ömrün yerine geçmez <sup><a href="#kaynak-7" aria-label="Kaynak 7">[7]</a></sup>.</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Metformin kanseri önler</td>
                <td class="p-3">Henüz test edilmedi ama test edilebilir</td>
                <td class="p-3">Gözlemsel ilişkiler bildirildi <sup><a href="#kaynak-7" aria-label="Kaynak 7">[7]</a><a href="#kaynak-8" aria-label="Kaynak 8">[8]</a></sup>; sağlıklı kişilerde önleme çalışması bu yazıda doğrulanmadı.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2 id="riskler">Etiket dışı kullanımın riskleri</h2>
        <p>
          Bu bölümde espri payı yok; sade ve açık yazıyorum.
        </p>
        <p>
          <strong>Vitamin B12 eksikliği.</strong> Metformin 4 aydan uzun kullanıldığında B12 eksikliği için bir risk
          faktörü sayılır <sup><a href="#kaynak-12" aria-label="Kaynak 12">[12]</a></sup>. Emilimin bozulması bunun bilinen bir mekanizması <sup><a href="#kaynak-13" aria-label="Kaynak 13">[13]</a></sup>. Eksiklik kansızlık ve sinir hasarı
          gibi sonuçlar doğurabilir. Bu yüzden uzun süre kullanan kişide B12 düzeyi izlenir <Evidence level={3} /> <sup><a href="#kaynak-12" aria-label="Kaynak 12">[12]</a><a href="#kaynak-13" aria-label="Kaynak 13">[13]</a></sup>.
          ABD etiketi kansızlık değerlerinin yılda bir, B12'nin 2-3 yılda bir ölçülmesini öneriyor <sup><a href="#kaynak-16" aria-label="Kaynak 16">[16]</a></sup>. Bu aralıklar
          diyabetli kullanıcılar için yazılmış bir izlem takvimidir; yaşlanma amacıyla kullanan biri için ayrı bir
          takvim yoktur.
        </p>
        <p>
          <strong>Böbrek işlevi ve laktik asidoz.</strong> Metformin böbrekten atılır. Laktik asidoz, kanda laktat adlı
          asidin birikmesidir; nadirdir ama ağırdır. ABD etiketinin çerçeveli uyarısı bu durumu anar ve risk faktörleri
          arasında böbrek işlevinde bozulma, belirli ilaçlarla birlikte kullanım, 65 yaş ve üzeri, kontrastlı radyolojik
          tetkik, ameliyat, düşük oksijenli durumlar, aşırı alkol ve karaciğer yetmezliğini sayar <sup><a href="#kaynak-16" aria-label="Kaynak 16">[16]</a></sup>. Etikete göre
          tahmini glomerüler süzme hızı (eGFR) 30'un altında ilaç kullanılmaz; asidoz da kontrendikasyon sebebidir <sup><a href="#kaynak-16" aria-label="Kaynak 16">[16]</a></sup>.
          Böbrek hastalığı olan diyabetlilerdeki gözlemsel çalışmaların birleşik analizinde evre 4'te laktik asidoz
          eğilimi vardı ama anlamlı değildi ve kanıt kesinliği çok düşüktü <Evidence level={1} /> <sup><a href="#kaynak-11" aria-label="Kaynak 11">[11]</a></sup>. Yani risk
          gösterilmedi ama dışlanmadı da. Böbrek işlevi ölçülmeden ilaç başlanmaz.
        </p>
        <p>
          <strong>Mide-bağırsak yakınmaları.</strong> ABD etiketinde (uzun salınımlı form) plaseboya göre ishal %10'a
          karşı %3, bulantı ya da kusma %7'ye karşı %2 olarak bildirilmiş <sup><a href="#kaynak-16" aria-label="Kaynak 16">[16]</a></sup>. Bunlar diyabetli katılımcıların
          verisidir.
        </p>
        <p>
          <strong>Kimler özellikle dikkatli olmalı.</strong> Böbrek ya da karaciğer yetmezliği olanlar, aşırı alkol
          kullananlar, kontrastlı görüntüleme ya da ameliyat öncesindeki kişiler, hipoksik hastalıkta olanlar.
          Gebelikte metformin için etiket "yeterli veri yok" der; emzirmede süte geçtiğini bildirir <sup><a href="#kaynak-16" aria-label="Kaynak 16">[16]</a></sup>. Gebelik planı
          olan ya da emziren biri uzun yaşam amacıyla başlamadan önce hekimiyle özel olarak konuşmalıdır. Not: etiket,
          yaşlanma amacıyla kullanan sağlıklı kişiler için yazılmamıştır.
        </p>
        <p>
          Kullanıcıların kendi bildirimleri etkinlik için zayıf, güvenlik sinyali olarak değerlidir. "İyi hissediyorum"
          demek plasebo ya da ortalamaya dönüşten etkilenir; tekrarlayan bir yan etki bildirimi ise ciddiye alınır.
        </p>

        <h2 id="devam-eden">Devam eden çalışmalar: cevap ne zaman gelir?</h2>
        <p>
          Bu bölüm, yazıyı güncelleme gerekçemiz.
        </p>
        <p>
          ClinicalTrials.gov kayıtlarında (27 Ekim 2026 itibarıyla) metforminin yaşlanma bağlamında sınandığı birkaç
          çalışma görünüyor <sup><a href="#kaynak-14" aria-label="Kaynak 14">[14]</a></sup>. İnsülin duyarlılığının metforminin yaşlanmayı yavaşlatma potansiyelini etkileyip
          etkilemediğine bakan 166 katılımcılı bir çalışma tamamlanmış (NCT04264897). Obezitesi olan yaşlı gazilerde
          yaşam tarzı müdahalesine eklenen metforminin kırılganlığa etkisini sınayan 114 katılımcılı bir çalışma da
          tamamlanmış (NCT04221750). Yatak istirahatinde kas sağlığına bakan 64 kişilik bir çalışmanın birincil
          tamamlanma tarihi Kasım 2026 (NCT03107884). Bu yazıyı hazırlarken bu çalışmaların sonuç makalelerini
          doğrulayamadık; yayımlandıkça yazıyı güncelleyeceğiz. Üçü de kısa süreli ve yerine geçen göstergelerle
          ilgili; ömür ya da hastalık sonlanımı değil.
        </p>
        <p>
          Sonuç ne zaman gelir? Bilmiyoruz. Sonuçlanmamış bir çalışmanın ne diyeceğini tahmin etmeyeceğim.
        </p>

        <h2 id="menopoz">Menopoz ve 40 sonrası: bildiklerimiz ve bilmediklerimiz</h2>
        <p>
          Kısa söyleyeyim: bu soruya doğrudan cevap veren bir çalışma bulamadık.
        </p>
        <p>
          Tarayabildiğimiz literatürde, menopoz geçişindeki kadınlarda metforminin yaşlanma ya da uzun yaşam
          sonlanımlarını sınayan randomize bir çalışma görmedik <Evidence level={1} />. Fare verisinde etki bazı
          analizlerde erkeklerde görüldü <sup><a href="#kaynak-5" aria-label="Kaynak 5">[5]</a></sup>; bu, kadınlar için doğrudan sonuç anlamına gelmez. MASTERS'a kadınlar da
          katıldı <sup><a href="#kaynak-1" aria-label="Kaynak 1">[1]</a></sup>; ama menopoz durumuna göre ayrı bir sonuç raporu görmedik.
        </p>
        <p>
          Menopozdaki bir kadın olarak metformin düşünüyorsanız, aslında iki ayrı soru var. Birincisi, tip 2 diyabet,
          prediyabet, gebelik diyabeti öyküsü, polikistik over sendromu ya da belirgin metabolik risk gibi, hekimin bir
          tanıya ya da risk faktörüne dayanarak metformin düşündüğü bir durum var mı? Bunların bir kısmı etiket
          dışıdır; ABD etiketindeki tek endikasyon tip 2 diyabettir <sup><a href="#kaynak-16" aria-label="Kaynak 16">[16]</a></sup>. Ama hekimin nedenini açıkça söyleyebildiği,
          hasta grubuna göre klinik kanıtı olan kullanımlardır. İkincisi, bunların hiçbiri yoksa ve yalnızca "uzun
          yaşam" için düşünülüyorsa, yukarıdaki tablolar geçerli. Birinci soru bir hekimle konuşulacak, tanıya dayalı bir
          konu; ikincisi bu yazının konusu.
        </p>

        <h2 id="hekimle">Hekiminizle konuşulacaklar</h2>
        <p>
          Doz vermiyorum, protokol de. Bunlar sorular.
        </p>
        <ul>
          <li><strong>Hedefiniz ne?</strong> "Uzun yaşam" bir hedef değil; kan şekeri, kilo, kas, kalp ya da bellek gibi ölçülebilir bir şeye bağlanabilir mi?</li>
          <li><strong>Başlamadan önce hangi bazal ölçümler?</strong> Kan şekeri (açlık glukozu, HbA1c) ve böbrek işlevi (kreatinin, eGFR) bu konuşmanın değişmez parçasıdır; duruma göre kan sayımı, karaciğer enzimleri ve B12 eklenir. Herkese aynı geniş tetkik listesi istenmez.</li>
          <li><strong>Aynı anda tek değişiklik.</strong> Birden çok yeni şeyi birlikte başlatırsanız hangisinin işe yarayıp yaramadığını anlayamazsınız.</li>
          <li><strong>Hangi belirtide bırakılacak?</strong> Önceden konuşulmuş bir ölçüt olsun.</li>
          <li><strong>İlaç kaynağı.</strong> Reçeteyle, eczaneden alınan ilaç dışında bir kaynağı kullanmak yanlış üründen zarar riskini artırır.</li>
        </ul>

        <h2 id="guclu-yollar">Aynı hedef için kanıtı daha güçlü yollar</h2>
        <p>
          Vaaz vermeyeceğim; yalnızca karşılaştırma.
        </p>
        <p>
          Hedefiniz kas ve işlevse, düzenli direnç egzersizi bu yazıdaki en sağlam dayanaklardan biri: MASTERS
          çalışmasında plasebo grubu 14 haftada anlamlı kas kazandı <sup><a href="#kaynak-1" aria-label="Kaynak 1">[1]</a></sup>. Metformin bu listede onun yerine geçmedi;
          tersine, kazanımı azalttı. Kan basıncı, kan yağları, uyku ve sigara gibi konularda ise yerleşik rehberler var;
          onları bu yazının dışında, hekiminizle konuşmak daha doğru.
        </p>

        <h2 id="bilinmeyenler">Henüz bilmediklerimiz</h2>
        <p>
          Açık kalan sorular, bu yazının güncellenmesi gereken yerler.
        </p>
        <ul>
          <li>Diyabeti olmayanlarda ömür ya da hastalık sonlanımı.</li>
          <li>Kadınlarda ve menopoz geçişinde etki.</li>
          <li>Direnç egzersiziyle çakışmanın uzun süreli sonucu.</li>
          <li>Diyabetsizde uzun süreli kullanımın güvenlik profili.</li>
        </ul>
        <p>
          Bir ilacın dosyasının kalın olması, her soruya cevap verdiği anlamına gelmiyor. Eczanedeki aynı kutu, sormanız
          gereken sorulara göre başka bir kutu gibi davranıyor. Önce soruyu netleştirin; kutunun adı ondan sonra gelir.
        </p>
      </ArticleProsePanel>

      <ArticleFAQ id="sik-sorulanlar" title="Dr. Aksoy'a sorular" intro="Bu bölümde metforminin uzun yaşam amacıyla kullanımı ve güvenliğiyle ilgili sorulara kendi yanıtlarımı veriyorum." items={faqItems} class="mt-10" />

