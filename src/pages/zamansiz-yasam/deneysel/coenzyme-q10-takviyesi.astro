const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Coenzyme Q10 Hangi Durumda Klinik Kanıtlı, Hangi Durumda Reklam?';
const seoTitle = 'Coenzyme Q10: Kanıt mı Reklam mı?';
const articleDescription =
'CoQ10 takviyesi anti-aging reklamlarının favorisi; oysa kanıt tek hikaye değil. Statin yan etkisinde klinik kanıt var, anti-aging iddiasında sınırlı.';
