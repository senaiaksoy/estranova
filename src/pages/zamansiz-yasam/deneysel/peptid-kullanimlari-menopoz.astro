  { id: 'glp1-ayri', label: 'Kilo: GLP-1 ve Deneysel Peptidler' },
  { id: 'doku-kas', label: 'Doku ve Kas İddiaları' },
  { id: 'enerji-uyku-longevity', label: 'Enerji, Uyku ve Uzun Yaşam' },
