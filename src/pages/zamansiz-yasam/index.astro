---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuHero from '../../components/site/SubmenuHero.astro';
import SubmenuLinkCard from '../../components/site/SubmenuLinkCard.astro';
import SubmenuSection from '../../components/site/SubmenuSection.astro';
import SubmenuSpotlightCard from '../../components/site/SubmenuSpotlightCard.astro';
import EditorPickCard from '../../components/site/EditorPickCard.astro';
import MagazineTOC from '../../components/site/MagazineTOC.astro';
import CategoryRelatedLinks from '../../components/site/CategoryRelatedLinks.astro';
import Evidence from '../../components/site/Evidence.astro';
import ChapterMasthead from '../../components/site/ChapterMasthead.astro';
import EditorialEpigraph from '../../components/site/EditorialEpigraph.astro';
import ChapterCompass from '../../components/site/ChapterCompass.astro';
import HubStartingPath from '../../components/site/HubStartingPath.astro';
import { submenuHeroByRoute } from '../../data/submenu-heroes';
import { subHubEpigraphs } from '../../data/sub-hub-epigraphs';
import { hubStartingPaths } from '../../data/hub-starting-paths';

const hero = submenuHeroByRoute['/zamansiz-yasam']!;
const __hubPath = '/zamansiz-yasam';
const epigraph = subHubEpigraphs[__hubPath];
const startingPath = hubStartingPaths['/zamansiz-yasam'];

const pillars = [
  {
    step: '01',
    title: 'Vitaminler & Takviyeler',
    excerpt: 'D vitamini, Omega-3, mineraller, kolajen ve daha fazlası.',
    href: '/zamansiz-yasam/vitaminler',
    image: submenuHeroByRoute['/zamansiz-yasam/vitaminler']!,
  },
  {
    step: '02',
    title: 'Deneysel Yaklaşımlar',
    excerpt: 'NAD+, Peptidler, Ozon tedavisi: bilim ne diyor?',
    href: '/zamansiz-yasam/deneysel',
    image: submenuHeroByRoute['/zamansiz-yasam/deneysel']!,
  },
  {
    step: '03',
    title: 'Ameliyatsız Uygulamalar',
    excerpt: 'Lazer, HIFU, RF, PRP: kanıt düzeyiyle değerlendirme.',
    href: '/zamansiz-yasam/non-invaziv',
    image: submenuHeroByRoute['/zamansiz-yasam/non-invaziv']!,
  },
  {
    step: '04',
    title: 'Beslenme & Metabolizma',
    excerpt: 'İnsülin direnci, gut sağlığı, metabolik denge.',
    href: '/zamansiz-yasam/beslenme-yaslanma',
    image: submenuHeroByRoute['/zamansiz-yasam/beslenme-yaslanma']!,
  },
  {
    step: '05',
    title: 'Hareket & Vücut',
    excerpt: 'Kas kütlesi, esneklik, postür, nefes teknikleri.',
    href: '/zamansiz-yasam/hareket-saglik-menopoz',
    image: submenuHeroByRoute['/zamansiz-yasam/hareket-saglik-menopoz']!,
  },
];

const evidenceLevels = [5, 4, 3, 2, 1] as const;

const editorPick = {
  href: '/zamansiz-yasam/mevsimle-yemek-yemek',
  title: 'Mevsimle Yemek Yemek — Anadolu Sofrası 40 Sonrası',
  lede: 'Geçen perşembe sabahı tezgâha yeni gelen taze enginarlara bakarken aklıma takıldı: bedenimizin de her ay aynı şeyi aynı yoğunlukta istemesi neden beklensin?',
  writerSlug: 'gamze-cizreli',
  readingMinutes: 6,
  image: submenuHeroByRoute['/zamansiz-yasam/mevsimle-yemek-yemek']!,
};

const tocArticles = [
  {
    href: '/zamansiz-yasam/eklem-agrisi-menopoz',
    title: 'Menopozda Eklem Ağrısı — Sabah Tutukluğundan Hareketin Yatışına',
    excerpt:
      'Menopoz geçişinde sıkça görülen eklem ağrısının arkasındaki östrojen-kıkırdak ilişkisini, hareketin neden istirahatten daha çok iyileştirdiğini ve bu hafta denenebilecek sade adımları konuşan yaşıt tonlu rehber.',
    writerSlug: 'alara-baykent',
    readingMinutes: 7,
  },
  {
    href: '/zamansiz-yasam/kilo-artisi-menopoz',
    title: 'Menopozda Kilo Artışı — Aynı Yaşamda Değişen Bedenle Sakin Bir Sohbet',
    excerpt:
      'Menopoz geçişinde kilo artışının arkasındaki östrojen-yağ dağılımı ilişkisini, kas kütlesinin neden tartıdan daha belirleyici olduğunu ve diyet kültürüne kapılmadan denenebilecek küçük adımları konuşan yaşıt tonlu rehber.',
    writerSlug: 'berna-aksoy',
    readingMinutes: 9,
  },
  {
    href: '/zamansiz-yasam/seyahat-menopoz',
    title: 'Seyahatte Menopoz — Uçuş, Zaman Farkı ve Otel Odası Notları',
    excerpt:
      'Uzun uçuşlar, jet lag, sıcak basması ve yeni mutfak ritmi menopoz geçişinde seyahati nasıl şekillendirir? Bir yaşıt perspektifinden sakin notlar.',
    writerSlug: 'duygu-karaosmanoglu',
    readingMinutes: 7,
  },
  {
    href: '/zamansiz-yasam/kemik-sagligi-40-sonrasi',
    title: '40 Yaşından Sonra Kemik Sağlığı — Koruyucu Rehber',
    excerpt: 'D vitamini, kalsiyum, hareket ve düzenli izlem; kemik sağlığını uzun vadede korumak için günlük çerçeveler.',
    writerSlug: 'berna-aksoy',
    readingMinutes: 9,
  },
  {
    href: '/zamansiz-yasam/d-vitamini-rehberi',
    title: 'D Vitamini Rehberi — Tarama, Beslenme, Takviye',
    excerpt: 'D vitamini taraması, beslenme, güneş maruziyeti ve takviye planını dengeli biçimde ele alan kapsamlı rehber.',
    writerSlug: 'rima-erdemir',
    readingMinutes: 9,
  },
];
---

<SiteLayout
  title="Zamansız Yaşam - Estranova"
  description="Dinamik ve enerjik yaşlanmak için bilimsel bilgi. Vitaminlerden deneysel yaklaşımlara, kanıt düzeyiyle değerlendirilmiş içerikler."
>
  <SiteNavbar currentPath="/zamansiz-yasam" />

  <ChapterMasthead variant="section" chapter="Zamansız Yaşam" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Kategori"
      title="Zamansız Yaşam"
      lede="Dinamik ve enerjik yaşlanmak için bilimsel bilgi. Vitaminlerden deneysel yaklaşımlara, kanıt düzeyiyle değerlendirilmiş içerikler. Bu bölüm, anti-aging ve longevity başlıklarını sade bir çerçevede toplar."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />

    {startingPath && (
      <HubStartingPath
        kicker={startingPath.kicker}
        title={startingPath.title}
        intro={startingPath.intro}
        steps={startingPath.steps}
      />
    )}

    <SubmenuSection variant="cream" borderedTop={true}>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
        {
          pillars.map((p) => (
            <SubmenuLinkCard
              href={p.href}
              title={p.title}
              excerpt={p.excerpt}
              imageSrc={p.image.src}
              imageAlt={p.image.alt}
              step={p.step}
            />
          ))
        }
      </div>
    </SubmenuSection>

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Editör'ün Seçimi</p>
        <h2 class="font-serif text-3xl leading-tight md:text-4xl">Bu kategoriden bir okuma</h2>
      </header>

      <EditorPickCard
        href={editorPick.href}
        title={editorPick.title}
        lede={editorPick.lede}
        writerSlug={editorPick.writerSlug}
        readingMinutes={editorPick.readingMinutes}
        imageSrc={editorPick.image.src}
        imageAlt={editorPick.image.alt}
      />
    </SubmenuSection>

    <SubmenuSection variant="cream" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Bu Kategoride Okumalar</p>
        <h2 class="font-serif text-3xl leading-tight md:text-4xl">Sayının diğer başlıkları</h2>
      </header>

      <MagazineTOC items={tocArticles} />
    </SubmenuSection>

    {epigraph && <EditorialEpigraph quote={epigraph} />}

    <SubmenuSection variant="white" borderedTop={true}>
      <div class="rounded-[36px] border border-burgundy/12 bg-cream-warm p-8 shadow-sm ring-1 ring-black/5 md:p-12">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Kanıt Düzeyi</p>
        <h2 class="mb-4 font-serif text-4xl leading-tight md:text-5xl">İçeriklerimiz nasıl değerlendirilir?</h2>
        <p class="mb-8 max-w-3xl text-lg leading-relaxed text-ink/75">
          Bu kategorideki her makale bilimsel editör tarafından değerlendirilir. Kanıt düzeyi işaretleri, bilginin araştırma gücünü
          hızlıca görmenize yardımcı olur.
        </p>

        <div class="mb-8 space-y-3">
          {
            evidenceLevels.map((n) => (
              <div class="flex items-center gap-4 rounded-2xl bg-white/90 px-4 py-3 ring-1 ring-burgundy/12">
                <span class="w-24 shrink-0 text-sm font-semibold text-ink">Seviye {n}</span>
                <div class="h-2 flex-1 overflow-hidden rounded-full bg-cream-soft">
                  <div class="h-full rounded-full bg-burgundy" style={`width: ${n * 20}%`} />
                </div>
              </div>
            ))
          }
        </div>

        <div class="overflow-x-auto rounded-2xl ring-1 ring-burgundy/15">
          <table class="min-w-full border-collapse bg-white text-sm">
            <thead>
              <tr class="bg-cream-soft">
                <th class="px-4 py-3 text-left font-semibold text-ink">Seviye</th>
                <th class="px-4 py-3 text-left font-semibold text-ink">Gösterim</th>
                <th class="px-4 py-3 text-left font-semibold text-ink">Kısa Açıklama</th>
              </tr>
            </thead>
            <tbody class="text-ink/80">
              <tr class="border-t border-burgundy/15">
                <td class="px-4 py-3">Seviye 5</td>
                <td class="px-4 py-3 text-burgundy"><Evidence level={5} /></td>
                <td class="px-4 py-3">Yüksek düzeyde, tutarlı bilimsel kanıt.</td>
              </tr>
              <tr class="border-t border-burgundy/15">
                <td class="px-4 py-3">Seviye 4</td>
                <td class="px-4 py-3 text-burgundy"><Evidence level={4} /></td>
                <td class="px-4 py-3">Güçlü kanıt, sınırlı belirsizlikler bulunabilir.</td>
              </tr>
              <tr class="border-t border-burgundy/15">
                <td class="px-4 py-3">Seviye 3</td>
                <td class="px-4 py-3 text-burgundy"><Evidence level={3} /></td>
                <td class="px-4 py-3">Orta düzey kanıt, yeni verilerle güncellenebilir.</td>
              </tr>
              <tr class="border-t border-burgundy/15">
                <td class="px-4 py-3">Seviye 2</td>
                <td class="px-4 py-3 text-burgundy"><Evidence level={2} /></td>
                <td class="px-4 py-3">Sınırlı kanıt, dikkatli yorum gerekir.</td>
              </tr>
              <tr class="border-t border-burgundy/15">
                <td class="px-4 py-3">Seviye 1</td>
                <td class="px-4 py-3 text-burgundy"><Evidence level={1} /></td>
                <td class="px-4 py-3">Ön bilgi niteliğinde, araştırma erken aşamada.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </SubmenuSection>

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Öne Çıkanlar</p>
        <h2 class="mb-4 font-serif text-4xl leading-tight md:text-5xl">Öne Çıkan İçerikler</h2>
        <p class="text-lg leading-relaxed text-ink/75">
          Bu kategorideki popüler başlıklardan örnek içerikler.
        </p>
      </header>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <SubmenuSpotlightCard
          tag="Vitaminler"
          title="D Vitamini Takibi İçin Temel Notlar"
          body="Takviyeleri değerlendirirken günlük yaşam, beslenme ve test takibini birlikte ele alan rehber."
          href="/zamansiz-yasam/vitaminler/d-vitamini-rehberi"
        >
          <span slot="footer">Kanıt Düzeyi: <Evidence level={3} /></span>
        </SubmenuSpotlightCard>
        <SubmenuSpotlightCard
          highlight={true}
          tag="Deneysel Yaklaşımlar"
          title="NAD+ Hakkında Ne Biliyoruz?"
          body="Mevcut araştırmaları sadeleştiren ve beklenti yönetimini güçlendiren derleme içerik."
          href="/zamansiz-yasam/deneysel/nad-plus-takviyesi"
        >
          <span slot="footer">Kanıt Düzeyi: <Evidence level={3} /></span>
        </SubmenuSpotlightCard>
        <SubmenuSpotlightCard
          tag="Hareket & Vücut"
          title="Kas Kütlesini Destekleyen Rutin"
          body="Yaşla birlikte hareket planını sürdürülebilir biçimde kurmak için pratik bir başlangıç çerçevesi."
          href="/zamansiz-yasam/hareket-saglik-menopoz"
        >
          <span slot="footer">Kanıt Düzeyi: <Evidence level={3} /></span>
        </SubmenuSpotlightCard>
      </div>
    </SubmenuSection>

    <SubmenuSection variant="sand" borderedTop={true}>
      <CategoryRelatedLinks exclude="/zamansiz-yasam" />
    </SubmenuSection>

    <ChapterCompass nextHref="/zamansiz-yasam/vitaminler" nextNumber="01" nextChapter="Vitaminler" nextParent="Zamansız Yaşam" />
  </main>

  <SiteFooter />
</SiteLayout>
