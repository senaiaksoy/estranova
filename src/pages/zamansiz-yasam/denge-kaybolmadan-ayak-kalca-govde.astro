---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuHero from '../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../components/site/ArticleAuthorBlock.astro';
import SaveForLaterButton from '../../components/site/SaveForLaterButton.astro';
import ReadingControls from '../../components/site/ReadingControls.astro';
import RedFlagBox from '../../components/site/RedFlagBox.astro';
import ArticleTOC from '../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../components/site/ArticleSummary.astro';
import Evidence from '../../components/site/Evidence.astro';
import RelatedReadings from '../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../components/site/ArticleFAQ.astro';
import { submenuHeroByRoute } from '../../data/submenu-heroes';
import { articleFaqs } from '../../data/article-faqs';
import { buildArticleSchemas } from '../../utils/article-schema';
import { resolveSiteUrl } from '../../utils/seo';

const pathname = '/zamansiz-yasam/denge-kaybolmadan-ayak-kalca-govde/';
const hero = submenuHeroByRoute['/zamansiz-yasam/']!;
const faqItems = articleFaqs[pathname] ?? [];

const tocEntries = [
  { id: 'denge-kaybolmadan', label: 'Denge Kaybolmadan' },
  { id: 'ayak-tabani', label: 'Ayak Tabanı' },
  { id: 'kalca-cevresi', label: 'Kalça Çevresi' },
  { id: 'govde-hatti', label: 'Gövde Hattı' },
  { id: 'ev-ici-ipucu', label: 'Ev İçi İpucu' },
  { id: 'ne-zaman-destek', label: 'Ne Zaman Destek?' },
  { id: 'sik-sorulanlar', label: 'Sıkça Sorulanlar' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Denge ve Ayak: Kalça ile Gövde Hattını Yeniden Duymak';
const seoTitle = 'Denge ve Ayak: Kalça-Gövde Hattı';
const articleDescription =
  '40 sonrasında dengeyi düşmeden önce okumak: ayak tabanı, ayak sağlığı, kalça çevresi, gövde kontrolü ve ev içindeki küçük işaretler hareket güvenini anlatır.';
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'ersin-sarac',
  articleType: 'editorial-guide',
  publishedDate: '1 Haziran 2026',
  modifiedDate: '21 Ekim 2026',
  pathname,
  articleSection: 'Zamansız Yaşam',
  sectionPath: '/zamansiz-yasam/',
  keywords: [
    'denge',
    'denge ayak',
    'ayak sağlığı',
    '40 sonrası hareket',
    'düşme önleme',
    'ayak tabanı',
    'kalça kasları',
    'gövde kontrolü',
    'fizyoterapi',
    'kas-iskelet sağlığı',
  ],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/zamansiz-yasam/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Hareket"
      title={articleTitle}
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="ersin-sarac"
        articleType="editorial-guide"
        publishedDate="1 Haziran 2026"
        lastUpdated="21 Ekim 2026"
        readingMinutes={7}
        imageSrc="/images/library/editorial/ersin-denge-ayak-kalca-govde-byline.webp"
        imageAlt="Ev koridorunda duvara hafifçe temas ederek dengesini fark eden 40+ kadın; ayak, kalça ve gövde hattını yeniden duyma temasını taşıyan sakin editoryal görsel"
        imagePosition="48% center"
      />

      <div class="flex flex-wrap items-center justify-end gap-3">
        <ReadingControls />
        <SaveForLaterButton slug={pathname} title={articleTitle} />
      </div>

      <ArticleSummary title="Kısa Özet">
        <p>
          Denge, genellikle ancak kaybolduğunda fark edilen bir güven duygusudur. Oysa fizyoterapi bakışında denge; ayak
          tabanı, ayak sağlığı, kalça çevresi, gövde kontrolü ve günlük alışkanlıkların birlikte kurduğu bir destek
          hattıdır. Bu yazı, düşmeyi beklemeden dengeyi okumanıza ve hangi durumlarda profesyonel değerlendirme almanın
          yerinde olacağını ayırt etmenize yardımcı olur.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="denge-kaybolmadan">Denge Kaybolmadan Önce Küçük İşaretler Gelir</h2>
        <p>
          Çoğu kişi dengeyi ancak kaybolduğunda fark eder. Oysa uyarı çok daha önce, usulca gelir.
        </p>
        <p>
          Denge yalnızca tek ayak üzerinde durabilmek demek olmaz. Yön değiştirirken, merdivenden inerken, karanlık
          koridorda yürürken ve bir eşyaya uzanırken bedenin fark edilmeden yaptığı ayarlardır. Yürüyüşte dengeyi bozan
          küçük sapmalar çoğu zaman düşmeden önce görünür.
        </p>
        <p>
          40 sonrasında denge sistemini yalnızca yaşlılık konusu saymak, konuşmayı geciktirir. Kas kuvveti, eklem hareket
          açıklığı, görme, ayak bileği kontrolü, iç kulaktaki denge organı ve dikkat aynı tabloya katılır
          <Evidence from={4} to={5} />. Küçük bir dengesizlik hissi, düşmeden önce gelen değerli bir uyarı olabilir.
        </p>
        <p>
          Önce şunu söyleyeyim: dengesizlik hissi sizi zayıf yapmaz, size bilgi verir. Değerlendirmelerde sık duyduğum bir
          tarif var: düşmedim ama düşecek gibi oldum. Arkasında çoğu zaman bir korku bulunur. Merdivenden kaçınmak, evden
          az çıkmak, hareketi azaltmak. Bu korkuyu anlıyorum. Yine de çözüm hareketi bırakmak olmuyor. Bedeni dinleyerek
          ilerlemek, nerede güvensiz kaldığını fark edip daha güvenli bir zemin kurmak demektir. Küçük adımların gücü de
          burada başlar: büyük bir egzersiz listesi yerine doğru halkayı bulmak.
        </p>
        <p>
          Fizyoterapi değerlendirmesinde büyük testlerden önce bu küçük geçişlere bakılır: tek ayak üzerinde çorap
          giyerken duvara hafifçe dokunmak, ayakkabı bağlarken oturacak yer aramak, kapıdan çıkmadan önce çantayı diğer
          omza almak. Bunlar tek başına sorun anlamına gelmez; ama bedenin hangi noktada destek istediğini gösterir.
          Sizde bu işaret bambaşka bir anda belirebilir. Önemli olan onu panikle değil, bilgi olarak karşılamaktır.
        </p>

        <h2 id="ayak-tabani">Ayak Tabanı Zemini İlk Okuyan Yerdir</h2>
        <p>
          Denge sık sık yukarıda, başta ya da gövdede aranır. İlk bilgi ise çoğu kez ayaktan gelir.
        </p>
        <p>
          Zeminle temas, bedene nerede olduğunu söyleyen ilk duyudur. Dengeyi ayaktan okumak, konuya aşağıdan yukarıya
          bakmak demektir.
        </p>
        <p>
          Ayak bileği hareketi, parmakların zemini kavrama becerisi, taban duyusu ve ayakkabı seçimi günlük dengeyi
          etkileyebilir <Evidence level={4} />. Ev içinde sık takılmak, halı kenarında güvensiz hissetmek, çıplak ayakta
          daha iyi ya da daha kötü dengelenmek küçük ama işe yarar ipuçları verir.
        </p>
        <p>
          Bu yüzden dengeyi konuşurken yalnızca “başım dönüyor mu?” diye sormam. “Ayağınız zemini ne kadar net
          hissediyor?” sorusu en az onun kadar öğreticidir.
        </p>

        <h2 id="kalca-cevresi">Kalça Çevresi Ana Destek Hattıdır</h2>
        <p>
          Kalça çevresi her adımda sizi yana, öne ve arkaya savrulmaktan korur. Çalışırken fark edilmez; zayıfladığında
          denge daha kırılgan hissedilir.
        </p>
        <p>
          Merdiven inerken dizin içe kaçması, yürüyüşte kalçanın düşmesi, tek ayakta dururken gövdenin yana yatması
          veya uzun yürüyüşten sonra bel-kalça hattında yorgunluk oluşması kalça çevresinin daha yakından
          değerlendirilmesi gerektiğini düşündürebilir <Evidence level={4} />.
        </p>
        <p>
          Hedef sert bir güç gösterisi olmuyor. Güvenli denge küçük, kontrollü ve tekrar edilebilir hareketlerle
          gelişir. Fizyoterapide iyi başlangıç, kası zorlamak kadar hareketin kalitesini görmektir. Kısa ama düzenli bir
          çalışma, düzensiz büyük hamlelerden daha sürdürülebilir olur.
        </p>

        <h2 id="govde-hatti">Gövde Hattı Dengeyi Taşır</h2>
        <p>
          Gövde kontrolü, denge sisteminin merkezindeki düzenleyicidir. Bel, karın, sırt ve nefes birlikte çalışmadığında
          küçük yön değişiklikleri bile daha fazla efor ister.
        </p>
        <p>
          Gövde kontrolü yalnızca karın kası meselesi olmuyor. Nefes, kaburga hareketi, pelvis pozisyonu ve omurga
          hareketliliği aynı hatta yer alır <Evidence level={3} />. Masa başı günler, uzun süreli oturma ve tek taraflı
          çanta taşıma bu hattı daha gergin ve daha az esnek hale getirebilir.
        </p>
        <p>
          Denge çalışmaları bazen ayakta başlar. Bazen nefes, ağırlık aktarımı ve yavaş yön değiştirme gibi daha küçük
          farkındalıklarla başlar. Kendini güvende hisseden bir beden daha iyi organize olur.
        </p>

        <h2 id="ev-ici-ipucu">Ev İçindeki Küçük Zorlanmalar Dengeyi Gösterir</h2>
        <p>
          Dengeyi yalnızca egzersiz sırasında ölçmek yetmez. Ev, günlük hayatın doğal testi gibi çalışır.
        </p>
        <p>
          Gece tuvalete kalkarken duvara dokunma ihtiyacı, çorap giyerken oturmadan duramama, merdiven inerken trabzana
          güçlü tutunma, yerden bir şey alırken güvensizlik veya kalabalık sokakta yön değiştirirken tedirginlik dikkat
          edilmeye değer işaretlerdir.
        </p>
        <p>
          Ev düzeni de tabloya dahildir. Kayan halılar, zayıf ışık, dar geçişler, kablolar, kaygan terlikler ve sık
          kullanılan eşyaların çok yukarıda durması düşme riskini artırabilir <Evidence level={4} />. Denge çalışmasının
          ilk adımı bazen, evi size daha az tuzak kuran bir yere çevirmektir.
        </p>

        <h2 id="ne-zaman-destek">Destek Almanın Doğru Olduğu Anlar</h2>
        <p>
          Her küçük dengesizlik acil bir sorun olmaz. Bazı işaretler ise evde dikkat etmekle yetinmemeyi gerektirir.
        </p>

        <RedFlagBox
          title="Denge yakınmasında geciktirilmemesi gereken işaretler"
          intro="Aşağıdaki durumlar fizyoterapi planından önce veya onunla birlikte tıbbi değerlendirme gerektirebilir."
          markers={[
            'Yeni başlayan belirgin baş dönmesi, bayılma hissi veya düşme',
            'Düşme sonrası kalça, bel, el bileği ya da baş bölgesinde şiddetli ağrı',
            'Uyuşma, güç kaybı, konuşma bozulması, görme değişikliği veya yüz-kol-bacakta ani güçsüzlük',
            'Ateş, açıklanamayan kilo kaybı, gece uykusunu bölen ağrı veya giderek artan dengesizlik',
          ]}
          footnote="Bu liste tanı koymaz; daha hızlı değerlendirme gerektirebilecek işaretleri görünür kılar."
        />

        <p>
          Daha hafif tablolarda fizyoterapi değerlendirmesi; ayak bileği hareketini, kalça gücünü, gövde kontrolünü,
          yürüme biçimini ve ev içi riskleri birlikte okumaya yardımcı olabilir. Amaç, size uyan halkayı bulmaktır; hazır
          bir egzersiz listesine sığmanız gerekmez.
        </p>
        <p>
          Denge kaybolmadan konuşulduğunda konu korku olmaktan çıkar, güvene döner. En doğru başlangıç bazen bir program
          olmaz; ayak tabanından kalçaya, gövdeden nefese bedenin küçük işaretlerini ciddiye alan, dikkatli bir gündelik
          ritim olur.
        </p>
      </ArticleProsePanel>

      <ArticleFAQ id="sik-sorulanlar" items={faqItems} class="mt-10" />

      <RelatedReadings
        class="mt-14"
        paths={[
          '/zamansiz-yasam/40-sonrasi-harekete-yeniden-baslamak/',
          '/zamansiz-yasam/40-sonrasi-kas-iskelet-agrilari/',
          '/zamansiz-yasam/kemik-gucu-kirigi-beklemeden-sorulacak-sorular/',
          '/zihin-denge/uyku-dinlenme/aksam-hareketi-uyku-melatonin/',
        ]}
      />

      <ArticleEditorNote class="mt-14" reviewerForWriter="ersin-sarac" reviewedDate="21 Ekim 2026">
        <p class="mb-4 text-lg font-semibold text-ink">Kanıt Düzeyi: <Evidence from={4} to={5} /></p>
        <p>
          Düşme riski, kas kuvveti, denge eğitimi ve ev içi güvenlik düzenlemeleri 40 sonrası hareket kapasitesi ve
          uzun vadeli bağımsızlık açısından birlikte ele alınmalıdır. Denge çalışmaları kişisel risk, ağrı, kemik
          sağlığı ve nörolojik bulgularla uyumlu planlandığında daha güvenli ilerler.
        </p>
        <p>
          <strong>Klinik sınır:</strong> Bu yazı kişisel egzersiz reçetesi yerine genel hareket okuryazarlığı sunar.
          Düşme, yeni nörolojik bulgu, bayılma, üzerine basamama, travma sonrası ağrı veya hızla artan dengesizlik
          varsa bireysel değerlendirme geciktirilmemelidir.
        </p>
        <p>
          <strong>Pratik bütünleşim:</strong> Ayak tabanı, kalça çevresi ve gövde hattı ayrı başlıklar gibi görünse de
          günlük hayatta tek bir hareket güvenliği sistemi gibi çalışır.
        </p>
        <p class="mt-4 border-t border-gold/30 pt-3 text-sm italic text-primary">
          — Estranova Bilimsel Editör Notu
        </p>
      </ArticleEditorNote>

      <ArticleDisclaimer class="mt-10">
        <p>
          Bu içerik genel bilgilendirme amaçlıdır. Tanı, tedavi, rehabilitasyon veya kişisel egzersiz programı yerine
          geçmez. Denge kaybı, düşme, baş dönmesi, ağrı, nörolojik belirti veya mevcut hastalıklarınız varsa kişisel
          planınızı sağlık profesyoneliyle birlikte değerlendiriniz.
        </p>
      </ArticleDisclaimer>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
