  { id: 'kaynaklar', label: 'Kaynaklar' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = '40 Yaşından Sonra Kemik Sağlığı — Koruyucu Rehber';
const seoTitle = '40 Sonrası Kemik Sağlığı — Rehber';
const articleDescription = '40 yaş sonrası kemik sağlığını desteklemek için tarama, beslenme, hareket ve tıbbi seçenekleri anlatan kapsamlı rehber.';
const pathname = '/zamansiz-yasam/kemik-sagligi-40-sonrasi/';
const hero = submenuHeroByRoute[pathname] ?? submenuHeroByRoute['/zamansiz-yasam/']!;
const faqItems = articleFaqs[pathname] ?? [];
const articleSchemas = buildArticleSchemas({
