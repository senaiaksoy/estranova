---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuSection from '../../../components/site/SubmenuSection.astro';
import SubmenuLinkCard from '../../../components/site/SubmenuLinkCard.astro';
import ChapterMasthead from '../../../components/site/ChapterMasthead.astro';
import EditorialEpigraph from '../../../components/site/EditorialEpigraph.astro';
import ChapterCompass from '../../../components/site/ChapterCompass.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { chapterMap, getNextChapter } from '../../../data/chapter-map';
import { subHubEpigraphs } from '../../../data/sub-hub-epigraphs';

const hero = submenuHeroByRoute['/zamansiz-yasam/vitaminler']!;
const __path = '/zamansiz-yasam/vitaminler';
const chapter = chapterMap[__path]!;
const epigraph = subHubEpigraphs[__path];
const next = getNextChapter(__path);

const articles = [
  {
    href: '/zamansiz-yasam/vitaminler/d-vitamini-rehberi',
    title: 'D Vitamini Rehberi',
    excerpt:
      'D vitamininin kemik sağlığı, kas işlevi ve genel iyi oluşla ilişkisi; günlük ihtiyaç, kaynaklar ve takviye konusunda dengeli bir okuma.',
    image: submenuHeroByRoute['/zamansiz-yasam/vitaminler']!,
  },
  {
    href: '/zamansiz-yasam/beslenme-yaslanma',
    title: 'Beslenme ve Yaşlanma',
    excerpt:
      'Mikro besinleri tek başına değil, beslenme bütünü içinde okumak için temel bir çerçeve; protein, lif ve mineral dengesinin neden önemli olduğunu ele alıyoruz.',
    image: submenuHeroByRoute['/zamansiz-yasam/beslenme-yaslanma']!,
  },
];

const neighbors = [
  {
    href: '/zamansiz-yasam/deneysel',
    title: 'Deneysel Yaklaşımlar',
    excerpt: 'Henüz standart öneri olmayan ancak araştırılan başlıklar; kanıt düzeyiyle değerlendirilmiş içerikler.',
  },
  {
    href: '/zamansiz-yasam/non-invaziv',
    title: 'Non-invaziv Uygulamalar',
    excerpt: 'Ameliyat veya enjeksiyon gerektirmeyen yaklaşımlar üzerine editöryal çerçeve.',
  },
  {
    href: '/zamansiz-yasam/hareket-saglik-menopoz',
    title: 'Hareket ve Sağlık',
    excerpt: 'Düzenli hareketin kemik, kas ve metabolik denge üzerindeki etkilerini ele alan rehber.',
  },
];
---

<SiteLayout
  title="Vitaminler ve Takviyeler - Estranova"
  description="D vitamini ve seçilmiş takviye konularında kanıt odaklı zamansız yaşam içerikleri."
>
  <SiteNavbar currentPath="/zamansiz-yasam" />
  <ChapterMasthead number={chapter.number} parent={chapter.parent} chapter={chapter.chapter} />

  <main id="main-content" class="text-[#2D2D2D]">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Vitaminler"
      title="Vitaminler ve Takviyeler"
      lede="Bu alt başlıkta vitaminleri tek bir hap olarak değil, beslenme ve günlük alışkanlıkların bir parçası olarak okuyoruz. Şu an için D vitamini üzerine derinlemesine bir rehber yayında."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />

    <section class="border-b border-[#6B2D3E]/10 bg-[#FDF8F0] px-6 py-12 md:py-16">
      <div class="mx-auto max-w-6xl">
        <nav class="mb-8 text-sm text-[#2D2D2D]/60" aria-label="İçerik yolu">
          <ol class="flex flex-wrap items-center gap-2">
            <li>
              <a href="/zamansiz-yasam" class="font-medium text-[#6B2D3E] hover:underline">Zamansız Yaşam</a>
            </li>
            <li aria-hidden="true">/</li>
            <li class="font-medium text-[#2D2D2D]">Vitaminler</li>
          </ol>
        </nav>

        <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-start lg:gap-16">
          <div>
            <p class="mb-5 text-lg leading-relaxed text-[#2D2D2D]/82 md:text-xl">
              Vitamin denildiğinde aklımıza ilk olarak bir kutu hap geliyor; oysa pek çoğumuz için asıl soru,
              günlük yemek tabağımızın bizi nasıl beslediği. Bu bölüm vitaminleri o bütün içinde okumaya
              davet ediyor: ne zaman gerçekten takviye gerek, ne zaman beslenme yeter?
            </p>
            <p class="text-base leading-relaxed text-[#2D2D2D]/72">
              Aşağıdaki rehberler kanıt düzeyini görünür kılarak yazılır. Bireysel takviye kararı her zaman
              hekiminizle veya bir diyetisyenle birlikte verilmelidir.
            </p>
          </div>

          <aside
            class="rounded-[28px] border border-[#6B2D3E]/15 bg-white p-7 shadow-sm md:p-8"
            aria-labelledby="vitaminler-ozet-baslik"
          >
            <h2 id="vitaminler-ozet-baslik" class="mb-4 font-serif text-xl text-[#2D2D2D]">Bu konuda sık sorulanlar</h2>
            <ul class="space-y-4 text-sm leading-relaxed text-[#2D2D2D]/78">
              <li class="border-b border-[#6B2D3E]/10 pb-4">
                <span class="block font-semibold text-[#2D2D2D]">Takviye ne zaman gerekir?</span>
                Beslenmeyle yetersiz alındığında veya hekim önerirse; gelişigüzel kullanım önerilmez.
              </li>
              <li class="border-b border-[#6B2D3E]/10 pb-4">
                <span class="block font-semibold text-[#2D2D2D]">Tek başına D vitamini yeterli mi?</span>
                Kemik sağlığı için yeterli değil; kalsiyum, hareket ve dengeli beslenmeyle birlikte değerlendirilir.
              </li>
              <li>
                <span class="block font-semibold text-[#2D2D2D]">Kanıt düzeyi nasıl okunmalı?</span>
                Rehberlerimizde güçlü ve sınırlı kanıt etiketleriyle gösterilir; karar bu çerçevede şekillenir.
              </li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    {epigraph && <EditorialEpigraph quote={epigraph} />}

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">İçerikler</p>
        <h2 class="mb-4 font-serif text-3xl leading-tight md:text-4xl">Yayında olan rehberler</h2>
        <p class="text-lg leading-relaxed text-[#2D2D2D]/75">
          Şu an için D vitamini üzerine derinlemesine bir rehber ile beslenme bütününe dair temel bir okuma
          mevcut. Yeni başlıklar editöryal takvimde.
        </p>
      </header>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          articles.map((a) => (
            <SubmenuLinkCard
              href={a.href}
              title={a.title}
              excerpt={a.excerpt}
              imageSrc={a.image.src}
              imageAlt={a.image.alt}
              cta="Rehberi oku"
            />
          ))
        }
      </div>
    </SubmenuSection>

    <SubmenuSection variant="cream" borderedTop={true}>
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">Aynı kategoride</p>
      <h2 class="mb-8 font-serif text-2xl md:text-3xl">İlgili alt başlıklar</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          neighbors.map((n) => (
            <a
              href={n.href}
              class="group rounded-[26px] border border-[#6B2D3E]/12 bg-white p-7 transition hover:border-[#6B2D3E]/28 hover:shadow-sm"
            >
              <h3 class="mb-2 font-serif text-xl text-[#2D2D2D] group-hover:text-[#6B2D3E]">{n.title}</h3>
              <p class="mb-4 text-sm leading-relaxed text-[#2D2D2D]/72">{n.excerpt}</p>
              <span class="text-sm font-semibold text-[#6B2D3E] group-hover:underline">Sayfaya git →</span>
            </a>
          ))
        }
      </div>
    </SubmenuSection>

    <ChapterCompass nextHref={next?.href} nextNumber={next?.number} nextChapter={next?.chapter} nextParent={next?.parent} />
  </main>

  <SiteFooter />
</SiteLayout>
