---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuSection from '../../../components/site/SubmenuSection.astro';
import EditorPickCard from '../../../components/site/EditorPickCard.astro';
import MagazineTOC from '../../../components/site/MagazineTOC.astro';
import ChapterMasthead from '../../../components/site/ChapterMasthead.astro';
import EditorialEpigraph from '../../../components/site/EditorialEpigraph.astro';
import ChapterCompass from '../../../components/site/ChapterCompass.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { chapterMap, getNextChapter } from '../../../data/chapter-map';
import { subHubEpigraphs } from '../../../data/sub-hub-epigraphs';

const hero = submenuHeroByRoute['/zamansiz-yasam/vitaminler']!;
const __path = '/zamansiz-yasam/vitaminler';
const chapter = chapterMap[__path]!;
const epigraph = subHubEpigraphs[__path];
const next = getNextChapter(__path);

const editorPick = {
  href: '/zamansiz-yasam/d-vitamini-rehberi',
  title: 'D Vitamini Rehberi — Tarama, Dozaj ve Bireysel Karar',
  lede: '"Vitamin" adı yanıltıcı — biyolojik olarak hormon gibi davranıyor; bu yüzden dozaj ve takip kararı bireysel. Baseline 25-OH-D, kişiselleştirilmiş takvim ve eşlik eden tabloların değerlendirmesi.',
  writerSlug: 'senai-aksoy',
  readingMinutes: 9,
  image: submenuHeroByRoute['/zamansiz-yasam/d-vitamini-rehberi'] ?? submenuHeroByRoute['/zamansiz-yasam/vitaminler']!,
};

const tocArticles = [
  {
    href: '/zamansiz-yasam/beslenme-yaslanma',
    title: 'Beslenme ve Yaşlanma',
    excerpt: 'Mikro besinleri tek başına değil, beslenme bütünü içinde okumak için temel bir yol; protein, lif ve mineral dengesinin neden önemli olduğunu ele alıyoruz.',
    writerSlug: 'berna-aksoy',
    readingMinutes: 8,
  },
];

const neighbors = [
  {
    step: '01',
    href: '/zamansiz-yasam/deneysel',
    title: 'Deneysel Yaklaşımlar',
    excerpt: 'Henüz standart öneri olmayan ancak araştırılan başlıklar; kanıt düzeyiyle değerlendirilmiş içerikler.',
  },
  {
    step: '02',
    href: '/zamansiz-yasam/non-invaziv',
    title: 'Ameliyatsız Uygulamalar',
    excerpt: 'Ameliyat veya enjeksiyon gerektirmeyen yaklaşımlar üzerine editöryal rehber.',
  },
  ];
---

<SiteLayout
  title="Vitaminler ve Takviyeler - Estranova"
  description="D vitamini ve seçilmiş takviye konularında kanıt odaklı zamansız yaşam içerikleri."
>
  <SiteNavbar currentPath="/zamansiz-yasam" />
  <ChapterMasthead number={chapter.number} parent={chapter.parent} chapter={chapter.chapter} />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Vitaminler"
      title="Vitaminler ve Takviyeler"
      lede="Bu alt başlıkta vitaminleri tek bir hap olarak değil, beslenme ve günlük alışkanlıkların bir parçası olarak okuyoruz. Şu an için D vitamini üzerine derinlemesine bir rehber yayında."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />

    <section class="border-b border-burgundy/10 bg-[#fffaf0] px-6 py-14 md:py-18">
      <div class="mx-auto max-w-6xl">
        <nav class="mb-8 text-sm text-ink/60" aria-label="İçerik yolu">
          <ol class="flex flex-wrap items-center gap-2">
            <li>
              <a href="/zamansiz-yasam" class="font-medium text-burgundy hover:underline">Zamansız Yaşam</a>
            </li>
            <li aria-hidden="true">/</li>
            <li class="font-medium text-ink">Vitaminler</li>
          </ol>
        </nav>

        <div class="grid gap-12 lg:grid-cols-[1.12fr_0.88fr] lg:items-start lg:gap-16">
          <div>
            <p class="mb-6 max-w-3xl font-serif text-3xl italic leading-tight text-burgundy md:text-5xl">
              Takviye sorusu, çoğu zaman kutudan önce tabağın ve kan değerinin sorusudur.
            </p>
            <p class="mb-5 text-lg leading-relaxed text-ink/82 md:text-xl">
              Vitamin denildiğinde aklımıza ilk olarak bir kutu hap geliyor; oysa pek çoğumuz için asıl soru,
              günlük yemek tabağımızın bizi nasıl beslediği. Bu bölüm vitaminleri o bütün içinde okumaya
              davet ediyor: ne zaman gerçekten takviye gerek, ne zaman beslenme yeter?
            </p>
            <p class="text-base leading-relaxed text-ink/72">
              Aşağıdaki rehberler kanıt düzeyini görünür kılarak yazılır. Bireysel takviye kararı her zaman
              hekiminizle veya bir diyetisyenle birlikte verilmelidir.
            </p>
          </div>

          <aside
            class="border-y border-burgundy/15 bg-white/62 p-7 md:p-8"
            aria-labelledby="vitaminler-ozet-baslik"
          >
            <h2 id="vitaminler-ozet-baslik" class="mb-5 font-serif text-3xl leading-tight text-ink">Bu konuda sık sorulanlar</h2>
            <ul class="space-y-4 text-sm leading-relaxed text-ink/78">
              <li class="border-b border-burgundy/10 pb-4">
                <span class="block font-semibold text-ink">Takviye ne zaman gerekir?</span>
                Beslenmeyle yetersiz alındığında veya hekim önerirse; gelişigüzel kullanım önerilmez.
              </li>
              <li class="border-b border-burgundy/10 pb-4">
                <span class="block font-semibold text-ink">Tek başına D vitamini yeterli mi?</span>
                Kemik sağlığı için yeterli değil; kalsiyum, hareket ve dengeli beslenmeyle birlikte değerlendirilir.
              </li>
              <li>
                <span class="block font-semibold text-ink">Kanıt düzeyi nasıl okunmalı?</span>
                Rehberlerimizde güçlü ve sınırlı kanıt etiketleriyle gösterilir; karar da buna göre şekillenir.
              </li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    {epigraph && <EditorialEpigraph quote={epigraph} />}

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-12 grid gap-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-end">
        <p class="text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Editör'ün Seçimi</p>
        <h2 class="font-serif text-4xl leading-[0.95] tracking-[-0.04em] md:text-6xl">Bu evreden bir okuma</h2>
      </header>

      <EditorPickCard
        href={editorPick.href}
        title={editorPick.title}
        lede={editorPick.lede}
        writerSlug={editorPick.writerSlug}
        readingMinutes={editorPick.readingMinutes}
        imageSrc={editorPick.image.src}
        imageAlt={editorPick.image.alt}
      />
    </SubmenuSection>

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-12 grid gap-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-end">
        <p class="text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Bu Evrede Okumalar</p>
        <h2 class="font-serif text-4xl leading-[0.95] tracking-[-0.04em] md:text-6xl">Sayının diğer başlıkları</h2>
      </header>

      <MagazineTOC items={tocArticles} />
    </SubmenuSection>

    <SubmenuSection variant="cream" borderedTop={true}>
      <header class="mb-10 grid gap-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-end">
        <p class="text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Aynı kategoride</p>
        <h2 class="font-serif text-4xl leading-[0.95] tracking-[-0.04em] md:text-6xl">İlgili alt başlıklar</h2>
      </header>
      <div class="divide-y divide-burgundy/14 border-y border-burgundy/14">
        {
          neighbors.map((n) => (
            <a
              href={n.href}
              class="group grid gap-5 py-7 transition hover:bg-white/58 md:grid-cols-[88px_1fr_auto] md:items-center md:py-8"
            >
              <span class="font-serif text-3xl italic text-gold">{n.step}</span>
              <div>
                <h3 class="mb-2 font-serif text-3xl leading-tight text-ink group-hover:text-burgundy">{n.title}</h3>
                <p class="max-w-2xl text-sm leading-relaxed text-ink/72">{n.excerpt}</p>
              </div>
              <span class="text-2xl text-gold transition group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </SubmenuSection>

    <ChapterCompass nextHref={next?.href} nextNumber={next?.number} nextChapter={next?.chapter} nextParent={next?.parent} />
  </main>

  <SiteFooter />
</SiteLayout>
