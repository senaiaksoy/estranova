const hero =
  submenuHeroByRoute['/zamansiz-yasam/vitaminler/magnezyum-menopozda-ne-ise-yarar/']
  ?? submenuHeroByRoute['/zamansiz-yasam/vitaminler/']!;

const tocEntries = [
  { id: 'neden-bu-kadar-konusuluyor', label: 'Neden Bu Kadar Konuşuluyor?' },
  { id: 'uyku-icin-kanit', label: 'Uyku' },
  { id: 'kramp-ve-gerginlik', label: 'Gece Krampları' },
  { id: 'kabizlik', label: 'Kabızlık' },
  { id: 'stres-kaygi-carpinti', label: 'Stres, Kaygı, Çarpıntı' },
  { id: 'formlar', label: 'Form Seçimi' },
  { id: 'kimler-dikkatli-olmali', label: 'Kimler Dikkatli Olmalı' },
  { id: 'doktora-uc-soru', label: 'Görüşmeye Üç Soru' },
  { id: 'kapanis', label: 'Kapanış' },
