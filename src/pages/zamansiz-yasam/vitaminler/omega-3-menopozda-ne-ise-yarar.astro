---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import SaveForLaterButton from '../../../components/site/SaveForLaterButton.astro';
import ReadingControls from '../../../components/site/ReadingControls.astro';
import RedFlagBox from '../../../components/site/RedFlagBox.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../../components/site/ArticleFAQ.astro';
import { articleFaqs } from '../../../data/article-faqs';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { resolveSiteUrl } from '../../../utils/seo';

const hero = submenuHeroByRoute['/zamansiz-yasam/vitaminler/']!;

const tocEntries = [
  { id: 'hamsi-tezgahi', label: 'Hamsi Tezgâhı' },
  { id: 'kapsulde-ne-var', label: 'Kapsülde Ne Var' },
  { id: 'trigliserit-ve-kalp', label: 'Trigliserit ve Kalp' },
  { id: 'menopoz-vaatleri', label: 'Menopoz Vaatleri' },
  { id: 'kanit-merdiveni', label: 'Kanıt Merdiveni ve İddialar' },
  { id: 'guvenlik', label: 'Ritim, Kanama, Etkileşim' },
  { id: 'bilinmeyenler', label: 'Kadınlar ve Bilinmeyenler' },
  { id: 'karar-olcutleri', label: 'Karar Ölçütleri' },
  { id: 'kaynaklar', label: 'Kaynaklar' },
  { id: 'sik-sorulanlar', label: "Dr. Aksoy'a sorular" },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Omega-3 Menopozda Ne İşe Yarar?';
const articleImage = '/images/library/editorial/zy-omega-3-menopoz.webp';
const articleDescription =
  'Omega-3 trigliseridi düşürebilir; menopoz belirtilerindeki yararı belirsizdir. Takviyelerin ritim ve kanama riskleri ürüne ve doza göre değerlendirilir.';
const faqItems = articleFaqs['/zamansiz-yasam/vitaminler/omega-3-menopozda-ne-ise-yarar/'] ?? [];
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'senai-aksoy',
  articleType: 'clinical-guide',
  publishedDate: '30 Ekim 2026',
  image: articleImage,
  medicalReviewer: 'Dr. Alper Mumcu',
  pathname: '/zamansiz-yasam/vitaminler/omega-3-menopozda-ne-ise-yarar/',
  articleSection: 'Zamansız Yaşam · Vitaminler',
  sectionPath: '/zamansiz-yasam/',
  keywords: [
    'omega-3',
    'balık yağı',
    'menopoz',
    'trigliserit',
    'sıcak basması',
    'EPA',
    'DHA',
    'atriyal fibrilasyon',
    'takviye güvenliği',
  ],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${articleTitle} - Estranova`}
  description={articleDescription}
  image={articleImage}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/zamansiz-yasam/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Vitaminler"
      title="Omega-3 Menopozda Ne İşe Yarar?"
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="senai-aksoy"
        articleType="clinical-guide"
        medicalReviewer="Dr. Alper Mumcu"
        publishedDate="30 Ekim 2026"
        readingMinutes={12}
        imageSrc="/images/library/editorial/zy-omega-3-menopoz-byline.webp"
        imageAlt="Boğaz kıyısındaki bir balık tezgâhında, buz üstündeki hamsiyi gösterip gülen, deve tüyü paltolu kadın; yapay zekâ ile üretilmiş temsili görsel"
        imagePosition="50% 20%"
      />

      <div class="flex flex-wrap items-center justify-end gap-3">
        <ReadingControls />
        <SaveForLaterButton
          slug="/zamansiz-yasam/vitaminler/omega-3-menopozda-ne-ise-yarar/"
          title={articleTitle}
        />
      </div>

      <ArticleSummary title="Kısa Klinik Yanıt">
        <p>
          Omega-3 yağ asitlerinin insanda en sağlam gösterilen etkisi trigliseridi düşürmesi
          <sup><a href="#kaynak-1">[1]</a></sup> <sup><a href="#kaynak-2">[2]</a></sup>. Kalp hastalığı olmayan 25.871 orta yaş ve
          üzeri yetişkinde günde 1 g balık yağı beş yılda kalp krizi, inme ve kalp kaynaklı ölümden oluşan birleşik sonucu azaltmadı
          <sup><a href="#kaynak-3">[3]</a></sup>. Menopozdaki 355 kadınla yapılan çalışmada sıcak basması, uyku ve ruh hali
          plasebodan farklı değişmedi <sup><a href="#kaynak-4">[4]</a></sup>. En önemli güvenlik notu: kalp çalışmalarında
          atriyal fibrilasyon (bir ritim bozukluğu) riski arttı ve artış günde 1 g’ın üzerindeki dozlarda daha belirgindi
          <sup><a href="#kaynak-5">[5]</a></sup>. Ritim bozukluğunuz varsa, kan sulandırıcı kullanıyorsanız ya da ameliyat
          planınız varsa kapsülü kullanmaya hekiminize sormadan başlamayın.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="hamsi-tezgahi">Hamsi Tezgâhı ile Kapsül Şişesi</h2>
        <p>
          Ekim sonunda balıkçı tezgâhları gümüş rengine döner. Hamsi buz üstünde parlar, satıcı “taze, bugün geldi”
          diye seslenir.
        </p>
        <p>
          Ben de bu mevsimde o tezgâhın önünden geçerken adımlarını yavaşlatanlardanım. Evde ise çoğu mutfakta başka bir
          omega-3 kaynağı durur: buzdolabının kapağında yarısı içilmiş bir balık yağı şişesi ya da tezgâhta kapsül
          kutusu.
        </p>
        <p>
          Kırk yaşından sonra bu kutunun alınma nedeni değişir. Kimi kalbini korumak ister, kimi gece uyandıran sıcak
          basmasından, eklem sızısından ya da unutkanlıktan kurtulmak. Bir kutudan bu kadar çok şey beklenir.
        </p>
        <p>
          Merak etmeyin diye baştan yazayım: Haftada bir iki kez balık yemek iyi bir alışkanlık ve kalp sağlığı için
          önerilen bir düzen <sup><a href="#kaynak-6">[6]</a></sup>. Bu yazının sorusu tabaktaki balık değil, her gün yutulan
          kapsül. Onun karnesi daha karışık.
        </p>

        <h2 id="kapsulde-ne-var">Kapsülün İçinde Ne Var, Etiket Ne Söylüyor?</h2>
        <p>
          “Omega-3” tek bir madde sanılır. Oysa üç ayrı yağ asidinin ortak adı ve araştırmaların çoğu yalnızca ikisine
          bakıyor.
        </p>
        <p>
          EPA ve DHA balıkta ve balık yağında bulunur. ALA ise keten tohumu, ceviz ve bazı bitkisel yağlarda vardır. Kalp
          çalışmalarının büyük kısmı EPA ve DHA kapsülleriyle yapıldı; ALA ayrı incelendi ve sonuçları ayrı yorumlanıyor
          <sup><a href="#kaynak-1">[1]</a></sup>.
        </p>
        <p>
          Kutunun ön yüzünde “1000 mg balık yağı” yazması, içinde 1000 mg omega-3 olduğu demek değil. Asıl sayı arka
          yüzdeki EPA ve DHA miktarıdır. Ön yüz pazarlama, arka yüz bilgi verir.
        </p>
        <p>
          Etiket ile içerik de her zaman örtüşmüyor. Yeni Zelanda’da satılan 32 balık yağı ürünü incelendiğinde yalnızca
          üçünde etikette yazan kadar EPA ve DHA bulundu; ürünlerin çoğu önerilen bozulma (oksidasyon) sınırlarını aştı.
          Son kullanma tarihi, fiyat ve menşe kaliteyi öngörmedi <sup><a href="#kaynak-7">[7]</a></sup>. Bu tek ülkenin
          verisi; Türkiye piyasası için benzer bir analize ulaşamadık.
        </p>
        <p>
          Türkiye’de balık yağı takviye edici gıda olarak satılıyor. Tarım ve Orman Bakanlığı’nın 21 Ekim 2026 tarihli
          listesi 11 yaş ve üzeri için bir sınır koyuyor: takviyede günlük EPA ve DHA toplamı en fazla 5.000 mg
          <sup><a href="#kaynak-8">[8]</a></sup>. Bu sayı yasal üst sınır; kimse için hedef miktar sayılmaz. Ayrıca yüksek trigliserit
          tedavisinde kullanılan omega-3 içerikli reçeteli ilaçlar da ruhsatlı; bunlardan biri yalnızca saf EPA
          (ikosapent etil) içeriyor <sup><a href="#kaynak-9">[9]</a></sup>. Reçeteli ürün ile marketteki kapsül aynı
          araştırmanın konusu değil; sonuçları birbirine taşınmamalı.
        </p>

        <h2 id="trigliserit-ve-kalp">Trigliserit ve Kalp: Kanıtın En Sağlam Olduğu Yer</h2>
        <p>
          Omega-3’ün kesin konuşabildiğimiz tek alanı kan yağları. Kalp krizine giden yolda ise tablo daha karışık.
        </p>
        <p>
          86 randomize çalışmayı (162.796 kişi) toplayan derlemede balık kökenli omega-3 trigliseridi yaklaşık yüzde 15
          düşürdü ve etki doza bağlıydı <sup><a href="#kaynak-1">[1]</a></sup> <Evidence level={5} />. Trigliseridi çok
          yüksek olan kişilerde günde 4 g reçeteli omega-3 bu değeri yüzde 30’dan fazla düşürebiliyor
          <sup><a href="#kaynak-2">[2]</a></sup>. Aynı derlemede toplam ölüm üzerinde belirgin bir etki görülmedi; kalp
          kaynaklı ölüm ve koroner olaylarda küçük bir azalma işareti vardı <sup><a href="#kaynak-1">[1]</a></sup>.
        </p>
        <p>
          Kalp hastalığı olmayan kişilerde soruyu en net yanıtlayan çalışma 50 yaş üzeri erkekler ve 55 yaş üzeri
          kadınlarla yapıldı. 25.871 kişi beş yıl boyunca günde 1 g balık yağı ya da plasebo aldı. Kalp krizi, inme ve kalp
          kaynaklı ölümden oluşan ana sonuçta fark çıkmadı; kanser sıklığı da değişmedi <sup><a href="#kaynak-3">[3]</a></sup>
          <Evidence level={4} />. İkincil bir analizde kalp krizi sayısı daha düşüktü; ana sonuç anlamlı olmadığı için bu
          bulgu doğrulanması gereken bir işaret olarak okunuyor.
        </p>
        <p>
          Yüksek riskli hastalarda iki büyük çalışma farklı sonuç verdi. Statin kullanan, trigliseridi yüksek 8.179 kişide
          günde 4 g reçeteli saf EPA, kalp-damar olaylarını yaklaşık dörtte bir azalttı
          <sup><a href="#kaynak-10">[10]</a></sup>. Benzer 13.078 kişide EPA ile DHA karışımı içeren başka bir ilaç ise mısır
          yağıyla karşılaştırıldığında fark yaratmadı; üstelik sindirim yakınmaları daha sıktı
          <sup><a href="#kaynak-11">[11]</a></sup>. Ürün, karşılaştırılan yağ ve hasta grubu farklıydı.
        </p>
        <p>
          Trigliserit yüksekliğinde karar, değere ve kalp-damar riskine göre verilir; çok yüksek değerler pankreatit riski için ayrıca değerlendirilir <sup><a href="#kaynak-27">[27]</a></sup>. Market kapsülüyle “kalbimi korurum” beklentisi büyük çalışmalarda karşılık bulmadı.
        </p>

        <h2 id="menopoz-vaatleri">Menopoz Vaatleri: Sıcak Basmasından Eklem Ağrısına</h2>
        <p>
          Sıcak basması için soru açıkça sorulmuş ve büyük bir çalışmada yanıt olumsuz çıkmış. Sonuç: fark yok.
        </p>
        <p>
          Menopoz geçişindeki ya da sonrasındaki 355 kadın 12 hafta boyunca günde 1,8 g omega-3 ya da plasebo aldı.
          Başlangıçta günde ortalama 7,6 sıcak basması vardı. İki grupta da azaldı ve azalma aynı ölçüdeydi; uyku,
          uykusuzluk, depresif belirti ve kaygı ölçümlerinde de fark görülmedi <sup><a href="#kaynak-4">[4]</a></sup>
          <Evidence level={3} />. 2023’te dokuz randomize çalışmayı inceleyen derleme de omega-3’ün sıcak basması, uyku
          ve depresyon üzerinde etkili olduğunu gösteren yeterli kanıt bulamadı <sup><a href="#kaynak-12">[12]</a></sup>.
          Omega-3’ün tek başına kullanıldığı çalışmaları birleştiren başka bir analizde de sıcak basması sıklığı ve
          şiddeti plasebodan farklı değildi <sup><a href="#kaynak-13">[13]</a></sup>.
        </p>
        <p>
          Olumlu sonuç veren bir çalışma da var, ama sınırlarıyla birlikte okunmalı. Ruhsal sıkıntısı olan orta yaşlı
          kadınlarla sekiz haftalık bir çalışma yapıldı. İkincil analizde, sıcak basması olan 91 kadında EPA alanlarda
          sıklık daha fazla azaldı <sup><a href="#kaynak-14">[14]</a></sup>. Yazarlar da bulgunun sıcak basması için
          tasarlanmış bir çalışmada doğrulanması gerektiğini yazdı; daha büyük çalışma ise bunu doğrulamadı
          <sup><a href="#kaynak-4">[4]</a></sup>.
        </p>
        <p>
          <strong>Ruh hali.</strong> Aynı orta yaşlı kadın grubunda tüm katılımcılara bakıldığında fark çıkmadı; majör
          depresyonu olmayan alt grupta ruhsal sıkıntı skorları EPA ile daha fazla düzeldi
          <sup><a href="#kaynak-15">[15]</a></sup>. Depresyon tanısı alan yetişkinlerle yapılan çalışmaları toplayan derleme
          plaseboya göre küçük bir etki buldu. Ortalama etki klinik açıdan anlamlı sayılan eşiğin altındaydı; ancak sonuçlar anlamlı bir yararı da dışlamıyordu ve kanıtın
          kesinliği çok düşüktü <sup><a href="#kaynak-16">[16]</a></sup> <Evidence level={2} />. Önleme sorusunda sonuç
          şaşırtıcıydı. 50 yaş üzeri 18.353 yetişkinde beş yıl günde 1 g balık yağı depresyonu önlemedi. Depresyon ya da
          belirgin depresif belirti riski balık yağı grubunda biraz daha yüksekti; ruh hali skorlarında fark yoktu
          <sup><a href="#kaynak-17">[17]</a></sup>.
        </p>
        <p>
          Haftalarca süren isteksizlik, uyku ve iştah değişikliği ya da umutsuzluk hissi varsa bunu bir kapsülle
          beklemeyin. Bu, değerlendirilmesi gereken bir durum.
        </p>
        <p>
          <strong>Zihin ve unutkanlık.</strong> Bilişsel sorunu olmayan yaşlı kişilerde yapılan yüksek kaliteli çalışmalar,
          omega-3 takviyesinin bellek ve düşünme testlerinde yarar sağlamadığını gösterdi
          <sup><a href="#kaynak-18">[18]</a></sup>. Perimenopozdaki “beyin sisi” için ayrı bir çalışma ise yeni: 42 kadınla
          yürütülen bir randomize çalışmanın sonuçları henüz yayımlanmadı <sup><a href="#kaynak-19">[19]</a></sup>.
        </p>
        <p>
          <strong>Eklem, kemik ve göz.</strong> Aromataz inhibitörü, meme kanseri tedavisinde kullanılan ve eklem ağrısı
          yapabilen bir ilaç. Bu ağrıyı yaşayan, menopoz sonrası 249 kadın 24 hafta günde 3,3 g omega-3 ya da plasebo aldı. İki grupta da
          ağrı yarıdan fazla azaldı; gruplar arasında anlamlı fark yoktu <sup><a href="#kaynak-20">[20]</a></sup>. 70 yaş
          üzeri 2.157 kişiyle yapılan üç yıllık çalışmada günde 1 g omega-3 kırık, kan basıncı, fiziksel performans ve
          bilişsel testlerde fark yaratmadı <sup><a href="#kaynak-21">[21]</a></sup>. Orta-ağır kuru gözde bir yıl günde
          3 g omega-3, zeytinyağlı plasebodan daha iyi sonuç vermedi <sup><a href="#kaynak-22">[22]</a></sup>.
        </p>

        <h2 id="kanit-merdiveni">Kanıt Merdiveni ve Dolaşımdaki İddialar</h2>
        <p>
          Omega-3, yaşlanma karşıtı listelerde de sık geçiyor. Bu iddiaların her biri bilimde farklı bir basamakta duruyor.
        </p>
        <p>
          Kanında omega-3 düzeyi yüksek kişileri 16 yıl izleyen 17 çalışmanın birleşik analizinde, en yüksek beşte birlik
          dilimde ölüm riski yüzde 15-18 daha düşüktü <sup><a href="#kaynak-23">[23]</a></sup>. Bu kişiler daha çok balık
          yiyor, belki daha çok yürüyor, belki daha az sigara içiyor olabilir. Gözlemsel çalışma kapsülün ömrü uzattığını
          gösteremez; randomize çalışmada ise toplam ölümde fark çıkmadı <sup><a href="#kaynak-3">[3]</a></sup>.
        </p>
        <p>
          70 yaş üzeri 777 kişide üç yıl sonra epigenetik “yaşlanma saatlerinde” birkaç aylık bir yavaşlama görüldü
          <sup><a href="#kaynak-24">[24]</a></sup> <Evidence level={2} />. Bulgu ilginç ama erken: analiz çalışmanın ana
          sorusu değildi ve aynı çalışmada gerçek sağlık sonuçlarında fark çıkmamıştı
          <sup><a href="#kaynak-21">[21]</a></sup>.
        </p>
        <h3>Dolaşımdaki iddialar ve kanıttaki yerleri</h3>
        <div class="my-8 overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead class="hidden md:table-header-group">
              <tr class="border-b border-primary/20 bg-primary/5 text-ink font-serif">
                <th class="p-3 font-semibold">İddia</th>
                <th class="p-3 font-semibold">Durum</th>
                <th class="p-3 font-semibold">Ne bulundu</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-primary/10">
              <tr class="block border-b border-primary/10 py-3 md:table-row md:py-0">
                <td class="block px-3 py-1 font-medium md:table-cell md:p-3">Trigliseridi düşürür</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Test edildi, desteklendi</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Doza bağlı düşüş; çok yüksek trigliseritte reçeteli dozla daha belirgin <sup><a href="#kaynak-1">[1]</a>, <a href="#kaynak-2">[2]</a></sup></td>
              </tr>
              <tr class="block border-b border-primary/10 py-3 md:table-row md:py-0">
                <td class="block px-3 py-1 font-medium md:table-cell md:p-3">Yüksek riskli hastada kalp olaylarını azaltır</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Test edildi, ürüne göre değişti</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Reçeteli saf EPA ile azaldı; EPA+DHA ilacıyla azalmadı <sup><a href="#kaynak-10">[10]</a>, <a href="#kaynak-11">[11]</a></sup></td>
              </tr>
              <tr class="block border-b border-primary/10 py-3 md:table-row md:py-0">
                <td class="block px-3 py-1 font-medium md:table-cell md:p-3">Sağlıklı kişide kalp krizi ve inmeyi önler</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Test edildi, desteklenmedi</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Kalp krizi, inme ve kalp kaynaklı ölümün birleşik ana sonucunda fark yok; ikincil kalp krizi bulgusu ayrıca doğrulanmalı <sup><a href="#kaynak-3">[3]</a></sup></td>
              </tr>
              <tr class="block border-b border-primary/10 py-3 md:table-row md:py-0">
                <td class="block px-3 py-1 font-medium md:table-cell md:p-3">Sıcak basmasını azaltır</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Test edildi, desteklenmedi</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Büyük çalışmada ve derlemelerde fark yok; tek küçük olumlu bulgu doğrulanmadı <sup><a href="#kaynak-4">[4]</a>, <a href="#kaynak-12">[12]</a>, <a href="#kaynak-14">[14]</a></sup></td>
              </tr>
              <tr class="block border-b border-primary/10 py-3 md:table-row md:py-0">
                <td class="block px-3 py-1 font-medium md:table-cell md:p-3">Depresyonu önler</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Test edildi, desteklenmedi</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Önlemedi; risk balık yağı grubunda biraz daha yüksekti <sup><a href="#kaynak-17">[17]</a></sup></td>
              </tr>
              <tr class="block border-b border-primary/10 py-3 md:table-row md:py-0">
                <td class="block px-3 py-1 font-medium md:table-cell md:p-3">Depresif belirtileri hafifletir</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Test edildi, sonuç belirsiz</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Küçük etki olabilir, kesinlik düşük <sup><a href="#kaynak-15">[15]</a>, <a href="#kaynak-16">[16]</a></sup></td>
              </tr>
              <tr class="block border-b border-primary/10 py-3 md:table-row md:py-0">
                <td class="block px-3 py-1 font-medium md:table-cell md:p-3">Unutkanlığı önler, “beyin sisini” açar</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Yaşlılarda desteklenmedi; perimenopozda test ediliyor</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Sağlıklı yaşlılarda fark yok; perimenopoz çalışmasının sonucu bekleniyor <sup><a href="#kaynak-18">[18]</a>, <a href="#kaynak-19">[19]</a></sup></td>
              </tr>
              <tr class="block border-b border-primary/10 py-3 md:table-row md:py-0">
                <td class="block px-3 py-1 font-medium md:table-cell md:p-3">Eklem ağrısını azaltır</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Test edildi, desteklenmedi</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Aromataz inhibitörüne bağlı eklem ağrısında iki grupta da belirgin düzelme, gruplar arasında fark yok <sup><a href="#kaynak-20">[20]</a></sup></td>
              </tr>
              <tr class="block border-b border-primary/10 py-3 md:table-row md:py-0">
                <td class="block px-3 py-1 font-medium md:table-cell md:p-3">Kemiği korur, kırığı önler</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Test edildi, desteklenmedi</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">70 yaş üzerinde üç yılda kırık sıklığında fark yok <sup><a href="#kaynak-21">[21]</a></sup></td>
              </tr>
              <tr class="block border-b border-primary/10 py-3 md:table-row md:py-0">
                <td class="block px-3 py-1 font-medium md:table-cell md:p-3">Kuru gözü düzeltir</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Test edildi, desteklenmedi</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Bir yılda zeytinyağlı plasebodan fark yok <sup><a href="#kaynak-22">[22]</a></sup></td>
              </tr>
              <tr class="block border-b border-primary/10 py-3 md:table-row md:py-0">
                <td class="block px-3 py-1 font-medium md:table-cell md:p-3">Biyolojik yaşlanmayı yavaşlatır</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Biyobelirteçte incelendi; klinik karşılığı belirsiz</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Yalnızca epigenetik saatte küçük fark; klinik sonuç ölçülmedi <sup><a href="#kaynak-24">[24]</a></sup></td>
              </tr>
              <tr class="block border-b border-primary/10 py-3 md:table-row md:py-0">
                <td class="block px-3 py-1 font-medium md:table-cell md:p-3">Menopozda cildi nemlendirir, gençleştirir</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Henüz test edilmedi</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Menopozdaki kadınlarda cilt sonucunu ölçen randomize çalışmaya ulaşamadık</td>
              </tr>
              <tr class="block border-b border-primary/10 py-3 md:table-row md:py-0">
                <td class="block px-3 py-1 font-medium md:table-cell md:p-3">Ömrü uzatır</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Test edildi; yaşam süresini uzattığı gösterilmedi</td>
                <td class="block px-3 py-1 md:table-cell md:p-3">Ömür için yıllarca süren çalışma gerekir; gözlemsel ilişki var, randomize çalışmada ölüm farkı yok <sup><a href="#kaynak-3">[3]</a>, <a href="#kaynak-23">[23]</a></sup></td>
              </tr>
            </tbody>
          </table>
        </div>

        <p>Takviyeyi bırakmak mümkündür; gelişmiş bir yan etkinin geri dönüp dönmeyeceği ise kişiye ve etkiye göre değerlendirilir.</p>

        <h2 id="guvenlik">Ritim, Kanama ve İlaç Etkileşimi</h2>
        <p>
          Omega-3 güvenli bilinir ve büyük ölçüde öyle. Yine de bir yan etkisi kalp çalışmalarında tekrar tekrar çıktı.
        </p>
        <p>
          <strong>Ritim bozukluğu.</strong> Kalp sonuçlarını izleyen yedi randomize çalışmada (81.210 kişi, yüzde 39’u kadın)
          omega-3 takviyesi atriyal fibrilasyon riskini yüzde 25 artırdı. Artış günde 1 g’ın üzerindeki dozlarda yüzde 49,
          1 g ve altında yüzde 12’ydi <sup><a href="#kaynak-5">[5]</a></sup> <Evidence level={4} />. Reçeteli saf EPA
          çalışmasında da ritim bozukluğu nedeniyle hastaneye yatış daha sıktı (yüzde 3,1’e karşı 2,1)
          <sup><a href="#kaynak-10">[10]</a></sup>. Çarpıntı, düzensiz nabız ya da nefes darlığı başlarsa kapsülü bırakıp
          değerlendirilmeniz gerekir.
        </p>
        <p>
          <strong>Kanama.</strong> 11 randomize çalışmayı (120.643 kişi) birleştiren analizde omega-3 genel kanama riskini
          artırmadı; beyin içi ve mide-bağırsak kanamaları da benzerdi. Yüksek doz saf EPA alanlarda göreli risk yüzde 50
          artarken mutlak artış yüzde 0,6’da kaldı <sup><a href="#kaynak-25">[25]</a></sup>. Günde 1 g balık yağıyla
          yapılan büyük çalışmada da kanama artışı görülmedi <sup><a href="#kaynak-3">[3]</a></sup>. Yine de kan
          sulandırıcı kullanıyorsanız ya da ameliyat planınız varsa hekiminiz bilmeli.
        </p>
        <p>
          <strong>Sık bildirilen istenmeyen etkiler.</strong> En sık yakınma sindirimle ilgili: geğirme, balık tadı, mide
          rahatsızlığı. Bir çalışmada sindirim yakınmaları omega-3 grubunda yüzde 24,7, mısır yağı grubunda yüzde 14,7 idi
          <sup><a href="#kaynak-11">[11]</a></sup>. Kullanıcıların “daha enerjik hissettim” gibi bildirimleri ise kanıt
          değeri taşımaz; aynı dönemde değişen alışkanlıklar ve beklenti bu hissi etkiler. Tekrarlayan yan etki
          bildirimleri ise ciddiye alınması gereken sinyallerdir.
        </p>
        <RedFlagBox
          title="Omega-3 Kapsülüne Başlamadan Önce Hekiminizle Konuşun"
