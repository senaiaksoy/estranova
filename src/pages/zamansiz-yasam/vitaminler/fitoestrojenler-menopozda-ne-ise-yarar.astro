  { id: 'fitoestrojen-nedir', label: 'Fitoestrojen Nedir' },
  { id: 'sicak-basmasi', label: 'Sıcak Basması' },
  { id: 'soya-yonca-keten', label: 'Soya, Kırmızı Yonca, Keten' },
  { id: 'diger-vaatler', label: 'Kemik, Cinsel Yaşam, Ruh Hali' },
  { id: 'guvenlik', label: 'Meme, Rahim, Tiroid' },
  { id: 'besin-ve-ekstrakt', label: 'Besin ve Ekstrakt' },
  { id: 'karar-olcutleri', label: 'Karar Ölçütleri' },
  { id: 'doktora-uc-soru', label: 'Görüşmeye Üç Soru' },
  { id: 'kapanis', label: 'Kapanış' },
