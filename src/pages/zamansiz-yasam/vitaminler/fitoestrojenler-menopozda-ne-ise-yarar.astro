  { id: 'sik-sorulanlar', label: "Dr. Aksoy'a sorular" },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Fitoestrojenler Menopozda Ne İşe Yarar?';
const articleImage = '/images/library/editorial/zy-fitoestrojenler-menopoz.webp';
const articleDescription =
