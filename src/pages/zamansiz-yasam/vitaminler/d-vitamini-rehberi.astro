---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import Evidence from '../../../components/site/Evidence.astro';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { resolveSiteUrl } from '../../../utils/seo';

const tocEntries = [
  { id: 'd-vitamini-nedir', label: 'D Vitamini Nedir' },
  { id: 'ihtiyac-neden-artar', label: 'İhtiyaç Neden Artar' },
  { id: 'eksiklik-belirtileri', label: 'Eksiklik Belirtileri' },
  { id: 'ne-kadar-almali', label: 'Ne Kadar Almalı' },
  { id: 'dogal-kaynaklar', label: 'Doğal Kaynaklar' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'D Vitamini: 40 Yaşından Sonra Ne Kadar Almanız Gerekiyor?';
const articleDescription = '40 yaş sonrası dönemde D vitamini ihtiyacını, eksiklik belirtilerini, doz aralıklarını ve doğal kaynakları bilimsel bir çerçevede ele alan rehber.';
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'rima-erdemir',
  publishedDate: '10 Nisan 2026',
  pathname: '/zamansiz-yasam/vitaminler/d-vitamini-rehberi',
  articleSection: 'Zamansız Yaşam',
  sectionPath: '/zamansiz-yasam',
  keywords: ['D vitamini', 'dozaj', '40 yaş sonrası', 'eksiklik', 'takviye', 'doğal kaynaklar'],
  siteUrl,
});
---

<SiteLayout
  title={`${articleTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar />

  <main id="main-content" class="pt-24 text-[#2D2D2D]">
    <SubmenuArticleBody>
        <ArticleTOC slot="toc" entries={tocEntries} />
        <ArticleAuthorBlock authorSlug="rima-erdemir" publishedDate="10 Nisan 2026" readingMinutes={3} />

        <header class="mb-10">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">Zamansız Yaşam · Vitaminler</p>
          <h1 class="font-serif text-4xl leading-tight md:text-6xl">
            D Vitamini: 40 Yaşından Sonra Ne Kadar Almanız Gerekiyor?
          </h1>
        </header>

        <section class="rounded-[28px] border border-[#C9A96E]/35 bg-gradient-to-br from-white to-[#FDF8F0]/90 p-7 shadow-sm ring-1 ring-[#C9A96E]/22 md:p-8">
          <h2 class="mb-4 font-serif text-3xl">Bu yazıda öğrenecekleriniz</h2>
          <ul class="mb-5 list-disc space-y-2 pl-5 leading-relaxed text-[#2D2D2D]/80">
            <li>D vitamininin 40 yaş sonrası dönemde neden daha yakından izlenmesi gerektiği</li>
            <li>Eksiklik belirtilerinin hangi durumlarda hekim değerlendirmesi gerektirebileceği</li>
            <li>Güncel kılavuzlarda geçen doz aralıkları, doğal kaynaklar ve takviye seçimi</li>
          </ul>
          <p class="text-sm font-medium text-[#2D2D2D]/70">Okuma süresi: 6 dakika</p>
        </section>

        <ArticleProsePanel>
          <h2 id="d-vitamini-nedir">D Vitamini Nedir ve Neden Önemlidir?</h2>
          <p>
            D vitamini, kemik ve kas sağlığında temel rol oynayan bir vitamindir. Vücutta kalsiyum ve fosfor dengesine
            katkı sağlar. Bu denge, yalnızca kemik yoğunluğu için değil, günlük hareket kapasitesi için de önemlidir.
          </p>
          <p>
            Son yıllarda D vitamininin bağışıklık sistemi ve genel iyi olma hali ile ilişkisi de daha fazla araştırılmaktadır.
            Ancak bu ilişki her başlıkta aynı güçte değildir. Bu nedenle D vitaminini “tek başına çözüm” gibi görmek yerine,
            bütüncül sağlık planının bir parçası olarak değerlendirmek daha doğru olur.
          </p>

          <h2 id="ihtiyac-neden-artar">40 Yaşından Sonra D Vitamini İhtiyacı Neden Artar?</h2>
          <p>
            Yaş ilerledikçe ciltte D vitamini sentezi azalabilir. Güneşe çıkma süresinin düşmesi, kapalı ortamda geçirilen
            zamanın artması ve beslenme düzenindeki değişimler de bu tabloya eklenir. Menopoz geçişinde kemik döngüsü hızlandığı
            için D vitamini düzeyinin izlenmesi daha fazla önem kazanır.
          </p>
          <p>
            Özellikle kemik sağlığı açısından risk taşıyan kişilerde, D vitamini düzeyinin tek başına değil; kalsiyum alımı,
            fiziksel aktivite ve genel sağlık durumu ile birlikte değerlendirilmesi gerekir.
          </p>

          <h2 id="eksiklik-belirtileri">Eksiklik Belirtileri Nelerdir?</h2>
          <p>
            D vitamini eksikliği her zaman belirgin bulgu vermez. Bununla birlikte uzun süren yorgunluk, kas güçsüzlüğü,
            yaygın kemik veya kas ağrısı, sık düşme eğilimi ve iyileşmesi geciken halsizlik hissi bazı kişilerde görülebilir.
          </p>
          <p>
            Bu belirtiler birçok farklı nedenle de ortaya çıkabilir. Bu yüzden yalnızca şikayetlere bakarak karar vermek yerine,
            hekim değerlendirmesi ve uygun görülen kan testleriyle birlikte ilerlemek en güvenli yaklaşımdır.
          </p>

          <h2 id="ne-kadar-almali">Ne Kadar Almanız Gerekiyor? (Dozaj Bilgisi — Tarafsız)</h2>
          <p>
            Genel kılavuzlarda yetişkinler için günlük D vitamini gereksinimi çoğunlukla 600–800 IU aralığında verilir.
            Menopoz sonrası dönemde, bireysel risk durumuna göre bu aralık hekim tarafından yeniden düzenlenebilir.
          </p>
          <p>
            Bazı klinik durumlarda 800–2000 IU gibi daha yüksek destek dozları planlanabilir. Buna karşın uzun süre yüksek doz
            kullanımının hekim kontrolü olmadan sürdürülmesi önerilmez. Birçok rehberde yetişkinler için üst güvenli sınır
            4000 IU/gün olarak belirtilir. Kişisel doz kararı, kan düzeyi ve tıbbi öyküye göre verilmelidir.
          </p>

          <h2 id="dogal-kaynaklar">Doğal Kaynaklar ve Takviye Seçimi</h2>
          <p>
            D vitamini için en temel doğal kaynak güneş ışığıdır. Bunun yanında yağlı balıklar, yumurta sarısı ve D vitamini ile
            zenginleştirilmiş gıdalar beslenmeye katkı sağlar. Ancak yalnızca besinle hedef düzeye ulaşmak her zaman mümkün olmayabilir.
          </p>
          <p>
            Takviye seçerken ürünün birim dozuna, formuna (D2 veya D3), günlük kullanım kolaylığına ve güvenilir üretici bilgisine
            bakmak önemlidir. Takviyeyi kişisel sağlık durumunuza göre planlamak için hekim veya ilgili sağlık profesyoneli ile
            birlikte karar vermek en dengeli yaklaşımdır.
          </p>
        </ArticleProsePanel>

        <section class="mt-14 rounded-[28px] border border-[#6B2D3E]/12 bg-[#FDF8F0] p-7 shadow-sm ring-1 ring-[#6B2D3E]/10 md:p-8">
          <h2 class="mb-5 font-serif text-3xl">İlgili İçerikler</h2>
          <ul class="space-y-3">
            <li>
              <a href="/library" class="font-semibold text-[#6B2D3E] hover:underline">Kütüphane: beslenme ve longevity içerikleri</a>
            </li>
            <li>
              <a href="/article/menopozda-kemik-sagligi" class="font-semibold text-[#6B2D3E] hover:underline">
                Menopozda Kemik Sağlığı (Makale)
              </a>
            </li>
            <li>
              <a href="/hormonal-gecis/40-sonrasi/tarama-testleri" class="font-semibold text-[#6B2D3E] hover:underline">
                Tarama ve İzlem: Genel Çerçeve
              </a>
            </li>
          </ul>
        </section>

        <section class="mt-14 rounded-[28px] border border-[#6B2D3E]/15 border-l-[6px] border-l-[#C9A96E] bg-gradient-to-r from-[#F5EDE0] to-[#FDF8F0] p-7 shadow-sm ring-1 ring-[#6B2D3E]/10 md:p-8">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.22em] text-[#6B2D3E]">Bilimsel Editör Notu</p>
          <p class="mb-4 text-lg font-semibold text-[#2D2D2D]">Kanıt Düzeyi: A — Güçlü Kanıt <Evidence level={5} /></p>
          <p class="leading-relaxed text-[#2D2D2D]/80">
            D vitamini takviyesinin kemik sağlığı üzerindeki olumlu etkisi çok sayıda randomize kontrollü çalışma ve meta-analiz ile desteklenmektedir.
            Uluslararası kılavuzlar menopoz sonrası kadınlarda D vitamini takviyesini önermektedir.
          </p>
          <p class="mt-4 text-sm text-[#2D2D2D]/65">Son güncelleme: Nisan 2026</p>
        </section>

        <section class="mt-10 rounded-[24px] border border-dashed border-[#6B2D3E]/25 bg-white/95 p-6 ring-1 ring-[#6B2D3E]/10">
          <p class="text-sm leading-relaxed text-[#2D2D2D]/75">
            Bu içerik yalnızca genel bilgilendirme amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavinin yerini almaz.
          </p>
        </section>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
