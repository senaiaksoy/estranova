---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import SaveForLaterButton from '../../../components/site/SaveForLaterButton.astro';
import ReadingControls from '../../../components/site/ReadingControls.astro';
import RedFlagBox from '../../../components/site/RedFlagBox.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { articleFaqs } from '../../../data/article-faqs';
import { resolveSiteUrl } from '../../../utils/seo';

const hero =
  submenuHeroByRoute['/zamansiz-yasam/non-invaziv/non-invaziv-cihazlar-hifu-rf-mikroakim']
  ?? submenuHeroByRoute['/zamansiz-yasam/non-invaziv']!;

const tocEntries = [
  { id: 'mekanizma', label: 'Mekanizma Sözlüğü' },
  { id: 'kanit-haritasi', label: 'Kanıt Haritası' },
  { id: 'postmenopozal', label: 'Postmenopozal Zemin' },
  { id: 'pratik-notlar', label: 'Beklenti, Maliyet, Risk' },
  { id: 'uc-soru', label: 'Doktora Üç Soru' },
  { id: 'sik-sorulanlar', label: 'Sıkça Sorulanlar' },
  { id: 'kapanis', label: 'Kapanış' },
  { id: 'sss', label: 'Sıkça Sorulan Sorular' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'HIFU, Radyofrekans ve Mikroakım — Non-İnvaziv Cihazların Kanıt Sınırı';
const articleDescription =
'HIFU, radyofrekans ve mikroakım cihazları "ameliyatsız yüz germe" vaadiyle yoğun pazarlanıyor; oysa kanıt cerrahi sonuçtan belirgin biçimde uzakta. HIFU yüz germede orta kanıt, RF cilt sıkılaştırma ve pelvik uygulamalar zayıf-orta kanıt, mikroakım ve LED ev cihazları sınırlı. Postmenopozal cilt zemini, beklenti yönetimi ve klinik karar için dürüst rehber.';
const faqItems = articleFaqs['/zamansiz-yasam/non-invaziv/non-invaziv-cihazlar-hifu-rf-mikroakim'] ?? [];
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'senai-aksoy',
  publishedDate: '3 Mayıs 2026',
  pathname: '/zamansiz-yasam/non-invaziv/non-invaziv-cihazlar-hifu-rf-mikroakim',
  articleSection: 'Zamansız Yaşam',
  sectionPath: '/zamansiz-yasam',
  keywords: [
    'HIFU',
    'radyofrekans',
    'mikroakım',
    'non-invaziv estetik',
    'cilt sıkılaştırma',
    'yüz germe',
    'pelvik radyofrekans',
    'postmenopozal cilt',
    'kanıt seviyesi',
    'LED ışık tedavisi',
  ],
  faqItems,

  siteUrl,
});
---

<SiteLayout
  title={`${articleTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/zamansiz-yasam" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Ameliyatsız Uygulamalar"
      title="HIFU, Radyofrekans ve Mikroakım — Non-İnvaziv Cihazların Kanıt Sınırı"
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock authorSlug="senai-aksoy" publishedDate="3 Mayıs 2026" readingMinutes={9} />

      <div class="flex flex-wrap items-center justify-end gap-3">
        <ReadingControls />
        <SaveForLaterButton
          slug="/zamansiz-yasam/non-invaziv/non-invaziv-cihazlar-hifu-rf-mikroakim"
          title={articleTitle}
        />
      </div>

      <ArticleSummary title="Kısa Özet">
<p>
          HIFU, radyofrekans (RF), mikroakım ve LED ışık cihazları <em>"ameliyatsız
          yüz germe"</em> ya da <em>"cilt sıkılaştırma"</em> vaadiyle yoğun pazarlanıyor.
          Bu cihazlar gerçek bir enerji formuyla çalışır — ama klinik etkileri <em>cerrahi
          sonuçtan belirgin biçimde uzakta</em>; üstelik aynı cihaz aynı isimle farklı
          merkezlerde çok farklı protokollerle uygulanıyor. Bu yazı dört cihaz sınıfının
          mekanizmasını, kanıt seviyesini, postmenopozal cilt için anlamını ve hekim
          görüşmesi için somut soruları toparlıyor — pazarlama vaadi yerine dürüst
okuma rehberi.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="mekanizma">Mekanizma Sözlüğü: Bu Cihazlar Aslında Ne Yapıyor?</h2>
        <p>
          Geçen ay bir hasta bana <em>"utanarak soracağım"</em> diyerek başladı:
          yıllardır izlediği bir cihazın seansını almak istiyordu, ama
          <em>"yaşlanma karşısında çaresiz hissettiğini ve bunu söylemekten
rahatsız olduğunu"</em> ekledi. His meşru, bilimsel tablo ayrı: bu
          tür cihazlar konusunda sorulan ilk soru doğru olanıdır — <em>"bu cihaz
          aslında ne yapıyor?"</em> Konuya isim koyarak başlayalım.
        </p>
        <p>
          <strong>HIFU (yüksek yoğunluklu odaklanmış ultrason):</strong> Cilt
          yüzeyinden geçip belirli derinlikte (genellikle SMAS — fasyal kas
          tabakası seviyesi) odaklanan ses dalgaları kullanır; bu odakta
          mikrokoagülasyon noktaları üreterek dokuda kollajen yenilenmesini
          tetikler. Cerrahi gerektirmez; ama tedavi sırasında ısı ve hafif ağrı
          beklenir.
        </p>
        <p>
          <strong>Radyofrekans (RF):</strong> Yüksek frekanslı elektromanyetik
          enerji dokuda ısı üretir; hedef dermis tabakasında kollajen kontraksiyonu
          ve uzun vadeli yeniden yapılanma. Yüz, vücut ve <em>vajinal/pelvik</em>
          uygulamalar için farklı cihaz tipleri var — aynı isim altında çok
          farklı endikasyonlar. Bu yazıda yüz/cilt eksenine odaklanıyoruz; pelvik
          RF için
          <a href="/beden-yakinlik/pelvik-taban/menopozda-idrar-kacirma-pelvik-taban" class="text-burgundy underline decoration-burgundy/30 underline-offset-2 hover:decoration-burgundy">
idrar kaçırma yazısındaki yaklaşım
          </a>
          ayrıca okunabilir.
        </p>
        <p>
          <strong>Mikroakım:</strong> Düşük şiddetli (mikroamper düzeyinde)
          elektrik akımı yüz kaslarını ve hücresel ATP üretimini uyardığı
          iddiasıyla pazarlanır. Klinik cihazlar (yüksek güçlü, profesyonel) ile
          ev cihazları (düşük güçlü, tüketici) arasında ciddi fark vardır;
          pazarlama mesajları çoğu zaman bu farkı görünmez kılar.
        </p>
        <p>
          <strong>LED ışık tedavisi:</strong> Belirli dalga boylarında (kırmızı,
          yakın kızılötesi, mavi) düşük güçlü ışık dokunun mitokondriyal
          aktivitesini ve cilt onarım yolaklarını etkilediği iddiasıyla pazarlanır.
          Klinik cihazlar ile ev maskeleri arasındaki kanıt farkı yine büyük.
        </p>
        <p>
          Bu dört cihaz sınıfının ortak özelliği şu: gerçek bir enerji ile
          çalışıyorlar; bu enerjinin dokuda <em>bir şey</em> yaptığı şüpheli
          değil. Asıl soru şu: <em>bu "bir şey" sizin görmek istediğiniz klinik
          sonuca ne kadar yaklaşıyor?</em> Cevap her cihaz için ayrı.
        </p>

        <h2 id="kanit-haritasi">Kanıt Haritası: Nerede Orta, Nerede Zayıf?</h2>
        <p>
          Bilim diliyle söylersek — bu cihazların hiçbiri için elimizde cerrahi
          yüz germeyle (face-lift) karşılaştırılabilir bir kanıt seviyesi <em>yok</em>.
          Her cihazın kendi kanıt yelpazesi farklı; bu yelpazeyi okuyabilmek
          karar verirken size en güçlü aracı verir.
        </p>
        <p>
          <strong>HIFU:</strong> Yüz/boyun bölgesi sıkılaştırma için orta
          düzeyde klinik kanıtı olan en kanıtlı non-invaziv cihaz <Evidence level={3} />.
          Çalışmalar tek seans sonrası ölçülebilir cilt sıkılaşması ve hafif
          kontur iyileşmesi gösteriyor; ama etki ölçeği <em>orta</em>, kalıcılık
          12-18 ay civarında ve sonuç hastadan hastaya belirgin değişkenlik
          gösteriyor. Hiçbir HIFU cihazı cerrahi yüz germeyi taklit edemez.
        </p>
        <p>
          <strong>RF (yüz/cilt):</strong> Cilt sıkılaştırma için kanıt seviyesi
          HIFU'ya benzer ya da biraz daha sınırlıdır <Evidence from={2} to={3} />.
          Etki büyüklüğü ortalama olarak küçük-orta; bazı çalışmalarda anlamlı
          fark gösterilemedi. Cihaz markası, uygulama protokolü ve operatör
          deneyimi sonuca ciddi etki ediyor — bu da kanıtın yorumlanmasını
          zorlaştırıyor.
        </p>
        <p>
          <strong>RF (vücut sıkılaştırma):</strong> Karın, kol, bacak gibi
          alanlarda RF için kanıt cilt yüzü etkisinden daha sınırlıdır
          <Evidence level={2} />; <em>"selülit tedavisi"</em> iddiasıyla
          pazarlanan uygulamaların kanıtı belirgin biçimde zayıf.
        </p>
        <p>
          <strong>Pelvik RF (vajinal sıkılaştırma):</strong> Bu konuda kanıt
          ayrıca tartışmalıdır <Evidence level={2} />; vajinal atrofi veya GSM
          için kanıtlanmış standart tedavilerin (lokal östrojen, pelvik taban
          eğitimi) <em>yerine değil yanına</em> bile zorlukla konumlandırılabilir.
          Bazı uluslararası uzman dernekleri pelvik RF için <em>"araştırma
içinde değerlendirilmeli, standart önerilemez"</em> uyarısında
          bulunuyor.
        </p>
        <p>
          <strong>Mikroakım:</strong> Klinik cihazlarla yapılan bazı küçük
          çalışmalarda kısa vadeli yüz konturunda iyileşme bildirilmiş, ama
          metodolojik kalitesi sınırlı <Evidence from={1} to={2} />. Ev
          cihazları için kanıt seviyesi <em>çok daha düşük</em>; bu cihazlardan
          beklenen etkinin önemli kısmı plasebodur.
        </p>
        <p>
          <strong>LED ışık tedavisi:</strong> Akne, yara iyileşmesi gibi belirli
          endikasyonlar için orta kanıt; <em>yaşlanma karşıtı genel cilt iyileşmesi</em>
          için kanıt sınırlı <Evidence from={1} to={2} />. Yine klinik cihazlarla
          ev cihazları arasındaki kanıt farkı belirgin.
        </p>
        <p>
          Plasebo etkisi estetik müdahalelerde özellikle güçlüdür: tedaviden
          beklenti, aynaya başka bir gözle bakmaya yetebilir <Evidence from={3} to={4} />;
          bu his değerli ama bilimsel sonuç değil. Bu yüzden <em>"hastalarımın
          hepsi memnun"</em> tek başına klinik kanıt sayılmaz. Bu yazıyla aynı
          eksendeki
          <a href="/zamansiz-yasam/deneysel/deneysel-tedaviyi-okuma-kilavuzu" class="text-burgundy underline decoration-burgundy/30 underline-offset-2 hover:decoration-burgundy">
            deneysel tedaviyi okuma kılavuzu
          </a>
          burada da geçerli: <em>aynı cihaz farklı endikasyon ve farklı protokolde
          farklı kanıt seviyesindedir</em>.
        </p>

<h2 id="postmenopozal">Postmenopozal Zemin — Bu Cihazlar Hormonal Değişimi Çözer mi?</h2>
        <p>
          Burada kritik bir nokta var. Postmenopozal dönemde cilt değişiminin
          arkasındaki temel etken <em>östrojen düşüşüne bağlı kollajen kaybı</em>;
          ilk 5 yıl içinde dermal kollajen %30'a yakın azalabilir
          <Evidence level={4} />. Bu kayıp <em>biyolojik bir geçiş</em>;
          mekanik bir sıkılaştırma cihazıyla "geri döndürülen" bir şey değil.
        </p>
        <p>
          Bu zeminde non-invaziv cihazların yaptığı şey <em>yeni kollajen üretimini
          uyarmak</em>tır; ama uyarılan kollajen miktarı menopozda kaybedilen
          miktarın yanında küçük kalır. Yani bu cihazlar <em>hormonal yaşlanmayı
          çözmez</em>; onun üstüne küçük bir katkı sunabilirler. Beklentiyi bu
          oranda kalibre etmek hayal kırıklığını azaltır.
        </p>
        <p>
          Bilimsel olarak en güçlü kanıt postmenopozal cilt için hâlâ <em>klasik
          temel</em>de: günlük yüksek faktörlü güneş koruyucu, topikal retinoidler
          (reçeteli formlar), bazı durumlarda topikal östrojen ya da düşük doz
          sistemik HRT. Non-invaziv cihazlar bu temele <em>ek bir adım</em> olabilir;
          temelin yerine değil.
        </p>

        <h2 id="pratik-notlar">Beklenti, Maliyet, Risk: Pratik Notlar</h2>
        <p>
          Eğer hekiminizle birlikte bir non-invaziv cihaz değerlendirmeye karar
          verirseniz, bilmeniz yarayacak birkaç pratik nokta var.
        </p>
        <p>
          <strong>Beklenti yönetimi:</strong> En önemli adım. Bu cihazlardan
          beklenen <em>küçük-orta düzeyde sıkılaşma, hafif kontur iyileşmesi,
          ölçülebilir ama abartısız bir cilt yenilenmesi</em>. Cerrahi yüz germe
          sonucu beklemek hayal kırıklığını neredeyse kaçınılmaz kılar.
        </p>
        <p>
          <strong>Operatör ve protokol farkı:</strong> Aynı isimli cihaz, farklı
          merkezlerde farklı eller ve farklı protokollerde uygulanıyor. Bir
          merkezde olumlu sonuç alan biri başka merkezde aynı sonucu almayabilir.
          Operatör deneyimi, cihaz kalibrasyonu ve seans sayısı sonuca ciddi etki
          eder.
        </p>
        <p>
          <strong>Seans sayısı ve maliyet:</strong> Çoğu cihaz için tek seans
          yetmez; 2-4 seans + yıllık tekrar gerekir. Toplam maliyet ciddi olabiliyor.
          Bütçe planı <em>"sürdürülebilir tekrar"</em> hesabıyla yapılır; tek
          seanslık karar yerine yıllık bir plan düşünmek mantıklıdır.
        </p>
        <p>
          <strong>Yan etki ve risk:</strong> En sık karşılaşılanlar geçici kızarıklık,
          hafif şişlik, geçici hassasiyet; nadir olarak yanık, hiperpigmentasyon,
          kalıcı sinir hasarı (uygulama derinliği yanlış olduğunda) ve <em>yağ
          atrofisi</em> (özellikle HIFU'da yüzdeki yağ dokusunun tedavi sonrası
          azalması, ki hayal edilenin tersi sonuç doğurabilir).
        </p>
        <p>
          <strong>Uzun dönem güvenlik:</strong> 5+ yıl tekrarlanan kullanımın
          uzun dönem güvenlik profili <em>henüz tam haritalanmış değil</em>
          <Evidence from={1} to={2} />. Erken çalışmalar olumlu, ama uzun süreli
          izlem verisi sınırlı.
        </p>

        <RedFlagBox
          markers={[
            'Aktif cilt enfeksiyonu, açık yara, aktif ciddi akne, herpes alevlenmesi — uygulama bölgesinde kontrendike',
            'Yara iyileşme bozukluğu (keloid eğilimi, otoimmün cilt hastalığı, izotretinoin kullanımı son 6 ay) — risk değerlendirmesi şart',
            'Aktif kanser veya kanser tedavisi sürerken — onkolog onayı olmadan değil',
            'Pacemaker, defibrilatör, manyetik implant — RF uygulamalarında özellikle dikkat',
            'Hamilelik veya emzirme — güvenlik verisi yok',
            'Aşırı yüksek beklenti (cerrahi sonuç bekleme) — beklenti kalibrasyonu yapılmadan başlamak hayal kırıklığını neredeyse kaçınılmaz kılar',
            '"Tek seansta sonuç / kalıcı yüz germe" pazarlama mesajları — bilimsel temel yok',
'"Koşulsuz memnuniyet / paranızı geri alın" tarzı satış dili — tıbbi karar zemininde uygun değil',
            'Kontrolsüz önce-sonra fotoğrafları (ışıklandırma/poz farkı, seçilmiş hasta) — tek başına klinik kanıt değil',
            'Operatör deneyimi sorulduğunda net yanıt verilmemesi — farklı merkez değerlendirmesi mantıklı',
          ]}
          footnote="Bu liste teşhis amaçlı değil; non-invaziv cihaz değerlendirilirken bir hekimle konuşmaya değer durumların hatırlatıcısıdır."
        />

        <h2 id="uc-soru">Doktora Sorabileceğiniz Üç Soru</h2>
        <p>
          O zaman biz ne yapıyoruz? Bir cihaz seansı düşünüyorsanız hekim odasına
          üç soruyla girilirse görüşme bambaşka bir yere taşınır.
        </p>
        <p>
          <strong>Birincisi:</strong>
          <em>"Bu cihazın benim cilt tipim, yaş bandım ve menopozal dönemim için
          klinik kanıt seviyesi nedir? Hangi tür çalışmalara dayanıyor?"</em> Bu
          soru, <em>"hastalarımız çok memnun"</em> tarzı pazarlama dilini kanıt
          diline davet eder. Bilen bir uygulayıcı <em>"bu cihaz için kanıt
          orta düzeyde"</em> demekten çekinmez; bu cümle güven sinyalidir,
          <em>"kesin sonuç verir"</em> diyen yaklaşım büyük olasılıkla pazarlama
          dilidir.
        </p>
        <p>
          <strong>İkincisi:</strong>
          <em>"Beklenti seviyem ne olmalı? Cerrahi sonuçla ne kadar arası?
          Sonucu ne ile, ne kadar sürede değerlendireceğiz?"</em> Bu soru
          beklenti yönetimini açar. Foto karşılaştırması, ölçüm değişimi
          (fotogrametri), hasta memnuniyet ölçeği — birden çok yöntemle
          değerlendirme dürüst bir görüşmenin parçasıdır. Tek bir <em>"daha iyi
          görüneceksiniz"</em> cümlesi yeterli değildir.
        </p>
        <p>
          <strong>Üçüncüsü:</strong>
          <em>"Yan etki ve risk profili nedir? Hangi durumlarda önerilmez? Daha
          önce yapmış hastalarınızın memnuniyet oranı ne, kaç kişi memnun
          kalmadı?"</em> Bu soru <em>karşı-tarafı</em> da konuşmayı zorunlu
          kılar. Olumsuz sonuç ihtimaline saygılı bir uygulayıcı bunları sorulmadan
          paylaşmaya açıktır; konuyu sadece olumluluk üzerinden anlatan yaklaşım
          eksik bilgi sunar.
        </p>

        <h2 id="sik-sorulanlar">Sıkça Sorulanlar</h2>

        <h3>HIFU ile RF arasındaki temel fark nedir?</h3>
        <p>
          HIFU odaklanmış ses dalgalarıyla derinde mikrokoagülasyon noktaları
          üretirken, RF elektromanyetik enerji ile dermiste daha yaygın bir ısı
          dağılımı oluşturur. HIFU genellikle daha derin tabaka (SMAS) etkisiyle
          <em>"yüz germe"</em> iddiasıyla pazarlanırken, RF daha yüzeysel cilt
          sıkılaştırma için tercih edilir. Klinik kanıt seviyesinde HIFU yüz
          uygulamalarında biraz daha güçlü bir yere oturuyor; ama her ikisi
          için de etki büyüklüğü <em>orta düzeyde ve değişken</em>.
        </p>

        <h3>Ev cihazları (mikroakım, LED maske) klinik cihazlardan ne kadar farklı?</h3>
        <p>
          Belirgin biçimde farklı. Klinik cihazlar yüksek güç, hassas
          kalibrasyon, eğitimli operatör koşullarında çalışır; ev cihazları
          tüketici güvenliği için düşük güçlü tasarlanır. Ev cihazlarından
          beklenen klinik etki <em>çok sınırlıdır</em>; düzenli kullanım hafif
          bir cilt iyileşmesi sağlayabilir, ama klinik cihazlarla
          karşılaştırılabilir bir sonuç beklemek gerçekçi değil. Pazarlama
          mesajları çoğu zaman bu farkı silikleştirir.
        </p>

        <h3>Bir seansta sonuç görür müyüm?</h3>
        <p>
          Çoğu cihaz için <em>hayır</em>. Tek seansta hafif bir cilt sıkılığı
          ve geçici parlama hissi olabilir; gerçek anlamda kollajen yenilenmesi
          süreci 8-12 hafta alır <Evidence level={3} />. Çoğu protokol 2-4 seans
          + yıllık tekrar önerir. <em>"Tek seansta yıllar geri"</em> tarzı
          vaatler bilimsel temele oturmaz; tedavi planı en başta seans sayısı
          ve takvim olarak konuşulmalıdır.
        </p>

        <h3>Postmenopozal hastalar için sonuç farklı mı?</h3>
        <p>
          Genelde biraz daha sınırlı sonuç beklenir. Östrojen düşüşüne bağlı
          azalmış kollajen rezervi yeni kollajen üretiminin <em>üstüne ekleneceği
          temeli</em> daha düşük tutar; aynı cihaz aynı uygulamada premenopozal
          hastayla karşılaştırıldığında postmenopozal hastada etki büyüklüğü
          biraz daha küçük olabilir. Bu fark cihazın değersiz olduğunu söylemez,
          beklentinin gerçekçi tutulması gerektiğini söyler.
        </p>

        <h3>HRT alıyorum, etkileşim var mı?</h3>
        <p>
          Doğrudan ilaç-cihaz etkileşimi <em>yoktur</em>. HRT alan postmenopozal
          hastalarda cilt yapısı genellikle daha iyi korunmuş olduğundan, cihaz
          tedavisi sonucu daha tatmin edici olabilir; ama bu da bireysel değişkenlik
          gösterir. HRT'ye yeni başlamış hastalarda ciltteki iyileşmenin bir
          kısmı zaten HRT'ye bağlı olabileceğinden, cihaz etkisini izole etmek
          zorlaşır. Bu bilgi tedavi planlamasında hekiminizle paylaşılır.
        </p>

        <h2 id="kapanis">Kapanış</h2>
        <p>
          Non-invaziv cihazlar (HIFU, RF, mikroakım, LED) <em>gerçek bir enerji</em>
          ile çalışır ve dokuda <em>bir şey</em> yaparlar; ama bu "bir şey"
          cerrahi sonuçtan belirgin biçimde uzakta kalır. HIFU yüz uygulamasında
          orta düzeyde kanıt; RF cilt sıkılaştırmada zayıf-orta kanıt; pelvik RF,
          mikroakım ve LED ev cihazları için kanıt belirgin biçimde sınırlı.
          Postmenopozal dönemde sonuç biraz daha mütevazı olur — çünkü cihaz
          hormonal yaşlanmayı çözmez, üstüne küçük bir katkı sunar.
        </p>
        <p>
          Doktorunuza üç soruyla gidin: <em>"Bu cihaz için kanıt seviyesi nedir,
          hangi tür çalışmaya dayanıyor?"</em>, <em>"Beklenti seviyem ne olmalı,
          sonucu ne ile ölçeceğiz?"</em>, <em>"Yan etki, risk ve memnun kalmayan
          hasta oranı nedir?"</em>. Bu üç soru tedaviyi bir vaatten klinik
          karara çevirir.
        </p>
        <p>
          Yaşlanma karşısında bir an gelir, çoğumuz <em>"bir şey yapsam"</em>
deriz — bu duygu meşru ve insanca. His meşru, bilimsel tablo ayrı:
          dürüst yorum ne hissi küçümser ne de pazarlamaya teslim olur. Bilgi
          belirsizliğin panzehiridir — bu konuda da öyle. Cihaz kararı sakin
          değerlendirmeyle hem cüzdanı hem ruhsal beklentiyi koruyor.
        </p>
