---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuSection from '../../../components/site/SubmenuSection.astro';
import EditorPickCard from '../../../components/site/EditorPickCard.astro';
import MagazineTOC from '../../../components/site/MagazineTOC.astro';
import ChapterMasthead from '../../../components/site/ChapterMasthead.astro';
import EditorialEpigraph from '../../../components/site/EditorialEpigraph.astro';
import ChapterCompass from '../../../components/site/ChapterCompass.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { chapterMap, getNextChapter } from '../../../data/chapter-map';
import { subHubEpigraphs } from '../../../data/sub-hub-epigraphs';

const hero = submenuHeroByRoute['/zamansiz-yasam/non-invaziv']!;
const __path = '/zamansiz-yasam/non-invaziv';
const chapter = chapterMap[__path]!;
const epigraph = subHubEpigraphs[__path];
const next = getNextChapter(__path);

const editorPick = {
  href: '/zamansiz-yasam/non-invaziv/non-invaziv-cihazlar-hifu-rf-mikroakim',
  title: 'HIFU, Radyofrekans ve Mikroakım — Non-İnvaziv Cihazların Kanıt Sınırı',
  lede: 'HIFU, RF, mikroakım ve LED ışık cihazları "ameliyatsız yüz germe" vaadiyle yoğun pazarlanıyor; oysa kanıt cerrahi sonuçtan belirgin biçimde uzakta. Mekanizma sözlüğü, kanıt haritası, postmenopozal zemin ve hekim görüşmesi için somut soruların dürüst rehberi.',
  writerSlug: 'senai-aksoy',
  readingMinutes: 9,
  image: submenuHeroByRoute['/zamansiz-yasam/non-invaziv/non-invaziv-cihazlar-hifu-rf-mikroakim'] ?? submenuHeroByRoute['/zamansiz-yasam/non-invaziv']!,
};

const tocArticles = [
  {
    href: '/zamansiz-yasam/non-invaziv/sauna-soguk-dus-menopoz',
    title: 'Sauna ve Soğuk Duş — Sporcu Bedenden Önceki Kuşağın Sıcak Basmasına',
    excerpt: 'Sporcu olarak sauna ve soğuk maruziyet deneyimi, önceki kuşaktan bir kadının sıcak basması gözlemi, bilimsel bakış (kardiyovasküler, mood, sıcak basması paradoksu) ve güvenlik notları. Yaşıt ama mütevazı bir kuşak köprüsü.',
    writerSlug: 'alara-baykent',
    readingMinutes: 8,
  },
  {
    href: '/beden-yakinlik/cinsel-saglik/mahrem-bolge-degisimleri-menopoz',
    title: 'Vajinal Sağlık ve Menopoz',
    excerpt: 'Vulvovajinal atrofi, atrofik etkilerin günlük konfora yansıması ve non-hormonal destek seçenekleri üzerine planlı rehber.',
    writerSlug: 'senai-aksoy',
    readingMinutes: 8,
  },
];

const neighbors = [
  {
    href: '/zamansiz-yasam/vitaminler',
    title: 'Vitaminler',
    excerpt: 'D vitamini başta olmak üzere temel mikro besinler ve takviye okuması.',
  },
  {
    href: '/zamansiz-yasam/deneysel',
    title: 'Deneysel Yaklaşımlar',
    excerpt: 'Henüz standart öneri olmayan ancak araştırılan başlıklar; kanıt düzeyiyle değerlendirme.',
  },
  {
    href: '/beden-yakinlik',
    title: 'Beden & Yakınlık',
    excerpt: 'Cilt, vajinal sağlık ve pelvik taban gibi başlıklarda editöryal rehberler.',
  },
];
---

<SiteLayout
  title="Ameliyatsız Uygulamalar - Estranova"
  description="Cerrahi olmayan yaklaşımlar üzerine bağımsız editöryal içerikler; cilt, beden ve günlük iyi olma başlıklarında rehberler."
>
  <SiteNavbar currentPath="/zamansiz-yasam" />
  <ChapterMasthead number={chapter.number} parent={chapter.parent} chapter={chapter.chapter} />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Ameliyatsız"
      title="Ameliyatsız Uygulamalar"
      lede="Bu alt başlık altında ameliyat veya enjeksiyon gerektirmeyen yaklaşımları editöryal bir bakışla ele alıyoruz. Genel rehber yayında; başka başlıklar editöryal takvimde."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />

    <section class="border-b border-burgundy/10 bg-cream-soft px-6 py-12 md:py-16">
      <div class="mx-auto max-w-6xl">
        <nav class="mb-8 text-sm text-ink/60" aria-label="İçerik yolu">
          <ol class="flex flex-wrap items-center gap-2">
            <li>
              <a href="/zamansiz-yasam" class="font-medium text-burgundy hover:underline">Zamansız Yaşam</a>
            </li>
            <li aria-hidden="true">/</li>
            <li class="font-medium text-ink">Ameliyatsız</li>
          </ol>
        </nav>

        <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-start lg:gap-16">
          <div>
            <p class="mb-5 text-lg leading-relaxed text-ink/82 md:text-xl">
              Ameliyatsız uygulamalar başlığı altında ameliyat veya enjeksiyon gerektirmeyen, günlük rutinin ya
              da daha hafif yaklaşımların ele alındığı içerikleri topluyoruz. Burada amaç ne reklam, ne
              karşılaştırma; bu alana sakin ve bilgili bir gözle bakmak.
            </p>
            <p class="text-base leading-relaxed text-ink/72">
          Şu an yayında olan genel rehberin yanında cilt ve beden başlıklarındaki komşu okumaları
              toparladık. Yeni içerikler hazırlandıkça bu sayfa genişleyecek.
            </p>
          </div>

          <aside
            class="rounded-[28px] border border-burgundy/15 bg-white p-7 shadow-sm md:p-8"
            aria-labelledby="non-invaziv-ozet-baslik"
          >
            <h2 id="non-invaziv-ozet-baslik" class="mb-4 font-serif text-xl text-ink">Bu konuda sık sorulanlar</h2>
            <ul class="space-y-4 text-sm leading-relaxed text-ink/78">
              <li class="border-b border-burgundy/10 pb-4">
                <span class="block font-semibold text-ink">Ameliyatsız uygulamalar neden ayrı bir başlık?</span>
                Ameliyat veya enjeksiyon gerektirmeyen yaklaşımları, günlük bakımla birlikte değerlendirmek için.
              </li>
              <li class="border-b border-burgundy/10 pb-4">
                <span class="block font-semibold text-ink">Yakında neler yayınlanacak?</span>
                Cilt, dermokozmetik ve günlük bakım başlıkları editöryal takvimde.
              </li>
              <li>
                <span class="block font-semibold text-ink">Bilgi ürün satışı içerir mi?</span>
                Hayır; karşılaştırma, fiyatlandırma veya marka önerisi yapılmaz.
              </li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    {epigraph && <EditorialEpigraph quote={epigraph} />}

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Editör'ün Seçimi</p>
        <h2 class="font-serif text-3xl leading-tight md:text-4xl">Bu evreden bir okuma</h2>
      </header>

      {editorPick && (<EditorPickCard
        href={editorPick.href}
        title={editorPick.title}
        lede={editorPick.lede}
        writerSlug={editorPick.writerSlug}
        readingMinutes={editorPick.readingMinutes}
        imageSrc={editorPick.image.src}
        imageAlt={editorPick.image.alt}
      />)}
    </SubmenuSection>

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Bu Evrede Okumalar</p>
        <h2 class="font-serif text-3xl leading-tight md:text-4xl">Sayının diğer başlıkları</h2>
      </header>

      <MagazineTOC items={tocArticles} />
    </SubmenuSection>

    <SubmenuSection variant="cream" borderedTop={true}>
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Aynı kategoride ve komşu alanlar</p>
      <h2 class="mb-8 font-serif text-2xl md:text-3xl">İlgili alt başlıklar</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          neighbors.map((n) => (
            <a
              href={n.href}
              class="group rounded-[26px] border border-burgundy/12 bg-white p-7 transition hover:border-burgundy/28 hover:shadow-sm"
            >
              <h3 class="mb-2 font-serif text-xl text-ink group-hover:text-burgundy">{n.title}</h3>
              <p class="mb-4 text-sm leading-relaxed text-ink/72">{n.excerpt}</p>
              <span class="text-sm font-semibold text-burgundy group-hover:underline">Sayfaya git →</span>
            </a>
          ))
        }
      </div>
    </SubmenuSection>

    <ChapterCompass nextHref={next?.href} nextNumber={next?.number} nextChapter={next?.chapter} nextParent={next?.parent} />
  </main>

  <SiteFooter />
</SiteLayout>
