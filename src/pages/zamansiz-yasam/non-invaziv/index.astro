---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuSection from '../../../components/site/SubmenuSection.astro';
import SubmenuLinkCard from '../../../components/site/SubmenuLinkCard.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';

const hero = submenuHeroByRoute['/zamansiz-yasam/non-invaziv']!;

const articles = [
  {
    href: '/beden-yakinlik/menopozda-cilt-degisimleri',
    title: 'Menopozda Cilt Değişimleri',
    excerpt:
      'Menopoz döneminde ciltte yaşanan elastikiyet, nem ve incelik değişimleri; günlük bakım ve klinik yaklaşımlara sade bir bakış.',
    image: submenuHeroByRoute['/beden-yakinlik/menopozda-cilt-degisimleri']!,
  },
  {
    href: '/beden-yakinlik/vajinal-saglik-menopoz',
    title: 'Vajinal Sağlık ve Menopoz',
    excerpt:
      'Vulvovajinal atrofi, atrofik etkilerin günlük konfora yansıması ve non-hormonal destek seçenekleri üzerine yapılandırılmış rehber.',
    image: submenuHeroByRoute['/beden-yakinlik/vajinal-saglik-menopoz']!,
  },
];

const neighbors = [
  {
    href: '/zamansiz-yasam/vitaminler',
    title: 'Vitaminler',
    excerpt: 'D vitamini başta olmak üzere temel mikro besinler ve takviye okuması.',
  },
  {
    href: '/zamansiz-yasam/deneysel',
    title: 'Deneysel Yaklaşımlar',
    excerpt: 'Henüz standart öneri olmayan ancak araştırılan başlıklar; kanıt düzeyiyle değerlendirme.',
  },
  {
    href: '/beden-yakinlik',
    title: 'Beden & Yakınlık',
    excerpt: 'Cilt, vajinal sağlık ve pelvik taban gibi başlıklarda editöryal rehberler.',
  },
];
---

<SiteLayout
  title="Non-invaziv Uygulamalar - Estranova"
  description="Cerrahi olmayan yaklaşımlar üzerine bağımsız editöryal içerikler; cilt, beden ve günlük iyi olma çerçevesinde rehberler."
>
  <SiteNavbar currentPath="/zamansiz-yasam" />

  <main id="main-content" class="text-[#2D2D2D]">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Non-invaziv"
      title="Non-invaziv Uygulamalar"
      lede="Bu alt başlık altında ameliyat veya enjeksiyon gerektirmeyen yaklaşımları editöryal bir çerçevede ele alıyoruz. Yeni rehberler editöryal takvimde; şimdilik en yakın başlıklara aşağıdaki bağlantılardan ulaşabilirsiniz."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />

    <section class="border-b border-[#6B2D3E]/10 bg-[#FDF8F0] px-6 py-12 md:py-16">
      <div class="mx-auto max-w-6xl">
        <nav class="mb-8 text-sm text-[#2D2D2D]/60" aria-label="İçerik yolu">
          <ol class="flex flex-wrap items-center gap-2">
            <li>
              <a href="/zamansiz-yasam" class="font-medium text-[#6B2D3E] hover:underline">Zamansız Yaşam</a>
            </li>
            <li aria-hidden="true">/</li>
            <li class="font-medium text-[#2D2D2D]">Non-invaziv</li>
          </ol>
        </nav>

        <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-start lg:gap-16">
          <div>
            <p class="mb-5 text-lg leading-relaxed text-[#2D2D2D]/82 md:text-xl">
              Non-invaziv terimi pek çoğumuz için tanıdık değil; aslında ameliyat veya enjeksiyon gerektirmeyen,
              günlük rutinin ya da daha hafif uygulamaların ele alındığı bir başlık. Burada amaç ne reklam, ne
              karşılaştırma; bu alana sakin ve bilgili bir gözle bakmak.
            </p>
            <p class="text-base leading-relaxed text-[#2D2D2D]/72">
              Aşağıda şimdilik cilt ve beden başlıklarındaki en yakın editöryal rehberleri toparladık. Yeni içerikler
              hazırlandıkça bu sayfa genişleyecek.
            </p>
          </div>

          <aside
            class="rounded-[28px] border border-[#6B2D3E]/15 bg-white p-7 shadow-sm md:p-8"
            aria-labelledby="non-invaziv-ozet-baslik"
          >
            <h2 id="non-invaziv-ozet-baslik" class="mb-4 font-serif text-xl text-[#2D2D2D]">Bu konuda sık sorulanlar</h2>
            <ul class="space-y-4 text-sm leading-relaxed text-[#2D2D2D]/78">
              <li class="border-b border-[#6B2D3E]/10 pb-4">
                <span class="block font-semibold text-[#2D2D2D]">Non-invaziv neden ayrı bir başlık?</span>
                Ameliyat veya enjeksiyon gerektirmeyen yaklaşımları, günlük bakımla birlikte değerlendirmek için.
              </li>
              <li class="border-b border-[#6B2D3E]/10 pb-4">
                <span class="block font-semibold text-[#2D2D2D]">Yakında neler yayınlanacak?</span>
                Cilt, dermokozmetik ve günlük bakım başlıkları editöryal takvimde.
              </li>
              <li>
                <span class="block font-semibold text-[#2D2D2D]">Bilgi ürün satışı içerir mi?</span>
                Hayır; karşılaştırma, fiyatlandırma veya marka önerisi yapılmaz.
              </li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">İlgili rehberler</p>
        <h2 class="mb-4 font-serif text-3xl leading-tight md:text-4xl">Şimdilik en yakın başlıklar</h2>
        <p class="text-lg leading-relaxed text-[#2D2D2D]/75">
          Cilt değişimleri ve vajinal sağlık gibi başlıklar bu alana yakın editöryal okumalardır.
          Doğrudan non-invaziv başlıkları için yeni içerikler hazırlanıyor.
        </p>
      </header>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          articles.map((a) => (
            <SubmenuLinkCard
              href={a.href}
              title={a.title}
              excerpt={a.excerpt}
              imageSrc={a.image.src}
              imageAlt={a.image.alt}
              cta="Rehberi oku"
            />
          ))
        }
      </div>
    </SubmenuSection>

    <SubmenuSection variant="cream" borderedTop={true}>
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">Aynı kategoride ve komşu alanlar</p>
      <h2 class="mb-8 font-serif text-2xl md:text-3xl">İlgili alt başlıklar</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          neighbors.map((n) => (
            <a
              href={n.href}
              class="group rounded-[26px] border border-[#6B2D3E]/12 bg-white p-7 transition hover:border-[#6B2D3E]/28 hover:shadow-sm"
            >
              <h3 class="mb-2 font-serif text-xl text-[#2D2D2D] group-hover:text-[#6B2D3E]">{n.title}</h3>
              <p class="mb-4 text-sm leading-relaxed text-[#2D2D2D]/72">{n.excerpt}</p>
              <span class="text-sm font-semibold text-[#6B2D3E] group-hover:underline">Sayfaya git →</span>
            </a>
          ))
        }
      </div>
    </SubmenuSection>

    <section class="bg-white px-6 py-10">
      <div class="mx-auto max-w-4xl rounded-[20px] border border-[#6B2D3E]/12 p-6 text-center">
        <p class="text-sm leading-relaxed text-[#2D2D2D]/75">
          Bu sayfa genel bilgilendirme sunar; bireysel uygulama veya tedavi kararları için tıbbi değerlendirme yerine geçmez.
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
