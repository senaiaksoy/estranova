---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuHero from '../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../components/site/ArticleSummary.astro';
import RelatedReadings from '../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../components/site/ArticleFAQ.astro';
import Evidence from '../../components/site/Evidence.astro';
import RedFlagBox from '../../components/site/RedFlagBox.astro';
import { submenuHeroByRoute } from '../../data/submenu-heroes';
import { buildArticleSchemas } from '../../utils/article-schema';
import { articleFaqs } from '../../data/article-faqs';
import { resolveSiteUrl } from '../../utils/seo';

const pathname = '/zamansiz-yasam/belden-gelen-agri-kasik-genital-bolge/';
const hero = submenuHeroByRoute['/zamansiz-yasam/']!;

const articleTitle = 'Belden Gelen Ağrı Her Zaman Belde Kalmaz: Kasık ve Genital Bölgeye Vuran Ağrıyı Nasıl Okumalı?';
const seoTitle = 'Belden Gelen Ağrı: Kasık ve Genital';
const articleDescription =
  'Kasık ve genital bölge ağrısında bel, kalça, sinir ve pelvik tabanın olası rolü; hareketle değişimin sınırları ve değerlendirme gerektiren belirtiler.';

const tocEntries = [
  { id: 'agri-haritasi', label: 'Ağrının Haritası' },
  { id: 'bel-kalca-hatti', label: 'Bel ve Kalça Hattı' },
  { id: 'sinir-pelvik-taban', label: 'Sinir ve Pelvik Taban' },
  { id: 'mekanik-ipuclari', label: 'Mekanik İpuçları' },
  { id: 'degerlendirme-zinciri', label: 'Değerlendirme Zinciri' },
  { id: 'evde-dikkat', label: 'Evde Dikkat' },
  { id: 'ne-zaman-beklememeli', label: 'Ne Zaman Beklememeli?' },
  { id: 'kapanis', label: 'Kapanış' },
  { id: 'kaynaklar', label: 'Kaynaklar' },
  { id: 'sss', label: 'Sık Sorulanlar' },
];

const faqItems = articleFaqs[pathname] ?? [];
const siteUrl = resolveSiteUrl(Astro.site);
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'ersin-sarac',
  articleType: 'editorial-guide',
  publishedDate: '7 Mayıs 2026',
  modifiedDate: '14 Ekim 2026',
  pathname,
  articleSection: 'Zamansız Yaşam',
  sectionPath: '/zamansiz-yasam/',
  keywords: [
    'kasık ağrısı',
    'genital bölge ağrısı',
    'bel ağrısı',
    'pelvik taban',
    'sakroiliak eklem',
    'yansıyan ağrı',
  ],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/zamansiz-yasam/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Hareket"
      title={articleTitle}
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="ersin-sarac"
        articleType="editorial-guide"
        publishedDate="7 Mayıs 2026"
        lastUpdated="14 Ekim 2026"
        readingMinutes={9}
        imageSrc="/images/library/editorial/ersin-sarac-belden-gelen-agri-byline.jpg"
        imageAlt="Pencere yanında ayakta duran, bir elini beline koymuş kadın"
        imagePosition="right center"
      />

      <ArticleSummary title="Kısa Özet" class="article-export-summary">
        <p>
          Kasık ağrısı bazı kişilerde bel veya kalça çevresindeki yapılardan yansıyabilir. Genital bölge ağrısında
          ise pelvik taban, sinirler ve jinekolojik ya da ürolojik nedenler birlikte değerlendirilir. Ağrının hareketle
          değişmesi bir ipucudur; nedenini tek başına göstermez <Evidence level={3} /><sup><a href="#kaynak-1" aria-label="Kaynak 1">[1]</a>, <a href="#kaynak-2" aria-label="Kaynak 2">[2]</a></sup>.
          Bel ağrısıyla birlikte yeni genital uyuşma veya his kaybı, idrar yapamama ya da idrar-dışkı kontrolünde kayıp varsa acil değerlendirme alın; bu durumda evde egzersiz deneyerek beklemeyin <sup><a href="#kaynak-5" aria-label="Kaynak 5">[5]</a></sup>.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="agri-haritasi">Ağrının Yeri Her Zaman Kaynağını Söylemez</h2>
        <p>
          Kasığınızı elinizle gösterdiğinizde ağrının yerini tarif etmiş olursunuz. Kaynağına inmek için ise ağrının ne zaman başladığına ve hangi hareketlerde değiştiğine bakılır.
        </p>
        <p>
          Yansıyan ağrı, ağrının kaynaklandığı yapıdan başka bir bölgede hissedilmesidir. Bel ve sakroiliak eklem
          sorunlarına kasık ağrısı eşlik edebilir <Evidence level={3} /><sup><a href="#kaynak-1" aria-label="Kaynak 1">[1]</a></sup>.
          Bu ilişki, kasıkta veya genital bölgede hissedilen her ağrıyı belden gelen ağrı saymak için yeterli değildir.
        </p>
        <p>
          Bazen bir hastam eliyle doğrudan kasığını gösterir ve sorunun tam orada olduğunu söyler. Konuşma ilerledikçe
          ağrının uzun oturma, ayağa kalkma, bel pozisyonu ya da tek tarafa yük verme ile değiştiği ortaya çıkar. Bu
          noktada ağrının yeriyle hangi harekette değiştiğini birlikte değerlendiririz.
        </p>
        <p>
          Mahrem bir bölgede ağrıyı anlatmak zor gelebilir. Yakınmanızı tarif etmek için kusursuz bir tıbbi kelime
          bulmanız gerekmez; nerede hissettiğiniz ve günlük hayatınızı nasıl etkilediği iyi bir başlangıçtır.
        </p>

        <h2 id="bel-kalca-hatti">Bel, Sakroiliak Eklem ve Kalça Hattı Kasıkta Nasıl Konuşur?</h2>
        <p>
          Sandalyeden kalkmak, merdiven çıkmak ve yatakta dönmek bel ile kalça çevresini birlikte çalıştırır.
          Kasık ağrınızın bu hareketlerde değişmesi, muayenede bu bölgelere de bakılmasını gerektirebilir.
        </p>
        <p>
          Sakroiliak eklem, omurganın altındaki sakrum kemiği ile leğen kemiğinin birleştiği yerdir. Bu eklem ve bazı
          bel sorunlarında kasık ağrısı bildirilmiştir <Evidence level={3} /><sup><a href="#kaynak-1" aria-label="Kaynak 1">[1]</a></sup>.
          Bu bulgular, seçilmiş hastaların kayıtlarını geriye dönük inceleyen bir çalışmadan gelir; tek başına tanı koymaya yetmez.
        </p>
        <h3>Herkeste aynı his olmaz</h3>
        <p>
          Kimi kadınlar çekilme, kimileri derin baskı ya da yerini tam gösteremedikleri bir sızı tarif eder.
          Bu tarifler değerlidir; ancak tek bir kası, eklemi veya siniri işaret etmez.
        </p>
        <p>
          Kalçayı büken kaslar, iç uyluk kasları ve kalça çevresindeki diğer yapılar da değerlendirmeye katılabilir.
          Kas-iskelet muayenesi, gerektiğinde nörolojik ve pelvik değerlendirmeyle birlikte ele alınır
          <sup><a href="#kaynak-2" aria-label="Kaynak 2">[2]</a></sup>.
        </p>

        <h2 id="sinir-pelvik-taban">Sinir Hattı ile Pelvik Taban Neden Bu Kadar Kolay Karışır?</h2>
        <p>
          Otururken artan yanma ile derin bir baskı hissi aynı kişide bulunabilir. Hekim bu hislerin ne zaman başladığını ve hangisinin günlük hayatınızı daha çok etkilediğini de sorar.
        </p>
        <p>
          Pelvik bölgedeki sinirlerle ilişkili ağrı; yanma, batma, elektriklenme veya dokunmayla artan rahatsızlık
          şeklinde hissedilebilir <Evidence level={3} /><sup><a href="#kaynak-2" aria-label="Kaynak 2">[2]</a></sup>.
          Pelvik taban, leğen kemiğinin alt kısmındaki destek kaslarıdır. Bu kasların aşırı etkinliği ve hassasiyeti
          de pelvik ağrıya eşlik edebilir <Evidence level={3} /><sup><a href="#kaynak-3" aria-label="Kaynak 3">[3]</a></sup>.
        </p>
        <p>
          Genital bölgedeki sinir yakınmaları değerlendirilirken omurgayla ilişkili nedenler de araştırılabilir.
          Sinir, kas ve pelvik organ kaynaklı ağrıyı ayırmak için öykü ve muayene bulguları birlikte değerlendirilir
          <sup><a href="#kaynak-2" aria-label="Kaynak 2">[2]</a></sup>.
        </p>
        <p>
          Bazen bir hastam bunu ağrıdan çok oturdukça içeri doğru yayılan bir huzursuzluk olarak tarif eder.
          Bu tarif, görüşmede sinir ve pelvik taban değerlendirmesini birlikte düşünmeye yardımcı olur; aynı
          yakınmayı yaşayan herkesin nedeni aynı olmayabilir.
        </p>

        <h2 id="mekanik-ipuclari">Hangi İşaretler Mekanik Bir Hattı Daha Güçlü Düşündürür?</h2>
        <p>
          Ağrının uzun oturuşta mı, yürüyüşte mi, yoksa tek tarafa yük verirken mi değiştiğini fark edebilirsiniz.
          Bunları görüşmede anlatmanız, hangi hareketlerin değerlendirmede ele alınacağını netleştirir.
        </p>
        <p>
          Oturup kalkma, bel pozisyonu ve yüklenmeyle değişen yakınmalar kas-iskelet değerlendirmesinde ipucu verir
          <Evidence level={3} /><sup><a href="#kaynak-1" aria-label="Kaynak 1">[1]</a>, <a href="#kaynak-2" aria-label="Kaynak 2">[2]</a></sup>.
          Fakat hareketle ağrının artması iç organ kaynaklı nedenleri dışlamaz. Ateş veya kanamanın olmaması da
          ağrının kesin olarak mekanik olduğunu göstermez <sup><a href="#kaynak-6" aria-label="Kaynak 6">[6]</a></sup>.
        </p>
        <h3>Ertesi gün bıraktığı iz de önemlidir</h3>
        <p>
          Bazı yakınmalar hareket sırasında hafif görünür, ama ertesi gün oturmayı ya da yürümeyi zorlaştırır.
          Bu, yüklenmeyi yeniden gözden geçirmek için bir neden olabilir. Tek başına doku hasarını ya da belirli bir tanıyı göstermez. Bedeni dinleyerek ilerlemek, o anki hissin yanında ertesi günkü yanıtı da hesaba katmaktır.
        </p>
        <p>
          Hangi hareketin yakınmanızı değiştirdiğini ve bu değişimin ne kadar sürdüğünü hekiminize anlatabilirsiniz.
          Size uygun hareket miktarı, günlük işleviniz ve değerlendirme bulgularınızla birlikte belirlenir
          <sup><a href="#kaynak-4" aria-label="Kaynak 4">[4]</a></sup>.
        </p>

        <h2 id="degerlendirme-zinciri">Değerlendirme Zincirinde Hangi Sorular Öne Çıkar?</h2>
        <p>
          Hekimle konuşurken yalnızca ağrıyan yeri değil, ağrının gün içindeki değişimini de anlatırsınız.
          Muayene ve gerekli tetkikler bu öyküdeki sorulara yanıt arar.
        </p>
        <p>
          Belin ve kalçanın hareketi, yürüme biçimi, oturup kalkma ve yük taşıma sırasında ağrının değişimi
          değerlendirilebilir. Gerekirse sinir işlevine yönelik muayene ve pelvik taban konusunda eğitimli bir
          fizyoterapistin değerlendirmesi eklenir <Evidence level={4} /><sup><a href="#kaynak-2" aria-label="Kaynak 2">[2]</a>, <a href="#kaynak-3" aria-label="Kaynak 3">[3]</a></sup>.
          Pelvik muayene gerekiyorsa amacı ve nasıl yapılacağı önceden açıklanır, onayınız alınır.
        </p>
        <p>
          Her bel ağrısında MR gerekmez; görüntüleme, sonucu tedavi yaklaşımını değiştirecekse düşünülür
          <Evidence level={4} /><sup><a href="#kaynak-4" aria-label="Kaynak 4">[4]</a></sup>.
          Normal bir bel MR’ı da ağrıyı veya bütün pelvik nedenleri dışlamaz. Pelvik sinir yakınmalarında tetkikler
          normal olabilir; muayene ile görüntüleme birlikte değerlendirilir <sup><a href="#kaynak-2" aria-label="Kaynak 2">[2]</a></sup>.
        </p>
        <h3>Jinekolojik ve ürolojik hat ne zaman öne çıkar?</h3>
        <p>
          Yeni pelvik ağrıya ateş, olağandışı kanama veya akıntı, idrar yaparken yanma ya da idrar yapmakta güçlük
          eşlik ediyorsa aynı gün hekim değerlendirmesi alın. Gebelik ihtimali varsa bunu da belirtin; pelvik ağrı
          bu durumda da gecikmeden değerlendirilir <Evidence level={4} /><sup><a href="#kaynak-6" aria-label="Kaynak 6">[6]</a></sup>.
          Cinsel ilişkiyle artan veya bağırsak düzeniyle değişen ağrıyı da hekiminize anlatın. Şiddetli alt karın
          ağrısı, bayılma veya yoğun kanamada ise aşağıdaki acil değerlendirme ayrımı geçerlidir.
        </p>
        <p>
          Kas-iskelet, jinekolojik ve ürolojik nedenler birlikte bulunabilir. İlk değerlendirmede hangi branşın
          öncelikli olduğu, eşlik eden belirtilere ve muayeneye göre belirlenir.
        </p>

        <h2 id="evde-dikkat">Evde Neyi Zorlamamak Daha Doğru Olur?</h2>
        <p>
          Ağrı başlayınca daha çok esnemek veya bütün hareketi bırakmak isteyebilirsiniz.
          Önce aşağıdaki acil belirtilerin bulunup bulunmadığını ayırmak gerekir.
        </p>
        <p>
          Acil belirtiler yoksa ve değerlendirme kas-iskelet kaynaklı bir yakınmayı düşündürüyorsa, hareket günlük
          kapasitenize göre düzenlenir. Bel ağrısında uzun süreli yatak istirahati yerine katlanabildiğiniz günlük etkinlikleri sürdürmek önerilir <Evidence level={4} /><sup><a href="#kaynak-4" aria-label="Kaynak 4">[4]</a></sup>.
          Bu yaklaşım, yeni veya nedeni bilinmeyen genital ağrı için hazır bir egzersiz reçetesi değildir.
        </p>
        <p>
          Ağrıyı belirgin artıran derin esnemeyi, karın sıkma egzersizini veya hızı artırmayı zorlamayın.
          Kısa hareket aralarını ve rahatlatan pozisyonları fizyoterapistinizle konuşabilirsiniz. Pelvik taban
          yakınmasında daha çok sıkma egzersizi her zaman uygun olmaz; aşırı kas etkinliğinde gevşemeye yönelik
          yaklaşım gerekebilir <Evidence level={3} /><sup><a href="#kaynak-3" aria-label="Kaynak 3">[3]</a></sup>.
        </p>

        <h2 id="ne-zaman-beklememeli">Hangi Durumlarda Beklememek Gerekir?</h2>
        <p>
          Bazı belirtiler planlı bir muayeneyle izlenebilir; bazıları ise hemen değerlendirme ister. Aşağıdaki belirtiler ikinci gruba girer.
        </p>
        <p>
          Bel ağrısıyla birlikte yeni başlayan idrar yapamama, idrar-dışkı kontrolünde kayıp veya genital bölge ile
          makat çevresinde uyuşma, omurganın alt kısmındaki sinirlerin etkilenmesini düşündürebilir.
          Güç kaybının eklenmesini beklemeyin <Evidence level={5} /><sup><a href="#kaynak-5" aria-label="Kaynak 5">[5]</a></sup>.
        </p>
        <div class="article-safety-callout">
        <RedFlagBox
          title="Acil değerlendirme gerektiren belirtiler"
          intro="Aşağıdaki belirtilerde egzersiz deneyerek veya planlı görüşmeyi bekleyerek zaman kaybetmeyin; acil servise başvurun."
          markers={[
            'Bel ağrısıyla birlikte yeni başlayan idrar yapamama veya idrar-dışkı kontrolünde kayıp',
            'Bel ağrısıyla birlikte genital bölge, makat çevresi veya iç uylukların mahrem bölgeye yakın kısmında yeni his kaybı',
            'Bacaklarda hızla ilerleyen güç kaybı veya bel ağrısıyla birlikte iki bacakta yeni uyuşma ya da güçsüzlük',
            'Ani ve şiddetli alt karın ağrısı; özellikle bayılma, yoğun kanama veya belirgin genel durum bozukluğuyla birlikteyse',
          ]}
          footnote="Bu belirtiler tek bir tanıyı kanıtlamaz; acil değerlendirmede ciddi nedenlerin dışlanması gerekir. Kaynaklar: [5, 6]."
        />
        </div>
        <h3>Geciktirmeden hekimle görüşülmesi gereken diğer durumlar</h3>
        <p>
          Düşme, çarpma ya da ani zorlanmanın ardından başlayan ve yük vermeyi zorlaştıran ağrı hekim değerlendirmesi gerektirir. Ateş, gece terlemesi, açıklanamayan kilo kaybı ve genel durum bozukluğu da aynı şekilde ele alınmalıdır. Gece uykudan uyandıran, giderek artan ağrı da bu gruba girer. Kanama, yoğun akıntı ve idrar yaparken yanmayı da hekiminize mutlaka söyleyin
          <sup><a href="#kaynak-5" aria-label="Kaynak 5">[5]</a>, <a href="#kaynak-6" aria-label="Kaynak 6">[6]</a></sup>.
          Şiddetli veya hızla kötüleşen yakınmalarda acil değerlendirme alın. Ağrı sürüyor, tekrarlıyor veya günlük
          işlerinizi engelliyorsa, acil belirti olmasa da planlı hekim değerlendirmesini ertelemeyin.
        </p>

        <h2 id="kapanis">Kapanış</h2>
        <p>
          Görüşmeye ağrının ne zaman başladığını, hangi hareketlerde değiştiğini ve eşlik eden belirtileri anlatarak
          başlayabilirsiniz. Bu bilgiler, bel ve kalça muayenesini diğer branşların bulgularıyla bir araya getirir.
        </p>
        <p>
          Küçük adımların gücü burada da geçerli. Uygun hareketin miktarını değerlendirme bulgularınıza göre birlikte belirlersiniz. Fizyoterapistinizle mola aralarını ve yeniden değerlendirme gerektiren değişiklikleri de konuşabilirsiniz.
        </p>

        <h2 id="kaynaklar">Kaynaklar ve İleri Okuma</h2>
        <p>
          Ağrının yeri ve hareketle ilişkisi değerlendirmeye yardımcı olur. Aşağıdaki kaynaklar bu bilgilerin
          sınırlarını, pelvik değerlendirmeyi ve başvuru gerektiren belirtileri açıklar.
        </p>
        <ol>
          <li id="kaynak-1"><a href="https://pubmed.ncbi.nlm.nih.gov/28866262/" target="_blank" rel="noopener noreferrer">Kurosawa ve arkadaşları, 2017. Sakroiliak eklem ve bel sorunlarına eşlik eden kasık ağrısı.</a> Geriye dönük hasta kayıtları; genital ağrının bel kaynaklı olduğunu kanıtlamaz.</li>
          <li id="kaynak-2"><a href="https://uroweb.org/guidelines/chronic-pelvic-pain/chapter/diagnostic-evaluation" target="_blank" rel="noopener noreferrer">Avrupa Üroloji Derneği, Kronik Pelvik Ağrı Rehberi: Tanısal değerlendirme.</a> Sinir, kas-iskelet ve pelvik organ değerlendirmesi; muayenede bilgilendirme ve onay.</li>
          <li id="kaynak-3"><a href="https://uroweb.org/guidelines/chronic-pelvic-pain/chapter/management" target="_blank" rel="noopener noreferrer">Avrupa Üroloji Derneği, Kronik Pelvik Ağrı Rehberi: Yönetim.</a> Pelvik taban aşırı etkinliği ve uzmanlaşmış fizyoterapi; tedavi araştırmalarının sınırlılıkları.</li>
          <li id="kaynak-4"><a href="https://www.nice.org.uk/guidance/ng59/chapter/recommendations" target="_blank" rel="noopener noreferrer">NICE NG59: Bel ağrısı ve siyatikte değerlendirme ve yönetim.</a> Günlük etkinlikler, kişiye uygun hareket ve görüntülemenin kullanım sınırları.</li>
          <li id="kaynak-5"><a href="https://www.nice.org.uk/guidance/ng127/chapter/recommendations-for-adults-aged-over-16" target="_blank" rel="noopener noreferrer">NICE NG127, bölüm 1.7.3: Bel ağrısıyla birlikte yeni nörolojik belirtiler.</a> İdrar-dışkı işlevi değişikliği ve perineal uyuşmada acil değerlendirme. Ayrıca <a href="https://www.nhs.uk/conditions/back-pain/" target="_blank" rel="noopener noreferrer">NHS: Bel ağrısında başvuru gerektiren belirtiler.</a></li>
          <li id="kaynak-6"><a href="https://www.nhs.uk/symptoms/pelvic-pain/" target="_blank" rel="noopener noreferrer">NHS: Pelvik ağrı.</a> Jinekolojik, ürolojik ve diğer nedenler; ani veya şiddetli yakınmalarda başvuru.</li>
        </ol>
      </ArticleProsePanel>

      <ArticleFAQ
        id="sss"
        items={faqItems}
        intro="Bu sorular, makaledeki değerlendirme ve güvenlik ayrımlarını kısa yanıtlarla bir araya getirir."
        class="mt-10"
      />

      <RelatedReadings
        class="mt-14"
        paths={[
          '/zamansiz-yasam/40-sonrasi-kas-iskelet-agrilari/',
          '/beden-yakinlik/cinsel-saglik/cinsellikte-agri-menopoz/',
          '/beden-yakinlik/pelvik-taban/menopozda-idrar-kacirma-pelvik-taban/',
          '/hormonal-gecis/menopoz/menopozda-hekim-hasta-iliskisi/',
        ]}
