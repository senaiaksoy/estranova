    sourceRefs: [2, 4, 5],
  },
  {
    question: 'Kilo vermek gerçekten diz ağrısını azaltır mı?',
    answer: 'Diz osteoartriti olan ve fazla kilo ya da obeziteyle yaşayan kişilerde kilo yönetimi ağrı ve işlev açısından yarar sağlayabilir. Bu öneri, normal kilodaki herkesin kilo vermesi gerektiği anlamına gelmez. Diz ağrısının nedeni ve size uygun hedef birlikte değerlendirilir.',
    sourceRefs: [1],
  },
  {
    question: 'Ne kadar süre konservatif plan denenmeli?',
    answer: 'Cerrahi dışı tedavi için bütün diz ağrılarına uyan tek bir süre yoktur. Kontrol zamanı tanıya, belirtilere ve tedaviye yanıta göre belirlenir. Yeni kilitlenme, hızla artan şişlik veya belirgin kötüleşme olduğunda planlanan kontrol tarihini beklemeyin.',
    sourceRefs: [1, 2],
  },
];
const articleImage = '/images/library/editorial/40-sonrasi-diz-agrisi-izlem-mudahale.webp';
const sources = [
  { id: 1, label: 'NICE. Osteoarthritis in over 16s: diagnosis and management. NG226, 2022. Tanı, egzersiz, kilo yönetimi, enjeksiyonlar, izlem ve eklem protezine yönlendirme önerileri.', url: 'https://www.nice.org.uk/guidance/ng226/chapter/Recommendations' },
  { id: 2, label: 'NHS. Knee pain. Diz ağrısında değerlendirme ve acil uyarı belirtileri; son inceleme 21 Aralık 2023.', url: 'https://www.nhs.uk/symptoms/knee-pain/' },
  { id: 3, label: 'NHS. DVT (deep vein thrombosis). Tek taraflı bacak belirtileri ve nefes darlığında acil değerlendirme; son inceleme 30 Nisan 2026.', url: 'https://www.nhs.uk/conditions/deep-vein-thrombosis-dvt/' },
  { id: 4, label: 'AAOS. Management of Acute Isolated Meniscal Pathology. Klinik uygulama kılavuzu, 10 Haziran 2024. Akut izole menisküs yaralanmaları; dejeneratif ve kronik yırtıklar kapsam dışıdır.', url: 'https://www.aaos.org/quality/quality-programs/acute-isolated-meniscal-pathology/' },
  { id: 5, label: 'Siemieniuk RAC ve ark. Arthroscopic surgery for degenerative knee arthritis and meniscal tears: a clinical practice guideline. BMJ. 2017;357:j1982. doi:10.1136/bmj.j1982.', url: 'https://www.bmj.com/content/357/bmj.j1982' },
  { id: 6, label: 'Critchlow AJ ve ark. The role of estrogen in female skeletal muscle aging: A systematic review. Maturitas. 2023;178:107844. doi:10.1016/j.maturitas.2023.107844. PMID:37716136.', url: 'https://doi.org/10.1016/j.maturitas.2023.107844' },
  { id: 7, label: 'Lawford BJ ve ark. Exercise for osteoarthritis of the knee. Cochrane Database of Systematic Reviews. 2024;12:CD004376. doi:10.1002/14651858.CD004376.pub4.', url: 'https://www.cochrane.org/evidence/CD004376_exercise-effective-therapy-treat-knee-osteoarthritis' },
  { id: 8, label: 'T.C. İçişleri Bakanlığı. 112 Acil Çağrı Merkezi. Türkiye’de acil çağrılar için tek numara.', url: 'https://www.112.gov.tr/' },
  { id: 9, label: 'NHS. Symptoms of a stroke. Ani tek taraflı güç kaybı ve diğer nörolojik belirtilerde acil yardım; son inceleme 12 Eylül 2024.', url: 'https://www.nhs.uk/conditions/stroke/symptoms/' },
];
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'bulent-aksoy',
  articleType: 'clinical-guide',
  publishedDate: '8 Mayıs 2026',
  modifiedDate: '14 Ekim 2026',
  pathname: pathname,
  articleSection: 'Zamansız Yaşam',
  sectionPath: '/zamansiz-yasam/',
  keywords: [
    '40 sonrası diz ağrısı',
    'diz ağrısı izlem',
    'diz ağrısı müdahale',
    'diz osteoartriti',
