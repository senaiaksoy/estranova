---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuHero from '../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../components/site/ArticleAuthorBlock.astro';
import ArticleProsePanel from '../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../components/site/ArticleDisclaimer.astro';
import MedicalContextNote from '../../components/site/MedicalContextNote.astro';
import ArticleSummary from '../../components/site/ArticleSummary.astro';
import RelatedReadings from '../../components/site/RelatedReadings.astro';
import Evidence from '../../components/site/Evidence.astro';
import { submenuHeroByRoute } from '../../data/submenu-heroes';
import { buildArticleSchemas } from '../../utils/article-schema';
import { resolveSiteUrl } from '../../utils/seo';

const pathname = '/zamansiz-yasam/yapay-zeka-hekim-cihaz-dengesi/';
const hero = submenuHeroByRoute['/zamansiz-yasam/']!;

const articleTitle = 'Yapay Zekâya Sorduğum Bir Soru, Hekime Yazdığım Bir Not — Sağlık Bilgisinin Üçlü Dengesi';
const seoTitle = 'Yapay Zekâ, Hekim ve Cihaz Dengesi';
const articleDescription =
  'Yapay zekâ asistanı, kişisel takip verisi ve hekim yorumu aynı masada nasıl durur? Rima Erdemir, üç bilgi kaynağının birbirini nasıl tamamladığını anlatıyor.';

const siteUrl = resolveSiteUrl(Astro.site);
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'rima-erdemir',
  articleType: 'experience-essay',
  publishedDate: '29 Nisan 2026',
  modifiedDate: '1 Ekim 2026',
  pathname,
  articleSection: 'Zamansız Yaşam',
  sectionPath: '/zamansiz-yasam/',
  keywords: [
    'yapay zekâ',
    'dijital sağlık',
    'dijital takip verisi',
    'menopoz',
    'post-menopoz',
    'sağlık okuryazarlığı',
  ],
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/zamansiz-yasam/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Dijital Sağlık"
      title={articleTitle}
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <ArticleAuthorBlock
        authorSlug="rima-erdemir"
        articleType="experience-essay"
        publishedDate="29 Nisan 2026"
        lastUpdated="1 Ekim 2026"
        readingMinutes={8}
        imageSrc="/images/library/editorial/rima-erdemir-yapay-zeka-hekim-cihaz-byline.jpg"
        imageAlt="Çalışma masasında tablet ve sağlık notları yanında düşünen 50+ kadın portresi; yapay zekâ, hekim yorumu ve kişisel takip verisi dengesini sakin editoryal bir tonla anlatan dosya görseli"
        imagePosition="right center"
      />

      <ArticleSummary title="Bu yazıya başlarken">
        <p>
          Bir gece yapay zekâya sıcak basmalarımı sordum; sabah hekimime kendi gözlemlerimi yazdım.
          Menopoz sonrası dönemde uyku takibime de bakarken, bu üç bilgi kaynağından ne beklediğimi yeniden düşündüm.
        </p>
      </ArticleSummary>

      <ArticleProsePanel mode="experience">
        <h2 id="gece-sorusu">Gece Sorduğum Soruyu Sabah Yeniden Düşündüm</h2>
        <p>
          Gece telefonda okuduğum yanıt uzundu. Sabah hekimime yazacağım not ise birkaç cümleye sığdı.
        </p>
        <p>
          Geçen ay bir gece sıcak basmasıyla uyandım. Böyle geceler benim için yeni değil; ama son haftalarda
          sıcak basmalarını daha yoğun hissediyordum. Telefona uzandım. İçimde tuhaf bir merak vardı. Yapay zekâ
          asistanına bunun neden olabileceğini sordum. Karşıma uzun bir liste çıktı: akşam yemeği saati, oda
          sıcaklığı, stres, kahve, bazı ilaç etkileşimleri, uyku düzeni.
        </p>
        <p>
          O cevap aydınlatıcıydı, ama bana ait değildi. Yapay zekâ son üç haftadır kahveyi biraz artırdığımı
          bilmiyordu. Aile içinde uykunun bölündüğü bir döneme girdiğimizi de bilmiyordu. Sağlık taramalarımın geçmişi
          de o yanıtın içinde yoktu.
        </p>
        <p>
          Siz de gece yarısı bir soruyu telefona emanet ettiyseniz, sabah o yanıtın size ne kadar az şey sorduğunu
          fark etmiş olabilirsiniz. Ben hekimime not düşerken kendi gözlemimi yazdım: “Şu üç değişiklik oldu;
          sizce bunların bir anlamı var mı?”
        </p>

        <h2 id="yapay-zeka-siniri">Yapay Zekânın Yanıtını Bir Başlangıç Olarak Okuyorum</h2>
        <p>
          Bir konuya nereden bakacağınızı ararken kısa bir özet işe yarayabilir. O özeti kendi sağlığımla
          ilgili bir karara dönüştürürken duruyorum.
        </p>
        <p>
          Benim için yapay zekânın yararlı tarafı, dağınık soruları toparlamaya yardım etmesi. Bir başlığı daha
          anlaşılır hâle getirebiliyor, üzerinde düşünmek istediğim olasılıkları sıralayabiliyor. Kişisel öykümün
          yanıta ne kadar yansıdığı ise ayrı bir mesele. Aile öyküsü, sağlık riskleri ve o hafta yaşanan değişiklikler,
          genel bir sorunun yanıtında kendiliğinden yer almıyor.
        </p>
        <p>
          Uzun yıllar bilgi gürültüsünün içinde çalıştığım için manşet ile anlam arasındaki boşluğu sezmeye alışığım.
          Bugün aynı refleksi sağlık bilgisinde de kullanıyorum: akıcı bir yanıtın doğruluğunu ayrıca sorgulamak
          gerekiyor. Yapay zekânın yazdıklarını, hekimime soracağım konuları belirlemek için okuyorum.
          Son kararı o yanıta bırakmıyorum.
        </p>

        <h2 id="cihaz-verisi">Uyku Takibindeki Değişiklik Notuma Girdi</h2>
        <p>
          Siz de bir uyku uygulamasına bakıyorsanız, ekrandaki değişiklik ile o sabah nasıl hissettiğinizi
          yan yana düşünmüş olabilirsiniz. Benim dikkatimi de bu ikisi çekti.
        </p>
        <p>
          Uyku takip uygulamam son haftalarda hafif uyku süresini daha uzun, derin uyku süresini daha kısa
          gösteriyordu. Bunlar uygulamanın tahminleriydi. İlk anda üzerinde fazla durmadım.
          Bir uygulamanın benden fazla şey bildiğini sanacak kadar aceleci davranmak istemiyorum artık. Aynı dönemde gece
          sıcak basmaları da belirginleşince, bu değişikliği hekimime yazacağım nota ekledim.
        </p>
        <p>
          Uygulamanın gösterdiklerini kendi uyku gözlemimle birlikte ele aldım. “Son günlerde biraz kötü uyuyorum”
          derken hangi dönemi kastettiğimi anlatmamı kolaylaştırdı. Uyku evrelerinin gerçekten değişip değişmediğini
          ise bu veriden çıkaramazdım.
        </p>
        <p>
          Cihazdan beklediğim de buydu: fark ettiğim değişikliği konuşabilmek. Bana bir tanı vermesini beklemiyordum.
        </p>

        <h2 id="hekim-yorumu">Hekimimle Konuşurken Kendi Gözlemim Öne Çıktı</h2>
        <p>
          Hekiminize yazarken insan her şeyi bir arada anlatmak istiyor. Ben de öyle yaptım.
        </p>
        <p>
          Yapay zekânın listesini, uygulamadaki değişikliği ve kendi fark ettiklerimi aynı notta topladım. Notun tonu
          oldukça sadeydi: “Son haftalarda gece sıcak basmaları arttı. Yapay zekâ
          asistanı birkaç olası tetikleyici sıraladı. Uyku takibimde de ritim değişiyor. Ben ayrıca kahve miktarımın
          arttığını fark ettim. Sizce bunların arasında nasıl bir bağ olabilir?”
        </p>
        <p>
          İçiniz rahat olsun diye ekliyorum: Böyle bir not için uzman olmanız gerekmiyor. Değişikliğin ne zaman
          başladığını ve sizi en çok neyin rahatsız ettiğini yazmak iyi bir başlangıç.
        </p>
        <p>
          Gelen yanıt, yapay zekâ cevabından daha kısaydı; ama daha kişiseldi. İki değişken öne çıktı, bir kontrol
          önerildi, birkaç hafta sonra yeniden konuşma planlandı. Benim için fark burada belirginleşti:
          konuşma, genel bir olasılık listesinden kendi yaşadığım değişikliklere geldi. Hangi gözlemin üzerinde
          duracağımızı hekimimle birlikte değerlendirdik.
        </p>

        <h2 id="sade-soru">Bilgi Çoğaldıkça Daha Sade Soru Sormayı Öğreniyorum</h2>
        <p>
          Telefonumdaki aramalara dönüp baktığımda, aynı konu çevresinde ne kadar dolaştığımı görüyorum.
        </p>
        <p>
          Uyku, sıcak basması, uyku takip verisi, yapay zekâ, hormonal geçiş. Başlıklar çoğaldıkça konuyu daha iyi
          anladığımı sanıyordum. Oysa hekimime yazarken beni en çok ilgilendiren değişikliği birkaç cümlede
          anlatabilmek daha yararlı oldu.
        </p>
        <p>
          Şimdi kendime daha yalın sorular soruyorum: “Bu veri hangi kalıbı gösteriyor?” “Bu değişiklik ne zaman başladı?”
          “Bunu kendi sağlık öykümle birlikte düşündüğümde ne anlam çıkıyor?” Hepsinin yanıtını kendim bulmam gerekmiyor.
          Belki yaş almanın iyi taraflarından biri de bu: daha çok şey bilip daha az kelimeyle sormak.
        </p>
        <p>
          Hâlâ her şey net değil. O gece beni telefona uzandıran merak da geçmedi. Artık onu uzun bir liste yerine,
          sabah hekimime yazacağım birkaç cümleye taşıyorum. Benim yolum bu; sizin bilgiye ulaşma ve hekiminizle konuşma biçiminiz farklı olabilir.
        </p>
      </ArticleProsePanel>

      <RelatedReadings
        class="mt-10"
        paths={[
          '/zamansiz-yasam/deneysel/deneysel-tedaviyi-okuma-kilavuzu/',
          '/zihin-denge/uyku-dinlenme/uyku-bozuklugu-menopoz/',
          '/bilimsel-pencere/yeni-arastirmalar/menopozda-hrt-avantajlari/',
        ]}
      />

      <MedicalContextNote class="mt-10">
        <p>
          Genel amaçlı yapay zekâ asistanlarının sağlık yanıtları yanlış veya eksik bilgi içerebilir.
          Kişisel öykü paylaşılmış olsa da bu yanıtlar bireysel tanı ve tedavi değerlendirmesinin yerini tutmaz.
          Tanı ve tedavi planlaması kişisel öykü, muayene ve hekim değerlendirmesi gerektirir.
        </p>
        <p>
          Tüketici tipi uyku takip araçları, zaman içindeki değişiklikleri konuşmaya yardımcı olabilir;
          uyku evresi tahminleri ise kesin ölçüm gibi yorumlanmamalıdır <Evidence level={3} />.
          Bu yazıda anlatılan takip uygulaması, tıbbi uyku değerlendirmesinin yerine geçmez.
        </p>
      </MedicalContextNote>

      <ArticleDisclaimer class="mt-10">
        <p>
          Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme yerine geçmez. Sağlığınıza dair kararları kendi
          hekiminizle birlikte değerlendirmeniz önerilir.
        </p>
      </ArticleDisclaimer>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
