---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuHero from '../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../components/site/ArticleProsePanel.astro';
import { submenuHeroByRoute } from '../../data/submenu-heroes';
import Evidence from '../../components/site/Evidence.astro';
import RelatedReadings from '../../components/site/RelatedReadings.astro';
import { buildArticleSchemas } from '../../utils/article-schema';
import { resolveSiteUrl } from '../../utils/seo';

const hero = submenuHeroByRoute['/zamansiz-yasam/seyahat-menopoz']!;

const tocEntries = [
  { id: 'ucus-oncesi', label: 'Uçuş Öncesi Hazırlık' },
  { id: 'kabin-iklimi', label: 'Kabin İklimi ve Sıcak Basması' },
  { id: 'dolasim-hareket', label: 'Dolaşım ve Hareket' },
  { id: 'zaman-farki', label: 'Zaman Farkı ve Uyku' },
  { id: 'otel-rutini', label: 'Otel Odasında İlk Gece' },
  { id: 'sosyal-yemek', label: 'Akşam Yemekleri ve Alkol' },
  { id: 'donus-toparlanma', label: 'Dönüşte Toparlanma' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Seyahatte Menopoz — Uçuş, Zaman Farkı ve Otel Odası Notları';
const articleDescription =
  'Uzun uçuşlar, jet lag, sıcak basması ve yeni mutfak ritmi menopoz geçişinde seyahati nasıl şekillendirir? Bir yaşıt perspektifinden sakin bir rehber.';
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'duygu-karaosmanoglu',
  publishedDate: '27 Nisan 2026',
  pathname: '/zamansiz-yasam/seyahat-menopoz',
  articleSection: 'Zamansız Yaşam',
  sectionPath: '/zamansiz-yasam',
  keywords: [
    'seyahat',
    'menopoz',
    'uzun uçuş',
    'jet lag',
    'zaman farkı',
    'sıcak basması',
    'uyku',
    'HRT',
    '40+ kadın',
    'sosyal yaşam',
  ],
  siteUrl,
});
---

<SiteLayout
  title={`${articleTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/zamansiz-yasam" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zamansız Yaşam · Seyahat"
      title="Seyahatte Menopoz — Uçuş, Zaman Farkı ve Otel Odası Notları"
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock authorSlug="duygu-karaosmanoglu" publishedDate="27 Nisan 2026" readingMinutes={7} />

      <section
        class="rounded-[28px] border border-gold/35 bg-gradient-to-br from-white to-cream-soft/90 p-7 shadow-sm ring-1 ring-gold/22 md:p-8"
      >
        <h2 class="mb-4 font-serif text-3xl">Kısa Özet</h2>
        <p class="leading-relaxed text-ink/80">
          Londra'ya her gittiğimde aynı şeyi fark ediyorum: bir uçak, bir saat farkı ve bambaşka bir mutfak ritmi
          menopoz dönemini biraz daha hissedilir kılıyor. Açıkçası bu beni seyahatten alıkoymuyor; sadece birkaç
          küçük hazırlığa ve dönüşte yumuşak bir inişe alan açmamı istiyor. Bu yazı, kendi bedenimde izlediğim ve
          arkadaşlarımla bir akşam yemeğinde defalarca konuştuğumuz pratik notların derlemesi.
        </p>
      </section>

      <ArticleProsePanel>
        <h2 id="ucus-oncesi">Uçuştan Önceki Gece — Bavul Hazır, Beden Hazır mı?</h2>
        <p>
          Londra'ya her gittiğimde uçuştan önceki gece bavulu bitiriyorum, sonra mutfakta bir bardak su içip
          oturuyorum. O sessiz on dakikada hep aynı şey aklıma geliyor: uçağa bavul kadar bedenimle de hazır binmek.
        </p>
        <p>
          Uçuş öncesi birkaç gün boyunca uyku saatini hedef saat dilimine doğru yavaş yavaş kaydırmak; sirkadiyen
          ritmin ani sıçramasını yumuşatabilir <Evidence level={4} />. Doğuya doğru gidiyorsan biraz erken, batıya
          gidiyorsan biraz geç yatmak — büyük bir disiplin değil, küçük bir nazik kaydırma.
        </p>
        <p>
          Bir de hep yaptığım bir şey var: son 24 saatte kafein ve alkolü biraz azaltıyorum. Gece terlemesini
          ve uçakta gözümün açık kalma saatlerini bu küçük ayar belirgin biçimde değiştirebiliyor
          <Evidence level={4} />. Bavula hep bir su şişesi, ince bir kazak ve katmanlı bir gömlek atıyorum;
          "ne olur ne olmaz" hissini "hazırım" rahatlığına dönüştüren küçük şeyler.
        </p>

        <h2 id="kabin-iklimi">Kabin Sıcak; Ben Bazen Daha Sıcak</h2>
        <p>
          Uçakta penceredeki o ışıkla bir bakıyorsun her şey sakin, bir bakıyorsun bir dalga ısı gelmiş, kazağı
          çıkarıyor, eşarbını açıyor, küçük bir el yelpazesini düşünüyorsun. Bu sahne benim için yeni değil; HRT'ye
          başladığımdan beri seyrekleşti ama bittiğini söyleyemem.
        </p>
        <p>
          Kabin havası kuru, serin ve basınçlıdır; menopoz döneminde bu üç faktör birleşince sıcak basması ve
          terleme atağı huzursuz bir saat yaratabilir <Evidence level={4} />. Burun ve göz kuruluğu da aynı
          tabloya eşlik etmeyi seviyor.
        </p>
        <p>
          Şunu söyleyebilirim: ince bir pamuklu kazak veya şal hep yanımdan ayırmadığım bir parça. Çıkarılır,
          örtülür, gerektiğinde yastık olur. Yanımda küçük bir su mendili tutmak da hızlı bir rahatlama
          getiriyor. Alkolü kabinde içmemeye özellikle dikkat ediyorum; o "şarap mı içsem" anına teslim olduğum
          günlerde sıcak basması katlandığı gibi, varış gecesi de zorlu geçebiliyor <Evidence level={4} />.
          Sade su, açıkçası, benim için hâlâ en sade seçenek.
        </p>

        <h2 id="dolasim-hareket">Beş Saat Üstü Uçuşlarda Bedenim Bana Hatırlatıyor</h2>
        <p>
          Eskiden bir uçuşta dümdüz oturup kitabı bitirirdim; şimdi bedenim her saatte bir hafifçe omzuma dokunup
          "kalk birkaç adım at" diyor. Bu, yaşa gelmek değil — bedeni dinlemeyi öğrenmek.
        </p>
        <p>
          Dört saatten uzun uçuşlarda uzun süre hareketsiz kalmak derin damar tıkanıklığı (DVT) riskini bir miktar
          artırabilir; menopoz dönemi ve hormon kullanımı bu tabloyu nüansla etkiler <Evidence level={4} />. İyi
          haber, küçük adımlar gerçekten fark yaratıyor.
        </p>
        <p>
          Benim yaptıklarım çok basit: saatte bir kalkıp koridorda kısa bir tur atıyorum, koltukta ayak bileklerimi
          döndürüyorum, baldır kaslarımı sıkıp gevşetiyorum <Evidence level={4} />. Su şişesini kabin görevlisinden
          istemekten çekinmiyorum — biri uzun uçuşlardan dönmüş bir yaşıta sorduğunda hep şunu söylüyorum: "su,
          adım, katman; üçü yeter". Eğer hekiminle daha önce kompresyon çorabı konuştuysan, uzun bir uçuşta onu
          unutmamak iyi fikir; yeni başlayacaksan bu kararı kişisel risk profilinle birlikte hekimle değerlendirmek
          gerekir.
        </p>

        <h2 id="zaman-farki">Zaman Farkı: Beden Saatim Yeniden Ayarlanırken</h2>
        <p>
          Zaman farkı bende hep ilk üç gün konuşur. Sabah çok erken uyanıyorum, akşam yemeğinde gözlerim kayıyor,
          sıcak basması seyrekken bile kendini hatırlatıyor. Bu, yaşadıklarımın seyahati durduran tarafı değil;
          sadece bana planlı bir iniş gerektiğini hatırlatan tarafı.
        </p>
        <p>
          Sirkadiyen ritim ışık, sıcaklık ve yemek saatleriyle ayarlanır <Evidence level={5} />. Yeni bir saat
          dilimine vardığında ritmi yeniden kurmanın en güçlü işareti sabah ışığıdır <Evidence level={5} />. Ben
          de bunu öğrendiğimden beri varış günü öğleden önce mutlaka kısa bir yürüyüşe çıkıyorum — Londra'da
          parka, İstanbul'da sahile.
        </p>
        <p>
          Sıcak basması varsa, jet lag onu ilk birkaç gün biraz öne çıkarabilir; bu yaygın ve yönetilebilir bir
          tablo <Evidence level={4} />. Benim küçük ritüellerim: yatmadan serin bir duş, ince pamuklu bir gecelik,
          başucunda bir bardak su. Melatonin bazı kişilerde yardımcı olabilir <Evidence level={4} />, ama HRT
          veya başka düzenli ilaç kullanıyorsan bu işi seyahatten önce hekimine sormak en güvenli yol; benim
          deneyimim şu oldu: doktorum söylemeden bir şeyi yola çıkmadan başlatmamak en rahatlatıcısı.
        </p>

        <h2 id="otel-rutini">İlk Geceyi Tanıdığa Çevirmek</h2>
        <p>
          Londra'da hep kızımda kalıyorum; ama orada bile, ilk gece bedenim "burası neresi" diye soruyor.
          Yatağı sevsem, oda tanıdık olsa bile menopoz uykusu yeni bir mekânda biraz huysuzlanabiliyor —
          ister sevdiğin birinin evinde, ister bir otel odasında ol.
        </p>
        <p>
          Yatak odasını serin (yaklaşık 16-19°C), karanlık ve sessiz tutmak gece uyanmalarını azaltır
          <Evidence level={5} />. Ben de kaldığım yere varır varmaz aynı şeyleri yapıyorum: oda sıcaklığını
          ayarlamak, perdeleri iyice çekmek, gerekirse ince bir nevresim daha istemek. Misafirlikteyken
          bu küçük talepleri çekinmeden söylemek de yıllar içinde öğrendiğim bir şey oldu.
        </p>
        <p>
          Bir de hep yanımda taşıdığım küçük bir tanıdık var: aynı kitap, aynı gecelik, kulaklıkta tanıdık
          birkaç şarkı. "Burada da güvendeyim" hissi bedene en hızlı bu sade tanıdıklar üzerinden ulaşıyor.
          Açıkçası bu artık bir batıl inanç değil; benim için çalışan bir uyku rutini.
        </p>

        <h2 id="sosyal-yemek">Bir Akşam Yemeğinden Sızılmadan Çıkmak</h2>
        <p>
          Seyahatin en güzel tarafı sofra; aynı zamanda menopoz uykusunu en hızlı zorlayan birkaç şeyin orada
          buluştuğu bir alan. Bu cümleyi ilk söylediğimde bir arkadaşım masada gülüp "biz de aynısını
          konuşuyorduk" demişti — yalnız değiliz.
        </p>
        <p>
          Alkol uykuya geçişi hızlandırıyor gibi görünse de gece içinde uyku derinliğini azaltır ve sıcak basması
          atağını tetikleyebilir <Evidence level={4} />. Acılı, çok yağlı ve büyük porsiyonlu yemekler de gece
          terlemesi ve reflüye yatkınlığı artırabilir <Evidence level={4} />. Bunu söylemek yeme zevkimizi
          bırakmak demek değil — sadece aklımızda küçük bir denge taşımak demek.
        </p>
        <p>
          Arkadaşlarımla bir akşam yemeğinde fark ettim ki, masada ne içtiğimden çok ne zaman bittiğimiz uykuyu
          belirliyor. O akşamdan beri yeni bir mutfakla tanıştığım ilk gecelerde küçük porsiyonlarla başlıyorum,
          geç saate yığmamaya çalışıyorum. Bir kadeh içtiysem ertesi gün hafif bir ara veriyorum; ertesi gece
          neredeyse her zaman karşılığını veriyor.
        </p>

        <h2 id="donus-toparlanma">Eve Dönerken Aceleci Olmamak</h2>
        <p>
          Bir seyahatin en zoru bazen dönüş oluyor. Çantaları çözmek değil, bedeni geri çağırmak. 55'imde fark
          ettim ki, eve döndüğüm sabah hemen rutine atlamak yerine üç günlük yumuşak bir iniş bana çok daha
          iyi geliyor.
        </p>
        <p>
          Dönüş gününde sabit bir uyku saati belirlemek toparlanmayı kolaylaştırabilir <Evidence level={4} />.
          İlk üç gün; ağır spor, uzun toplantılar ve büyük sosyal yemekler yerine yürüyüş, ev yemeği ve erken
          yatış benim formülüm. Jet lag, sıcak basması ve duygusal yorgunluğun aynı anda büyümesini önlemenin
          en sade yolu.
        </p>
        <p>
          Şunu söyleyebilirim: eğer dönüşte belirgin bir uyku bozukluğu, bacaklarda şişlik, açıklanamayan yorgunluk
          ya da nefes darlığı yaşıyorsan bunu "seyahat yorgunluğu" deyip geçiştirmemek gerek. Doktorumla
          paylaştığım küçük bir ayar tablonun tamamını çoğu zaman değiştiriyor; senin için de aynı olabilir.
        </p>
      </ArticleProsePanel>

      <RelatedReadings
        class="mt-14"
        paths={[
          '/zihin-denge/uyku-dinlenme/uyku-bozuklugu-menopoz',
          '/hormonal-gecis/menopoz/sicak-basmasi-gece-terlemesi',
          '/hormonal-gecis/menopoz/hrt-yan-etkileri-ve-izleme',
          '/zamansiz-yasam/hareket-saglik-menopoz',
          '/library',
        ]}
      />

      <section
        class="rounded-[28px] border border-burgundy/15 border-l-[6px] border-l-gold bg-gradient-to-r from-cream-warm to-cream-soft p-7 shadow-sm ring-1 ring-burgundy/10 md:p-8"
      >
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.22em] text-burgundy">Bilimsel Editör Notu</p>
        <p class="leading-relaxed text-ink/80">
          Seyahat sırasında uzun uçuşlar, zaman farkı ve değişen yeme-içme ritmi menopoz dönemine özgü belirtileri
          geçici olarak öne çıkarabilir. Hidrasyon, sabit uyku saati, ışıkla sirkadiyen ayarlama ve hareket
          molaları temel destek başlıklarıdır. Mevcut HRT veya başka tedavi rutini varsa, doz saatlerini seyahat
          öncesi planlamak ve önemli değişiklikler için hekim görüşü almak güvenli yaklaşımdır.
        </p>
      </section>

      <section class="rounded-[24px] border border-dashed border-burgundy/25 bg-white/95 p-6 ring-1 ring-burgundy/10">
        <p class="text-sm leading-relaxed text-ink/75">
          Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme yerine geçmez. Tanı ve tedavi kararları için
          sağlık profesyoneline başvurunuz.
        </p>
      </section>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
