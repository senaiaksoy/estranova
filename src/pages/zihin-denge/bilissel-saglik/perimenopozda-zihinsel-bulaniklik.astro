---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../../components/site/ArticleFAQ.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { articleFaqs } from '../../../data/article-faqs';
import { resolveSiteUrl } from '../../../utils/seo';

const pathname = '/zihin-denge/bilissel-saglik/perimenopozda-zihinsel-bulaniklik/';
const hero = submenuHeroByRoute[pathname] ?? submenuHeroByRoute['/zihin-denge/bilissel-saglik/']!;
const articleTitle = 'Perimenopozda Zihinsel Bulanıklık: Unutkanlık Hissi Günlük Hayatta Nasıl Okunur?';
const seoTitle = 'Perimenopozda Beyin Sisi ve Unutkanlık';
const articleDescription =
  'Perimenopozda beyin sisi, kelime bulma güçlüğü ve odaklanma sorunlarını; uyku, stres ve sıcak basmalarıyla birlikte sakin ve kaynaklı biçimde ele alan rehber.';
const publishedDate = '4 Mayıs 2026';
const modifiedDate = '4 Ağustos 2026';
const readingMinutes = 8;

const tocEntries = [
  { id: 'neden-simdi', label: 'Bu bulanıklık hissi neden tam da şimdi ortaya çıkıyor?' },
  { id: 'ayni-sey-mi', label: 'Unutkanlık ile zihinsel yorgunluk aynı şey mi?' },
  { id: 'uyku-stres', label: 'Uyku, stres ve sıcak basmaları zihni nasıl etkiliyor?' },
  { id: 'olagan-dalgalanma', label: 'Hangi belirtiler olağan dalgalanma gibi okunabilir?' },
  { id: 'ne-zaman-degerlendirme', label: 'Ne zaman daha dikkatli değerlendirme gerekir?' },
  { id: 'kucuk-duzenler', label: 'Gündelik hayatta zihni rahatlatan küçük düzenler' },
  { id: 'sik-sorulanlar', label: 'Sıkça Sorulanlar' },
  { id: 'kisa-hatirlatma', label: 'Kısa hatırlatma' },
  { id: 'kaynaklar', label: 'Kaynaklar' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const faqItems = articleFaqs[pathname] ?? [];
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'estranova-editorial',
  articleType: 'editorial-guide',
  publishedDate,
  modifiedDate,
  pathname,
  articleSection: 'Zihin & Denge',
  sectionPath: '/zihin-denge/',
  image: hero.src.startsWith('http') ? hero.src : `${siteUrl}${hero.src}`,
  keywords: [
    'perimenopoz',
    'beyin sisi',
    'unutkanlık',
    'odaklanma',
    'zihinsel yorgunluk',
    'bilişsel sağlık',
    'uyku',
    'stres',
    'hormon değişimi',
  ],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/zihin-denge/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zihin & Denge · Bilişsel Sağlık"
      title="Perimenopozda Zihinsel Bulanıklık"
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="estranova-editorial"
        articleType="editorial-guide"
        publishedDate={publishedDate}
        readingMinutes={readingMinutes}
        imageSrc="/images/library/editorial/perimenopozda-zihinsel-bulaniklik-byline.webp"
        imageAlt="Aydınlık bir kütüphane köşesinde notlarına bakan kadın; perimenopozda zihinsel bulanıklık ve odaklanma yazısı için editoryal görsel"
      />

      <ArticleSummary title="Kısa Özet">
<p>
          Bazen bir toplantının ortasında aradığınız kelime gelmez; bazen de mutfaktan neden kalktığınızı bir anlığına
          hatırlayamazsınız. Perimenopozda bu tür anlar, uyku bölünmesi, sıcak basmaları, stres ve hormonal geçişle
          birlikte daha sık hissedilebilir <Evidence level={4} />. Bu rehber, yaşadığınız şeyi küçümsemeden ama hemen
          en kötü sonuca da varmadan nasıl okuyabileceğinizi anlatıyor.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="neden-simdi">Bu bulanıklık hissi neden tam da şimdi ortaya çıkıyor?</h2>
        <p>
          Takvim aynı akar ama zihninizin çalışma ritmi bir süreliğine değişmiş gibi gelebilir. Perimenopoz,
          yalnızca adet düzenini değil, düşüncenin gündelik akışını da etkileyebilen bir geçiş dönemidir.
        </p>
        <p>
          Bu dönemde östrojen düzeyi dümdüz bir çizgi gibi ilerlemez; dalgalanır. Araştırmalar, dikkat, bellek ve
          duygu düzenleme ile ilişkili bilişsel süreçlerin bu geçişten etkilenebileceğini düşündürüyor <Evidence level={3} />.
          Bu yüzden kadınlar
          bazen kelimeyi geç bulduklarını, aynı anda birden fazla işle uğraşırken daha çabuk dağıldıklarını ya da
          zihinsel olarak günün erken saatlerinde yorulduklarını fark eder.
        </p>
        <p>
          Burada önemli olan, yaşadığınız hissi hemen ağır bir sonuca bağlamamak. Mesele çoğu zaman zekânızın
          azalması değil; bölünmüş uyku, sıcak basmaları, iş hayatı, aile sorumlulukları ve duygusal gerilimlerin
          aynı anda zihninizden geçmesi.
        </p>

        <h2 id="ayni-sey-mi">Perimenopozda unutkanlık ile zihinsel yorgunluk aynı şey mi?</h2>
        <p>
          Bir kelimeyi birkaç saniye geç hatırlamakla bütün gün zihninizin sisli çalışması aynı şey değil. Bu iki hissi
          birbirinden ayırmak, neye ihtiyacınız olduğunu anlamayı da kolaylaştırabilir.
        </p>
        <p>
          Unutkanlık hissi daha çok isim, kelime, yapılacak küçük bir iş ya da odaya neden girdiğini bir an için
          kaçırmak gibi görünür. Zihinsel yorgunluk ise odak süresinin kısalması, karar vermenin ağırlaşması,
          konuşurken cümleyi içeride biraz daha yavaş kurma ihtiyacı ve çoklu görevde daha çabuk dağılma şeklinde
          yaşanabilir <Evidence level={3} />.
        </p>
        <p>
          Bu ayrım önemli; çünkü "unutkanlık" diye tarif ettiğiniz şey bazen uykusuzluk ve stresle ağırlaşmış bir
          dikkat yorgunluğu olabilir. Bunu fark etmek kaygıyı azaltır ve hangi desteğin anlamlı olabileceğini gösterir.
        </p>

        <h2 id="uyku-stres">Uyku, stres ve sıcak basmaları zihni nasıl etkiliyor?</h2>
        <p>
          Zihin, gecenin nasıl geçtiğini sabah sessizce anlatır. İyi uyunmayan bir gece yalnızca göz altlarında değil,
          düşüncenin akışında da kendini belli edebilir.
        </p>
        <p>
          Gece terlemesi, sık uyanma ve yüzeysel uyku, ertesi gün dikkat toplama süresini kısaltabilir <Evidence level={4} />.
          Stres yükü arttığında beyin sürekli öncelik sıralamaya çalışır; bu da basit kararları bile gereğinden ağır
          hissettirebilir. Sıcak basmaları ise yalnızca kısa bir rahatsızlık anı yaratmaz; geceyi bölerek zihnin toparlanma
          kapasitesini de etkiler.
        </p>
        <p>
          Bu yüzden bilişsel sis çoğu zaman sadece "beyinle ilgili" değildir. Uyku kalitesi, sinir sistemi yükü,
          duygusal gerilim ve hormon dalgalanması birlikte çalışır. Tek bir sebep aramak yerine, birlikte hareket eden
          bu halkaları görmek daha gerçekçi bir bakış sunar.
        </p>

        <h2 id="olagan-dalgalanma">Hangi belirtiler olağan dalgalanma gibi okunabilir?</h2>
        <p>
          Her zihinsel aksama alarm değildir. Özellikle yoğun dönemlerde yaşanan küçük kaymalar, perimenopozun daha görünür
          kıldığı bir dalgalanma olarak yaşanabilir; yine de süre, şiddet ve günlük işlev üzerindeki etkisi önemlidir.
        </p>
        <p>
          Ara sıra kelime aramak, alışveriş listesine bakmadan bir şeyi atlamak, aynı anda birkaç işi yürütürken daha
          hızlı yorulmak, kalabalık ya da gürültülü ortamlarda dikkat toplamakta zorlanmak, sabahları biraz daha geç açılmak
          gibi örnekler sık görülür <Evidence from={3} to={4} />. Bunlar, özellikle uyku ve stres yükü eşlik ediyorsa,
          çoğu zaman tek başına ağır bir tablo anlamına gelmez.
        </p>
        <p>
          Yine de bu cümle, yaşanan hissi küçümsemek için değildir. Olağan dalgalanma da yıpratıcı olabilir; sadece onu
          doğru isimlendirmek, gereksiz korkuyla gereksiz küçümseme arasında daha dengeli bir yerde durmayı sağlar.
        </p>

        <h2 id="ne-zaman-degerlendirme">Ne zaman daha dikkatli değerlendirme gerekir?</h2>
        <p>
          Bazı değişimler vardır; artık yalnızca "yoğun bir dönem" diye açıklanmakta zorlanır. O noktada daha dikkatli
          bir değerlendirme istemek telaş değil, iyi bir öz bakım refleksidir.
        </p>
        <p>
          Günlük işlevi belirgin biçimde bozan unutkanlık, gittikçe artan yön bulma güçlüğü, konuşurken cümleyi toparlamada
          olağanın çok üstünde zorlanma, kişilikte dikkat çeken değişim, derin çöküntü hali, uzun süren uyku bozulması ya da
          başka nörolojik belirtilerin eşlik etmesi durumunda profesyonel değerlendirme geciktirilmemelidir <Evidence level={5} />.
        </p>
        <p>
          Ayrıca anemi, tiroid düzensizlikleri, B12 eksikliği, depresif dönemler ve bazı ilaç etkileri de benzer bir sis
          yaratabilir. Yani her şey hormon geçişiyle açıklanmak zorunda değildir; bazen soruyu biraz daha geniş sormak
          en doğru yoldur.
        </p>

        <h2 id="kucuk-duzenler">Gündelik hayatta zihni biraz rahatlatan küçük düzenler neler olabilir?</h2>
        <p>
          Zihin bu dönemde çoğu zaman büyük çözümlerden çok, gün içindeki küçük sürtünmeleri azaltan düzenlere ihtiyaç duyar.
          Amaç daha verimli görünmek değil; günü biraz daha taşınabilir hale getirmek.
        </p>
        <p>
          Gösterişli çözümler yerine sade adımlar daha kolay sürdürülebilir. Sabit uyku saati, aynı yerde duran bir not defteri,
          gün içinde tek bir işe dönmek, bildirim gürültüsünü azaltmak ve kısa hareket molaları bilişsel yükü hafifletebilir
          <Evidence level={3} />. Protein içeren dengeli kahvaltı, gün ışığıyla erken temas ve akşam ekran geçişlerini
          biraz yumuşatmak da dolaylı olarak odak hissini destekleyebilir.
        </p>
        <ul>
          <li>Yapılacakları zihinde tutmak yerine tek bir not sistemine indirmek</li>
          <li>Günün en dikkat isteyen işini sabaha almak</li>
          <li>Aynı anda üç şey yapmak yerine işi küçük bloklara ayırmak</li>
          <li>Gece uykusunu bölen etkenleri ayrı bir problem olarak ele almak</li>
          <li>Kendine "neden böyle oldum" yerine "bugün yükü nasıl azaltırım" diye sormak</li>
        </ul>
        <p>
          Bu öneriler bir gecede her şeyi değiştirmez. Ama bedenin yükünü biraz azaltmak, zihninize de yeniden alan açabilir.
          Bazen daha yararlı olan, her şeyi içeride tutmak yerine küçük bir not almak ya da bir işi yardım isteyerek paylaşmaktır.
        </p>

        <h2 id="kisa-hatirlatma">Kısa hatırlatma: Bu dönem zekâyı değil yükü değiştirir</h2>
        <p>
          Perimenopozdaki bilişsel dalgalanmalar, dışarıdan pek görünmediği için daha da yorucu olabilir. Her şey aynı
          görünürken içeride düşüncenin hızı bir süreliğine değişmiş gibidir.
        </p>
        <p>
          Bu, otomatik olarak bir kayıp hikâyesi anlamına gelmez. Bedeniniz yeni bir denge kurmaya çalışırken zihninizin
          de ilgi istemesi anlaşılır. Son aylarda kendinizi daha dağınık, daha çabuk yorulan ya da daha kolay bunalan biri
          gibi hissediyorsanız, bu sizi eksik yapmaz; yalnızca yükünüzü yeniden düzenlemeniz gerektiğini hatırlatabilir.
        </p>

        <h2 id="kaynaklar">Kaynaklar</h2>
        <p>Bu yazının bilişsel belirtiler ve değerlendirme sınırları için başvurduğu başlıca kaynaklar:</p>
        <ol>
          <li>The Menopause Society. <a href="https://menopause.org/patient-education/menopause-topics/mental-health" target="_blank" rel="noopener noreferrer">Orta yaşta bilişsel işlev ve ruh hâli hakkında hasta bilgilendirmesi</a>.</li>
          <li>NICE. <a href="https://www.nice.org.uk/guidance/NG23" target="_blank" rel="noopener noreferrer">Menopoz: tanımlama ve yönetim kılavuzu (NG23)</a>.</li>
          <li>Maki PM ve Weber MT. <a href="https://pubmed.ncbi.nlm.nih.gov/37755656/" target="_blank" rel="noopener noreferrer">Perimenopozda bilişsel sorunlar: güncel kanıtların derlemesi</a>. 2023.</li>
          <li>Weber MT ve ark. <a href="https://pubmed.ncbi.nlm.nih.gov/23770320/" target="_blank" rel="noopener noreferrer">Perimenopozda biliş ve duygu durumu üzerine sistematik derleme ve meta-analiz</a>. 2013.</li>
        </ol>
      </ArticleProsePanel>

      <ArticleFAQ id="sik-sorulanlar" items={faqItems} class="mt-10" />

      <RelatedReadings
        class="mt-14"
        paths={[
          '/zihin-denge/uyku-dinlenme/uyku-bozuklugu-menopoz/',
          '/zihin-denge/duygusal-denge/stres-yonetimi-menopoz/',
          '/hormonal-gecis/perimenopoz/perimenopoz-ilk-isaretler/',
        ]}
      />
      <ArticleEditorNote>
        <p>Perimenopozda tarif edilen bilişsel bulanıklık çoğu zaman yapısal bir bellek kaybı olarak değil, dikkat, uyku ve stres yükünün kesişiminde belirginleşen bir işlev dalgalanması olarak görünür.</p>
        <p>Östrojen dalgalanması, gece uyanmaları, vazomotor belirtiler ve duygu durum yükü birlikte çalıştığında kelime bulmada gecikme, odakta kırılma ve zihinsel yorgunluk hissi daha görünür hale gelebilir.</p>
        <p>Bununla birlikte belirgin yön bulma güçlüğü, hızla artan unutkanlık, günlük işlevde bozulma, uzun süren çöküntü hali ya da eşlik eden nörolojik belirtiler varsa tablo yalnızca hormonal geçiş başlığı altında değerlendirilmemelidir.</p>
        <p>Klinik yaklaşım çoğu zaman uyku düzeni, stres yükü, beslenme, tiroid-B12-demir ekseni ve gerekirse nörolojik veya psikiyatrik değerlendirme dahil daha geniş bir çerçeveyle düşünmeyi gerektirir.</p>
        <p class="text-sm italic text-primary">— Doç. Dr. Senai Aksoy, Estranova Bilimsel Editörü</p>
      </ArticleEditorNote>

      <ArticleDisclaimer class="mt-10">
        <p>Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavinin yerini almaz. Sağlık kararlarınız için kendi hekiminizle birlikte değerlendirme yapınız.</p>
      </ArticleDisclaimer>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
