---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../../components/site/ArticleFAQ.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { articleFaqs } from '../../../data/article-faqs';
import { resolveSiteUrl } from '../../../utils/seo';

const pathname = '/zihin-denge/bilissel-saglik/perimenopozda-zihinsel-bulaniklik/';
const hero = submenuHeroByRoute['/zihin-denge/bilissel-saglik/']!;
const articleTitle = 'Perimenopozda Zihinsel Bulanıklık: Unutkanlık Hissi Günlük Hayatta Nasıl Okunur?';
const seoTitle = 'Perimenopozda Beyin Sisi ve Unutkanlık';
const articleDescription =
  'Perimenopozda beyin sisi ve unutkanlık hissi; uyku, stres ve sıcak basmalarıyla birlikte. Çoğu zaman kalıcı bellek kaybı değildir; günlük işlev bozulursa değerlendirme gerekir.';
const publishedDate = '4 Mayıs 2026';
const modifiedDate = '21 Ekim 2026';
const readingMinutes = 8;

const tocEntries = [
  { id: 'neden-simdi', label: 'Perimenopozda bulanıklığın şimdi belirginleşmesi' },
  { id: 'ayni-sey-mi', label: 'Unutkanlık hissi ile zihinsel yorgunluk' },
  { id: 'uyku-stres', label: 'Uyku, stres ve sıcak basmalarının zihne etkisi' },
  { id: 'olagan-dalgalanma', label: 'Olağan dalgalanma gibi okunabilecek belirtiler' },
  { id: 'ne-zaman-degerlendirme', label: 'Ne zaman daha dikkatli değerlendirme gerekir?' },
  { id: 'kucuk-duzenler', label: 'Gündelik hayatta zihni rahatlatan küçük düzenler' },
  { id: 'kisa-hatirlatma', label: 'Kısa hatırlatma' },
  { id: 'sik-sorulanlar', label: 'Bu sis hakkında sorular' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const faqItems = articleFaqs[pathname] ?? [];
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'estranova-editorial',
  articleType: 'editorial-guide',
  publishedDate,
  modifiedDate,
  pathname,
  articleSection: 'Zihin & Denge',
  sectionPath: '/zihin-denge/',
  image: hero.src.startsWith('http') ? hero.src : `${siteUrl}${hero.src}`,
  keywords: [
    'perimenopoz',
    'beyin sisi',
    'unutkanlık',
    'odaklanma',
    'zihinsel yorgunluk',
    'bilişsel sağlık',
    'uyku',
    'stres',
    'hormon değişimi',
  ],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/zihin-denge/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zihin & Denge · Bilişsel Sağlık"
      title="Perimenopozda Zihinsel Bulanıklık"
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="estranova-editorial"
        articleType="editorial-guide"
        publishedDate={publishedDate}
        lastUpdated={modifiedDate}
        readingMinutes={readingMinutes}
        imageSrc="/images/library/editorial/perimenopozda-zihinsel-bulaniklik-byline.webp"
        imageAlt="Aydınlık bir kütüphane köşesinde notlarına bakan kadın; perimenopozda zihinsel bulanıklık ve odaklanma yazısı için editoryal görsel"
      />

      <ArticleSummary title="Kısa Özet">
        <p>
          Toplantının ortasında aradığınız kelime gelmez; mutfaktan kalkınca neden kalktığınızı bir an unutursunuz.
          Perimenopozda bu anlar uyku bölünmesi, sıcak basmaları, stres ve hormonal geçişle birlikte daha sık
          hissedilebilir <Evidence level={4} />. Çoğu zaman kalıcı bir bellek kaybı değildir. Günlük işleriniz
          bozuluyorsa, yön bulmak zorlaşıyorsa veya ani güçsüzlük, şiddetli baş ağrısı gibi ek belirtiler varsa
          değerlendirmeyi ertelemeyin.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="neden-simdi">Perimenopozda bulanıklığın şimdi belirginleşmesi</h2>
        <p>
          Toplantı masasında aradığınız kelime dilinizin ucunda durur. Gelir, ama birkaç saniye gecikir.
        </p>
        <p>
          Perimenopoz adet düzeninin yanı sıra düşünmenin gündelik akışını da etkileyebilir. Östrojen bu dönemde
          dümdüz ilerlemez; dalgalanır.
          Araştırmalar, dikkat, bellek ve duygu düzenlemeyle ilgili düşünme süreçlerinin bu geçişten
          etkilenebileceğini düşündürüyor <Evidence level={3} />.
        </p>
        <p>
          Bu yüzden kelimeyi geç bulabilirsiniz. Aynı anda birkaç işle uğraşırken daha çabuk dağılabilir, günün
          erken saatlerinde zihnen yorulabilirsiniz. İçiniz rahat olsun: Bu tablo çoğu zaman zekânızın azaldığını
          göstermez. Bölünmüş uyku, sıcak basmaları, iş ve ev yükü aynı anda zihninizden geçiyor olabilir.
        </p>

        <h2 id="ayni-sey-mi">Unutkanlık hissi ile zihinsel yorgunluk</h2>
        <p>
          Bir kelimeyi birkaç saniye geç hatırlamakla bütün gün sisin içinde yürümek aynı yük mü?
        </p>
        <p>
          Unutkanlık hissi çoğu zaman bir isim, bir kelime, yapılacak küçük bir iş ya da odaya girince duraklamak
          gibi görünür. Anahtar elinizde, salondasınız; niyet bir an kaybolmuştur. Zihinsel yorgunluk başka durur:
          odak süreniz kısalır, basit bir karar ağırlaşır, cümleyi içeride biraz daha yavaş kurarsınız, çoklu işte
          daha çabuk dağılırsınız <Evidence level={3} />.
        </p>
        <p>
          Bazen “unutkanlık” dediğiniz şey, uykusuzluk ve stresle ağırlaşmış bir dikkat yorgunluğudur. İsmi
          netleşince, neye ihtiyaç duyduğunuz da netleşir.
        </p>

        <h2 id="uyku-stres">Uyku, stres ve sıcak basmalarının zihne etkisi</h2>
        <p>
          Gece üçte çarşafı tekmeleyip uyandıysanız, sabah kelimeyi kaçırmanız şaşırtıcı olmayabilir.
        </p>
        <p>
          Gece terlemesi, sık uyanma ve yüzeysel uyku, ertesi gün dikkati toplama süresini kısaltabilir
          <Evidence level={4} />. Stres yükü arttığında zihin sürekli öncelik sıralar; basit kararlar bile
          gereğinden ağır gelebilir. Sıcak basması geceyi bölerek zihnin toparlanma payını da keser.
        </p>
        <p>
          Beyin sisi çoğu zaman tek bir yerden gelmez. Uyku, gerilim, duygusal yük ve hormon dalgalanması birlikte
          işler. Tek sebep aramayın.
        </p>

        <h2 id="olagan-dalgalanma">Olağan dalgalanma gibi okunabilecek belirtiler</h2>
        <p>
          Yoğun bir haftada listenin bir kalemini atlamak, perimenopozun daha görünür kıldığı bir kayma olabilir.
          Süre, şiddet ve gününüzü ne kadar bozduğu yine de önemlidir.
        </p>
        <p>
          Ara sıra kelime aramak, alışveriş listesine bakmadan bir şeyi atlamak, aynı anda birkaç işi yürütürken daha
          hızlı yorulmak, kalabalık ya da gürültülü ortamlarda dikkat toplamakta zorlanmak, sabahları biraz daha geç
          açılmak gibi örnekler sık görülür <Evidence from={3} to={4} />. Uyku ve stres de eşlik ediyorsa bu tablo
          tek başına ağır bir hastalık resmi çizmez.
        </p>
        <p>
          Olağan dalgalanma da yorar. Doğru isim, korku ile küçümseme arasında durmayı kolaylaştırır.
        </p>

        <h2 id="ne-zaman-degerlendirme">Ne zaman daha dikkatli değerlendirme gerekir?</h2>
        <p>
          Bazı değişimler “yoğun bir dönem” cümlesine sığmaz. O noktada daha dikkatli bir değerlendirme istemek
          kendinize iyi bakmaktır.
        </p>
        <p>
          Günlük işlevi belirgin biçimde bozan unutkanlık, gittikçe artan yön bulma güçlüğü, konuşurken cümleyi
          toparlamada olağanın çok üstünde zorlanma, kişilikte dikkat çeken değişim, derin çöküntü hali, uzun süren
          uyku bozulması ya da başka nörolojik belirtilerin eşlik etmesi durumunda değerlendirmeyi ertelemeyin
          <Evidence level={5} />. Tek taraflı güçsüzlük, ani yönelim bozukluğu, şiddetli baş ağrısı veya hızla
          ilerleyen unutkanlık da bekletilmemelidir.
        </p>
        <p>
          Anemi, tiroid düzensizlikleri, B12 eksikliği, depresif dönemler ve bazı ilaç etkileri de benzer bir sis
          yaratabilir. Her bulanıklığı hormon geçişine bağlamak zorunda değilsiniz; soruyu biraz daha geniş tutmak
          bazen en doğru yoldur.
        </p>

        <h2 id="kucuk-duzenler">Gündelik hayatta zihni rahatlatan küçük düzenler</h2>
        <p>
          Bu dönemde zihin çoğu zaman gün içindeki küçük sürtünmelerin azalmasını ister.
        </p>
        <p>
          Sade adımlar daha kolay sürer. Sabit uyku saati, aynı yerde duran bir not
          defteri, gün içinde tek bir işe dönmek, bildirim gürültüsünü azaltmak ve kısa hareket molaları düşünme
          yükünü hafifletebilir <Evidence level={3} />. Protein içeren dengeli kahvaltı, gün ışığıyla erken temas ve
          akşam ekran geçişlerini biraz yumuşatmak da dolaylı olarak odak hissini destekleyebilir.
        </p>
        <p>
          Aynı anda üç iş, üç sekme, bir de kaynayan su: zihin bu dönemde böyle bir sahneyi taşımakta zorlanabilir.
        </p>
        <ul>
          <li>Yapılacakları zihinde tutmak yerine tek bir not sistemine indirmek</li>
          <li>Günün en dikkat isteyen işini sabaha almak</li>
          <li>Aynı anda üç şey yapmak yerine işi küçük bloklara ayırmak</li>
          <li>Gece uykusunu bölen etkenleri ayrı bir problem olarak ele almak</li>
          <li>Kendinize “neden böyle oldum” yerine “bugün yükü nasıl azaltırım” diye sormak</li>
        </ul>
        <p>
          Bu adımlar bir gecede her şeyi değiştirmez. Mutfak tezgâhındaki tek bir defter, içeride tutulan on işten
          daha az yer kaplar. Yardım istemek de bir düzen olabilir; sizin gününüz başka türlü kurulabilir.
        </p>

        <h2 id="kisa-hatirlatma">Kısa hatırlatma: Bu dönemdeki yük görünmez olabilir</h2>
        <p>
          Dışarıdan her şey aynı dururken içeride düşüncenin hızı bir süreliğine değişmiş gibi gelebilir. Görünmeyen
          bir yük, daha çok yorar.
        </p>
        <p>
          İçinizde “aklım mı gidiyor” diye bir mahcubiyet belirebilir. Bu çok anlaşılır. Son aylarda daha dağınık,
          daha çabuk yorulan ya da daha kolay bunalan biri gibi hissediyorsanız, bu sizi eksik yapmaz. Yükünüzü
          yeniden düzenlemeniz gerektiğini hatırlatabilir.
        </p>
      </ArticleProsePanel>

      <ArticleFAQ
        id="sik-sorulanlar"
        title="Bu sis hakkında sorular"
        intro="Kelimeyi kaçırmak, bölünen gece ve sisin her zaman hormondan gelip gelmediği üzerine üç kısa soru."
        items={faqItems}
        class="mt-10"
      />

      <RelatedReadings
        class="mt-14"
        paths={[
          '/zihin-denge/uyku-dinlenme/uyku-bozuklugu-menopoz/',
          '/zihin-denge/duygusal-denge/stres-yonetimi-menopoz/',
          '/hormonal-gecis/perimenopoz/perimenopoz-ilk-isaretler/',
        ]}
      />
      <ArticleEditorNote>
        <p>Perimenopozda tarif edilen bilişsel bulanıklık çoğu zaman yapısal bir bellek kaybı olarak değil, dikkat, uyku ve stres yükünün kesişiminde belirginleşen bir işlev dalgalanması olarak görünür.</p>
        <p>Östrojen dalgalanması, gece uyanmaları, vazomotor belirtiler ve duygu durum yükü birlikte çalıştığında kelime bulmada gecikme, odakta kırılma ve zihinsel yorgunluk hissi daha görünür hale gelebilir.</p>
        <p>Bununla birlikte belirgin yön bulma güçlüğü, hızla artan unutkanlık, günlük işlevde bozulma, uzun süren çöküntü hali ya da eşlik eden nörolojik belirtiler varsa tablo yalnızca hormonal geçiş başlığı altında değerlendirilmemelidir.</p>
        <p>Klinik yaklaşım çoğu zaman uyku düzeni, stres yükü, beslenme, tiroid-B12-demir ekseni ve gerekirse nörolojik veya psikiyatrik değerlendirme dahil daha geniş bir çerçeveyle düşünmeyi gerektirir.</p>
        <p class="text-sm italic text-primary">— Doç. Dr. Senai Aksoy, Estranova Bilimsel Editörü</p>
      </ArticleEditorNote>

      <ArticleDisclaimer class="mt-10">
        <p>Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavinin yerini almaz. Sağlık kararlarınız için kendi hekiminizle birlikte değerlendirme yapınız.</p>
      </ArticleDisclaimer>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
