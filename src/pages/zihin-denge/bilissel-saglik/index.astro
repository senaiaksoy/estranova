---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuSection from '../../../components/site/SubmenuSection.astro';
import ChapterMasthead from '../../../components/site/ChapterMasthead.astro';
import EditorialEpigraph from '../../../components/site/EditorialEpigraph.astro';
import MarginaliaRail from '../../../components/site/MarginaliaRail.astro';
import MarginaliaItem from '../../../components/site/MarginaliaItem.astro';
import Asterism from '../../../components/site/Asterism.astro';
import ChapterCompass from '../../../components/site/ChapterCompass.astro';
import EditorPickCard from '../../../components/site/EditorPickCard.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { chapterMap, getNextChapter } from '../../../data/chapter-map';
import { subHubEpigraphs } from '../../../data/sub-hub-epigraphs';

const path = '/zihin-denge/bilissel-saglik';
const hero = submenuHeroByRoute[path]!;
const chapter = chapterMap[path]!;
const epigraph = subHubEpigraphs[path];
const next = getNextChapter(path);

const editorPick = {
  href: '/zihin-denge/bilissel-saglik/bellek-odaklanma-menopoz',
  title: 'Bellek ve Odaklanma — Kognitif Değişimler',
  lede: 'Beyin sisi tek başına anlamlı değil; uyku, stres ve hormonal dalgalanma birlikte düşünüldüğünde resim netleşir.',
  writerSlug: 'rima-erdemir',
  readingMinutes: 9,
  image: submenuHeroByRoute['/zihin-denge/bilissel-saglik/bellek-odaklanma-menopoz']!,
};

const neighbors = [
  { href: '/zihin-denge/uyku-dinlenme', title: 'Uyku & Dinlenme', excerpt: 'Uyku kalitesi bilişsel performansla doğrudan bağlantılıdır.' },
  { href: '/zihin-denge/duygusal-denge', title: 'Duygusal Denge', excerpt: 'Ruh halinde dalgalanma ve stres yönetimi; hormonların beyin kimyasıyla ilişkisi.' },
];
---

<SiteLayout
  title="Bilişsel Sağlık — Zihin & Denge - Estranova"
  description="Menopozda beyin sisi, unutkanlık ve dikkat dağılması; ne kadarı normal seyir, ne kadarı izlenmeyi gerektirir? Bilişsel değişimleri okuma çerçevesi."
>
  <SiteNavbar currentPath="/zihin-denge" />

  <main id="main-content" class="text-[#2D2D2D]">
    <ChapterMasthead number={chapter.number} parent={chapter.parent} chapter={chapter.chapter} />

    <SubmenuHero
      eyebrow="Sınıflama yorgunluğu"
      title="Bilişsel Sağlık"
      lede="Beyin sisi, kelimeyi unutma, dikkat dağılması — menopozda 'aklımı kaçırıyorum' hissi yaygın ama çoğu zaman geçicidir. Burada ne kadarı normal, ne kadarı dikkat ister yanıtları."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />

    <section class="border-b border-[#6B2D3E]/10 bg-[#FDF8F0] px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <nav class="mb-10 text-sm text-[#2D2D2D]/60" aria-label="İçerik yolu">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/zihin-denge" class="font-medium text-[#6B2D3E] hover:underline">Zihin & Denge</a></li>
            <li aria-hidden="true">/</li>
            <li class="font-medium text-[#2D2D2D]">Bilişsel Sağlık</li>
          </ol>
        </nav>

        <div class="grid gap-12 lg:grid-cols-12 lg:items-start lg:gap-14">
          <div class="lg:col-span-8">
            <p class="editorial-dropcap mb-7 text-lg leading-relaxed text-[#2D2D2D]/85 md:text-xl">
              Östrojen reseptörleri hipokampusta — yani bellek merkezinde — yoğundur. Hormon
              dalgalanmaları geçici <strong class="font-semibold text-[#2D2D2D]">"beyin sisi"</strong> hissine yol açabilir. Bu çoğu kadında
              2-3 yıl içinde dengelenir; menopoz sonrası beyin yeni bir kimyasal denge kurar
              ve bilişsel kapasite çoğu zaman geri toparlanır.
            </p>
            <p class="text-base leading-relaxed text-[#2D2D2D]/72 md:text-lg">
              Uyku, stres, beslenme ve fiziksel aktivite bilişsel performansı menopozdan
              bağımsız doğrudan etkiler. "Aklımı kaybediyorum" hissini izlemek anlamlı; ama
              erken paniğe yer yok.
            </p>
          </div>

          <div class="lg:col-span-4 lg:pt-1">
            <MarginaliaRail>
              <MarginaliaItem label="Yayın" value="Mart 2026 · Düzenli güncellenir" />
              <MarginaliaItem label="Süre" emphasized="Beyin sisi tipik olarak 1-3 yıl içinde belirgin azalır." />
              <MarginaliaItem label="Sık sorulanlar">
                <ul class="mt-2 space-y-3 text-sm leading-snug text-[#2D2D2D]/78">
                  <li><span class="block font-semibold text-[#2D2D2D]">Bu demans habercisi mi?</span>Genellikle hayır; menopozun bilişsel etkileri geçicidir.</li>
                  <li><span class="block font-semibold text-[#2D2D2D]">Beyin sisi ne kadar sürer?</span>Çoğu kadında 1-3 yıl içinde belirgin azalır.</li>
                  <li><span class="block font-semibold text-[#2D2D2D]">Ne zaman hekime danışmalı?</span>Günlük yaşamı bozan, kötüleşen değişimlerde gecikmeyin.</li>
                </ul>
              </MarginaliaItem>
            </MarginaliaRail>
          </div>
        </div>
      </div>
    </section>

    {epigraph && <EditorialEpigraph quote={epigraph} />}

    <SubmenuSection variant="white" borderedTop={false}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">Editör'ün Seçimi</p>
        <h2 class="font-serif text-3xl leading-tight md:text-4xl">Bu evreden bir okuma</h2>
      </header>

      <EditorPickCard
        href={editorPick.href}
        title={editorPick.title}
        lede={editorPick.lede}
        writerSlug={editorPick.writerSlug}
        readingMinutes={editorPick.readingMinutes}
        imageSrc={editorPick.image.src}
        imageAlt={editorPick.image.alt}
      />
    </SubmenuSection>

    <Asterism />

    <SubmenuSection variant="cream" borderedTop={false}>
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-[#6B2D3E]">Aynı kategoride</p>
      <h2 class="mb-8 font-serif text-2xl md:text-3xl">İlgili alt başlıklar</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {neighbors.map((n) => (
          <a href={n.href} class="group rounded-[26px] border border-[#6B2D3E]/12 bg-white p-7 transition hover:border-[#6B2D3E]/28 hover:shadow-sm">
            <h3 class="mb-2 font-serif text-xl text-[#2D2D2D] group-hover:text-[#6B2D3E]">{n.title}</h3>
            <p class="mb-4 text-sm leading-relaxed text-[#2D2D2D]/72">{n.excerpt}</p>
            <span class="text-sm font-semibold text-[#6B2D3E] group-hover:underline">Sayfaya git →</span>
          </a>
        ))}
      </div>
    </SubmenuSection>

    <ChapterCompass nextHref={next?.href} nextNumber={next?.number} nextChapter={next?.chapter} nextParent={next?.parent} />
  </main>

  <SiteFooter />
</SiteLayout>
