import { resolveSiteUrl } from '../../../utils/seo';

const hero = submenuHeroByRoute['/zihin-denge/duygusal-denge/ruh-hali-degisimleri-menopoz']!;

const tocEntries = [
  { id: 'aslinda-bildigimiz-an', label: 'Aslında Hepimizin Bildiği Bir An…' },
  { id: 'hormon-yasam-ben', label: 'Hormon mu, Yaşam mı, Ben mi?' },
  { id: 'dalga-mi-baska-mi', label: 'Bu Bir Dalga mı, Yoksa Bir Şey Daha mı?' },
  { id: 'risk-haritasi', label: 'Niye Birimiz Daha Çok Zorlanıyor?' },
  { id: 'gunluk-temeller', label: 'Günlük Temeller — Hangileri Gerçekten Konuşur?' },
  { id: 'tibbi-secenekler', label: 'Tıbbi Seçenekler — HRT, SSRI, Terapi: Hangisi Nereye?' },
  { id: 'travma-omuz', label: 'Travma ve Geçmişin Omuzları' },
  { id: 'uzman-kapisi', label: 'Ne Zaman Bir Uzmana Bakmalı?' },
