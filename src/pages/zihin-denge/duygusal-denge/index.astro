---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuSection from '../../../components/site/SubmenuSection.astro';
import ChapterMasthead from '../../../components/site/ChapterMasthead.astro';
import EditorialEpigraph from '../../../components/site/EditorialEpigraph.astro';
import MarginaliaRail from '../../../components/site/MarginaliaRail.astro';
import MarginaliaItem from '../../../components/site/MarginaliaItem.astro';
import Asterism from '../../../components/site/Asterism.astro';
import ChapterCompass from '../../../components/site/ChapterCompass.astro';
import EditorPickCard from '../../../components/site/EditorPickCard.astro';
import MagazineTOC from '../../../components/site/MagazineTOC.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { chapterMap, getNextChapter } from '../../../data/chapter-map';
import { subHubEpigraphs } from '../../../data/sub-hub-epigraphs';

const path = '/zihin-denge/duygusal-denge';
const hero = submenuHeroByRoute[path]!;
const chapter = chapterMap[path]!;
const epigraph = subHubEpigraphs[path];
const next = getNextChapter(path);

const editorPick: any = null;

const tocArticles = [
  {
    href: '/zihin-denge/duygusal-denge/stres-yonetimi-menopoz',
    title: 'Stres Yönetimi',
    excerpt:
      'Menopozda stres tepkisi ve hormonal değişim ilişkisi; günlük yaşamda uygulanabilir kanıt-temelli rahatlama yöntemleri.',
    writerSlug: 'berna-aksoy',
    readingMinutes: 5,
  },
];

const neighbors = [
  { href: '/zihin-denge/uyku-dinlenme', title: 'Uyku & Dinlenme', excerpt: 'Gece terlemesi ve uyku bölünmesi; uykunun menopozda neden zorlaştığı.' },
  { href: '/zihin-denge/bilissel-saglik', title: 'Bilişsel Sağlık', excerpt: 'Beyin sisi, bellek ve odaklanma; bilişsel değişimleri okuma çerçevesi.' },
];
---

<SiteLayout
  title="Duygusal Denge — Zihin & Denge - Estranova"
  description="Menopozda ruh halinde dalgalanma, kaygı ve stres tepkisi; hormonların beyin kimyasıyla konuştuğu noktada mekanizma ve günlük yaşam stratejileri."
>
  <SiteNavbar currentPath="/zihin-denge" />

  <main id="main-content" class="text-ink">
    <ChapterMasthead number={chapter.number} parent={chapter.parent} chapter={chapter.chapter} />

    <SubmenuHero
      eyebrow="İçerideki manzara"
      title="Duygusal Denge"
      lede="Ruh halinde dalgalanma, ani sinirlenme, kaygının artması — menopoz hormonları beyin kimyasıyla doğrudan konuşur. Bu sayfa hem mekanizmayı hem günlük stratejileri bir arada ele alır."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />

    <section class="border-b border-burgundy/10 bg-cream-soft px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <nav class="mb-10 text-sm text-ink/60" aria-label="İçerik yolu">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/zihin-denge" class="font-medium text-burgundy hover:underline">Zihin & Denge</a></li>
            <li aria-hidden="true">/</li>
            <li class="font-medium text-ink">Duygusal Denge</li>
          </ol>
        </nav>

        <div class="grid gap-12 lg:grid-cols-12 lg:items-start lg:gap-14">
          <div class="lg:col-span-8">
            <p class="editorial-dropcap mb-7 text-lg leading-relaxed text-ink/85 md:text-xl">
              Östrojen serotonin, dopamin ve GABA gibi nörotransmitter sistemlerini doğrudan
              etkiler. Bu yüzden hormonal dalgalanmalar; <strong class="font-semibold text-ink">duygu durumu, kaygı eşiği ve stres tepkisini</strong> de değiştirir.
              Bu değişimler "abartıyor değilim" demenizi gerektirmez; bilim onları zaten kabul ediyor.
            </p>
            <p class="text-base leading-relaxed text-ink/72 md:text-lg">
              Uyku, hareket, sosyal destek ve gerektiğinde profesyonel destek; hepsi aynı
              planın parçaları olabilir. Tek bir doğru yol yoktur — kişiye uyan kombinasyon
              çoğu zaman birden fazla kanaldan gelir.
            </p>
          </div>

          <div class="lg:col-span-4 lg:pt-1">
            <MarginaliaRail>
              <MarginaliaItem label="Yayın" value="Mart 2026 · Düzenli güncellenir" />
              <MarginaliaItem label="Mekanizma" emphasized="Östrojen serotonin sentezini ve reseptör duyarlılığını doğrudan modüle eder." />
              <MarginaliaItem label="Sık sorulanlar">
                <ul class="mt-2 space-y-3 text-sm leading-snug text-ink/78">
                  <li><span class="block font-semibold text-ink">Bu depresyon mu, perimenopoz mu?</span>İkisinin örtüşebildiği bir alan; hekiminizle değerlendirilmelidir.</li>
                  <li><span class="block font-semibold text-ink">Hormon tedavisi ruh halini düzeltir mi?</span>Bazı kişilerde yarar görülür; tek başına psikiyatrik tedavinin yerine geçmez.</li>
                  <li><span class="block font-semibold text-ink">Doğal yöntemler işe yarar mı?</span>Hareket, uyku ve sosyal destek kanıt-temelli temel adımlardır.</li>
                </ul>
              </MarginaliaItem>
            </MarginaliaRail>
          </div>
        </div>
      </div>
    </section>

    {epigraph && <EditorialEpigraph quote={epigraph} />}

    <SubmenuSection variant="white" borderedTop={false}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Editör'ün Seçimi</p>
        <h2 class="font-serif text-3xl leading-tight md:text-4xl">Bu evreden bir okuma</h2>
      </header>

      {editorPick && (<EditorPickCard
        href={editorPick.href}
        title={editorPick.title}
        lede={editorPick.lede}
        writerSlug={editorPick.writerSlug}
        readingMinutes={editorPick.readingMinutes}
        imageSrc={editorPick.image.src}
        imageAlt={editorPick.image.alt}
      />)}
    </SubmenuSection>

    <SubmenuSection variant="cream" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Bu Evrede Okumalar</p>
        <h2 class="font-serif text-3xl leading-tight md:text-4xl">Sayının diğer başlıkları</h2>
      </header>

      <MagazineTOC items={tocArticles} />
    </SubmenuSection>

    <Asterism />

    <SubmenuSection variant="cream" borderedTop={false}>
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Aynı kategoride</p>
      <h2 class="mb-8 font-serif text-2xl md:text-3xl">İlgili alt başlıklar</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {neighbors.map((n) => (
          <a href={n.href} class="group rounded-[26px] border border-burgundy/12 bg-white p-7 transition hover:border-burgundy/28 hover:shadow-sm">
            <h3 class="mb-2 font-serif text-xl text-ink group-hover:text-burgundy">{n.title}</h3>
            <p class="mb-4 text-sm leading-relaxed text-ink/72">{n.excerpt}</p>
            <span class="text-sm font-semibold text-burgundy group-hover:underline">Sayfaya git →</span>
          </a>
        ))}
      </div>
    </SubmenuSection>

    <ChapterCompass nextHref={next?.href} nextNumber={next?.number} nextChapter={next?.chapter} nextParent={next?.parent} />
  </main>

  <SiteFooter />
</SiteLayout>
