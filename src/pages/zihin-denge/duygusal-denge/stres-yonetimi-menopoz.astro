---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { resolveSiteUrl } from '../../../utils/seo';

const hero = submenuHeroByRoute['/zihin-denge/duygusal-denge/stres-yonetimi-menopoz']!;

const tocEntries = [
  { id: 'neden-farkli', label: 'Neden Farklı' },
  { id: 'fizyolojik-etki', label: 'Fizyolojik Etkiler' },
  { id: 'belirtileri-tanima', label: 'Belirtileri Tanıma' },
  { id: 'meditasyon', label: 'Meditasyon' },
  { id: 'yoga', label: 'Yoga' },
  { id: 'cbt', label: 'CBT İlkeleri' },
  { id: 'gunluk-yonetim', label: 'Günlük Yönetim' },
  { id: 'profesyonel-yardim', label: 'Profesyonel Yardım' },
  { id: 'ilk-adimlar', label: 'İlk Adımlar' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Stres Yönetimi — Menopozda Stres ve Adaptasyon';
const articleDescription = 'Menopozda stres yönetimi teknikleri ve hormon değişikliklerinin stres tepkisine etkisi hakkında rehberlik.';
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'berna-aksoy',
  publishedDate: '20 Mart 2026',
  pathname: '/zihin-denge/duygusal-denge/stres-yonetimi-menopoz',
  articleSection: 'Zihin & Denge',
  sectionPath: '/zihin-denge',
  keywords: ['menopoz', 'perimenopoz', 'stres', 'anksiyete', 'kortizol', 'rahatlama'],
  siteUrl,
});
---

<SiteLayout
  title={`${articleTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/zihin-denge" />

  <main id="main-content" class="text-[#2D2D2D]">
    <SubmenuHero
      eyebrow="Zihin & Denge · Stres"
      title="Stres Yönetimi — Menopozda Stres ve Adaptasyon"
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />
    <SubmenuArticleBody>
        <ArticleTOC slot="toc" entries={tocEntries} />
        <ArticleAuthorBlock authorSlug="berna-aksoy" publishedDate="20 Mart 2026" readingMinutes={4} />

        <section class="rounded-[28px] border border-[#C9A96E]/35 bg-gradient-to-br from-white to-[#FDF8F0]/90 p-7 shadow-sm ring-1 ring-[#C9A96E]/22 md:p-8">
          <h2 class="mb-4 font-serif text-3xl">Kısa Özet</h2>
          <p class="leading-relaxed text-[#2D2D2D]/80">
            Menopoz, yaşamın stresli bir aşamasıdır: kariyer, aile, sağlık endişeleri birleşir. Hormon değişiklikleri stres tepkisini de değiştirir. Kanıt-tabanlı stres yönetimi teknikleri bu dönemde dengeyi yeniden kurmaya yardımcı olur.
          </p>
        </section>

        <ArticleProsePanel>
          <h2 id="neden-farkli">Menopoz Döneminde Stres Neden Farklı?</h2>
          <p>
            Menopoz, yalnızca hormonal değişim değil; aynı zamanda yaşam aşamasının bir kırılma noktasıdır.
            Kariyer zirvesinde kalmak veya devam etme soruları, genç yetişkin çocuklara bağlantı, yaşlanan ebeveynlerin bakımı gibi sorunlar bu döneme denk gelebilir.
            Bu bağlamda stres çok yaygındır <Evidence level={5} />.
          </p>
          <p>
            Ancak hormonal değişiklik, stres tepkisini de değiştirir. Kortisol (stres hormonu) ve östrojen arasında karşılıklı etkileşim vardır <Evidence level={5} />.
            Hormon dalgalanması, uyku bozukluğu ve stres bir döngü oluşturur; birisi diğerini kötüleştirir <Evidence level={5} />.
            Ruh hali değişimleri stres toleransını düşürür; her sorun daha ağır hissedilir <Evidence level={5} />.
            Vazomotor belirtiler (sıcak basması) dikkat dağılması ve huzursuzluk sebebi olabilir <Evidence level={5} />.
          </p>

          <h2 id="fizyolojik-etki">Stresin Fizyolojik Etkileri</h2>
          <p>
            Akut stres (kısa süreli, belirli bir sebebi olan) vücudu mobilize eder; uygun dozu "iyi stres"tir <Evidence level={5} />.
            Kronik stres (uzun süreli, kesintisiz) ise zararlıdır. Stres yanıtı sürekli aktif kaldığında kortisol ve adrenalin yükselmesi,
            artık gerekli olmayan durumda sürekli yüksek kalırsa bağışıklık sistemi baskılanır <Evidence level={5} />.
          </p>
          <p>
            İltihabi yanıtın artması kronik hastalık riskini artırır <Evidence level={5} />.
            Kalp atış hızı, kan basıncı, metabolik sorunlar (kan şekeri yükselmesi) görülür <Evidence level={5} />.
            Kas gerginliği, uyku bozukluğu, sindirim sorunları (IBS benzeri semptomlar) somatik belirtiler olarak ortaya çıkar.
          </p>

          <h2 id="belirtileri-tanima">Stres Belirtileri Tanıma</h2>
          <p>
            Bedensel belirtiler arasında baş ağrısı, boyun ve omuz gerginliği, mide sorunları, hızlı nefes almak yer alır <Evidence level={5} />.
            Duygusal düzeyde kaygı, sinirlilik, ani öfke patlamaları, tüketilmiş hissetme yaygındır <Evidence level={5} />.
            Bilişsel etkiler odaklanma güçlüğü, bellek kayması ve karar vermede zorlanma şeklinde hissedilebilir <Evidence level={5} />.
            Davranışsal değişiklikler (uyku artışı veya azalması, yemek alışkanlığı değişimi, sosyal çekilme) gözlemlenir <Evidence level={5} />.
          </p>
          <p>
            Menopoz döneminde bu belirtileri çoğu zaman "yaş" diye adlandırırız; ancak çoğu zaman stres ve hormon etkileşimidir.
            Belirtileri tanımlamak ve ismini koymak, kontrolü geri almaya yardımcı olur.
          </p>

          <h2 id="meditasyon">Meditasyon ve Farkındalık</h2>
          <p>
            Meditasyon, bilinçli bir şekilde anın farkında olmayı ve yargısız gözlemlemedir <Evidence level={5} />.
            Kısa oturumlar (5-10 dakika) ile başlanabilir; düzenli yapılınca etkisi belirginleşir <Evidence level={5} />.
            Çeşitli uygulamalar vardır: oturularak meditasyon, kılavuzlu ses, tarama meditasyonu (vücut taraması).
          </p>
          <p>
            Fizyolojik etkileri kanıtlanmıştır <Evidence level={5} />: kortisol azalır, kalp atış hızı normalleşir, kan basıncı düşer, sinir sistemi sakinleşir.
            HPA ekseni (stres ekseninin beyin-glantlar kısmı) iyileşir. Başta yapay veya zor gelebilirse endişelenmeyin;
            beyin bu yeni aktiviteye uyum sağlar.
          </p>

          <h2 id="yoga">Yoga ve Somato-Motor Uygulamalar</h2>
          <p>
            Yoga, hareket, solunum ve meditasyonun birleşimidir. Vinyasa (dinamik, akan hareket), Hatha (durağan duruşlar), Yin (pasif, uzun tutma) gibi çeşitleri vardır <Evidence level={4} />.
            Menopoza uygun modifikasyonlar (kuvvetli ters döndürmelerden kaçınma, kemik sağlığı odağı) önerilir <Evidence level={4} />.
          </p>
          <p>
            Faydaları esneklik, denge, kas kuvveti ve stres azaltmayı içerir <Evidence level={5} />.
            Pranayama (solunum teknikleri), özellikle yavaş ve derin nefes, otonomik sinir sistemini sakinleştirir <Evidence level={5} />.
            Haftada 2-3 seans yeterli; evde yapılabilecek basit diziler YouTube'da bulunur.
          </p>

          <h2 id="cbt">Bilişsel Davranış Terapisi (CBT) İlkeleri</h2>
          <p>
            Bilişsel davranış terapisi, düşünceler-duygular-davranışlar arasındaki ilişkiye odaklanır <Evidence level={5} />.
            Olumsuz otomatik düşünceler ("Her şey başarısız olacak") beden tepkisini tetikler.
            Bu döngüyü tanımak ve düşünceyi yeniden çerçevelemekle (örneğin, “Bu zorluk geçici; ben buna daha önce de dayanmıştım”) değişim sağlanır <Evidence level={5} />.
          </p>
          <p>
            Kabul ve Bağlılık Terapisi (ACT) ilkeleri, biraz farklıdır: değiştiremediğimiz düşünceler ve duygularla yaşamayı ve
            değerlerimize bağlı kalarak hareket etmeyi öğretir <Evidence level={5} />. Bu her ikisi de etkilidir; kişisel tercih ve terapeut desteğiyle uygun olansa başlanabilir.
          </p>

          <h2 id="gunluk-yonetim">Günlük Yaşamda Stres Yönetimi</h2>
          <p>
            Zaman yönetimi ve önceliklendirme, "hayır" söylemeyi ve sınırlar koymayı içerir <Evidence level={5} />.
            Tüm istekleri yerine getiremeyeceğinizi kabul etmek önemli bir adımdır. Sosyal destek ağını kuvvetlendirmek <Evidence level={5} />;
            yakın dostlarla düzenli temas, grup aktiviteleri ve aile zamanını sadeleştirme bu alanda destekleyici olabilir.
          </p>
          <p>
            Hobi ve keyif faaliyetleri (okuma, sanat, bahçecilik, müzik) stres antidotu görevi görür <Evidence level={5} />.
            Uyku ve hareket temel altyapıdır <Evidence level={5} />; bunlar eksik olursa diğer teknikler daha az etkilidir.
            Sabah gün ışığına çıkış, sirkadiyen ritme katkı sağlar ve ruh halini iyileştirebilir.
          </p>

          <h2 id="profesyonel-yardim">Profesyonel Yardım Ne Zaman?</h2>
          <p>
            Depresyon veya anksiyete tanısı varsa profesyonel destek önerilir <Evidence level={5} />.
            Kendi başınız denediğiniz tekniklere rağmen iyileşme olmazsa danışman veya psikoterapi faydalı olabilir <Evidence level={5} />.
            Terapist veya danışman (psikolog, danışman, psikiyatrist) seçimi kişisel uyuma bağlıdır <Evidence level={5} />.
            Grup desteği ve menopoz toplulukları, kendini yalnız hissetmemenize yardımcı olabilir <Evidence level={4} />.
          </p>

          <h2 id="ilk-adimlar">Başlamak İçin İlk Adımlar</h2>
          <p>
            Bu hafta, meditasyon veya yoga uygulamalarından birini seçin. İnternet üzerinde 5 dakikalık bir seans bulun ve deneyin.
            Sonra, stres belirtilerinizden en rahatsız edici olanı belirleyin. Haftada bir kez o belirtiye hedeflenen bir teknik uygulayın.
            Örneğin, egzersiz öncesi anksiyete hissediyorsanız, yoga sırasında derin nefes alınız.
            Kademeli değişiklikler, büyük farklara neden olabilir.
          </p>
        </ArticleProsePanel>

        <RelatedReadings
          class="mt-14"
          paths={[
            '/zihin-denge/duygusal-denge/ruh-hali-degisimleri-menopoz',
            '/zihin-denge/uyku-dinlenme/uyku-bozuklugu-menopoz',
            '/zamansiz-yasam/hareket-saglik-menopoz',
            '/zamansiz-yasam/beslenme-yaslanma',
            '/beden-yakinlik/cinsel-saglik/cinsellikte-agri-menopoz',
          ]}
        />

        <section class="mt-14 rounded-[28px] border border-[#6B2D3E]/15 border-l-[6px] border-l-[#C9A96E] bg-gradient-to-r from-[#F5EDE0] to-[#FDF8F0] p-7 shadow-sm ring-1 ring-[#6B2D3E]/10 md:p-8">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.22em] text-[#6B2D3E]">Bilimsel Editör Notu</p>
          <p class="mb-4 text-lg font-semibold text-[#2D2D2D]">Kanıt Düzeyi: A — Güçlü Kanıt <Evidence level={5} /></p>
          <p class="leading-relaxed text-[#2D2D2D]/80">
            Stres yönetimi menopozda sadece "iyi hissetmek" için değil, fiziksel ve duygusal sağlığı korumak için medikasyonlar kadar önemlidir. Uygulanabilir, kanıt-tabanlı teknikler bu dönemde dirençliliği inşa etmeye yardımcı olur.
          </p>
        </section>

        <section class="mt-10 rounded-[24px] border border-dashed border-[#6B2D3E]/25 bg-white/95 p-6 ring-1 ring-[#6B2D3E]/10">
          <p class="text-sm leading-relaxed text-[#2D2D2D]/75">
            Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavinin yerini almaz. Sağlık kararlarınız için
            kendi hekiminizle birlikte değerlendirme yapınız.
          </p>
        </section>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>
