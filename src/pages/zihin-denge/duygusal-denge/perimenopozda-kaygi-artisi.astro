---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuArticleBody from '../../../components/site/SubmenuArticleBody.astro';
import ArticleTOC from '../../../components/site/ArticleTOC.astro';
import ArticleAuthorBlock from '../../../components/site/ArticleAuthorBlock.astro';
import ArticleProsePanel from '../../../components/site/ArticleProsePanel.astro';
import ArticleDisclaimer from '../../../components/site/ArticleDisclaimer.astro';
import ArticleEditorNote from '../../../components/site/ArticleEditorNote.astro';
import ArticleSummary from '../../../components/site/ArticleSummary.astro';
import Evidence from '../../../components/site/Evidence.astro';
import RelatedReadings from '../../../components/site/RelatedReadings.astro';
import ArticleFAQ from '../../../components/site/ArticleFAQ.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { buildArticleSchemas } from '../../../utils/article-schema';
import { articleFaqs } from '../../../data/article-faqs';
import { resolveSiteUrl } from '../../../utils/seo';

const pathname = '/zihin-denge/duygusal-denge/perimenopozda-kaygi-artisi/';
const hero = submenuHeroByRoute[pathname] ?? submenuHeroByRoute['/zihin-denge/duygusal-denge/']!;
const bylineImage = {
  src: '/images/library/editorial/perimenopozda-kaygi-artisi-byline.webp',
  alt: 'Pencere önünde çay ve açık bir defter eşliğinde sohbet eden iki kadın',
};
const articleTitle = 'Perimenopozda Kaygı Artışı: Her Şey Aynıyken Neden İçiniz Daralıyor Gibi Hissedebilirsiniz?';
const seoTitle = 'Perimenopozda Kaygı Artışı';
const articleDescription =
  'Perimenopozda kaygının hormonlar, uyku ve stresle ilişkisi; belirtileri izlemek, destek almak ve acil durumları ayırt etmek için sade bir rehber.';
const publishedDate = '6 Mayıs 2026';
const modifiedDate = '19 Ekim 2026';
const readingMinutes = 8;

const tocEntries = [
  { id: 'neden-simdi', label: 'Bu kaygı hissi neden tam da şimdi belirginleşebilir?' },
  { id: 'kaygi-stres', label: 'Kaygı ve stres arasındaki fark' },
  { id: 'bedensel-alarm', label: 'Kaygının bedensel belirtileri' },
  { id: 'uyku-sicak-basma', label: 'Bölünen uyku ve sıcak basmaları' },
  { id: 'olagan-dalga', label: 'Belirtilerin süresi ve günlük hayata etkisi' },
  { id: 'ne-zaman-destek', label: 'Destek alma zamanı' },
  { id: 'gunluk-duzenler', label: 'Günü kolaylaştıran küçük düzenler' },
  { id: 'kisa-hatirlatma', label: 'Görüşmeye hazırlanırken' },
  { id: 'sik-sorulanlar', label: 'Sıkça Sorulanlar' },
];

const siteUrl = resolveSiteUrl(Astro.site);
const faqItems = articleFaqs[pathname] ?? [];
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'estranova-editorial',
  articleType: 'editorial-guide',
  publishedDate,
  modifiedDate,
  pathname,
  articleSection: 'Zihin & Denge',
  sectionPath: '/zihin-denge/',
  image: new URL(bylineImage.src, siteUrl).href,
  keywords: [
    'perimenopoz',
    'kaygı',
    'anksiyete',
    'iç sıkışması',
    'duygusal denge',
    'uyku',
    'sıcak basması',
    'hormon dalgalanması',
    '40 sonrası sağlık',
  ],
  faqItems,
  siteUrl,
});
---

<SiteLayout
  title={`${seoTitle} - Estranova`}
  description={articleDescription}
  ogType="article"
  image="/images/library/editorial/perimenopozda-kaygi-artisi.webp"
  jsonLd={articleSchemas}
>
  <SiteNavbar currentPath="/zihin-denge/" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Zihin & Denge · Duygusal Denge"
      title="Perimenopozda Kaygı Artışı"
      imageSrc={hero.src}
      imageAlt={hero.alt}
      compact
    />

    <SubmenuArticleBody>
      <ArticleTOC slot="toc" entries={tocEntries} />
      <ArticleAuthorBlock
        authorSlug="estranova-editorial"
        articleType="editorial-guide"
        publishedDate={publishedDate}
        lastUpdated={modifiedDate}
        readingMinutes={readingMinutes}
        imageSrc={bylineImage.src}
        imageAlt={bylineImage.alt}
        imagePosition="center"
      />

      <ArticleSummary title="Kısa Özet">
        <p>
          Kaygı, perimenopozda bazı kadınlarda belirginleşebilir; hormon değişimleri, uyku ve yaşam yükü
          birlikte rol oynayabilir. Günlük hayatınızı etkileyen kaygı için destek alabilirsiniz.
          Yeni göğüs belirtileri veya kendinize zarar verme düşüncesi ise aşağıdaki güvenlik uyarılarıyla
          birlikte, ayrıca değerlendirilmelidir.
        </p>
      </ArticleSummary>

      <ArticleProsePanel>
        <h2 id="neden-simdi">Bu kaygı hissi neden tam da şimdi belirginleşebilir?</h2>
        <p>
          Aynı sabah hazırlığı, aynı iş listesi… Yine de güne başlarken eskisinden daha gergin
          olduğunuzu fark edebilirsiniz.
        </p>
        <p>
          Perimenopoz, menopoza geçiş dönemidir; östrojen ve progesteron düzeyleri bu sırada dalgalanır.
          Bazı kadınlarda kaygı belirtileri de artabilir <Evidence level={3} />. Bu ilişki, yaşadığınız
          kaygının doğrudan ve yalnızca hormonlardan kaynaklandığını göstermez. Önceki kaygı öykünüz,
          uykunuz ve o sırada taşıdığınız sorumluluklar da önemlidir.
        </p>
        <p>
          Daha çabuk bunaldığınız için kendinizi suçlamayın. Kaygı bir karakter kusuru değildir.
          Ne zamandır böyle hissettiğinizi fark etmek, size neyin yardımcı olacağını konuşmayı kolaylaştırır.
        </p>

        <h2 id="kaygi-stres">Kaygı ve stres arasındaki fark</h2>
        <p>
          Yetişmesi gereken bir iş için gerilmekle, iş bittikten sonra da kötü bir şey olacakmış gibi
          hissetmek birbirinden farklı olabilir. Gündelik hayatta bu iki his sık sık iç içe geçer.
        </p>
        <p>
          Stres genellikle bir talep veya baskıya verilen yanıttır. Kaygı ise olabileceklerle ilgili
          endişe ve tetikte olma halidir; belirgin bir tehdit yokken de sürebilir. Sizde hangisinin
          ağır bastığını anlamak için gün içinde neye takıldığınıza ve bu hissin ne zaman hafiflediğine bakabilirsiniz.
        </p>
        <p>
          Örneğin teslim tarihi geçtiğinde rahatlıyor musunuz, yoksa zihniniz hemen başka bir endişeye mi geçiyor?
          Bu sorunun yanıtı tek başına tanı koymaz; görüşmede anlatabileceğiniz somut bir ayrıntı verir.
        </p>

        <h2 id="bedensel-alarm">Kaygının bedensel belirtileri</h2>
        <p>
          Omuzlarınızı sıktığınızı veya midenizin düğümlendiğini, neye endişelendiğinizi fark etmeden önce
          hissedebilirsiniz. Kaygının fiziksel tarafı da yorucu olabilir.
        </p>
        <p>
          Çarpıntı, kas gerginliği, mide rahatsızlığı, terleme veya nefesin hızlanması kaygıya eşlik edebilir.
          Sıcak basması da terleme ve çarpıntı hissi yaratabildiğinden, yalnızca nasıl hissettirdiğine bakarak
          nedenini ayırt etmek zor olabilir. Yeni başlayan, sıklaşan veya uzayan çarpıntıyı hekiminize anlatın.
        </p>
        <p>
          <strong>Aniden başlayan ve geçmeyen göğüs ağrısı ya da baskıyı kaygı veya sıcak basması diye beklemeyin.</strong>
          Çarpıntıyla birlikte göğüs ağrısı, nefes darlığı, bayılacak gibi olma ya da bayılma varsa acil sağlık
          yardımı alın. Bu belirtilerin kaynağı burada anlatılanlardan farklı olabilir.
        </p>

        <h2 id="uyku-sicak-basma">Bölünen uyku ve sıcak basmaları</h2>
        <p>
          Gece birkaç kez uyandıktan sonra sabahın sıradan işleri bile daha yorucu gelebilir.
          Kaygınızın arttığı günlerde önceki gecenin nasıl geçtiğine de bakın.
        </p>
        <p>
          Uyku kaybının ertesi gün kaygıyı artırabildiği araştırmalarda da görülüyor <Evidence level={3} />.
          Ancak bu çalışmaların hepsi perimenopozdaki kadınlarla yapılmış değil. Gece terlemesi, sıcak basması
          veya endişeli düşünceler uykunuzu bölebilir; kaygı da yeniden uykuya dalmayı zorlaştırabilir.
        </p>
        <p>
          Yatma saatinizi, gece uyanmalarını ve ertesi gün nasıl hissettiğinizi kısa notlarla kaydedebilirsiniz.
          Uyanırken terleme olup olmadığını da ekleyin. Bu kayıt, görüşmede uyku sorununu ayrıca ele almayı kolaylaştırır.
        </p>

        <h2 id="olagan-dalga">Belirtilerin süresi ve günlük hayata etkisi</h2>
        <p>
          Bir sabah huzursuz uyanmakla, haftalardır dışarı çıkmaktan kaçınmak aynı deneyim değildir.
          Sizin gününüzde nelerin değiştiği, belirtinin adından daha açıklayıcı olabilir.
        </p>
        <p>
          Görüşmede ne zamandır kaygılandığınız, bunun ne sıklıkta olduğu ve günün ne kadarını kapladığı sorulabilir.
          İşlerinizi ertelemek, görüşmelerden kaçınmak veya sürekli güvence aramak gibi değişiklikleri de anlatın.
          Adet günleriyle birlikte artıp azalıyorsa bunu not etmek yararlı olabilir.
        </p>
        <p>
          Belirtileriniz için kusursuz bir açıklama bulmanız gerekmiyor. Ne yaşadığınızı kendi sözcüklerinizle
          anlatmanız yeterli; değerlendirmede süre, şiddet ve sağlık öyküsü birlikte ele alınır.
        </p>

        <h2 id="ne-zaman-destek">Destek alma zamanı</h2>
        <p>
          Kaygı yüzünden yapabildikleriniz azalıyorsa bunu bir görüşmede dile getirin.
          Yardım istemek için bütün işlerin aksamasını beklemeniz gerekmez.
        </p>
        <p>
          İşiniz, uykunuz veya ilişkileriniz etkileniyorsa; tekrarlayan panik benzeri ataklar, çöküntü hali,
          umutsuzluk veya yoğun suçluluk varsa aile hekiminizle ya da bir ruh sağlığı uzmanıyla görüşebilirsiniz.
          Kaygıyla baş etmek için alkol veya kendi kararınızla ilaç kullanmaya başladıysanız bunu da söyleyin.
        </p>
        <p>
          Hekiminiz, örneğin tiroid sorunları, kansızlık veya kullandığınız ilaçların etkisini de değerlendirebilir.
          B12 eksikliği gibi başka durumlar öykü ve muayeneye göre araştırılabilir; bu liste herkese aynı testlerin
          yapılması gerektiği anlamına gelmez. Yas ve uzun süren bakım sorumluluğu da görüşmede yer bulmalıdır.
        </p>
        <p>
          Değerlendirme sonrasında psikolojik destek, düşünce ve davranışların kaygıyla ilişkisini ele alan
          bilişsel davranışçı terapi veya gerektiğinde ilaç tedavisi konuşulabilir <Evidence level={4} />.
          Hangi desteğin uygun olduğu belirtilerinize ve tercihlerinize göre belirlenir.
        </p>
        <h3>Kendinize zarar verme düşüncesi varsa</h3>
        <p>
          <strong>Kendinize zarar verme düşüncesi için gecikmeden profesyonel yardım isteyin.</strong>
          Bir planınız varsa, kendinizi güvende tutamıyorsanız veya kendinize zarar verdiyseniz yalnız kalmayın;
          güvendiğiniz birini yanınıza çağırın ve acil sağlık yardımı alın. Bunu rutin bir görüşmeye kadar ertelemeyin.
        </p>

        <h2 id="gunluk-duzenler">Günü kolaylaştıran küçük düzenler</h2>
        <p>
          Zor bir günde bütün alışkanlıklarınızı değiştirmeniz gerekmiyor.
          Size uygun, sürdürebileceğiniz bir adımla başlayabilirsiniz.
        </p>
        <p>
          Düzenli hareket, yeterli uyku ve fazla kafeini azaltmak kaygıyla baş etmeye yardımcı olabilir
          <Evidence level={3} />. Bunlar genel destek adımlarıdır; belirgin kaygının değerlendirilmesi
          veya tedavisinin yerini tutmaz.
        </p>
        <ul>
          <li>Yatma ve kalkma saatlerinizi olabildiğince düzenli tutmayı deneyin; akşam ekran kullanımınızı gözden geçirin.</li>
          <li>Sabah gün ışığı almak ve gün içinde kısa bir yürüyüş yapmak için size uygun bir zaman seçin.</li>
          <li>Kahve, çay ve enerji içeceklerinin miktarını, özellikle uykunuzu etkileyip etkilemediğini fark edin.</li>
          <li>Rahat bir nefesle kısa bir mola verin; yapılacaklar çoksa aklınızdakileri bir kâğıda yazabilirsiniz.</li>
          <li>Kaygıyı hafifletmek için alkole veya kendi kararınızla ilaç kullanmaya yönelmeyin.</li>
        </ul>
        <p>
          Bir öneri size iyi gelmiyorsa kendinizi zorlamayın. Hangi adımın uygulanabilir olduğunu görmek,
          uzun bir yapılacaklar listesini eksiksiz tamamlamaktan daha yararlıdır.
        </p>

        <h2 id="kisa-hatirlatma">Görüşmeye hazırlanırken</h2>
        <p>
          Söylemek istediklerinizi görüşme sırasında unutmak kolaydır. Telefonunuza veya küçük bir deftere
          birkaç satır yazmanız yeterli olabilir.
        </p>
        <p>
          Kaygının ne zaman başladığını, uyku ve adet düzeninizdeki değişiklikleri, kullandığınız ilaç ve
          takviyeleri not edin. Daha önce benzer bir dönem yaşadıysanız neyin yardımcı olduğunu da ekleyin.
          Görüşmenin sonunda anlamadığınız bir noktayı yeniden sorabilir, önerilen desteğin ne amaçla
          sunulduğunu öğrenebilirsiniz.
        </p>
      </ArticleProsePanel>

      <ArticleFAQ id="sik-sorulanlar" items={faqItems} class="mt-10" />

      <RelatedReadings
        class="mt-14"
        paths={[
          '/zihin-denge/duygusal-denge/stres-yonetimi-menopoz/',
          '/zihin-denge/uyku-dinlenme/perimenopoz-uyku-degisen-yan/',
          '/zihin-denge/bilissel-saglik/perimenopozda-zihinsel-bulaniklik/',
        ]}
      />

      <ArticleEditorNote>
        <p>Perimenopoz döneminde kaygı artışı, hormonal dalgalanmanın duygu düzenleme, uyku ve otonom sinir sistemi yanıtlarıyla kesiştiği bir alanda değerlendirilebilir.</p>
        <p>Uyku bölünmesi, vazomotor belirtiler, mevcut stres yükü, geçmiş kaygı öyküsü ve eşlik eden tıbbi durumlar tabloyu belirginleştirebilir; bu nedenle tek nedenli açıklama çoğu zaman yetersiz kalır.</p>
        <p>Günlük işlev kaybı, panik atak benzeri ataklar, uzun süren çöküntü hali, kendine zarar verme düşüncesi veya bedensel belirtilerin şiddetlenmesi durumunda bireysel değerlendirme geciktirilmemelidir.</p>
        <p class="text-sm italic text-primary">— Doç. Dr. Senai Aksoy, Estranova Bilimsel Editörü</p>
      </ArticleEditorNote>

      <ArticleDisclaimer class="mt-10">
        <p>Bu içerik genel bilgi amaçlıdır ve bireysel tıbbi değerlendirme, tanı veya tedavinin yerini almaz. Sağlık kararlarınız için kendi hekiminizle birlikte değerlendirme yapınız.</p>
      </ArticleDisclaimer>
    </SubmenuArticleBody>
  </main>

  <SiteFooter />
</SiteLayout>

<style>
  @media (max-width: 639px) {
    #main-content :global(#submenu-hero-title) {
      font-size: clamp(2.1rem, 10.5vw, 3.45rem);
      line-height: 0.95;
    }
  }
</style>
