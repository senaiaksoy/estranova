---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteNavbar from '../../../components/site/SiteNavbar.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SubmenuHero from '../../../components/site/SubmenuHero.astro';
import SubmenuSection from '../../../components/site/SubmenuSection.astro';
import ChapterMasthead from '../../../components/site/ChapterMasthead.astro';
import EditorialEpigraph from '../../../components/site/EditorialEpigraph.astro';
import MarginaliaRail from '../../../components/site/MarginaliaRail.astro';
import MarginaliaItem from '../../../components/site/MarginaliaItem.astro';
import Asterism from '../../../components/site/Asterism.astro';
import ChapterCompass from '../../../components/site/ChapterCompass.astro';
import EditorPickCard from '../../../components/site/EditorPickCard.astro';
import { submenuHeroByRoute } from '../../../data/submenu-heroes';
import { chapterMap, getNextChapter } from '../../../data/chapter-map';
import { subHubEpigraphs } from '../../../data/sub-hub-epigraphs';

const path = '/zihin-denge/uyku-dinlenme';
const hero = submenuHeroByRoute[path]!;
const chapter = chapterMap[path]!;
const epigraph = subHubEpigraphs[path];
const next = getNextChapter(path);

const editorPick = {
  href: '/zihin-denge/uyku-dinlenme/uyku-bozuklugu-menopoz',
  title: 'Menopozda Uyku Bozukluğu — Dinlenme Rehberi',
  lede: 'Önce ter, sonra düşünceler, sonra saat üçte tavana bakan tuhaf uyanıklık. Menopozda uyku tek seferde kaybedilmez; her gece bir parçası eksilir.',
  writerSlug: 'berna-aksoy',
  readingMinutes: 9,
  image: submenuHeroByRoute['/zihin-denge/uyku-dinlenme/uyku-bozuklugu-menopoz']!,
};

const neighbors = [
  { step: '01', href: '/zihin-denge/duygusal-denge', title: 'Duygusal Denge', excerpt: 'Ruh halinde dalgalanma, kaygı ve stres yönetimi; mekanizma ve günlük stratejiler.' },
  { step: '02', href: '/zihin-denge/bilissel-saglik', title: 'Bilişsel Sağlık', excerpt: 'Beyin sisi, bellek ve odaklanma — menopozda bilişsel değişimleri okumak.' },
];
---

<SiteLayout
  title="Uyku & Dinlenme — Zihin & Denge - Estranova"
  description="Menopozda uykunun neden zorlaştığı ve nasıl desteklenebileceği üzerine sade bir okuma rehberi; gece terlemesi, uyku bölünmesi ve dinlenme kalitesi."
>
  <SiteNavbar currentPath="/zihin-denge" />

  <main id="main-content" class="text-ink">
    <ChapterMasthead number={chapter.number} parent={chapter.parent} chapter={chapter.chapter} />

    <SubmenuHero
      eyebrow="Gecenin ortasında uyanan kadın"
      title="Uyku & Dinlenme"
      lede="Menopozda uyku, çoğu zaman tek seferde kaybedilmez; her gece bir parçası eksilir. Önce ter, sonra düşünceler, sonra saat üçte tavana bakan o tuhaf uyanıklık."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />

    <section class="border-b border-burgundy/10 bg-[#fffaf0] px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <nav class="mb-10 text-sm text-ink/60" aria-label="İçerik yolu">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/zihin-denge" class="font-medium text-burgundy hover:underline">Zihin & Denge</a></li>
            <li aria-hidden="true">/</li>
            <li class="font-medium text-ink">Uyku & Dinlenme</li>
          </ol>
        </nav>

        <div class="grid gap-12 lg:grid-cols-12 lg:items-start lg:gap-14">
          <div class="lg:col-span-8">
            <p class="editorial-dropcap mb-7 text-lg leading-relaxed text-ink/85 md:text-xl">
              Östrojen ve progesteronun çekilmesi vücudun ısı düzenleme eşiğini ve derin uyku
              mimarisini birlikte değiştirir. Sıcak basmaları yalnızca rahatsız edici bir his
              değil, REM dışı uykuyu bölen ölçülebilir bir nörofizyolojik olaydır; insomnia
              ise çoğu kadında bunun üzerine kurulan ikinci bir katmandır — uyumamak, zamanla
              uyku düşüncesinin kendisinden korkmaya dönüşür.
            </p>
            <p class="text-base leading-relaxed text-ink/72 md:text-lg">
              İyi haber şu: bu döngü kırılabilir. Bilişsel davranışçı uyku terapisi, hormon
              temelli yaklaşımlar ve gündüze yayılan birkaç sade alışkanlık, çoğu vakada
              ilaca gerek kalmadan geceyi yeniden yaşanabilir kılıyor.
            </p>
          </div>

          <div class="lg:col-span-4 lg:pt-1">
            <MarginaliaRail>
              <MarginaliaItem label="Yayın" value="Nisan 2026 · Düzenli güncellenir" />
              <MarginaliaItem label="Yaygınlık" emphasized="Menopoz geçişindeki kadınların 40-60'ı kronik uyku sorunu bildirir." />
              <MarginaliaItem label="Sık sorulanlar">
                <ul class="mt-2 space-y-3 text-sm leading-snug text-ink/78">
                  <li><span class="block font-semibold text-ink">Gece terlemesi neden tam uykunun ortasında?</span>Vücut ısısı en çok REM dışı evrede düşer; menopozdaki dar termoregülasyon penceresi bunu "aşırı ısınma" olarak okur.</li>
                  <li><span class="block font-semibold text-ink">Hap mı, terapi mi?</span>Kısa vadede uyku ilaçları işe yarar; kalıcı çözüm çoğu zaman BDT-İ ve gerekiyorsa hormonal destektir.</li>
                  <li><span class="block font-semibold text-ink">Saat üçte uyanmak menopoza bağlı mı?</span>Çok büyük olasılıkla evet — menopoz uyku profilinin tipik imzalarından biri.</li>
                </ul>
              </MarginaliaItem>
            </MarginaliaRail>
          </div>
        </div>
      </div>
    </section>

    {epigraph && <EditorialEpigraph quote={epigraph} />}

    <SubmenuSection variant="white" borderedTop={false}>
      <header class="mb-12 grid gap-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-end">
        <p class="text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Editör'ün Seçimi</p>
        <h2 class="font-serif text-4xl leading-[0.95] tracking-[-0.04em] md:text-6xl">Bu evreden bir okuma</h2>
      </header>

      <EditorPickCard
        href={editorPick.href}
        title={editorPick.title}
        lede={editorPick.lede}
        writerSlug={editorPick.writerSlug}
        readingMinutes={editorPick.readingMinutes}
        imageSrc={editorPick.image.src}
        imageAlt={editorPick.image.alt}
      />
    </SubmenuSection>

    <Asterism />

    <SubmenuSection variant="white" borderedTop={false}>
      <header class="mb-12 grid gap-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-end">
        <p class="text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Mayıs 2026 · Dosya</p>
        <div>
          <h2 class="font-serif text-4xl leading-[0.95] tracking-[-0.04em] md:text-6xl">Uyuyamadığımız Geceler dosyasından</h2>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink/72">
            Bu ay perimenopozda uyku değişiminin farklı kapılarına bakıyoruz; bu kategoride yer alan yazılar.
          </p>
        </div>
      </header>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        <a
          href="/zihin-denge/uyku-dinlenme/perimenopoz-uyku-degisen-yan"
          class="group block rounded-[26px] border border-burgundy/12 bg-white p-7 transition hover:border-burgundy/28 hover:shadow-sm"
        >
          <p class="mb-2 text-xs font-bold uppercase tracking-[0.22em] text-gold">Berna Aksoy · 8 dk okuma</p>
          <h3 class="mb-2 font-serif text-xl text-ink group-hover:text-burgundy md:text-2xl">
            Perimenopozda Uykunun Gerçekten Değişen Yanı
          </h3>
          <p class="mb-4 text-sm leading-relaxed text-ink/72">
            Östrojen ve progesteron uykunun hangi evresine dokunuyor, hangi değişim geçici, hangisi kalıcı bir
            düzen kuruyor — dosyanın zemin yazısı.
          </p>
          <span class="text-sm font-semibold text-burgundy group-hover:underline">Yazıya git →</span>
        </a>
        <a
          href="/zihin-denge/uyku-dinlenme/gece-terlemesi-uyku-utancsiz"
          class="group block rounded-[26px] border border-burgundy/12 bg-white p-7 transition hover:border-burgundy/28 hover:shadow-sm"
        >
          <p class="mb-2 text-xs font-bold uppercase tracking-[0.22em] text-gold">Senai Aksoy · 6 dk okuma</p>
          <h3 class="mb-2 font-serif text-xl text-ink group-hover:text-burgundy md:text-2xl">
            Gece Terlemesi ve Uyku: Utançsız Bir Bakış
          </h3>
          <p class="mb-4 text-sm leading-relaxed text-ink/72">
            Konuşulması zor ama herkesin yaşadığı bir an. Mahrem yan jargonsuz, çözüm seçenekleri açık liste —
            yargısız bir komşu sıcaklığı.
          </p>
          <span class="text-sm font-semibold text-burgundy group-hover:underline">Yazıya git →</span>
        </a>
        <a
          href="/zihin-denge/uyku-dinlenme/aksam-hareketi-uyku-melatonin"
          class="group block rounded-[26px] border border-burgundy/12 bg-white p-7 transition hover:border-burgundy/28 hover:shadow-sm"
        >
          <p class="mb-2 text-xs font-bold uppercase tracking-[0.22em] text-gold">Alara Baykent · 7 dk okuma</p>
          <h3 class="mb-2 font-serif text-xl text-ink group-hover:text-burgundy md:text-2xl">
            Akşam Hareketi Uykuyu Bozar mı, Toparlar mı?
          </h3>
          <p class="mb-4 text-sm leading-relaxed text-ink/72">
            Sporcu beden okumasıyla akşam egzersizi, melatonin ve beden ısısı ilişkisi. Performans baskısı değil,
            geceye geçiş ritüeli.
          </p>
          <span class="text-sm font-semibold text-burgundy group-hover:underline">Yazıya git →</span>
        </a>
      </div>
      <p class="mt-6 text-sm text-ink/65">
        <a href="/dosya/2026-05-uyuyamadigimiz-geceler" class="font-medium text-burgundy hover:underline">
          Dosyanın tamamını gör →
        </a>
      </p>
    </SubmenuSection>

    <SubmenuSection variant="cream" borderedTop={false}>
      <header class="mb-10 grid gap-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-end">
        <p class="text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Aynı kategoride</p>
        <h2 class="font-serif text-4xl leading-[0.95] tracking-[-0.04em] md:text-6xl">İlgili alt başlıklar</h2>
      </header>
      <div class="divide-y divide-burgundy/14 border-y border-burgundy/14">
        {neighbors.map((n) => (
          <a href={n.href} class="group grid gap-5 py-7 transition hover:bg-white/58 md:grid-cols-[88px_1fr_auto] md:items-center md:py-8">
            <span class="font-serif text-3xl italic text-gold">{n.step}</span>
            <div>
              <h3 class="mb-2 font-serif text-3xl leading-tight text-ink group-hover:text-burgundy">{n.title}</h3>
              <p class="max-w-2xl text-sm leading-relaxed text-ink/72">{n.excerpt}</p>
            </div>
            <span class="text-2xl text-gold transition group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </SubmenuSection>

    <ChapterCompass nextHref={next?.href} nextNumber={next?.number} nextChapter={next?.chapter} nextParent={next?.parent} />
  </main>

  <SiteFooter />
</SiteLayout>
