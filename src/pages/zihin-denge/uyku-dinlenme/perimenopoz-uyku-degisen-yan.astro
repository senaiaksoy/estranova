import { perimenopozUykuFaqs as faqItems } from '../../../data/perimenopoz-uyku-faqs';

const hero = submenuHeroByRoute['/zihin-denge/uyku-dinlenme/perimenopoz-uyku-degisen-yan/']!;

const siteUrl = resolveSiteUrl(Astro.site);
const articleTitle = 'Perimenopozda Uykunun Gerçekten Değişen Yanı';
const articleDescription =
  'Perimenopozda uyku bölünmeleri ve sabah yorgunluğu: geceyi anlamak, alışkanlıkları gözden geçirmek ve ne zaman yardım istemek gerektiği.';
const tocEntries = [
  { id: 'uyku-mimarisi', label: 'Sekiz saat, iki sabah' },
  { id: 'hormonal-dalga', label: 'Hormonlar ve gece' },
  { id: 'evre-degisimi', label: 'Sabah yorgunluğu' },
  { id: 'gecici-kalici', label: 'Kötü gece ve sonrası' },
  { id: 'ne-yardim', label: 'Akşamı gözden geçirmek' },
  { id: 'ne-zaman', label: 'Yardım istemek' },
  { id: 'uykuyu-okurken', label: "Dr. Aksoy'a sorular" },
  { id: 'kapanis', label: 'Sabaha kalan soru' },
];
const articleSchemas = buildArticleSchemas({
  title: articleTitle,
  description: articleDescription,
  writerSlug: 'berna-aksoy',
  articleType: 'editorial-guide',
  publishedDate: '28 Nisan 2026',
  modifiedDate: '30 Eylül 2026',
  pathname: '/zihin-denge/uyku-dinlenme/perimenopoz-uyku-degisen-yan/',
  articleSection: 'Zihin & Denge',
  sectionPath: '/zihin-denge/',
  keywords: ['perimenopoz', 'uyku', 'uyku evresi', 'östrojen', 'progesteron', 'REM', 'NREM', 'CBT-I', 'menopoz uyku'],

  faqItems,
  siteUrl,
