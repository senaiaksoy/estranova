---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteNavbar from '../../components/site/SiteNavbar.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SubmenuHero from '../../components/site/SubmenuHero.astro';
import SubmenuLinkCard from '../../components/site/SubmenuLinkCard.astro';
import SubmenuSection from '../../components/site/SubmenuSection.astro';
import SubmenuSpotlightCard from '../../components/site/SubmenuSpotlightCard.astro';
import CategoryRelatedLinks from '../../components/site/CategoryRelatedLinks.astro';
import Evidence from '../../components/site/Evidence.astro';
import ChapterMasthead from '../../components/site/ChapterMasthead.astro';
import EditorialEpigraph from '../../components/site/EditorialEpigraph.astro';
import ChapterCompass from '../../components/site/ChapterCompass.astro';
import HubStartingPath from '../../components/site/HubStartingPath.astro';
import { submenuHeroByRoute } from '../../data/submenu-heroes';
import { subHubEpigraphs } from '../../data/sub-hub-epigraphs';
import { hubStartingPaths } from '../../data/hub-starting-paths';

const hero = submenuHeroByRoute['/zihin-denge']!;
const __hubPath = '/zihin-denge';
const epigraph = subHubEpigraphs[__hubPath];
const startingPath = hubStartingPaths['/zihin-denge'];

const pillars = [
  {
    step: '01',
    title: 'Uyku & Dinlenme',
    excerpt: 'Gece terlemesi, uyku bölünmesi ve uyku kalitesi — menopozda uykunun neden zorlaştığı ve nasıl desteklenebileceği üzerine sade rehberler.',
    href: '/zihin-denge/uyku-dinlenme',
    image: submenuHeroByRoute['/zihin-denge/uyku-dinlenme']!,
  },
  {
    step: '02',
    title: 'Duygusal Denge',
    excerpt: 'Ruh halinde dalgalanma, kaygı, ani sinirlenme — menopoz hormonlarının beyin kimyasıyla konuştuğu yerde mekanizma ve günlük stratejiler.',
    href: '/zihin-denge/duygusal-denge',
    image: submenuHeroByRoute['/zihin-denge/duygusal-denge']!,
  },
  {
    step: '03',
    title: 'Bilişsel Sağlık',
    excerpt: 'Beyin sisi, unutkanlık ve dikkat dağılması; ne kadarı menopozun normal seyri, ne kadarı izlenmeyi gerektirir?',
    href: '/zihin-denge/bilissel-saglik',
    image: submenuHeroByRoute['/zihin-denge/bilissel-saglik']!,
  },
];
---

<SiteLayout
  title="Zihin & Denge - Estranova"
  description="Hormonal değişimlerin zihinsel ve duygusal etkilerini anlamak, uyku kalitesini artırmak ve ruh halinizi dengelemek için bilimsel rehberlik."
>
  <SiteNavbar currentPath="/zihin-denge" />

  <ChapterMasthead variant="section" chapter="Zihin & Denge" />

  <main id="main-content" class="text-ink">
    <SubmenuHero
      eyebrow="Kategori"
      title="Zihin & Denge"
      lede="Hormonal değişimlerin zihinsel ve duygusal etkilerini anlamak, uyku ve ruh halini desteklemek için bilimsel rehberlik. Günlük dalgalanmaları sade bir çerçevede ele alırız."
      imageSrc={hero.src}
      imageAlt={hero.alt}
    />
    {startingPath && (
      <HubStartingPath
        kicker={startingPath.kicker}
        title={startingPath.title}
        intro={startingPath.intro}
        steps={startingPath.steps}
      />
    )}

    <SubmenuSection variant="cream" borderedTop={true}>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
        {
          pillars.map((p) => (
            <SubmenuLinkCard
              href={p.href}
              title={p.title}
              excerpt={p.excerpt}
              imageSrc={p.image.src}
              imageAlt={p.image.alt}
              step={p.step}
            />
          ))
        }
      </div>
    </SubmenuSection>

    {epigraph && <EditorialEpigraph quote={epigraph} />}

    <SubmenuSection variant="white" borderedTop={true}>
      <header class="mb-10 max-w-3xl">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.24em] text-burgundy">Öne Çıkanlar</p>
        <h2 class="mb-4 font-serif text-4xl leading-tight md:text-5xl">Öne Çıkan İçerikler</h2>
        <p class="text-lg leading-relaxed text-ink/75">
          Zihin ve duygusal denge konularına odaklanan örnek içerikler.
        </p>
      </header>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <SubmenuSpotlightCard
          tag="Uyku"
          title="Gece Rutini Oluşturmak"
          body="Uyku kalitesini artırmaya yardımcı, uygulanabilir ve sakin bir akşam planı."
          href="/zihin-denge/uyku-dinlenme/uyku-bozuklugu-menopoz"
        >
          <span slot="footer">Kanıt Düzeyi: <Evidence level={4} /></span>
        </SubmenuSpotlightCard>
        <SubmenuSpotlightCard
          highlight={true}
          tag="Stres"
          title="Gün İçinde Nefes Araları"
          body="Kısa nefes ve farkındalık molalarıyla zihinsel yükü düzenlemeye yardımcı notlar."
          href="/zihin-denge/duygusal-denge/stres-yonetimi-menopoz"
        >
          <span slot="footer">Kanıt Düzeyi: <Evidence level={3} /></span>
        </SubmenuSpotlightCard>
        <SubmenuSpotlightCard
          tag="Ruh Hali"
          title="Duygusal Dalgalanmaları İzlemek"
          body="Duygu günlüğüyle tetikleyicileri fark etmeyi kolaylaştıran başlangıç yaklaşımı."
          href="/zihin-denge/duygusal-denge/ruh-hali-degisimleri-menopoz"
        >
          <span slot="footer">Kanıt Düzeyi: <Evidence level={3} /></span>
        </SubmenuSpotlightCard>
      </div>
    </SubmenuSection>

    <SubmenuSection variant="sand" borderedTop={true}>
      <CategoryRelatedLinks exclude="/zihin-denge" />
    </SubmenuSection>

    <ChapterCompass nextHref="/zihin-denge/uyku-dinlenme" nextNumber="01" nextChapter="Uyku & Dinlenme" nextParent="Zihin & Denge" />
  </main>

  <SiteFooter />
</SiteLayout>
