---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
---

<SiteLayout
  title="Hakkimizda - Estranova"
  description="Estranova'nin editoryal kimligi, amaci ve yonetim yapisi."
>
  <SiteNavbar currentPath="/about" />

  <main id="main-content" class="pt-24">
    <section class="px-6 py-16 md:py-20">
      <div class="max-w-5xl mx-auto">
        <header class="max-w-3xl mb-14">
          <p class="text-secondary text-xs font-bold tracking-[0.28em] uppercase mb-4">Hakkimizda</p>
          <h1 class="text-5xl md:text-7xl font-serif leading-[1.05] text-charcoal mb-6">Estranova nasil bir platform?</h1>
          <p class="text-lg md:text-xl text-charcoal/65 leading-relaxed">
            Estranova, perimenopoz, menopoz ve 40+ saglik basliklarinda okura duzenli, anlasilir ve kanita dayali bilgi sunmak icin kurulan
            editoryal bir saglik icerigi platformudur.
          </p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
          <section class="rounded-[32px] border border-primary/10 bg-card p-8 editorial-shadow">
            <h2 class="text-3xl font-serif mb-4">Amac</h2>
            <p class="text-charcoal/70 leading-relaxed">
              Menopoz gecisi ile ilgili bilgileri reklam dili olmadan, acik ve sakin bir icerik yapisiyla sunmak. Hedef, okuru kaygilandiran degil,
              yonunu bulmasini kolaylastiran bir yayin modeli kurmaktir.
            </p>
          </section>

          <section class="rounded-[32px] border border-primary/10 bg-surface-container p-8">
            <h2 class="text-3xl font-serif mb-4">Yayin Cizgisi</h2>
            <p class="text-charcoal/70 leading-relaxed">
              Estranova bir klinik sitesi, tedavi sayfasi veya hizmet hunisi degildir. Sayfalar; bilgi, baglam ve kaynak okuma kolayligi esas alinarak hazirlanir.
            </p>
          </section>
        </div>

        <section class="rounded-[36px] burgundy-gradient text-white p-10 md:p-12 mb-16">
          <p class="text-[11px] uppercase tracking-[0.22em] text-white/70 font-bold mb-4">Yonetim Yapisi</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <p class="text-sm font-bold uppercase tracking-[0.18em] text-white/70 mb-2">Site Yonetimi</p>
              <p class="text-2xl font-serif">Berna Aksoy</p>
            </div>
            <div>
              <p class="text-sm font-bold uppercase tracking-[0.18em] text-white/70 mb-2">Danisman Doktor ve Yazi Denetleyici</p>
              <p class="text-2xl font-serif">Doc. Dr. Senai Aksoy</p>
            </div>
          </div>
        </section>

        <section class="rounded-[32px] border border-primary/10 bg-card p-8">
          <h2 class="text-3xl font-serif mb-5">Neden seffaflik onemli?</h2>
          <p class="text-charcoal/70 leading-relaxed mb-4">
            Saglik iceriginde rol dagiliminin acik olmasi, okurun metni nasil yorumlayacagini belirler. Bu nedenle yazar, denetim ve tibbi kurul rolleri
            sayfa yapisinda ayrik olarak gosterilir.
          </p>
          <p class="text-charcoal/70 leading-relaxed">
            Estranova'da icerikler yayinlanmadan once yazim, kaynak ve tibbi baglam acisindan farkli asamalardan gecer. Ayrintilar icin
            <a href="/methodology" class="text-primary font-semibold border-b border-primary/30 pb-0.5 ml-1">metodoloji sayfasini</a>
            inceleyebilirsiniz.
          </p>
        </section>
      </div>
    </section>
  </main>

  <SiteFooter />
</SiteLayout>
