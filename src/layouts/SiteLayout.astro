---
import '../index.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = "Estranova - Perimenopoz, menopoz ve 40+ kadın sağlığı için editoryal bilgi platformu.",
  canonical,
} = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title}</title>
  </head>
  <body class="bg-surface text-charcoal font-sans antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-primary focus:text-white"
    >
      İçeriğe geç
    </a>
    <slot />
  </body>
</html>