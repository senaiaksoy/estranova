---
import '../index.css';
import mobileMenuScript from '../components/site/mobile-menu.js?url';

type JsonLdSchema = Record<string, unknown>;

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  jsonLd?: JsonLdSchema | JsonLdSchema[];
}

const {
  title,
  description = "Estranova - Perimenopoz, menopoz ve 40+ kadın sağlığı için editoryal bilgi platformu.",
  canonical,
  jsonLd,
} = Astro.props;

const siteUrl = (Astro.site ? Astro.site.toString() : 'https://estranova.com').replace(/\/$/, '');

const webSiteSchema: JsonLdSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Estranova',
  url: siteUrl,
  inLanguage: 'tr-TR',
  description,
};

const organizationSchema: JsonLdSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Estranova',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description: '40+ kadın sağlığına odaklanan bağımsız editoryal sağlık platformu.',
};

const additionalSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allSchemas = [webSiteSchema, organizationSchema, ...additionalSchemas];
---

<!doctype html>
<html lang="tr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Accessibility Meta Tags -->
    <meta name="robots" content="follow, index" />
    <meta name="theme-color" content="#7C2D58" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}

    <title>{title}</title>

    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="bg-surface text-charcoal font-sans antialiased" data-theme="light">
    <!-- Skip to Main Content Link -->
    <a
      href="#main-content"
      class="skip-link"
      tabindex="0"
    >
      İçeriğe doğrudan geç
    </a>

    <!-- Mobile menu script -->
    <script src={mobileMenuScript} defer></script>

    <slot />
  </body>
</html>
