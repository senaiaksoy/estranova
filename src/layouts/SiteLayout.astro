---
import '../index.css';
import mobileMenuScript from '../components/site/mobile-menu.js?url';
import {
  resolveCanonicalUrl,
  resolveSiteUrl,
  resolveSocialImageUrl,
  type OgType,
} from '../utils/seo';
import { isProductionLaunch } from '../utils/launch';
import { featureFlags } from '../utils/feature-flags';
import CookieBanner from '../components/site/CookieBanner.astro';

type JsonLdSchema = Record<string, unknown>;

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  ogType?: OgType;
  jsonLd?: JsonLdSchema | JsonLdSchema[];
  allowIndexing?: boolean;
}

const {
  title,
  description = 'Estranova - Perimenopoz, menopoz ve 40+ kadın sağlığı için editoryal bilgi platformu.',
  canonical,
  image,
  ogType = 'website',
  jsonLd,
  allowIndexing = isProductionLaunch(),
} = Astro.props;

const siteUrl = resolveSiteUrl(Astro.site);
const canonicalUrl = resolveCanonicalUrl({
  siteUrl,
  pathname: Astro.url.pathname,
  canonical,
});
const socialImageUrl = resolveSocialImageUrl({ siteUrl, image });
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

const DR_AKSOY_PERSON_ID = 'https://senaiaksoy.net/#person';

const webSiteSchema: JsonLdSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: 'Estranova',
  url: siteUrl,
  inLanguage: 'tr-TR',
  description,
  publisher: { '@id': `${siteUrl}/#organization` },
};

const organizationSchema: JsonLdSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'Estranova',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description: '40+ kadın sağlığına odaklanan bağımsız editoryal sağlık platformu.',
  reviewedBy: { '@id': DR_AKSOY_PERSON_ID },
};

const additionalSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allSchemas = [webSiteSchema, organizationSchema, ...additionalSchemas];
---

<!doctype html>
<html lang="tr-TR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />

    <meta
      name="robots"
      content={allowIndexing ? 'index, follow, max-image-preview:large' : 'noindex, nofollow'}
    />
    <meta name="theme-color" content="#AD1457" />
    {googleSiteVerification && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="alternate" type="application/rss+xml" title="Estranova — Editöryal Yayın" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:site_name" content="Estranova" />
    <meta property="og:locale" content="tr_TR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:url" content={canonicalUrl} />

    <title>{title}</title>

    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="bg-surface text-charcoal font-sans antialiased" data-theme="light">
    <a
      href="#main-content"
      class="skip-link"
      tabindex="0"
    >
      İçeriğe doğrudan geç
    </a>

    <script src={mobileMenuScript} defer></script>

    <slot />

    {featureFlags.cookieBannerEnabled && <CookieBanner />}

    <script>
      import '../scripts/save-for-later';
      import '../scripts/reading-controls';
      import '../scripts/article-toc';
      import '../scripts/newsletter-signup';
    </script>
  </body>
</html>
