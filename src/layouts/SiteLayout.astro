---
import '../index.css';
import mobileMenuScript from '../components/site/mobile-menu.js?url';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = "Estranova - Perimenopoz, menopoz ve 40+ kadın sağlığı için editoryal bilgi platformu.",
  canonical,
} = Astro.props;
---

<!doctype html>
<html lang="tr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Accessibility Meta Tags -->
    <meta name="robots" content="follow, index" />
    <meta name="theme-color" content="#7C2D58" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <title>{title}</title>
  </head>
  <body class="bg-surface text-charcoal font-sans antialiased" data-theme="light">
    <!-- Skip to Main Content Link -->
    <a
      href="#main-content"
      class="skip-link"
      tabindex="0"
    >
      İçeriğe doğrudan geç
    </a>

    <!-- Mobile menu script -->
    <script src={mobileMenuScript} defer></script>

    <slot />
  </body>
</html>
