---
import '../index.css';
import mobileMenuScript from '../components/site/mobile-menu.js?url';
import {
  resolveCanonicalUrl,
  resolveSiteUrl,
  resolveSocialImageUrl,
  type OgType,
} from '../utils/seo';

type JsonLdSchema = Record<string, unknown>;

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  ogType?: OgType;
  jsonLd?: JsonLdSchema | JsonLdSchema[];
}

const {
  title,
  description = 'Estranova - Perimenopoz, menopoz ve 40+ kadın sağlığı için editoryal bilgi platformu.',
  canonical,
  image,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const siteUrl = resolveSiteUrl(Astro.site);
const canonicalUrl = resolveCanonicalUrl({
  siteUrl,
  pathname: Astro.url.pathname,
  canonical,
});
const socialImageUrl = resolveSocialImageUrl({ siteUrl, image });

const webSiteSchema: JsonLdSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Estranova',
  url: siteUrl,
  inLanguage: 'tr-TR',
  description,
};

const organizationSchema: JsonLdSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Estranova',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description: '40+ kadın sağlığına odaklanan bağımsız editoryal sağlık platformu.',
};

const additionalSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allSchemas = [webSiteSchema, organizationSchema, ...additionalSchemas];
---

<!doctype html>
<html lang="tr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <meta name="robots" content="follow, index" />
    <meta name="theme-color" content="#7C2D58" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:site_name" content="Estranova" />
    <meta property="og:locale" content="tr_TR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:url" content={canonicalUrl} />

    <title>{title}</title>

    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="bg-surface text-charcoal font-sans antialiased" data-theme="light">
    <a
      href="#main-content"
      class="skip-link"
      tabindex="0"
    >
      İçeriğe doğrudan geç
    </a>

    <script src={mobileMenuScript} defer></script>

    <slot />
  </body>
</html>
